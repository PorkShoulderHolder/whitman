ke", "her", "too", "Mother", ",", "I", "am", "still", "going", "among", "the", "hospitals", ",", "there", "is", "plenty", "of", "need", ",", "just", "the", "same", "as", "ever", "I", "go", "every", "day", "or", "evening", "I", "have", "not", "heard", "from", "George", "I", "have", "no", "doubt", "the", "51st", "is", "still", "at", "Crab", "Orchard4", "Mother", ",", "I", "hope", "you", "will", "try", "to", "write", "I", "send", "you", "my", "love", ",", "&", "to", "Jeff", "&", "Mat", "&", "all", "so", "good", "bye", ",", "dear", "Mother", "Walt"], "date": [], "normalizedTime": "0.196518427853", "recipient": "Louisa Van Velsor Whitman", "organizations": ["Jeff1 Mother"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00805.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to Louisa Van Velsor Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Bethuel", "NNP"], ["Smith", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": [], "money": [], "year": "1863", "locations": [], "month": "Dec", "parties": ["Bethuel Smith", "Walt Whitman"], "properDate": "Dec 16, 1863", "gpe": ["Culpeper"], "facility": [], "latlngs": [[38.4731815, -77.9966639]], "text": " Dear friend I now take this opertunity to write to you after so long A time. you must excuse me for not writing sooner for I cold not get anny paper. I have received three letters from you since I wrote to you  we have had pretty hard times this fall but we are having it easyer now we are doing provo duty in Culpeper now but I dont now how long it will last there is some talk of braking up 4 Companies of the 2 Cav & I dont no but my Company will be one of them if it is we will go on recruiting servis that will be A good jok but I dont now as that will be the Case yet still I hope so I am well & harty & in good spirits  I have not heard from home in A long time I gess that they have for got that they have A son in the army it is about 2 O Clock at night now I am on gard sitting by A big fire   you must excuse my writing with A pencil for I cannot get pen & ink to write with   no more at present good by   Directions the same ", "dateText": "", "percents": [], "taggedText": [[["Dear", "NNP"], ["friend", "VBP"], ["I", "PRP"], ["now", "RB"], ["take", "VBP"], ["this", "DT"], ["opertunity", "NN"], ["to", "TO"], ["write", "VB"], ["to", "TO"], ["you", "PRP"], ["after", "IN"], ["so", "RB"], ["long", "RB"], ["A", "DT"], ["time", "NN"], [".", "."]], [["you", "PRP"], ["must", "MD"], ["excuse", "VB"], ["me", "PRP"], ["for", "IN"], ["not", "RB"], ["writing", "VBG"], ["sooner", "NN"], ["for", "IN"], ["I", "PRP"], ["cold", "VBP"], ["not", "RB"], ["get", "VB"], ["anny", "JJ"], ["paper", "NN"], [".", "."]], [["I", "PRP"], ["have", "VBP"], ["received", "VBN"], ["three", "CD"], ["letters", "NNS"], ["from", "IN"], ["you", "PRP"], ["since", "IN"], ["I", "PRP"], ["wrote", "VBD"], ["to", "TO"], ["you", "PRP"], ["we", "PRP"], ["have", "VBP"], ["had", "VBN"], ["pretty", "RB"], ["hard", "RB"], ["times", "VBZ"], ["this", "DT"], ["fall", "NN"], ["but", "CC"], ["we", "PRP"], ["are", "VBP"], ["having", "VBG"], ["it", "PRP"], ["easyer", "JJR"], ["now", "RB"], ["we", "PRP"], ["are", "VBP"], ["doing", "VBG"], ["provo", "NN"], ["duty", "NN"], ["in", "IN"], [["Culpeper", "NNP"]], ["now", "RB"], ["but", "CC"], ["I", "PRP"], ["dont", "VBP"], ["now", "RB"], ["how", "WRB"], ["long", "JJ"], ["it", "PRP"], ["will", "MD"], ["last", "VB"], ["there", "EX"], ["is", "VBZ"], ["some", "DT"], ["talk", "NN"], ["of", "IN"], ["braking", "VBG"], ["up", "RP"], ["4", "CD"], ["Companies", "NNS"], ["of", "IN"], ["the", "DT"], ["2", "CD"], ["Cav", "NNP"], ["&", "CC"], ["I", "PRP"], ["dont", "VBP"], ["no", "DT"], ["but", "CC"], ["my", "PRP$"], [["Company", "NNP"]], ["will", "MD"], ["be", "VB"], ["one", "CD"], ["of", "IN"], ["them", "PRP"], ["if", "IN"], ["it", "PRP"], ["is", "VBZ"], ["we", "PRP"], ["will", "MD"], ["go", "VB"], ["on", "IN"], ["recruiting", "NN"], ["servis", "NNS"], ["that", "WDT"], ["will", "MD"], ["be", "VB"], ["A", "DT"], ["good", "JJ"], ["jok", "NN"], ["but", "CC"], ["I", "PRP"], ["dont", "VBP"], ["now", "RB"], ["as", "IN"], ["that", "DT"], ["will", "MD"], ["be", "VB"], ["the", "DT"], ["Case", "NNP"], ["yet", "RB"], ["still", "RB"], ["I", "PRP"], ["hope", "VBP"], ["so", "RB"], ["I", "PRP"], ["am", "VBP"], ["well", "RB"], ["&", "CC"], ["harty", "NN"], ["&", "CC"], ["in", "IN"], ["good", "JJ"], ["spirits", "NNS"], ["I", "PRP"], ["have", "VBP"], ["not", "RB"], ["heard", "VBN"], ["from", "IN"], ["home", "NN"], ["in", "IN"], ["A", "DT"], ["long", "JJ"], ["time", "NN"], ["I", "PRP"], ["gess", "VBP"], ["that", "IN"], ["they", "PRP"], ["have", "VBP"], ["for", "IN"], ["got", "VBN"], ["that", "IN"], ["they", "PRP"], ["have", "VBP"], ["A", "DT"], ["son", "NN"], ["in", "IN"], ["the", "DT"], ["army", "NN"], ["it", "PRP"], ["is", "VBZ"], ["about", "IN"], ["2", "CD"], ["O", "NNP"], ["Clock", "NNP"], ["at", "IN"], ["night", "NN"], ["now", "RB"], ["I", "PRP"], ["am", "VBP"], ["on", "IN"], ["gard", "NN"], ["sitting", "VBG"], ["by", "IN"], ["A", "DT"], ["big", "JJ"], ["fire", "NN"], ["you", "PRP"], ["must", "MD"], ["excuse", "VB"], ["my", "PRP$"], ["writing", "NN"], ["with", "IN"], ["A", "DT"], ["pencil", "NN"], ["for", "IN"], ["I", "PRP"], ["can", "MD"], ["not", "RB"], ["get", "VB"], ["pen", "VBN"], ["&", "CC"], ["ink", "NN"], ["to", "TO"], ["write", "VB"], ["with", "IN"], ["no", "DT"], ["more", "JJR"], ["at", "IN"], ["present", "JJ"], ["good", "NN"], ["by", "IN"], ["Directions", "NNS"], ["the", "DT"], ["same", "JJ"]]], "sentences": [" Dear friend I now take this opertunity to write to you after so long A time.", "you must excuse me for not writing sooner for I cold not get anny paper.", "I have received three letters from you since I wrote to you  we have had pretty hard times this fall but we are having it easyer now we are doing provo duty in Culpeper now but I dont now how long it will last there is some talk of braking up 4 Companies of the 2 Cav & I dont no but my Company will be one of them if it is we will go on recruiting servis that will be A good jok but I dont now as that will be the Case yet still I hope so I am well & harty & in good spirits  I have not heard from home in A long time I gess that they have for got that they have A son in the army it is about 2 O Clock at night now I am on gard sitting by A big fire   you must excuse my writing with A pencil for I cannot get pen & ink to write with   no more at present good by   Directions the same "], "words": ["Dear", "friend", "I", "now", "take", "this", "opertunity", "to", "write", "to", "you", "after", "so", "long", "A", "time.", "you", "must", "excuse", "me", "for", "not", "writing", "sooner", "for", "I", "cold", "not", "get", "anny", "paper.", "I", "have", "received", "three", "letters", "from", "you", "since", "I", "wrote", "to", "you", "we", "have", "had", "pretty", "hard", "times", "this", "fall", "but", "we", "are", "having", "it", "easyer", "now", "we", "are", "doing", "provo", "duty", "in", "Culpeper", "now", "but", "I", "dont", "now", "how", "long", "it", "will", "last", "there", "is", "some", "talk", "of", "braking", "up", "4", "Companies", "of", "the", "2", "Cav", "&", "I", "dont", "no", "but", "my", "Company", "will", "be", "one", "of", "them", "if", "it", "is", "we", "will", "go", "on", "recruiting", "servis", "that", "will", "be", "A", "good", "jok", "but", "I", "dont", "now", "as", "that", "will", "be", "the", "Case", "yet", "still", "I", "hope", "so", "I", "am", "well", "&", "harty", "&", "in", "good", "spirits", "I", "have", "not", "heard", "from", "home", "in", "A", "long", "time", "I", "gess", "that", "they", "have", "for", "got", "that", "they", "have", "A", "son", "in", "the", "army", "it", "is", "about", "2", "O", "Clock", "at", "night", "now", "I", "am", "on", "gard", "sitting", "by", "A", "big", "fire", "you", "must", "excuse", "my", "writing", "with", "A", "pencil", "for", "I", "can", "not", "get", "pen", "&", "ink", "to", "write", "with", "no", "more", "at", "present", "good", "by", "Directions", "the", "same"], "date": [], "normalizedTime": "0.196654426765", "recipient": "Walt Whitman", "organizations": ["Company"], "sender": "Bethuel Smith", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00601.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Bethuel Smith to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["William", "NNP"], ["E.", "NNP"], ["Vandemark", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["William Vandemark"], "money": [], "year": "1863", "locations": [], "month": "Dec", "parties": ["William E. Vandemark", "Walt Whitman"], "properDate": "Dec 16, 1863", "gpe": ["Dear", "Alexandria"], "facility": [], "latlngs": [[38.8048355, -77.0469214]], "text": " Dear brother and comrad I received a letter from yo this mornin dated the 13 and was very glad to hear from yo i am not very well i have good dele of pain in my hip and head i see by the tones of yiour letter that yo are not very well i hope by the time this letter reaches yo they may find yo well i know it is bad to loos a brother but the lord giveth and the lord taketh away an then we must all sooner or later give up this world    i had a few lines from home this morning my little girl is sick and i feeling bad to think that i cant see her now but my prays is that she may better soon  well father i am going to my ridgement i think the doctor marked so but i cant march we expect evry day to start for elickazandry [Alexandria] to the convalesent camp if i could get to the city i could get my discharge but i cant father i thank yo for seeing about my discriptave list for they owe me now six months pay and i want i very bad they paid all those that had thair discriptave lists the doctors here are meen for they have no feeing to a man father the wether is getting cold here now and i will be glad wen i get away from here i long to see yo and have a good talk with yo for yo have ben kind to me wen i Could not help my self and i hope the day may come wen i can do for yo some good in return for father you donte know how i do love you i donte know wy it is i am more attached yo than enny one that i was acquainted with  the papers gives us good news now conserning the war i hope theat peace may soone be proclaimed thair has been a grate many lives lost in the cruel war father i wish that yo would send yiour likenes and i will send yo mine & i wish that i could see yo i hope that i may soon see yo their is about 15 rebs here now they get all they want and the docters pays thair attention to the will the rebs  over our men like dogs now strange it is well it may be all for the best i hope they will turn thair corse before it is to late Deair father and Comrad i will close now good by and may god take care of yo and that we may soon meet from friend & son William Vandemark to  his comrad and father and friend ", "dateText": "", "percents": [], "taggedText": [[[["Dear", "NNP"]], ["brother", "NN"], ["and", "CC"], ["comrad", "VBD"], ["I", "PRP"], ["received", "VBD"], ["a", "DT"], ["letter", "NN"], ["from", "IN"], ["yo", "NN"], ["this", "DT"], ["mornin", "NN"], ["dated", "VBD"], ["the", "DT"], ["13", "CD"], ["and", "CC"], ["was", "VBD"], ["very", "RB"], ["glad", "VBN"], ["to", "TO"], ["hear", "VB"], ["from", "IN"], ["yo", "NN"], ["i", "PRP"], ["am", "VBP"], ["not", "RB"], ["very", "RB"], ["well", "RB"], ["i", "PRP"], ["have", "VBP"], ["good", "JJ"], ["dele", "NN"], ["of", "IN"], ["pain", "NN"], ["in", "IN"], ["my", "PRP$"], ["hip", "NN"], ["and", "CC"], ["head", "NN"], ["i", "PRP"], ["see", "VBP"], ["by", "IN"], ["the", "DT"], ["tones", "NNS"], ["of", "IN"], ["yiour", "PRP$"], ["letter", "NN"], ["that", "IN"], ["yo", "NN"], ["are", "VBP"], ["not", "