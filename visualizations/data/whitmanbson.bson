NNP"], ["st.", "NNP"], ["Camden", "NNP"]], [",", ","], ["N.J.", "NNP"], ["Aug.", "NNP"], ["7", "CD"], [".", "."]], [["All", "DT"], ["about", "IN"], ["the", "DT"], ["same", "JJ"], ["write", "NN"], ["to", "TO"], ["me", "PRP"], ["about", "IN"], ["Tasistro", "NNP"], ["in", "IN"], ["your", "PRP$"], ["next", "JJ"], ["Am", "NNP"], ["here", "RB"], ["partially", "RB"], ["alone", "RB"], ["folks", "NNS"], ["gone", "VBP"], ["to", "TO"], [["Atlantic", "NNP"]], ["city", "NN"], ["I", "PRP"], ["prefer", "VBP"], ["staying", "VBG"], ["here", "RB"], ["wish", "JJ"], ["you", "PRP"], ["was", "VBD"], ["here", "RB"], ["with", "IN"], ["me", "PRP"], ["head", "VBP"], ["aching", "VBG"], ["badly", "RB"], ["to-day", "JJ"], ["in", "IN"], ["good", "JJ"], ["spirits", "NNS"], ["though", "IN"], ["W.", "NNP"], ["W", "NNP"], [".", "."]]], "sentences": ["  431 Stevens st. Camden, N.J.           Aug. 7.", "All about the same   write to me about Tasistro in your next   Am here partially alone   folks gone to Atlantic city   I prefer staying here   wish you was here with me   head aching badly to-day   in good spirits though     W. W.        "], "words": ["431", "Stevens", "st.", "Camden", ",", "N.J.", "Aug.", "7.", "All", "about", "the", "same", "write", "to", "me", "about", "Tasistro", "in", "your", "next", "Am", "here", "partially", "alone", "folks", "gone", "to", "Atlantic", "city", "I", "prefer", "staying", "here", "wish", "you", "was", "here", "with", "me", "head", "aching", "badly", "to-day", "in", "good", "spirits", "though", "W.", "W", "."], "date": [], "normalizedTime": "0.725282197742", "recipient": "Peter Doyle", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/nyp.00351.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Peter Doyle ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["John", "NNP"]], ["and", "CC"], [["Ursula", "NNP"], ["Burroughs", "NNP"]], [",", ","]]], "people": ["Stevens st.", "Camden", "John", "John Swinton", "Wilson", "Tennyson", "Swinton"], "money": [], "year": "1874", "locations": ["West"], "month": "Aug", "parties": ["Walt", "Whitman", "John", "Ursula Burroughs"], "properDate": "Aug 18, 1874", "gpe": ["Boston", "Walt"], "facility": [], "latlngs": [[42.3584308, -71.0597732]], "text": "  431 Stevens st. / cor West. / Camden, / N. Jersey.           Aug. 18.                             Dear John & 'Sula Burroughs,        The interval of some weeks, (or is it months?) since I last wrote you has passed on, bringing no decided change          in my condition   in my bad spells, (& I have them often enough) I 'most think the end is not far off   but I get over them & my natural buoyancy re\u00e4sserts itself   (& in the main keeps control of the helm)   though to a man of my lazy-activity this whole condition & sickness of mine is very wearing    To-day I am feeling very comfortable, sitting here in the front room by the open window writing this   eat this morning quite a respectable breakfast, beefsteak, bread, & tea   & at about 3 shall make a light,          moderate bite of dinner   no supper   I find I get along best with one pretty fair-meal only,          & that I make breakfast   The gastric & dyspeptic trouble has been serious, & is perhaps so yet   pains in left side, distress in head, &c   the old story    John Swinton came down from N.Y. & spent Sunday with me   told me lots of N.Y. newspaper news,          &c.   it was a very welcome visit to me.        I was discharged from my clerkship on the last of June, by B. Wilson, the new Solicitor of the Treasury   (it is all right)   All questions of what I shall do are to me so subordinate to the question of whether         I shall soon or ever get well, (or partially well,) that I hardly entertain them seriously   I enclose you Tennyson's latest letter to me   also a slip Swinton gave me   Send them both back in your next letter   Eldridge is in Boston on his vacation   I expect a visit from him in about 12 days, on his way back   Best love to you both, & I shall be with you yet, I have no doubt.         Walt.        ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"]], ["/", "NNP"], ["cor", "NN"], [["West", "NNP"]], [".", "."]], [["/", "NN"], [["Camden", "NNP"]], [",", ","], ["/", "NNP"], ["N.", "NNP"], ["Jersey", "NNP"], [".", "."]], [["Aug.", "NNP"], ["18", "CD"], [".", "."]], [["Dear", "NNP"], [["John", "NNP"]], ["&", "CC"], ["'Sula", "NNP"], ["Burroughs", "NNP"], [",", ","], ["The", "NNP"], ["interval", "NN"], ["of", "IN"], ["some", "DT"], ["weeks", "NNS"], [",", ","], ["(", ":"], ["or", "CC"], ["is", "VBZ"], ["it", "PRP"], ["months", "VBZ"], ["?", "."]], [[")", "NN"], ["since", "IN"], ["I", "PRP"], ["last", "JJ"], ["wrote", "NN"], ["you", "PRP"], ["has", "VBZ"], ["passed", "VBN"], ["on", "IN"], [",", ","], ["bringing", "VBG"], ["no", "DT"], ["decided", "JJ"], ["change", "NN"], ["in", "IN"], ["my", "PRP$"], ["condition", "NN"], ["in", "IN"], ["my", "PRP$"], ["bad", "JJ"], ["spells", "NNS"], [",", ","], ["(", ":"], ["&", "CC"], ["I", "PRP"], ["have", "VBP"], ["them", "PRP"], ["often", "RB"], ["enough", "RB"], [")", ":"], ["I", "PRP"], ["'most", "VBP"], ["think", "VBP"], ["the", "DT"], ["end", "NN"], ["is", "VBZ"], ["not", "RB"], ["far", "RB"], ["off", "IN"], ["but", "CC"], ["I", "PRP"], ["get", "VBP"], ["over", "IN"], ["them", "PRP"], ["&", "CC"], ["my", "PRP$"], ["natural", "JJ"], ["buoyancy", "NN"], ["re\u00e4sserts", "NNS"], ["itself", "PRP"], ["(", "VBP"], ["&", "CC"], ["in", "IN"], ["the", "DT"], ["main", "JJ"], ["keeps", "NNS"], ["control", "NN"], ["of", "IN"], ["the", "DT"], ["helm", "NN"], [")", ":"], ["though", "IN"], ["to", "TO"], ["a", "DT"], ["man", "NN"], ["of", "IN"], ["my", "PRP$"], ["lazy-activity", "NN"], ["this", "DT"], ["whole", "NN"], ["condition", "NN"], ["&", "CC"], ["sickness", "NN"], ["of", "IN"], ["mine", "JJ