 in former note,                  I am anxious to have proofs as soon as possible.               Walt Whitman              ", "dateText": "", "percents": [], "taggedText": [[["Attorney", "NNP"], ["General", "NNP"], ["'s", "POS"], ["Office", "NNP"], [",", ","], [["Washington", "NNP"]], [".", "."]], [["March", "NNP"], ["10", "CD"], [",", ","], ["1868", "CD"], [".", "."]], [["Mr", "NNP"], ["Church", "NNP"], [".", "."]], [["My", "PRP$"], ["dear", "NN"], [["Sir", "NNP"]], [",", ","], ["I", "PRP"], ["write", "VBP"], ["a", "DT"], ["line", "NN"], ["to", "TO"], ["jog", "VB"], ["you", "PRP"], ["about", "IN"], ["the", "DT"], ["proofs", "NNS"], ["of", "IN"], [["Personalism", "NNP"]], [".", "."]], [["Is", "VBZ"], ["it", "PRP"], ["being", "VBG"], ["put", "VBN"], ["in", "RP"], ["type", "NN"], ["?", "."]], [["For", "IN"], ["reasons", "NNS"], ["as", "IN"], ["in", "IN"], ["former", "JJ"], ["note", "NN"], [",", ","], ["I", "PRP"], ["am", "VBP"], ["anxious", "JJ"], ["to", "TO"], ["have", "VB"], ["proofs", "NNS"], ["as", "IN"], ["soon", "RB"], ["as", "IN"], ["possible", "JJ"], [".", "."]], [[["Walt", "NNP"]], [["Whitman", "NNP"]]]], "sentences": ["  Attorney General's Office,                     Washington.", "March 10, 1868.", "Mr Church.", "My dear Sir,              I write a line to jog you about the proofs of Personalism.", "Is it being put in type?", "For reasons as in former note,                  I am anxious to have proofs as soon as possible.", "Walt Whitman              "], "words": ["Attorney", "General", "'s", "Office", ",", "Washington.", "March", "10", ",", "1868.", "Mr", "Church.", "My", "dear", "Sir", ",", "I", "write", "a", "line", "to", "jog", "you", "about", "the", "proofs", "of", "Personalism.", "Is", "it", "being", "put", "in", "type", "?", "For", "reasons", "as", "in", "former", "note", ",", "I", "am", "anxious", "to", "have", "proofs", "as", "soon", "as", "possible.", "Walt", "Whitman"], "date": [], "normalizedTime": "0.40690874473", "recipient": "Francis P.", "or