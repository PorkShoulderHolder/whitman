vals", ",", "and", "strong", "effect", "upon", "their", "readers", "who", "command", "the", "Press", ",", "we", "give", "you", "our", "hand", "again", "on", "paper", "and", "say", "goodbye", "Thayer", "&", "Eldridge"], "date": [], "normalizedTime": "0.0197198422413", "recipient": "Walt Whitman", "organizations": ["Grass", "Editorial Fraternity", "Wilkins5", "Times6", "News11 Herald", "Progress12 Journal", "Commerce13"], "sender": "Thayer", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00574.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Thayer & Eldridge to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], ["W.", "NNP"], ["W.", "NNP"], ["Thayer", "NNP"], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Hill", "Mr. Clapp", "Beach"], "money": [], "year": "1860", "locations": [], "month": "Jun", "parties": ["Walt Whitman"], "properDate": "Jun 5, 1860", "gpe": ["Boston", "Light", "Inasmuch", "Thayer"], "facility": [], "latlngs": [[42.3584308, -71.0597732], [36.5245064, -91.53819670000001]], "text": "  Boston June 5/60  Dear Walt    We sent you yesterday copy of Banner of Light c[illegible]ty critique as Leaves Grass written by Gen. Canning Hill,   He appreciates the Poems & you too2. Be assured he speaks truthfully and just as he believes & feels.    By the bye, will you please write for our consideration terms of contract for publishing L of G.?  We have been expecting said document, and now wish to have it adjusted as early as possible if agreeable to yourself.  Inasmuch as our \"writing\" has been submitted to you, your \"writing\" submitted to us will accommodate us if sent early.   We have so many things to think of that we would like to dispose of this contract & \"go on our way rejoicing\".   Regards to Mr. Clapp   &3 for yourself the \"fraternals\" of Thayer & Eldridge.  I think that Mrs. Beach's criticism is just about the damndest piece of scolding ever written by a woman who does not know what she is talking about4. My wife was indignant, and I should not wonder if she wrote a reply to it.   W. W. Thayer  ", "dateText": "", "percents": [], "taggedText": [[[["Boston", "NNP"]], ["June", "NNP"], ["5/60", "CD"], ["Dear", "NNP"], ["Walt", "NNP"], ["We", "NNP"], ["sent", "NN"], ["you", "PRP"], ["yesterday", "NN"], ["copy", "VBP"], ["of", "IN"], [["Banner", "NNP"]], ["of", "IN"], [["Light", "NNP"]], ["c", "NN"], ["[", ":"], ["illegible", "JJ"], ["]", "NN"], ["ty", "NN"], ["critique", "NN"], ["as", "IN"], [["Leaves", "NNP"], ["Grass", "NNP"]], ["written", "NN"], ["by", "IN"], ["Gen.", "NNP"], ["Canning", "NNP"], [["Hill", "NNP"]], [",", ","], ["He", "NNP"], ["appreciates", "VBZ"], ["the", "DT"], [["Poems", "NNP"]], ["&", "CC"], ["you", "PRP"], [["too2", "NNP"]], [".", "."]], [["Be", "VB"], ["assured", "VBN"], ["he", "PRP"], ["speaks", "VBZ"], ["truthfully", "RB"], ["and", "CC"], ["just", "RB"], ["as", "IN"], ["he", "PRP"], ["believes", "VBZ"], ["&", "CC"], ["feels", "NNS"], [".", "."]], [["By", "IN"], ["the", "DT"], ["bye", "NN"], [",", ","], ["will", "MD"], ["you", "PRP"], ["please", "VB"], ["write", "JJ"], ["for", "IN"], ["our", "PRP$"], ["consideration", "NN"], ["terms", "NNS"], ["of", "IN"], ["contract", "NN"], ["for", "IN"], ["publishing", "NN"], ["L", "NNP"], ["of", "IN"], ["G.", "NNP"], ["?", "."]], [["We", "PRP"], ["have", "VBP"], ["been", "VBN"], ["expecting", "VBG"], ["said", "VBD"], ["document", "NN"], [",", ","], ["and", "CC"], ["now", "RB"], ["wish", "JJ"], ["to", "TO"], ["have", "VB"], ["it", "PRP"], ["adjusted", "VBN"], ["as", "IN"], ["early", "JJ"], ["as", "IN"], ["possible", "JJ"], ["if", "IN"], ["agreeable", "JJ"], ["to", "TO"], ["yourself", "PRP"], [".", "."]], [[["Inasmuch", "JJ"]], ["as", "IN"], ["our", "PRP$"], ["``", "``"], ["writing", "VBG"], ["''", "''"], ["has", "VBZ"], ["been", "VBN"], ["submitted", "VBN"], ["to", "TO"], ["you", "PRP"], [",", ","], ["your", "PRP$"], ["`