her", "place"], "date": [], "normalizedTime": "0.218278253774", "recipient": "Thomas Jefferson Whitman", "organizations": ["Corps", "forth1", "Mass", "New England", "Sigel3", "Army", "Bell Plain"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00829.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to Thomas Jefferson Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], ["W.", "NNP"], ["E.", "NNP"], ["Worthen", "NNP"], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Appleton Ho"], "money": [], "year": "1864", "locations": [], "month": "May", "parties": ["Walt Whitman"], "properDate": "May 23, 1864", "gpe": ["New York"], "facility": [], "latlngs": [[40.7143528, -74.00597309999999]], "text": "  New York May 23  Dear Sir Enclosed find $20 which I have collected for yr Sanitary distribution.  I hope I shall be able to send more from time to time.  I am yrs try W. E. Worthen1 Address care of D. Appleton Ho.  ", "dateText": "", "percents": [], "taggedText": [[[["New", "NNP"], ["York", "NNP"]], ["May", "NNP"], ["23", "CD"], ["Dear", "NNP"], ["Sir", "NNP"], ["Enclosed", "NNP"], ["find", "NN"], ["$", "$"], ["20", "CD"], ["which", "WDT"], ["I", "PRP"], ["have", "VBP"], ["collected", "VBN"], ["for", "IN"], ["yr", "NN"], ["Sanitary", "NNP"], ["distribution", "NN"], [".", "."]], [["I", "PRP"], ["hope", "VBP"], ["I", "PRP"], ["shall", "MD"], ["be", "VB"], ["able", "JJ"], ["to", "TO"], ["send", "VB"], ["more", "JJR"], ["from", "IN"], ["time", "NN"], ["to", "TO"], ["time", "VB"], [".", "."]], [["I", "PRP"], ["am", "VBP"], ["yrs", "NNS"], ["try", "VBP"], ["W.", "NNP"], ["E.", "NNP"], ["Worthen1", "NNP"], ["Address", "NNP"], ["care", "NN"], ["of", "IN"], ["D.", "NNP"], [["Appleton", "NNP"], ["Ho", "NNP"]], [".", "."]]], "sentences": ["  New York May 23  Dear Sir Enclosed find $20 which I have collected for yr Sanitary distribution.", "I hope I shall be able to send more from time to time.", "I am yrs try W. E. Worthen1 Address care of D. Appleton Ho.  "], "words": ["New", "York", "May", "23", "Dear", "Sir", "Enclosed", "find", "$", "20", "which", "I", "have", "collected", "for", "yr", "Sanitary", "distribution.", "I", "hope", "I", "shall", "be", "able", "to", "send", "more", "from", "time", "to", "time.", "I", "am", "yrs", "try", "W.", "E.", "Worthen1", "Address", "care", "of", "D.", "Appleton", "Ho", "."], "date": [], "normalizedTime": "0.218278253774", "recipient": "Walt Whitman", "organizations": [], "sender": "", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00879.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from W. E. Worthen to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Louisa", "NNP"], ["Van", "NNP"], ["Velsor", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["George", "Jeff", "Han", "George", "Fred McReady", "Mother", "Oscar Cunningham", "Cutter", "Mother", "Jeff", "Jeff"], "money": [], "year": "1864", "locations": [], "month": "May", "parties": ["Walt Whitman", "Louisa Van Velsor Whitman"], "properDate": "May 25, 1864", "gpe": ["Washington", "Fredericksburgh", "Alexandria", "Fredericksburgh", "Jeff", "Pennsylvania", "Mother", "Nance", "Brooklyn", "New York", "Mat"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [38.8048355, -77.0469214], [40.65, -73.95], [40.7143528, -74.00597309999999]], "text": "  Washington |  May 25 1864  Dearest Mother I have not heard any thing of George or the reg't or Corps more than I have already written   I got Jeff's letter on Sunday, & wrote to him next day, which you have seen, mother, of course   I have written to Han & sent her George's letter to me dated 16th   I have heard that the 9th Corps has been moved to the extreme left of the Army   I should think by acc'ts this morning that the Army must be nearly half way from Fredericksburgh to Richmond1   the advance can't be more than 30 to 35 miles from there    I see Fred McReady about every other day, I have to go down to Alexandria, about 6 miles from here   he is doing quite well, but very tired of the confinement   I still go around daily & nightly among wounded   Mother, it is just the same old story, poor suffering young men, great swarms of them come up here, now, every day, all battered & bloody   there have 4000 arrived here this morning, & 1500 yesterday   they appear to be bringing them all up here from Fredericksburgh   the journey from the field till they get aboard the boats at Bell Plain is horrible   I believe I wrote several times about Oscar Cunningham, 82d Ohio, amputation of right leg, wounded over a year ago, a friend of mine here, he is rapidly sinking, said to me yesterday, O if he could only die   the young lad Cutter, of 1st Massachusetts heavy artillery, I was with Sunday afternoon, (I wrote about in Jeff's letter,) still holds out, poor boy, there is no chance for him at all    But, Mother, I shall make you gloomy enough if I go on with these kind of particulars   Only I know you like to hear about the poor young men, after I have once begun to mention them   Mother, I have changed my quarters   am at 502 Pennsylvania av. near 3d street, only a little way from the Capitol   where I was, the house was sold & the old lady I hired the room from had to move out & give the owner possession   I like my new quarters pretty well   I have a room to myself, 3d story hall bedroom, I have my meals in the house. Mother, it must be sad enough about Nance, & the young ones   is the little baby still hearty, I believe you wrote a few weeks after it was born that it was quite a fine child2   I see you had a draft in the 3d Congressional district, I was glad enough to see Jeff's name was not drawn   We have had it awful hot here, but there was a sharp storm of thunder & lightning last night, & to-day it is fine   Mother, do any of the soldiers I see here, from Brooklyn or New York, ever call upon you?   they sometimes say they will, here   tell Jeff I got a letter yesterday from W E Worthen, in which he sent me some money for the men, I have acknowledged it to Mr W by letter3   Well, dear mother, I must close, O how I want to see you all   I will surely have to come home as soon as this Richmond campaign is decided   then I want to print my next book   love to Mat   write to a fellow often as you can    Walt ", "dateText": "", "percents": [], "taggedText": [[[["Washington", "NNP"]], ["|", ":"], ["May", "NNP"], ["25", "CD"], ["1864", "CD"], ["Dearest", "NNP"], ["Mother", "NNP"], ["I", "NNP"], ["have", "VBP"], ["not", "RB"], ["heard", "VBN"], ["any", "DT"], ["thing", "NN"], ["of", "IN"], [["George", "NNP"]], ["or", "CC"], ["the", "DT"], ["reg't", "JJ"], ["or", "CC"], ["Corps", "NNP"], ["more", "RBR"], ["than", "IN"], ["I", "PRP"], ["have", "VBP"], ["already", "RB"], ["written", "VBN"], ["I", "PRP"], ["got", "VBD"], [["Jeff", "NNP"]], ["'s", "POS"], ["letter", "NN"], ["on", "IN"], ["Sunday", "NNP"], [",", ","], ["&", "CC"], ["wrote", "VBD"], ["to", "TO"], ["him", "PRP"], ["next", "JJ"], ["day", "NN"], [",", ","], ["which", "WDT"], ["you", "PRP"], ["have", "VBP"], ["seen", "VBN"], [",", ","], ["mother", "RB"], [",", ","], ["of", "IN"], ["course", "NN"], ["I", "PRP"], ["have", "VBP"], ["written", "VBN"], ["to", "TO"], [["Han", "NNP"]], ["&", "CC"], ["sent", "NN"], ["her", "PRP$"], [["George", "NNP"]], ["'s", "POS"], ["letter", "NN"], ["to", "TO"], ["me", "PRP"], ["dated", "VBD"], ["16th", "CD"], ["I", "PRP"], ["have", "VBP"], ["heard", "VBN"], ["that", "IN"], ["the", "DT"], ["9th", "JJ"], [["Corps", "NNP"]], ["has", "VBZ"], ["been", "VBN"], ["moved", "VBN"], ["to", "TO"], ["the", "DT"], ["extreme", "NN"], ["left", "VBD"], ["of", "IN"], ["the", "DT"], [["Army", "NNP"]], ["I", "NNP"], ["should", "MD"], ["think", "VB"], ["by", "IN"], ["acc