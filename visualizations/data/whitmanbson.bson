"], ["work", "NN"], [",", ","], ["&", "CC"], ["now", "RB"], ["they", "PRP"], ["are", "VBP"], ["to", "TO"], ["me", "PRP"], ["as", "IN"], ["a", "DT"], ["tale", "NN"], ["that", "WDT"], ["is", "VBZ"], ["told", "VBN"], ["Only", "RB"], ["the", "DT"], ["majestic", "JJ"], ["&", "CC"], ["moving", "VBG"], ["river", "NN"], ["&", "CC"], ["rapid", "JJ"], ["sea-water", "JJ"], ["scenery", "NN"], ["&", "CC"], ["life", "NN"], ["about", "IN"], ["the", "DT"], ["islands", "NNS"], [",", ","], ["N.", "NNP"], ["Y.", "NNP"], ["and", "CC"], [["Brooklyn", "NNP"]], [",", ","], ["tower", "NN"], ["into", "IN"], ["larger", "JJR"], ["proportions", "NNS"], ["than", "IN"], ["ever", "RB"], [".", "."]], [["I", "PRP"], ["doubt", "VBP"], ["if", "IN"], ["the", "DT"], ["world", "NN"], ["elsewhere", "RB"], ["has", "VBZ"], ["their", "PRP$"], ["equal", "JJ"], [",", ","], ["or", "CC"], ["could", "MD"], ["have", "VB"], [",", ","], ["to", "TO"], ["me", "PRP"], ["The", "DT"], ["waters", "NNS"], ["about", "IN"], [["New", "NNP"], ["York", "NNP"]], ["&", "CC"], ["west", "JJS"], ["end", "NN"], ["of", "IN"], [["Long-Island", "NNP"]], ["are", "VBP"], ["real", "JJ"], ["sea-waters", "NNS"], [",", ","], ["&", "CC"], ["are", "VBP"], ["ever-rolling", "JJ"], ["&", "CC"], ["rushing", "VBG"], ["in", "IN"], ["or", "CC"], ["out", "IN"], ["never", "RB"], ["placid", "JJ"], [",", ","], ["never", "RB"], ["calm", "NN"], ["surely", "RB"], ["they", "PRP"], ["please", "VBP"], ["this", "DT"], ["uneasy", "NN"], ["spirit", "NN"], [",", ","], [["Me", "NNP"]], [",", ","], ["that", "IN"], ["ebbs", "NNS"], ["&", "CC"], ["flows", "VBZ"], ["too", "RB"], ["all", "DT"], ["the", "DT"], ["while", "NN"], [",", ","], ["yet", "CC"], ["gets", "NNS"], ["nowhere", "RB"], [",", ","], ["&", "CC"], ["amounts", "NNS"], ["to", "TO"], ["nothing", "NN"], ["I", "PRP"], ["am", "VBP"], ["trying", "VBG"], ["to", "TO"], ["write", "VB"], ["a", "DT"], ["piece", "NN"], [",", ","], ["to", "TO"], ["be", "VB"], ["called", "VBN"], [["Democracy", "NNP"]], [",", ","], ["for", "IN"], ["the", "DT"], ["leading", "VBG"], ["article", "NN"], ["in", "IN"], ["the", "DT"], ["December", "NNP"], ["or", "CC"], ["January", "NNP"], ["number", "NN"], ["of", "IN"], ["the", "DT"], [["Galaxy", "NNP"]], ["in", "IN"], ["some", "DT"], ["sort", "NN"], ["a", "DT"], ["counterblast", "NN"], ["or", "CC"], ["rejoinder", "NN"], ["to", "TO"], [["Carlyle", "NNP"]], ["'s", "POS"], ["late", "JJ"], ["piece", "NN"], [",", ","], ["Shooting", "NNP"], ["Niagara", "NNP"], [",", ","], ["which", "WDT"], ["you", "PRP"], ["must", "MD"], ["have", "VB"], ["read", "VBN"], [",", ","], ["or", "CC"], ["at", "IN"], ["least", "JJS"], ["heard", "NN"], ["about", "IN"], [".", "."]], [[["Mr.", "NNP"]], [["Church", "NNP"]], ["strongly", "RB"], ["wishes", "VBZ"], ["it", "PRP"], ["written", "VBN"], [".", "."]], [[["Mother", "NNP"]], ["&", "CC"], [["Martha", "NNP"]], ["send", "NN"], ["love", "VBD"], [",", ","], ["&", "CC"], ["I", "PRP"], ["also", "RB"], [",", ","], ["most", "RBS"], ["truly", "RB"], ["I", "PRP"], ["shall", "MD"], ["probably", "RB"], ["return", "VB"], ["to", "TO"], [["Washington", "NNP"]], ["last", "JJ"], ["of", "IN"], ["the", "DT"], ["week", "NN"], [".", "."]], [[["Walt", "NNP"]], [".", "."]]], "sentences": ["  Brooklyn                     September 21, 1867                                  My dear friend,              As you see by the date, &c. I am home, on a visit to my mother & the rest.", "Mother is about as well as usual   has occasionally some trouble with                 rheumatism, but is cheerful & keeps up amazingly.", "We speak of you every day,                 & I have to give minute particulars of you, William, little Jenny, & all.", "My                 brother George is very well, looks hearty & brown as ever   much like he                 used to, only more serious   Jeff is at St. Louis, on the Water Works.", "Martha                 & the little girls are well   they are here in Brooklyn, occupying temporary                 apartments.", "I am well as usual, & go daily around New York & Brooklyn yet with interest,                 of course   but I find the places & crowds & excitements   Broadway,                 &c   have not the zest of former times   they have done their work,                 & now they are to me as a tale that is told   Only the majestic & moving                 river & rapid sea-water scenery & life about the islands, N. Y. and                 Brooklyn, tower into larger proportions than ever.", "I doubt if the world elsewhere                 has their equal, or could have, to me   The waters about New York & west end                 of Long-Island are real sea-waters, & are ever-rolling & rushing in or                 out   never placid, never calm   surely they please this uneasy spirit, Me,                 that ebbs & flows too all the while, yet gets nowhere, & amounts to                 nothing    I am trying to write a piece, to be called Democracy, for the                 leading article in the December or January number of the Galaxy   in some sort a counterblast or rejoinder to Carlyle's late                 piece, Shooting Niagara, which you must have read, or at least                 heard about.", "Mr. Church strongly wishes it written.", "Mother & Martha send love, & I also,                 most truly   I shall probably return to Washington last of the week.", "Walt.              "], "words": ["Brooklyn", "September", "21", ",", "1867", "My", "dear", "friend", ",", "As", "you", "see", "by", "the", "date", ",", "&", "c.", "I", "am", "home", ",", "on", "a", "visit", "to", "my", "mother", "&", "the", "rest.", "Mother", "is", "about", "as", "well", "as", "usual", "has", "occasionally", "some", "trouble", "with", "rheumatism", ",", "but", "is", "cheerful", "&", "keeps", "up", "amazingly.", "We", "speak", "of", "you", "every", "day", ",", "&", "I", "have", "to", "give", "minute", "particulars", "of", "you", ",", "William", ",", "little", "Jenny", ",", "&", "all.", "My", "brother", "George",