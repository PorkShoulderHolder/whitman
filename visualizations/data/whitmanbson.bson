. The July number for which it was [illegible]ded ought to be a light number for Summer reading:             this is an article that requires thought; cannot be read on cars &c, & ought to appear in soberer weather. But lest you should wish to use it elsewhere immediately I return the MS. in a separate package. I regret that there has been any delay in reaching this conclusion, but the                                                   question could not be decided hastily, in justice to you.                  I am                 Very truly yours                 F. P. Church              Mr Walt Whitman ", "dateText": "", "percents": [], "taggedText": [[["image", "NN"], ["1image", "NN"], ["2image", "NN"], ["3image", "NN"], ["4", "CD"], ["An", "DT"], [["Illustrated", "NNP"], ["Magazine", "NNP"]], ["of", "IN"], ["Entertaining", "NNP"], ["Reading", "NNP"], [".", "."]], [["Published", "JJ"], [["Monthly", "NNP"]], ["OFFICE", "NNP"], ["OF", "NNP"], ["THE", "NNP"], [["GALAXY", "NNP"], ["No", "NNP"]], [".", "."]], [["39", "CD"], [["Park", "NNP"], ["Row", "NNP"]], [",", ","], [["New", "NNP"], ["York", "NNP"]], [",", ","], ["May", "NNP"], ["15", "CD"], ["1868", "CD"], ["My", "NNP"], ["dear", "NN"], [["Sir", "NNP"]], [":", ":"], ["After", "IN"], ["thinking", "VBG"], ["over", "IN"], ["your", "PRP$"], ["article", "NN"], ["for", "IN"], ["several", "JJ"], ["days", "NNS"], [",", ","], ["&", "CC"], ["consulting", "VBG"], ["with", "IN"], ["[", "CD"], ["Mr.", "NNP"], ["?", "."]], [["]", "NN"], [["Sheldon", "NNP"]], ["(", "NNP"], ["who", "WP"], ["of", "IN"], ["course", "NN"], ["has", "VBZ"], ["no", "DT"], ["editorial", "NN"], ["control", "NN"], ["over", "IN"], ["The", "DT"], [["Galaxy", "NNP"]], [",", ","], ["but", "CC"], ["whose", "WP$"], ["opinion", "NN"], ["in", "IN"], ["courtesy", "NN"], ["I", "PRP"], ["am", "VBP"], ["bound", "RP"], ["to", "TO"], ["regard", "VB"], [")", ":"], ["I", "PRP"], ["am", "VBP"], ["obliged", "JJ"], ["to", "TO"], ["come", "VB"], ["to", "TO"], ["the", "DT"], [