"time": [], "heading": " Letter from Walt Whitman to Louisa Van Velsor Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Reuben", "NNP"], ["Farwell", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Dear", "Armory Suqare Hospital", "Expect", "Yours Affectionately"], "money": [], "year": "1864", "locations": [], "month": "Jun", "parties": ["Reuben Farwell", "Walt Whitman"], "properDate": "Jun 16, 1864", "gpe": ["Town"], "facility": [], "latlngs": [], "text": "   Dear Comrad I arrived in Town this forenoon and I have been trying to find your residence  But unseccessfull I came to Armory Suqare Hospital to learn whither you had gone The Boys do not know your whereabouts. S So I concluded to find out by dropping a few lines to you I hope my Dear Uncle that nothing has befallen you Either sickness or discontentment I would like to see you before I returne to The Front which will be on the 18th of this month. To morrow night I will remain here  If you have any desire or wish to see me Call or write me your address  I just come from the front & Expect to return soon   receive this from one who remembers you still  Yours Affectionately  ", "dateText": "", "percents": [], "taggedText": [[[["Dear", "NNP"]], [["Comrad", "NNP"]], ["I", "NNP"], ["arrived", "VBD"], ["in", "IN"], [["Town", "NNP"]], ["this", "DT"], ["forenoon", "NN"], ["and", "CC"], ["I", "PRP"], ["have", "VBP"], ["been", "VBN"], ["trying", "VBG"], ["to", "TO"], ["find", "VB"], ["your", "PRP$"], ["residence", "NN"], ["But", "CC"], ["unseccessfull", "JJ"], ["I", "PRP"], ["came", "VBD"], ["to", "TO"], [["Armory", "NNP"], ["Suqare", "NNP"], ["Hospital", "NNP"]], ["to", "TO"], ["learn", "VB"], ["whither", "NN"], ["you", "PRP"], ["had", "VBD"], ["gone", "VBN"], ["The", "DT"], ["Boys", "NNP"], ["do", "VBP"], ["not", "RB"], ["know", "VB"], ["your", "PRP$"], ["whereabouts", "NNS"], [".", "."]], [["S", "NNP"], ["So", "NNP"], ["I", "NNP"], ["concluded", "VBD"], ["to", "TO"], ["find", "VB"], ["out", "RP"], ["by", "IN"], ["dropping", "NN"], ["a", "DT"], ["few", "JJ"], ["lines", "NNS"], ["to", "TO"], ["you", "PRP"], ["I", "PRP"], ["hope", "VBP"], ["my", "PRP$"], ["Dear", "NNP"], ["Uncle", "NNP"], ["that", "IN"], ["nothing", "NN"], ["has", "VBZ"], ["befallen", "VBN"], ["you", "PRP"], ["Either", "NNP"], ["sickness", "NN"], ["or", "CC"], ["discontentment", "NN"], ["I", "PRP"], ["would", "MD"], ["like", "VB"], ["to", "TO"], ["see", "VB"], ["you", "PRP"], ["before", "IN"], ["I", "PRP"], ["returne", "VBP"], ["to", "TO"], ["The", "DT"], ["Front", "NNP"], ["which", "WDT"], ["will", "MD"], ["be", "VB"], ["on", "IN"], ["the", "DT"], ["18th", "JJ"], ["of", "IN"], ["this", "DT"], ["month", "NN"], [".", "."]], [["To", "TO"], ["morrow", "VB"], ["night", "NN"], ["I", "PRP"], ["will", "MD"], ["remain", "VB"], ["here", "RB"], ["If", "IN"], ["you", "PRP"], ["have", "VBP"], ["any", "DT"], ["desire", "NN"], ["or", "CC"], ["wish", "NN"], ["to", "TO"], ["see", "VB"], ["me", "PRP"], ["Call", "NNP"], ["or", "CC"], ["write", "VB"], ["me", "PRP"], ["your", "PRP$"], ["address", "NN"], ["I", "PRP"], ["just", "RB"], ["come", "VBP"], ["from", "IN"], ["the", "DT"], ["front", "NN"], ["&", "CC"], [["Expect", "NNP"]], ["to", "TO"], ["return", "VB"], ["soon", "RB"], ["receive", "JJ"], ["this", "DT"], ["from", "IN"], ["one", "CD"], ["who", "WP"], ["remembers", "NNS"], ["you", "PRP"], ["still", "RB"], [["Yours", "NNP"], ["Affectionately", "NNP"]]]], "sentences": ["   Dear Comrad I arrived in Town this forenoon and I have been trying to find your residence  But unseccessfull I came to Armory Suqare Hospital to learn whither you had gone The Boys do not know your whereabouts.", "S So I concluded to find out by dropping a few lines to you I hope my Dear Uncle that nothing has befallen you Either sickness or discontentment I would like to see you before I returne to The Front which will be on the 18th of this month.", "To morrow night I will remain here  If you have any desire or wish to see me Call or write me your address  I just come from the front & Expect to return soon   receive this from one who remembers you still  Yours Affectionately  "], "words": ["Dear", "Comrad", "I", "arrived", "in", "Town", "this", "forenoon", "and", "I", "have", "been", "trying", "to", "find", "your", "residence", "But", "unseccessfull", "I", "came", "to", "Armory", "Suqare", "Hospital", "to", "learn", "whither", "you", "had", "gone", "The", "Boys", "do", "not", "know", "your", "whereabouts.", "S", "So", "I", "concluded", "to", "find", "out", "by", "dropping", "a", "few", "lines", "to", "you", "I", "hope", "my", "Dear", "Uncle", "that", "nothing", "has", "befallen", "you", "Either", "sickness", "or", "discontentment", "I", "would", "like", "to", "see", "you", "before", "I", "returne", "to", "The", "Front", "which", "will", "be", "on", "the", "18th", "of", "this", "month.", "To", "morrow", "night", "I", "will", "remain", "here", "If", "you", "have", "any", "desire", "or", "wish", "to", "see", "me", "Call", "or", "write", "me", "your", "address", "I", "just", "come", "from", "the", "front", "&", "Expect", "to", "return", "soon", "receive", "this", "from", "one", "who", "remembers", "you", "still", "Yours", "Affectionately"], "date": [], "normalizedTime": "0.221542227662", "recipient": "Walt Whitman", "organizations": ["Comrad"], "sender": "Reuben Farwell", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/duk.00372.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Reuben Farwell to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Louisa", "NNP"], ["Van", "NNP"], ["Velsor", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["George", "Walt Mother"], "money": [], "year": "1864", "locations": [], "month": "Jun", "parties": ["Walt Whitman", "Louisa Van Velsor Whitman"], "properDate": "Jun 17, 1864", "gpe": ["Washington"], "facility": [], "latlngs": [[38.8951118, -77.0363658]], "text": "  Washington |  June 17 1864  Dearest Mother I got your letter this morning   this place & the hospitals seem to have got the better of me   I do not feel so badly this forenoon   but I have bad nights & bad days too, some of the spells are pretty bad   still I am up some & around every day   the doctors have told me for a fortnight I must leave, that I need an entire change of air, &c    I think I shall come home for a short time, & pretty soon   (I will try it two or three days yet, though, & if I find my illness goes over, I will stay here yet awhile   all I think about is to be here if any thing should happen to George)    We dont hear any thing more of the Army than you do there in the papers    Walt Mother, if I should come I will write a day or so before    ", "dateText": "", "percents": [], "taggedText": [[[["Washington", "NNP"]], ["|", ":"], ["June", "NNP"], ["17", "CD"], ["1864", "CD"], ["Dearest", "NNP"], ["Mother", "NNP"], ["I", "NNP"], ["got", "VBD"], ["your", "PRP$"], ["letter", "NN"], ["this", "DT"], ["morning", "NN"], ["this", "DT"], ["place", "NN"], ["&", "CC"], ["the", "DT"], ["hospitals", "NNS"], ["seem", "VBP"], ["to", "TO"], ["have", "VB"], ["got", "VBN"], ["the", "DT"], ["better", "JJR"], ["of", "IN"], ["me", "PRP"], ["I", "PRP"], ["do", "VBP"], ["not", "RB"], ["feel", "VB"], ["so", "RB"], ["badly", "RB"], ["this", "DT"], ["forenoon", "NN"], ["but", "CC"], ["I", "PRP"], ["have", "VBP"], ["bad", "JJ"], ["nights", "NNS"], ["&", "CC"], ["bad", "JJ"], ["days", "NNS"], ["too", "RB"], [",", ","], ["some", "DT"], ["of", "IN"], ["the", "DT"], ["spells", "NNS"], ["are", "VBP"], ["pretty", "RB"], ["bad", "JJ"], ["still", "RB"], ["I", "PRP"], ["am", "VBP"], ["up", "RP"], ["some", "DT"], ["&", "CC"], ["around", "IN"], ["every", "DT"], ["day", "NN"], ["the", "DT"], ["doctors", "NNS"], ["have", "VBP"], ["told", "VBN"], ["me", "PRP"], ["for", "IN"], ["a", "DT"], ["fortnight", 