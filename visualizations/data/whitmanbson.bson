Whitman"], "properDate": "May 21, 1860", "gpe": ["Walt", "Boston", "Boston", "New York", "Robt4", "Fred"], "facility": [], "latlngs": [[42.3584308, -71.0597732], [42.3584308, -71.0597732], [40.7143528, -74.00597309999999]], "text": " Dear Walt, I received your note this a.m. and I was very very much pleased to hear from you. I am right glad to hear your mission to Boston has terminated so successfully.2 I hope to God it may be not only a success as regards its typography, appearance and real worth, but also pecuniarily a success. For you know, \"A well filled pocket, now & then, is relished by the best of men.\"3 Walt, I hope you will be home soon. I want to see you very much indeed. I have never thought more frequently about you than during the time you have been in Boston. Make it your business to call and see me as soon as you arrive in New York, and we can make an appointment to pass some hours together. As I have much, very much to talk to you about. Robt4 and Mrs. Cooper5 send their love, Yours truly, Fred.   ", "dateText": "", "percents": [], "taggedText": [[[["Dear", "NNP"]], [["Walt", "NNP"]], [",", ","], ["I", "PRP"], ["received", "VBD"], ["your", "PRP$"], ["note", "NN"], ["this", "DT"], ["a.m.", "NNP"], ["and", "CC"], ["I", "PRP"], ["was", "VBD"], ["very", "RB"], ["very", "RB"], ["much", "RB"], ["pleased", "VBN"], ["to", "TO"], ["hear", "VB"], ["from", "IN"], ["you", "PRP"], [".", "."]], [["I", "PRP"], ["am", "VBP"], ["right", "RB"], ["glad", "JJ"], ["to", "TO"], ["hear", "VB"], ["your", "PRP$"], ["mission", "NN"], ["to", "TO"], [["Boston", "NNP"]], ["has", "VBZ"], ["terminated", "VBN"], ["so", "RB"], ["successfully.2", "-NONE-"], ["I", "PRP"], ["hope", "VBP"], ["to", "TO"], ["God", "NNP"], ["it", "PRP"], ["may", "MD"], ["be", "VB"], ["not", "RB"], ["only", "RB"], ["a", "DT"], ["success", "NN"], ["as", "IN"], ["regards", "NNS"], ["its", "PRP$"], ["typography", "NN"], [",", ","], ["appearance", "NN"], ["and", "CC"], ["real", "JJ"], ["worth", "NN"], [",", "