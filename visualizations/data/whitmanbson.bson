", "POS"], ["]", "NNP"], ["Lees6", "NNP"], ["used", "VBD"], ["to", "TO"], ["go", "VB"], ["at", "IN"], ["you", "PRP"], ["so", "RB"], ["roughly", "RB"], ["Do", "NNP"], ["you", "PRP"], ["remember", "VB"], ["those", "DT"], ["days", "NNS"], [["Walt", "NNP"]], [".", "."]], [["I", "PRP"], ["was", "VBD"], ["at", "IN"], ["home", "NN"], ["as", "IN"], ["usual", "JJ"], ["last", "JJ"], ["Sunday", "NNP"], ["but", "CC"], ["there", "EX"], ["was", "VBD"], ["nothing", "NN"], ["new", "JJ"], ["we", "PRP"], ["miss", "VBP"], ["you", "PRP"], ["very", "RB"], ["much", "RB"], ["of", "IN"], ["course", "NN"], [".", "."]], [[["Mother", "NNP"]], ["speaks", "VBZ"], ["very", "RB"], ["often", "RB"], ["of", "IN"], ["her", "PRP$"], ["small", "JJ"], ["family", "NN"], ["now", "RB"], ["and", "CC"], ["talks", "NNS"], ["of", "IN"], ["one", "CD"], ["room", "NN"], ["and", "CC"], ["bedroom", "NN"], ["&", "CC"], ["c", "NN"], [["Mattie", "NNP"]], ["remains", "VBZ"], ["the", "DT"], ["same", "JJ"], [",", ","], ["she", "PRP"], ["has", "VBZ"], ["plenty", "JJ"], ["to", "TO"], ["do", "VB"], ["and", "CC"], ["talks", "NNS"], ["of", "IN"], ["getting", "VBG"], ["a", "DT"], ["girl", "NN"], ["to", "TO"], ["do", "VB"], ["housework", "NN"], [".", "."]], [["I", "PRP"], ["'m", "VBP"], ["getting", "VBG"], ["to", "TO"], ["be", "VB"], ["quite", "RB"], ["a", "DT"], ["family", "NN"], ["man", "NN"], ["aint", "NN"], ["I.7", "-NONE-"], ["When", "WRB"], ["do", "VBP"], ["you", "PRP"], ["suppose", "VB"], ["you", "PRP"], ["will", "MD"], ["get", "VB"], ["through", "IN"], ["and", "CC"], ["come", "VB"], ["home", "NN"], [".", "."]], [[["Mother", "NNP"]], ["has", "VBZ"], ["heard", "VBN"], ["from", "IN"], ["you", "PRP"], ["several", "JJ"], ["times", "NNS"], ["and", "CC"], ["it", "PRP"], ["does", "VBZ"], ["her", "PRP$"], ["a", "DT"], ["great", "JJ"], ["deal", "NN"], ["of", "IN"], ["good.8", "NNP"], ["you", "PRP"], ["must", "MD"], ["write", "VB"], ["her", "PRP"], ["often", "RB"], ["and", "CC"], ["let", "VB"], ["me", "PRP"], ["hear", "VB"], ["from", "IN"], ["you", "PRP"], ["again", "RB"], ["before", "IN"], ["long", "RB"], [".", "."]], [["I", "PRP"], ["shall", "VBP"], ["write", "JJ"], ["to", "TO"], ["you", "PRP"], ["again", "RB"], ["presently", "RB"], [",", ","], ["now", "RB"], ["as", "IN"], ["you", "PRP"], ["will", "MD"], ["perceive", "VB"], ["I", "PRP"], ["am", "VBP"], ["rather", "RB"], ["hard", "RB"], ["up", "IN"], ["for", "IN"], ["something", "NN"], ["to", "TO"], ["write", "VB"], ["about", "IN"], [".", "."]], [["Your", "PRP$"], ["affectionate", "NN"], [["Brother", "NNP"], ["Jeff", "NNP"]]]], "sentences": ["  Jamaica, [New York,] April 3rd /60 Dear Brother Walt, I have just now received yours of the 1st.1 I should have written to you before but when I left home a week ago yesterday Mother said she would write to you that day, and I believe she did, its singular that you have not received it Everything remains abt.", "as usual with us Walt.", "Mother has taken the house and rented the lower part to a Mr \"John Brown\"2 @ $14 per month Mat and I keeping the same rooms as before.3 Andrew has been very sick but was getting better on Sunday when I was home.", "His disease commenced by a very violent pain in the side, kept up and made worse by an ignorent Dr. and those around him.4 Mother visited him most every day and kept his courage up I am truly glad Walt, that you are comfortably situated and the more so that you are having things done to suit you in the way of publishing your book.", "I quite long for it to make its appearence.", "What jolly times we will have reading the notices of it wont we.", "you must expect the \"Yam Yam Yam\" writer[s] to give you a dig as often as possible but I dont suppose you will mind it any more than you did in the days of your editorship of the B.", "[rooklyn] Eagle5 when the Advertiser['s] Lees6 used to go at you so roughly  Do you remember those days Walt.", "I was at home as usual last Sunday but there was nothing new  we miss you very much of course.", "Mother speaks very often of her small family now and talks of one room and bedroom &c  Mattie remains the same, she has plenty to do and talks of getting a girl to do housework.", "I'm getting to be quite a family man aint I.7 When do you suppose you will get through and come home.", "Mother has heard from you several times and it does her a great deal of good.8 you must write her often and let me hear from you again before long.", "I shall write to you again presently, now as you will perceive I am rather hard up for something to write about.", "Your affectionate Brother Jeff"], "words": ["Jamaica", ",", "[", "New", "York", ",", "]", "April", "3rd", "/60", "Dear", "Brother", "Walt", ",", "I", "have", "just", "now", "received", "yours", "of", "the", "1st.1", "I", "should", "have", "written", "to", "you", "before", "but", "when", "I", "left", "home", "a", "week", "ago", "yesterday", "Mother", "said", "she", "would", "write", "to", "you", "that", "day", ",", "and", "I", "believe", "she", "did", ",", "its", "singular", "that", "you", "have", "not", "received", "it", "Everything", "remains", "abt.", "as", "usual", "with", "us", "Walt.", "Mother", "has", "taken", "the", "house", "and", "rented", "the", "lower", "part", "to", "a", "Mr", "``", "John", "Brown", "''", "2", "@", "$", "14", "per", "month", "Mat", "and", "I", "keeping", "the", "same", "rooms", "as", "before.3", "Andrew", "has", "been", "very", "sick", "but", "was", "getting", "better", "on", "Sunday", "when", "I", "was", "home.", "His", "disease", "commenced", "by", "a", "very", "violent", "pain", "in", "the", "side", ",", "kept", "up", "and", "made", "worse", "by", "an", "ignorent", "Dr.", "and", "those", "around", "him.4", "Mother", "visited", "him", "most", "every", "day", "and", "kept", "his", "courage", "up", "I", "am", "truly", "glad", "Walt", ",", "that", "you", "are", "comfortably", "situated", "and", "the", "more", "so", "that", "you", "are", "having", "things", "done", "to", "suit", "you", "in", "the", "way", "of", "publishing", "your", "book.", "I", "quite", "long", "for", "it", "to", "make", "its", "appearence.", "What", "jolly", "times", "we", "will", "have", "reading", "the", "notices", "of", "it", "wont", "we.", "you", "must", "expect", "the", "``", "Yam", "Yam", "Yam", "''", "writer", "[", "s", "]", "to", "give", "you", "a", "dig", "as", "often", "as", "possible", "but", "I", "dont", "suppose", "you", "will", "mind", "it", "any", "more", "than", "you", "did", "in", "the", "days", "of", "your", "editorship", "of", "the", "B.", "[", "rooklyn", "]", "Eagle5", "when", "the", "Advertiser", "[", "'s", "]", "Lees6", "used", "to", "go", "at", "you", "so", "roughly", "Do", "you", "remember", "those", "days", "Walt.", "I", "was", "at", "home", "as", "usual", "last", "Sunday", "but", "there", "was", "nothing", "new", "we", "miss", "you", "very", "much", "of", "course.", "Mother", "speaks", "very", "often", "of", "her", "small", "family", "now", "and", "talks", "of", "one", "room", "and", "bedroom", "&", "c", "Mattie", "remains", "the", "same", ",", "she", "has", "plenty", "to", "do", "and", "talks", "of", "getting", "a", "girl", "to", "do", "housework.", "I", "'m", "getting", "to", "be", "quite", "a", "family", "man", "aint", "I.7", "When", "do", "you", "suppose", "you", "will", "get", "through", "and", "come", "home.", "Mother", "has", "heard", "from", "you", "several", "times", "and", "it", "does", "her", "a", "great", "deal", "of", "good.8", "you", "must", "write", "her", "often", "and", "let", "me", "hear", "from", "you", "again", "before", "long.", "I", "shall", "write", "to", "you", "again", "presently", ",", "now", "as", "you", "will", "perceive", "I", "am", "rather", "hard", "up", "for", "something", "to", "write", "about.", "Your", "affectionate", "Brother", "Jeff"], "date": [], "normalizedTime": "0.0127838977288", "recipient": "Walt Whitman", "organizations": ["Advertiser"], "sender": "Thomas Jefferson Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00392.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Thomas Jefferson Whitman to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], ["O.", "NNP"], ["K.", "NNP"], ["Sammis", "NNP"], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Friend", "Sammis To Walt Whitman"], "money": [], "year": "1860", "locations": [], "month": "Apr", "parties": ["Walt Whitman"], "properDate": "Apr 6, 1860", "gpe": ["Brooklyn", "Boston", "Grass", "Boston", "Accept"], "facility": [], "latlngs": [[40.65, -73.95], [42.3584308, -71.0597732], [42.3584308, -71.0597732]], "text": "  Brooklyn April 6, 1860 Box [illegible] P.O.  Friend Walter    I design [bearly?] to say How do you do, while you are in Boston, & to express my own pleasure at hearing that your \"Leaves of Grass,\" in its next issue, is to [eminate?] from that City.  It will hereafter be read in your day.  Every N.E. yankee factory girl will read and re-read it from an unconquerable passion, for to every N.E. mind its unfathomable inspirations willst be \"New every morning and fresh every evening.\"  I know what is your mental fare in Boston from my own past personal experience and without wishing to intrude myself above my true level I could wish I were, at least, a stander-by. How shall I rise to life (action), is, now, my all pressing & all urgent question.  Let me have a line in regard to your experience in it, if convenient.  Accept my affectionate regards. O. K. Sammis To Walt Whitman.  ", "dateText": "", "percents": [], "taggedText": [[[["Brooklyn", "NNP"]], ["April", "NNP"], ["6", "CD"], [",", ","], ["1860", "CD"], ["Box", "NNP"], ["[", "NNP"], ["illegible", "JJ"], ["]", "NN"], ["P.O", "-NONE-"], [".", "."]], [[["Friend", "NN"]], ["Walter", "NNP"], ["I", "PRP"], ["design", "VBP"], ["[", ":"], ["bearly", "RB"], ["?", "."]], [["]", "NN"], ["to", "TO"], ["say", "VB"], ["How", "WRB"], ["do", "VB"], ["you", "PRP"], ["do", "VB"], [",", ","], ["while", "IN"], ["you", "PRP"], ["are", "VBP"], ["in", "IN"], [["Boston", "NNP"]], [",", ","], ["&", "CC"], ["to", "TO"], ["express", "NN"], ["my", "PRP$"], ["own", "JJ"], ["pleasure", "NN"], ["at", "IN"], ["hearing", "NN"], ["that", "IN"], ["your", "PRP$"], ["``", "``"], ["Leaves", "NNP"], ["of", "IN"], [["Grass", "NNP"]], [",", ","], ["''", "''"], ["in", "IN"], ["its", "PRP$"], ["next", "JJ"], ["issue", "NN"], [",", ","], ["is", "VBZ"], ["to", "TO"], ["[", "CD"], ["eminate", "NN"], ["?", "."]], [["]", "NN"], ["from", "IN"], ["that", "DT"], ["City", "NNP"], [".", "."]], [["It", "PRP"], ["will", "MD"], ["hereafter", "VB"], ["be", "VB"], ["read", "VBN"], ["in", "IN"], ["your", "PRP$"], ["day", "NN"], [".", "."]], [["Every", "DT"], ["N.E", "JJ"], [".", "."]], [["yankee", "NN"], ["factory", "NN"], ["girl", "NN"], ["will", "MD"], ["read", "VB"], ["and", "CC"], ["re-read", "JJ"], ["it", "PRP"], ["from", "IN"], ["an", "DT"], ["unconquerable", "JJ"], ["passion", "NN"], [",", ","], ["for", "IN"], ["to", "TO"], ["every", "DT"], ["N.E", "JJ"], [".", "."]], [["mind", "NN"], ["its", "PRP$"], ["unfathomable", "JJ"], ["inspirations", "NNS"], ["willst", "VBP"], ["be", "VB"], ["``", "``"], ["New", "NNP"], ["every", "DT"], ["morning", "NN"], ["and", "CC"], ["fresh", "JJ"], ["every", "DT"], ["evening", "NN"], [".", "."]], [["``", "``"], ["I", "PRP"], ["know", "VBP"], ["what", "WP"], ["is", "VBZ"], ["your", "PRP$"], ["mental", "JJ"], ["fare", "NN"], ["in", "IN"], [["Boston", "NNP"]], ["from", "IN"], ["my", "PRP$"], ["own", "JJ"], ["past", "NN"], ["personal", "JJ"], ["experience", "NN"], ["and", "CC"], ["without", "IN"], ["wishing", "NN"], ["to", "TO"], ["intrude", "VB"], ["myself", "PRP"], ["above", "IN"], ["my", "PRP$"], ["true", "NN"], ["level", "NN"], ["I", "PRP"], ["could", "MD"], ["wish", "VB"], ["I", "PRP"], ["were", "VBD"], [",", ","], ["at", "IN"], ["least", "JJS"], [",", ","], ["a", "DT"], ["stander-by", "JJ"], [".", "."]], [["How", "WRB"], ["shall", 