 "PRP"], ["works", "VBZ"], ["every", "DT"], ["day", "NN"], ["in", "IN"], ["the", "DT"], ["yard", "NN"], [".", "."]], [["He", "PRP"], ["does", "VBZ"], ["not", "RB"], ["seem", "VB"], ["to", "TO"], ["mind", "VB"], ["the", "DT"], ["heat", "NN"], [".", "."]], [["He", "PRP"], ["is", "VBZ"], ["employed", "VBN"], ["in", "IN"], ["the", "DT"], ["store-house", "JJ"], [",", ","], ["where", "WRB"], ["they", "PRP"], ["are", "VBP"], ["continually", "RB"], ["busy", "JJ"], ["preparing", "NN"], ["stores", "NNS"], [",", ","], ["provisions", "NNS"], [",", ","], ["to", "TO"], ["send", "VB"], ["off", "RP"], ["in", "IN"], ["the", "DT"], ["different", "JJ"], ["vessels", "NNS"], [".", "."]], [["He", "PRP"], ["assists", "VBZ"], ["in", "IN"], ["that", "DT"], [".", "."]], [["We", "PRP"], ["are", "VBP"], ["all", "RB"], ["very", "RB"], ["glad", "JJ"], ["the", "DT"], ["13th", "JJ"], ["is", "VBZ"], ["coming", "VBG"], ["home", "NN"], ["mother", "NN"], ["especially", "RB"], [".", "."]], [["There", "EX"], ["have", "VBP"], ["been", "VBN"], ["so", "RB"], ["many", "JJ"], ["accounts", "NNS"], ["of", "IN"], ["shameful", "JJ"], ["negligence", "NN"], [",", ","], ["or", "CC"], ["worse", "VB"], [",", ","], ["in", "IN"], ["the", "DT"], ["commissariat", "NN"], ["of", "IN"], ["your", "PRP$"], ["reg't", "JJ"], [".", "."]], [["that", "DT"], ["there", "EX"], ["must", "MD"], ["be", "VB"], ["something", "NN"], ["in", "IN"], ["it", "PRP"], ["notwithstanding", "VBG"], ["you", "PRP"], ["speak", "VBP"], ["very", "RB"], ["lightly", "RB"], ["of", "IN"], ["the", "DT"], ["complaints", "NNS"], ["in", "IN"], ["your", "PRP$"], ["letters", "NNS"], [".", "."]], [["The", "DT"], [["Eagle", "NNP"]], [",", ","], ["of", "IN"], ["course", "NN"], [",", ","], ["makes", "VBZ"], ["the", "DT"], ["worst", "JJS"], ["of", "IN"], ["it", "PRP"], [",", ","], ["every", "DT"], ["day", "NN"], [",", ","], ["to", "TO"], ["stop", "VB"], ["men", "NNS"], ["from", "IN"], ["enlisting.4", "-NONE-"], ["All", "DT"], ["of", "IN"], ["us", "PRP"], ["here", "RB"], ["think", "VBP"], ["the", "DT"], ["rebellion", "NN"], ["as", "IN"], ["good", "JJ"], ["as", "IN"], ["broke", "NN"], ["no", "DT"], ["matter", "NN"], ["if", "IN"], ["the", "DT"], ["war", "NN"], ["does", "VBZ"], ["continue", "VB"], ["for", "IN"], ["months", "NNS"], ["yet", "RB"], [".", "."]], [[["Walt", "NNP"]], [".", "."]]], "sentences": ["  [B]rooklyn,  | [Friday]1 July 12th, 1861.", "Dear Brother, Your letter come to-day.", "Every thing with us is pretty much the same.", "Mother is pretty much the same.", "Some days she [is] better, and some not so well.", "She has taken a good many sulphur vapor baths.", "She takes one every other day.", "She goes down in the cars to the baths, in Willoughby street near the City Hall.2 Sometimes Mat goes with her, [and once in] a while she goes [alo]ne.", "They are rather agreeable to take   they make one sweat extremely.", "Mother goes about the same, around the house.", "She has better use of her arms and wrists than she did there one time   but an hour or two, now and then, generally in the morning, she has bad pains.", "Her appetite is pretty good.", "The weather here lately has been awful   three days the heat was as bad as I ever knew it   so I think that had something to do with mother's feeling weak.", "To-day it is much cooler.", "Jeff and Martha and Cis3 and Eddy are all well.", "Jess is the same as usual   he works every day in the yard.", "He does not seem to mind the heat.", "He is employed in the store-house, where they are continually busy preparing stores, provisions, to send off in the different vessels.", "He assists in that.", "We are all very glad the 13th is coming home   mother especially.", "There have been so many accounts of shameful negligence, or worse, in the commissariat of your reg't.", "that there must be something in it   notwithstanding you speak very lightly of the complaints in your letters.", "The Eagle, of course, makes the worst of it, every day, to stop men from enlisting.4 All of us here think the rebellion as good as broke   no matter if the war does continue for months yet.", "Walt. "], "words": ["[", "B", "]", "rooklyn", ",", "|", "[", "Friday", "]", "1", "July", "12th", ",", "1861.", "Dear", "Brother", ",", "Your", "letter", "come", "to-day.", "Every", "thing", "with", "us", "is", "pretty", "much", "the", "same.", "Mother", "is", "pretty", "much", "the", "same.", "Some", "days", "she", "[", "is", "]", "better", ",", "and", "some", "not", "so", "well.", "She", "has", "taken", "a", "good", "many", "sulphur", "vapor", "baths.", "She", "takes", "one", "every", "other", "day.", "She", "goes", "down", "in", "the", "cars", "to", "the", "baths", ",", "in", "Willoughby", "street", "near", "the", "City", "Hall.2", "Sometimes", "Mat", "goes", "with", "her", ",", "[", "and", "once", "in", "]", "a", "while", "she", "goes", "[", "alo", "]", "ne.", "They", "are", "rather", "agreeable", "to", "take", "they", "make", "one", "sweat", "extremely.", "Mother", "goes", "about", "the", "same", ",", "around", "the", "house.", "She", "has", "better", "use", "of", "her", "arms", "and", "wrists", "than", "she", "did", "there", "one", "time", "but", "an", "hour", "or", "two", ",", "now", "and", "then", ",", "generally", "in", "the", "morning", ",", "she", "has", "bad", "pains.", "Her", "appetite", "is", "pretty", "good.", "The", "weather", "here", "lately", "has", "been", "awful", "three", "days", "the", "heat", "was", "as", "bad", "as", "I", "ever", "knew", "it", "so", "I", "think", "that", "had", "something", "to", "do", "with", "mother", "'s", "feeling", "weak.", "To-day", "it", "is", "much", "cooler.", "Jeff", "and", "Martha", "and", "Cis3", "and", "Eddy", "are", "all", "well.", "Jess", "is", "the", "same", "as", "usual", "he", "works", "every", "day", "in", "the", "yard.", "He", "does", "not", "seem", "to", "mind", "the", "heat.", "He", "is", "employed", "in", "the", "store-house", ",", "where", "they", "are", "continually", "busy", "preparing", "stores", ",", "provisions", ",", "to", "send", "off", "in", "the", "different", "vessels.", "He", "assists", "in", "that.", "We", "are", "all", "very", "glad", "the", "13th", "is", "coming", "home", "mother", "especially.", "There", "have", "been", "so", "many", "accounts", "of", "shameful", "negligence", ",", "or", "worse", ",", "in", "the", "commissariat", "of", "your", "reg't.", "that", "there", "must", "be", "something", "in", "it", "notwithstanding", "you", "speak", "very", "lightly", "of", "the", "complaints", "in", "your", "letters.", "The", "Eagle", ",", "of", "course", ",", "makes", "the", "worst", "of", "it", ",", "every", "day", ",", "to", "stop", "men", "from", "enlisting.4", "All", "of", "us", "here", "think", "the", "rebellion", "as", "good", "as", "broke", "no", "matter", "if", "the", "war", "does", "continue", "for", "months", "yet.", "Walt", "."], "date": [], "normalizedTime": "0.0760233918129", "recipient": "George Washington Whitman", "organizations": ["Brother", "Cis3"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/duk.00378.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to George Washington Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["James", "NNP"], ["Russell", "NNP"], ["Lowell", "NNP"]], [",", ","]]], "people": ["Mr. Lowell", "Dear Sir"], "money": [], "year": "1861", "locations": [], "month": "Oct", "parties": ["Walt Whitman", "James Russell Lowell"], "properDate": "Oct 1, 1861", "gpe": ["Brooklyn"], "facility": [], "latlngs": [[40.65, -73.95]], "text": "  Brooklyn |  Tuesday morning October 1st | 1861  Mr. Lowell, Dear Sir: The price of \"1861,\" if you print it, is $20. You are at liberty to make any verbal alterations. The envelope is of course to return it in, if you cannot use it.2 Yours truly W. Whitman ", "dateText": "", "percents": [], "taggedText": [[[["Brooklyn", "NNP"]], ["|", ":"], ["Tuesday", "NNP"], ["morning", "NN"], ["October", "NNP"], ["1st", "CD"], ["|", "CD"], ["1861", "CD"], [["Mr.", "NNP"], ["Lowell", "NNP"]], [",", ","], [["Dear", "NNP"], ["Sir", "NNP"]], [":", ":"], ["The", "DT"], ["price", "NN"], ["of", "IN"], ["``", "``"], ["1861", "CD"], [",", ","], ["''", "''"], ["if", "IN"], ["you", "PRP"], ["print", "VBP"], ["it", "PRP"], [",", ","], ["is", "VBZ"], ["$", "$"], ["20", "CD"], [".", "."]], [["You", "PRP"], ["are", "VBP"], ["at", "IN"], ["liberty", "NN"], ["to", "TO"], ["make", "VB"], ["any", "DT"], ["verbal", "JJ"], ["alterations", "NNS"], [".", "."]], [["The", "DT"], ["envelope", "NN"], ["is", "VBZ"], ["of", "IN"], ["course", "NN"], ["to", "TO"], ["return", "VB"], ["it", "PRP"], ["in", "IN"], [",", ","], ["if", "IN"], ["you", "PRP"], ["can", "MD"], ["not", "RB"], ["use", "VB"], ["it.2", "-NONE-"], ["Yours", "NNP"], ["truly", "RB"], ["W.", "NNP"], ["Whitman", "NNP"]]], "sentences": ["  Brooklyn |  Tuesday morning October 1st | 1861  Mr. Lowell, Dear Sir: The price of \"1861,\" if you print it, is $20.", "You are at liberty to make any verbal alterations.", "The envelope is of course to return it in, if you cannot use it.2 Yours truly W. Whitman "], "words": ["Brooklyn", "|", "Tuesday", "morning", "October", "1st", "|", "1861", "Mr.", "Lowell", ",", "Dear", "Sir", ":", "The", "price", "of", "``", "1861", ",", "''", "if", "you", "print", "it", ",", "is", "$", "20.", "You", "are", "at", "liberty", "to", "make", "any", "verbal", "alterations.", "The", "envelope", "is", "of", "course", "to", "return", "it", "in", ",", "if", "you", "can", "not", "use", "it.2", "Yours", "truly", "W.", "Whitman"], "date": [], "normalizedTime": "0.0870393036856", "recipient": "James Russell Lowell", "organizations": [], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/prc.00004.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to James Russell Lowell ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["James", "NNP"], ["Russell", "NNP"], ["Lowell", "NNP"]], [",", ","]]], "people": ["Mr."], "money": [], "year": "1861", "locations": [], "month": "Oct", "parties": ["Walt Whitman", "James Russell Lowell"], "properDate": "Oct 2, 1861", "gpe": ["Brooklyn"], "facility": [], "latlngs": [[40.65, -73.95]], "text": "  Brooklyn, / Wednesday morning, October 2, 1861.  Mr. Lowell,1 Dear Sir: I also send you two more little pieces, to take their chances for the magazine. The price, if you take them, will be $8 each. I forgot to say, with the one I sent yesterday, that whatever pieces are printed, I reserve the right to include them in any future collection of my poems.  yours, W. Whitman  ", "dateText": "", "percents": [], "taggedText": [[[["Brooklyn", "NNP"]], [",", ","], ["/", "NNP"], ["Wednesday", "NNP"], ["morning", "NN"], [",", ","], ["October", "NNP"], ["2", "CD"], [",", ","], ["1861", "CD"], [".", "."]], [[["Mr.", "NNP"]], ["Lowell,1", "NNP"], ["Dear", "NNP"], ["Sir", "NNP"], [":", ":"], ["I", "PRP"], ["also", "RB"], ["send", "VBP"], ["you", "PRP"], ["two", "CD"], ["more", "JJR"], ["little", "JJ"], ["pieces", "NNS"], [",", ","], ["to", "TO"], ["take", "VB"], ["their", "PRP$"], ["chances", "NNS"], ["for", "IN"], ["the", "DT"], ["magazine", "NN"], [".", "."]], [["The", "DT"], ["price", "NN"], [",", ","], ["if", "IN"], ["you", "PRP"], ["take", "VBP"], ["them", "PRP"], [",", ","], ["will", "MD"], ["be", "VB"], ["$", "$"], ["8", "CD"], ["each", "DT"], [".", "."]], [["I", "PRP"], ["forgot", "VBD"], ["to", "TO"], ["say", "VB"], [",", ","], ["with", "IN"], ["the", "DT"], ["one", "CD"], ["I", "PRP"], ["sent", "VBD"], ["yesterday", "NN"], [",", ","], ["that", "IN"], ["whatever", "NN"], ["pieces", "NNS"], ["are", "VBP"], ["printed", "VBN"], [",", ","], ["I", "PRP"], ["reserve", "VBP"], ["the", "DT"], ["right", "NN"], ["to", "TO"], ["include", "V