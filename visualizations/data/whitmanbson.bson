 ["trenches", "NNS"], ["in", "IN"], ["front", "JJ"], ["of", "IN"], [["Petersburgh", "NNP"]], [",", ","], ["my", "PRP$"], ["term", "NN"], ["of", "IN"], [["Service", "NNP"]], ["having", "VBG"], ["expired", "VBN"], [",", ","], ["after", "IN"], ["three", "CD"], ["years", "NNS"], ["Service", "NNP"], ["from", "IN"], ["Oct", "NNP"], ["1861.", "CD"], ["on", "IN"], ["arriving", "NN"], ["at", "IN"], [["Washington", "NNP"]], ["I", "NNP"], ["tried", "VBD"], ["to", "TO"], ["find", "VB"], ["you", "PRP"], ["but", "CC"], ["could", "MD"], ["not", "RB"], [".", "."]], [["when", "WRB"], ["you", "PRP"], ["first", "RB"], ["met", "VBD"], ["me", "PRP"], [",", ","], ["on", "IN"], ["leaving", "NN"], ["you", "PRP"], ["you", "PRP"], ["gave", "VBD"], ["me", "PRP"], ["a", "DT"], ["small", "JJ"], ["book", "NN"], ["of", "IN"], ["poems", "NNS"], ["with", "IN"], ["your", "PRP$"], ["name", "NN"], ["in", "IN"], ["it", "PRP"], [",", ","], ["bidding", "VBG"], ["me", "PRP"], ["think", "VBP"], ["of", "IN"], ["you", "PRP"], [".", "."]], [["I", "PRP"], ["stowed", "VBD"], ["it", "PRP"], ["away", "RB"], ["in", "IN"], ["my", "PRP$"], ["knapsack", "NN"], ["but", "CC"], ["loosing", "VBG"], ["that", "IN"], ["I", "PRP"], ["lost", "VBD"], ["your", "PRP$"], ["gift", "NN"], [".", "."]], [["I", "PRP"], ["would", "MD"], ["like", "VB"], ["a", "DT"], ["duplicate", "JJ"], [",", ","], ["if", "IN"], ["it", "PRP"], ["is", "VBZ"], ["not", "RB"], ["presuming", "VBG"], ["too", "RB"], ["much", "RB"], [".", "."]], [["I", "PRP"], ["trust", "VBP"], ["you", "PRP"], ["will", "MD"], ["not", "RB"], ["think", "VB"], ["me", "PRP"], ["forward", "RB"], ["in", "IN"], ["this", "DT"], [".", "."]], [["With", "IN"], ["many", "JJ"], ["and", "CC"], ["kind", "NN"], ["regards", "NNS"], [["Very", "NNP"], ["Respectfully", "NNP"], ["Yours", "NNP"], ["Hugh", "NNP"]], ["B.", "NNP"], ["Thomson", "NNP"], ["242", "CD"], ["Canal", "NNP"], ["St", "NNP"], [["New", "NNP"], ["York", "NNP"], ["City", "NNP"]], [".", "."]]], "sentences": ["  New York December 5, 1866 Walt Whitman Esq.", "Dear Sir.", "The undersigned though a comparative stranger to you feels himself drawn toward you closer and closer after perusing your \"Leaves of Grass.", "\"  We have a sympathy in common with you.", "in some of these well wrought passages the experiences taught there has been one to some extent.", "While doing garrison duty with my regiment the 2nd New York Arty on the works South of the Potomac I visited Washington in company with a comrade named Charles String of Connecticut and by him introduced to you at your studio.", "(I forget the street) but it was not far removed from the avenue.", "if I mistake not, you accompanied us to the theatre at night.", "I have never forgotten you since, remembering you as a friend to the Union and the \"boys\" striving to keep it together.", "I left the regiment in the trenches in front of Petersburgh, my term of Service having expired, after three years Service from Oct 1861.  on arriving at Washington I tried to find you but could not.", "when you first met me, on leaving you you gave me a small book of poems with your name in it, bidding me think of you.", "I stowed it away in my knapsack but loosing that I lost your gift.", "I would like a duplicate, if it is not presuming too much.", "I trust you will not think me forward in this.", "With many and kind regards  Very Respectfully Yours Hugh B. Thomson 242 Canal St New York City.  "], "words": ["New", "York", "December", "5", ",", "1866", "Walt", "Whitman", "Esq.", "Dear", "Sir.", "The", "undersigned", "though", "a", "comparative", "stranger", "to", "you", "feels", "himself", "drawn", "toward", "you", "closer", "and", "closer", "after", "perusing", "your", "``", "Leaves", "of", "Grass.", "''", "We", "have", "a", "sympathy", "in", "common", "with", "you.", "in", "some", "of", "these", "well", "wrought", "passages", "the", "experiences", "taught", "there", "has", "been", "one", "to", "some", "extent.", "While", "doing", "garrison", "duty", "with", "my", "regiment", "the", "2nd", "New", "York", "Arty", "on", "the", "works", "South", "of", "the", "Potomac", "I", "visited", "Washington", "in", "company", "with", "a", "comrade", "named", "Charles", "String", "of", "Connecticut", "and", "by", "him", "introduced", "to", "you", "at", "your", "studio.", "(", "I", "forget", "the", "street", ")", "but", "it", "was", "not", "far", "removed", "from", "the", "avenue.", "if", "I", "mistake", "not", ",", "you", "accompanied", "us", "to", "the", "theatre", "at", "night.", "I", "have", "never", "forgotten", "you", "since", ",", "remembering", "you", "as", "a", "friend", "to", "the", "Union", "and", "the", "``", "boys", "''", "striving", "to", "keep", "it", "together.", "I", "left", "the", "regiment", "in", "the", "trenches", "in", "front", "of", "Petersburgh", ",", "my", "term", "of", "Service", "having", "expired", ",", "after", "three", "years", "Service", "from", "Oct", "1861.", "on", "arriving", "at", "Washington", "I", "tried", "to", "find", "you", "but", "could", "not.", "when", "you", "first", "met", "me", ",", "on", "leaving", "you", "you", "gave", "me", "a", "small", "book", "of", "poems", "with", "your", "name", "in", "it", ",", "bidding", "me", "think", "of", "you.", "I", "stowed", "it", "away", "in", "my", "knapsack", "but", "loosing", "that", "I", "lost", "your", "gift.", "I", "would", "like", "a", "duplicate", ",", "if", "it", "is", "not", "presuming", "too", "much.", "I", "trust", "you", "will", "not", "think", "me", "forward", "in", "this.", "With", "many", "and", "kind", "regards", "Very", "Respectfully", "Yours", "Hugh", "B.", "Thomson", "242", "Canal", "St", "New", "York", "City", "."], "date": [], "normalizedTime": "0.344213246294", "recipient": "Walt Whitman", "organizations": ["Sir", "Potomac", "Union", "Washington"], "sender": "Hugh B. Thomson", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00873.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Hugh B. Thomson to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Benton", "NNP"], ["H.", "NNP"], ["Wilson", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Walt Whitman", "Dear", "Hamilton"], "money": [], "year": "1866", "locations": [], "month": "Dec", "parties": ["Benton H. Wilson", "Walt Whitman"], "properDate": "Dec 9, 1866", "gpe": ["Brother"], "facility": [], "latlngs": [], "text": " Walt Whitman, Dear old Friend, I wrote to you a long time ago and received one letter from you but when I wrote again I received no answer and supposed you had not received my letter and I thought I would write you a few lines again and see if you had not forgotten me. I would try to make myself one of your correspondents for I would really like to hear from you very much for I formed an attachment for you during my short stay in washington (and at the hospital) that I would like to perpetuate it. I do not know your present address but shall address this the same as I did the last one I wrote to you. My Friend Hamilton started for Leavenworth Kansas last week to see his Brother, who has been jammed up on the Rail Road, and had his leg amputated. I will not weary you with a very long letter this time but will wait till I get an answer to this and then I will try to do better.   I am as every your sincere friend  ", "dateText": "", "percents": [], "taggedText": [[[["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","], [["Dear", "NNP"]], ["old", "JJ"], ["Friend", "NNP"], [",", ","], ["I", "PRP"], ["wrote", "VBD"], ["to", "TO"], ["you", "PRP"], ["a", "DT"], ["long", "JJ"], ["time", "NN"], ["ago", "RB"], ["and", "CC"], ["received", "VBD"], ["one", "CD"], ["letter", "NN"], ["from", "IN"], ["you", "PRP"], ["but", "CC"], ["when", "WRB"], ["I", "PRP"], ["wrote", "VBP"], ["again", "RB"], ["I", "PRP"], ["received", "VBD"], ["no", "DT"], ["answer", "NN"], ["and", "CC"], ["supposed", "VBD"], ["you", "PRP"], ["had"