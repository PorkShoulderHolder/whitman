IN"], ["i", "PRP"], ["am", "VBP"], ["able", "JJ"], ["to", "TO"], ["come", "VB"], ["No", "DT"], ["more", "RBR"], ["at", "IN"], ["present", "NN"], ["Good", "NNP"], ["by", "IN"], ["answer", "NN"], ["by", "IN"], ["return", "NN"], ["mail", "NN"], ["from", "IN"], ["a", "DT"], ["friend", "NN"], ["and", "CC"], ["ever", "RB"], ["shall", "MD"], ["be", "VB"]]], "sentences": [" Friend witman I now take the plesure of fulfilling my promace of writing to yo hoping to find yo en Joying good hlth I am not very well i am worse now than wen i got out of bed i tore my wound acoming home the hole is a bout half an inch square I hante ben noware sence i have been home i have had the docter and he ordered me to bathe in sider soaky i will hef to have my furlow exstended I would have written be fore but i was not able to do it yo must exscuse me    the crops look much better here than they do in washington I find a grate many that donte know me when i arrived in york my cosin was thare and he brought me to my home it has ben rainy ever since I have been home    give my love to the boys in ward B I will be back Just as soon as i am able to come No more at present Good by answer by return mail from a friend and ever shall be "], "words": ["Friend", "witman", "I", "now", "take", "the", "plesure", "of", "fulfilling", "my", "promace", "of", "writing", "to", "yo", "hoping", "to", "find", "yo", "en", "Joying", "good", "hlth", "I", "am", "not", "very", "well", "i", "am", "worse", "now", "than", "wen", "i", "got", "out", "of", "bed", "i", "tore", "my", "wound", "acoming", "home", "the", "hole", "is", "a", "bout", "half", "an", "inch", "square", "I", "hante", "ben", "noware", "sence", "i", "have", "been", "home", "i", "have", "had", "the", "docter", "and", "he", "ordered", "me", "to", "bathe", "in", "sider", "soaky", "i", "will", "hef", "to", "have", "my", "furlow", "exstended", "I", "would", "have", "written", "be", "fore", "but", "i", "was", "not", "able", "to", "do", "it", "yo", "must", "exscuse", "me", "the", "crops", "look", "much", "better", "here", "than", "they", "do", "in", "washington", "I", "find", "a", "grate", "many", "that", "donte", "know", "me", "when", "i", "arrived", "in", "york", "my", "cosin", "was", "thare", "and", "he", "brought", "me", "to", "my", "home", "it", "has", "ben", "rainy", "ever", "since", "I", "have", "been", "home", "give", "my", "love", "to", "the", "boys", "in", "ward", "B", "I", "will", "be", "back", "Just", "as", "soon", "as", "i", "am", "able", "to", "come", "No", "more", "at", "present", "Good", "by", "answer", "by", "return", "mail", "from", "a", "friend", "and", "ever", "shall", "be"], "date": [], "normalizedTime": "0.177886576907", "recipient": "Walt Whitman", "organizations": [], "sender": "William E. Vandemark", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/tex.00128.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from William E. Vandemark to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Thomas", "NNP"], ["P.", "NNP"], ["Sawyer", "NNP"]]]], "people": ["Dear", "Armory Hospital", "Lewy Brown", "Lewy", "Tom", "Charleston", "Lee", "Gettysburgh"], "money": [], "year": "1863", "locations": [], "month": "Aug", "parties": ["Walt Whitman", "Thomas P. Sawyer"], "properDate": "Aug 0, 1863", "gpe": ["Washington", "Well", "Dear"], "facility": [], "latlngs": [[38.8951118, -77.0363658]], "text": " Dear brother,2 You did not write any answer to my last two letters, now quite a while ago, still I will write again. I still remain here in Washington, finding just about work enough to pay my expenses. Occasionaly go to Armory Hospital. I see Lewy Brown always, he has returned from his furlough, he told me a few days ago he had written to you, & had sent you my best respects   I told him he must never send my respects to you but always my love. Lewy's leg has not healed, gives him trouble yet. He goes around with crutches, but not very far. He is the same good young man as ever, & always will be. Well, Tom, it looks as though secesh was nearly played out   if they lose Charleston, as I believe they will soon, seems to be they may as well give it up   Some think that Lee will make another dash up this way, but I should think Gettysburgh might last him a while yet. Dear brother, how I should like to see you   & would like to know how things have gone with you for three months past. I cant understand why you have ceased to correspond with me. Any how I hope we shall meet again, & have some good times. So, dearest comrade, good bye for present & God bless you. ", "dateText": "", "percents": [], "taggedText": [[[["Dear", "NNP"]], ["brother,2", "NNP"], ["You", "NNP"], ["did", "VBD"], ["not", "RB"], ["write", "VB"], ["any", "DT"], ["answer", "NN"], ["to", "TO"], ["my", "PRP$"], ["last", "JJ"], ["two", "CD"], ["letters", "NNS"], [",", ","], ["now", "RB"], ["quite", "RB"], ["a", "DT"], ["while", "NN"], ["ago", "RB"], [",", ","], ["still", "RB"], ["I", "PRP"], ["will", "MD"], ["write", "VB"], ["again", "RB"], [".", "."]], [["I", "PRP"], ["still", "RB"], ["remain", "VB"], ["here", "RB"], ["in", "IN"], [["Washington", "NNP"]], [",", ","], ["finding", "VBG"], ["just", "RB"], ["about", "IN"], ["work", "NN"], ["enough", "RB"], ["to", "TO"], ["pay", "VB"], ["my", "PRP$"], ["expenses", "NNS"], [".", "."]], [["Occasionaly", "RB"], ["go", "VBP"], ["to", "TO"], [["Armory", "NNP"], ["Hospital", "NNP"]], [".", "."]], [["I", "PRP"], ["see", "VBP"], [["Lewy", "NNP"], ["Brown", "NNP"]], ["always", "RB"], [",", ","], ["he", "PRP"], ["has", "VBZ"], ["returned", "VBN"], ["from", "IN"], ["his", "PRP$"], ["furlough", "JJ"], [",", ","], ["he", "PRP"], ["told", "VBD"], ["me", "PRP"], ["a", "DT"], ["few", "JJ"], ["days", "NNS"], ["ago", "RB"], ["he", "PRP"], ["had", "VBD"], ["written", "VBN"], ["to", "TO"], ["you", "PRP"], [",", ","], ["&", "CC"], ["had", "VBD"], ["sent", "VB