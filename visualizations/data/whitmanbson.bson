"Walt Whitman"], "properDate": "Apr 10, 1871", "gpe": ["New York", "France", "Galaxy"], "facility": [], "latlngs": [[40.7143528, -74.00597309999999], [31.3768681, -94.4166521]], "text": "image 1image 2image 3image 4                                           EDITORIAL OFFICE OF THE GALAXY,                          40 PARK ROW, New York.                                                                               10 April, 1871                                  Dear Sir:              Your poem entitled \"O, Star of France\" will be published in the June number of The Galaxy.                  Respectfully                 John Lillie                     for F. P. Church              Mr Whitman ", "dateText": "", "percents": [], "taggedText": [[["image", "NN"], ["1image", "NN"], ["2image", "NN"], ["3image", "NN"], ["4", "CD"], [["EDITORIAL", "NNP"]], ["OFFICE", "NNP"], ["OF", "NNP"], ["THE", "NNP"], [["GALAXY", "NNP"]], [",", ","], ["40", "CD"], [["PARK", "NNP"]], ["ROW", "NNP"], [",", ","], [["New", "NNP"], ["York", "NNP"]], [".", "."]], [["10", "CD"], ["April", "NNP"], [",", ","], ["1871", "CD"], ["Dear", "NNP"], ["Sir", "NNP"], [":", ":"], ["Your", "PRP$"], ["poem", "NN"], ["entitled", "VBD"], ["``", "``"], ["O", "NNP"], [",", ","], [["Star", "NNP"]], ["of", "IN"], [["France", "NNP"]], ["''", "''"], ["will", "MD"], ["be", "VB"], ["published", "VBN"], ["in", "IN"], ["the", "DT"], ["June", "NNP"], ["number", "NN"], ["of", "IN"], ["The", "DT"], [["Galaxy", "NNP"]], [".", "."]], [["Respectfully", "RB"], [["John", "NNP"], ["Lillie", "NNP"]], ["for", "IN"], ["F.", "NNP"], ["P.", "NNP"], ["Church", "NNP"], ["Mr", "NNP"], ["Whitman", "NNP"]]], "sentences": ["image 1image 2image 3image 4                                           EDITORIAL OFFICE OF THE GALAXY,                          40 PARK ROW, New York.", "10 April, 1871                                  Dear Sir:              Your poem entitled \"O, Star of France\" will be published in the June number of The Galaxy.", "Respectfully                 John Lillie                     for F. P. Church              Mr Whitman "], "words": ["image", "1image", "2image", "3image", "4", "EDITORIAL", "OFFICE", "OF", "THE", "GALAXY", ",", "40", "PARK", "ROW", ",", "New", "York.", "10", "April", ",", "1871", "Dear", "Sir", ":", "Your", "poem", "entitled", "``", "O", ",", "Star", "of", "France", "''", "will", "be", "published", "in", "the", "June", "number", "of", "The", "Galaxy.", "Respectfully", "John", "Lillie", "for", "F.", "P.", "Church", "Mr", "Whitman"], "date": [], "normalizedTime": "0.560043519652", "recipient": "Walt Whitman", "organizations": ["EDITORIAL", "GALAXY", "PARK", "Star"], "sender": "Francis P. Church", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/loc.01290.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " John Lillie , for Francis P. Church , to Walt Whitman ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Abby", "NNP"], ["H.", "NNP"], ["Price", "NNP"]], [",", ","]]], "people": ["Dear", "Major Saxton", "Arthur", "Willard Saxton"], "money": [], "year": "1871", "locations": [], "month": "Apr", "parties": ["Walt", "Whitman", "Abby H. Price"], "properDate": "Apr 21, 1871", "gpe": ["Washington", "Abby", "Love", "Walt", "Abby"], "facility": [], "latlngs": [[38.8951118, -77.0363658]], "text": "  Washington                     April 21, 1871.                                                      Dear Abby,              I have seen Major Saxton, & handed him your note, & the accompanying paper   he said he knew the 4th Auditor personally, & would see him about it, & would probably write to you within three or four days. So Arthur is home, & you are all well   what with the baby & all you women   what jolly times you must have   I wish I could just drop in and take part in them    With me, nothing very new or special   I am well & hearty   feel first-rate the greater part of the time   and as to streaks of the other kind of feeling, I am thankful they are so few   for you know I am getting to be an old fellow   though my temperament for buoyancy & fun I believe increases instead of diminishes   I shall take my vacation considerably earlier than usual, this summer   so it wont be long before I shall see you all.                  Love to all   not forgetting the baby.                 Walt.              Abby, Willard Saxton's address is 1st Comptroler's office Treasury Dep't. ", "dateText": "", "percents": [], "taggedText": [[[["Washington", "NNP"]], ["April", "NNP"], ["21", "CD"], [",", ","], ["1871", "CD"], [".", "."]], [[["Dear", "NNP"]], [["Abby", "NNP"]], [",", ","], ["I", "PRP"], ["have", "VBP"], ["seen", "VBN"], [["Major", "NNP"], ["Saxton", "NNP"]], [",", ","], ["&", "CC"], ["handed", "VBD"], ["him", "PRP"], ["your", "PRP$"], ["note", "NN"], [",", ","], ["&", "CC"], ["the", "DT"], ["accompanying", "NN"], ["paper", "NN"], ["he", "PRP"], ["said", "VBD"], ["he", "PRP"], ["knew", "VBD"], ["the", "DT"], ["4th", "JJ"], ["Auditor", "NNP"], ["personally", "RB"], [",", ","], ["&", "CC"], ["would", "MD"], ["see", "VB"], ["him", "PRP"], ["about", "IN"], ["it", "PRP"], [",", ","], ["&", "CC"], ["would", "MD"], ["probably", "RB"], ["write", "VB"], ["to", "TO"], ["you", "PRP"], ["within", "IN"], ["three", "CD"], ["or", "CC"], ["four", "CD"], ["days", "NNS"], [".", "."]], [["So", "IN"], [["Arthur", "NNP"]], ["is", "VBZ"], ["home", "NN"], [",", ","], ["&", "CC"], ["you", "PRP"], ["are", "VBP"], ["all", "DT"], ["well", "RB"], ["what", "WP"], ["with", "IN"], ["the", "DT"], ["baby", "NN"], ["&", "CC"], ["all", "DT"], ["you", "PRP"], ["women", "NNS"], ["what", "WP"], ["jolly", "RB"], ["times", "VBZ"], ["you", "PRP"], ["must", "MD"], ["have", "VB"], ["I", "PRP"], ["wish", "VB"], ["I", "PRP"], ["could", "MD"], ["just", "RB"], ["drop", "VB"], ["in", "IN"], ["and", "CC"], ["take", "VB"], ["part", "NN"], ["in", "IN"], ["them", "PRP"], ["With", "IN"], ["me", "P