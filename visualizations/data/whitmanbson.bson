: ["Walt", "Whitman"], "money": [], "year": "1871", "locations": [], "month": "Dec", "parties": ["Walt", "Whitman", "Anne Gilchrist"], "properDate": "Dec 26, 1871", "gpe": ["Washington"], "facility": [], "latlngs": [[38.8951118, -77.0363658]], "text": "  Washington, U. S.                     Dec. 26, '71.                                  Dear friend,              Your late letter has just reached me   & I write at once to at least say specifically that both your letter of Sept. 6 and that of Oct. 15 safely reached me   this that comes to-day being the third. Again I will say that I am sure I appreciate & accept your letters, & all they stand for, as fully as even you, dear friend, could wish   & as lovingly & bona fide.                   Walt Whitman              ", "dateText": "", "percents": [], "taggedText": [[[["Washington", "NNP"]], [",", ","], ["U.", "NNP"], ["S.", "NNP"], ["Dec.", "NNP"], ["26", "CD"], [",", ","], ["'71", "-NONE-"], [".", "."]], [["Dear", "NNP"], ["friend", "VBP"], [",", ","], ["Your", "NNP"], ["late", "RB"], ["letter", "JJR"], ["has", "VBZ"], ["just", "RB"], ["reached", "VBN"], ["me", "PRP"], ["&", "CC"], ["I", "PRP"], ["write", "VBP"], ["at", "IN"], ["once", "RB"], ["to", "TO"], ["at", "IN"], ["least", "JJS"], ["say", "VB"], ["specifically", "RB"], ["that", "IN"], ["both", "DT"], ["your", "PRP$"], ["letter", "NN"], ["of", "IN"], ["Sept.", "NNP"], ["6", "CD"], ["and", "CC"], ["that", "IN"], ["of", "IN"], ["Oct.", "NNP"], ["15", "CD"], ["safely", "RB"], ["reached", "VBN"], ["me", "PRP"], ["this", "DT"], ["that", "WDT"], ["comes", "VBZ"], ["to-day", "JJ"], ["being", "VBG"], ["the", "DT"], ["third", "JJ"], [".", "."]], [["Again", "RB"], ["I", "PRP"], ["will", "MD"], ["say", "VB"], ["that", "IN"], ["I", "PRP"], ["am", "VBP"], ["sure", "JJ"], ["I", "PRP"], ["appreciate", "VBP"], ["&", "CC"], ["accept", "IN"], ["your", "PRP$"], ["letters", "NNS"], [",", ","], ["&", "CC"], ["all", "DT"], ["they", "PRP"], ["stand", "VBP"], ["for", "IN"], [",", ","], ["as", "IN"], ["fully", "RB"], ["as", "IN"], ["even", "RB"], ["you", "PRP"], [",", ","], ["dear", "JJ"], ["friend", "NN"], [",", ","], ["could", "MD"], ["wish", "VB"], ["&", "CC"], ["as", "IN"], ["lovingly", "RB"], ["&", "CC"], ["bona", "NNS"], ["fide", "VBP"], [".", "."]], [[["Walt", "NNP"]], [["Whitman", "NNP"]]]], "sentences": ["  Washington, U. S.                     Dec. 26, '71.", "Dear friend,              Your late letter has just reached me   & I write at once to at least say specifically that both your letter of Sept. 6 and that of Oct. 15 safely reached me   this that comes to-day being the third.", "Again I will say that I am sure I appreciate & accept your letters, & all they stand for, as fully as even you, dear friend, could wish   & as lovingly & bona fide.", "Walt Whitman              "], "words": ["Washington", ",", "U.", "S.", "Dec.", "26", ",", "'71.", "Dear", "friend", ",", "Your", "late", "letter", "has", "just", "reached", "me", "&", "I", "write", "at", "once", "to", "at", "least", "say", "specifically", "that", "both", "your", "letter", "of", "Sept.", "6", "and", "that", "of", "Oct.", "15", "safely", "reached", "me", "this", "that", "comes", "to-day", "being", "the", "third.", "Again", "I", "will", "say", "that", "I", "am", "sure", "I", "appreciate", "&", "accept", "your", "letters", ",", "&", "all", "they", "stand", "for", ",", "as", "fully", "as", "even", "you", ",", "dear", "friend", ",", "could", "wish", "&", "as", "lovingly", "&", "bona", "fide.", "Walt", "Whitman"], "date": [], "normalizedTime": "0.595403236774", "recipient": "Anne Gilchrist", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/upa.00012.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Anne Gilchrist ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Louisa", "NNP"], ["Van", "NNP"], ["Velsor", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Mr. Williams", "Ashton", "Mama", "Stanton", "Mother", "Lou", "Mama", "Stanton", "Love", "George", "Mother"], "money": [], "year": "1871", "locations": [], "month": "Dec", "parties": ["Walt", "Whitman", "Louisa Van Velsor Whitman"], "properDate": "Dec 27, 1871", "gpe": ["Dearest", "Heyde", "Denmark", "Walt", "Write"], "facility": [], "latlngs": [[56.26392, 9.501785]], "text": "  Department of Justice                     Washington Dec 27 1871.                                  Dearest mother,              There is nothing special to write about to-day. The new Attorney General Mr. Williams has been in once or twice   he is a tallish, western sort of man, wears a stove-pipe hat   is rather spare & a little round shouldered   sallow complexion   long legged   seems quite plain in his talk   Ashton says he is a good man   we will see   He takes his seat about the 10th Jan.  \u00bd past 10, forenoon   Mama, your letter has just come   It is too bad to have such a puppy as Stanton annoying you   He is one of the Heyde sort, it always seemed to me   Mother, write to me how it turns out   whether they leave or not    I see you have it very changeable there too   After the severest cold spell ever known here so early,                  we are just now having it mild & warm enough for spring   it rained here this morning, but is now bright & pleasant    I suppose Lou will be with you now   I should like first rate to just drop in on you all    I continue to get letters &c from abroad about my book   I believe I told you I got one the other day from Denmark,                  from the editor of the principal magazine there. He is preparing a review & partial translation of my writings    Mama dear, I hope you will have a pleasant holiday week, what's left of it   Don't let Stanton annoy you, the dirty scamp   Love to you, dearest mother, & to George & Lou & all.               Walt.              Write by next Sunday if convenient, & tell me if the order comes safe    Mother, give the enclosed $1 to the letter-carrier, if you think proper    ", "dateText": "", "percents": [], "taggedText": [[["Department", "NN"], ["of", "IN"], [["Justice", "NNP"], ["Washington", "NNP"]], ["Dec", "NNP"], ["27", "CD"], ["1871", "CD"], [".", "."]], [[["Dearest", "NNP"]], ["mother", "NN"], [",", ","], ["There", "EX"], ["is", "VBZ"], ["nothing", "NN"], ["special", "JJ"], ["to", "TO"], ["write", "VB"], ["about", "IN"], ["to-day", "JJ"], [".", "."]], [["The", "DT"], ["new", "JJ"], ["Attorney", "NNP"], ["General", "NNP"], [["Mr.", "NNP"], ["Williams", "NNP"]], ["has", "VBZ"], ["been", "VBN"], ["in", "IN"], ["once", "RB"], ["or", "CC"], ["twice", "NN"], ["he", "PRP"], ["is", "VBZ"], ["a", "DT"], ["tallish", "JJ"], [",", ","], ["western", "JJ"], ["sort", "NN"], ["of", "IN"], ["man", "NN"], [",", ","], ["wears", "NNS"], ["a", "DT"], ["stove-pipe", "JJ"], ["hat", "NN"], ["is", "VBZ"], ["rather", "RB"], ["spare", "JJ"], ["&", "CC"], ["a", "DT"], ["little", "RB"], ["round", "NN"], ["shouldered", "VBD"], ["sallow", "JJ"], ["complexion", "NN"], ["long", "RB"], ["legged", "VBD"], ["seems", "NNS"], ["quite", "RB"], ["plain", "VB"], ["in", "IN"], ["his", "PRP$"], ["talk", "NN"], [["Ashton", "NNP"]], ["says", "VBZ"], ["he", "PRP"], ["is", "VBZ"], ["a", "DT"], ["good", "JJ"], ["man", "NN"], ["we", "PRP"], ["will", "MD"], ["see", "VB"], ["He", "PRP"], ["takes", "VBZ"], ["his", "PRP$"], ["seat", "NN"], ["about", "IN"], ["the", "DT"], ["10th", "JJ"], ["Jan.", "NNP"], ["\u00bd", "NNP"], ["past", "NN"], ["10", "CD"], [",", ","], ["forenoon", "RB"], [["Mama", "NNP"]], [",", ","], ["your", "PRP$"], ["letter", "NN"], ["has", "VBZ"], ["just", "RB"], ["come", "VBN"], ["It", "PRP"], ["is", "VBZ"], ["too", "RB"], ["bad", "JJ"], ["to", "TO"], ["have", "VB"], ["such", "JJ"], ["a", "DT"], ["puppy", "NN"], ["as", "IN"], [["Stanton", "NNP"]], ["annoying", "NN"], ["you", "PRP"], ["He", "PRP"], ["is", "VBZ"], ["one", "CD"], ["of", "IN"], ["the", "DT"], [["Heyde",