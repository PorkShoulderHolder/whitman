"organizations": ["Philadelphia", "States"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00806.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to an Unidentified Correspondent , ( ? ) . ( ? ) . 1863 ("}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["George", "NNP"], ["Wood", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","], ["[", "NNP"], ["15", "CD"], ["January", "NNP"]]], "people": ["Sir You"], "money": [], "year": "1", "locations": [], "month": "]", "parties": ["George Wood", "Walt Whitman"], "properDate": "] 1863, 1", "gpe": [], "facility": [], "latlngs": [], "text": "  Thursday  Mr dear Sir You sometimes find a poor soldier whom a small sum would relieve and I beg you will distribute these pieces of paper as you shall see best on your visits to the Hospital. [illegible]  G Wood Mr W: Whitman  ", "dateText": "", "percents": [], "taggedText": [[["Thursday", "NNP"], ["Mr", "NNP"], ["dear", "NN"], [["Sir", "NNP"], ["You", "NNP"]], ["sometimes", "RB"], ["find", "VB"], ["a", "DT"], ["poor", "JJ"], ["soldier", "NN"], ["whom", "WP"], ["a", "DT"], ["small", "JJ"], ["sum", "NN"], ["would", "MD"], ["relieve", "VB"], ["and", "CC"], ["I", "PRP"], ["beg", "VBP"], ["you", "PRP"], ["will", "MD"], ["distribute", "VB"], ["these", "DT"], ["pieces", "NNS"], ["of", "IN"], ["paper", "NN"], ["as", "IN"], ["you", "PRP"], ["shall", "MD"], ["see", "VB"], ["best", "JJS"], ["on", "IN"], ["your", "PRP$"], ["visits", "NNS"], ["to", "TO"], ["the", "DT"], [["Hospital", "NNP"]], [".", "."]], [["[", "NN"], ["illegible", "JJ"], ["]", "NN"], ["G", "NNP"], ["Wood", "NNP"], ["Mr", "NNP"], ["W", "NNP"], [":", ":"], ["Whitman", "NNP"]]], "sentences": ["  Thursday  Mr dear Sir You sometimes find a poor soldier whom a small sum would relieve and I beg you will distribute these pieces of paper as you shall see best on your visits to the Hospital.", "[illegible]  G Wood Mr W: Whitman  "], "words": ["Thursday", "Mr", "dear", "Sir", "You", "sometimes", "find", "a", "poor", "soldier", "whom", "a", "small", "sum", "would", "relieve", "and", "I", "beg", "you", "will", "distribute", "these", "pieces", "of", "paper", "as", "you", "shall", "see", "best", "on", "your", "visits", "to", "the", "Hospital.", "[", "illegible", "]", "G", "Wood", "Mr", "W", ":", "Whitman"], "date": [], "normalizedTime": "n/a", "recipient": "Walt Whitman", "organizations": ["Hospital"], "sender": "George Wood", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00878.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from George Wood to Walt Whitman , [ 15 January"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Louisa", "NNP"], ["Van", "NNP"], ["Velsor", "NNP"], ["Whitman", "NNP"]], [",", ","], ["16", "CD"], ["October", "NNP"], ["1866", "CD"], ["(", "CD"]]], "people": ["Han", "Mr. Stanbery Ashton", "Jeff", "George", "Love", "Mat Well"], "money": [], "year": "1", "locations": [], "month": ")", "parties": ["Walt Whitman", "Louisa Van Velsor Whitman"], "properDate": ") 0, 1", "gpe": ["Washington", "Walt"], "facility": [], "latlngs": [[38.8951118, -77.0363658]], "text": "  ATTORNEY GENERAL'S OFFICE, Washington,  Oct. 16, 1862  Dearest mother, I have not heard any thing from you the last week, but I hope you are well & every thing goes right. I sent you a letter last Tuesday, as usual. I suppose you have got your copy of the new book   I feel satisfied with the looks of it   it might be better, & handsomer paper, &c   but I am glad it turns out as good as it is   for, in making a book, you can't be certain how it is going to look, till it is all completed. Then I feel sure it tells the meaning better than any of the former editions   My enemies, & those who are determined to find fault, will of course still do so   But I feel that the book proves itself to any fair person   & will have a fair chance now, & go ahead. But the best thing is, it is done   & I shant worry myself any more with fixing & revising it    I have sent a copy to Han   & wrote her a letter   I am feeling first rate in health   I have a good place to eat   get good victuals & plenty of 'em   After the biggest rain-storm I ever knew, we have splendid weather here just now. In the office here, every thing goes on the same as usual. I like Mr. Stanbery   Ashton, the Assistant, will probably remain here this winter   I hope Jeff won't neglect to vote   George of course will vote   Love to Mat   Well good bye, dear mother, till next time. Walt. ", "dateText": "", "percents": [], "taggedText": [[["ATTORNEY", "NN"], [["GENERAL", "NNP"]], ["'S", "POS"], ["OFFICE", "NNP"], [",", ","], [["Washington", "NNP"]], [",", ","], ["Oct.", "NNP"], ["16", "CD"], [",", ","], ["1862", "CD"], ["Dearest", "NNP"], ["mother", "NN"], [",", ","], ["I", "PRP"], ["have", "VBP"], ["not", "RB"], ["heard", "VBN"], ["any", "DT"], ["thing", "NN"], ["from", "IN"], ["you", "PRP"], ["the", "DT"], ["last", "JJ"], ["week", "NN"], [",", ","], ["but", "CC"], ["I", "PRP"], ["hope", "VBP"], ["you", "PRP"], ["are", "VBP"], ["well", "RB"], ["&", "CC"], ["every", "DT"], ["thing", "NN"], ["goes", "VBZ"], ["right", "RB"], [".", "."]], [["I", "PRP"], ["sent", "VBD"], ["you", "PRP"], ["a", "DT"], ["letter", "NN"], ["last", "JJ"], ["Tuesday", "NNP"], [",", ","], ["as", "IN"], ["usual", "JJ"], [".", "."]], [["I", "PRP"], ["suppose", "VBP"], ["you", "PRP"], ["have", "VBP"], ["got", "VBN"], ["your", "PRP$"], ["copy", "NN"], ["of", "IN"], ["the", "DT"], ["new", "JJ"], ["book", "NN"], ["I", "PRP"], ["feel", "VBP"], ["satisfied", "JJ"], ["with", "IN"], ["the", "DT"], ["looks", "NNS"], ["of", "IN"], ["it", "PRP"], ["it", "PRP"], ["might", "MD"], ["be", "VB"], ["better", "JJR"], [",", ","], ["&", "CC"], ["handsomer", "NN"], ["paper", "NN"], [",", ","], ["&", "CC"], ["c",