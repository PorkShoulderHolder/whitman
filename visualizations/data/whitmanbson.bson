, "house", "soon", ",", "as", "the", "folks", "are", "all", "going", "to", "move", "this", "month", "My", "good", "&", "real", "friends", "the", "O'Connors", "live", "in", "the", "same", "block", ",", "I", "am", "in", "there", "every", "day", "Dear", "Mother", ",", "tell", "Mat", "&", "Miss", "Mannahatta", "I", "send", "them", "my", "love", "I", "want", "to", "see", "them", "both", "O", "how", "I", "want", "to", "see", "Jeff", "&", "you", ",", "mother", ",", "I", "sometimes", "feel", "as", "if", "I", "should", "just", "get", "in", "the", "cars", "&", "come", "home", "&", "the", "baby", "too", ",", "you", "must", "always", "write", "about", "her", "dear", "mother", ",", "good", "bye", "for", "present", "Walt"], "date": [], "normalizedTime": "0.182238542092", "recipient": "Louisa Van Velsor Whitman", "organizations": ["this1", "Common Council", "George2 Mother", "N"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00785.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to Louisa Van Velsor Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Mary", "NNP"], ["A.", "NNP"], ["Babbitt", "NNP"]], [",", ","]]], "people": [], "money": [], "year": "1863", "locations": [], "month": "Sep", "parties": ["Walt Whitman", "Mary A. Babbitt"], "properDate": "Sep 3, 1863", "gpe": ["Washington"], "facility": [], "latlngs": [[38.8951118, -77.0363658]], "text": "  Washington |  September 3, 1863  Mary A. Babbitt,2 I write you regarding your brother Caleb   I rec'd your letter of August 18th & I have written to Caleb three letters since. But I have not heard a word about him, only your letter of August 18th    ", "dateText": "", "percents": [], "taggedText": [[[["Washington", "NNP"]], ["|", ":"], ["September", "NNP"], ["3", "CD"], [",", ","], ["1863", "CD"], ["Mary", "NNP"], ["A.", "NNP"], ["Babbitt,2", "NNP"], ["I", "NNP"], ["write", "VBP"], ["you", "PRP"], ["regarding", "VBG"], ["your", "PRP$"], ["brother", "NN"], ["Caleb", "NNP"], ["I", "PRP"], ["rec", "VBP"], ["'d", "JJ"], ["your", "PRP$"], ["letter", "NN"], ["of", "IN"], ["August", "NNP"], ["18th", "CD"], ["&", "CC"], ["I", "PRP"], ["have", "VBP"], ["written", "VBN"], ["to", "TO"], ["Caleb", "NNP"], ["three", "CD"], ["letters", "NNS"], ["since", "IN"], [".", "."]], [["But", "CC"], ["I", "PRP"], ["have", "VBP"], ["not", "RB"], ["heard", "VBN"], ["a", "DT"], ["word", "NN"], ["about", "IN"], ["him", "PRP"], [",", ","], ["only", "RB"], ["your", "PRP$"], ["letter", "NN"], ["of", "IN"], ["August", "NNP"], ["18th", "CD"]]], "sentences": ["  Washington |  September 3, 1863  Mary A. Babbitt,2 I write you regarding your brother Caleb   I rec'd your letter of August 18th & I have written to Caleb three letters since.", "But I have not heard a word about him, only your letter of August 18th    "], "words": ["Washington", "|", "September", "3", ",", "1863", "Mary", "A.", "Babbitt,2", "I", "write", "you", "regarding", "your", "brother", "Caleb", "I", "rec", "'d", "your", "letter", "of", "August", "18th", "&", "I", "have", "written", "to", "Caleb", "three", "letters", "since.", "But", "I", "have", "not", "heard", "a", "word", "about", "him", ",", "only", "your", "letter", "of", "August", "18th"], "date": [], "normalizedTime": "0.182510539916", "recipient": "Mary A. Babbitt", "organizations": [], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00786.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to Mary A. Babbitt ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Thomas", "NNP"], ["Jefferson", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Mother", "George", "George", "George", "Andrew", "Andrew", "Andrew", "Nancy", "Andrew", "Han", "Heyde", "Tom", "Tom", "Carls", "Uncle Abe", "Reg", "Andrew"], "money": [], "year": "1863", "locations": [], "month": "Sep", "parties": ["Thomas Jefferson Whitman", "Walt Whitman"], "properDate": "Sep 5, 1863", "gpe": ["Brooklyn", "Mother", "Mother", "Amermans9", "Husted", "Min", "Ohio", "Brooklyn", "Jeff"], "facility": [], "latlngs": [[40.65, -73.95], [40.65, -73.95]], "text": "  Brooklyn Sept 5 18631 Dear Walt, Mother gave me the enclosed letter to send you some days since but I forgot to mail it till now. We received your letter2 last night. The money from George came all safe  I sent you another letter from George about last Monday, also sent George a letter with the money in it. Andrew has been away in the country but returned yesterday, very much worse.3 He came in to see me this morning and it has made me feel quite down-spirited.  He can neither eat nor drink without the greatest agony. He looks very thin and emaciated. I think that if I had the same sickness that I could get the best of it,4 but Andrew seems to put his whole faith in thinking that some Dr can give him something that will set him all straight. I am going to see the Dr with him this P.M. and I also want him to consult Ruggles5 if he will. I fear the worst for Andrew. I wish you was on here. I think that your advice would be a great thing for him. Cant you come. You speak of coming home. I wish you could come just now. Mother is of course much worried about him. Nancy dont seem to amount to much when trouble comes. You would hardly know Andrew. He is thin weak and generally sickly looking  We have heard nothing from Han lately that I know of  Mother and Heyde keep writing letters to one another but what about I know not. At last the great draft has come and gone and I was not one of the elected. I feel thankful  In our ward the screws were put rather tight. out of a little over 3000 names they drew 1056 nearly one in three, while in other wards the proportion was 1 in 6 and 1 in 7 and in the 9th ward 1 in 10. Tom Geere,6 Tom McEvoy,7 Pat Hughes8 two or three in Amermans9 house, were all hit. It seems to have avoided the Water Works, only one or two out of the whole 40 or 50 employed were hit while in Husted & Carls store10 7 out of 10 were taken. If this is the last of it I feel thankful but I believe Uncle Abe left off some on account of Seymour,11 if so I suppose there will be another spurt. However we wont worry till the time comes  The enclosed $5 is from Mr Moses Lane.12 We have what remains of [three?] old Reg. on the hills by our house. They are fine looking and well behaved men, and look as if they would do their duty any where. If you was home you could have grand times talking with them  One Reg. is from Min. one from Mich. and one from Ohio. What do you think about coming to Brooklyn  I think you better, for awhile any way. I wish you would write to Andrew. He seems to feel wonderfully cast down  Aint the Administrat[ion] got wit enough to see that now is the hour to end the war by whipping the rebels. Dont they know enough to know that unless it is ended in 6 months they will have a hard time to get men to fill the places of what they have now. I fear not. Jeff", "dateText": "", "percents": [], "taggedText": [[[["Brooklyn", "NNP"]], ["Sept", "NNP"], ["5", "CD"], ["18631", "CD"], ["Dear", "NNP"], ["Walt", "NNP"], [",", ","], [["Mother", "NNP"]], ["gave", "VBD"], ["me", "PRP"], ["the", "DT"], ["enclosed", "VBN"], ["letter", "NN"], ["to", "TO"], ["send", "VB"], ["you", "PRP"], ["some", "DT"], ["days", "NNS"], ["since", "IN"], ["but", "CC"], ["I", "PRP"], ["forgot", "VBD"], ["to", "TO"], ["mail", "VB"], ["it", "PRP"], ["till", "MD"], ["now", "RB"], [".", "."]], [["We", "PRP"], ["received", "VBD"], ["your", "PRP$"], [["letter2", "NNP"]], ["last", "JJ"], ["night", "NN"], [".", "."]], [["The", "DT"], ["money", "NN"], ["from", "IN"], [["George", "NNP"]], ["came", "VBD"], ["all", "DT"], ["safe", "NN"], ["I", "PRP"], ["sent", "VBD"], ["you", "PRP"], ["anothe