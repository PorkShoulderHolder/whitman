onstruction/tei/loc.01593.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Charles W. Eldridge ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Abby", "NNP"], ["H.", "NNP"], ["Price", "NNP"]], [",", ","]]], "people": ["Jeannie", "William", "Davis", "Mr. Davis", "Fields", "Point", "Nora Perry", "Wm O'Connor", "Davis", "Mr. Davis", "Love", "Helen", "Emily"], "money": [], "year": "1868", "locations": [], "month": "Oct", "parties": ["Walt", "Whitman", "Abby H. Price"], "properDate": "Oct 21, 1868", "gpe": ["Providence", "New York", "Washington", "Olneysville", "Walt"], "facility": [], "latlngs": [[41.8239891, -71.4128343], [40.7143528, -74.00597309999999], [38.8951118, -77.0363658]], "text": "  Providence, R. I.                     October 21, 1868                                  Dear Abby,              I shall return to New York to-morrow, Thursday   leaving here at \u00bd past 12, noon,                  and getting in N. Y. about 8   & intend to go on to Washington on Monday next, 26th.                  I have been at the Channings's   Jeannie is quite unwell   but bears it like the heroine she is   William O'Connor is there   I am now at Mr. & Mrs. Davis's   Am treated with the                  greatest hospitality & courtesy every where. Yesterday Mr. Davis took me out riding   went down to Fields' Point, off the bay   & thence to the domain & factories                  of the Spragues, & so to Olneysville &c &c   as interesting a ride                  & exploration as I ever had in my life    I have seen Mrs. Whitman   & like her. We had yesterday here to dinner & spend                  the evening Nora Perry, Wm O'Connor, Dr. Channing, &c   To-day Mrs. Davis had                  intended to take me out riding, but it is threatening rain, wind east, & skies dark   So it will have to be given up. I like Mr. Davis much. I am very glad I made                  this jaunt & visit   Love to you, Helen, Emily, & all.               Walt.              ", "dateText": "", "percents": [], "taggedText": [[[["Providence", "NN"]], [",", ","], ["R.", "NNP"], ["I.", "NNP"], ["October", "NNP"], ["21", "CD"], [",", ","], ["1868", "CD"], ["Dear", "NNP"], ["Abby", "NNP"], [",", ","], ["I", "PRP"], ["shall", "MD"], ["return", "VB"], ["to", "TO"], [["New", "NNP"], ["York", "NNP"]], ["to-morrow", "NNP"], [",", ","], ["Thursday", "NNP"], ["leaving", "NN"], ["here", "RB"], ["at", "IN"], ["\u00bd", "CD"], ["past", "NN"], ["12", "CD"], [",", ","], ["noon", "RB"], [",", ","], ["and", "CC"], ["getting", "VBG"], ["in", "IN"], ["N.", "NNP"], ["Y.", "NNP"], ["about", "IN"], ["8", "CD"], ["&", "CC"], ["intend", "NN"], ["to", "TO"], ["go", "VB"], ["on", "IN"], ["to", "TO"], [["Washington", "NNP"]], ["on", "IN"], ["Monday", "NNP"], ["next", "JJ"], [",", ","], ["26th", "JJ"], [".", "."]], [["I", "PRP"], ["have", "VBP"], ["been", "VBN"], ["at", "IN"], ["the", "DT"], [["Channings", "NNS"]], ["'s", "POS"], [["Jeannie", "NNP"]], ["is", "VBZ"], ["quite", "RB"], ["unwell", "RB"], ["but", "CC"], ["bears", "NNS"], ["it", "PRP"], ["like", "IN"], ["the", "DT"], ["heroine", "NN"], ["she", "PRP"], ["is", "VBZ"], [["William", "NNP"]], ["O'Connor", "NNP"], ["is", "VBZ"], ["there", "RB"], ["I", "PRP"], ["am", "VBP"], ["now", "RB"], ["at", "IN"], [["Mr.", "NNP"]], ["&", "CC"], ["Mrs.", "NNP"], [["Davis", "NNP"]], ["'s", "POS"], ["Am", "NNP"], ["treated", "VBD"], ["with", "IN"], ["the", "DT"], ["greatest", "JJS"], ["hospitality", "NN"], ["&", "CC"], ["courtesy", "NN"], ["every", "DT"], ["where", "WRB"], [".", "."]], [["Yesterday", "NN"], [["Mr.", "NNP"], ["Davis", "NNP"]], ["took", "VBD"], ["me", "PRP"], ["out", "IN"], ["riding", "VBG"], ["went", "NN"], ["down", "IN"], ["to", "TO"], [["Fields", "NNP"]], ["'", "POS"], [["Point", "NNP"]], [",", ","], ["off", "IN"], ["the", "DT"], ["bay", "NN"], ["&", "CC"], ["thence", "NN"], ["to", "TO"], ["the", "DT"], ["domain", "NN"], ["&", "CC"], ["factories", "NNS"], ["of", "IN"], ["the", "DT"], [["Spragues", "NNPS"]], [",", ","], ["&", "CC"], ["so", "RB"], ["to", "TO"], [["Olneysville", "NNP"]], ["&", "CC"], ["c", "NN"], ["&", "CC"], ["c", "NN"], ["as", "IN"], ["interesting", "JJ"], ["a", "DT"], ["ride", "NN"], ["&", "CC"], ["exploration", "NN"], ["as", "IN"], ["I", "PRP"], ["ever", "RB"], ["had", "VBD"], ["in", "IN"], ["my", "PRP$"], ["life", "NN"], ["I", "PRP"], ["have", "VBP"], ["seen", "VBN"], ["Mrs.", "NNP"], ["Whitman", "NNP"], ["&", "CC"], ["like", "IN"], ["her", "PRP$"], [".", "."]], [["We", "PRP"], ["had", "VBD"], ["yesterday", "NN"], ["here", "RB"], ["to", "TO"], ["dinner", "VB"], ["&", "CC"], ["spend", "VB"], ["the", "DT"], ["evening", "NN"], [["Nora", "NNP"], ["Perry", "NNP"]], [",", ","], [["Wm", "NNP"], ["O'Connor", "NNP"]], [",", ","], ["Dr.", "NNP"], ["Channing", "NNP"], [",", ","], ["&", "CC"], ["c", "NN"], ["To-day", "NN"], ["Mrs.", "NNP"], [["Davis", "NNP"]], ["had", "VBD"], ["intended", "VBN"], ["to", "TO"], ["take", "VB"], ["me", "PRP"], ["out", "RP"], ["riding", "VBG"], [",", ","], ["but", "CC"], ["it", "PRP"], ["is", "VBZ"], ["threatening", "VBG"], ["rain", "NN"], [",", ","], ["wind", "IN"], ["east", "JJ"], [",", ","], ["&", "CC"], ["skies", "NNS"], ["dark", "VBP"], ["So", "RB"], ["it", "PRP"], ["will", "MD"], ["have", "VB"], ["to", "TO"], ["be", "VB"], ["given", "VBN"], ["up", "RP"], [".", "."]], [["I", "PRP"], ["like", "VBP"], [["Mr.", "NNP"], ["Davis", "NNP"]], ["much", "RB"], [".", "."]], [["I", "PRP"], ["am", "VBP"], ["very", "RB"], ["glad", "JJ"], ["I", "PRP"], ["made", "VBD"], ["this", "DT"], ["jaunt", "NN"], ["&", "CC"], ["visit", "NN"], [["Love", "NNP"]], ["to", "TO"], ["you", "PRP"], [",", ","], [["Helen", "NNP"]], [",", ","], [["Emily", "NNP"]], [",", ","], ["&", "CC"], ["all", "DT"], [".", "."]], [[["Walt", "NNP"]], [".", "."]]], "sentences": ["  Providence, R. I.                     October 21, 1868                                  Dear Abby,              I shall return to New York to-morrow, Thursday   leaving here at \u00bd past 12, noon,                  and getting in N. Y. about 8   & intend to go on to Washington on Monday next, 26th.", "I have been at the Channings's   Jeannie is quite unwell   but bears it like the heroine she is   William O'Connor is there   I am now at Mr. & Mrs. Davis's   Am treated with the                  greatest hospitality & courtesy every where.", "Yesterday Mr. Davis took me out riding   went down to Fields' Point, off the bay   & thence to the domain & factories                  of the Spragues, & so to Olneysville &c &c   as interesting a ride                  & exploration as I ever had in my life    I have seen Mrs. Whitman   & like her.", "We had yesterday here to dinner & spend                  the evening Nora Perry, Wm O'Connor, Dr. Channing, &c   To-day Mrs. Davis had                  intended to take me out riding, but it is threatening rain, wind east, & skies dark   So it will have to be given up.", "I like Mr. Davis much.", "I am very glad I made                  this jaunt & visit   Love to you, Helen, Emily, & all.", "Walt.              "], "words": ["Providence", ",", "R.", "I.", "October", "21", ",", "1868", "Dear", "Abby", ",", "I", "shall", "return", "to", "New", "York", "to-morrow", ",", "Thursday", "leaving", "here", "at", "\u00bd", "past", "12", ",", "noon", ",", "and", "getting", "in", "N.", "Y.", "about", "8", "&", "intend", "to", "go", "on", "to", "Washington", "on", "Monday", "next", ",", "26th.", "I", "have", "been", "at", "the", "Channings", "'s", "Jeannie", "is", "quite", "unwell", "but", "bears", "it", "like", "the", "heroine", "she", "is", "William", "O'Connor", "is", "there", "I", "am", "now", "at", "Mr.", "&", "Mrs.", "Davis", "'s", "Am", "treated", "with", "the", "greatest", "hospitality", "&", "courtesy", "every", "where.", "Yesterday", "Mr.", "Davis", "took", "me", "out", "riding", "went", "down", "to", "Fields", "'", "Point", ",", "off", "the", "bay", "&", "thence", "