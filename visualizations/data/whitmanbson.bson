, "VB"], ["from", "IN"], ["you", "PRP"], [".", "."]], [["I", "PRP"], ["consider", "VBP"], ["it", "PRP"], ["an", "DT"], ["opportunity", "NN"], ["for", "IN"], ["you", "PRP"], ["to", "TO"], ["make", "VB"], ["this", "DT"], ["$", "$"], ["50", "CD"], ["the", "DT"], ["father", "NN"], ["of", "IN"], ["100", "CD"], ["'s", "POS"], ["without", "IN"], ["in", "IN"], ["the", "DT"], ["least", "JJS"], ["seeming", "VBG"], ["like", "IN"], ["one", "CD"], ["asking", "VBG"], ["for", "IN"], ["it", "PRP"], ["I", "PRP"], ["certainly", "RB"], ["think", "VBP"], [["Mother", "NNP"]], ["is", "VBZ"], ["following", "VBG"], ["a", "DT"], ["mistaken", "NN"], ["notion", "NN"], ["of", "IN"], ["ecomony.7", "NNP"], ["I", "NNP"], ["think", "VBP"], ["the", "DT"], ["only", "JJ"], ["decent", "NN"], ["meals", "NNS"], ["that", "WDT"], ["any", "DT"], ["of", "IN"], ["them", "PRP"], ["have", "VBP"], ["had", "VBN"], ["for", "IN"], ["three", "CD"], ["months", "NNS"], ["is", "VBZ"], ["what", "WP"], ["they", "PRP"], ["have", "VBP"], ["eaten", "VBN"], ["with", "IN"], [["Mat", "NNP"]], ["and", "CC"], ["I", "PRP"], [".", "."]], [["As", "IN"], ["regards", "NNS"], ["Mother", "NNP"], ["I", "PRP"], ["am", "VBP"], ["perfectly", "RB"], ["willing", "JJ"], ["she", "PRP"], ["should", "MD"], ["live", "VB"], ["with", "IN"], ["us", "PRP"], ["all", "DT"], ["[", ":"], ["the", "DT"], ["time", "NN"], ["?", "."]], [["]", "NN"], ["(", "``"], ["that", "IN"], ["is", "VBZ"], ["to", "TO"], ["eat", "VB"], [",", ","], ["I", "PRP"], ["mean", "VBP"], [")", ":"], ["but", "CC"], [["Ed", "NNP"]], ["and", "CC"], [["Jess", "NNP"]], ["I", "NNP"], ["cant", "NN"], ["stand", "VBP"], ["entirely", "RB"], [".", "."]], [[["Dont", "NNP"]], ["understand", "VBP"], ["me", "PRP"], ["that", "IN"], ["they", "PRP"], ["do", "VBP"], ["eat", "RB"], ["with", "IN"], ["us", "PRP"], [",", ","], ["for", "IN"], ["they", "PRP"], ["dont", "VBP"], ["as", "IN"], ["much", "JJ"], ["perhaps", "NNS"], ["as", "IN"], ["they", "PRP"], ["used", "VBD"], ["to", "TO"], [".", "."]], [[["Mother", "NNP"]], ["certainly", "RB"], ["does", "VBZ"], ["not", "RB"], [",", ","], ["not", "RB"], ["as", "IN"], ["much", "JJ"], ["as", "IN"], ["we", "PRP"], ["wish", "VBP"], ["her", "PRP"], ["to", "TO"], [",", ","], ["for", "IN"], ["we", "PRP"], ["always", "RB"], ["call", "VBP"], ["her", "PRP"], [".", "."]], [["I", "PRP"], ["notice", "VBP"], ["however", "RB"], ["that", "IN"], ["when", "WRB"], [["Jess", "NNP"]], ["does", "VBZ"], ["eat", "NN"], ["with", "IN"], ["us", "PRP"], ["that", "IN"], ["he", "PRP"], ["does", "VBZ"], ["not", "RB"], ["throw", "VB"], ["up", "RP"], ["his", "PRP$"], ["victuals", "NNS"], [".", "."]], [["And", "CC"], [["Andrew", "NNP"]], ["too", "RB"], [",", ","], ["his", "PRP$"], ["trouble", "NN"], ["comes", "VBZ"], ["as", "IN"], ["much", "JJ"], ["from", "IN"], ["his", "PRP$"], ["mode", "NN"], ["of", "IN"], ["living", "NN"], ["and", "CC"], ["sleeping", "VBG"], ["His", "NNP"], ["room", "NN"], ["for", "IN"], ["sleeping", "NN"], ["is", "VBZ"], ["without", "IN"], ["ventilation", "NN"], [".", "."]], [["the", "DT"], ["window", "NN"], ["is", "VBZ"], ["coverd", "VBN"], ["with", "IN"], ["posiness", "NN"], ["tress", "NN"], [".", "."]], [["He", "PRP"], ["has", "VBZ"], ["no", "DT"], ["nice", "JJ"], ["little", "JJ"], ["things", "NNS"], [",", ","], ["[", ":"], ["or", "CC"], ["]", ":"], ["all", "DT"], ["nourishment", "NN"], ["fixed", "VBN"], ["for", "IN"], ["him", "PRP"], ["to", "TO"], ["eat", "VB"], [",", ","], ["such", "JJ"], ["as", "IN"], ["I", "PRP"], ["intended", "VBD"], [["Mat", "NNP"]], ["should", "MD"], ["fix", "VB"], ["for", "IN"], ["him", "PRP"], [".", "."]], [["I", "PRP"], ["dont", "VBP"], ["think", "VBP"], ["myself", "PRP"], ["that", "IN"], ["we", "PRP"], ["have", "VBP"], ["any", "DT"], ["thing", "NN"], ["to", "TO"], ["do", "VB"], ["with", "IN"], [["Nancy", "NNP"]], [",", ","], ["she", "PRP"], ["is", "VBZ"], ["able", "JJ"], ["enough", "RB"], ["to", "TO"], ["make", "VB"], ["a", "DT"], ["good", "JJ"], ["living", "NN"], ["both", "DT"], ["for", "IN"], ["herself", "PRP"], ["and", "CC"], ["the", "DT"], ["children", "NNS"], [",", ","], ["if", "IN"], ["she", "PRP"], ["wasnt", "VBP"], ["so", "RB"], ["dam", "NN"], ["'d", "MD"], ["lazy", "VB"], [".", "."]], [["Walt", "NNP"], ["I", "PRP"], ["wish", "VBP"], ["you", "PRP"], ["was", "VBD"], ["home", "NN"], ["for", "IN"], ["awhile", "NN"], [".", "."]], [["I", "PRP"], ["think", "VBP"], ["you", "PRP"], ["would", "MD"], ["see", "VB"], ["and", "CC"], ["think", "VB"], ["as", "IN"], ["I", "PRP"], ["do", "VBP"], [".", "."]], [["I", "PRP"], ["have", "VBP"], ["scribbled", "VBN"], ["this", "DT"], ["to", "TO"], ["you", "PRP"], ["just", "RB"], ["as", "IN"], ["I", "PRP"], ["have", "VBP"], ["thought", "VBN"], ["for", "IN"], ["a", "DT"], ["day", "NN"], ["or", "CC"], ["two", "CD"], [".", "."]], [[["Ruggles8", "NNP"]], ["says", "VBZ"], ["that", "IN"], [["Andrew", "NNP"]], ["can", "MD"], ["not", "RB"], ["be", "VB"], ["a", "DT"], ["well", "RB"], ["man", "NN"], ["in", "IN"], ["this", "DT"], ["town", "NN"], [",", ","], ["to", "TO"], ["be", "VB"], ["sure", "JJ"], ["even", "RB"], ["going", "VBG"], ["away", "RB"], ["may", "MD"], ["not", "RB"], ["help", "VB"], ["him", "PRP"], [",", ","], ["but", "CC"], ["he", "PRP"], ["thinks", "VBZ"], ["and", "CC"], ["is", "VBZ"], ["almost", "RB"], ["certain", "JJ"], ["that", "IN"], ["it", "PRP"], ["will", "MD"], [".", "."]], [["I", "PRP"], ["wish", "VBP"], ["if", "IN"], ["you", "PRP"], ["dont", "VBP"], ["come", "VBN"], ["on", "IN"], ["you", "PRP"], ["would", "MD"], ["write", "VB"], ["me", "PRP"], ["also", "RB"], ["write", "VBP"], [["Andrew", "NNP"]], [".", "."]], [["Oh", "UH"], ["you", "PRP"], ["dont", "VBP"], ["know", "VBP"], ["how", "WRB"], ["down", "RP"], ["spirited", "VBN"], ["he", "PRP"], ["is", "VBZ"], [["Jeff", "NNP"]], [".", "."]]], "sentences": ["  Brooklyn 24th Sept 1863 Dear brother Walt, The enclosed $25 is from Joseph P. Davis1 making with the $25 sent you last Tuesday $50 from Jo.", "Now I will give you a statement of the whole affair  Last Monday I received a letter from W. S. Davis,2 Jo's brother [at?", "] Worcester, Mass.", "saying that he had received a letter from Joe directing him to send me $70.", "$50 to be sent to you and $20 to be expended in buying a present for young \"Joe Probasco.", "\"3 The $25 I sent you on Tuesday I borrowed of Mr Lane4 so that I might send it immediately and to day I received a check for the $70.", "I have paid Mr Lane the $25 and according to Jo's direction send you the remaind[er] of the $50.", "Jo's brother, W. S. Davis, is a lawer, in Worcester,5 with a large number of acquaintances and I think liberal.", "I wrote him a note acknowledging the recipt of the money and telling him that you would write him a long letter,6 detailing the manner, style, &c &c of your dispensing the money (like those you used to write us)  ask him to show it to his friends and get them to give what they can and have him send it to you  He writes me that he wants you to acknowledge the receipt of the money, and also that he would much like to hear from you.", "I consider it an opportunity for you to make this $50 the father of 100's without in the least seeming like one asking for it I certainly think Mother is following a mistaken notion of ecomony.7 I think the only decent meals that any of them have had for three months is what they have eaten with Mat and I.", "As regards Mother I am perfectly willing she should live with us all [the time?", "] (that is to eat, I mean) but Ed and Jess I cant stand entirely.", "Dont understand me that they do eat with us, for they dont as much perhaps as they used to.", "Mother certainly does not, not as much as we wish her to, for we always call her.", "I notice however that when Jess does eat with us that he does not throw up his victuals.", "And Andrew too, his trouble comes as much from his mode of living and sleeping  His room for sleeping is without ventilation.", "the window is coverd with posiness tress.", "He has no nice little things, [or] all nourishment fixed for him to eat, such as I intended Mat should fix for him.", "I dont think myself that we have any thing to do with Nancy, she is able enough to make a good living both for herself and the children, if she wasnt so dam'd lazy.", "Walt I wish you was home for awhile.", "I think you would see and think as I do.", "I have scribbled this to you just as I have thought for a day or two.", "Ruggles8 says that Andrew cannot be a well man in this town, to be sure even going away may not help him, but he thinks and is almost certain that it will.", "I wish if you dont come on you would write me also write Andrew.", "Oh you dont know how down spirited he is Jeff."], "words": ["Brooklyn", "24th", "Sept", "1863", "Dear", "brother", "Walt", ",", "The", "enclosed", "$", "25", "is", "from", "Joseph", "P.", "Davis1", "making", "with", "the", "$", "25", "sent", "you", "last", "Tuesday", "$", "50", "from", "Jo.", "Now", "I", "will", "give", "you", "a", "statement", "of", "the", "whole", "affair", "Last", "Monday", "I", "received", "a", "letter", "from", "W.", "S.", "Davis,2", "Jo", "'s", "brother", "[", "at", "?", "]", "Worcester", ",", "Mass.", "saying", "that", "he", "had", "received", "a", "letter", "from", "Joe", "directing", "him", "to", "send", "me", "$", "70.", "$", "50", "to", "be", "sent", "to", "you", "and", "$", "20", "to", "be", "expended", "in", "buying", "a", "present", "for", "young", "``", "Joe", "Probasco.", "''", "3", "The", "$", "25", "I", "sent", "you", "on", "Tuesday", "I", "borrowed", "of", "Mr", "Lane4", "so", "that", "I", "might", "send", "it", "immediately", "and", "to", "day", "I", "received", "a", "check", "for", "the", "$", "70.", "I", "have", "paid", "Mr", "Lane", "the", "$", "25", "and", "according", "to", "Jo", "'s", "direction", "send", "you", "the", "remaind", "[", "er", "]", "of", "the", "$", "50.", "Jo", "'s", "brother", ",", "W.", "S.", "Davis", ",", "is", "a", "lawer", ",", "in", "Worcester,5", "with", "a", "large", "number", "of", "acquaintances", "and", "I", "think", "liberal.", "I", "wrote", "him", "a", "note", "acknowledging", "the", "recipt", "of", "the", "money", "and", "telling", "him", "that", "you", "would", "write", "him", "a", "long", "letter,6", "detailing", "the", "manner", ",", "style", ",", "&", "c", "&", "c", "of", "your", "dispensing", "the", "money", "(", "like", "those", "you", "used", "to", "write", "us", ")", "ask", "him", "to", "show", "it", "to", "his", "friends", "and", "get", "them", "to", "give", "what", "they", "can", "and", "have", "him", "send", "it", "to", "you", "He", "writes", "me", "that", "he", "wants", "you", "to", "acknowledge", "the", "receipt", "of", "the", "money", ",", "and", "also", "that", "he", "would", "much", "like", "to", "hear", "from", "you.", "I", "consider", "it", "an", "opportunity", "for", "you", "to", "make", "this", "$", "50", "the", "father", "of", "100", "'s", "without", "in", "the", "least", "seeming", "like", "one", "asking", "for", "it", "I", "certainly", "think", "Mother", "is", "following", "a", "mistaken", "notion", "of", "ecomony.7", "I", "think", "the", "only", "decent", "meals", "that", "any", "of", "them", "have", "had", "for", "three", "months", "is", "what", "they", "have", "eaten", "with", "Mat", "and", "I.", "As", "regards", "Mother", "I", "am", "perfectly", "willing", "she", "should", "live", "with", "us", "all", "[", "the", "time", "?", "]", "(", "that", "is", "to", "eat", ",", "I", "mean", ")", "but", "Ed", "and", "Jess", "I", "cant", "stand", "entirely.", "Dont", "understand", "me", "that", "they", "do", "eat", "with", "us", ",", "for", "they", "dont", "as", "much", "perhaps", "as", "they", "used", "to.", "Mother", "certainly", "does", "not", ",", "not", "as", "much", "as", "we", "wish", "her", "to", ",", "for", "we", "always", "call", "her.", "I", "notice", "however", "that", "when", "Jess", "does", "eat", "with", "us", "that", "he", "does", "not", "throw", "up", "his", "victuals.", "And", "Andrew", "too", ",", "his", "trouble", "comes", "as", "much", "from", "his", "mode", "of", "living", "and", "sleeping", "His", "room", "for", "sleeping", "is", "without", "ventilation.", "the", "window", "is", "coverd", "with", "posiness", "tress.", "He", "has", "no", "nice", "little", "things", ",", "[", "or", "]", "all", "nourishment", "fixed", "for", "him", "to", "eat", ",", "such", "as", "I", "intended", "Mat", "should", "fix", "for", "him.", "I", "dont", "think", "myself", "that", "we", "have", "any", "thing", "to", "do", "with", "Nancy", ",", "she", "is", "able", "enough", "to", "make", "a", "good", "living", "both", "for", "herself", "and", "the", "children", ",", "if", "she", "wasnt", "so", "dam", "'d", "lazy.", "Walt", "I", "wish", "you", "was", "home", "for", "awhile.", "I", "think", "you", "would", "see", "and", "think", "as", "I", "do.", "I", "have", "scribbled", "this", "to", "you", "just", "as", "I", "have", "thought", "for", "a", "day", "or", "two.", "Ruggles8", "says", "that", "Andrew", "can", "not", "be", "a", "well", "man", "in", "this", "town", ",", "to", "be", "sure", "even", "going", "away", "may", "not", "help", "him", ",", "but", "he", "thinks", "and", "is", "almost", "certain", "that", "it", "will.", "I", "wish", "if", "you", "dont", "come", "on", "you", "would", "write", "me", "also", "write", "Andrew.", "Oh", "you", "dont", "know", "how", "down", "spirited", "he", "is", "Jeff", "."], "date": [], "normalizedTime": "0.185366517068", "recipient": "Walt Whitman", "organizations": ["Jess", "Ruggles8"], "sender": "Thomas Jefferson Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00423.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Thomas Jefferson Whitman to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Bethuel", "NNP"], ["Smith", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Dear", "Carlisle"], "money": [], "year": "1863", "locations": [], "month": "Sep", "parties": ["Bethuel Smith", "Walt Whitman"], "properDate": "Sep 28, 1863", "gpe": ["Washington", "Washington"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [38.8951118, -77.0363658]], "text": " Dear Friend I now sit to write to you I hope this will find you in good spirits & well I received your letters & was verry glad to get them & always shall be I am well the toe is getting along verry fast I ware my boots A little everry day I think in A few days I shall be able to join my regiment I hope so anyway for it is so loansome here to me I walk around considerable & the more I walk around the more loansom it is to me the buildings are all burnt & it looks dessolate but they are repareing them again Carlisle is miserabler than Washington for women I think friend walt I should like to Come & see you verry much I hope that I shall join my regimint soon & then shall be near Washington where I Can come & see you Dear friend I dont now as I have anny more to write good by & may god bless you ", "dateText": "", "percents": [], "taggedText": [[[["Dear", "NNP"]], ["Friend", "NNP"], ["I", "NNP"], ["now", "RB"], ["sit", "VB"], ["to", "TO"], ["write", "VB"], ["to", "TO"], ["you", "PRP"], ["I", "PRP"], ["hope", "VBP"], ["this", "DT"], ["will", "MD"], ["find", "VB"], ["you", "PRP"], ["in", "IN"], ["good", "JJ"], ["spirits", "NNS"], ["&", "CC"], ["well", "RB"], ["I", "PRP"], ["received", "VBD"], ["your", "PRP$"], ["letters", "NNS"], ["&", "CC"], ["was", "VBD"], ["verry", "JJ"], ["glad", "NN"], ["to", "TO"], ["get", "VB"], ["them", "PRP"], ["&", "CC"], ["always", "RB"], ["shall", "MD"], ["be", "VB"], ["I", "PRP"], ["am", "VBP"], ["well", "RB"], ["the", "DT"], ["toe", "NN"], ["is", "VBZ"], ["getting", "VBG"], ["along", "IN"], ["verry", "NN"], ["fast", "NN"], ["I", "PRP"], ["ware", "VBP"], ["my", "PRP$"], ["boots", "NNS"], ["A", "DT"], ["little", "RB"], ["everry", "JJ"], ["day", "NN"], ["I", "PRP"], ["think", "VBP"], ["in", "IN"], ["A", "DT"], ["few", "JJ"], ["days", "NNS"], ["I", "PRP"], ["shall", "MD"], ["be", "VB"], ["able", "JJ"], ["to", "TO"], ["join", "VB"], ["my", "PRP$"], ["regiment", "NN"], ["I", "PRP"], ["hope", "VBP"], ["so", "RB"], ["anyway", "RB"], ["for", "IN"], ["it", "PRP"], ["is", "VBZ"], ["so", "RB"], ["loansome", "RB"], ["here", "RB"], ["to", "TO"], ["me", "PRP"], ["I", "PRP"], ["walk", "VBP"], ["around", "RP"], ["considerable", "JJ"], ["&", "CC"], ["the", "DT"], ["more", "RBR"], ["I", "PRP"], ["walk", "VBP"], ["around", "RP"], ["the", "DT"], ["more", "RBR"], ["loansom", "JJ"], ["it", "PRP"], ["is", "VBZ"], ["to", "TO"], ["me", "PRP"], ["the", "DT"], ["buildings", "NNS"], ["are", "VBP"], ["all", "DT"], ["burnt", "NN"], ["&", "CC"], ["it", "PRP"], ["looks", "VBZ"], ["dessolate", "JJ"], ["but", "CC"], ["they", "PRP"], ["are", "VBP"], ["repareing", "VBG"], ["them", "PRP"], ["again", "RB"], [["Carlisle", "NNP"]], ["is", "VBZ"], ["miserabler", "JJR"], ["than", "IN"], [["Washington", "NNP"]], ["for", "IN"], ["women", "NNS"], ["I", "PRP"], ["think", "VBP"], ["friend", "NN"], ["walt", "NN"], ["I", "PRP"], ["should", "MD"], ["like", "VB"], ["to", "TO"], ["Come", "VB"], ["&", "CC"], ["see", "VB"], ["you", "PRP"], ["verry", "VB"], ["much", "JJ"], ["I", "PRP"], ["hope", "VBP"], ["that", "IN"], ["I", "PRP"], ["shall", "MD"], ["join", "VB"], ["my", "PRP$"], ["regimint", "NN"], ["soon", "RB"], ["&", "CC"], ["then", "RB"], ["shall", "MD"], ["be", "VB"], ["near", "IN"], [["Washington", "NNP"]], ["where", "WRB"], ["I", "PRP"], ["Can", "MD"], ["come", "VB"], ["&", "CC"], ["see", "VB"], ["you", "PRP"], ["Dear", "NNP"], ["friend", "VBP"], ["I", "PRP"], ["dont", "VBP"], ["now", "RB"], ["as", "IN"], ["I", "PRP"], ["have", "VBP"], ["anny", "JJ"], ["more", "RBR"], ["to", "TO"], ["write", "VB"], ["good", "JJ"], ["by", "IN"], ["&", "CC"], ["may", "MD"], ["god", "VB"], ["bless", "NN"], ["you", "PRP"]]], "sentences": [" Dear Friend I now sit to write to you I hope this will find you in good spirits & well I received your letters & was verry glad to get them & always shall be I am well the toe is getting along verry fast I ware my boots A little everry day I think in A few days I shall be able to join my regiment I hope so anyway for it is so loansome here to me I walk around considerable & the more I walk around the more loansom it is to me the buildings are all burnt & it looks dessolate but they are repareing them again Carlisle is miserabler than Washington for women I think friend walt I should like to Come & see you verry much I hope that I shall join my regimint soon & then shall be near Washington where I Can come & see you Dear friend I dont now as I have anny more to write good by & may god bless you "], "words": ["Dear", "Friend", "I", "now", "sit", "to", "write", "to", "you", "I", "hope", "this", "will", "find", "you", "in", "good", "spirits", "&", "well", "I", "received", "your", "letters", "&", "was", "verry", "glad", "to", "get", "them", "&", "always", "shall", "be", "I", "am", "well", "the", "toe", "is", "getting", "along", "verry", "fast", "I", "ware", "my", "boots", "A", "little", "everry", "day", "I", "think", "in", "A", "few", "days", "I", "shall", "be", "able", "to", "join", "my", "regiment", "I", "hope", "so", "anyway", "for", "it", "is", "so", "loansome", "here", "to", "me", "I", "walk", "around", "considerable", "&", "the", "more", "I", "walk", "around", "the", "more", "loansom", "it", "is", "to", "me", "the", "buildings", "are", "all", "burnt", "&", "it", "looks", "dessolate", "but", "they", "are", "repareing", "them", "again", "Carlisle", "is", "miserabler", "than", "Washington", "for", "women", "I", "think", "friend", "walt", "I", "should", "like", "to", "Come", "&", "see", "you", "verry", "much", "I", "hope", "that", "I", "shall", "join", "my", "regimint", "soon", "&", "then", "shall", "be", "near", "Washington", "where", "I", "Can", "come", "&", "see", "you", "Dear", "friend", "I", "dont", "now", "as", "I", "have", "anny", "more", "to", "write", "good", "by", "&", "may", "god", "bless", "you"], "date": [], "normalizedTime": "0.185910512716", "recipient": "Walt Whitman", "organizations": [], "sender": "Bethuel Smith", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00598.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Bethuel Smith to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Louisa", "NNP"], ["Van", "NNP"], ["Velsor", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Well", "Major", "Mother", "Jeff", "Jeff", "Mother", "Mother", "Mother", "Meade", "Mat", "Major", "Andrew", "Aunt Fanny", "Ansel", "Quaker", "Mary", "Ansel", "Mrs Price", "Mother"], "money": [], "year": "1863", "locations": [], "month": "Sep", "parties": ["Walt Whitman", "Louisa Van Velsor Whitman"], "properDate": "Sep 29, 1863", "gpe": ["Washington", "Major Hapgood", "Virginia", "Boston", "George", "East", "North", "American", "Farmingdale"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [37.4315734, -78.6568942], [42.3584308, -71.0597732], [22.5009081, 114.1558258], [40.7325997, -73.4454009], [39.3270677, -79.2802633], [32.7765656, -79.93092159999999]], "text": "  Washington |  Sept 29 1863  Dear Mother, Well here I sit this forenoon in a corner by the window in Major Hapgood's office   all the Potomac & Maryland & Virginia hills in sight   writing my Tuesday letter to you, dearest mother   Major has gone home to Boston on sick leave, & only the clerk & me occupy the office & he not much of the time   at the present moment there are two wounded officers come in to get their pay, one has crutches   the other is drest in the light blue uniform of the invalid corps   way up here in the 5th floor it is pretty hard scratching for cripples & very weak men to journey up here   often they come up here very weary & faint, & then find out they can't get their money, some red tape hitch, & the poor soldiers look so disappointed   it always makes me feel bad    Mother, we are having perfect weather here nowadays, both night & day   the nights are wonderful, for the last three nights as I have walked home from the hospital pretty late, it has seemed to me like a dream, the moon & sky ahead of any thing I ever see before   Mother, do you hear any thing from George, I wrote to him yesterday & sent him your last letter & Jeff's enclosed   I shall send him some papers to-day   I send papers quite often   (why hasn't Jeff sent me the Union1 with my letter in   I want much to see it, & whether they have misprinted it.) Mother, I dont think the 51st has been in any of the fighting we know of down there yet   what is to come of course nobody can tell   As to Burnside I suppose you know he is among his friends, & I think this quite important, for such the main body of East Tennesseans are, & are far truer Americans any how than the Copperheads of the North   the Tennesseans will fight for us too   Mother, you have no idea how the soldiers, sick &c. (I mean the American ones to a man) all feel about the copperheads, they never speak of them without a curse & I hear them say with an air that shows they mean it, they would shoot them sooner than they would a rebel   Mother, the troops from Meade's army are passing through here night & day, going west & so down to reinforce Rosecrans I suppose   the papers are not permitted to mention it, but it is so   two Army Corps I should think have mostly passed   they go through night & day   I hear the whistle of the locomotive screaming away any time at night when I wake up, & the rumbling of the trains    Mother dear, you must write to me soon, & so must Jeff   I thought Mat was going to send me a great long letter, I am always looking for it, I hope it will be full of every thing about family matters & doings, & how every body really is   I go to Major's box three or four times a day   I want to hear also about Andrew, & indeed about every one of you & every thing, nothing is too trifling, nothing uninteresting. O mother, who do you think I got a letter from, two or three days ago   Aunt Fanny, Ansel's mother   She sent it by a young man, a wounded soldier who has been home to Farmingdale on furlough, & lately returned   she writes a first rate letter, Quaker all over2   I shall answer it   She says Mary & Ansel & all are well   I have rec'd another letter from Mrs Price, she has not good health, I am sorry for her from my heart, she is a good noble woman, no better kind   Mother, I am in the hospitals as usual   I stand it better the last three weeks than ever before   I go among the worst fevers & wounds with impunity   I go among the small pox, &c just the same   I feel to go without apprehension, & so I go   nobody else goes, & as the darkey said there at Charleston when the boat run on a flat & the reb sharpshooters were peppering them, somebody must jump in de water (& shove the boat off)    Walt ", "dateText": "", "percents": [], "taggedText": [[[["Washington", "NNP"]], ["|", ":"], ["Sept", "NNP"], ["29", "CD"], ["1863", "CD"], ["Dear", "NNP"], ["Mother", "NNP"], [",", ","], [["Well", "NNP"]], ["here", "RB"], ["I", "PRP"], ["sit", "VBP"], ["this", "DT"], ["forenoon", "NN"], ["in", "IN"], ["a", "DT"], ["corner", "NN"], ["by", "IN"], ["the", "DT"], ["window", "NN"], ["in", "IN"], [["Major", "NNP"], ["Hapgood", "NNP"]], ["'s", "POS"], ["office", "NN"], ["all", "DT"], ["the", "DT"], [["Potomac", "NNP"]], ["&", "CC"], [["Maryland", "NNP"]], ["&", "CC"], [["Virginia", "NNP"]], ["hills", "NNS"], ["in", "IN"], ["sight", "NN"], ["writing", "VBG"], ["my", "PRP$"], ["Tuesday", "NNP"], ["letter", "NN"], ["to", "TO"], ["you", "PRP"], [",", ","], ["dearest", "VBP"], ["mother", "NN"], [["Major", "NNP"]], ["has", "VBZ"], ["gone", "VBN"], ["home", "NN"], ["to", "TO"], [["Boston", "NNP"]], ["on", "IN"], ["sick", "NN"], ["leave", "NN"], [",", ","], ["&", "CC"], ["only", "RB"], ["the", "DT"