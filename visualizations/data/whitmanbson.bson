ulations etc. on the marriage.         Kindest respects to Mrs. Rossetti. I have lately received a good kind letter from Tennyson.        Write soon and freely. I am pretty lonesome here.  Walt Whitman        ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["St.", "NNP"]], ["/", "NNP"], [["Camden", "NNP"]], [",", ","], ["N.", "NNP"], ["Jersey", "NNP"], [".", "."]], [["/", "NN"], [["U.S.", "NNP"]], ["America", "NNP"], ["19", "CD"], ["October", "NNP"], ["1875", "CD"], [".", "."]], [["My", "PRP$"], ["dear", "NN"], [["Mr.", "NNP"], ["Rossetti", "NNP"]], [",", ","], ["Let", "NNP"], ["me", "PRP"], ["by", "IN"], ["this", "DT"], ["introduce", "NN"], ["to", "TO"], ["you", "PRP"], ["an", "DT"], ["old", "JJ"], ["and", "CC"], ["valued", "VBN"], ["friend", "NN"], ["of", "IN"], ["mine", "JJ"], [",", ","], ["J", "NNP"], [".", "."]], [["B.", "NNP"], [["Marvin", "NNP"]], [",", ","], ["who", "WP"], ["is", "VBZ"], ["making", "VBG"], ["a", "DT"], ["short", "JJ"], ["visit", "NN"], ["to", "TO"], [["London", "NNP"]], ["on", "IN"], ["business", "NN"], [".", "."]], [[["Mr.", "NNP"]], [["Marvin", "NNP"]], ["is", "VBZ"], ["a", "DT"], [["New", "JJ"], ["Englander", "NNP"]], [",", ","], ["literary", "JJ"], [",", ","], ["democratic", "JJ"], [",", ","], ["has", "VBZ"], ["a", "DT"], ["family", "NN"], [",", ","], ["and", "CC"], ["has", "VBZ"], ["a", "DT"], ["position", "NN"], ["in", "IN"], ["the", "DT"], [["Treasury", "NNP"]], ["at", "IN"], [["Washington", "NNP"]], [".", "."]], [["I", "PRP"], ["still", "RB"], ["continue", "VBP"], ["here", "RB"], [",", ","], ["laid", "VBD"], ["up", "RP"], [",", ","], ["but", "CC"], ["working", "VBG"], ["a", "DT"], ["very", "RB"], ["little", "JJ"], [".", "."]], [["Best", "JJS"], ["wishes", "NNS"], [",", ","], ["congratulations", "NNS"], ["etc", "VBP"], [".", "."]], [["on", "IN"], ["the", "DT"], ["marriage", "NN"], [".", "."]], [[["Kindest", "NNP"]], ["respects", "NNS"], ["to", "TO"], ["Mrs.", "NNP"], ["Rossetti", "NNP"], [".", ".