", "gpe": ["Have", "Minnesota"], "facility": [], "latlngs": [], "text": "  431 Stevens st. Camden, N.J.           May 6.                            Yours rec'd, & welcomed. Have been to the doctor's to-day   troubles of breast & left side getting steadier & more severe   in fact in addition to other troubles ugly gastric & catarrhal ones   Am still out & around some, however, & shan't give up yet    May 7   2 p.m. Nothing new or different   have had a long good call from a friend          from Minnesota this forenoon   & a letter & papers from Denmark     W. W.        ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"], ["Camden", "NNP"]], [",", ","], ["N.J.", "NNP"], ["May", "NNP"], ["6", "CD"], [".", "."]], [["Yours", "NNS"], ["rec", "VBP"], ["'d", "JJ"], [",", ","], ["&", "CC"], ["welcomed", "VBN"], [".", "."]], [[["Have", "NNP"]], ["been", "VBN"], ["to", "TO"], ["the", "DT"], ["doctor", "NN"], ["'s", "POS"], ["to-day", "JJ"], ["troubles", "NNS"], ["of", "IN"], ["breast", "JJ"], ["&", "CC"], ["left", "VBN"], ["side", "NN"], ["getting", "VBG"], ["steadier", "JJR"], ["&", "CC"], ["more", "JJR"], ["severe", "JJ"], ["in", "IN"], ["fact", "NN"], ["in", "IN"], ["addition", "NN"], ["to", "TO"], ["other", "JJ"], ["troubles", "NNS"], ["ugly", "RB"], ["gastric", "JJ"], ["&", "CC"], ["catarrhal", "JJ"], ["ones", "NNS"], ["Am", "NNP"], ["still", "RB"], ["out", "IN"], ["&", "CC"], ["around", "IN"], ["some", "DT"], [",", ","], ["however", "RB"], [",", ","], ["&", "CC"], ["sha", "NN"], ["n't", "RB"], ["give", "VB"], ["up", "RP"], ["yet", "RB"], ["May", "NNP"], ["7", "CD"], ["2", "CD"], ["p.m", "JJ"], [".", "."]], [["Nothing", "NN"], ["new", "JJ"], ["or", "CC"], ["different", "JJ"], ["have", "VBP"], ["had", "VBN"], ["a", "DT"], ["long", "JJ"], ["good", "JJ"], ["call", "NN"], ["from", "IN"], ["a", "DT"], ["friend", "NN"], ["from", "IN"], [["Minnesota", "NNP"]], ["this", "DT"], ["forenoon", "NN"], ["&", "CC"], ["a", "DT"], ["letter