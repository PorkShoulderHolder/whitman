act", "untold", "wealth", "&", "I", "shall", "not", "feel", "right", "if", "you", "undertake", "to", "alter", "this", "part", "of", "my", "programme", "I", "am", "feeling", "well", "&", "hearty", "I", "wish", "you", "to", "read", "my", "piece", "in", "the", "``", "Broadway", "London", "Magazine", ",", "''", "just", "out", "it", "was", "written", "for", "you", "among", "the", "rest", "In", "a", "few", "hours", "I", "shall", "be", "with", "you.", "Walt", "."], "date": [], "normalizedTime": "0.432476540188", "recipient": "Abby H. Price", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/pml.00026.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Abby H. Price ,"}, {"taggedHeading": [[[["Peter", "NNP"]], [["Doyle", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whiman", "NNP"]], [",", ","]]], "people": ["Dear Walt", "History", "Very", "Dave", "Peter Doyle"], "money": [], "year": "1868", "locations": [], "month": "Sep", "parties": ["Peter", "Doyle", "Walt Whiman"], "properDate": "Sep 18, 1868", "gpe": ["Washington"], "facility": [], "latlngs": [[38.8951118, -77.0363658]], "text": "image 1image 2image 3image 4  Washington                     Sep 18                                  Dear Walt,              I could not resist the inclination to write to you this morning it seems more than a week since i saw you there is hardly anything of interest transpired since you went away except occasionaly some one inquires for the Major, or the General or some familiar name which no doubt which you have heard so often Dear Walt I have examined that book (Pollards History) and i am Very much displeased with it i find it is quite the opposite from what i was led to believe i thought it mentioned the movements of the different companys & Regiments i am sorry that i made such a mistake because the Book is of no interest to me inclosed you will find somemthing from this mornings Cronicle it seems the Washington Papers has you right for once i am very impatient to hear from you to know that you are doing well Dave & all the rest of the Rail Road boys is well & sends their best respects mother had a very sick headache when i left home this morning i have to cut this short as i write a part of it while the car is in motion                  farewell                 Peter Doyle              ", "dateText": "", "percents": [], "taggedText": [[["image", "NN"], ["1image", "NN"], ["2image", "NN"], ["3image", "NN"], ["4", "CD"], [["Washington", "NNP"]], ["Sep", "NNP"], ["18", "CD"], ["Dear", "NNP"], ["Walt", "NNP"], [",", ","], ["I", "PRP"], ["could", "MD"], ["not", "RB"], ["resist", "VB"], ["the", "DT"], ["inclination", "NN"], ["to", "TO"], ["write", "VB"], ["to", "TO"], ["you", "PRP"], ["this", "DT"], ["morning", "NN"], ["it", "PRP"], ["seems", "VBZ"], ["more", "JJR"], ["than", "IN"], ["a", "DT"], ["week", "NN"], ["since", "IN"], ["i", "PRP"], ["saw", "VBD"], ["you", "PRP"], ["there", "EX"], ["is", "VBZ"], ["hardly", "RB"], ["anything", "NN"], ["of", "IN"], ["interest", "NN"], ["transpired", "VBN"], ["since", "IN"], ["you", "PRP"], ["went", "VBD"], ["away", "RB"], ["except", "IN"], ["occasionaly", "RB"], ["some", "DT"], ["one", "CD"], ["inquires", "NNS"], ["for", "IN"], ["the", "DT"], ["Major", "NNP"], [",", ","], ["or", "CC"], ["the", "DT"], [["General", "NNP"]], ["or", "CC"], ["some", "DT"], ["familiar", "JJ"], ["name", "NN"], ["which", "WDT"], ["no", "DT"], ["doubt", "NN"], ["which", "WDT"], ["you", "PRP"], ["have", "VBP"], ["heard", "VBN"], ["so", "RB"], ["often", "RB"], [["Dear", "NNP"], ["Walt", "NNP"]], ["I", "NNP"], ["have", "VBP"], ["examined", "VBN"], ["that", "IN"], ["book", "NN"], ["(", ":"], ["Pollards", "NNS"], [["History", "NNP"]], [")", "NNP"], ["and", "CC"], ["i", "PRP"], ["am", "VBP"], [["Very", "NNP"]], ["much", "RB"], ["displeased", "VBD"], ["with", "IN"], ["it", "PRP"], ["i", "PRP"], ["find", "VBP"], ["it", "PRP"], 