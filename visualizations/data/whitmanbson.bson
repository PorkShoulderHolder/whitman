 [], "facility": [], "latlngs": [], "text": "  431 Stevens st. Camden, N. Jersey           May 8   noon                               Every thing pretty much the same. Rather a bad week with me   no improvement   great distress in head          & left side, at intervals   cannot write much to-day   Will do better next time     W W        Your letter & paper came. ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"], ["Camden", "NNP"]], [",", ","], ["N.", "NNP"], [["Jersey", "NNP"]], ["May", "NNP"], ["8", "CD"], ["noon", "NN"], ["Every", "NNP"], ["thing", "NN"], ["pretty", "RB"], ["much", "RB"], ["the", "DT"], ["same", "JJ"], [".", "."]], [["Rather", "RB"], ["a", "DT"], ["bad", "JJ"], ["week", "NN"], ["with", "IN"], ["me", "PRP"], ["no", "DT"], ["improvement", "NN"], ["great", "NN"], ["distress", "NN"], ["in", "IN"], ["head", "NN"], ["&", "CC"], ["left", "VBN"], ["side", "NN"], [",", ","], ["at", "IN"], ["intervals", "NNS"], ["can", "MD"], ["not", "RB"], ["write", "VB"], ["much", "JJ"], ["to-day", "NN"], [["Will", "NNP"]], ["do", "VBP"], ["better", "JJR"], ["next", "JJ"], ["time", "NN"], ["W", "NNP"], ["W", "NNP"], ["Your", "NNP"], ["letter", "NN"], ["&", "CC"], ["paper", "NN"], ["came", "VBD"], [".", "."]]], "sentences": ["  431 Stevens st. Camden, N. Jersey           May 8   noon                               Every thing pretty much the same.", "Rather a bad week with me   no improvement   great distress in head          & left side, at intervals   cannot write much to-day   Will do better next time     W W        Your letter & paper came. "], "words": ["431", "Stevens", "st.", "Camden", ",", "N.", "Jersey", "May", "8", "noon", "Every", "thing", "pretty", "much", "the", "same.", "Rather", "a", "bad", "week", "with", "me", "no", "improvement", "great", "distress", "in", "head", "&", "left", "side", ",", "at", "intervals", "can", "not", "write", "much", "to-day", "Will", "do", "better", "next", "time", "W", "W", "Your", "letter", "&", "paper", "came", "."], "date": [], "normalizedTime": "0.71290629675", "recipient": "Peter Doyle", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/nyp.00340.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Peter Doyle ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Peter", "NNP"], ["Doyle", "NNP"]], [",", ","]]], "people": ["Stevens st. Camden"], "money": [], "year": "1874", "locations": [], "month": "May", "parties": ["Walt", "Whitman", "Peter Doyle"], "properDate": "May 15, 1874", "gpe": [], "facility": [], "latlngs": [], "text": "                     431 Stevens st. Camden, N. Jersey.           Friday, May 15.                            Yours of last Sunday rec'd   paper also   Pretty bad spells of last week have let-up this morning   feel more comfortable than usual to-day   I don't get discouraged   & you mustn't either     W W        ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"], ["Camden", "NNP"]], [",", ","], ["N.", "NNP"], ["Jersey", "NNP"], [".", "."]], [["Friday", "NNP"], [",", ","], ["May", "NNP"], ["15", "CD"], [".", "."]], [["Yours", "NNS"], ["of", "IN"], ["last", "JJ"], ["Sunday", "NNP"], ["rec", "NN"], ["'d", "MD"], ["paper", "NN"], ["also", "RB"], ["Pretty", "NNP"], ["bad", "JJ"], ["spells", "NNS"], ["of", "IN"], ["last", "JJ"], ["week", "NN"], ["have", "VBP"], ["let-up", "JJ"], ["this", "DT"], ["morning", "NN"], ["feel", "NN"], ["more", "RBR"], ["comfortable", "JJ"], ["than", "IN"], ["usual", "JJ"], ["to-day", "NN"], ["I", "PRP"], ["do", "VBP"], ["n't", "RB"], ["get", "VB"], ["discouraged", "VBN"], ["&", "CC"], ["you", "PRP"], ["must", "MD"], ["n't", "RB"], ["either", "VB"], ["W", "NNP"], ["W", "NNP"]]], "sentences": ["                     431 Stevens st. Camden, N. Jersey.", "Friday, May 15.", "Yours of last Sunday rec'd   paper also   Pretty bad spells of last week have let-up this morning   feel more comfortable than usual to-day   I don't get discouraged   & you mustn't either     W W        "], "words": ["431", "Stevens", "st.", "Camden", ",", "N.", "Jersey.", "Friday", ",", "May", "15.", "Yours", "of", "last", "Sunday", "rec", "'d", "paper", "also", "Pretty", "bad", "spells", "of", "last", "week", "have", "let-up", "this", "morning", "feel", "more", "comfortable", "than", "usual", "to-day", "I", "do", "n't", "get", "discouraged", "&", "you", "must", "n't", "either", "W", "W"], "date": [], "normalizedTime": "0.713858289134", "recipient": "Peter Doyle", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/nyp.00341.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Peter Doyle ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Ellen", "NNP"], ["M.", "NNP"]], ["O'Connor", "NNP"], [",", ","]]], "people": ["Stevens st.", "Camden", "Dear"], "money": [], "year": "1874", "locations": ["West"], "month": "May", "parties": ["Walt", "Whitman", "Ellen M."], "properDate": "May 15, 1874", "gpe": ["Nelly", "Graham", "Norwich"], "facility": [], "latlngs": [[47.0528789, -122.2942839], [52.6308859, 1.297355]], "text": "  431 Stevens                st.                             / cor West / Camden, /                N.                             Jersey. Friday, May 15.                   Dear Nelly,        I have had a succession of bad spells, (& pretty close together) since I wrote         the encouraging lines, some two or three weeks ago   indeed for a month now, in addition to other troubles, a pronounced         pain & distress in left side, growing intenser & quite extended   often         coming on at night, waking me up, & keeping me from sleep all night         afterward   But this morning as I write, (9 o'clock after breakfast   fish,         Graham bread, tea, my appetite, though modified, by no means lost)   I feel         quite peert, in good spirits, free from any marked         distress   & if you were to come in this minute, (than which, dear Nelly, I         can think of no blesseder God-send,) you would say I appear in face, flesh, color,         expression, &c. just the same Walt as of yore   Will         this good turn & let-up of today (yesterday morning at this time I felt like         death   & thought of it   ) be followed by other relapses?         Probably   for so it has been now for nearly a year. And yet each time I cannot         help fancying that now I am going to recuperate    As I write, sitting here in the parlor alone by the window, it is very         pleasant   soothing   it is a sweet balmy, not hot morning   my         sister's sister, from Norwich, Conn. is here on a         visit, with her little 8 months old babe-boy   She is walking in the other         room, singing it to sleep, in her arms   she has a fine contralto voice, &         is singing beautifully, unconsciously   it does me good too     Walt        ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"]], ["/", "NNP"], ["cor", "NN"], [["West", "NNP"]], ["/", "NNP"], [["Camden", "NNP"]], [",", ","], ["/", "NNP"], ["N.", "NNP"], ["Jersey", "NNP"], [".", "."]], [["Friday", "NNP"], [",", ","], ["May", "NNP"], ["15", "CD"], [".", "."]], [[["Dear", "NNP"]], [["Nelly", "NNP"]], [",", ","], ["I", "PRP"], ["have", "VBP"], ["had", "VBN"], ["a", "DT"], ["succession", "NN"], ["of", "IN"], ["bad", "JJ"], ["spells", "NNS"], [",", ","], ["(", ":"], ["&", "CC"], ["pretty", "RB"], ["close", "JJ"], ["together", "NN"], [")", ":"], ["since", "IN"], ["I", "PRP"], ["wrote", "VBD"], ["the", "DT"], ["encouraging", "NN"], ["lines", "NNS"], [",", ","], ["some", "DT"], ["two", "CD"], ["or", "CC"], ["three", "CD"], ["weeks", "NNS"], ["ago", "IN"], ["indeed", "RB"], ["for", "