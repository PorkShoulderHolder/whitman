e", "PRP"], ["is", "VBZ"], ["dated", "VBN"], ["Jan", "NNP"], ["27th", "CD"], [".", "."]], [["You", "PRP"], ["speak", "VBP"], ["of", "IN"], ["haveing", "VBG"], ["sent", "NN"], ["one", "CD"], ["the", "DT"], ["previous", "JJ"], ["Saturday", "NNP"], [",", ","], ["encloseing", "VBG"], ["one", "CD"], ["from", "IN"], ["home", "NN"], [",", ","], ["and", "CC"], ["some", "DT"], ["money", "NN"], [".", "."]], [["I", "PRP"], ["have", "VBP"], ["not", "RB"], ["received", "VBN"], ["it", "PRP"], [".", "."]], [["I", "PRP"], ["got", "VBD"], ["a", "DT"], ["letter", "NN"], ["from", "IN"], [["Mother", "NNP"]], ["a", "DT"], ["day", "NN"], ["or", "CC"], ["two", "CD"], ["ago", "IN"], [".", "."]], [["She", "PRP"], ["says", "VBZ"], ["they", "PRP"], ["are", "VBP"], ["all", "RB"], ["getting", "VBG"], ["along", "IN"], ["after", "IN"], ["the", "DT"], ["old", "JJ"], ["sort", "NN"], [".", "."]], [[["Han", "NNP"]], ["has", "VBZ"], ["not", "RB"], ["got", "VBN"], ["home", "NN"], ["yet", "RB"], [",", ","], ["but", "CC"], [["Mother", "NNP"]], ["says", "VBZ"], ["she", "PRP"], ["expects", "VBZ"], ["her", "PRP$"], ["before", "IN"], ["a", "DT"], ["great", "JJ"], ["while", "NN"], [".", "."]], [["We", "PRP"], ["had", "VBD"], ["a", "DT"], ["regular", "JJ"], ["old", "JJ"], [["Northern", "NNP"]], ["snow", "NN"], ["storm", "NN"], ["last", "JJ"], ["week", "NN"], [",", ","], ["but", "CC"], ["it", "PRP"], ["is", "VBZ"], ["nearly", "RB"], ["gone", "VBN"], ["now", "RB"], ["but", "CC"], ["the", "DT"], ["mud", "NN"], ["is", "VBZ"], ["quite", "RB"], ["plenty", "JJ"], ["just", "RB"], ["about", "IN"], ["hear", "JJ"], [".", "."]], [["Capt", "NNP"], ["Sims", "NNP"], ["tells", "VBZ"], ["me", "PRP"], ["to", "TO"], ["night", "NN"], ["that", "IN"], ["he", "PRP"], ["has", "VBZ"], ["been", "VBN"], ["promised", "VBN"], ["a", "DT"], ["leave", "NN"], ["of", "IN"], ["absence", "NN"], ["for", "IN"], ["10", "CD"], ["days", "NNS"], ["and", "CC"], ["will", "MD"], ["probaly", "RB"], ["start", "VB"], ["for", "IN"], [["Brooklyn", "NNP"]], ["in", "IN"], ["a", "DT"], ["day", "NN"], ["or", "CC"], ["two", "CD"], ["I", "PRP"], ["suppose", "VBP"], ["he", "PRP"], ["will", "MD"], ["call", "VB"], ["on", "IN"], ["you", "PRP"], ["in", "IN"], ["Washington.2", "-NONE-"], ["As", "IN"], ["soon", "RB"], ["as", "IN"], ["he", "PRP"], ["gets", "VBZ"], ["back", "RB"], [",", ","], ["I", "PRP"], ["shall", "MD"], ["apply", "VB"], [",", ","], ["and", "CC"], ["if", "IN"], ["I", "PRP"], ["dont", "VBP"], ["get", "VB"], ["it", "PRP"], ["I", "PRP"], ["dont", "VBP"], ["know", "RB"], ["but", "CC"], ["I", "PRP"], ["will", "MD"], ["send", "VB"], ["in", "IN"], ["my", "PRP$"], ["resignation", "NN"], ["as", "IN"], ["it", "PRP"], ["is", "VBZ"], ["hardly", "RB"], ["a", "DT"], ["fair", "JJ"], ["shake", "NN"], ["for", "IN"], ["some", "DT"], ["to", "TO"], ["go", "VB"], ["home", "RB"], ["two", "CD"], ["or", "CC"], ["three", "CD"], ["times", "NNS"], ["a", "DT"], ["year", "NN"], ["while", "IN"], ["others", "NNS"], ["cant", "VBP"], ["get", "NN"], ["away", "RB"], ["at", "IN"], ["all", "DT"], [",", ","], ["but", "CC"], ["I", "PRP"], ["dont", "VBP"], ["blame", "JJ"], ["Sims", "NNS"], ["at", "IN"], ["all", "DT"], ["for", "IN"], ["going", "VBG"], ["whenever", "RB"], ["he", "PRP"], ["can", "MD"], ["get", "VB"], ["a", "DT"], ["chance", "NN"], [".", "."]], [["Walt", "NNP"], ["I", "PRP"], ["think", "VBP"], ["you", "PRP"], ["had", "VBD"], ["better", "RBR"], ["write", "JJ"], ["on", "IN"], ["to", "TO"], [["Mother", "NNP"]], ["and", "CC"], ["let", "VB"], ["her", "PRP$"], ["send", "NN"], ["you", "PRP"], ["(", "VBP"], ["by", "IN"], ["express", "NN"], [")", ":"], ["$", "$"], ["20", "CD"], ["of", "IN"], ["my", "PRP$"], ["money", "NN"], ["and", "CC"], ["bring", "VBG"], ["it", "PRP"], ["on", "IN"], ["here", "RB"], ["to", "TO"], ["me", "PRP"], ["when", "WRB"], ["you", "PRP"], ["come", "VBP"], [",", ","], ["for", "IN"], ["if", "IN"], ["I", "PRP"], ["go", "VBP"], ["home", "RB"], ["I", "PRP"], ["shall", "MD"], ["want", "VB"], ["it", "PRP"], [",", ","], ["as", "IN"], ["I", "PRP"], ["may", "MD"], ["not", "RB"], ["have", "VB"], ["a", "DT"], ["chance", "NN"], ["to", "TO"], ["get", "VB"], ["my", "PRP$"], ["pay", "NN"], ["in", "IN"], [["Washington", "NNP"]], [".", "."]], [[["Tom3", "NNP"]], ["recd", "VBD"], [".", "."]], [["a", "DT"], ["letter", "NN"], ["from", "IN"], ["you", "PRP"], ["to", "TO"], ["night", "NN"], [".", "."]], [[["Write", "NNP"]], ["as", "IN"], ["soon", "RB"], ["as", "IN"], ["you", "PRP"], ["get", "VBP"], ["this", "DT"], [".", "."]], [[["Good", "NNP"]], ["night", "NN"], ["G.W.W", "-NONE-"], [".", "."]]], "sentences": ["  Camp near FalmouthVa.", "Feb 1st /63 Dear Walt.", "Here we are yet in camp just the same as you left us, and I think by the appearance of things here we are likely to stay for some time.", "I have my log hut partly finished and should have had it completed long ago, but after I had cut the logs and had them brought here, orders came for us to be ready to move the next day so I used the logs for fire wood, and since then, the weather has been so stormy I could not do much to it.", "I suppose we will go on picket tomorrow, so that I wont have a chance to do anything to the house untill Wednesday, but I shall finish it this week, and as soon as I get it done, I want you to come down and see me.", "Frank Butler1 is helping me build it and is to occupy apartments in it.", "Your last letter to me is dated Jan 27th.", "You speak of haveing sent one the previous Saturday, encloseing one from home, and some money.", "I have not received it.", "I got a letter from Mother a day or two ago.", "She says they are all getting along after the old sort.", "Han has not got home yet, but Mother says she expects her before a great while.", "We had a regular old Northern snow storm last week, but it is nearly gone now but the mud is quite plenty just about hear.", "Capt Sims tells me to night that he has been promised a leave of absence for 10 days and will probaly start for Brooklyn in a day or two  I suppose he will call on you in Washington.2 As soon as he gets back, I shall apply, and if I dont get it I dont know but I will send in my resignation  as it is hardly a fair shake for some to go home two or three times a year while others cant get away at all, but I dont blame Sims at all for going whenever he can get a chance.", "Walt I think you had better write on to Mother and let her send you (by express) $20 of my money and bring it on here to me when you come, for if I go home I shall want it, as I may not have a chance to get my pay in Washington.", "Tom3 recd.", "a letter from you to night.", "Write as soon as you get this.", "Good night     G.W.W. "], "words": ["Camp", "near", "FalmouthVa.", "Feb", "1st", "/63", "Dear", "Walt.", "Here", "we", "are", "yet", "in", "camp", "just", "the", "same", "as", "you", "left", "us", ",", "and", "I", "think", "by", "the", "appearance", "of", "things", "here", "we", "are", "likely", "to", "stay", "for", "some", "time.", "I", "have", "my", "log", "hut", "partly", "finished", "and", "should", "have", "had", "it", "completed", "long", "ago", ",", "but", "after", "I", "had", "cut", "the", "logs", "and", "had", "them", "brought", "here", ",", "orders", "came", "for", "us", "to", "be", "ready", "to", "move", "the", "next", "day", "so", "I", "used", "the", "logs", "for", "fire", "wood", ",", "and", "since", "then", ",", "the", "weather", "has", "been", "so", "stormy", "I", "could", "not", "do", "much", "to", "it.", "I", "suppose", "we", "will", "go", "on", "picket", "tomorrow", ",", "so", "that", "I", "wont", "have", "a", "chance", "to", "do", "anything", "to", "the", "house", "untill", "Wednesday", ",", "but", "I", "shall", "finish", "it", "this", "week", ",", "and", "as", "soon", "as", "I", "get", "it", "done", ",", "I", "want", "you", "to", "come", "down", "and", "see", "me.", "Frank", "Butler1", "is", "helping", "me", "build", "it", "and", "is", "to", "occupy", "apartments", "in", "it.", "Your", "last", "letter", "to", "me", "is", "dated", "Jan", "27th.", "You", "speak", "of", "haveing", "sent", "one", "the", "previous", "Saturday", ",", "encloseing", "one", "from", "home", ",", "and", "some", "money.", "I", "have", "not", "received", "it.", "I", "got", "a", "letter", "from", "Mother", "a", "day", "or", "two", "ago.", "She", "says", "they", "are", "all", "getting", "along", "after", "the", "old", "sort.", "Han", "has", "not", "got", "home", "yet", ",", "but", "Mother", "says", "she", "expects", "her", "before", "a", "great", "while.", "We", "had", "a", "regular", "old", "Northern", "snow", "storm", "last", "week", ",", "but", "it", "is", "nearly", "gone", "now", "but", "the", "mud", "is", "quite", "plenty", "just", "about", "hear.", "Capt", "Sims", "tells", "me", "to", "night", "that", "he", "has", "been", "promised", "a", "leave", "of", "absence", "for", "10", "days", "and", "will", "probaly", "start", "for", "Brooklyn", "in", "a", "day", "or", "two", "I", "suppose", "he", "will", "call", "on", "you", "in", "Washington.2", "As", "soon", "as", "he", "gets", "back", ",", "I", "shall", "apply", ",", "and", "if", "I", "dont", "get", "it", "I", "dont", "know", "but", "I", "will", "send", "in", "my", "resignation", "as", "it", "is", "hardly", "a", "fair", "shake", "for", "some", "to", "go", "home", "two", "or", "three", "times", "a", "year", "while", "others", "cant", "get", "away", "at", "all", ",", "but", "I", "dont", "blame", "Sims", "at", "all", "for", "going", "whenever", "he", "can", "get", "a", "chance.", "Walt", "I", "think", "you", "had", "better", "write", "on", "to", "Mother", "and", "let", "her", "send", "you", "(", "by", "express", ")", "$", "20", "of", "my", "money", "and", "bring", "it", "on", "here", "to", "me", "when", "you", "come", ",", "for", "if", "I", "go", "home", "I", "shall", "want", "it", ",", "as", "I", "may", "not", "have", "a", "chance", "to", "get", "my", "pay", "in", "Washington.", "Tom3", "recd.", "a", "letter", "from", "you", "to", "night.", "Write", "as", "soon", "as", "you", "get", "this.", "Good", "night", "G.W.W", "."], "date": [], "normalizedTime": "0.153406772746", "recipient": "Walt Whitman", "organizations": ["FalmouthVa", "Butler1", "Tom3"], "sender": "George Washington Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/duk.00336.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from George Washington Whitman to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["George", "NNP"], ["Washington", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Aquia Creek", "Mother"], "money": [], "year": "1863", "locations": [], "month": "Feb", "parties": ["George Washington Whitman", "Walt Whitman"], "properDate": "Feb 6, 1863", "gpe": ["Camp", "Falmouth", "Walt", "Jan", "Good"], "facility": [], "latlngs": [[50.15257099999999, -5.066269999999999]], "text": "  Camp near Falmouth Va. Feb 6th/63 Dear Walt. We have just received orders to cook three days rations and be ready to march immediately  I beleive the whole of the 9th Army Corps are ordered to report at Fortress Monroe. If so I suppose we will march to Aquia Creek, and go on board of Transports  My own oppinion is that Burnside1 is to collect a force at Fortress Monroe, and start off again on his own hook with a sepperate command. I wrote you a few days since,2 to send home for Mother to send you $20 by express and for you to bring it, when you came down here. Of course you will keep it, untill we get to some place where you can either send it by express or bring it yourself. We will probaly stay somewhere around Fortress Monroe for some time, if so you can take a run down there and see me,  I will write you as soon as we get there. I have my house nearly finished, and was going to have a nice warm place. Capt Sims3 left here yesterday for home on a leave of absence for 10 days. I was going to apply as soon as he came back and was makeing lots of reckoning of going home for a few days, but I suppose there will be no getting away now for some time. Walt, I have not received the letter you sent with the money, nor have I received any letter from you since the 27th of Jan. I wish you would write home telling them that we are going to leave here, as I dont know that I shall get a chance to write before we start. I will write to them as soon as we get to Fortress Monroe or wherever we may go. The mail is about closeing so I must stop. Good bye for the present G.W.W.", "dateText": "", "percents": [], "taggedText": [[[["Camp", "NNP"]], ["near", "IN"], [["Falmouth", "NNP"]], ["Va.", "NNP"], ["Feb", "NNP"], ["6th/63", "CD"], ["Dear", "NNP"], ["Walt", "NNP"], [".", "."]], [["We", "PRP"], ["have", "VBP"], ["just", "RB"], ["received", "VBN"], ["orders", "NNS"], ["to", "TO"], ["cook", "VB"], ["three", "CD"], ["days", "NNS"], ["rations", "NNS"], ["and", "CC"], ["be", "VB"], ["ready", "JJ"], ["to", "TO"], ["march", "NN"], ["immediately", "RB"], ["I", "PRP"], ["beleive", "VBP"], ["the", "DT"], ["whole", "JJ"], ["of", "IN"], ["the", "DT"], ["9th", "JJ"], [["Army", "NNP"], ["Corps", "NNP"]], ["are", "VBP"], ["ordered", "VBN"], ["to", "TO"], ["report", "VB"], ["at", "IN"], [["Fortress", "NNP"], ["Monroe", "NNP"]], [".", "."]], [["If", "IN"], ["so", "RB"], ["I", "PRP"], ["suppose", "VBP"], ["we", "PRP"], ["will", "MD"], ["march", "VB"], ["to", "TO"], [["Aquia", "NNP"], ["Creek", "NNP"]], [",", ","], ["and", "CC"], ["go", "VB"], ["on", "IN"], ["board", "NN"], ["of", "IN"], [["Transports", "NNS"], ["My", "NNP"]], ["own", "NN"], ["oppinion", "NN"], ["is", "VBZ"], ["that", "IN"], [["Burnside1", "NNP"]], ["is", "VBZ"], ["to", "TO"], ["collect", "VB"], ["a", "DT"], ["force", "NN"], ["at", "IN"], [["Fortress", "NNP"], ["Monroe", "NNP"]], [",", ","], ["and", "CC"], ["start", "VB"], ["off", "RP"], ["again", "RB"], ["on", "IN"], ["his", "PRP$"], ["own", "JJ"], ["hook", "NN"], ["with", "IN"], ["a", "DT"], ["sepperate", "JJ"], [