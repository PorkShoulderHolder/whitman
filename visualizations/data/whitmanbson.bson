 "am", "going", "out", "as", "I", "like", "to", "be", "on", "the", "river", ",", "(", "on", "those", "strong", "boats", "crashing", "through", "the", "ice", "now", "plentiful", "on", "the", "Delaware", ")", "I", "shall", "probably", "cross", "to", "Phil", "&", "mail", "this", "letter", "thence", "."], "date": [], "normalizedTime": "0.701210390317", "recipient": "Ellen M.", "organizations": ["Nation", "MSS", "Delaware"], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/nyp.00327.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Ellen M. O'Connor ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Ellen", "NNP"], ["M.", "NNP"]], ["O'Connor", "NNP"], [",", ","]]], "people": ["Stevens st.", "Mannahatta Jeff", "John Burroughs"], "money": [], "year": "1874", "locations": ["West"], "month": "Feb", "parties": ["Walt", "Whitman", "Ellen M."], "properDate": "Feb 23, 1874", "gpe": ["Camden", "Chinois", "California"], "facility": [], "latlngs": [[51.55170589999999, -0.1588255], [36.778261, -119.4179324], [38.6270025, -90.19940419999999]], "text": "  431 Stevens st. cor West. Camden, N. Jersey,           Monday,           Feb. 23   2\u00bd p.m.                             Dear Nelly,        I write mostly to send the pictures   you needn't hurry at all about returning them   not that I have any thing special to write about. It has not been well with me now          for some ten days   not even as well as usual   Still I am up & around every day.          I suffer much with my head, & locomotion is more clumsy & paralyzed even than usual   But my inward feeling & faith are not seriously demoralized yet. We are having it warm          & bright & spring like here at present   very attractive out, but my head prevents me          going out with any good enjoyment of it. My nieces are well   the one with the hair a          la Chinois is California, (Jessie,) the younger   the other is Mannahatta   Jeff is still at St. Louis, full of work   both my brothers have plenty of noble, manly work,          & very remunerative. I have just heard from John Burroughs   he is full of house     Walt        ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"]], ["cor", "NN"], [["West", "NNP"]], [".", "."]], [[["Camden", "NNP"]], [",", ","], ["N.", "NNP"], ["Jersey", "NNP"], [",", ","], ["Monday", "NNP"], [",", ","], ["Feb.", "NNP"], ["23", "CD"], ["2\u00bd", "CD"], ["p.m.", "NNP"], ["Dear", "NNP"], ["Nelly", "NNP"], [",", ","], ["I", "PRP"], ["write", "VBP"], ["mostly", "RB"], ["to", "TO"], ["send", "VB"], ["the", "DT"], ["pictures", "NNS"], ["you", "PRP"], ["need", "VBP"], ["n't", "RB"], ["hurry", "VB"], ["at", "IN"], ["all", "DT"], ["about", "IN"], ["returning", "VBG"], ["them", "PRP"], ["not", "RB"], ["that", "IN"], ["I", "PRP"], ["have", "VBP"], ["any", "DT"], ["thing", "NN"], ["special", "JJ"], ["to", "TO"], ["write", "VB"], ["about", "IN"], [".", "."]], [["It", "PRP"], ["has", "VBZ"], ["not", "RB"], ["been", "VBN"], ["well", "RB"], ["with", "IN"], ["me", "PRP"], ["now", "RB"], ["for", "IN"], ["some", "DT"], ["ten", "NN"], ["days", "NNS"], ["not", "RB"], ["even", "RB"], ["as", "IN"], ["well", "RB"], ["as", "IN"], ["usual", "JJ"], ["Still", "NNP"], ["I", "PRP"], ["am", "VBP"], ["up", "RP"], ["&", "CC"], ["around", "IN"], ["every", "DT"], ["day", "NN"], [".", "."]], [["I", "PRP"], ["suffer", "VBP"], ["much", "RB"], ["with", "IN"], ["my", "PRP$"], ["head", "NN"], [",", ","], ["&", "CC"], ["locomotion", "NN"], ["is", "VBZ"], ["more", "RBR"], ["clumsy", "JJ"], ["&", "CC"], ["paralyzed", "VBN"], ["even", "RB"], ["than", "IN"], ["usual", "JJ"], ["But", "CC"], ["my", "PRP$"], ["inward", "NN"], ["feeling", "VBG"], ["&", "CC"], ["faith", "IN"], ["are", "VBP"], ["not", "RB"], ["seriously", "RB"], ["demoralized", "VBN"], ["yet", "RB"], [".", "."]], [["We", "PRP"], ["are", "VBP"],