und", "Han", "better", "than", "she", "expected", "she", "says3", "I", "have", "been", "suffering", "since", "Friday", "with", "a", "``", "run-around", "''", "on", "my", "middle", "finger", "I", "have", "been", "unable", "to", "do", "anything", "for", "the", "last", "three", "days", "and", "seems", "to", "me", "I", "never", "suffered", "so", "much", "pain", "before", "in", "so", "short", "a", "time", "I", "send", "the", "bundle", "this", "morning", "by", "Wescotts", "express", "you", "must", "forgive", "me", "for", "not", "attending", "to", "it", "before", "I", "should", "have", "done", "so", "had", "not", "Mother", "told", "me", "you", "was", "coming", "home", "And", "Walt", "why", "dont", "you", "come", "home", "we", "would", "be", "glad", "to", "see", "you", "and", "I", "think", "you", "would", "enjoy", "a", "visit", "home", "just", "now", "come", "and", "make", "us", "a", "visit", "George", "has", "started", "in", "his", "building", "business4", "he", "is", "in", "hopes", "of", "getting", "a", "pretty", "large", "job", "in", "New", "York", "will", "know", "to-day", "Mr", "Lane5", "offered", "him", "a", "first", "rate", "berth", "he", "thought", "at", "first", "he", "would", "take", "it", "but", "afterwards", "declined", "perhaps", "he", "did", "better", "in", "going", "on", "with", "his", "venture", "Everything", "is", "going", "the", "same", "all", "rosey", "we", "hope", "you", "will", "come", "on", "and", "see", "us", "I", "am", "in", "a", "great", "hurry", "this", "morning", "or", "would", "write", "longer", "affectionately", "Jeff"], "date": [], "normalizedTime": "0.28301373589", "recipient": "Walt Whitman", "organizations": ["home2"], "sender": "Thomas Jefferson Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00441.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Thomas Jefferson Whitman to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Abraham", "NNP"], ["Simpson", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Drum Taps", "Drum Taps", "Abraham Simpson"], "money": [], "year": "1865", "locations": [], "month": "Sep", "parties": ["Abraham Simpson", "Walt Whitman"], "properDate": "Sep 20, 1865", "gpe": [], "facility": [], "latlngs": [], "text": "  Sept 20th, 1865    Walt Whitman Esq When I  receive your extra sheet will then bind you 500 \"Drum Taps.\" Can you give me an [order on any person?] for a copy of your \"Drum Taps\" as I want[to?] match them. As I have to pay nett cash for the materials used in your work would thank you to forward me the money.  Respectfully, Abraham Simpson  ", "dateText": "", "percents": [], "taggedText": [[["Sept", "NNP"], ["20th", "CD"], [",", ","], ["1865", "CD"], ["Walt", "NNP"], ["Whitman", "NNP"], ["Esq", "NNP"], ["When", "NNP"], ["I", "NNP"], ["receive", "VBP"], ["your", "PRP$"], ["extra", "JJ"], ["sheet", "NN"], ["will", "MD"], ["then", "RB"], ["bind", "VB"], ["you", "PRP"], ["500", "CD"], ["``", "``"], [["Drum", "NNP"], ["Taps", "NNP"]], [".", "."]], [["``", "``"], ["Can", "MD"], ["you", "PRP"], ["give", "VB"], ["me", "PRP"], ["an", "DT"], ["[", "NN"], ["order", "NN"], ["on", "IN"], ["any", "DT"], ["person", "NN"], ["?", "."]], [["]", "NN"], ["for", "IN"], ["a", "DT"], ["copy", "NN"], ["of", "IN"], ["your", "PRP$"], ["``", "``"], [["Drum", "NNP"], ["Taps", "NNP"]], ["''", "''"], ["as", "IN"], ["I", "PRP"], ["want", "VBP"], ["[", ":"], ["to", "TO"], ["?", "."]], [["]", "NN"], ["match", "NN"], ["them", "PRP"], [".", "."]], [["As", "IN"], ["I", "PRP"], ["have", "VBP"], ["to", "TO"], ["pay", "VB"], ["nett", "NN"], ["cash", "NN"], ["for", "IN"], ["the", "DT"], ["materials", "NNS"], ["used", "VBN"], ["in", "IN"], ["your", "PRP$"], ["work", "NN"], ["would", "MD"], ["thank", "VB"], ["you", "PRP"], ["to", "TO"], ["forward", "VB"], ["me", "PRP"], ["the", "DT"], ["money", "NN"], [".", "."]], [["Respectfully", "RB"], [",", ","], [["Abraham", "NNP"], ["Simpson", "NNP"]]]], "sentences": ["  Sept 20th, 1865    Walt Whitman Esq When I  receive your extra sheet will then bind you 500 \"Drum Taps.", "\" Can you give me an [order on any person?", "] for a copy of your \"Drum Taps\" as I want[to?", "] match them.", "As I have to pay nett cash for the materials used in your work would thank you to forward me the money.", "Respectfully, Abraham Simpson  "], "words": ["Sept", "20th", ",", "1865", "Walt", "Whitman", "Esq", "When", "I", "receive", "your", "extra", "sheet", "will", "then", "bind", "you", "500", "``", "Drum", "Taps.", "''", "Can", "you", "give", "me", "an", "[", "order", "on", "any", "person", "?", "]", "for", "a", "copy", "of", "your", "``", "Drum", "Taps", "''", "as", "I", "want", "[", "to", "?", "]", "match", "them.", "As", "I", "have", "to", "pay", "nett", "cash", "for", "the", "materials", "used", "in", "your", "work", "would", "thank", "you", "to", "forward", "me", "the", "money.", "Respectfully", ",", "Abraham", "Simpson"], "date": [], "normalizedTime": "0.284237726098", "recipient": "Walt Whitman", "organizations": [], "sender": "Abraham Simpson", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00866.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Abraham Simpson to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Thomas", "NNP"], ["Jefferson", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Walt We", "Mother", "Mother", "George", "Mother", "George", "Mattie", "Jeff"], "money": [], "year": "1865", "locations": [], "month": "Sep", "parties": ["Thomas Jefferson Whitman", "Walt Whitman"], "properDate": "Sep 29, 1865", "gpe": ["Brooklyn", "Brooklyn", "Brooklyn", "St.", "Brooklyn", "Vermont", "Burlington"], "facility": [], "latlngs": [[40.65, -73.95], [40.65, -73.95], [40.65, -73.95], [40.65, -73.95], [44.5588028, -72.57784149999999], [44.4758825, -73.21207199999999]], "text": "  Brooklyn, N. Y., Sept. 29th 1865 Dear brother Walt We hav'nt heard from you for some time1   you say the bundle was not the right one   I read the label and thought it read the same as you described in your letter   would you like me to send the other or right one if I can find it   Mother told me she knew the one you meant and that she would put it on the table for me2   that is the one I sent We had a letter from Mother to-day   she seems pretty well   talks a little of coming home but does not say when   I have just written her this eve   We are all as well as usual   the baby has a bad boil on its forehead but I suppose it will get well in a day or two and then she will be all right again   it looks just now though about as bad as anything of the kind I ever saw  by-the-way it was me that had the \"run around\" on the finger3   and I have just got well of it   and a cussed bad time I had of it too   it accounts for my not writing you before    George is getting along first rate I guess   He dont say any more about getting a position in the Custom House   I hope he wont try but I am quite sure that if he can keep devoted to his present undertaking he will make a handsome fortune in 8 or ten years4   he certainly has the prospect of it   there is an immense amount of building in the city this season   though material is wonderful high   brick $12 per thousand   should be abt 5 or 6   I have given up all thought of building this fall   at one time I thought I would sure  perhaps next spring will be better Matters about Brooklyn are much the same   with me just the same   Mr Kirkwood5 has been on a visit to Brooklyn and just gone back to St. Louis   I think it more than likely that he will build the water works of that city   if so it will be as large a job as the Brooklyn works The Doctor6 returned from the country last week   he looks first rate   says he had a wonderfully good time   he was spending the summer up in Vermont near Burlington   speaks of it as being a splendid place to live    In her letter to-day Mother says she wants either you or George to come on and come home with her7   so I suppose she begins to think of coming home Mattie and the children desire to send their love to you   the child[ren] are growing first rate    I wish you would write me  I want to know how things are going with you affectionately Jeff", "dateText": "", "percents": [], "taggedText": [[[["Brooklyn", "NNP"]], [",", ","], ["N.", "NNP"], ["Y.", "NNP"], [",", ","], ["Sept.", "NNP"], ["29th", "CD"], ["1865", "CD"], ["Dear", "NNP"], ["brother", "NN"], [["Walt", "NNP"], ["We", "NNP"]], ["hav'nt", "NNP"], ["heard", "NN"], ["from", "IN"], ["you", "PRP"], ["for", "IN"], ["some", "DT"], ["time1", "NNP"], ["you", "PRP"], ["say", "VBP"], ["the", "DT"], ["bundle", "NN"], ["was", "VBD"], ["not", "RB"], ["the", "DT"], ["right", "NN"], ["one", "CD"], ["I", "PRP"], ["read", "VBP"], ["the", "DT"], ["label", "NN"], ["and", "CC"], ["thought", "VBD"], ["it", "PRP"], ["read", "VB"], ["the", "DT"], ["same", "JJ"], ["as", "IN"], ["you", "PRP"], ["described", "VBD"], ["in", "IN"], ["your", "PRP$"], ["letter", "NN"], ["would", "MD"], ["you", "PRP"], ["like", "VB"], ["me", "PRP"], ["to", "TO"], ["send", "VB"], ["the", "DT"], ["other", "JJ"], ["or", "CC"], ["right", "RB"], ["one", "CD"], ["if", "IN"], ["I", "PRP"], ["can", "MD"], ["find", "VB"], ["it", "PRP"], [["Mother", "NNP"]], ["told", "VBD"], ["me", "PRP"], ["she", "PRP"], ["knew", "VBD"], ["the", "DT"], ["one", "CD"], ["you", "PRP"], ["meant", "VBD"], ["and", "CC"], ["that", "IN"], ["she", "PRP"], ["would", "MD"], ["put", "VB"], ["it", "PRP"], ["on", "IN"], ["the", "DT"], ["table", "NN"], ["for", "IN"], [["me2", "NNP"]], ["that", "WDT"], ["is", "VBZ"], ["the", "DT"], ["one", "CD"], ["I", "PRP"], ["sent", "VBD"], ["We", "PRP"], ["had", "VBD"], ["a", "DT"], ["letter", "NN"], ["from", "IN"], [["Mother", "NNP"]], ["to-day", "NNP"], ["she", "PRP"], ["seems", "VBZ"], 