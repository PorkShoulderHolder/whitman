ore", "invasion2 My", "Bartlett3"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/nyp.00190.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to Lewis K. Brown ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Aaron", "NNP"], ["Smith", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Mr. Walt", "Yours", "Aaron Smith"], "money": [], "year": "1864", "locations": [], "month": "Jul", "parties": ["Aaron Smith", "Walt Whitman"], "properDate": "Jul 13, 1864", "gpe": ["U.S."], "facility": [], "latlngs": [], "text": "  Carver U.S. HospitalWashington D.C. July 13th 1864  Mr. Walt WhitmanDear Friend I have once more returned to this place and am improving in health. I should like very much to see you. I am very anxious to hear something of the whereabouts of my Capt I have written several times and as yet have recd no answer. Hoping to see, or hear from you, soon. I remain as ever,  Yours with respect Aaron Smith  ", "dateText": "", "percents": [], "taggedText": [[["Carver", "RB"], [["U.S.", "NNP"]], [["HospitalWashington", "NNP"], ["D.C.", "NNP"]], ["July", "NNP"], ["13th", "CD"], ["1864", "CD"], [["Mr.", "NNP"], ["Walt", "NNP"]], ["WhitmanDear", "NNP"], ["Friend", "NNP"], ["I", "NNP"], ["have", "VBP"], ["once", "RB"], ["more", "RBR"], ["returned", "VBN"], ["to", "TO"], ["this", "DT"], ["place", "NN"], ["and", "CC"], ["am", "NN"], ["improving", "VBG"], ["in", "IN"], ["health", "NN"], [".", "."]], [["I", "PRP"], ["should", "MD"], ["like", "VB"], ["very", "RB"], ["much", "RB"], ["to", "TO"], ["see", "VB"], ["you", "PRP"], [".", "."]], [["I", "PRP"], ["am", "VBP"], ["very", "RB"], ["anxious", "JJ"], ["to", "TO"], ["hear", "VB"], ["something", "NN"], ["of", "IN"], ["the", "DT"], ["whereabouts", "NNS"], ["of", "IN"], ["my", "PRP$"], ["Capt", "NNP"], ["I", "NNP"], ["have", "VBP"], ["written", "VBN"], ["several", "JJ"], ["times", "NNS"], ["and", "CC"], ["as", "IN"], ["yet", "RB"], ["have", "VBP"], ["recd", "VBN"], ["no", "DT"], ["answer", "NN"], [".", "."]], [["Hoping", "VBG"], ["to", "TO"], ["see", "VB"], [",", ","], ["or", "CC"], ["hear", "VB"], ["from", "IN"], ["you", "PRP"], [",", ","], ["soon", "RB"], [".", "."]], [["I", "PRP"], ["remain", "VBP"], ["as", "IN"], ["ever", "RB"], [",", ","], [["Yours", "NNP"]], ["with", "IN"], ["respect", "NN"], [["Aaron", "NNP"], ["Smith", "NNP"]]]], "sentences": ["  Carver U.S. HospitalWashington D.C. July 13th 1864  Mr. Walt WhitmanDear Friend I have once more returned to this place and am improving in health.", "I should like very much to see you.", "I am very anxious to hear something of the whereabouts of my Capt I have written several times and as yet have recd no answer.", "Hoping to see, or hear from you, soon.", "I remain as ever,  Yours with respect Aaron Smith  "], "words": ["Carver", "U.S.", "HospitalWashington", "D.C.", "July", "13th", "1864", "Mr.", "Walt", "WhitmanDear", "Friend", "I", "have", "once", "more", "returned", "to", "this", "place", "and", "am", "improving", "in", "health.", "I", "should", "like", "very", "much", "to", "see", "you.", "I", "am", "very", "anxious", "to", "hear", "something", "of", "the", "whereabouts", "of", "my", "Capt", "I", "have", "written", "several", "times", "and", "as", "yet", "have", "recd", "no", "answer.", "Hoping", "to", "see", ",", "or", "hear", "from", "you", ",", "soon.", "I", "remain", "as", "ever", ",", "Yours", "with", "respect", "Aaron", "Smith"], "date": [], "normalizedTime": "0.225214198286", "recipient": "Walt Whitman", "organizations": ["HospitalWashington D.C."], "sender": "Aaron Smith", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/nyp.00229.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Aaron Smith to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Elijah", "NNP"], ["Douglass", "NNP"], ["Fox", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Dear", "God", "Armory Square Hospt", "Fox"], "money": [], "year": "1864", "locations": [], "month": "Jul", "parties": ["Elijah Douglass Fox", "Walt Whitman"], "properDate": "Jul 14, 1864", "gpe": [], "facility": [], "latlngs": [], "text": "   Dear Comrade I received your kind letter, and it will be impossible for me to tell how glad I was to hear from you again though very sorry to hear that you had been sick. Oh! I should like to have been with you so I could have nursed you back to health & strength, but if you were with your mother no doubt you were taken care of better than I could have done for you but I would liked to have been with you anyway I could have read to you and talked with you if nothing more  I am afraid I shall never be able to recompense you for your kind care and the trouble I made you while I was sick in the hospital unless you are already paid by knowing you have helped the sick and suffering soldiers many of them will never cease to remember you and to ask God's blessing to rest upon you while you and they live  there is no one such as you at least I have often thought of you and wondered where you were if you were still visiting Armory Square Hospt  I believe I wrote to you that you had two Children instead of one, you know I used to call you Father or \"Pa,\" and I still think of you as such for I am sure no Father could have cared for their own child, better than you did me, if you could see your other child I think you would like her better than you did me for I do. I have also been very sick since you heard from me, for two weeks I knew nothing, was perfectly insane. I was taken with some kind of spasm and for two or three days many said I could not live but I had a good Doctor and have almost regained my health but think I shall never be able to do hard work again  Mary sends her love to you she often talks about you  she sends her thanks to you for your kindness to me and hopes you may soon regain your health, but I must stop for this time  write soon and often  the reason I did not write was that I wrote once and received no answer  I thought you had left there but now you shall hear from me often  no more  I remain your Son & Comrade   E. D. Fox   ", "dateText": "", "percents": [], "taggedText": [[[["Dear", "NNP"]], [["Comrade", "NNP"]], ["I", "NNP"], ["received", "VBD"], ["your", "PRP$"], ["kind", "NN"], ["letter", "NN"], [",", ","], ["and", "CC"], ["it", "PRP"], ["will", "MD"], ["be", "VB"], ["impossible", "JJ"], ["for", "IN"], ["me", "PRP"], ["to", "TO"], ["tell", "VB"], ["how", "WRB"], ["glad", "JJ"], ["I", "PRP"], ["was", "VBD"], ["to", "TO"], ["hear", "VB"], ["from", "IN"], ["you", "PRP"], ["again", "RB"], ["though", "IN"], ["very", "RB"], ["sorry", "JJ"], ["to", "TO"], ["hear", "VB"], ["that", "IN"], ["you", "PRP"], ["had", "VBD"], ["been", "VBN"], ["sick", "JJ"], [".", "."]], [["Oh", "UH"], ["!", "``"]], [["I", "PRP"], ["should", "MD"], ["like", "VB"], ["to", "TO"], ["have", "VB"], ["been", "VBN"], ["with", "IN"], ["you", "PRP"], ["so", "RB"], ["I", "PRP"], ["could", "MD"], ["have", "VB"], ["nursed", "VBN"], ["you", "PRP"], ["back", "RB"], ["to", "TO"], ["health", "NN"], ["&", "CC"], ["strength", "NN"], [",", ","], ["but", "CC"], ["if", "IN"], ["you", "PRP"], ["were", "VBD"], ["with", "IN"], ["your", "PRP$"], ["mother", "NN"], ["no", "DT"], ["doubt", "NN"], ["you", "PRP"], ["were", "VBD"], ["taken", "VBN"], ["care", "NN"], ["of", "IN"], ["better", "JJR"], ["than", "IN"], ["I", "PRP"], ["could", "MD"], ["have", "VB"], ["done", "VBN"], ["for", "IN"], ["you", "PRP"], ["but", "CC"], ["I", "PRP"], ["would", "MD"], ["liked", "VB"], ["to", "TO"], ["have", "VB"], ["been", "VBN"], ["with", "IN"], ["you", "PRP"], ["anyway", "VBP"], ["I", "PRP"], ["could", "MD"], ["have", "VB"], ["read", "VBN"], ["to", "TO"], ["you", "PRP"], ["and", "CC"], ["talked", "VBD"], ["with", "IN"], ["you", "PRP"], ["i