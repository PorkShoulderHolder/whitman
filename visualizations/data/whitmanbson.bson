ter", "tell", "me", "all", "the", "news", "all", "about", "the", "girls", ",", "&", "Mr.", "Arnold", "&", "the", "last", "from", "Arthur", ",", "&", "every", "thing", "So", "good", "bye", "for", "this", "time", "I", "send", "you", "my", "love", ",", "dear", "friend", ",", "&", "same", "to", "the", "dear", "girls", "&", "to", "all.", "Walt.", "If", "you", "can", "get", "the", "papers", ",", "direct", "them", "to", "me", "Attorney", "Gen", "'s", "Office"], "date": [], "normalizedTime": "0.376036991704", "recipient": "Abby H. Price", "organizations": ["Washington", "London Chronicle", "Leaves", "Grass"], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/pml.00022.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Abby H. Price ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["William", "NNP"], ["C.", "NNP"], ["Church", "NNP"]], [",", ","]]], "people": ["Mr. Church", "William O'Connor", "Carol", "Attorney General", "Walt", "Whitman"], "money": [], "year": "1867", "locations": [], "month": "Aug", "parties": ["Walt", "Whitman", "William C. Church"], "properDate": "Aug 7, 1867", "gpe": ["Washington", "Harvest", "Galaxy", "Please", "Direct"], "facility": [], "latlngs": [[38.8951118, -77.0363658]], "text": "  Washington, Wednesday afternoon, Aug. 7, 1867.                  My dear Mr. Church,              In response to your letter to William O'Connor, I send herewith the piece,                                                                                            \"A Carol of Harvest, for 1867,\"                                                                                for the Galaxy. I presume it will be in time for the September number. I wish, if                 acceptable, you would have it set up immediately, proved,                 read carefully by copy, carefully corrected, & then a good                     proof taken & sent to me here. I would mail it back again the same day                 I get it, so you would receive it next day. If practicable, I should like to have the piece commence on an odd-numbered page of                 the magazine   & wish it could come the second article in the Number. The \"Carol\" will make about five pages more or less. Please acknowledge the receipt of this. Direct to me, Attorney General's Office.               Walt Whitman              ", "dateText": "", "percents": [], "taggedText": [[[["Washington", "NNP"]], [",", ","], ["Wednesday", "NNP"], ["afternoon", "NN"], [",", ","], ["Aug.", "NNP"], ["7", "CD"], [",", ","], ["1867", "CD"], [".", "."]], [["My", "PRP$"], ["dear", "NN"], [["Mr.", "NNP"], ["Church", "NNP"]], [",", ","], ["In", "NNP"], ["response", "NN"], ["to", "TO"], ["your", "PRP$"], ["letter", "NN"], ["to", "TO"], [["William", "NNP"], ["O'Connor", "NNP"]], [",", ","], ["I", "PRP"], ["send", "VBP"], ["herewith", "JJ"], ["the", "DT"], ["piece", "NN"], [",", ","], ["``", "``"], ["A", "DT"], ["Carol", "NNP"], ["of", "IN"], [["Harvest", "NNP"]], [",", ","], ["for", "IN"], ["1867", "CD"], [",", ","], ["''", "''"], ["for", "IN"], ["the", "DT"], [["Galaxy", "NNP"]], [".", "."]], [["I", "PRP"], ["presume", "VBP"], ["it", "PRP"], ["will", "MD"], ["be", "VB"], ["in", "IN"], ["time", "NN"], ["for", "IN"], ["the", "DT"], ["September", "NNP"], ["number", "NN"], [".", "."]], [["I", "PRP"], ["wish", "VBP"], [",", ","], ["if", "IN"], ["acceptable", "JJ"], [",", ","], ["you", "PRP"], ["would", "MD"], ["have", "VB"], ["it", "PRP"], ["set", "VBN"], ["up", "RP"], ["immediately", "RB"], [",", ","], ["proved", "VBD"], [",", ","], ["read", "JJ"], ["carefully", "RB"], ["by", "IN"], ["copy", "NN"], [",", ","], ["carefully", "RB"], ["corrected", "VBN"], [",", ","], ["&", "CC"], ["then", "RB"], ["a", "DT"], ["good", "JJ"], ["proof", "NN"], ["taken", "VBN"], ["&", "CC"], ["sent", "NN"], ["to", "TO"], ["me", "PRP"], ["here", "RB"], [".", "."]], [["I", "PRP"], ["wo