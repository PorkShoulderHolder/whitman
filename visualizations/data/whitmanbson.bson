s", "NNP"]], ["''", "''"], ["$", "$"], ["34.85", "CD"], ["Paid", "NNP"], ["P.", "NNP"], ["Eckler2", "NNP"]]], "sentences": ["  New York May 4th, 1865  Mr. Walt Whitman To Ballance bill Printing \"Drum Taps\" $34.85  Paid  P. Eckler2  "], "words": ["New", "York", "May", "4th", ",", "1865", "Mr.", "Walt", "Whitman", "To", "Ballance", "bill", "Printing", "``", "Drum", "Taps", "''", "$", "34.85", "Paid", "P.", "Eckler2"], "date": [], "normalizedTime": "0.265333877329", "recipient": "Walt Whitman", "organizations": [], "sender": "Peter Eckler", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00855.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Peter Eckler to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Thomas", "NNP"], ["Jefferson", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["George", "Mattie", "George", "Write Jeff"], "money": [], "year": "1865", "locations": [], "month": "May", "parties": ["Thomas Jefferson Whitman", "Walt Whitman"], "properDate": "May 4, 1865", "gpe": ["Brooklyn", "Mother", "Children", "New York", "Washington"], "facility": [], "latlngs": [[40.65, -73.95], [40.7143528, -74.00597309999999], [38.8951118, -77.0363658]], "text": "  Brooklyn, N. Y., May 4th 1865 Dear Walt, We received your letter1 and [were] glad to get it too   We had all begun to feel a little worried about George   glad to hear that you are getting along so nicely   The Expressman did not come for your trunk yesterday as he promised so I called last night and [a]gain left the order   to-day at noon they came and got it giving a receipt for it  Enclosed I send the Key. I like to get letters from you  Matters are going about as usual with us. Mother is pretty well Mattie and the Children very well   I hope you will enjoy your cake that they put in the trunk   It looked nice when I put it in  I packed it Tuesday night and had it already Wednesday, but they did not come for it  I hope to be able to make you a visit this summer yet   How would it do to come when the review of the Army happens2   could i see it or would it be like our New York shows   how long do you suppose George will remain around Washington?3 I should like to come before he goes away   Write Jeff", "dateText": "", "percents": [], "taggedText": [[[["Brooklyn", "NNP"]], [",", ","], ["N.", "NNP"], ["Y.", "NNP"], [",", ","], ["May", "NNP"], ["4th", "CD"], ["1865", "CD"], ["Dear", "NNP"], ["Walt", "NNP"], [",", ","], ["We", "NNP"], ["received", "VBD"], ["your", "PRP$"], [["letter1", "NNP"]], ["and", "CC"], ["[", "NNP"], ["were", "VBD"], ["]", "NNP"], ["glad", "NN"], ["to", "TO"], ["get", "VB"], ["it", "PRP"], ["too", "RB"], ["We", "PRP"], ["had", "VBD"], ["all", "PDT"], ["begun", "VBN"], ["to", "TO"], ["feel", "VB"], ["a", "DT"], ["little", "JJ"], ["worried", "VBN"], ["about", "IN"], [["George", "NNP"]], ["glad", "NN"], ["to", "TO"], ["hear", "VB"], ["that", "IN"], ["you", "PRP"], ["are", "VBP"], ["getting", "VBG"], ["along", "IN"], ["so", "RB"], ["nicely", "RB"], ["The", "DT"], [["Expressman", "NNP"]], ["did", "VBD"], ["not", "RB"], ["come", "VBN"], ["for", "IN"], ["your", "PRP$"], ["trunk", "NN"], ["yesterday", "NN"], ["as", "IN"], ["he", "PRP"], ["promised", "VBD"], ["so", "RB"], ["I", "PRP"], ["called", "VBD"], ["last", "JJ"], ["night", "NN"], ["and", "CC"], ["[", "CD"], ["a", "DT"], ["]", "NN"], ["gain", "NN"], ["left", "VBD"], ["the", "DT"], ["order", "NN"], ["to-day", "NN"], ["at", "IN"], ["noon", "NN"], ["they", "PRP"], ["came", "VBD"], ["and", "CC"], ["got", "VBD"], ["it", "PRP"], ["giving", "VBG"], ["a", "DT"], ["receipt", "NN"], ["for", "IN"], ["it", "PRP"], ["Enclosed", "NNP"], ["I", "PRP"], ["send", "VBP"], ["the", "DT"], [["Key", "NNP"]], [".", "."]], [["I", "PRP"], ["like", "VBP"], ["to", "TO"], ["get", "VB"], ["letters", "NNS"], ["from", "IN"], ["you", "PRP"], ["Matters", "NNPS"], ["are", "VBP"], ["g