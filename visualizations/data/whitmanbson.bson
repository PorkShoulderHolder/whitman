 [",", ","], ["the", "DT"], ["fourth", "JJ"], ["week", "NN"], ["of", "IN"], ["my", "PRP$"], ["vacation", "NN"], ["is", "VBZ"], ["most", "JJS"], ["ended", "VBN"], [".", "."]], [["I", "PRP"], ["shall", "VBP"], ["return", "NN"], ["the", "DT"], ["middle", "NN"], ["of", "IN"], ["next", "JJ"], ["week", "NN"], [".", "."]], [["Give", "JJ"], ["my", "PRP$"], ["love", "NN"], ["to", "TO"], [["Johnny", "NNP"], ["Lee", "NNP"]], ["let", "VBD"], ["him", "PRP"], ["read", "VB"], ["this", "DT"], ["letter", "NN"], [",", ","], ["&", "CC"], ["then", "RB"], ["return", "VBP"], ["it", "PRP"], ["to", "TO"], ["you", "PRP"], [".", "."]], [[["Dear", "NNP"]], [["Jack", "NNP"]], [",", ","], ["I", "PRP"], ["rec", "VBP"], ["'d", "JJ"], ["your", "PRP$"], ["affectionate", "NN"], ["letter", "NN"], ["of", "IN"], ["Sept.", "NNP"], ["5th", "CD"], [".", "."]], [[["Pete", "NNP"]], [",", ","], ["I", "PRP"], ["have", "VBP"], ["seen", "VBN"], [["Tom", "NNP"], ["Haslett", "NNP"]], ["he", "PRP"], ["is", "VBZ"], ["well", "RB"], ["he", "PRP"], ["is", "VBZ"], ["working", "VBG"], ["extra", "JJ"], ["on", "IN"], [["Broadway", "NNP"]], ["&", "CC"], ["42d", "CD"], ["st.", "NNP"], ["RR", "NNP"], [".", "."]], [["He", "PRP"], ["does", "VBZ"], ["not", "RB"], ["think", "VB"], ["of", "IN"], ["going", "VBG"], ["home", "NN"], ["till", "IN"], [["Christmas", "NNP"]], [".", "."]], [[["Jimmy", "NNP"]], [["Foy", "NNP"]], ["has", "VBZ"], ["not", "RB"], ["got", "VBN"], ["work", "NN"], ["yet", "RB"], [".", "."]], [["I", "PRP"], ["suppose", "VBP"], ["you", "PRP"], ["got", "VBD"], ["``", "``"], ["Kenilworth", "NNP"], ["''", "''"], ["I", "PRP"], ["sent", "VBP"], [".", "."]], [[["Well", "NNP"]], [",", ","], ["boy", "NN"], [",", ","], ["I", "PRP"], ["shall", "MD"], ["now", "RB"], ["take", "VB"], ["a", "DT"], ["bath", "NN"], [",", ","], ["dress", "NN"], ["myself", "PRP"], ["&", "CC"], ["go", "VB"], ["out", "RP"], [",", ","], ["cross", "NNS"], ["the", "DT"], ["river", "NN"], [",", ","], ["put", "VBD"], ["this", "DT"], ["letter", "NN"], ["in", "IN"], ["the", "DT"], ["p.", "NNP"], ["o", "NN"], [".", "."]], [["&", "CC"], ["then", "RB"], ["ramble", "JJ"], ["&", "CC"], ["ride", "JJ"], ["around", "IN"], ["the", "DT"], [["City", "NNP"]], [",", ","], ["awhile", "JJ"], [",", ","], ["as", "IN"], ["I", "PRP"], ["think", "VBP"], ["we", "PRP"], ["are", "VBP"], ["going", "VBG"], ["to", "TO"], ["have", "VB"], ["a", "DT"], ["fine", "NN"], ["evening", "NN"], ["&", "CC"], ["moonlight", "NN"], ["&", "CC"], ["c.", "NNP"], ["Good", "NNP"], ["bye", "NN"], [",", ","], ["dear", "JJ"], ["son", "NN"], ["We", "PRP"], ["will", "MD"], ["soon", "RB"], ["be", "VB"], ["together", "RB"], ["again", "RB"], [".", "."]], [[["Walt", "NNP"]], [".", "."]]], "sentences": ["  Brooklyn,                     Friday afternoon, Sept. 10, 1869.", "Dear Pete   dear son,              I have received your letter of the 8th to-day   all your letters have come                 safe   four altogether.", "This is the third I have sent you (besides that one by                 Adams' Express, Aug.", "23d.", ")              Pete, you say my sickness must be worse than I described in my letters   &                 ask me to write precisely how I am.", "No, dearest boy, I wrote just as it really was.", "But, Pete, you will now be truly happy to learn that I am feeling all right, &                 have been mainly so for the last four days   & have had no bad spells all                 that time.", "Yesterday I thought I felt as strong & well as ever in my                 life   in fact real young & jolly.", "I loafed around New York most all                 day   had a first-rate good time.", "All along Broadway hundreds of rich flags                 & streamers at half-mast for Gen. Rawlins'                 funeral   From the tall buildings, they waved out in a stiff west wind all                 across Broadway   late in the afternoon I rode up from the Battery to look at                 them, as the sun struck through them   I thought I had never seen any thing so                 curious & beautiful   On all the shipping, ferry boats, public buildings                 &c. flags at half mast too.", "This is the style here.", "No black drapery, for                 mourning   only thousands of flags at half mast, on the water as well as                 land   for any big bug's funeral.", "To-day I am all right too.", "It is now towards 3   Mother & I have just had our                 dinner, (my mammy's own cooking mostly.", ") I have been out all the forenoon knocking                 around   the water is my favorite recreation   I could spend two or three                 hours every day of my life here, & never get tired   Some of the pilots are                 dear personal friends of mine   some, when we meet, we kiss each other (I am an                 exception to all their customs with others)   some of their boys have grown up                 since I have known them, & they too know me & are very friendly.", "Pete, the fourth week of my vacation is most ended.", "I shall return the middle of next                 week.", "Give my love to Johnny Lee   let him read this letter, & then return it to you.", "Dear                 Jack, I rec'd your affectionate letter of Sept. 5th.", "Pete, I have seen Tom Haslett   he is well   he is working extra on Broadway &                 42d st. RR.", "He does not think of going home till Christmas.", "Jimmy Foy has not got work yet.", "I suppose you got \"Kenilworth\" I sent.", "Well, boy, I shall now take a bath, dress myself & go out, cross the river, put                 this letter in the p. o.", "& then ramble & ride around the City, awhile, as I                 think we are going to have a fine evening & moonlight &c. Good bye, dear son   We will soon be together again.", "Walt.              "], "words": ["Brooklyn", ",", "Friday", "afternoon", ",", "Sept.", "10", ",", "1869.", "Dear", "Pete", "dear", "son", ",", "I", "have", "received", "your", "letter", "of", "the", "8th", "