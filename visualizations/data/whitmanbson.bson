[["Ellen", "NNP"], ["M.", "NNP"]], ["O'Connor", "NNP"], [",", ","]]], "people": ["Dear", "William", "Jeannie", "Martha", "Helen", "John Arnold", "Beulah", "Wilcox", "Gibbs", "Lou", "Beulah", "William", "Jeannie Nothing", "Dear William", "Charles Eldridge", "Jeannie", "Nelly", "Walt"], "money": [], "year": "1871", "locations": [], "month": "Jun", "parties": ["Walt", "Whitman", "Ellen M."], "properDate": "Jun 29, 1871", "gpe": ["Portland", "Brooklyn", "Nelly", "Brooklyn", "Mother", "New York"], "facility": [], "latlngs": [[45.5234515, -122.6762071], [40.65, -73.95], [40.65, -73.95], [40.7143528, -74.00597309999999], [38.6270025, -90.19940419999999]], "text": "  107 north Portland av.                     Brooklyn, June 29.                                  Dear Nelly,              I will just write you a line to let you know I am here in Brooklyn, & well &                 hearty. Mother is well as usual, & sends love to you & William, & to                 Jeannie. My sister Martha at St. Louis was not in good health at last accounts. Helen Price was here & spent part of the day   She is looking                 finely   they are all as usual   it was John                     Arnold that died   he was a complete                 wreck   death was a boon & relief in the case    I have heard from Mrs. Howells   I have seen Beulah, she is a fine young woman, a handsome                 healthy blonde   she is at the fine establishment of Wilcox & Gibbs, on Broadway   her sister Lou is married   I shall soon see Mrs.                 Howells, & then I will tell you further   Beulah asked much about you &                 William, and Jeannie    Nothing special with me or my affairs. As it turns out, my death by railroad smash                 permeated the lower orders, (I suppose at second & third hand) & the rectification in many cases never reached them. So I hardly                 stir out in New York, but what I am called upon to certify, &c.    I am daily on the water here   it is inspiriting, & surpassingly                 beautiful   Every fine day the bay swarms with yachts, large &                 small   they are literally in scores   I never tire of looking on                 them   All the young fellows yacht here    Dear William, how are you? and dear Charles Eldridge, how are you? My true love to                 you both   Jeannie, my darling, a kiss for you   good bye, Nelly                 dear     Walt              ", "dateText": "", "percents": [], "taggedText": [[["107", "CD"], ["north", "JJ"], [["Portland", "NNP"]], ["av", "NN"], [".", "."]], [[["Brooklyn", "NNP"]], [",", ","], ["June", "NNP"], ["29", "CD"], [".", "."]], [[["Dear", "NNP"]], [["Nelly", "NNP"]], [",", ","], ["I", "PRP"], ["will", "MD"], ["just", "RB"], ["write", "VB"], ["you", "PRP"], ["a", "DT"], ["line", "NN"], ["to", "TO"], ["let", "VB"], ["you", "PRP"], ["know", "VB"], ["I", "PRP"], ["am", "VBP"], ["here", "RB"], ["in", "IN"], [["Brooklyn", "NNP"]], [",", ","], ["&", "CC"], ["well", "RB"], ["&", "CC"], ["hearty", "NN"], [".", "."]], [[["Mother", "NNP"]], ["is", "VBZ"], ["well", "RB"], ["as", "IN"], ["usual", "JJ"], [",", ","], ["&", "CC"], ["sends", "NNS"], ["love", "VBP"], ["to", "TO"], ["you", "PRP"], ["&", "CC"], [["William", "NNP"]], [",", ","], ["&", "CC"], ["to", "TO"], [["Jeannie", "NNP"]], [".", "."]], [["My", "PRP$"], ["sister", "NN"], [["Martha", "NNP"]], ["at", "IN"], [["St.", "NNP"], ["Louis", "NNP"]], ["was", "VBD"], ["not", "RB"], ["in", "IN"], ["good", "JJ"], ["health", "NN"], ["at", "IN"], ["last", "JJ"], ["accounts", "NNS"], [".", "."]], [[["Helen", "NNP"]], ["Price", "NNP"], ["was", "VBD"], ["here", "RB"], ["&", "CC"], ["spent", "NN"], ["part", "NN"], ["of", "IN"], ["the", "DT"], ["day", "NN"], ["She", "PRP"], ["is", "VBZ"], ["looking", "VBG"], ["finely", "RB"], ["they", "PRP"], ["are", "VBP"], ["all", "RB"], ["as", "IN"], ["usual", "JJ"], ["it", "PRP"], ["was", "VBD"], [["John", "NNP"], ["Arnold", "NNP"]], ["that", "IN"], ["died", "V