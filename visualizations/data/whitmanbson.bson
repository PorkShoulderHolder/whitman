 "me", "so", "subordinate", "to", "the", "question", "of", "whether", "I", "shall", "soon", "or", "ever", "get", "well", ",", "(", "or", "partially", "well", ",", ")", "that", "I", "hardly", "entertain", "them", "seriously", "I", "enclose", "you", "Tennyson", "'s", "latest", "letter", "to", "me", "also", "a", "slip", "Swinton", "gave", "me", "Send", "them", "both", "back", "in", "your", "next", "letter", "Eldridge", "is", "in", "Boston", "on", "his", "vacation", "I", "expect", "a", "visit", "from", "him", "in", "about", "12", "days", ",", "on", "his", "way", "back", "Best", "love", "to", "you", "both", ",", "&", "I", "shall", "be", "with", "you", "yet", ",", "I", "have", "no", "doubt.", "Walt", "."], "date": [], "normalizedTime": "0.726778185775", "recipient": "Ursula Burroughs", "organizations": ["Treasury"], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/nyp.00354.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to John and Ursula Burroughs ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Peter", "NNP"], ["Doyle", "NNP"]], [",", ","]]], "people": ["Camden"], "money": [], "year": "1874", "locations": [], "month": "Aug", "parties": ["Walt", "Whitman", "Peter Doyle"], "properDate": "Aug 21, 1874", "gpe": ["Stevens", "Phil"], "facility": [], "latlngs": [], "text": "  431 Stevens st Camden, N. Jersey.           Aug 21.                            Your last, & paper, rec'd   have had a tolerably good week but nothing to brag of   middling comfortable to-day   very hot here to-day   tell your RR. chum          if he sees me in Phil. he must make himself known to me.         W. W.        ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"]], ["st", "NN"], [["Camden", "NNP"]], [",", ","], ["N.", "NNP"], ["Jersey", "NNP"], [".", "."]], [["Aug", "NNP"], ["21", "CD"], [".", "."]], [["Your", "PRP$"], ["last", "JJ"], [",", ","], ["&", "CC"], ["paper", "NN"], [",", ","], ["rec", "NN"], ["'d", "MD"], ["have", "VB"], ["had", "VBN"], ["a", "DT"], ["tolerably", "RB"], ["good", "JJ"], ["week", "NN"], ["but", "CC"], ["nothing", "NN"], ["to", "TO"], ["brag", "VB"], ["of", "IN"], ["middling", "VBG"], ["comfortable", "JJ"], ["to-day", "NN"], ["very", "RB"], ["hot", "JJ"], ["here", "RB"], ["to-day", "JJ"], ["tell", "NN"], ["your", "PRP$"], ["RR", "NNP"], [".", "."]], [["chum", "NN"], ["if", "IN"], ["he", "PRP"], ["sees", "VBZ"], ["me", "PRP"], ["in", "IN"], [["Phil", "NNP"]], [".", "."]], [["he", "PRP"], ["must", "MD"], ["make", "VB"], ["himself", "PRP"], ["known", "VBN"], ["to", "TO"], ["me", "PRP"], [".", "."]], [["W.", "NNP"], ["W", "NNP"], [".", "."]]], "sentences": ["  431 Stevens st Camden, N. Jersey.", "Aug 21.", "Your last, & paper, rec'd   have had a tolerably good week but nothing to brag of   middling comfortable to-day   very hot here to-day   tell your RR.", "chum          if he sees me in Phil.", "he must make himself known to me.", "W. W.        "], "words": ["431", "Stevens", "st", "Camden", ",", "N.", "Jersey.", "Aug", "21.", "Your", "last", ",", "&", "paper", ",", "rec", "'d", "have", "had", "a", "tolerably", "good", "week", "but", "nothing", "to", "brag", "of", "middling", "comfortable", "to-day", "very", "hot", "here", "to-day", "tell", "your", "RR.", "chum", "if", "he", "sees", "me", "in", "Phil.", "he", "must", "make", "himself", "known", "to", "me.", "W.", "W", "."], "date": [], "normalizedTime": "0.727186182511", "recipient": "Peter Doyle", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/nyp.00352.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Peter Doyle ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Ellen", "NNP"], ["M.", "NNP"]], ["O'Connor", "NNP"], [",", ","]]], "people": ["Stevens st.", "Davis", "Charles Eldridge", "Eddy", "Jeff", "Walt If Pete Doyle"], "money": [], "year": "1874", "locations": ["West"], "month": "Nov", "parties": ["Walt", "Whitman", "Ellen M."], "properDate": "Nov 23, 1874", "gpe": ["Camden", "Washington", "Burlington"], "facility": [], "latlngs": [[51.55170589999999, -0.1588255], [38.8951118, -77.0363658], [44.4758825, -73.21207199999999], [38.6270025, -90.19940419999999]], "text": "  431 Stevens st. cor West. Camden, N. Jersey.           Nov. 23   2 p.m.                             Dear Nelly,        Your late letter reached me, enclosing the piece from the Academy.        I have been worse than usual for a week   very pronounced swimming spells & dizziness in the head,          with sometimes deathly faintness & great prostration   (twice I thought serious)   am sitting up to-day & yesterday   havn't been out   now this is the ninth day   continuous qualmishness & headache   doctor thinks however it is all substantially          a stomach & liver business   he comes every day   does not seem to be alarmed   I am taking mild powders of mercury for the liver   & drops composed of bromides          of potash & ammonia    There is death all around me here   Two yesterday of persons I know   I send you a piece by me          from the paper here   the young man alluded to was much like one of my most cherished soldier cases          in the Hospitals ten years since. He lived on the next block, & I was with him          a great deal   & at death.        Nelly, I just send you, (although one or two items confidential, sort o') Mrs. Price's last letter to me,          two days since   read it, & destroy it   I also send Mrs. Davis's, she (Mrs. P) sent me,          as you are interested in her    I shall get better, & shall come on to Washington yet   on a brief visit   Tell Charles Eldridge          I shall write to him this week   My brother & sister & Eddy here are well   My sister at Burlington,          Vt. was as usual at last acc'ts   also Jeff & his girls at St. Louis   As I write I am sitting here          in my big chair alone (alone muchly,) in the parlor by the window   It is a rainy darkish day here   the wind south & mild     Walt        If Pete Doyle comes up to see you, read him this letter   also give him the printed slip to read    ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"]], ["cor", "NN"], [["West", "NNP"]], [".", "."]], [[["Camden", "NNP"]], [",", ","], ["N.", "NNP"], ["Jersey", "NNP"], [".", "."]], [["Nov.", "NNP"], ["23", "CD"], ["2", "CD"], ["p.m.", "NNP"], ["Dear", "NNP"], ["Nelly", "NNP"], [",", ","], ["Your", "NNP"], ["late", "RB"], ["letter", "JJR"], ["reached", "VBN"], ["me", "PRP"], [",", ","], ["enclosing", "VBG"], ["the", "DT"], ["piece", "NN"], ["from", "IN"], ["the", "DT"], [["Academy", "NNP"]], [".", "."]], [["I", "PRP"], ["have", "VBP"], ["been", "VBN"], ["worse", "JJ"], ["than", "IN"], ["usual", "JJ"], ["for", "IN"], ["a", "DT"], ["week", "NN"], ["very", "RB"], ["pronounced", "VBN"], ["swimming", "VBG"], ["spells", "NNS"], ["&", "CC"], ["dizziness", "NN"], ["in", "IN"], ["the", "DT"], ["head", "NN"], [",", ","], ["with", "IN"], ["sometimes", "RB"], ["deathly", "RB"], ["faintness", "JJ"], ["&", "CC"], ["great", "JJ"], ["prostration", "NN"], ["(", ":"], ["twice", "NN"], ["I", "PRP"], ["thought", "VBD"], ["serious", "JJ"], [")", "NN"], ["am", "NN"], ["sitting", "VBG"], ["up", "RP"], ["to-day", "JJ"], ["&", "CC"], ["yesterday", "NN"], ["hav", "NN"], ["n't", "RB"], ["been", "VBN"], ["out", "RP"], ["now", "RB"], ["this", "DT"], ["is", "VBZ"], ["the", "DT"], ["ninth", "JJ"], ["day", "NN"], ["continuous", "JJ"], ["qualmishness", "NN"], ["&", "CC"], ["headache", "PRP"], ["doctor", "NN"], ["thinks", "NNS"], ["however", "RB"], ["it", "PRP"], ["is", "VBZ"], ["all", "DT"], ["substantially", "RB"], ["a", "DT"], ["stomach", "NN"], ["&", "CC"], ["liver", "RB"], ["business", "NN"], ["he", "PRP"], ["comes", "VBZ"], ["e