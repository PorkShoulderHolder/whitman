hast.", "Dear Sir:              I publish Leaves of Grass myself   & send it by mail,                 post paid, on receipt of the price, $3.", "Address.", "Walt Whitman                 Washington D. C.              "], "words": ["Attorney", "General", "'s", "Office", ",", "Washington.", "March", "12", ",", "1868.", "C.", "B.", "Sellinghast.", "Dear", "Sir", ":", "I", "publish", "Leaves", "of", "Grass", "myself", "&", "send", "it", "by", "mail", ",", "post", "paid", ",", "on", "receipt", "of", "the", "price", ",", "$", "3.", "Address.", "Walt", "Whitman", "Washington", "D.", "C", "."], "date": [], "normalizedTime": "0.407180742554", "recipient": "", "organizations": ["Leaves"], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/tex.00187.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to C. B. Sellinghast ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], ["O.", "NNP"], ["K.", "NNP"], [["Sammis", "NNP"]], [",", ","]]], "people": ["Doctor"], "money": [], "year": "1868", "locations": [], "month": "Mar", "parties": ["Walt", "Whitman", "Sammis"], "properDate": "Mar 13, 1868", "gpe": ["Washington", "Washington"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [38.8951118, -77.0363658]], "text": "  Attorney General's Office, Washington. March 13, 1868.                                  My dear Doctor,              Your note has just come to hand, stating that you intend a visit to Washington, &                 desire a situation. My friend, if that is your sole object here, & you depend                 upon any thing of that kind, (unless you have some special friend who has great                 influence, or offices at his disposal,) I seriously advise you against any such                 enterprise. I myself have no influence at all, being a mere clerk, & of low                 grade   & our office is in confusion   the Attorney General having                 yesterday resigned his place   & it being very probable that the                 rest of the cabinet will follow before long. They are discharging many of the                 Department employes, & appointing none. For some months to come, indeed for the                 ensuing year, every thing will be unsettled & in suspense here    There is nothing new with me   nor in our family.                  Yours, &c.                 Walt Whitman              with friendliest regards. ", "dateText": "", "percents": [], "taggedText": [[["Attorney", "NNP"], ["General", "NNP"], ["'s", "POS"], ["Office", "NNP"], [",", ","], [["Washington", "NNP"]], [".", "."]], [["March", "NNP"], ["13", "CD"], [",", ","], ["1868", "CD"], [".", "."]], [["My", "PRP$"], ["dear", "NN"], [["Doctor", "NNP"]], [",", ","], ["Your", "NNP"], ["note", "NN"], ["has", "VBZ"], ["just", "RB"], ["come", "VBN"], ["to", "TO"], ["hand", "VB"], [",", ","], ["stating", "VBG"], ["that", "IN"], ["you", "PRP"], ["intend", "VBP"], ["a", "DT"], ["visit", "NN"], ["to", "TO"], [["Washington", "NNP"]], [",", ","], ["&", "CC"], ["desire", "NN"], ["a", "DT"], ["situation", "NN"], [".", "."]], [["My", "PRP$"], ["friend", "NN"], [",", ","], ["if", "IN"], ["that", "DT"], ["is", "VBZ"], ["your", "PRP$"], ["sole", "NN"], ["object", "NN"], ["here", "RB"], [",", ","], ["&", "CC"], ["you", "PRP"], ["depend", "VBP"], ["upon", "IN"], ["any", "DT"], ["thing", "NN"], ["of", "IN"], ["that", "DT"], ["kind", "NN"], [",", ","], ["(", ":"], ["unless", "IN"], ["you", "PRP"], ["have", "VBP"], ["some", "DT"], ["special", "JJ"], ["friend", "NN"], ["who", "WP"], ["has", "VBZ"], ["great", "JJ"], ["influence", "NN"], [",", ","], ["or", "CC"], ["offices", "NNS"], ["at", "IN"], ["his", "PRP$"], ["disposal", "NN"], [",", ","], [")", ":"], ["I", "PRP"], ["seriously", "RB"], ["advise", "VBP"], ["you", "PRP"], ["against", "IN"], ["any", "DT"], ["such", "JJ"], ["enterprise", "NN"], [".", "."]], [["I", "PRP"], ["myself", "VBP