", "of", "the", "draft", "on", "the", "5th", "of", "next", "month", ",", "although", "$", "400", "seems", "like", "a", "pretty", "large", "sum", "to", "pay", "for", "a", "substitute.", "Walt", "says", "he", "is", "getting", "all", "right", "again,3", "when", "his", "book4", "is", "published", "I", "would", "him", ",", "to", "send", "me", "a", "coppy.", "Mattie", "and", "the", "children", "I", "hear", "are", "well", "as", "usual.", "Mother", "I", "hope", "you", "take", "things", "easy", "and", "dont", "worry", "and", "keep", "a", "bright", "look", "out", "for", "that", "little", "place", "in", "the", "country", ",", "When", "I", "get", "the", "New", "York", "papers", "I", "almost", "always", "look", "over", "the", "Farms", "for", "sale", "to", "see", "if", "there", "is", "anything", "offered", "that", "will", "suit", "us.", "Walt", "has", "asked", "several", "times", "if", "Williams5", "(", "who", "was", "with", "Fred", "McCready6", ")", "was", "captured", "when", "the", "ambulance", "train", "was", "attacted", ",", "Williams", "is", "here", "with", "his", "Company", ",", "he", "says", "when", "the", "guerillas", "ordered", "the", "train", "to", "halt", ",", "he", "jumped", "over", "the", "fence", "and", "escaped.", "Kind", "regards", "to", "allGeorge", "W.", "Whitman"], "date": [], "normalizedTime": "0.231742146063", "recipient": "Louisa Van Velsor Whitman", "organizations": ["fromPetersburg Va", "Division", "Regt", "book4", "Farms", "Williams5", "Company", "allGeorge"], "sender": "George Washington Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/duk.00361.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from George Washington Whitman to Louisa Van Velsor Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["James", "NNP"], ["S.", "NNP"], ["Stilwell", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Dear", "Sorry", "Sick", "Hill", "James S. Stilwell"], "money": [], "year": "1864", "locations": [], "month": "Sep", "parties": ["James S. Stilwell", "Walt Whitman"], "properDate": "Sep 2, 1864", "gpe": ["Washington", "Brooklyn"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [40.65, -73.95]], "text": " Dear Friend I take this time to write to you to let you know how I am I am well at presant my wound is most heald up and I hope that these few lines will find you well I reseived your letter and was glad to here from you but I was Sorry to here that you was Sick but I hope that you are well again before this time, I am home now I came home the (22) of august  I only got twenty (20) days furlough So I havent very long to Stay home it will be up the tenth (10) of this month I am A goin to new york A tuesday the Six (6) and if I have time I will come an See you I expected to have come home before or I should of wrote to you before this mother Send her best respects to you and would be glad to See you and So would all the rest I Shall try and get transfered to newyork before I go back to chestnut Hill, I will Send this to Washington and if you a[i]nt there they can Send it back to you fore I dont no how to derrect it to you to Brooklyn   So no more at preseant good by from your friend  James S. Stilwell  direct your letter to Commack Long Island N.Y. fore if I ant here mother will get it  ", "dateText": "", "percents": [], "taggedText": [[[["Dear", "NNP"]], ["Friend", "NNP"], ["I", "NNP"], ["take", "VBP"], ["this", "DT"], ["time", "NN"], ["to", "TO"], ["write", "VB"], ["to", "TO"], ["you", "PRP"], ["to", "TO"], ["let", "VB"], ["you", "PRP"], ["know", "VB"], ["how", "WRB"], ["I", "PRP"], ["am", "VBP"], ["I", "PRP"], ["am", "VBP"], ["well", "RB"], ["at", "IN"], ["presant", "JJ"], ["my", "PRP$"], ["wound", "NN"], ["is", "VBZ"], ["most", "JJS"], ["heald", "JJ"], ["up", "IN"], ["and", "CC"], ["I", "PRP"], ["hope", "VBP"], ["that", "IN"], ["these", "DT"], ["few", "JJ"], ["lines", "NNS"], ["will", "MD"],