"JJ"], ["little", "JJ"], ["thing", "NN"], ["!", "."]], [["Is", "VBZ"], ["n't", "RB"], ["it", "PRP"], ["s", "VBZ"], ["pitiful", "JJ"], ["thing", "NN"], ["to", "TO"], ["see", "VB"], ["a", "DT"], ["child", "NN"], ["sick", "NN"], ["?", "."]], [["To", "TO"], ["me", "PRP"], ["far", "RB"], ["more", "RBR"], ["appealing", "VBG"], ["than", "IN"], ["the", "DT"], ["sickness", "NN"], ["of", "IN"], ["a", "DT"], ["grown", "NN"], ["person", "NN"], [".", "."]], [["The", "DT"], ["critical", "JJ"], ["time", "NN"], ["was", "VBD"], ["Sunday", "NNP"], ["last", "JJ"], ["you", "PRP"], ["said", "VBD"], [",", ","], ["now", "RB"], ["it", "PRP"], ["is", "VBZ"], ["Tuesday", "NNP"], [",", ","], ["I", "PRP"], ["hope", "VBP"], ["she", "PRP"], ["is", "VBZ"], ["better", "RBR"], [".", "."]], [[["Try", "NNP"]], ["to", "TO"], ["send", "VB"], ["me", "PRP"], ["a", "DT"], ["line", "NN"], ["to", "TO"], ["say", "VB"], ["how", "WRB"], ["she", "PRP"], ["is", "VBZ"], [".", "."]], [["I", "PRP"], ["am", "VBP"], ["sorry", "JJ"], ["for", "IN"], ["your", "PRP$"], ["sake", "NN"], [",", ","], ["dear", "JJ"], ["Walt", "NNP"], [",", ","], ["that", "IN"], ["your", "PRP$"], ["mother", "NN"], ["is", "VBZ"], ["away", "RB"], [".", "."]], [["I", "PRP"], ["know", "VBP"], ["how", "WRB"], ["you", "PRP"], ["would", "MD"], ["miss", "VB"], ["her", "PRP"], [".", "."]], [["But", "CC"], ["perhaps", "RB"], ["by", "IN"], ["this", "DT"], ["time", "NN"], ["you", "PRP"], ["have", "VB"], ["gone", "VBN"], ["for", "IN"], ["her", "PRP$"], [".", "."]], [["I", "PRP"], ["hope", "VBP"], ["you", "PRP"], ["will", "MD"], ["go", "VB"], [",", ","], ["&", "CC"], ["will", "MD"], ["have", "VB"], ["a", "DT"], ["pleasant", "JJ"], ["journey", "NN"], ["and", "CC"], ["visit", "NN"], [".", "."]], [["I", "PRP"], ["have", "VBP"], ["delayed", "VBN"], ["writing", "VBG"], ["that", "IN"], ["I", "PRP"], ["might", "MD"], ["give", "VB"], ["you", "PRP"], ["the", "DT"], ["latest", "JJS"], ["news", "NN"], ["of", "IN"], ["Mrs.", "NNP"], [["Ashton", "NNP"]], ["&", "CC"], ["