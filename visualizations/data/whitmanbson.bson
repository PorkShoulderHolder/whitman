], [["The", "DT"], ["price", "NN"], ["is", "VBZ"], ["$", "$"], ["45", "CD"], ["and", "CC"], ["30", "CD"], ["copies", "NNS"], ["of", "IN"], ["the", "DT"], ["number", "NN"], ["in", "IN"], ["which", "WDT"], ["it", "PRP"], ["may", "MD"], ["be", "VB"], ["printed", "VBN"], [".", "."]], [["I", "PRP"], ["have", "VBP"], ["had", "VBN"], ["it", "PRP"], ["put", "VBD"], ["in", "IN"], ["type", "NN"], ["for", "IN"], ["my", "PRP$"], ["own", "JJ"], ["convenience", "NN"], [",", ","], ["&", "CC"], ["to", "TO"], ["insure", "VB"], ["greater", "JJR"], ["correctness", "NN"], [".", "."]], [["May", "NNP"], ["I", "PRP"], ["ask", "VBP"], ["you", "PRP"], ["the", "DT"], ["favor", "NN"], ["to", "TO"], ["send", "VB"], ["me", "PRP"], ["your", "PRP$"], ["decision", "NN"], ["within", "IN"], ["a", "DT"], ["week", "NN"], ["?", "."]], [[["Walt", "NNP"]], [["Whitman", "NNP"]], ["I", "NNP"], ["reserve", "VBP"], ["the", "DT"], ["right", "NN"], ["of", "IN"], ["printing", "NN"], ["the", "DT"], ["piece", "NN"], ["in", "IN"], ["future", "JJ"], ["book", "NN"], [".", "."]]], "sentences": ["  Attorney General's Office,                     Washington Dec. 17, 1868.", "Mr. Putnam.", "Dear Sir:              Would the enclosed piece be available to you for say the March number of your monthly?", "The price is $45   and 30 copies of the number in which it may be printed.", "I have had it put in type for my own convenience, & to insure greater correctness.", "May I ask you the favor to send me your decision within a week?", "Walt Whitman              I reserve the right of printing the piece in future book.                   "], "words": ["Attorney", "General", "'s", "Office", ",", "Washington", "Dec.", "17", ",", "1868.", "Mr.", "Putnam.", "Dear", "Sir", ":", "Would", "the", "enclosed", "piece", "be", "available", "to", "you", "for", "say", "the", "March", "number", "of", "your", "monthly", "?", "The", "price", "is", "$", "45", "and", "30", "copies", "of", "the", "number", "in", "which", "it", "may", "be", "printed.", "I", "have", "had", "it", "put", "in", "type", "for", "my", "own", "convenience", ",", "&", "to", "insure", "greater", "correctness.", "May", "I", "ask", "you", "the", "favor", "to", "send", "me", "your", "decision", "within", "a", "week", "?", "Walt", "Whitman", "I", "reserve", "the", "right", "of", "printing", "the", "piece", "in", "future", "book", "."], "date": [], "normalizedTime": "0.445260437916", "recipient": "George Palmer Putnam", "organizations": ["Putnam"], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/owu.00019.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to George Palmer Putnam ,"}, {"taggedHeading": [[[["Benton", "NNP"]], ["H.", "NNP"], [["Wilson", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Piano Factory", "Mother", "Baby Walt", "Johnson", "Love B.", "Wilson"], "money": [], "year": "1868", "locations": [], "month": "Dec", "parties": ["Benton", "Wilson", "Walt Whitman"], "properDate": "Dec 27, 1868", "gpe": ["Armory", "Father", "Father", "New York", "Hamilton"], "facility": [], "latlngs": [[40.7143528, -74.00597309999999], [43.25002080000001, -79.8660914], [43.0481221, -76.14742439999999]], "text": "image 1image 2image 3image 4image 5  Syracuse                     Dec 27th/68                                  Walt Whitman                 Dear Friend              I suppose you will think by this time that I have forgotten my Dear old Friend by my long silence & neglect to answer your letter, or acknowledge the receipt of your paper that you was so kind as to send me, but I assure you that I have not forgot you but sill remember you with the same Love that [commenced?] in Armory Square Hospital & will not cease as long as life lasts. There is not a day that passes but what I think of you & promise myself that I will not delay writing to you any longer but as often I break my promise. We have had excellent Sleighing here for the past two or three weeks                                                     and it still continues to be good & all that can afford it seem to enjoy it very much. I am at work in the Melodeon & Piano Factory of A. C. Chase again and shall probably continue there this winter. My health is very good. Father has been quite sick for a week but is improving now. Father & Mother send their Love to you. Our Baby Walt is a fine boy now & as bright as a dollar. I hope to have the pleasure of showing him to you someday. If you come to New York next summer & cannot come up and make me a short visit let me know when you are coming and if my business will permit I will meet you at new york and have a short visit with you there. I hope that the exit of A Johnson & the inauguration of Gen Grant                                                    will restore the country to a Peace footing in a very short time. I gave our Friends the Misses Riley a letter of introduction to you when they were here last fall. have you seen them yet. Hamilton is well as usual & is still running on the Rail Road. He sends his Love to you Hoping you had a merry Christmas & wishing you a happy New Year. I will close for the [present?] Please write soon.                  yours with Love                 B. H. Wilson.              ", "dateText": "", "percents": [], "taggedText": [[["image", "NN"], ["1image", "NN"], ["2image", "NN"], ["3image", "NN"], ["4image", "NN"], ["5", "CD"], [["Syracuse", "NNP"]], ["Dec", "NNP"], ["27th/68", "CD"], ["Walt", "NNP"], ["Whitman", "NNP"], ["Dear", "NNP"], ["Friend", "NNP"], ["I", "NNP"], ["suppose", "NN"], ["you", "PRP"], ["will", "MD"], ["think", "VB"], ["by", "IN"], ["this", "DT"], ["time", "NN"], ["that", "IN"], ["I", "PRP"], ["have", "VBP"], ["forgotten", "VBN"], ["my", "PRP$"], ["Dear", "NNP"], ["old", "JJ"], ["Friend", "NNP"], ["by", "IN"], ["my", "PRP$"], ["long", "JJ"], ["silence", "NN"], ["&", "CC"], ["neglect", "NN"], ["to", "TO"],