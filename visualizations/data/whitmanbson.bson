, [".", "."]]], "sentences": ["  431 Stevens st cor West Camden N Jersey U S America           April 4 '76                             Robert Buchanan   My dear friend           I merely want to say that I have read your letter in the London Daily News   all your three letters   & that I deeply appreciate them,          & do not hesitate to accept & respond to them in the same spirit in which they were surely impelled & written.", "May God bless you & yours,         Walt Whitman.        "], "words": ["431", "Stevens", "st", "cor", "West", "Camden", "N", "Jersey", "U", "S", "America", "April", "4", "'76", "Robert", "Buchanan", "My", "dear", "friend", "I", "merely", "want", "to", "say", "that", "I", "have", "read", "your", "letter", "in", "the", "London", "Daily", "News", "all", "your", "three", "letters", "&", "that", "I", "deeply", "appreciate", "them", ",", "&", "do", "not", "hesitate", "to", "accept", "&", "respond", "to", "them", "in", "the", "same", "spirit", "in", "which", "they", "were", "surely", "impelled", "&", "written.", "May", "God", "bless", "you", "&", "yours", ",", "Walt", "Whitman", "."], "date": [], "normalizedTime": "0.80769753842", "recipient": "Robert Buchanan", "organizations": ["America", "London Daily News"], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/loc.02828.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Robert Buchanan ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Daniel", "NNP"], ["Whittaker", "NNP"]], [",", ","]]], "people": ["Camden", "Harry Stafford", "Mr. Stafford", "Harry", "Walt", "Whitman"], "money": [], "year": "1876", "locations": [], "month": "Apr", "parties": ["Walt", "Whitman", "Daniel Whittaker"], "properDate": "Apr 4, 1876", "gpe": ["Stevens", "American"], "facility": [], "latlngs": [], "text": "  431 Stevens st Camden           April 4                    Dear Dan:        I take an interest in the boy in the office, Harry Stafford   I know his father & mother   There is a large family, very respectable American people   farmers, but only a hired farm   Mr. Stafford in weak health    I am anxious Harry should learn the printer's trade thoroughly   I want him to learn to set type          as fast as possible   want you to give him a chance (less of the mere errands &c)   There is a good deal really in the boy, if he has a chance.        Don't say any thing about this note to him   or in fact to any one   just tear it up, & keep the matter to yourself private.         Walt Whitman        ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"]], ["st", "NN"], [["Camden", "NNP"]], ["April", "NNP"], ["4", "CD"], ["Dear", "NNP"], ["Dan", "NNP"], [":", ":"], ["I", "PRP"], ["take", "VBP"], ["an", "DT"], ["interest", "NN"], ["in", "IN"], ["the", "DT"], ["boy", "NN"], ["in", "IN"], ["the", "DT"], ["office", "NN"], [",", ","], [["Harry", "NNP"], ["Stafford", "NNP"]], ["I", "NNP"], ["know", "VBP"], ["his", "PRP$"], ["father", "NN"], ["&", "CC"], ["mother", "NN"], ["There", "EX"], ["is", "VBZ"], ["a", "DT"], ["large", "JJ"], ["family", "NN"], [",", ","], ["very", "RB"], ["respectable", "JJ"], [["American", "JJ"]], ["people", "NNS"], ["farmers", "NNS"], [",", ","], ["but", "CC"], ["only", "RB"], ["a", "DT"], ["hired", "VBN"], ["farm", "NN"], [["Mr.", "NNP"], ["Stafford", "NNP"]], ["in", "IN"], ["weak", "JJ"], ["health", "NN"], ["I", "PRP"], ["am", "VBP"], ["anxious", "JJ"], [["Harry", "NNP"]], ["should", "MD"], ["learn", "VB"], ["the", "DT"], ["printer", "NN"], ["'s", "POS"], ["trade", "NN"], ["thoroughly", "RB"], ["I", "PRP"], ["want", "VBP"], ["him", "PRP"], ["to", "TO"], ["learn", "VB"], ["to", "TO"], ["set", "VB"], ["type", "NN"], ["as", "IN"], ["fast", "JJ"], ["as", "IN"], ["possible", "JJ"], ["want", "NN"], ["you", "PRP"], ["to", "TO"], ["give", "VB"], ["him", "PRP"], ["a", "DT"], ["chance", "NN"], ["(", ":"], ["l