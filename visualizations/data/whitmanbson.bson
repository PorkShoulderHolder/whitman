 ["I", "NNP"], ["write", "VBP"], ["to", "TO"], ["solicit", "VB"], ["from", "IN"], ["you", "PRP"], ["$", "$"], ["2", "CD"], [",", ","], ["for", "IN"], ["helping", "VBG"], ["my", "PRP$"], ["soldier", "NN"], ["boys", "NNS"], ["to", "TO"], ["some", "DT"], ["festivities", "NNS"], ["these", "DT"], ["holiday", "NN"], ["&", "CC"], [["New", "NNP"]], ["Year", "NNP"], ["times", "NNS"], [".", "."]], [["Yours", "NNS"], [["Walt", "NNP"], ["Whitman", "NNP"]]]], "sentences": ["  ATTORNEY GENERAL'S OFFICE, Washington.", "Dec. 29, 1866.", "My dear Mr. Wood,1 I write to solicit from you $2, for helping my soldier boys to some festivities these holiday & New Year times.", "Yours Walt Whitman "], "words": ["ATTORNEY", "GENERAL", "'S", "OFFICE", ",", "Washington.", "Dec.", "29", ",", "1866.", "My", "dear", "Mr.", "Wood,1", "I", "write", "to", "solicit", "from", "you", "$", "2", ",", "for", "helping", "my", "soldier", "boys", "to", "some", "festivities", "these", "holiday", "&", "New", "Year", "times.", "Yours", "Walt", "Whitman"], "date": [], "normalizedTime": "0.347477220182", "recipient": "George Wood", "organizations": ["GENERAL"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00846.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to George Wood ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Louisa", "NNP"], ["Van", "NNP"], ["Velsor", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Bayard Taylor", "Well"], "money": [], "year": "1867", "locations": [], "month": "Jan", "parties": ["Walt", "Whitman", "Louisa Van Velsor Whitman"], "properDate": "Jan 1, 1867", "gpe": ["Washington", "Eddy", "Walt"], "facility": [], "latlngs": [[38.8951118, -77.0363658]], "text": "  Attorney General's Office,                     Washington. Jan. 1, 1867 Dearest Mother,              I have just rec'd your letter   I thought of you during that storm   it was very severe here too,                  & awful gales of wind one or two nights   The dinner in the Hospital                 was a complete success   there was plenty, & good too   turkey & four or five kinds of vegetables, & mince pie, &c   then I purchased a large quantity of navy plug, & smoking tobacco, & pipes, &c. and after dinner                 every body that wanted to, had a good smoke   & I had a lot of oranges, apples, &c. & a large sugar cake for supper   then I read some amusing pieces to them for three quarters of an hour, for a change   & sat down by those who were worst off   &c. &c. Nobody else came in that day.                  They have a Chaplain, but he is miserable coot, like the rest of his tribe.              I have written again to Han                    I am writing this in the office, all alone   I am going down to the Hospital for a little while, & to carry some tobacco   & then I am invited to O'Connor's to dinner at 4 o'clock   we are to have cold turkey, hot vegetables, &c   They are going to stay where they are till next March.                  We have had quite a snow storm here   it is snowing moderately now.                  Some are out with their sleighs. I am glad to hear such a good account of Eddy.                 It makes me feel quite satisfied.              I had a visit from Bayard Taylor, a few days since. Well good bye for this time, dear mother.  Walt.              ", "dateText": "", "percents": [], "taggedText": [[["Attorney", "NNP"], ["General", "NNP"], ["'s", "POS"], ["Office", "NNP"], [",", ","], [["Washington", "NNP"]], [".", "."]], [["Jan.", "NNP"], ["1", "CD"], [",", ","], ["1867", "CD"], ["Dearest", "NNP"], ["Mother", "NNP"], [",", ","], ["I", "PRP"], ["have", "VBP"], ["just", "RB"], ["rec", "JJ"], ["'d", "JJ"], ["your", "PRP$"], ["letter", "NN"], ["I", "PRP"], ["thought", "VBD"], ["of", "IN"], ["you", "PRP"], ["during", "IN"], ["that", "DT"], ["storm", "NN"], ["it", "PRP"], ["was", "VBD"], ["very", "RB"]