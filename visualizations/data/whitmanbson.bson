NN"], ["his", "PRP$"], ["funeral", "JJ"], ["was", "VBD"], ["simple", "JJ"], ["but", "CC"], ["very", "RB"], ["impressive", "JJ"], ["all", "DT"], ["the", "DT"], ["big", "JJ"], ["radicals", "NNS"], ["were", "VBD"], ["there3", "NNP"], ["The", "NNP"], ["fight", "NN"], ["between", "IN"], [["Congress", "NNP"]], ["&", "CC"], ["the", "DT"], ["President", "NNP"], ["is", "VBZ"], ["still", "RB"], ["going", "VBG"], ["on", "IN"], ["I", "PRP"], ["think", "VBP"], ["the", "DT"], ["President", "NNP"], ["is", "VBZ"], ["rather", "RB"], ["afraid", "VBN"], ["of", "IN"], ["going", "VBG"], ["too", "RB"], ["far", "RB"], ["against", "IN"], [["Congress", "NNP"]], [",", ","], ["for", "IN"], [["Stevens", "NNP"]], ["&", "CC"], ["the", "DT"], ["rest", "NN"], ["of", "IN"], ["'em", "JJ"], ["are", "VBP"], ["very", "RB"], ["determined.4", "-NONE-"], ["My", "NNP"], ["hospitals", "NNS"], ["are", "VBP"], ["dwindled", "VBN"], ["down", "RP"], ["to", "TO"], ["a", "DT"], ["small", "JJ"], ["force", "NN"], ["but", "CC"], ["there", "EX"], ["are", "VBP"], ["plenty", "NN"], ["of", "IN"], ["cases", "NNS"], ["to", "TO"], ["occupy", "VB"], ["me", "PRP"], ["a", "DT"], ["couple", "NN"], ["of", "IN"], ["visits", "NNS"], ["a", "DT"], ["week", "NN"], ["I", "PRP"], ["always", "RB"], ["go", "VBP"], ["Sunday", "NNP"], [",", ","], ["&", "CC"], ["sometimes", "RB"], ["in", "IN"], ["the", "DT"], ["middle", "NN"], ["of", "IN"], ["the", "DT"], ["week", "NN"], [["Julius", "NNP"], ["Mason5", "NNP"]], ["is", "VBZ"], ["here", "RB"], ["in", "IN"], ["barracks", "NNS"], ["yet", "RB"], [["Jeff", "NNP"]], [",", ","], ["I", "PRP"], ["wish", "VBP"], ["I", "PRP"], ["could", "MD"], ["now", "RB"], ["&", "CC"], ["then", "RB"], ["be", "VB"], ["home", "NN"], ["&", "CC"], ["see", "VB"], ["you", "PRP"], ["all", "DT"], [",", ","], ["even", "RB"], ["if", "IN"], ["was", "VBD"], ["only", "RB"], ["a", "DT"], ["couple", "NN"], ["of", "IN"], ["hours", "NNS"], ["Give", "NNP"], ["my", "PRP$"], ["best", "JJS"], ["respects", "NNS"], ["to", "TO"], [["Mr.", "NNP"]], ["Lane,6", "NNP"], ["and", "CC"], ["the", "DT"], [["Doctor7", "NNP"]], ["I", "NNP"], ["send", "VBP"], ["my", "PRP$"], ["love", "NN"], ["to", "TO"], [["Mat8", "NNP"]], ["&", "CC"], ["the", "DT"], ["little", "JJ"], ["girls.9", "NN"], [["Write", "NNP"]], ["&", "CC"], ["tell", "NN"], ["me", "PRP"], ["all", "DT"], ["about", "IN"], ["home", "NN"], ["affairs", "NNS"], [",", ","], ["&", "CC"], ["how", "WRB"], [["George10", "NNP"]], ["is", "VBZ"], ["getting", "VBG"], ["along", "IN"], ["dear", "JJ"], ["old", "JJ"], ["Mother", "NNP"], [",", ","], ["as", "IN"], ["she", "PRP"], ["gets", "VBZ"], ["older", "JJR"], ["&", "CC"], ["older", "JJR"], [",", ","], ["I", "PRP"], ["think", "VBP"], ["about", "IN"], ["her", "PRP$"], ["every", "NN"], ["day", "NN"], ["&", "CC"], ["night", "NN"], [["Walt", "NNP"]], [".", "."]]], "sentences": ["  ATTORNEY GENERAL'S OFFICE, Washington, May 7, 1866.", "Dear brother Jeff,1 By Mother's letter I have heard about the moving & the new quarters   Mother says that she is glad they are no worse, under all the circumstances.", "I enclose an envelope to mother, with a little money in it.", "As you see, I am still in the same place, with easy times enough, & a good place as I could expect.", "The Attorney General2 is absent now in Kentucky.", "There is not much work.", "I can't tell whether I shall keep on here, or not.", "There is nothing at present that looks like a change   I feel quite well this spring   but a clerk's life here is not very interesting   I went down last Thursday to Mt Vernon, 16 miles down the Potomac   I think it is the pleasantest spot & farm I ever saw   went through the house & grounds &c   I was very glad I went   Yesterday we had the funeral here of a man you must have seen mentioned in the papers, old Count Gurowski.", "I have been very well acquainted with him since I have lived here   he was a strange old man, a great lord in his own country, Poland, owned 30,000 serfs & great estates   an exile for conspiring against the government   he knew every thing & growled & found fault with everybody   but was always very courteous to me, & spoke very highly of me in his book, his \"Diary,\" printed last winter   his funeral was simple but very impressive   all the big radicals were there3    The fight between Congress & the President is still going on   I think the President is rather afraid of going too far against Congress, for Stevens & the rest of 'em are very determined.4 My hospitals are dwindled down to a small force   but there are plenty of cases to occupy me a couple of visits a week   I always go Sunday, & sometimes in the middle of the week   Julius Mason5 is here in barracks yet   Jeff, I wish I could now & then be home & see you all, even if was only a couple of hours    Give my best respects to Mr. Lane,6 and the Doctor7   I send my love to Mat8 & the little girls.9 Write & tell me all about home affairs, & how George10 is getting along   dear old Mother, as she gets older & older, I think about her every day & night    Walt. "], "words": ["ATTORNEY", "GENERAL", "'S", "OFFICE", ",", "Washington", ",", "May", "7", ",", "1866.", "Dear", "brother", "Jeff,1", "By", "Mother", "'s", "letter", "I", "have", "heard", "about", "the", "moving", "&", "the", "new", "quarters", "Mother", "says", "that", "she", "is", "glad", "they", "are", "no", "worse", ",", "under", "all", "the", "circumstances.", "I", "enclose", "an", "envelope", "to", "mother", ",", "with", "a", "little", "money", "in", "it.", "As", "you", "see", ",", "I", "am", "still", "in", "the", "same", "place", ",", "with", "easy", "times", "enough", ",", "&", "a", "good", "place", "as", "I", "could", "expect.", "The", "Attorney", "General2", "is", "absent", "now", "in", "Kentucky.", "There", "is", "not", "much", "work.", "I", "ca", "n't", "tell", "whether", "I", "shall", "keep", "on", "here", ",", "or", "not.", "There", "is", "nothing", "at", "present", "that", "looks", "like", "a", "change", "I", "feel", "quite", "well", "this", "spring", "but", "a", "clerk", "'s", "life", "here", "is", "not", "very", "interesting", "I", "went", "down", "last", "Thursday", "to", "Mt", "Vernon", ",", "16", "miles", "down", "the", "Potomac", "I", "think", "it", "is", "the", "pleasantest", "spot", "&", "farm", "I", "ever", "saw", "went", "through", "the", "house", "&", "grounds", "&", "c", "I", "was", "very", "glad", "I", "went", "Yesterday", "we", "had", "the", "funeral", "here", "of", "a", "man", "you", "must", "have", "seen", "mentioned", "in", "the", "papers", ",", "old", "Count", "Gurowski.", "I", "have", "been", "very", "well", "acquainted", "with", "him", "since", "I", "have", "lived", "here", "he", "was", "a", "strange", "old", "man", ",", "a", "great", "lord", "in", "his", "own", "country", ",", "Poland", ",", "owned", "30,000", "serfs", "&", "great", "estates", "an", "exile", "for", "conspiring", "against", "the", "government", "he", "knew", "every", "thing", "&", "growled", "&", "found", "fault", "with", "everybody", "but", "was", "always", "very", "courteous", "to", "me", ",", "&", "spoke", "very", "highly", "of", "me", "in", "his", "book", ",", "his", "``", "Diary", ",", "''", "printed", "last", "winter", "his", "funeral", "was", "simple", "but", "very", "impressive", "all", "the", "big", "radicals", "were", "there3", "The", "fight", "between", "Congress", "&", "the", "President", "is", "still", "going", "on", "I", "think", "the", "President", "is", "rather", "afraid", "of", "going", "too", "far", "against", "Congress", ",", "for", "Stevens", "&", "the", "rest", "of", "'em", "are", "very", "determined.4", "My", "hospitals", "are", "dwindled", "down", "to", "a", "small", "force", "but", "there", "are", "plenty", "of", "cases", "to", "occupy", "me", "a", "couple", "of", "visits", "a", "week", "I", "always", "go", "Sunday", ",", "&", "sometimes", "in", "the", "middle", "of", "the", "week", "Julius", "Mason5", "is", "here", "in", "barracks", "yet", "Jeff", ",", "I", "wish", "I", "could", "now", "&", "then", "be", "home", "&", "see", "you", "all", ",", "even", "if", "was", "only", "a", "couple", "of", "hours", "Give", "my", "best", "respects", "to", "Mr.", "Lane,6", "and", "the", "Doctor7", "I", "send", "my", "love", "to", "Mat8", "&", "the", "little", "girls.9", "Write", "&", "tell", "me", "all", "about", "home", "affairs", ",", "&", "how", "George10", "is", "getting", "along", "dear", "old", "Mother", ",", "as", "she", "gets", "older", "&", "older", ",", "I", "think", "about", "her", "every", "day", "&", "night", "Walt", "."], "date": [], "normalizedTime": "0.315381476948", "recipient": "Thomas Jefferson Whitman", "organizations": ["GENERAL", "Potomac", "Congress", "Congress", "Doctor7", "Mat8", "Write", "George10"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/nyp.00206.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to Thomas Jefferson Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Louisa", "NNP"], ["Van", "NNP"], ["Velsor", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Dearest", "Han", "Walt"], "money": [], "year": "1866", "locations": [], "month": "May", "parties": ["Walt Whitman", "Louisa Van Velsor Whitman"], "properDate": "May 14, 1866", "gpe": ["Washington", "Mother", "Mother"], "facility": [], "latlngs": [[38.8951118, -77.0363658]], "text": "  ATTORNEY GENERAL'S OFFICE, Monday, Washington, May 14, 1866.  Dearest Mother, I hope you are entirely over that sickness of last week   When you write you must tell me   and also how you all get along with the new quarters   I think you must be pretty badly cramped   All goes on as usual with me   I spent yesterday afternoon at the Quarter Master's hospital   it is the old dregs & leavings of the war, old wounds, brokendown sick, discharged soldiers, who have no place to go, &c.   It is a shame that the Government has provided no place for such cases, of the Volunteer Army   they are just taken in here, to prevent them dying in the street   others go to the poor house   a good many break down after discharge, & have no pensions   & what is $8 a month these days anyhow? Mother, have [you] heard any thing lately from Han?1 I write to her every now & then   It is very pleasant weather here, quite cool to-day   Good by, dear mother, Walt. ", "dateText": "", "percents": [], "taggedText": [[["ATTORNEY", "NN"], [["GENERAL", "NNP"]], ["'S", "POS"], ["OFFICE", "NNP"], [",", ","], ["Monday", "NNP"], [",", ","], [["Washington", "NNP"]], [",", ","], ["May", "NNP"], ["14", "CD"], [",", ","], ["1866", "CD"], [".", "."]], [[["Dearest", "NNP"]], [["Mother", "NNP"]], [",", ","], ["I", "PRP"], ["hope", "VBP"], ["you", "PRP"], ["are", "VBP"], ["entirely", "RB"], ["over", "IN"], ["that", "DT"], ["sickness", "NN"], ["of", "IN"], ["last", "JJ"], ["week", "NN"], ["When", "WRB"], ["you", "PRP"], ["write", "VBP"], ["you", "PRP"], ["must", "MD"], ["tell", "VB"], ["me", "PRP"], ["and", "CC"], ["also", "RB"], ["how", "WRB"], ["you", "PRP"], ["all", "DT"], ["get", "NN"], ["along", "IN"], ["with", "IN"], ["the", "DT"], ["new", "JJ"], ["quarters", "NNS"], ["I", "PRP"], ["think", "VBP"], ["you", "PRP"], ["must", "MD"], ["be", "VB"], ["pretty", "RB"], ["badly", "RB"], ["cramped", "VBN"], ["All", "DT"], ["goes", "VBZ"], ["on", "IN"], ["as", "IN"], ["usual", "JJ"], ["with", "IN"], ["me", "PRP"], ["I", "PRP"], ["spent", "VBD"], ["yesterday", "NN"], ["afternoon", "NN"], ["at", "IN"], ["the", "DT"], [["Quarter", "NNP"], ["Master", "NNP"]], ["'s", "POS"], ["hospital", "JJ"], ["it", "PRP"], ["is", "VBZ"], ["the", "DT"], ["old", "JJ"], ["dregs", "NNS"], ["&", "CC"], ["leavings", "NNS"], ["of", "IN"], ["the", "DT"], ["war", "NN"], [",", ","], ["old", "JJ"], ["wounds", "NNS"], [",", ","], ["brokendown", "IN"], ["sick", "NN"], [",", ","], ["discharged", "VBD"], ["soldiers", "NNS"], [",", ","], ["who", "WP"], ["have", 