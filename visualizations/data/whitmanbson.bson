ns", "NNP"], ["st.", "NNP"], ["Camden", "NNP"]], [",", ","], ["N.", "NNP"], [["Jersey", "NNP"]], ["July", "NNP"], ["31", "CD"], [".", "."]], [["Though", "IN"], ["some", "DT"], ["bad", "JJ"], ["spells", "NNS"], ["still", "RB"], [",", ","], ["things", "NNS"], ["decidedly", "RB"], ["more", "RBR"], ["favorable", "JJ"], ["in", "IN"], ["my", "PRP$"], ["condition", "NN"], [".", "."]], [["I", "PRP"], ["shall", "VBP"], ["get", "VB"], ["up", "RP"], ["yet", "RB"], [".", "."]], [["W", "NNP"]]], "sentences": ["  431 Stevens st. Camden, N. Jersey           July 31.", "Though some bad spells still, things decidedly more favorable in my condition.", "I shall get up yet.", "W        "], "words": ["431", "Stevens", "st.", "Camden", ",", "N.", "Jersey", "July", "31.", "Though", "some", "bad", "spells", "still", ",", "things", "decidedly", "more", "favorable", "in", "my", "condition.", "I", "shall", "get", "up", "yet.", "W"], "date": [], "normalizedTime": "0.724330205358", "recipient": "Peter Doyle", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/nyp.00350.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Peter Doyle ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Ellen", "NNP"], ["M.", "NNP"]], ["O'Connor", "NNP"], [",", ","]]], "people": ["Stevens st.", "Dear", "Johnson", "Charles Eldridge My", "George", "Eddy", "Write", "Nelly", "Walt"], "money": [], "year": "1874", "locations": ["West"], "month": "Aug", "parties": ["Walt", "Whitman", "Ellen M."], "properDate": "Aug 5, 1874", "gpe": ["Camden", "Nelly", "Irish"], "facility": [], "latlngs": [[51.55170589999999, -0.1588255], [39.3642834, -74.4229266]], "text": "  431 Stevens st. cor West. Camden, N. Jersey.           Aug 5.                             Dear Nelly,        Your good letter came all right   it is pretty much \"the same subject continued\"   with my health & feelings   very grave depressions, alternated with more favorable spells    To-day, as I write, I am in good spirits & comparatively comfortable   after a painful attack last night   So it goes   What will be the finale remains to be seen.        I await your further letters with some curiosity   (for strange as it may seem, men have that weakness as well          as your sect)   I have to-day dispatched dear Mrs. Johnson's          picture by mail   (It is intended to be put in a square gray or white mat with oval top,          & then in a plain black walnut rustic square frame, with thin strip of gilt inside,          & good plate glass)   I shall look for Charles Eldridge    My sister is spending a few weeks at Atlantic City   I am here, (declining several invitations) muchly but pleasantly,          alone   We have a fine old Irish woman, (an old maid, not so very old either) who cooks nicely & runs the domestic          machinery, for brothers George & Eddy, & self   She little knows how much good she does me with her great splendid          coarse face & stout figure & warm-blooded & quaint & simple & affectionate ways    Write soon, Nelly dear            Walt.        ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"]], ["cor", "NN"], [["West", "NNP"]], [".", "."]], [[["Camden", "NNP"]], [",", ","], ["N.", "NNP"], ["Jersey", "NNP"], [".", "."]], [["Aug", "NNP"], ["5", "CD"], [".", "."]], [[["Dear", "NNP"]], [["Nelly", "NNP"]], [",", ","], ["Your", "NNP"], ["good", "NN"], ["letter", "NN"], ["came", "VBD"], ["all", "DT"], ["right", "NN"], ["it", "PRP"], ["is", "VBZ"], ["pretty", "RB"], ["much", "RB"], ["``", "``"], ["the", "DT"], ["same", "JJ"], ["subject", "NN"], ["continued", "VBD"], ["''", "''"], ["with", "IN"], ["my", "PRP$"], ["health", "NN"], ["&", "CC"], ["feelings", "NNS"], ["very", "RB"], ["grave", "VBP"], ["depressions", "NNS"], [",", ","], ["alternated", "VBD"], ["with", "IN"], ["more", "JJR"], ["favora