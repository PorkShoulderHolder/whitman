"&", "CC"], ["that", "IN"], ["is", "VBZ"], ["the", "DT"], ["case", "NN"], ["lately", "RB"], [".", "."]], [["But", "CC"], ["I", "PRP"], ["shall", "MD"], ["be", "VB"], ["careful", "JJ"], ["to", "TO"], ["make", "VB"], ["it", "PRP"], ["up", "RP"], [".", "."]], [["We", "PRP"], ["have", "VBP"], ["pleasanter", "JJR"], ["weather", "NN"], ["here", "RB"], ["the", "DT"], ["last", "JJ"], ["ten", "NN"], ["days", "NNS"], ["quite", "RB"], ["cool", "JJ"], ["mornings", "NNS"], ["&", "CC"], ["nights", "NNS"], [".", "."]], [["My", "PRP$"], ["dear", "NN"], ["friend", "NN"], [";", ":"], ["I", "PRP"], ["am", "VBP"], ["sorry", "JJ"], ["you", "PRP"], ["could", "MD"], ["not", "RB"], ["have", "VB"], ["been", "VBN"], ["with", "IN"], ["me", "PRP"], ["for", "IN"], ["a", "DT"], ["day", "NN"], ["or", "CC"], ["two", "CD"], ["before", "IN"], ["you", "PRP"], ["left", "VBD"], [["Washington", "NNP"]], [",", ","], ["as", "IN"], ["it", "PRP"], ["may", "MD"], ["be", "VB"], ["we", "PRP"], ["shall", "MD"], ["not", "RB"], ["meet", "VB"], ["again", "RB"], [".", "."]], [["But", "CC"], ["you", "PRP"], ["must", "MD"], ["not", "RB"], ["forget", "VB"], ["me", "PRP"], [",", ","], ["for", "IN"], ["I", "PRP"], ["shall", "MD"], ["not", "RB"], ["you", "PRP"], [".", "."]], [[["Write", "NNP"]], ["to", "TO"], ["me", "PRP"], ["from", "IN"], ["time", "NN"], ["to", "TO"], ["time", "VB"], [",", ","], [["Anson", "NNP"]], [",", ","], ["&", "CC"], ["I", "PRP"], ["will", "MD"], ["you", "PRP"], ["too", "RB"], [".", "."]], [["The", "DT"], ["picture", "NN"], ["you", "PRP"], ["shall", "MD"], ["have", "VB"], ["As", "RB"], ["I", "PRP"], ["am", "VBP"], ["writing", "VBG"], ["this", "DT"], ["at", "IN"], ["the", "DT"], ["office", "NN"], [",", ","], ["otherwise", "RB"], ["I", "PRP"], ["would", "MD"], ["enclose", "VB"], ["one", "CD"], ["of", "IN"], ["the", "DT"], ["card", "NN"], ["photographs", "NNS"], ["in", "IN"], ["it", "PRP"], ["they", "PRP"], ["are", "VBP"], ["up", "RP"], ["at", "IN"], ["my", "PRP$"], ["room", "NN"], ["I", "PRP"], ["wi