", "JJ"], ["three", "CD"], ["or", "CC"], ["four", "CD"], ["room", "NN"], ["house", "NN"], ["on", "IN"], ["it", "PRP"], [",", ","], ["in", "IN"], ["which", "WDT"], ["I", "PRP"], ["might", "MD"], ["live", "VB"], ["plainly", "RB"], ["&", "CC"], ["comfortably", "RB"], ["the", "DT"], ["rest", "NN"], ["of", "IN"], ["my", "PRP$"], ["days", "NNS"], ["&", "CC"], ["that", "IN"], ["is", "VBZ"], ["still", "RB"], ["my", "PRP$"], ["plan", "NN"], ["&", "CC"], ["desire", "NN"], [".", "."]], [["I", "PRP"], ["had", "VBD"], ["saved", "VBN"], ["up", "RP"], ["quite", "RB"], ["a", "DT"], ["fund", "NN"], ["from", "IN"], ["my", "PRP$"], ["earnings", "NNS"], ["'65", "-NONE-"], ["to", "TO"], ["'72", "-NONE-"], ["as", "IN"], ["clerk", "NN"], ["in", "IN"], [["Washington", "NNP"]], ["but", "CC"], ["they", "PRP"], ["have", "VBP"], ["now", "RB"], ["become", "VBN"], ["about", "IN"], ["exhausted", "VBN"], ["by", "IN"], ["expenses", "NNS"], ["of", "IN"], ["three", "CD"], ["years", "NNS"], [",", ","], ["(", ":"], ["for", "IN"], ["I", "PRP"], ["just", "RB"], ["take", "VBP"], ["board", "NN"], ["&", "CC"], ["lodging", "VBG"], ["here", "RB"], ["&", "CC"], ["pay", "NN"], ["for", "IN"], ["them", "PRP"], ["scrupulously", "RB"], ["same", "JJ"], ["as", "IN"], ["in", "IN"], ["some", "DT"], ["temporary", "JJ"], ["inn", "NN"], [".", "."]], [[")", "NN"], ["My", "PRP$"], ["great", "JJ"], ["wish", "NN"], ["still", "RB"], ["is", "VBZ"], ["to", "TO"], ["put", "VB"], ["up", "RP"], ["for", "IN"], ["myself", "PRP"], ["this", "DT"], ["little", "JJ"], ["three", "CD"], ["or", "CC"], ["four", "CD"], ["room", "NN"], ["home", "NN"], ["for", "IN"], ["the", "DT"], ["rest", "NN"], ["of", "IN"], ["my", "PRP$"], ["days", "NNS"], [",", ","], ["independently", "RB"], [",", ","], ["in", "IN"], ["a", "DT"], ["sort", "NN"], [".", "."]], [["I", "PRP"], ["suppose", "VBP"], ["it", "PRP"], ["would", "MD"], ["cost", "VB"], ["700", "CD"], ["or", "CC"], ["800", "CD"], ["dollars", "NNS"], [".", "."]], [["I", "PRP"], ["have", "VBP"], ["managed", "VBN"], ["to", "TO"], ["get", "VB"], ["out", "IN"], ["complete", "JJ"], ["my", "PRP$"], ["new", "JJ"], ["edition", "NN"], ["both", "DT"], ["Vols", "NNP"], [".", "."]], [["which", "WDT"], ["I", "PRP"], ["now", "RB"], ["begin", "VBP"], ["to", "TO"], ["sell", "VB"], ["&", "CC"], ["job", "NN"], ["myself", "PRP"], ["intend", "VBP"], ["to", "TO"], ["continue", "VB"], ["doing", "VBG"], ["so", "RB"], ["(", ":"], ["have", "VBP"], ["somehow", "NN"], ["an", "DT"], ["idea", "NN"], ["that", "IN"], ["I", "PRP"], ["should", "MD"], ["then", "RB"], [",", ","], ["in", "IN"], ["my", "PRP$"], ["own", "JJ"], ["shanty", "NN"], [",", ","], ["&", "CC"], ["for", "IN"], ["time", "NN"], ["to", "TO"], ["come", "VB"], [",", ","], ["be", "VB"], ["able", "JJ"], ["to", "TO"], ["live", "VB"], ["on", "IN"], ["the", "DT"], ["moderate", "JJ"], ["steady", "JJ"], ["income", "NN"], ["of", "IN"], ["the", "DT"], ["sales", "NNS"], ["of", "IN"], ["my", "PRP$"], ["own", "JJ"], ["works", "NNS"], ["which", "WDT"], ["is", "VBZ"], ["most", "JJS"], ["satisfactory", "JJ"], ["to", "TO"], ["me", "PRP"], [")", ":"], ["I", "PRP"], ["was", "VBD"], ["in", "IN"], ["hopes", "NNS"], ["to", "TO"], ["have", "VB"], ["seen", "VBN"], ["you", "PRP"], ["again", "RB"], ["before", "IN"], ["you", "PRP"], ["sail", "VBP"], ["'d", "JJ"], ["I", "PRP"], ["was", "VBD"], ["at", "IN"], [["Mrs", "NNP"], ["Lesley", "NNP"]], ["'s", "POS"], ["again", "NN"], ["about", "IN"], ["three", "CD"], ["weeks", "NNS"], ["since", "IN"], ["(", "CD"], ["to", "TO"], ["meet", "VB"], [["Miss", "NNP"], ["Kate", "NNP"], ["Hillard", "NNP"]], [")", "NNP"], ["had", "VBD"], ["a", "DT"], ["very", "RB"], ["pleasant", "JJ"], ["afternoon", "NN"], ["with", "IN"], ["Mrs.", "NNP"], ["L", "NNP"], ["&", "CC"], ["the", "DT"], ["rest", "NN"], ["Things", "NNS"], ["go", "VBP"], ["on", "IN"], ["much", "JJ"], ["the", "DT"], ["same", "JJ"], ["with", "IN"], ["me", "PRP"], ["in", "IN"], ["physical", "JJ"], ["condition", "NN"], ["I", "PRP"], ["send", "VBP"], ["you", "PRP"], ["a", "DT"], ["paper", "NN"], ["&", "CC"], ["some", "DT"], ["slips", "NNS"], [",", ","], ["same", "JJ"], ["mail", "NN"], ["with", "IN"], ["this", "DT"], ["I", "PRP"], ["have", "VBP"], ["written", "VBN"], ["very", "RB"], ["lately", "RB"], ["to", "TO"], [["W", "NNP"]], ["M", "NNP"], ["Rossetti", "NNP"], ["about", "IN"], ["my", "PRP$"], ["affairs", "NNS"], [",", ","], ["books", "NNS"], [",", ","], ["&", "CC"], ["c.", "NNP"], ["Walt", "NNP"], ["Whitman", "NNP"]]], "sentences": ["  431 Stevens st cor West Camden N Jersey  U S America              March 19                             My dearest friend,        I did not know at all till supper with my sister-in-law last           evening that you had had a conversation with her about, & special         interest in, my pecuniary condition, &c. If I had known it at the time I should         have spoken about it, & freely, to you, by word of mouth   as that would         have been, & is, best in such things.", "When I came to Camden in '73, paralyzed, I felt, (& the feeling has since been         confirmed,) that I had retired for good from the active world, but that I might         linger along for years yet.", "I bought a pleasant little cheap lot here, paid for it,         & my plan was to put up a small three or four room house on it, in which I might         live plainly & comfortably the rest of my days   & that is still my plan         & desire.", "I had saved up quite a fund from my         earnings '65 to '72 as clerk in Washington   but they have now become about         exhausted by expenses of three years, (for I just take board & lodging here         & pay for them scrupulously same as in some temporary inn.", ") My great wish still         is to put up for myself this little three or four room home for the rest of my days,         independently, in a sort.", "I suppose it would cost 700 or 800 dollars.", "I have managed to get out complete my new edition both Vols.", "which I now begin to         sell & job myself   intend to continue doing so   (have somehow an idea         that I should then, in my own shanty, & for time to come, be able to live on the         moderate steady income of the sales of my own works   which           is most satisfactory to me)    I was in hopes to have seen you again before you sail'd   I was at Mrs Lesley's         again about three weeks since (to meet Miss Kate Hillard)   had a very pleasant afternoon with Mrs.         L & the rest    Things go on much the same with me in physical condition   I send you a paper         & some slips, same mail with this   I have written very lately to W M         Rossetti about my affairs, books, &c.  Walt Whitman        "], "words": ["431", "Stevens", "st", "cor", "West", "Camden", "N", "Jersey", "U", "S", "America", "March", "19", "My", "dearest", "friend", ",", "I", "did", "not", "know", "at", "all", "till", "supper", "with", "my", "sister-in-law", "last", "evening", "that", "you", "had", "had", "a", "conversation", "with", "her", "about", ",", "&", "special", "interest", "in", ",", "my", "pecuniary", "condition", ",", "&", "c.", "If", "I", "had", "known", "it", "at", "the", "time", "I", "should", "have", "spoken", "about", "it", ",", "&", "freely", ",", "to", "you", ",", "by", "word", "of", "mouth", "as", "that", "would", "have", "been", ",", "&", "is", ",", "best", "in", "such", "things.", "When", "I", "came", "to", "Camden", "in", "'73", ",", "paralyzed", ",", "I", "felt", ",", "(", "&", "the", "feeling", "has", "since", "been", "confirmed", ",", ")", "that", "I", "had", "retired", "for", "good", "from", "the", "active", "world", ",", "but", "that", "I", "might", "linger", "along", "for", "years", "yet.", "I", "bought", "a", "pleasant", "little", "cheap", "lot", "here", ",", "paid", "for", "it", ",", "&", "my", "plan", "was", "to", "put", "up", "a", "small", "three", "or", "four", "room", "house", "on", "it", ",", "in", "which", "I", "might", "live", "plainly", "&", "comfortably", "the", "rest", "of", "my", "days", "&", "that", "is", "still", "my", "plan", "&", "desire.", "I", "had", "saved", "up", "quite", "a", "fund", "from", "my", "earnings", "'65", "to", "'72", "as", "clerk", "in", "Washington", "but", "they", "have", "now", "become", "about", "exhausted", "by", "expenses", "of", "three", "years", ",", "(", "for", "I", "just", "take", "board", "&", "lodging", "here", "&", "pay", "for", "them", "scrupulously", "same", "as", "in", "some", "temporary", "inn.", ")", "My", "great", "wish", "still", "is", "to", "put", "up", "for", "myself", "this", "little", "three", "or", "four", "room", "home", "for", "the", "rest", "of", "my", "days", ",", "independently", ",", "in", "a", "sort.", "I", "suppose", "it", "would", "cost", "700", "or", "800", "dollars.", "I", "have", "managed", "to", "get", "out", "complete", "my", "new", "edition", "both", "Vols.", "which", "I", "now", "begin", "to", "sell", "&", "job", "myself", "intend", "to", "continue", "doing", "so", "(", "have", "somehow", "an", "idea", "that", "I", "should", "then", ",", "in", "my", "own", "shanty", ",", "&", "for", "time", "to", "come", ",", "be", "able", "to", "live", "on", "the", "moderate", "steady", "income", "of", "the", "sales", "of", "my", "own", "works", "which", "is", "most", "satisfactory", "to", "me", ")", "I", "was", "in", "hopes", "to", "have", "seen", "you", "again", "before", "you", "sail", "'d", "I", "was", "at", "Mrs", "Lesley", "'s", "again", "about", "three", "weeks", "since", "(", "to", "meet", "Miss", "Kate", "Hillard", ")", "had", "a", "very", "pleasant", "afternoon", "with", "Mrs.", "L", "&", "the", "rest", "Things", "go", "on", "much", "the", "same", "with", "me", "in", "physical", "condition", "I", "send", "you", "a", "paper", "&", "some", "slips", ",", "same", "mail", "with", "this", "I", "have", "written", "very", "lately", "to", "W", "M", "Rossetti", "about", "my", "affairs", ",", "books", ",", "&", "c.", "Walt", "Whitman"], "date": [], "normalizedTime": "0.805521555828", "recipient": "Moncure D. Conway", "organizations": ["America", "Mrs Lesley", "W"], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/col.00005.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Moncure D. Conway ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Ellen", "NNP"], ["M.", "NNP"]], ["O'Connor", "NNP"], [",", ","]]], "people": ["Camden"], "money": [], "year": "1876", "locations": [], "month": "Mar", "parties": ["Walt", "Whitman", "Ellen M."], "properDate": "Mar 23, 1876", "gpe": [], "facility": [], "latlngs": [], "text": "  Camden              March 23   noon                               Yours rec'd   I am around, much the same   nothing very new, or different   the b[aby] doing well, grows well, hearty & bright   the rest well as usual   E[dward] recovered, & all right   my (new Edition) books out at last   (sent a set to N. M. J[ohnson] 506 12th st.)   comfortable to-day   write this in haste     W.W.        ", "dateText": "", "percents": [], "taggedText": [[[["Camden", "NNP"]], ["March", "NNP"], ["23", "CD"], ["noon", "NN"], ["Yours", "NNS"], ["rec", "VBP"], ["'d", "JJ"], ["I", "PRP"], ["am", "VBP"], ["around", "RP"], [",", ","], ["much", "RB"], ["the", "DT"], ["same", "JJ"], ["nothing", "NN"], ["very", "RB"], ["new", "JJ"], [",", ","], ["or", "CC"], ["different", "JJ"], ["the", "DT"], ["b", "NN"], ["[", ":"], ["aby", "NN"], ["]", ":"], ["doing", "VBG"], ["well", "RB"], [",", ","], ["grows", "VBZ"], ["well", "RB"], [",", ","], ["hearty", "NN"], ["&", "CC"], ["bright", "JJ"], ["the", "DT"], ["rest", "NN"], ["well", "RB"], ["as", "IN"], ["usual", "JJ"], ["E", "NNP"], ["[", "NNP"], ["dward", "NN"], ["]", ":"], ["recovered", "VBD"], [",", ","], ["&", "CC"], ["all", "DT"], ["right", "NN"], ["my", "PRP$"], ["(", "NN"], ["new", "JJ"], ["Edition", "NN"], [")", ":"], ["books", "NNS"], ["out", "IN"], ["at", "IN"], ["last", "JJ"], ["(", "NN"