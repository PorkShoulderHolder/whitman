ll", "DT"], ["very", "RB"], ["well", "RB"], [",", ","], ["except", "IN"], ["that", "DT"], ["my", "PRP$"], ["sister", "NN"], [",", ","], ["the", "DT"], ["mother", "NN"], [",", ","], ["is", "VBZ"], ["part", "NN"], ["of", "IN"], ["the", "DT"], ["time", "NN"], ["only", "RB"], ["middling", "VBG"], [".", "."]], [["I", "PRP"], ["hear", "VBP"], ["young", "JJ"], ["Walt", "NNP"], ["raising", "NN"], ["his", "PRP$"], ["song", "JJ"], [",", ","], ["in", "IN"], ["the", "DT"], ["room", "NN"], ["overhead", "NN"], ["as", "IN"], ["I", "PRP"], ["conclude", "VBP"], ["my", "PRP$"], ["letter", "NN"], [["Love", "NNP"]], ["to", "TO"], ["you", "PRP"], [",", ","], ["as", "IN"], ["always", "RB"], [",", ","], ["my", "PRP$"], ["friend", "NN"], [["Walt", "NNP"]], [".", "."]]], "sentences": ["  431 Stevens st. cor West.", "Camden, N. Jersey.", "Dec. 17                  Dear John Burroughs,        I have been back here two weeks & over   My Washington jaunt occupied some seventeen or eighteen days,          & was a very pleasant one for me   (started out with the idea of a two days visit only)   Am perhaps now lately          not so well, but not much different   the gravest trouble is the liver and stomachic business now   Still I keep          up about the same, (& get mad at myself for grunting)   Your letter of two days since rec'd.", "Best love to 'Sula, & to Jenny Grant if there    My new edition is nearly ready   Two Vols   will give you early advice of their appearance   only 100 copies issued   Is the Winter Sunshine out?", "Eldridge call'd to see me on his return home two weeks since.", "Marvin has gone to England,          with a Treas[ury] squad.", "He has call'd on Mrs. Gilchrist.", "M. D. Conway called on me.", "Lord Houghton also.", "We have great times in this house   a baby has arrived, a fine lusty little fellow, now five weeks old   (he has been named Walt)   just now though he is quite sick, but I opine will get along   The rest all very well, except that my sister,          the mother, is part of the time only middling.", "I hear young Walt raising his song, in the room overhead as          I conclude my letter    Love to you, as always, my friend            Walt.        "], "words": ["431", "Stevens", "st.", "cor", "West.", "Camden", ",", "N.", "Jersey.", "Dec.", "17", "Dear", "John", "Burroughs", ",", "I", "have", "been", "back", "here", "two", "weeks", "&", "over", "My", "Washington", "jaunt", "occupied", "some", "seventeen", "or", "eighteen", "days", ",", "&", "was", "a", "very", "pleasant", "one", "for", "me", "(", "started", "out", "with", "the", "idea", "of", "a", "two", "days", "visit", "only", ")", "Am", "perhaps", "now", "lately", "not", "so", "well", ",", "but", "not", "much", "different", "the", "gravest", "trouble", "is", "the", "liver", "and", "stomachic", "business", "now", "Still", "I", "keep", "up", "about", "the", "same", ",", "(", "&", "get", "mad", "at", "myself", "for", "grunting", ")", "Your", "letter", "of", "two", "days", "since", "rec'd.", "Best", "love", "to", "'Sula", ",", "&", "to", "Jenny", "Grant", "if", "there", "My", "new", "edition", "is", "nearly", "ready", "Two", "Vols", "will", "give", "you", "early", "advice", "of", "their", "appearance", "only", "100", "copies", "issued", "Is", "the", "Winter", "Sunshine", "out", "?", "Eldridge", "call", "'d", "to", "see", "me", "on", "his", "return", "home", "two", "weeks", "since.", "Marvin", "has", "gone", "to", "England", ",", "with", "a", "Treas", "[", "ury", "]", "squad.", "He", "has", "call", "'d", "on", "Mrs.", "Gilchrist.", "M.", "D.", "Conway", "called", "on", "me.", "Lord", "Houghton", "also.", "We", "have", "great", "times", "in", "this", "house", "a", "baby", "has", "arrived", ",", "a", "fine", "lusty", "little", "fellow", ",", "now", "five", "weeks", "old", "(", "he", "has", "been", "named", "Walt", ")", "just", "now", "though", "he", "is", "quite", "sick", ",", "but", "I", "opine", "will", "get", "along", "The", "rest", "all", "very", "well", ",", "except", "that", "my", "sister", ",", "the", "mother", ",", "is", "part", "of", "the", "time", "only", "middling.", "I", "hear", "young", "Walt", "raising", "his", "song", ",", "in", "the", "room", "overhead", "as", "I", "conclude", "my", "letter", "Love", "to", "you", ",", "as", "always", ",", "my", "friend", "Walt", "."], "date": [], "normalizedTime": "0.792873657011", "recipient": "John Burroughs", "organizations": ["Treas"], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/nyp.00373.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to John Burroughs ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], ["the", "DT"], [["Librarian", "NNP"]], ["of", "IN"], [["Congress", "NNP"]], [",", ","]]], "people": ["Stevens st.", "Librarian Congress", "Copyright", "Walt Whitman If", "Copyright"], "money": [], "year": "1875", "locations": ["West"], "month": "Dec", "parties": ["Walt", "Whitman", "Librarian", "Congress"], "properDate": "Dec 20, 1875", "gpe": ["Camden"], "facility": [], "latlngs": [[51.55170589999999, -0.1588255]], "text": "  431 Stevens st. cor West. Camden, N. Jersey.           Dec. 20, '75                  Librarian Congress:Dear Sir:        Please furnish me with Copyright for \"Two Rivulets,\" as per title enclosed. Is the $1 the right sum?                 Yours truly         Walt Whitman        If perfectly convenient   & you have a printed slip with Copyright laws, (latest) please enclose with document. ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"]], ["cor", "NN"], [["West", "NNP"]], [".", "."]], [[["Camden", "NNP"]], [",", ","], ["N.", "NNP"], ["Jersey", "NNP"], [".", "."]], [["Dec.", "NNP"], ["20", "CD"], [",", ","], ["'75", "-NONE-"], [["Librarian", "NNP"], ["Congress", "NNP"]], [":", ":"], ["Dear", "NNP"], ["Sir", "NNP"], [":", ":"], ["Please", "NNP"], ["furnish", "NN"], ["me", "PRP"], ["with", "IN"], [["Copyright", "NNP"]], ["for", "IN"], ["``", "``"], ["Two", "CD"], ["Rivulets", "NNS"], [",", ","], ["''", "''"], ["as", "IN"], ["per", "JJR"], ["title", "NN"], ["enclosed", "VBN"], [".", "."]], [["Is", "VBZ"], ["the", "DT"], ["$", "$"], ["1", "CD"], ["the", "DT"], ["right", "NN"], ["sum", "NN"], ["?", "."]], [["Yours", "NNS"], ["truly", "RB"], [["Walt", "NNP"], ["Whitman", "NNP"], ["If", "NNP"]], ["perfectly", "RB"], ["convenient", "JJ"], ["&", "CC"], ["you", "PRP"], ["have", "VBP"], ["a", "DT"], ["printed", "VBN"], ["slip", "NN"], ["with", "IN"], [["Copyright", "NNP"]], ["laws", "NNS"], [",", ","], ["(", ":"], ["latest", "JJS"], [")", ":"], ["please", "NN"], ["enclose", "NN"], ["with", "IN"], ["document", "NN"], [".", "."]]], "sentences": ["  431 Stevens st. cor West.", "Camden, N. Jersey.", "Dec. 20, '75                  Librarian Congress:Dear Sir:        Please furnish me with Copyright for \"Two Rivulets,\" as per title enclosed.", "Is the $1 the right sum?", "Yours truly         Walt Whitman        If perfectly convenient   & you have a printed slip with Copyright laws, (latest) please enclose with document. "], "words": ["431", "Stevens", "st.", "cor", "West.", "Camden", ",", "N.", "Jersey.", "Dec.", "20", ",", "'75", "Librarian", "Congress", ":", "Dear", "Sir", ":", "Please", "furnish", "me", "with", "Copyright", "for", "``", "Two", "Rivulets", ",", "''", "as", "per", "title", "enclosed.", "Is", "the", "$", "1", "the", "right", "sum", "?", "Yours", "truly", "Walt", "Whitman", "If", "perfectly", "convenient", "&", "you", "have", "a", "printed", "slip", "with", "Copyright", "laws", ",", "(", "latest", ")", "please", "enclose", "with", "document", "."], "date": [], "normalizedTime": "0.793281653747", "recipient": "Congress", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/med.00440.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to the Librarian of Congress ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Edward", "NNP"], ["Dowden", "NNP"]]]], "people": ["Stevens St", "John", "Burroughs", "John Burroughs", "Walt", "Whitman"], "money": [], "year": "1876", "locations": [], "month": "Jan", "parties": ["Walt", "Whitman", "Edward Dowden"], "properDate": "Jan 0, 1876", "gpe": ["Britain"], "facility": [], "latlngs": [], "text": "  431 Stevens St &c                        My dear friend,        Enclosed I send you a piece printed here to give a true statement of the situation   & which I should be          well satisfied to have printed in Britain. I ought to have written you before. I have read your \"Shakspere\" & ought to have thanked you for it. I find it full of vitality & suggestiveness, on themes that          might be supposed exhausted years ago   but are not at all exhausted.        As I write I am feeling pretty comfortable   much the same as for last two years   no worse.         John Burroughs was here with me last week. He is well.   \ufffd        M D Conway has called upon us. He is a good & intellectual man, but I don't think I either got hold of him,          nor he of me, at all. My friend, I must still put off for another letter some things I have had in my mind          for months to say to you. Your letters past   what John Burroughs told me   (and your Shakspere book)   have grafted you more on my good will & memory than you perhaps know. I write in haste.         Walt Whitman        ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["St", "NNP"]], ["&", "CC"], ["c", "NN"], ["My", "NNP"], ["dear", "NN"], ["friend", "NN"], [",", ","], ["Enclosed", "NNP"], ["I", "PRP"], ["send", "VBP"], ["you", "PRP"], ["a", "DT"], ["piece", "NN"], ["printed", "VBN"], ["here", "RB"], ["to", "TO"], ["give", "VB"], ["a", "DT"], ["true", "JJ"], ["statement", "NN"], ["of", "IN"], ["the", "DT"], ["situat