d", "NNP"], ["Printer", "NNP"], [",", ","]]], "people": [], "money": [], "year": "1868", "locations": [], "month": "Nov", "parties": ["Walt", "Whitman"], "properDate": "Nov 25, 1868", "gpe": [], "facility": [], "latlngs": [], "text": "  November 25, 1868                                It suits me first rate the way you have set it up   print 20 copies   give me good clear impressions. ", "dateText": "", "percents": [], "taggedText": [[["November", "NNP"], ["25", "CD"], [",", ","], ["1868", "CD"], ["It", "PRP"], ["suits", "VBZ"], ["me", "PRP"], ["first", "RB"], ["rate", "JJ"], ["the", "DT"], ["way", "NN"], ["you", "PRP"], ["have", "VB"], ["set", "VBN"], ["it", "PRP"], ["up", "RP"], ["print", "VBP"], ["20", "CD"], ["copies", "NNS"], ["give", "VBP"], ["me", "PRP"], ["good", "JJ"], ["clear", "NN"], ["impressions", "NNS"], [".", "."]]], "sentences": ["  November 25, 1868                                It suits me first rate the way you have set it up   print 20 copies   give me good clear impressions. "], "words": ["November", "25", ",", "1868", "It", "suits", "me", "first", "rate", "the", "way", "you", "have", "set", "it", "up", "print", "20", "copies", "give", "me", "good", "clear", "impressions", "."], "date": [], "normalizedTime": "0.442268461852", "recipient": "", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/med.00414.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to an Unidentified Printer ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Ralph", "NNP"], ["Waldo", "NNP"], ["Emerson", "NNP"]], [",", ","]]], "people": ["Dear", "Mr. Emerson", "Mr. Fields", "Mr. Fields", "Walt Whitman"], "money": [], "year": "1868", "locations": [], "month": "Nov", "parties": ["Walt", "Whitman", "Ralph Waldo Emerson"], "properDate": "Nov 30, 1868", "gpe": ["Boston"], "facility": [], "latlngs": [[42.3584308, -71.0597732], [38.8951118, -77.0363658], [41.4036007, -95.0138776]], "text": "  Attorney General's Office                     Washington Nov. 30, 1868.                                  Dear Mr. Emerson:              On the eve of sending the enclosed piece abroad, I have taken a notion to first offer it to                  the Atlantic   and, if not too great a liberty, to solicit your services for that purpose.              I would be much obliged if you would take it in to Mr. Fields the first time you go to Boston   show him this letter   If available at all, I propose it for about the February number of the magazine.                  The price is $100, & 30 copies of the number in which it may be printed   and I will ask Mr. Fields                  to do me the favor to send me an answer within a week from the time he receives the piece   or perhaps he can give his decision at once on receiving it.                  With best respect & love,                 Walt Whitman.              The piece appears in printed form because I have had it put in type for my own convenience,                      and to insure greater correctness   I forgot to say, above, that I scrupulously reserve the                      right to print this piece in future in my book   (which, however, will not be for several months.)                  W. W. ", "dateText": "", "percents": [], "taggedText": [[["Attorney", "NNP"], ["General", "NNP"], ["'s", "POS"], ["Office", "NNP"], [["Washington", "NNP"]], ["Nov.", "NNP"], ["30", "CD"], [",", ","], ["1868", "CD"], [".", "."]], [[["Dear", "NNP"]], [["Mr.", "NNP"], ["Emerson", "NNP"]], [":", ":"], ["On", "IN"], ["the", "DT"], ["eve", "NN"], ["of", "IN"], ["sending", "VBG"], ["the", "DT"], ["enclosed", "VBN"], ["piece", "NN"], ["abroad", "RB"], [",", ","], ["I", "PRP"], ["have", "VBP"], ["taken", "VBN"], ["a", "DT"], ["notion", "NN"], ["to", "TO"], ["first", "JJ"], ["offer", "NN"], ["it", "PRP"], ["to", "TO"], ["the", "DT"], [["Atlantic", "NNP"]], ["and", "CC"], [