, ["book", "NN"], [".", "."]], [["I", "PRP"], ["am", "VBP"], ["closing", "VBG"], ["in", "IN"], ["these", "DT"], ["days", "NNS"], ["my", "PRP$"], ["article", "NN"], ["on", "IN"], ["you", "PRP"], [".", "."]], [["Indeed", "RB"], ["I", "PRP"], ["am", "VBP"], ["too", "RB"], ["much", "RB"], ["occupied", "VBN"], ["with", "IN"], ["you", "PRP"], ["to", "TO"], ["write", "VB"], ["you", "PRP"], ["any", "DT"], ["more", "RBR"], [".", "."]], [["In", "IN"], ["the", "DT"], ["final", "JJ"], ["week", "NN"], ["of", "IN"], ["March", "NNP"], ["I", "NNP"], ["shall", "MD"], ["send", "VB"], ["two", "CD"], ["copies", "NNS"], ["of", "IN"], ["our", "PRP$"], ["February", "NNP"], ["number", "NN"], ["by", "IN"], ["pr", "NN"], ["post", "NN"], [",", ","], ["the", "DT"], ["one", "CD"], ["to", "TO"], ["you", "PRP"], ["in", "IN"], [["New", "NNP"], ["York", "NNP"]], [",", ","], ["the", "DT"], ["other", "JJ"], ["to", "TO"], [["Clausen", "NNP"]], ["in", "IN"], [["Washington", "NNP"]], [".", "."]], [["I", "PRP"], ["wish", "VBP"], ["you", "PRP"], ["good", "JJ"], ["days", "NNS"], ["with", "IN"], ["your", "PRP$"], ["mother", "NN"], [".", "."]], [["Truly", "RB"], ["yours", "VBZ"], [["Rudolf", "NNP"], ["Schmidt", "NNP"]]]], "sentences": ["image 1image 2image 3image 4                                        Fra                     Red.", "af   \ufffdFor Ide og Virkelighed\".", "Kj\u00f8benhavn, d. 27 Feb 1872.", "Dear Mr. Walt Whitman.", "I hereby acknowledge the receipt of your kind letter of 2 Feb, which has been in my hands for some days.", "On the 5th January I duely received all the three parcels    Your letter of 16th January I replied to immediately on the 5th February.", "Of course my letter has gone to Washington.", "The other copy of \"Democratic Vistas,\" [illegible] shall have; but he [illegible] understand                                                     only a very little English.", "If the whole book could be translated into Danish it would fall as a crossing lightning over all the controversies in these northern countries.", "But our democrats   I am ashamed of telling it you!", "are very silly persons   , and our bourgeoisie will not buy the book.", "I am closing in these days my article on you   .", "Indeed I am too much occupied with you to write you any more.", "In the final week of March I shall send two copies of our February number by pr post, the one to you                                                                        in New York, the other to Clausen in Washington.", "I wish you good days with your mother.", "Truly yours                 Rudolf Schmidt              "], "words": ["image", "1image", "2image", "3image", "4", "Fra", "Red.", "af", "\ufffdFor", "Ide", "og", "Virkelighed", "''", ".", "Kj\u00f8benhavn", ",", "d.", "27", "Feb", "1872.", "Dear", "Mr.", "Walt", "Whitman.", "I", "hereby", "acknowledge", "the", "receipt", "of", "your", "kind", "letter", "of", "2", "Feb", ",", "which", "has", "been", "in", "my", "hands", "for", "some", "days.", "On", "the", "5th", "January", "I", "duely", "received", "all", "the", "three", "parcels", "Your", "letter", "of", "16th", "January", "I", "replied", "to", "immediately", "on", "the", "5th", "February.", "Of", "course", "my", "letter", "has", "gone", "to", "Washington.", "The", "other", "copy", "of", "``", "Democratic", "Vistas", ",", "''", "[", "illegible", "]", "shall", "have", ";", "but", "he", "[", "illegible", "]", "understand", "only", "a", "very", "little", "English.", "If", "the", "whole", "book", "could", "be", "translated", "into", "Danish", "it", "would", "fall", "as", "a", "crossing", "lightning", "over", "all", "the", "controversies", "in", "these", "northern", "countries.", "But", "our", "democrats", "I", "am", "ashamed", "of", "telling", "it", "you", "!", "are", "very", "silly", "persons", ",", "and", "our", "bourgeoisie", "will", "not", "buy", "the", "book.", "I", "am", "closing", "in", "these", "days", "my", "article", "on", "you", ".", "Indeed", "I", "am", "too", "much", "occupied", "with", "you", "to", "write", "you", "any", "more.", "In", "the", "final", "week", "of", "March", "I", "shall", "send", "two", "copies", "of", "our", "February", "number", "by", "pr", "post", ",", "the", "one", "to", "you", "in", "New", "York", ",", "the", "other", "to", "Clausen", "in", "Washington.", "I", "wish", "you", "good", "days", "with", "your", "mother.", "Truly", "yours", "Rudolf", "Schmidt"], "date": [], "normalizedTime": "0.603971168231", "recipient": "Walt Whitman", "organizations": ["Democratic Vistas"], "sender": "Schmidt", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/loc.01905.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Rudolf Schmidt to Walt Whitman ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["John", "NNP"], ["Burroughs", "NNP"]], [",", ","]]], "people": ["John", "Chauncey", "Rec", "Wake Robin", "Rossetti", "Woman", "John", "Love", "Walt"], "money": [], "year": "1872", "locations": [], "month": "Mar", "parties": ["Walt", "Whitman", "John Burroughs"], "properDate": "Mar 15, 1872", "gpe": ["Portland", "Brooklyn", "Wash'n", "England"], "facility": [], "latlngs": [[45.5234515, -122.6762071], [40.65, -73.95], [52.3555177, -1.1743197]], "text": "  107 north Portland av.                     Brooklyn, N. Y.                     March 15.                               We have had cold & spiteful weather all the time of my visit here   over a month   & I have not had my usual outdoor enjoyment, loafing about &c   have been indoors most of the time   I also caught cold just on coming here, & it has bothered ever since. How are you, dear friend? & how is 'Sula   dear friend, too   Write me a few lines, John   let me know how Chauncey is getting along   if he finds any difficulty   but I guess not   I guess he is getting along well   Is there any thing new among my friends there in Wash'n? I have got out my new edition, from same plates as the last, only all bound in One Vol.   neatly done in green cloth, vellum   looks the best & most ship-shape of any edition yet   have not added any of my later pieces in this   leaving them to some future issue    Rec'd a letter from Mrs. Gilchrist in England   she has been reading \"Wake Robin\" & takes to it greatly   says Rossetti dined at her house not long since   (You know she is the authoress of the \"Woman's Estimate,\" in the Radical)    John, I think it likely I shall return about the 1st of April   Mother has had a bad spell for three days, but is about as usual again, yesterday & to-day   direct to me here                     Love to all,                 Walt.              ", "dateText": "", "percents": [], "taggedText": [[["107", "CD"], ["north", "JJ"], [["Portland", "NNP"]], ["av", "NN"], [".", "."]], [[["Brooklyn", "NNP"]], [",", ","], ["N.", "NNP"], ["Y", "NNP"], [".", "."]], [["March", "NNP"], ["15", "CD"], [".", "."]], [["We", "PRP"], ["have", "VBP"], ["had", "VBN"], ["cold", "VBN"], ["&", "CC"], ["spiteful", "JJ"], ["weather", "NN"], ["all", "DT"], ["the", "DT"], ["time", "NN"], ["of", "IN"], ["my", "PRP$"], ["visit", "NN"], ["here", "RB"], ["over", "IN"], ["a", "DT"], ["month", "NN"], ["&", "CC"], ["I", "PRP"], ["have", "VBP"], ["not", "RB"], ["had", "VBN"], ["my", "PRP$"], ["usual", "JJ"], ["outdoor", "NN"], ["enjoyment", "NN"], [",", ","], ["loafing", "VBG"], ["about", "IN"], ["&", "CC"], ["c", "NN"], ["have", "VBP"], ["been", "VBN"], ["indoors", "NNS"], ["most", "RBS"], ["of", "IN"], ["the", "DT"], ["time", "NN"], ["I", "PRP"], ["also", "RB"], ["caught", "VBD"], ["cold", "VBN"], ["just", "RB"], ["on", "IN"], ["coming", "VBG"], ["here", "RB"], [",", ","], ["&", "CC"], ["it", "PRP"], ["has", "VBZ"], ["bothered", "VBN"], ["ever", "RB"], ["since", "IN"], [".", "."]], [["How", "WRB"], ["are", "VBP"], ["you", "PRP"], [",", ","], ["dear", "JJ"], ["friend", "NN"], ["?", "."]], [["&", "CC"], ["how", "WRB"], ["is", "VBZ"], ["'Sula", "NNP"], ["dear", "