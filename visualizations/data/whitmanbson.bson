 "money": [], "year": "1868", "locations": [], "month": ")", "parties": ["Walt", "Whitman", "Lewis Wraymond"], "properDate": ") 0, 1868", "gpe": ["Lewy", "Duffy", "Hudson", "Washington", "Bill", "Prodigal"], "facility": [], "latlngs": [[42.2528649, -73.790959], [38.8951118, -77.0363658], [40.907507, -73.896546], [40.907507, -73.896546]], "text": "  Dear Lewy,              I will write you just a line, to let you know I have not forgotten you.                  I am here on leave, & shall stay nearly all this month. Duffy is here,                  driving on Broadway & 5th av. line. He has been up the Hudson river this                  summer driving hotel coach. He is the same old Duffy. I have heard that                  William Sydnor on 65, was laid up sick. I wish to hear about him, & whether he is well,                  & again at work. If you see him, tell him I have not forgot him, but send him                  my love, & will be back in Washington again. Tell Johnny Miller there is                  still a sprinkling of the old Broadway drivers left. Balky Bill, Fred Kelly, Charley McLaughlin, Tom Riley,                  Prodigal, Sandy, &c. &c. are still here. Frank McKinney & several other old                  drivers are with Adams Express. Staging is rather dull.                ", "dateText": "", "percents": [], "taggedText": [[[["Dear", "NNP"]], [["Lewy", "NNP"]], [",", ","], ["I", "PRP"], ["will", "MD"], ["write", "VB"], ["you", "PRP"], ["just", "RB"], ["a", "DT"], ["line", "NN"], [",", ","], ["to", "TO"], ["let", "VB"], ["you", "PRP"], ["know", "VB"], ["I", "PRP"], ["have", "VBP"], ["not", "RB"], ["forgotten", "VBN"], ["you", "PRP"], [".", "."]], [["I", "PRP"], ["am", "VBP"], ["here", "RB"], ["on", "IN"], ["leave", "NN"], [",", ","], ["&", "CC"], ["shall", "MD"], ["stay", "VB"], ["nearly", "RB"], ["all", "DT"], ["this", "DT"], ["month", "NN"], [".", "."]], [[["Duffy", "NNP"]], ["is", "VBZ"], ["here", "RB"], [",", ","], ["driving", "VBG"], ["on", "IN"],