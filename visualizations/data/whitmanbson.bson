me": [], "heading": " Walt Whitman to William D. O'Connor ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Dionysius", "NNP"], ["Thomas", "NNP"]], [",", ","]]], "people": ["Mr. James Gray", "Spruce"], "money": [], "year": "1867", "locations": [], "month": "Oct", "parties": ["Walt", "Whitman", "Dionysius Thomas"], "properDate": "Oct 13, 1867", "gpe": ["Washington", "Grass"], "facility": [], "latlngs": [[38.8951118, -77.0363658]], "text": "  Washington                     Oct. 13                                   Dear Sir:              I write to ask your kind offices in the following described matter: I sent to Doolady six weeks ago an order Mr. James Gray, Bookbinder 16 Spruce st. 14th floor, is the custodian of the sheets                 of my Leaves of Grass, & has been the binder for me. The sheets are now at his                 place. I hear that he has become involved   in fact has failed. If so, I regret it                     much.              I have been waiting now over six weeks for the fulfilment of orders I have sent him                 for bound books   & now, under that state of things, I suppose it will not                 be possible for him to do the work. ", "dateText": "", "percents": [], "taggedText": [[[["Washington", "NNP"]], ["Oct.", "NNP"], ["13", "CD"], ["Dear", "NNP"], ["Sir", "NNP"], [":", ":"], ["I", "PRP"], ["write", "VBP"], ["to", "TO"], ["ask", "VB"], ["your", "PRP$"], ["kind", "NN"], ["offices", "NNS"], ["in", "IN"], ["the", "DT"], ["following", "JJ"], ["described", "VBN"], ["matter", "NN"], [":", ":"], ["I", "PRP"], ["sent", "VBP"], ["to", "TO"], ["Doolady", "NNP"], ["six", "CD"], ["weeks", "NNS"], ["ago", "IN"], ["an", "DT"], ["order", "NN"], [["Mr.", "NNP"], ["James", "NNP"], ["Gray", "NNP"]], [",", ","], [["Bookbinder", "NNP"]], ["16", "CD"], [["Spruce", "NNP"]], ["st.", "NNP"], ["14th", "CD"], ["floor", "NN"], [",", ","], ["is", "VBZ"], ["the", "DT"], ["custodian", "JJ"], ["of", "IN"], ["the", "