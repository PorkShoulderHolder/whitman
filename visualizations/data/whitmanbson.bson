"IN"], [["Mr.", "NNP"], ["Tennyson", "NNP"]], ["has", "VBZ"], ["asked", "VBN"], ["you", "PRP"], ["to", "TO"], ["come", "VB"], ["to", "TO"], ["him", "PRP"], [".", "."]], [["I", "PRP"], ["hope", "VBP"], ["you", "PRP"], ["will", "MD"], ["come", "VB"], [".", "."]], [["And", "CC"], ["if", "IN"], ["to", "TO"], [["England", "NNP"]], ["to", "TO"], [["Ireland", "NNP"]], ["too", "RB"], [".", "."]], [["And", "CC"], ["if", "IN"], ["to", "TO"], [["Ireland", "NNP"]], [",", ","], ["would", "MD"], ["you", "PRP"], ["not", "RB"], ["come", "VBP"], ["to", "TO"], ["this", "DT"], ["house", "NN"], ["if", "IN"], ["you", "PRP"], ["had", "VBD"], ["not", "RB"], ["pleasanter", "JJR"], ["quarters", "NNS"], ["?", "."]], [["Your", "PRP$"], ["welcome", "NN"], [",", ","], ["at", "IN"], ["least", "JJS"], [",", ","], ["would", "MD"], ["be", "VB"], ["very", "RB"], ["sincere", "RB"], [".", "."]], [["Yours", "NNS"], ["very", "RB"], ["truly", "RB"], [["Edward", "NNP"], ["Dowden", "NNP"]], [".", "."]]], "sentences": ["image 1image 2image 3image 4  50 Wellington Road                     Dublin,                     Oct 15, 1871                 My dear Sir,              I ought before now to have thanked you for the poem \"After all, not to create only\",                 which I read with very great interest & pleasure.", "The evening I came to Dublin a                 friend   Todhunter   offered to lend me a copy cut out of a New York                 newspaper, not knowing I had seen it.", "Much work lying before me on my return here                 prevented me from thanking you sooner.", "Probably the Hon.", "Roden Noel, almost certainly Mr Rossetti has sent you a copy of                 this month's \"Dark Blue\"   nevertheless on the chance of your not having seen it                 I post a copy.", "I think you can hardly fail to be pleased with the article upon your poems.", "The essay in the same number                                                                    upon Robert Browning is by Miss West, whom I named to you as one who knew & loved what you have                 written.", "I also send you the first morsel of O'Grady's writing (I named him to you also),                 which has got into print   \"Apollo\".", "You will see, I think, that he springs from                 Carlyle on one side, & from you on the other, & is an aristocratic-democrat                 or democratic aristocrat.", "I do not wholly like \"Apollo\".", "I think he has made Apollo                 (& his English fellow) too idle, a god of glorious play merely, whereas he                 really does each day a good day's joyous work, illuminating the world, & slaying                 Python, & doctoring sick folk in a magnificent                                                                     manner.", "We have heard here that Mr. Tennyson has asked you to come to him.", "I hope you will                 come.", "And if to England   to Ireland too.", "And if to Ireland, would you not come                 to this house if you had not pleasanter quarters?", "Your welcome, at least, would be                 very sincere.", "Yours very truly                 Edward Dowden.              "], "words": ["image", "1image", "2image", "3image", "4", "50", "Wellington", "Road", "Dublin", ",", "Oct", "15", ",", "1871", "My", "dear", "Sir", ",", "I", "ought", "before", "now", "to", "have", "thanked", "you", "for", "the", "poem", "``", "After", "all", ",", "not", "to", "create", "only", "''", ",", "which", "I", "read", "with", "very", "great", "interest", "&", "pleasure.", "The", "evening", "I", "came", "to", "Dublin", "a", "friend", "Todhunter", "offered", "to", "lend", "me", "a", "copy", "cut", "out", "of", "a", "New", "York", "newspaper", ",", "not", "knowing", "I", "had", "seen", "it.", "Much", "work", "lying", "before", "me", "on", "my", "return", "here", "prevented", "me", "from", "thanking", "you", "sooner.", "Probably", "the", "Hon.", "Roden", "Noel", ",", "almost", "certainly", "Mr", "Rossetti", "has", "sent", "you", "a", "copy", "of", "this", "month", "'s", "``", "Dark", "Blue", "''", "nevertheless", "on", "the", "chance", "of", "your", "not", "having", "seen", "it", "I", "post", "a", "copy.", "I", "think", "you", "can", "hardly", "fail", "to", "be", "pleased", "with", "the", "article", "upon", "your", "poems.", "The", "essay", "in", "the", "same", "number", "upon", "Robert", "Browning", "is", "by", "Miss", "West", ",", "whom", "I", "named", "to", "you", "as", "one", "who", "knew", "&", "loved", "what", "you", "have", "written.", "I", "also", "send", "you", "the", "first", "morsel", "of", "O'Grady", "'s", "writing", "(", "I", "named", "him", "to", "you", "also", ")", ",", "which", "has", "got", "into", "print", "``", "Apollo", "''", ".", "You", "will", "see", ",", "I", "think", ",", "that", "he", "springs", "from", "Carlyle", "on", "one", "side", ",", "&", "from", "you", "on", "the", "other", ",", "&", "is", "an", "aristocratic-democrat", "or", "democratic", "aristocrat.", "I", "do", "not", "wholly", "like", "``", "Apollo", "''", ".", "I", "think", "he", "has", "made", "Apollo", "(", "&", "his", "English", "fellow", ")", "too", "idle", ",", "a", "god", "of", "glorious", "play", "merely", ",", "whereas", "he", "really", "does", "each", "day", "a", "good", "day", "'s", "joyous", "work", ",", "illuminating", "the", "world", ",", "&", "slaying", "Python", ",", "&", "doctoring", "sick", "folk", "in", "a", "magnificent", "manner.", "We", "have", "heard", "here", "that", "Mr.", "Tennyson", "has", "asked", "you", "to", "come", "to", "him.", "I", "hope", "you", "will", "come.", "And", "if", "to", "England", "to", "Ireland", "too.", "And", "if", "to", "Ireland", ",", "would", "you", "not", "come", "to", "this", "house", "if", "you", "had", "not", "pleasanter", "quarters", "?", "Your", "welcome", ",", "at", "least", ",", "would", "be", "very", "sincere.", "Yours", "very", "truly", "Edward", "Dowden", "."], "date": [], "normalizedTime": "0.585611315109", "recipient": "Walt Whitman", "organizations": ["Hon"], "sender": "Dowden", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/loc.01490.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Edward Dowden to Walt Whitman ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], ["an", "DT"], ["Unidentified", "NNP"], ["Correspondent", "NNP"], [",", ","]]], "people": ["Dear", "Dion Thomas", "Fulton st.", "Walt Whitman"], "money": [], "year": "1871", "locations": [], "month": "Oct", "parties": ["Walt", "Whitman"], "properDate": "Oct 17, 1871", "gpe": ["Washington", "Nassau", "Broadway"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [25.06, -77.345], [40.907507, -73.896546]], "text": "image 1image 2image 3image 4  Washington,                     Oct. 17, 1871.                                  Dear Sir:              In answer to your letter of September 5, (I beg pardon for not replying to it before,) I have to inform you that some time ago Dion Thomas, bookseller, 2d story, Fulton st. north side, about midway bet. Nassau and Broadway, had some copies of 1st edition Leaves of Grass   but whether he still has them to sell I cannot say    I can procure you of the artist a good photograph,   the price is $1.  Walt Whitman.  The last edition of my poems complete I publish & sell myself. ", "dateText": "", "percents": [], "taggedText": [[["image", "NN"], ["1image", "NN"], ["2image", "NN"], ["3image", "NN"], ["4", "CD"], [["Washington", "NNP"]], [",", ","], ["Oct.", "NNP"], ["17", "CD"], [",", ","], ["1871", "CD"], [".", "."]], [[["Dear", "NNP"]], ["Sir", "NNP"], [":", ":"], ["In", "NNP"], ["answer", "NN"], ["to", "TO"], ["your", "PRP$"], ["letter", "NN"], ["of", "IN"], ["September", "NNP"], ["5", "CD"], [",", ","], ["(", "NNP"], ["I", "PRP"], ["beg", "VBP"], ["pardon", "JJ"], ["for", "IN"], ["not", "RB"], ["replying", "VBG"], ["to", "TO"], ["it", "PRP"], ["before", "IN"], [",", ","], [")", ":"], ["I", "PRP"], ["have", "VBP"], ["to", "TO"], ["inform", "VB"], ["you", "PRP"], ["that", "IN"], ["some", "DT"], ["time", "NN"], ["ago", "RB"], [["Dion", "NNP"], ["Thomas", "NNP"]], [",", ","], ["bookseller", "NN"], [",", ","], ["2d", "CD"], ["story", "NN"], [",", ","], [["Fulton", "NNP"], ["st.", "NNP"]], ["north", "NN"], ["side", "NN"], [",", ","], ["about", "IN"], ["midway", "NN"], ["bet", "NN"], [".", "."]], [[["Nassau", "NNP"]], ["and", "CC"], [["Broadway", "NNP"]], [",", ","], ["had", "VBD"], ["some", "DT"], ["copies", "NNS"], ["of", "IN"], ["1st", "CD"], ["edition", "NN"], ["Leaves", "NNS"], ["of", "IN"], ["Grass", "NNP"], ["but", "CC"], ["whether", "IN"], ["he", "PRP"], ["still", "RB"], ["has", "VBZ"], ["them", "PRP"], ["to", "TO"], ["sell", "VB"], ["I", "PRP"], ["can", "MD"], ["not", "RB"], ["say", "VB"], ["I", "PRP"], ["can", "MD"], ["procure", "VB"], ["you", "PRP"], ["of", "IN"], ["the", "DT"], ["artist", "NN"], ["a", "DT"], ["good", "JJ"], ["photograph", "NN"], [",", ","], ["the", "DT"], ["price", "NN"], ["is", "VBZ"], ["$", "$"], ["1", "CD"], [".", "."]], [[["Walt", "NNP"], ["Whitman", "NNP"]], [".", "."]], [["The", "DT"], ["last", "JJ"], ["edition", "NN"], ["of", "IN"], ["my", "PRP$"], ["poems", "NNS"], ["complete", "VBP"], ["I", "PRP"], ["publish", "VBP"], ["&", "CC"], ["sell", "NN"], ["myself", "PRP"], [".", "."]]], "sentences": ["image 1image 2image 3image 4  Washington,                     Oct. 17, 1871.", "Dear Sir:              In answer to your letter of September 5, (I beg pardon for not replying to it before,) I have to inform you that some time ago Dion Thomas, bookseller, 2d story, Fulton st. north side, about midway bet.", "Nassau and Broadway, had some copies of 1st edition Leaves of Grass   but whether he still has them to sell I cannot say    I can procure you of the artist a good photograph,   the price is $1.", "Walt Whitman.", "The last edition of my poems complete I publish & sell myself. "], "words": ["image", "1image