e", "before", "long", ",", "if", "only", "for", "six", "or", "eight", "days.", "I", "wish", "to", "see", "you", ",", "&", "Andrew", "I", "wish", "to", "see", "the", "young", "ones", "&", "Mat.", "You", "must", "write.", "I", "am", "about", "moving,6", "I", "have", "been", "hunting", "for", "a", "room", "to-day", "I", "shall", "write", "next", "how", "I", "succeed.", "Good", "by", "for", "present", ",", "dear", "mother.", "Walt"], "date": [], "normalizedTime": "0.187950496396", "recipient": "Louisa Van Velsor Whitman", "organizations": ["Union"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00798.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to Louisa Van Velsor Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["James", "NNP"], ["Redpath", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["James Redpath"], "money": [], "year": "1863", "locations": [], "month": "Oct", "parties": ["James Redpath", "Walt Whitman"], "properDate": "Oct 14, 1863", "gpe": ["Boston", "Glad"], "facility": [], "latlngs": [[42.3584308, -71.0597732]], "text": "  Boston, Oct 14, 1863  Walt Whitman Dear Friend    About the Book   yes, if I can. I wd like to have it sent on & I will see what I can do about it. Dependent on others for capital, I can't answer any questions of will you publish? right off either yes or no. Glad to know you are now in good running trim; I will do all I can here, in one direction, to keep you supplied with funds.  You[illegible] [illegible] James Redpath  ", "dateText": "", "percents": [], "taggedText": [[[["Boston", "NNP"]], [",", ","], ["Oct", "NNP"], ["14", "CD"], [",", ","], ["1863", "CD"], ["Walt", "NNP"], ["Whitman", "NNP"], ["Dear", "NNP"], ["Friend", "NNP"], ["About", "NNP"], ["the", "DT"], [["Book", "NNP"]], ["yes", "VBZ"], [",", ","], ["if", "IN"], ["I", "PRP"], ["can", "MD"], [".", "."]], [["I", "PRP"], ["wd", "VBD"], ["like", "IN"], ["to", "TO"], ["have", "VB"], ["it", "PRP"], ["sent", "VBN"], ["on", "IN"], ["&", "CC"], ["I", "PRP"], ["will", "MD"], ["see", "VB"], ["what", "WP"], ["I", "PRP"], ["can", "MD"], ["do", "VB"], ["about", "RB"], ["it", "PRP"], [".", "."]], [["Dependent", "NNP"], ["on", "IN"], ["others", "NNS"], ["for", "IN"], ["capital", "NN"], [",", ","], ["I", "PRP"], ["ca", "MD"], ["n't", "RB"], ["answer", "VB"], ["any", "DT"], ["questions", "NNS"], ["of", "IN"], ["will", "MD"], ["you", "PRP"], ["publish", "VB"], ["?", "."]], [["right", "RB"], ["off", "IN"], ["either", "DT"], ["yes", "NNS"], ["or", "CC"], ["no", "DT"], [".", "."]], [[["Glad", "NNP"]], ["to", "TO"], ["know", "VB"], ["you", "PRP"], ["are", "VBP"], ["now", "RB"], ["in", "IN"], ["good", "JJ"], ["running", "NN"], ["trim", "NN"], [";", ":"], ["I", "PRP"], ["will", "MD"], ["do", "VB"], ["all", "PDT"], ["I", "PRP"], ["can", "MD"], ["here", "RB"], [",", ","], ["in", "IN"], ["one", "CD"], ["direction", "NN"], [",", ","], ["to", "TO"], ["keep", "VB"], ["you", "PRP"], ["supplied", "VBD"], ["with", "IN"], ["funds", "NNS"], [".", "."]], [["You", "PRP"], ["[", "VBP"], ["illegible", "JJ"], ["]", "NN"], ["[", ":"], ["illegible", "JJ"], ["]", "NN"], [["James", "NNP"], ["Redpath", "NNP"]]]], "sentences": ["  Boston, Oct 14, 1863  Walt Whitman Dear Friend    About the Book   yes, if I can.", "I wd like to have it sent on & I will see what I can do about it.", "Dependent on others for capital, I can't answer any questions of will you publish?", "right off either yes or no.", "Glad to know you are now in good running trim; I will do all I can here, in one direction, to keep you supplied with funds.", "You[illegible] [illegible] James Redpath  "], "words": ["Boston", ",", "Oct", "14", ",", "1863", "Walt", "Whitman", "Dear", "Friend", "About", "the", "Book", "yes", ",", "if", "I", "can.", "I", "wd", "like", "to", "have", "it", "sent", "on", "&", "I", "will", "see", "what", "I", "can", "do", "about", "it.", "Dependent", "on", "others", "for", "capital", ",", "I", "ca", "n't", "answer", "any", "questions", "of", "will", "you", "publish", "?", "right", "off", "either", "yes", "or", "no.", "Glad", "to", "know", "you", "are", "now", "in", "good", "running", "trim", ";", "I", "will", "do", "all", "I", "can", "here", ",", "in", "one", "direction", ",", "to", "keep", "you", "supplied", "with", "funds.", "You", "[", "illegible", "]", "[", "illegible", "]", "James", "Redpath"], "date": [], "normalizedTime": "0.188086495308", "recipient": "Walt Whitman", "organizations": ["Book"], "sender": "James Redpath", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/yal.00103.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from James Redpath to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Thomas", "NNP"], ["Jefferson", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Mother", "Mother", "Mat", "Andrew", "Dear", "Andrew", "Andrew", "Andrew", "Andrew", "Andrew", "Andrew alive.5", "Mother", "Mother", "Jeff"], "money": [], "year": "1863", "locations": [], "month": "Oct", "parties": ["Thomas Jefferson Whitman", "Walt Whitman"], "properDate": "Oct 15, 1863", "gpe": ["Brooklyn"], "facility": [], "latlngs": [[40.65, -73.95]], "text": "  Brooklyn Oct 15th 1863 Dear Walt, Mother received a letter from you yesterday1  I got one the day before.2 Mother did not let me see her letter3 but Mat says that she understands that you say that you think about coming home. I hope dear Walt, that you will come and that soon  I think if you should come just now you might be able to do Andrew considerable good  He is in a very bad way and I really fear, under the present circumstances that he will not last long. Dear Walt I wish that I could do something more for Andrew, but I have to work all the time, almost day and night and another thing I think he would be guided more by your advice than any one elses  That damed infernal robber the doctor4 that he has been with (Andrew has paid him $95 and been getting worse all the time) told Andrew yesterday that he must not come there again till he brought him $45 more. Only think of it. The infernal son of a bitch. I would like to hang him for a thousand years, ten times a second. I dont care anything about it for the good that I think that he could do Andrew but that he Andrew thinks that perhaps if he could pay him $45 he could do something for him. The very fact that the scoundrel wants the money in advance is enough  Dear Walt do come home if only for a short time  And unless you come quite soon you certainly will never see Andrew alive.5 Will you write me at once if you can come. Mother Mat and Sis are all suffering from bad colds, Mother particularly I think is failing rapidly. I do so wish that I could see you and have a good talk abt family affairs  I am in an awful hurry or would write more. To day I have to go through the whole line of conduit Jeff", "dateText": "", "percents": [], "taggedText": [[[["Brooklyn", "NNP"]], ["Oct", "NNP"], ["15th", "CD"], ["1863", "CD"], ["Dear", "NNP"], ["Walt", "NNP"], [",", ","], [["Mother", "NNP"]], ["received", "VBD"], ["a", "DT"], ["letter", "NN"], ["from", "IN"], ["you", "PRP"], ["yesterday1", "NNP"], ["I", "PRP"], ["got", "VBD"], ["one", "CD"], ["the", "DT"], ["day", "NN"], ["before.2", "-NONE-"], [["Mother", "NNP"]], ["did", "VBD"], ["not", "RB"], ["let", "VB"], ["me", "PRP"], ["see", "VB"], ["her", "PRP"], ["letter3", "NNP"], ["but", "CC"], [["Mat", "NNP"]], ["says", "VBZ"], ["that", "IN"], ["she", "PRP"], ["understands", "VBZ"], ["that", "IN"], ["you", "PRP"], ["say", "VBP"], ["that", "IN"], ["you", "PRP"], ["think", "VBP"], ["about", "IN"], ["coming", "VBG"], ["home", "NN"], [".", "."]], [["I", "PRP"], ["hope", "VBP"], ["dear", "JJ"], ["Walt", "NNP"], [",", ","], ["that", "IN"], ["you", "PRP"], ["will", "MD"]