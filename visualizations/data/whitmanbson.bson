: ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to John M. Binckley ,"}, {"taggedHeading": [[[["Francis", "NNP"]], ["P.", "NNP"], ["Church", "NNP"], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Monthly", "Sir", "Young", "Church Mr. Walt Whitman"], "money": [], "year": "1867", "locations": ["Carol"], "month": "Sep", "parties": ["Francis", "Walt Whitman"], "properDate": "Sep 4, 1867", "gpe": ["New York", "Very"], "facility": ["Park Row"], "latlngs": [[40.7143528, -74.00597309999999], [38.4697378, -101.7526723]], "text": "image 1image 2image 3image 4image 5image 6                   An Illustrated Magazine of Entertaining Reading.                 Published Monthly                                      OFFICE OF THE GALAXY                     No. 39 Park Row,                                                       New York,                      Sept 4 1867                                      My dear Sir:              I spoke to Mr. [Young?]                 about the Tribune's treatment of the Carol. He said it occurred during his absence                 & that he could gladly make on his own account the necessary correction &                 explanation. Enclosed I send a check for the poem.                  Very truly yours                 F. P. Church                 Mr. Walt Whitman              ", "dateText": "", "percents": [], "taggedText": [[["image", "NN"], ["1image", "NN"], ["2image", "NN"], ["3image", "NN"], ["4image", "NN"], ["5image", "NN"], ["6", "CD"], ["An", "DT"], [["Illustrated", "NNP"], ["Magazine", "NNP"]], ["of", "IN"], ["Entertaining", "NNP"], ["Reading", "NNP"], [".", "."]], [["Published", "JJ"], [["Monthly", "NNP"]], ["OFFICE", "NNP"], ["OF", "NNP"], ["THE", "NNP"], [["GALAXY", "NNP"], ["No", "NNP"]], [".", "."]], [["39", "CD"], [["Park", "NNP"], ["Row", "NNP"]], [",", ","], [["New", "NNP"], ["York", "NNP"]], [",", ","], ["Sept", "NNP"], ["4", "CD"], ["1867", "CD"], ["My", "NNP"], ["dear", "NN"], [["Sir", "NNP"]], [":", ":"], ["I", "PRP"], ["spoke", "VBP"], ["to", "TO"], ["Mr", "NNP"], [".", "."]], [["[", "NN"], [["Young", "NNP"]], ["?", "."]], [["]", "NN"], ["about", "IN"], ["the", "DT"], [["Tribune", "NNP"]], ["'s", "POS"], ["treatment", "NN"], ["of", "IN"], ["the", "DT"], [["Carol", "NNP"]], [".", "."]], [["He", "PRP"], ["said", "VBD"], ["it", "PRP"], ["occurred", "VBD"], ["during", "IN"], ["his", "PRP$"], ["absence", "NN"], ["&", "CC"], ["that", "IN"], ["he", "PRP"], ["could", "MD"], ["gladly", "RB"], ["make", "VB"], ["on", "IN"], ["his", "PRP$"], ["own", "JJ"], ["account", "NN"], ["the", "DT"], ["necessary", "JJ"], ["correction", "NN"], ["&", "CC"], ["explanation", "NN"], [".", "."]], [["Enclosed", "VBN"], ["I", "PRP"], ["send", "VBP"], ["a", "DT"], ["check", "NN"], ["for", "IN"], ["the", "DT"], ["poem", "NN"], [".", "."]], [[["Very", "NNP"]], ["truly", "RB"], ["yours", "VBZ"], ["F.", "NNP"], ["P.", "NNP"], [["Church", "NNP"], ["Mr.", "NNP"], ["Walt", "NNP"], ["Whitman", "NNP"]]]], "sentences": ["image 1image 2image 3image 4image 5image 6                   An Illustrated Magazine of Entertaining Reading.", "Published Monthly                                      OFFICE OF THE GALAXY                     No.", "39 Park Row,                                                       New York,                      Sept 4 1867                                      My dear Sir:              I spoke to Mr.", "[Young?", "]                 about the Tribune's treatment of the Carol.", "He said it occurred during his absence                 & that he could gladly make on his own account the necessary correction &                 explanation.", "Enclosed I send a check for the poem.", "Very truly yours                 F. P. Church                 Mr. Walt Whitman              "], "words": ["image", "1image", "2image", "3image", "4image", "5image", "6", "An", "Illustrated", "Magazine", "of", "Entertaining", "Reading.", "Published", "Monthly", "OFFICE", "OF", "THE", "GALAXY", "No.", "39", "Park", "Row", ",", "New", "York", ",", "Sept", "4", "1867", "My", "dear", "Sir", ":", "I", "spoke", "to", "Mr.", "[", "Young", "?", "]", "about", "the", "Tribune", "'s", "treatment", "of", "the", "Carol.", "He", "said", "it", "occurred", "during", "his", "absence", "&", "that", "he", "could", "gladly", "make", "on", "his", "own", "account", "the", "necessary", "correction", "&", "explanation.", "Enclosed", "I", "send", "a", "check", "for", "the", "poem.", "Very", "truly", "yours", "F.", "P.", "Church", "Mr.", "Walt", "Whitman"], "date": [], "normalizedTime": "0.381340949272", "recipient": "Walt Whitman", "organizations": ["Illustrated Magazine", "GALAXY No", "Tribune"], "sender": "Francis", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/loc.01281.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Francis P. Church to Walt Whitman ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["William", "NNP"], ["C.", "NNP"], ["Church", "NNP"]], ["and", "CC"], [["Francis", "NNP"], ["P.", "NNP"], ["Church", "NNP"]], [",", ","]]], "people": ["Ethiopia Commenting", "Carlyle", "Walt Whitman"], "money": [], "year": "1867", "locations": [], "month": "Sep", "parties": ["Walt", "Whitman", "William C. Church", "Francis P. Church"], "properDate": "Sep 7, 1867", "gpe": ["Washington", "Church", "Please", "Galaxy", "Please", "Brooklyn"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [40.65, -73.95]], "text": "  Washington, September 7, 1867.                  W.C. & F.P. Church.                                  Gentlemen:              The check for $60. arrived safely this morning. Please consider this a receipt                 for said sum.              I received, some ten days since, the six proof-impressions of the Carol   & am much obliged. (No copies of magazine.) I forward herewith another poem for the Galaxy. If acceptable,                 please, after correcting, let me have a good proof in time. The right of publishing Ethiopia Commenting, in                 future book, is reserved to me. The price of the piece is $25. I have, in composition, an article, (prose,) of some length   the subject                 opportune   I shall probably name it Democracy. It is                 partly provoked by, & in some respects a rejoinder to, Carlyle's Shooting Niagara. I think it might be                 specially appropriate to your purposes & scope. I would propose it to you for a                 leading article for January '68 Galaxy. Please write me how                 the idea suits you. Or, as I am coming to Brooklyn in a few days, perhaps I may as                 well call personally, & get your notions about it.  Walt Whitman.              ", "dateText": "", "percents": [], "taggedText": [[[["Washington", "NNP"]], [",", ","], ["September", "NNP"], ["7", "CD"], [",", ","], ["1867", "CD"], [".", "."]], [["W.C.", "NNP"], ["&", "CC"], ["F.P", "NNP"], [".", "."]], [[["Church", "NNP"]], [".", "."]], [["Gentlemen", "NNS"], [":", ":"], ["The", "DT"], ["check", "NN"], ["for", "IN"], ["$", "$"], ["60", "CD"], [".", "."]], [["arrived", "VBD"], ["safely", "RB"], ["this", "DT"], ["morning", "NN"], [".", "."]], [[["Please", "NN"]], ["consider", "NN"], ["this", "DT"], ["a", "DT"], ["receipt", "NN"], ["for", "IN"], ["said", "VBD"], ["sum", "NN"], [".", "."]], [["I", "PRP"], ["received", "VBD"], [",", ","], ["some", "DT"], ["ten", "NN"], ["days", "NNS"], ["since", "IN"], [",", ","], ["the", "DT"], ["six", "CD"], ["proof-impressions", "NNS"], ["of", "IN"], ["the", "DT"], [["Carol", "NNP"]], ["&", "CC"], ["am", "NN"], ["much", "RB"], ["obliged", "VBD"], [".", "."]], [["(", "NN"], ["No", "DT"], ["copies", "NNS"], ["of", "IN"], ["magazine", "NN"], [".", "."]], [[")", "NN"], ["I", "PRP"], ["forward", "RB"], ["herewith", "IN"], ["another", "DT"], ["poem", "NN"], ["for", "IN"], ["the", "DT"], [["Galaxy", "NNP"]], [".", "."]], [["If", "IN"], ["accep