, [".", "."]], [["It", "PRP"], ["is", "VBZ"], ["very", "RB"], ["easy", "JJ"], ["6", "CD"], ["or", "CC"], ["8", "CD"], ["trains", "NNS"], ["fro", "NN"], ["&", "CC"], ["to", "TO"], ["N.", "NNP"], ["Y.", "NNP"], ["every", "DT"], ["day", "NN"], ["&", "CC"], ["night", "NN"], [".", "."]], [["Come", "NNP"], ["either", "RB"], ["by", "IN"], ["boat", "JJ"], ["to", "TO"], [["Amboy", "NNP"]], [",", ","], ["&", "CC"], ["so", "RB"], ["directly", "RB"], ["here", "RB"], ["to", "TO"], [["Camden", "NNP"]], ["depot", "NN"], [",", ","], ["(", ":"], ["only", "RB"], ["60", "CD"], ["rods", "NNS"], ["from", "IN"], ["this", "DT"], ["house", "NN"], [",", ","], [")", ":"], ["or", "CC"], ["from", "IN"], [["Jersey", "NNP"], ["City", "NNP"]], ["to", "TO"], [["West", "NNP"], ["Philadelphia", "NNP"]], ["depot", "NN"], [",", ","], ["&", "CC"], ["so", "RB"], ["down", "IN"], [["Market", "NNP"], ["st.", "NNP"]], ["by", "IN"], ["horse", "NN"], ["cars", "NNS"], ["to", "TO"], [["Camden", "NNP"]], ["ferry", "NN"], ["at", "IN"], ["foot", "NN"], ["of", "IN"], ["it", "PRP"], [".", "."]], [["I", "PRP"], ["am", "VBP"], ["about", "IN"], ["the", "DT"], ["same", "JJ"], [".", "."]], [[["Jeff", "NNP"]], ["is", "VBZ"], ["here", "RB"], ["with", "IN"], ["me", "PRP"], ["(", ":"], ["from", "IN"], [["St.", "NNP"]], ["Louis", "NNP"], [")", "NNP"], ["for", "IN"], ["a", "DT"], ["couple", "NN"], ["of", "IN"], ["days", "NNS"], [".", "."]], [["W.", "NNP"], ["W", "NNP"], [".", "."]]], "sentences": ["  431 Stevens st. cor West.", "Camden, N. Jersey.", "June 24.", "Your good letter rec'd this morning.", "Come & see me whenever you can.", "It is very easy   6 or 8          trains fro & to N. Y. every day & night.", "Come either by boat to Amboy, & so directly here to          Camden depot, (only 60 rods from this house,) or from Jersey City to West Philadelphia depot,          & so down Market st. by horse cars to Camden ferry at foot of it.", "I am about the same.", "Jeff is here with me (from St. Louis) for a couple of days.", "