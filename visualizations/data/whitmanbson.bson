"], [",", ","], ["presented", "VBD"], ["by", "IN"], [["Hon", "NNP"]], [".", "."]], [[["Mr.", "NNP"], ["Cavanaugh", "NNP"]], [",", ","], ["making", "VBG"], ["grave", "NN"], ["charges", "NNS"], ["against", "IN"], ["Judge", "NNP"], [["Lyman", "NNP"], ["E.", "NNP"], ["Munson", "NNP"]], [",", ","], [["Associate", "NNP"], ["Justice", "NNP"]], [",", ","], [["U.S.", "NNP"]], ["Courts", "NNPS"], ["of", "IN"], [["Montana", "NNP"], ["Territory", "NNP"]], ["&", "CC"], ["have", "VBP"], ["prepared", "VBN"], ["the", "DT"], ["following", "JJ"], ["abridgement", "NN"], ["&", "CC"], ["abstract", "NN"], ["of", "IN"], ["said", "VBN"], ["papers", "NNS"], [".", "."]], [[["Very", "NNP"]], ["respectfully", "RB"], [",", ","], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","], ["of", "IN"], ["A.", "NNP"], ["G.", "NNP"], ["office", "NN"], [".", "."]]], "sentences": ["  Attorney General's Office, Washington, April 7, 1868.", "Hon.", "O. H. Browning,                                  Attorney General, ad interim Sir:              In obedience to your request, I have carefully examined the papers, presented by Hon.", "Mr. Cavanaugh, making grave charges against Judge                 Lyman E. Munson, Associate Justice, U.S. Courts of Montana Territory   &                 have prepared the following abridgement & abstract of said papers.", "Very respectfully,                 Walt Whitman, of A. G. office.              "], "words": ["Attorney", "General", "'s", "Office", ",", "Washington", ",", "April", "7", ",", "1868.", "Hon.", "O.", "H.", "Browning", ",", "Attorney", "General", ",", "ad", "interim", "Sir", ":", "In", "obedience", "to", "your", "request", ",", "I", "have", "carefully", "examined", "the", "papers", ",", "presented", "by", "Hon.", "Mr.", "Cavanaugh", ",", "making", "grave", "charges", "against", "Judge", "Lyman", "E.", "Munson", ",", "Associate", "Justice", ",", "U.S.", "Courts", "of", "Montana", "Territory", "&", "have", "prepared", "the", "following", "abridgement", "&", "abstract", "of", "said", "papers.", "Very", "respectfully", ",", "Walt", "Whitman", ",", "of", "A.", "G.", "office", "."], "date": [], "normalizedTime": "0.410716714266", "recipient": "Orville Hickman Browning", "organizations": ["Associate Justice"], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/ucl.00002.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Orville Hickman Browning ,"}, {"taggedHeading": [[[["John", "NNP"]], [["Camden", "NNP"], ["Hotten", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Mr. Moncure Conway", "Mr.", "Swinburne", "John Camden Hotten", "John Bright"], "money": [], "year": "1868", "locations": [], "month": "Apr", "parties": ["John", "Camden Hotten", "Walt Whitman"], "properDate": "Apr 8, 1868", "gpe": ["English", "America", "Pray"], "facility": [], "latlngs": [[38.0332695, -78.5059101]], "text": "image 1image 2image 3image 4                                        74 & 75 Piccadilly W                                                       London                      8 Ap. 1868                                  Dear Sir:              I am in receipt of your kind letter. The portrait of yourself we have given in the English Edition of \"Poems\" will be superseded by one from the very fine photograph wch Mr. Moncure Conway has lent me to be engraved. Should our second attempt not be satisfactory, I will cheerfully avail my self of your offer. Mr. Swinburne was very pleased to hear that his mention of                                                     yourself and literary labours had given satisfaction. He is now busy upon \"Bothwell\"   a new poem wch may be regarded as a sequel to his \"Chastelard\". I am a little puzzled as to a good agent for the sale of our English selection from                 your \"Poems\" in America. Any suggestions you may make will be thankfully                 received. Pray excuse the hasty scrawl   hasty to catch the post.                  Yrs very truly                 John Camden Hotten                              W. Whitman  \ufffd\ufffd You will have received some newspaper notices of the English Edition by this time I posted them a few days since. Enclosed is from John Bright's paper ", "dateText": "", "percents": [], "taggedText": [[["image", "NN"], ["1image", "NN"], ["2image", "NN"], ["3image", "NN"], ["4", "CD"], ["74", "CD"], ["&", "CC"], ["75", "CD"], ["Piccadilly", "NNP"], ["W", "NNP"], ["London", "NNP"], ["8", "CD"], ["Ap", "NNP"], [".", "."]], [["1868", "CD"], ["Dear", "NNP"], ["Sir", "NNP"], [":", ":"], ["I", "PRP"], ["am", "VBP"], ["in", "IN"], ["receipt", "NN"], ["of", "IN"], ["your", "PRP$"], ["kind", "NN"], ["letter", "NN"], [".", "."]], [["The", "DT"], ["portrait", "NN"], ["of", "IN"], ["yourself", "PRP"], ["we", "PRP"], ["have", "VBP"], ["given", "VBN"], ["in", "IN"], ["the", "DT"], [["English", "NNP"], ["Edition", "NNP"]], ["of", "IN"], ["``", "``"], ["Poems", "NNS"], ["''", "''"], ["will", "MD"], ["be", "VB"], ["superseded", "VBN"], ["by", "IN"], ["one", "CD"], ["from", "IN"], ["the", "DT"], ["very", "JJ"], ["fine", "NN"], ["photograph", "NN"], ["wch", "NN"], [["Mr.", "NNP"], ["Moncure", "NNP"], ["Conway", "NNP"]], ["has", "VBZ"], ["lent", "VBN"], ["me", "PRP"], ["to", "TO"], ["be", "VB"], ["engraved", "VBN"], [".", "."]], [["Should", "MD"], ["our", "PRP$"], ["second", "JJ"], ["attempt", "NN"], ["not", "RB"], ["be", "VB"], ["satisfactory", "JJ"], [",", ","], ["I", "PRP"], ["will", "MD"], ["cheerfully", "RB"], ["avail", "VB"], ["my", "PRP$"], ["self", "NN"], ["of", "IN"], ["your", "PRP$"], ["offer", "NN"], [".", "."]], [[["Mr.", "NNP"]], [["Swinburne", "NNP"]], ["was", "VBD"], ["very", "RB"], ["pleased", "VBN"], ["to", "TO"], ["hear", "VB"], ["that", "IN"], ["his", "PRP$"], ["mention", "NN"], ["of", "IN"], ["yourself", "PRP"], ["and", "CC"], ["literary", "JJ"], ["labours", "NNS"], ["had", "VBD"], ["given", "VBN"],