$"], ["idea", "NN"], ["is", "VBZ"], ["that", "IN"], [["Matty", "NNP"]], ["has", "VBZ"], ["the", "DT"], ["possibilities", "NNS"], ["of", "IN"], ["consumption", "NN"], ["in", "IN"], ["her", "PRP$"], ["system", "NN"], ["but", "CC"], ["that", "IN"], ["with", "IN"], ["ordinary", "JJ"], ["good", "JJ"], ["luck", "NN"], [",", ","], ["she", "PRP"], ["can", "MD"], ["&", "CC"], ["will", "MD"], ["get", "VB"], ["over", "IN"], ["it", "PRP"], [".", "."]], [["She", "PRP"], ["has", "VBZ"], ["good", "JJ"], ["spirits", "NNS"], [",", ","], ["is", "VBZ"], ["very", "RB"], ["comfortably", "RB"], ["situated", "VBN"], ["has", "VBZ"], ["a", "DT"], ["good", "JJ"], [",", ","], ["cheerfull", "JJ"], [",", ","], ["warm", "NN"], ["room", "NN"], [",", ","], ["with", "IN"], ["southern", "JJ"], ["exposure", "NN"], ["has", "VBZ"], ["a", "DT"], ["good", "JJ"], ["stove", "NN"], [",", ","], ["gas", "NN"], [",", ","], ["&", "CC"], ["c", "NN"], ["Upon", "NNP"], ["the", "DT"], ["whole", "JJ"], [",", ","], ["as", "IN"], ["to", "TO"], ["personal", "JJ"], ["surroundings", "NNS"], [",", ","], ["&", "CC"], ["c", "NN"], ["she", "PRP"], ["could", "MD"], ["not", "RB"], ["be", "VB"], ["happier", "JJR"], ["in", "IN"], ["them", "PRP"], ["for", "IN"], [["Mother", "NNP"]], [",", ","], ["&", "CC"], [["George", "NNP"]], [",", ","], ["&", "CC"], ["Ed", "NNP"], ["too", "RB"], [",", ","], ["think", "VBP"], ["&", "CC"], ["do", "VBP"], ["every", "DT"], ["thing", "NN"], ["that", "WDT"], ["the", "DT"], ["tenderest", "JJS"], ["mother", "NN"], ["&", "CC"], ["brothers", "NNS"], ["could", "MD"], ["George", "VB"], ["is", "VBZ"], ["very", "RB"], ["kind", "JJ"], ["Mat", "NNP"], ["realizes", "VBZ"], ["it", "PRP"], ["all", "DT"], ["perfectly", "RB"], [",", ","], ["&", "CC"], ["is", "VBZ"], ["herself", "PRP"], ["very", "RB"], ["kind", "JJ"], ["&", "CC"], ["affectionate", "JJ"], ["as", "IN"], ["indeed", "RB"], ["she", "PRP"], ["always", "RB"], ["was", "VBD"], [".", "."]], [[["Mother", "NNP"]], ["&", "CC"], ["all", "DT"], ["wish", "NN"], ["you", "PRP"], ["to", "TO"], ["arrange", "VB"], ["without", "IN"], ["fail", "NN"], ["to", "TO"], ["come", "VB"], ["on", "IN"], [",", ","], ["on", "IN"], ["or", "CC"], ["before", "IN"], ["1st", "CD"], ["December", "NNP"], ["before", "IN"], [",", ","], ["if", "IN"], ["convenient", "JJ"], ["Mother", "NNP"], ["is", "VBZ"], ["well", "RB"], [",", ","], ["but", "CC"], ["shows", "VBZ"], ["her", "PRP$"], ["old", "JJ"], ["age", "NN"], ["more", "RBR"], ["&", "CC"], ["more", "RBR"], [".", "."]], [["I", "PRP"], ["return", "VBP"], ["to", "TO"], [["Washington", "NNP"]], ["to-morrow", "NNP"], [",", ","], ["as", "IN"], ["my", "PRP$"], ["leave", "NN"], ["is", "VBZ"], ["up", "IN"], [".", "."]], [["The", "DT"], ["little", "JJ"], ["girls", "NNS"], ["are", "VBP"], ["hearty", "JJ"], ["as", "IN"], ["ever", "RB"], [".", "."]], [["Best", "JJS"], ["love", "VBP"], [["Walt", "NNP"]], [".", "."]], [["It", "PRP"], ["is", "VBZ"], ["certain", "JJ"], ["that", "IN"], ["her", "PRP$"], ["cough", "JJ"], ["is", "VBZ"], ["not", "RB"], ["near", "IN"], ["as", "IN"], ["bad", "JJ"], ["here", "RB"], ["as", "IN"], ["it", "PRP"], ["was", "VBD"], ["in", "IN"], [["St.", "NNP"], ["Louis", "NNP"]], [",", ","], ["in", "IN"], ["that", "DT"], ["house", "NN"], [".", "."]]], "sentences": ["  New York,                     Sunday forenoon, Oct. 25 1868.", "Dear brother Jeff,              I suppose you rec'd the letter I wrote four or five days ago from Providence, R. I.                  I came back Thursday night, & was over home on Friday.", "I received your letter.", "Matty has had an examination of her lungs, by Dr. A. D. Wilson, 30 Gates Av.", "near Clinton av.", "I had not seen Dr. W.   it was the Thursday before I returned   yesterday I went down to see Dr. Enos, waited some time, but did not see him   I intended to make an appointment, & go down with Mat but, as I say, came away                  without seeing him   Then I went up to Gates av.", "& found Dr. Wilson in, & had a                  long talk with him about Mat.", "The impression he made upon me was that he is a                  man who knows his business thoroughly, very candid, & probably a little disposed                  to state things on the most unfavorable side, rather than the other   He said he could tell better in ten or twelve days   one of Mat's lungs is affected   thinks there is no imminent danger at all   thinks that the physician in St. Louis                  who advised a change from there here, couldn't have had any knowledge of Brooklyn                  climate or situation   nevertheless thinks that the journey & a temporary change                  will be very salutary, & do her good   advised whiskey, wine, condensed milk, &c   did not advise any drug medicines   was evidently interested, & took hold of the                  case not merely as a matter of business   After seeing him & talking [to] him,                  I abandoned the idea of consulting Enos   at least for the present.", "My idea is that Matty has the possibilities of consumption in her system   but that with ordinary good luck, she can & will get over it.", "She has good spirits,                  is very comfortably situated   has a good, cheerfull, warm room, with southern exposure   has a good stove, gas, &c   Upon the whole, as to personal surroundings, &c                  she could not be happier in them   for Mother, & George, & Ed too, think & do                  every thing that the tenderest mother & brothers could   George is very kind   Mat realizes it all perfectly, & is herself very kind & affectionate as indeed she always was.", "Mother & all wish you to arrange without fail to come on, on or before 1st December   before,                  if convenient   Mother is well, but shows her old age more & more.", "I return to Washington to-morrow,                  as my leave is up.", "The little girls are hearty as ever.", "Best love     Walt.", "It is certain that her cough is not near as bad here as it was in St. Louis, in that house.                  "], "words": ["New", "York", ",", "Sunday", "forenoon", ",", "Oct.", "25", "1868.", "Dear", "brother", "Jeff", ",", "I", "suppose", "you", "rec", "'d", "the", "letter", "I", "wrote", "four", "or", "five", "days", "ago", "from", "Providence", ",", "R.", "I.", "I", "came", "back", "Thursday", "night", ",", "&", "was", "over", "home", "on", "Friday.", "I", "received", "your", "letter.", "Matty", "has", "had", "an", "examination", "of", "her", "lungs", ",", "by", "Dr.", "A.", "D.", "Wilson", ",", "30", "Gates", "Av.", "near", "Clinton", "av.", "I", "had", "not", "seen", "Dr.", "W.", "it", "was", "the", "Thursday", "before", "I", "returned", "yesterday", "I", "went", "down", "to", "see", "Dr.", "Enos", ",", "waited", "some", "time", ",", "but", "did", "not", "see", "him", "I", "intended", "to", "make", "an", "appointment", ",", "&", "go", "down", "with", "Mat", "but", ",", "as", "I", "say", ",", "came", "away", "without", "seeing", "him", "Then", "I", "went", "up", "to", "Gates", "av.", "&", "found", "Dr.", "Wilson", "in", ",", "&", "had", "a", "long", "talk", "with", "him", "about", "Mat.", "The", "impression", "he", "made", "upon", "me", "was", "that", "he", "is", "a", "man", "who", "knows", "his", "business", "thoroughly", ",", "very", "candid", ",", "&", "probably", "a", "little", "disposed", "to", "state", "things", "on", "the", "most", "unfavorable", "side", ",", "rather", "than", "the", "other", "He", "said", "he", "could", "tell", "better", "in", "ten", "or", "twelve", "days", "one", "of", "Mat", "'s", "lungs", "is", "affected", "thinks", "there", "is", "no", "imminent", "danger", "at", "all", "thinks", "that", "the", "physician", "in", "St.", "Louis", "who", "advised", "a", "change", "from", "there", "here", ",", "could", "n't", "have", "had", "any", "knowledge", "of", "Brooklyn", "climate", "or", "situation", "nevertheless", "thinks", "that", "the", "journey", "&", "a", "temporary", "change", "will", "be", "very", "salutary", ",", "&", "do", "her", "good", "advised", "whiskey", ",", "wine", ",", "condensed", "milk", ",", "&", "c", "did", "not", "advise", "any", "drug", "medicines", "was", "evidently", "interested", ",", "&", "took", "hold", "of", "the", "case", "not", "merely", "as", "a", "matter", "of", "business", "After", "seeing", "him", "&", "talking", "[", "to", "]", "him", ",", "I", "abandoned", "the", "idea", "of", "consulting", "Enos", "at", "least", "for", "the", "present.", "My", "idea", "is", "that", "Matty", "has", "the", "possibilities", "of", "consumption", "in", "her", "system", "but", "that", "with", "ordinary", "good", "luck", ",", "she", "can", "&", "will", "get", "over", "it.", "She", "has", "good", "spirits", ",", "is", "very", "comfortably", "situated", "has", "a", "good", ",", "cheerfull", ",", "warm", "room", ",", "with", "southern", "exposure", "has", "a", "good", "stove", ",", "gas", ",", "&", "c", "Upon", "the", "whole", ",", "as", "to", "personal", "surroundings", ",", "&", "c", "she", "could", "not", "be", "happier", "in", "them", "for", "Mother", ",", "&", "George", ",", "&", "Ed", "too", ",", "think", "&", "do", "every", "thing", "that", "the", "tenderest", "mother", "&", "brothers", "could", "George", "is", "very", "kind", "Mat", "realizes", "it", "all", "perfectly", ",", "&", "is", "herself", "very", "kind", "&", "affectionate", "as", "indeed", "she", "always", "was.", "Mother", "&", "all", "wish", "you", "to", "arrange", "without", "fail", "to", "come", "on", ",", "on", "or", "before", "1st", "December", "before", ",", "if", "convenient", "Mother", "is", "well", ",", "but", "shows", "her", "old", "age", "more", "&", "more.", "I", "return", "to", "Washington", "to-morrow", ",", "as", "my", "leave", "is", "up.", "The", "little", "girls", "are", "hearty", "as", "ever.", "Best", "love", "Walt.", "It", "is", "certain", "that", "her", "cough", "is", "not", "near", "as", "bad", "here", "as", "it", "was", "in", "St.", "Louis", ",", "in", "that", "house", "."], "date": [], "normalizedTime": "0.43805249558", "recipient": "Thomas Jefferson Whitman", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/mhs.00027.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Thomas Jefferson Whitman ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Francis", "NNP"], ["P.", "NNP"], ["Church", "NNP"]], ["(", "NNP"], ["?", "."]], [[")", "NN"], [",", ","]]], "people": ["Sir", "Ethiopia Commenting"], "money": [], "year": "1868", "locations": [], "month": "Nov", "parties": ["Walt", "Whitman", "Francis P. Church"], "properDate": "Nov 2, 1868", "gpe": ["Washington"], "facility": [], "latlngs": [[38.8951118, -77.0363658]], "text": "  Attorney General's Office,                     Washington.                     Nov. 2, 1868                                  My dear Sir,              As you have not found the little piece \"Ethiopia Commenting\" available, allow me to withdraw it   Indeed I have already sent it to another quarter.              ", "dateText": "", "percents": [], "taggedText": [[["Attorney", "NNP"], ["General", "NNP"], ["'s", "POS"], ["Office", "NNP"], [",", ","], [["Washington", "NNP"]], [".", "."]], [["Nov.", "NNP"], ["2", "CD"], [",", ","], ["1868", "CD"], ["My", "NNP"], ["dear", "NN"], [["Sir", "NNP"]], [",", ","], ["As", "NNP"], ["you", "PRP"], ["have", "VBP"], ["not", "RB"], ["found", "VBN"], ["the", "DT"], ["little", "JJ"], ["piece", "NN"], ["``", "``"], [["Ethiopia", "NNP"], ["Commenting", "NNP"]], ["''", "''"], ["available", "JJ"], [",", ","], ["allow", "VBP"], ["me", "PRP"], ["to", "TO"], ["withdraw", "VB"], ["it", "PRP"], ["Indeed", "RB"], ["I", "PRP"], ["have", "VBP"], ["already", "RB"], ["sent", "VBN"], ["it", "PRP"], ["to", "TO"], ["another", "DT"], ["quarter", "NN"], [".", "."]]], "sentences": ["  Attorney General's Office,                     Washington.", "Nov. 2, 1868                                  My dear Sir,              As you have not found the little piece \"Ethiopia Commenting\" available, allow me to withdraw it   Indeed I have already sent it to another quarter.              "], "words": ["Attorney", "General", "'s", "Office", ",", "Washington.", "Nov.", "2", ",", "1868", "My", "dear", "Sir", ",", "As", "you", "have", "not", "found", "the", "little", "piece", "``", "Ethiopia", "Commenting", "''", "available", ",", "allow", "me", "to", "withdraw", "it", "Indeed", "I", "have", "already", "sent", "it", "to", "another", "quarter", "."], "date": [], "normalizedTime": "0.439140486876", "recipient": "Francis P. Church", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/nyp.00266.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Francis P. Church ( ? ) ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["John", "NNP"], ["Flood", "NNP"]], [",", ","], ["Jr.", "NNP"], [",", ","]]], "people": ["Dear", "Jack Flood", "Jack", "Dear", "Walt Whitman"], "money": [], "year": "1868", "locations": [], "month": "Nov", "parties": ["Walt", "Whitman", "John Flood"], "properDate": "Nov 22, 1868", "gpe": ["Washington", "New York", "Dear", "New York", "Washington", "Washington", "Georgetown", "New York", "Jack", "Jack"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [40.7143528, -74.00597309999999], [40.7143528, -74.00597309999999], [38.8951118, -77.0363658], [38.8951118, -77.0363658], [6.804611, -58.15483099999999], [40.7143528, -74.00597309999999], [33.2560382, -98.2212979], [33.2560382, -98.2212979], [34.162526, -112.8507374]], "text": "  Attorney General's Office,                     Washington, D. C.,                     Nov. 22, 1868.                                   Dear Jack Flood,              I received your welcome letter, and was happy to know that you had not forgotten me   for I have thought of you many times since. I returned here from New York about four weeks ago,                  and have been and now am working in this office as usual   am well and hearty,                  and don't hurt myself with hard work. Our hours are from 9 till 3.              You speak of coming here and paying me a visit. Dear boy, I hope you will come truly,                  for it would be a great comfort to me if we could be together again. I don't know whether                  it would be very pleasant to you here, Jack, for this is a stupid place compared to New York   but we would have each other's society, and that would be first rate.              There's not much excitement in Washington   at least none that I take any interest in.                  Politics and politicians carry the day here   but I meddle with them very little.                  In a couple of weeks more, Congress will meet, and then the city will be quite lively.              I am out a good deal in the open air, as I have plenty of leisure time.                  It is fine scenery around Washington   plenty of hills, and a noble river.                  I take a ride on the cars out to Georgetown west, or Navy Yard east, once in a while                  of a pleasant afternoon, or Sunday   but I tell you I miss New York.                  We had a long spell of splendid weather. But now it is colder, with some                  snow a couple of days since. Jack, you must write often as you can   anything from my loving boy will be welcome   you needn't be particular about the writing   you might write in the car with pencil, when you have any time. I will write to you too.                  I will now close for this time. Dear Jack, I send you my love.               Walt Whitman.              ", "dateText": "", "percents": [], "taggedText": [[["Attorney", "NNP"], ["General", "NNP"], ["'s", "POS"], ["Office", "NNP"], [",", ","], [["Washington", "NNP"]], [",", ","], ["D."