], "month": "Jun", "parties": ["Walt", "Whitman", "Peter Doyle"], "properDate": "Jun 10, 1874", "gpe": ["Am"], "facility": [], "latlngs": [], "text": "                       431 Stevens st. Camden, N. Jersey.           June 10.                            Your letter & paper came to-day. Am standing the extreme hot weather very well indeed so far   am about as usual, (& better than when you saw me)     W W        ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"], ["Camden", "NNP"]], [",", ","], ["N.", "NNP"], ["Jersey", "NNP"], [".", "."]], [["June", "NNP"], ["10", "CD"], [".", "."]], [["Your", "PRP$"], ["letter", "NN"], ["&", "CC"], ["paper", "NN"], ["came", "VBD"], ["to-day", "JJ"], [".", "."]], [[["Am", "NNP"]], ["standing", "NN"], ["the", "DT"], ["extreme", "NN"], ["hot", "NN"], ["weather", "NN"], ["very", "RB"], ["well", "RB"], ["indeed", "RB"], ["so", "RB"], ["far", "RB"], ["am", "VBP"], ["about", "IN"], ["as", "IN"], ["usual", "JJ"], [",", ","], ["(", ":"], ["&", "CC"], ["better", "JJR"], ["than", "IN"], ["when", "WRB"], ["you", "PRP"], ["saw", "VBD"], ["me", "PRP"], [")", ":"], ["W", "NNP"], ["W", "NNP"]]], "sentences": ["                       431 Stevens st. Camden, N. Jersey.", "June 10.", "Your letter & paper came to-day.", "Am standing the extreme hot weather very well indeed so far   am about as usual, (& better than when you saw me)     W W        "], "words": ["431", "Stevens", "st.", "Camden", ",", "N.", "Jersey.", "June", "10.", "Your", "letter", "&", "paper", "came", "to-day.", "Am", "standing", "the", "extreme", "hot", "weather", "very", "well", "indeed", "so", "far", "am", "about", "as", "usual", ",", "(", "&", "better", "than", "when", "you", "saw", "me", ")", "W", "W"], "date": [], "normalizedTime": "0.717394260846", "recipient": "Peter Doyle", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/nyp.00345.html", "doc": {"h