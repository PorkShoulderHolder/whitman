eadline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " John Burroughs to Walt Whitman ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["William", "NNP"], ["Michael", "NNP"], ["Rossetti", "NNP"]], [",", ","]]], "people": ["Rossetti", "Richard J. Hinton", "Walt Whitman"], "money": [], "year": "1873", "locations": [], "month": "Apr", "parties": ["Walt", "Whitman", "William Michael Rossetti"], "properDate": "Apr 11, 1873", "gpe": ["Washington", "English"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [38.0332695, -78.5059101]], "text": "  Washington,           April 11, 1873.                        My dear Rossetti,        The bearer of this note is Col. Richard J. Hinton, of this city (though English by birth),          a friend of mine, who calls to make your acquaintance.          Truly yours,         Walt Whitman.        I have been very ill, from paralysis, but am recovering. Your books (two sets) reached me safely, and gave me great pleasure. I am perfectly satisfied            with the selections from my poems   and feel grateful to you for your kindness to me throughout            the books. I do not forget you. I will write again when I feel well. My address remains the same   Solicitor's Office, Treasury, here.  W.W.        ", "dateText": "", "percents": [], "taggedText": [[[["Washington", "NNP"]], [",", ","], ["April", "NNP"], ["11", "CD"], [",", ","], ["1873", "CD"], [".", "."]], [["My", "PRP$"], ["dear", "NN"], [["Rossetti", "NNP"]], [",", ","], ["The", "NNP"], ["bearer", "NN"], ["of", "IN"], ["this", "DT"], ["note", "NN"], ["is", "VBZ"], ["Col.", "NNP"], [["Richard", "NNP"], ["J.", "NNP"], ["Hinton", "NNP"]], [",", ","], ["of", "IN"], ["this", "DT"], ["city", "NN"], ["(", ":"], ["though", "IN"], [["English", "NNP"]], ["by", "IN"], ["birth", "JJ"], [")", "NN"], [",", ","], ["a", "DT"], ["friend", "NN"], ["of", "IN"], ["mine", "JJ"], [",", ","], ["who", "WP"], ["calls", "VBZ"], ["to", "TO"], ["make",