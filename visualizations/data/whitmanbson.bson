", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"]], ["cor", "NN"], [["West", "NNP"]], [".", "."]], [[["Camden", "NNP"]], [",", ","], ["N.", "NNP"], ["Jersey", "NNP"], [",", ","], ["Jan.", "NNP"], ["7", "CD"], [".", "."]], [[["Am", "NNP"]], ["feeling", "NN"], ["better", "JJR"], ["than", "IN"], ["during", "IN"], ["Nov.", "NNP"], ["and", "CC"], ["first", "JJ"], ["part", "NN"], ["of", "IN"], ["Dec", "NNP"], ["strength", "NN"], ["better", "JJR"], ["than", "IN"], ["for", "IN"], ["a", "DT"], ["long", "JJ"], ["time", "NN"], ["rec", "NN"], ["'d", "MD"], ["the", "DT"], [["Springfield", "NNP"]], ["Rep", "NNP"], ["[", "NNP"], ["ublican", "MD"], ["]", "VB"], ["this", "DT"], ["morning", "NN"], ["(", ":"], ["is", "VBZ"], ["it", "PRP"], ["from", "IN"], ["you", "PRP"], ["or", "CC"], ["Ch", "NNP"], ["[", ":"], ["arley", "NN"], ["]", ":"], ["?", "."]], [[")", "NN"], ["That", "DT"], ["\u00b6", "NN"], ["in", "IN"], ["the", "DT"], [["T", "NNP"]], ["[", "NNP"], ["ribune", "NN"], ["]", ":"], ["was", "VBD"], ["the", "DT"], ["most", "JJS"], ["flourishing", "VBG"], ["puff", "NN"], ["yet", "RB"], ["given", "VBN"], ["me", "PRP"], ["&", "CC"], ["from", "IN"], ["them", "PRP"], ["!", "."]], [["A", "DT"], ["leaden", "VBN"], [",", ","], ["heavy", "JJ"], ["day", "NN"], ["here", "RB"], [",", ","], ["with", "IN"], ["sulky", "JJ"], ["rain", "NN"], ["&", "CC"], ["some", "DT"], ["snow", "NN"], ["&", "CC"], ["sleet", "NN"], ["I", "PRP"], ["have", "VBP"], ["to", "TO"], ["stay", "VB"], ["in", "IN"], [",", ","], ["but", "CC"], ["am", "VBP"], ["feeling", "VBG"], ["comfortable", "JJ"], [".", "."]], [["WW", "NNP"]]], "sentences": ["  431 Stevens st. cor West.", "Camden, N. Jersey,           Jan. 7.", "Am feeling better than during Nov. and first part of Dec   strength better than for a long time   rec'd the Springfield Rep[ublican] this morning   (is it from you or Ch[arley]?", ")   That \u00b6 in the T[ribune] was the most flourishing puff yet given me   & from them!", "A lea