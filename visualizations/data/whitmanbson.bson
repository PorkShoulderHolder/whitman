], ["few", "JJ"], ["thanks", "NNS"], [",", ","], ["&", "CC"], ["only", "RB"], ["ask", "VBP"], ["its", "PRP$"], ["being", "VBG"], ["put", "VBN"], ["to", "TO"], ["best", "JJS"], ["use", "NN"], [",", ","], ["what", "WP"], ["they", "PRP"], ["feel", "VBP"], ["to", "TO"], ["give", "VB"], ["among", "IN"], ["sick", "NN"], ["&", "CC"], ["wounded", "VBD"], [".", "."]], [["I", "PRP"], ["have", "VBP"], ["received", "VBN"], ["L", "NNP"], ["B", "NNP"], ["Russell's5", "NNP"], ["letter", "NN"], ["&", "CC"], ["contribution", "NN"], ["by", "IN"], ["same", "JJ"], ["hand", "NN"], [",", ","], ["&", "CC"], ["shall", "MD"], ["try", "VB"], ["to", "TO"], ["write", "VB"], ["to", "TO"], ["him", "PRP"], ["to-morrow", "JJ"], [["Walt", "NNP"], ["Address", "NNP"]], ["|", "NNP"], ["care", "NN"], [["Major", "NNP"], ["Hapgood", "NNP"]], ["|", "NNP"], ["paymaster", "NN"], ["U", "NNP"], ["S", "NNP"], ["A", "NNP"], ["cor", "NN"], ["15th", "CD"], ["&", "CC"], ["F", "NNP"], ["st", "NN"], ["|", ":"], [["Washington", "NNP"]], ["D", "NNP"], ["C", "NNP"], [".", "."]]], "sentences": ["  Washington  October 8 | 1863  Dear friend2 Your letter was received, enclosing one from Mary Wigglesworth with $30 from herself & her sisters Jane & Anne   As I happened stopping at one of the hospitals last night Miss Lowe just from Boston came to me & handed the letters   My friend, you must convey the blessings of the poor young men around me here, many amid deepest afflictions not of body only but of soul, to your friends Mary, Jane, & Anne Wigglesworth.3 Their & all contributions shall be sacredly used among them.", "I find more & more how a little money rightly directed, the exact thing at the exact moment, goes a great ways, to make gifts comfort & truly nourish these American soldiers, so full of manly independence, is required the spirit of love & boundless brotherly tenderness, hand in hand with greatest tact.", "I do not find any lack in the storehouses, nor eager willingness of the North to unlock them for the soldiers   but sadly everywhere a lack of fittest hands to apply, & of just the right thing in just the right measure, & of all being vivified by the spirit I have mentioned    Say to the sisters Mary & Jane & Anne Wigglesworth, & to your own sister, Margaret,4 that as I feel it a privilege myself to be doing a part among these things, I know well enough the like privilege must be sweet to them, to their compassionate & sisterly souls, & need indeed few thanks, & only ask its being put to best use, what they feel to give among sick & wounded.", "I have received L B Russell's5 letter & contribution by same hand, & shall try to write to him to-morrow    Walt Address | care Major Hapgood | paymaster U S A cor 15th & F st | Washington D C. "], "words": ["Washington", "October", "8", "|", "1863", "Dear", "friend2", "Your", "letter", "was", "received", ",", "enclosing", "one", "from", "Mary", "Wigglesworth", "with", "$", "30", "from", "herself", "&", "her", "sisters", "Jane", "&", "Anne", "As", "I", "happened", "stopping", "at", "one", "of", "the", "hospitals", "last", "night", "Miss", "Lowe", "just", "from", "Boston", "came", "to", "me", "&", "handed", "the", "letters", "My", "friend", ",", "you", "must", "convey", "the", "blessings", "of", "the", "poor", "young", "men", "around", "me", "here", ",", "many", "amid", "deepest", "afflictions", "not", "of", "body", "only", "but", "of", "soul", ",", "to", "your", "friends", "Mary", ",", "Jane", ",", "&", "Anne", "Wigglesworth.3", "Their", "&", "all", "contributions", "shall", "be", "sacredly", "used", "among", "them.", "I", "find", "more", "&", "more", "how", "a", "little", "money", "rightly", "directed", ",", "the", "exact", "thing", "at", "the", "exact", "moment", ",", "goes", "a", "great", "ways", ",", "to", "make", "gifts", "comfort", "&", "truly", "nourish", "these", "American", "soldiers", ",", "so", "full", "of", "manly", "independence", ",", "is", "required", "the", "spirit", "of", "love", "&", "boundless", "brotherly", "tenderness", ",", "hand", "in", "hand", "with", "greatest", "tact.", "I", "do", "not", "find", "any", "lack", "in", "the", "storehouses", ",", "nor", "eager", "willingness", "of", "the", "North", "to", "unlock", "them", "for", "the", "soldiers", "but", "sadly", "everywhere", "a", "lack", "of", "fittest", "hands", "to", "apply", ",", "&", "of", "just", "the", "right", "thing", "in", "just", "the", "right", "measure", ",", "&", "of", "all", "being", "vivified", "by", "the", "spirit", "I", "have", "mentioned", "Say", "to", "the", "sisters", "Mary", "&", "Jane", "&", "Anne", "Wigglesworth", ",", "&", "to", "your", "own", "sister", ",", "Margaret,4", "that", "as", "I", "feel", "it", "a", "privilege", "myself", "to", "be", "doing", "a", "part", "among", "these", "things", ",", "I", "know", "well", "enough", "the", "like", "privilege", "must", "be", "sweet", "to", "them", ",", "to", "their", "compassionate", "&", "sisterly", "souls", ",", "&", "need", "indeed", "few", "thanks", ",", "&", "only", "ask", "its", "being", "put", "to", "best", "use", ",", "what", "they", "feel", "to", "give", "among", "sick", "&", "wounded.", "I", "have", "received", "L", "B", "Russell's5", "letter", "&", "contribution", "by", "same", "hand", ",", "&", "shall", "try", "to", "write", "to", "him", "to-morrow", "Walt", "Address", "|", "care", "Major", "Hapgood", "|", "paymaster", "U", "S", "A", "cor", "15th", "&", "F", "st", "|", "Washington", "D", "C", "."], "date": [], "normalizedTime": "0.187270501836", "recipient": "Hannah E. Stevenson", "organizations": ["Walt Address"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00796.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to Hannah E. Stevenson ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["James", "NNP"], ["Redpath", "NNP"]], [",", ","]]], "people": ["Miss"], "money": [], "year": "1863", "locations": [], "month": "Oct", "parties": ["Walt Whitman", "James Redpath"], "properDate": "Oct 12, 1863", "gpe": ["Good"], "facility": [], "latlngs": [], "text": " Your note of Oct 8,2 enclosing Dr Russell's of 4th to you,3 is just rec'd. Yours with $5, some weeks ago, came safely. The generosity of Dr. Russell, Mrs. Curtis, and the other friends, I will briefly say, tells daily & nightly & shall tell to the best of my power, upon my dear boys here, in hospital. I do not miss one day or night. (I guess we, I & the wounded &c, were made for each other.) I have written to Dr Russell, to Mrs Curtis & to Miss Stevenson.4 Do you want to print a little 30 or 50ct book about the scenes, war, camp, hospitals &c (especially the &c.)5 I shall probably remain here, in this thing. I am very happy. I never was so beloved. I am running over with health, fat, red & sunburnt in face &c. I tell thee I am just the one to go [to] our sick boys. Good by, my friend. ", "dateText": "", "percents": [], "taggedText": [[["Your", "PRP$"], ["note", "NN"], ["of", "IN"], ["Oct", "NNP"], ["8,2", "CD"], ["enclosing", "VBG"], ["Dr", "NNP"], ["Russell", "NNP"], ["'s", "POS"], ["of", "IN"], ["4th", "JJ"], ["to", "TO"], ["you,3", "-NONE-"], ["is", "VBZ"], ["just", "RB"], ["rec", "JJ"], ["'d", "JJ"], [".", "."]], [["Yours", "NNS"], ["with", "IN"], ["$", "$"], ["5", "CD"], [",", ","], ["some", "DT"], ["weeks", "NNS"], ["ago", "IN"], [",", ","], ["came", "VBD"], ["safely", "RB"], [".", "."]], [["The", "DT"], ["generosity", "NN"], ["of", "IN"], ["Dr.", "NNP"], ["Russell", "NNP"], [",", ","], ["Mrs.", "NNP"], ["Curtis", "NNP"], [",", ","], ["and", "CC"], ["the", "DT"], ["other", "JJ"], ["friends", "NNS"], [",", ","], ["I", "PRP"], ["will", "MD"], ["briefly", "RB"], ["say", "VB"], [",", ","], ["tells", "NNS"], ["daily", "RB"], ["&", "CC"], ["nightly", "RB"], ["&", "CC"], ["shall", "MD"], ["tell", "VB"], ["to", "TO"], ["the", "DT"], ["best", "JJS"], ["of", "IN"], ["my", "PRP$"], ["power", "NN"], [",", ","], ["upon", "IN"], ["my", "PRP$"], ["dear", "NN"], ["boys", "NNS"], ["here", "RB"], [",", ","], ["in", "IN"], ["hospital", "NN"], [".", "."]], [["I", "PRP"], ["do", "VBP"], ["not", "RB"], ["miss", "VB"], ["one", "CD"], ["day", "NN"], ["or", "CC"], ["night", "NN"], [".", "."]], [["(", "NN"], ["I", "PRP"], ["guess", "VBP"], ["we", "PRP"], [",", ","], ["I", "PRP"], ["&", "CC"], ["the", "DT"], ["wounded", "VBN"], ["&", "CC"], ["c", "NN"], [",", ","], ["were", "VBD"], ["made", "VBN"], ["for", "IN"], ["each", "DT"], ["other", "JJ"], [".", "."]], [[")", "NN"], ["I", "PRP"], ["have", "VBP"], ["written", "VBN"], ["to", "TO"], ["Dr", "NNP"], ["Russell", "NNP"], [",", ","], ["to", "TO"], ["Mrs", "NNP"], ["Curtis", "NNP"], ["&", "CC"], ["to", "TO"], [["Miss", "NNP"]], ["Stevenson.4", "NNP"], ["Do", "NNP"], ["you", "PRP"], ["want", "VB"], ["to", "TO"], ["print", "VB"], ["a", "DT"], ["little", "RB"], ["30", "CD"], ["or", "CC"], ["50ct", "CD"], ["book", "NN"], ["about", "IN"], ["the", "DT"], ["scenes", "NNS"], [",", ","], ["war", "NN"], [",", ","], ["camp", "NN"], [",", ","], ["hospitals", "NNS"], ["&", "CC"], ["c", "NN"], ["(", ":"], ["especially", "RB"], ["the", "DT"], ["&", "CC"], ["c.", "NNP"], [")", "NNP"], ["5", "CD"], ["I", "PRP"], ["shall", "MD"], ["probably", "RB"], ["remain", "VB"], ["here", "RB"], [",", ","], ["in", "IN"], ["this", "DT"], ["thing", "NN"], [".", "."]], [["I", "PRP"], ["am", "VBP"], ["very", "RB"], ["happy", "JJ"], [".", "."]], [["I", "PRP"], ["never", "RB"], ["was", "VBD"], ["so", "RB"], ["beloved", "VBN"], [".", "."]], [["I", "PRP"], ["am", "VBP"], ["running", "VBG"], ["over", "IN"], ["with", "IN"], ["health", "NN"], [",", ","], ["fat", "JJ"], [",", ","], ["red", "VBN"], ["&", "CC"], ["sunburnt", "NN"], ["in", "IN"], ["face", "NN"], ["&", "CC"], ["c.", "NNP"], ["I", "NNP"], ["tell", "VBP"], ["thee", "NN"], ["I", "PRP"], ["am", "VBP"], ["just", "RB"], ["the", "DT"], ["one", "CD"], ["to", "TO"], ["go", "VB"], ["[", ":"], ["to", "TO"], ["]", "VB"], ["our", "PRP$"], ["sick", "NN"], ["boys", "NNS"], [".", "."]], [[["Good", "NNP"]], ["by", "IN"], [",", ","], ["my", "PRP$"], ["friend", "NN"], [".", "."]]], "sentences": [" Your note of Oct 8,2 enclosing Dr Russell's of 4th to you,3 is just rec'd.", "Yours with $5, some weeks ago, came safely.", "The generosity of Dr. Russell, Mrs. Curtis, and the other friends, I will briefly say, tells daily & nightly & shall tell to the best of my power, upon my dear boys here, in hospital.", "I do not miss one day or night.", "(I guess we, I & the wounded &c, were made for each other.", ") I have written to Dr Russell, to Mrs Curtis & to Miss Stevenson.4 Do you want to print a little 30 or 50ct book about the scenes, war, camp, hospitals &c (especially the &c.)5 I shall probably remain here, in this thing.", "I am very happy.", "I never was so beloved.", "I am running over with health, fat, red & sunburnt in face &c. I tell thee I am just the one to go [to] our sick boys.", "Good by, my friend. "], "words": ["Your", "note", "of", "Oct", "8,2", "enclosing", "Dr", "Russell", "'s", "of", "4th", "to", "you,3", "is", "just", "rec'd.", "Yours", "with", "$", "5", ",", "some", "weeks", "ago", ",", "came", "safely.", "The", "generosity", "of", "Dr.", "Russell", ",", "Mrs.", "Curtis", ",", "and", "the", "other", "friends", ",", "I", "will", "briefly", "say", ",", "tells", "daily", "&", "nightly", "&", "shall", "tell", "to", "the", "best", "of", "my", "power", ",", "upon", "my", "dear", "boys", "here", ",", "in", "hospital.", "I", "do", "not", "miss", "one", "day", "or", "night.", "(", "I", "guess", "we", ",", "I", "&", "the", "wounded", "&", "c", ",", "were", "made", "for", "each", "other.", ")", "I", "have", "written", "to", "Dr", "Russell", ",", "to", "Mrs", "Curtis", "&", "to", "Miss", "Stevenson.4", "Do", "you", "want", "to", "print", "a", "little", "30", "or", "50ct", "book", "about", "the", "scenes", ",", "war", ",", "camp", ",", "hospitals", "&", "c", "(", "especially", "the", "&", "c.", ")", "5", "I", "shall", "probably", "remain", "here", ",", "in", "this", "thing.", "I", "am", "very", "happy.", "I", "never", "was", "so", "beloved.", "I", "am", "running", "over", "with", "health", ",", "fat", ",", "red", "&", "sunburnt", "in", "face", "&", "c.", "I", "tell", "thee", "I", "am", "just", "the", "one", "to", "go", "[", "to", "]", "our", "sick", "boys.", "Good", "by", ",", "my", "friend", "."], "date": [], "normalizedTime": "0.187814497484", "recipient": "James Redpath", "organizations": [], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00797.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to James Redpath ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Bethuel", "NNP"], ["Smith", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Carlisle", "Bethuel Smith1Co"], "money": [], "year": "1863", "locations": [], "month": "Oct", "parties": ["Bethuel Smith", "Walt Whitman"], "properDate": "Oct 13, 1863", "gpe": ["Washington"], "facility": [], "latlngs": [[38.8951118, -77.0363658]], "text": "  Washington Oct the 13 1863  Dear Friend I now sit down to write to write you a few lines to let you now where I am I am with the regiment now. I left Carlisle about one week ago and have ben diledaleying around & have not had time to rite to you untill now & I have not got much time now the toe is most all healed up but my foot is swelled so that I can not get my boot on it swelled from walking from the depot [out?]  her but I think that will go down in a day or to the brigade is gone out to the front again & I dont now but we shall follow them pretty soon I dont now as I can write anny more at present So good by for this time   Bethuel Smith1Co. F. 2nd U. S. Cav.Washington DC  ", "dateText": "", "percents": [], "taggedText": [[[["Washington", "NNP"]], ["Oct", "NNP"], ["the", "DT"], ["13", "CD"], ["1863", "CD"], ["Dear", "NNP"], ["Friend", "NNP"], ["I", "NNP"], ["now", "RB"], ["sit", "VB"], ["down", "IN"], ["to", "TO"], ["write", "VB"], ["to", "TO"], ["write", "VB"], ["you", "PRP"], ["a", "DT"], ["few", "JJ"], ["lines", "NNS"], ["to", "TO"], ["let", "VB"], ["you", "PRP"], ["now", "RB"], ["where", "WRB"], ["I", "PRP"], ["am", "VBP"], ["I", "PRP"], ["am", "VBP"], ["with", "IN"], ["the", "DT"], ["regiment", "NN"], ["now", "RB"], [".", "."]], [["I", "PRP"], ["left", "VBD"], [["Carlisle", "NNP"]], ["about", "IN"], ["one", "CD"], ["week", "NN"], ["ago", "RB"], ["and", "CC"], ["have", "VBP"], ["ben", "VBN"], ["diledaleying", "VBG"], ["around", "IN"], ["&", "CC"], ["have", "VBP"], ["not", "RB"], ["had", "VBN"], ["time", "NN"], ["to", "TO"], ["rite", "VB"], ["to", "TO"], ["you", "PRP"], ["untill", "MD"], ["now", "RB"], ["&", "CC"], ["I", "PRP"], ["have", "VBP"], ["not", "RB"], ["got", "VBN"], ["much", "RB"], ["time", "NN"], ["now", "RB"], ["the", "DT"], ["toe", "NN"], ["is", "VBZ"], ["most", "JJS"], ["all", "DT"], ["healed", "VBN"], ["up", "RP"], ["but", "CC"], ["my", "PRP$"], ["foot", "NN"], ["is", "VBZ"], ["swelled", "VBN"], ["so", "RB"], ["that", "IN"], ["I", "PRP"], ["can", "MD"], ["not", "RB"], ["get", "VB"], ["my", "PRP$"], ["boot", "NN"], ["on", "IN"], ["it", "PRP"], ["swelled", "VBD"], ["from", "IN"], ["walking", "VBG"], ["from", "IN"], ["the", "DT"], ["depot", "NN"], ["[", ":"], ["out", "IN"], ["?", "."]], [["]", "NN"], ["her", "PRP$"], ["but", "CC"], ["I", "PRP"], ["think", "VBP"], ["that", "IN"], ["will", "MD"], ["go", "VB"], ["down", "RB"], ["in", "IN"], ["a", "DT"], ["day", "NN"], ["or", "CC"], ["to", "TO"], ["the", "DT"], ["brigade", "NN"], ["is", "VBZ"], ["gone", "VBN"], ["out", "RP"], ["to", "TO"], ["the", "DT"], ["front", "NN"], ["again", "RB"], ["&", "CC"], ["I", "PRP"], ["dont", "VBP"], ["now", "RB"], ["but", "CC"], ["we", "PRP"], ["shall", "MD"], ["follow", "VB"], ["them", "PRP"], ["pretty", "RB"], ["soon", "RB"], ["I", "PRP"], ["dont", "VBP"], ["now", "RB"], ["as", "IN"], ["I", "PRP"], ["can", "MD"], ["write", "VB"], ["anny", "JJ"], ["more", "RBR"], ["at", "IN"], ["present", "NN"], ["So", "RB"], ["good", "JJ"], ["by", "IN"], ["for", "IN"], ["this", "DT"], ["time", "NN"], [["Bethuel", "NNP"], ["Smith1Co", "NNP"]], [".", "."]], [["F.", "NNP"], ["2nd", "CD"], ["U.", "NNP"], ["S.", "NNP"], ["Cav.Washington", "NNP"], ["DC", "NNP"]]], "sentences": ["  Washington Oct the 13 1863  Dear Friend I now sit down to write to write you a few lines to let you now where I am I am with the regiment now.", "I left Carlisle about one week ago and have ben diledaleying around & have not had time to rite to you untill now & I have not got much time now the toe is most all healed up but my foot is swelled so that I can not get my boot on it swelled from walking from the depot [out?", "]  her but I think that will go down in a day or to the brigade is gone out to the front again & I dont now but we shall follow them pretty soon I dont now as I can write anny more at present So good by for this time   Bethuel Smith1Co.", "F. 2nd U. S. Cav.Washington DC  "], "words": ["Washington", "Oct", "the", "13", "1863", "Dear", "Friend", "I", "now", "sit", "down", "to", "write", "to", "write", "you", "a", "few", "lines", "to", "let", "you", "now", "where", "I", "am", "I", "am", "with", "the", "regiment", "now.", "I", "left", "Carlisle", "about", "one", "week", "ago", "and", "have", "ben", "diledaleying", "around", "&", "have", "not", "had", "time", "to", "rite", "to", "you", "untill", "now", "&", "I", "have", "not", "got", "much", "time", "now", "the", "toe", "is", "most", "all", "healed", "up", "but", "my", "foot", "is", "swelled", "so", "that", "I", "can", "not", "get", "my", "boot", "on", "it", "swelled", "from", "walking", "from", "the", "depot", "[", "out", "?", "]", "her", "but", "I", "think", "that", "will", "go", "down", "in", "a", "day", "or", "to", "the", "brigade", "is", "gone", "out", "to", "the", "front", "again", "&", "I", "dont", "now", "but", "we", "shall", "follow", "them", "pretty", "soon", "I", "dont", "now", "as", "I", "can", "write", "anny", "more", "at", "present", "So", "good", "by", "for", "this", "time", "Bethuel", "Smith1Co.", "F.", "2nd", "U.", "S.", "Cav.Washington", "DC"], "date": [], "normalizedTime": "0.187950496396", "recipient": "Walt Whitman", "organizations": [], "sender": "Bethuel Smith", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00889.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Bethuel Smith to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Julia", "NNP"], ["Stilwell", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Mr. Whitman", "Dear Friend", "Culpepper"], "money": [], "year": "1863", "locations": [], "month": "Oct", "parties": ["Julia Stilwell", "Walt Whitman"], "properDate": "Oct 13, 1863", "gpe": ["Washington", "Please"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [22.0666667, -75.71666669999999]], "text": " Mr. Whitman, Dear Friend I received your kind and ever welcome letter from you and glad to hear that my brother is so comfortable and many thanks to you for your kindness to him and to me in writing to let me know how he is and I hope that the lord will reward you for your kindness to us who are entire strangers to you and I am sure that I will and all of us will ever be gratefull to you and never will forget you or your kindness to us in our days of trouble  we had heard of our dear Brothers death2 and we was in hopes that James3 would not hear of it untill he got stronger Will you please be so kind as to inquire in Washington if we can go to Culpepper and get his body. they would not let us go some two weeks but we have heard since that they had given so many days for any one to go after bodies but we dont know if it is true or not and if you will Please inquire, we shall be very much obliged to you. Please write and let me know and oblige ", "dateText": "", "percents": [], "taggedText": [[[["Mr.", "NNP"], ["Whitman", "NNP"]], [",", ","], [["Dear", "NNP"], ["Friend", "NNP"]], ["I", "NNP"], ["received", "VBD"], ["your", "PRP$"], ["kind", "NN"], ["and", "CC"], ["ever", "RB"], ["welcome", "VB"], ["letter", "NN"], ["from", "IN"], ["you", "PRP"], ["and", "CC"], ["glad", "VBD"], ["to", "TO"], ["hear", "VB"], ["that", "IN"], ["my", "PRP$"], ["brother", "NN"], ["is", "VBZ"], ["so", "RB"], ["comfortable", "JJ"], ["and", "CC"], ["many", "JJ"], ["thanks", "NNS"], ["to", "TO"], ["you", "PRP"], ["for", "IN"], ["your", "PRP$"], ["kindness", "NN"], ["to", "TO"], ["him", "PRP"], ["and", "CC"], ["to", "TO"], ["me", "VB"], ["in", "IN"], ["writing", "NN"], ["to", "TO"], ["let", "VB"], ["me", "PRP"], ["know", "VB"], ["how", "WRB"], ["he", "PRP"], ["is", "VBZ"], ["and", "CC"], ["I", "PRP"], ["hope", "VBP"], ["that", "IN"], ["the", "DT"], ["lord", "NN"], ["will", "MD"], ["reward", "VB"], ["you", "PRP"], ["for", "IN"], ["your", "PRP$"], ["kindness", "NN"], ["to", "TO"], ["us", "PRP"], ["who", "WP"], ["are", "VBP"], ["entire", "JJ"], ["strangers", "NNS"], ["to", "TO"], ["you", "PRP"], ["and", "CC"], ["I", "PRP"], ["am", "VBP"], ["sure", "JJ"], ["that", "IN"], ["I", "PRP"], ["will", "MD"], ["and", "CC"], ["all", "DT"], ["of", "IN"], ["us", "PRP"], ["will", "MD"], ["ever", "RB"], ["be", "VB"], ["gratefull", "JJ"], ["to", "TO"], ["you", "PRP"], ["and", "CC"], ["never", "RB"], ["will", "MD"], ["forget", "VB"], ["you", "PRP"], ["or", "CC"], ["your", "PRP$"], ["kindness", "NN"], ["to", "TO"], ["us", "PRP"], ["in", "IN"], ["our", "PRP$"], ["days", "NNS"], ["of", "IN"], ["trouble", "NN"], ["we", "PRP"], ["had", "VBD"], ["heard", "VBN"], ["of", "IN"], ["our", "PRP$"], ["dear", "JJ"], [["Brothers", "NNS"]], [["death2", "NNP"]], ["and", "CC"], ["we", "PRP"], ["was", "VBD"], ["in", "IN"], ["hopes", "NNS"], ["that", "IN"], [["James3", "NNP"]], ["would", "MD"], ["no