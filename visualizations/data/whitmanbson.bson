, "Knoxville", ",", "but", "it", "is", "doubtful", "I", "think", "the", "9th", "Corps", "might", "take", "a", "rest", "awhile", "anyhow", "good", "bye", ",", "mother", "Walt"], "date": [], "normalizedTime": "0.181286549708", "recipient": "Louisa Van Velsor Whitman", "organizations": ["well1", "it2", "him4", "Fanny5"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00784.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to Louisa Van Velsor Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], ["C.", "NNP"], ["L.", "NNP"], ["Scott", "NNP"], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Friend", "Whitman Two", "Armory Square Hospital"], "money": [], "year": "1863", "locations": [], "month": "Aug", "parties": ["Walt Whitman"], "properDate": "Aug 31, 1863", "gpe": [], "facility": [], "latlngs": [], "text": "   Friend Whitman Two weeks have quickly passed by since I left Armory Square Hospital. My journey home was very pleasant to me & what made it the more so (I suppose) was the anticipation of once more being with my friends. I arrived here on the 19th the joy of friends on my arrival I will not attempt to say anything about, only it seemed to be great. you no doubt can imagain a little how I felt in being once more where all the blessings & comforts of life seemed to encompass me, but though I am now here, I cannot forget the suffering in our country caused by this unholy, ungodly & nevertobeforgotten war. My mind is taken back to when I lay suffering in the Hospital & I have a particular feeling of gratitude to you for the many pleasant hours (to me) we have spent together.  what  is more consoling to the helpless (when away from home) than to find a friend, one in whom we can confide & trust, as was my case when I first made your acquaintance somehow or other you seemed like a father, why it was so I am unable to say, yet such was the case,  & I hav'nt the least doubt but such has been the case with thousands of other fellow soldiers, but I will not weary your patience, suffice it to say that I feel to rejoice that my lot is no worse & may the spirit that ever directs aright protect & keep you to be a comfort & blessing to many a weary one in their days of trouble, I remain your affectionate friend & brother,   ", "dateText": "", "percents": [], "taggedText": [[[["Friend", "NN"]], [["Whitman", "NNP"], ["Two", "NNP"]], ["weeks", "NNS"], ["have", "VBP"], ["quickly", "RB"], ["passed", "VBN"], ["by", "IN"], ["since", "IN"], ["I", "PRP"], ["left", "VBD"], [["Armory", "NNP"], ["Square", "NNP"], ["Hospital", "NNP"]], [".", "."]], [["My", "PRP$"], ["journey", "NN"], ["home", "NN"], ["was", "VBD"], ["very", "RB"], ["pleasant", "JJ"], ["to", "TO"], ["me", "PRP"], ["&", "CC"], ["what", "WP"], ["made", "VBN"], ["it", "PRP"], ["the", "DT"], ["more", "RBR"], ["so", "RB"], ["(", ":"], ["I", "PRP"], ["suppose", "VBP"], [")", ":"], ["was", "VBD"], ["the", "DT"], ["anticipation", "NN"], ["of", "IN"], ["once", "RB"], ["more", "RBR"], ["being", "VBG"], ["with", "IN"], ["my", "PRP$"], ["friends", "NNS"], [".", "."]], [["I", "PRP"], ["arrived", "VBD"], ["here", "RB"], ["on", "IN"], ["the", "DT"], ["19th", "JJ"], ["the", "DT"], ["joy", "NN"], ["of", "IN"], ["friends", "NNS"], ["on", "IN"], ["my", "PRP$"], ["arrival", "NN"], ["I", "PRP"], ["will", "MD"], ["not", "RB"], ["attempt", "VB"], ["to", "TO"], ["say", "VB"], ["anything", "NN"], ["about", "IN"], [",", ","], ["only", "RB"], ["it", "PRP"], ["seemed", "VBD"], ["to", "TO"], ["be", "VB"], ["great", "JJ"], [".", "."]], [["you", "PRP"], ["no", "DT"], ["doubt", "NN"], ["can", "MD"], ["imagain", "VB"], ["a", "DT"], ["little", "RB"], ["how", "WRB"], ["I", "PRP"], ["felt", "VBD"], ["in", "IN"], ["being", "VBG"], ["once", "RB"], ["more", "JJR"], ["where", "WRB"], ["all", "DT"], ["the", "DT"], ["blessings", "NNS"], ["&", "CC"], ["comforts", "NNS"], ["of", "IN"], ["life", "NN"], ["seemed", "VBD"], ["to", "TO"], ["encompass", "NN"], ["me", "PRP"], [",", ","], ["but", "CC"], ["though", "IN"], ["I", "PRP"], ["am", "VBP"], ["now", "RB"], ["here", "RB"], [",", ","], ["I", "PRP"], ["can", "MD"], ["not", "RB"], ["forget", "VB"], ["the", "DT"], ["suffering", "NN"], ["in", "IN"], ["our", "PRP$"], ["country", "NN"], ["caused", "VBD"], ["by", "IN"], ["this", "DT"], ["unholy", "RB"], [",", ","], ["ungodly", "RB"], ["&", "CC"], ["nevertobeforgotten", "RB"], ["war", "JJ"], [".", "."]], [["My", "PRP$"], ["mind", "NN"], ["is", "VBZ"], ["taken", "VBN"], ["back", "RB"], ["to", "TO"], ["when", "WRB"], ["I", "PRP"], ["lay", "VBP"], ["suffering", "VBG"], ["in", "IN"], ["the", "DT"], [["Hospital", "NNP"]], ["&", "CC"], ["I", "PRP"], ["have", "VBP"], ["a", "DT"], ["particular", "JJ"], ["feeling", "NN"], ["of", "IN"], ["gratitude", "NN"], ["to", "TO"], ["you", "PRP"], ["for", "IN"], ["the", "DT"], ["many", "JJ"], ["pleasant", "NN"], ["hours", "NNS"], ["(", ":"], ["to", "TO"], ["me", "PRP"], [")", ":"], ["we", "PRP"], ["have", "VBP"], ["spent", "VBN"], ["together", "RP"], [".", "."]], [["what", "WP"], ["is", "VBZ"], ["more", "RBR"], ["consoling", "VBG"], ["to", "TO"], ["the", "DT"], ["helpless", "NN"], ["(", ":"], ["when", "WRB"], ["away", "RB"], ["from", "IN"], ["home", "NN"], [")", ":"], ["than", "IN"], ["to", "TO"], ["find", "VB"], ["a", "DT"], ["friend", "NN"], [",", ","], ["one", "CD"], ["in", "IN"], ["whom", "NN"], ["we", "PRP"], ["can", "MD"], ["confide", "VB"], ["&", "CC"], ["trust", "NN"], [",", ","], ["as", "IN"], ["was", "VBD"], ["my", "PRP$"], ["case", "NN"], ["when", "WRB"], ["I", "PRP"], ["first", "RB"], ["made", "VBD"], ["your", "PRP$"], ["acquaintance", "NN"], ["somehow", "NN"], ["or", "CC"], ["other", "JJ"], ["you", "PRP"], ["seemed", "VBD"], ["like", "IN"], ["a", "DT"], ["father", "NN"], [",", ","], ["why", "WRB"], ["it", "PRP"], ["was", "VBD"], ["so", "RB"], ["I", "PRP"], ["am", "VBP"], ["unable", "JJ"], ["to", "T