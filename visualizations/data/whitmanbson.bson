"John Burroughs", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/med.00437.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to John Burroughs ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Robert", "NNP"], ["Carter", "NNP"]], [",", ","]]], "people": ["Stevens st.", "Robert Carter", "Dear Sir", "Mr. Dana", "Ideal", "Verse", "Walt", "Whitman"], "money": [], "year": "1875", "locations": ["West"], "month": "May", "parties": ["Walt", "Whitman", "Robert Carter"], "properDate": "May 7, 1875", "gpe": ["Camden"], "facility": [], "latlngs": [[51.55170589999999, -0.1588255]], "text": "  431 Stevens st. cor West. Camden, N. Jersey.           May 7, '75                        Robert Carter,         Dear Sir,        Thinking that possibly I might be itemised or briefly biographised in the Cyclopaedia I thought I would send you,          (or to Mr. Dana,) the accompanying sketch   some authentic statistics, (as I find I am beginning to be noted,          & they make sad work of it sometimes.)        Leaving of course the whole thing in your hands, I should like you to get the statistics, the fact-basis,          right   (& should you think proper can be further consulted here, or proof sent, &c.)   My book Leaves of Grass          as now printed, is in its permanent form   My other Vol. of equal size Two Rivulets, (i.e. of Real and Ideal)          will comprise all my other writings, Prose & Verse, & is now being put into type. I am still prostrated with          Cerebral & liver affection, but work occasionally.         Walt Whitman        ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"]], ["cor", "NN"], [["West", "NNP"]], [".", "."]], [[["Camden", "NNP"]], [",", ","], ["N.", "NNP"], ["Jersey", "NNP"], [".", "."]], [["May", "NNP"], ["7", "CD"], [",", ","], ["'75", "-NONE-"], [["Robert", "NNP"], ["Carter", "NNP"]], [",", ","], [["Dear", "NNP"], ["Sir", "NNP"]], [",", ","], ["Thinking", "NNP"], ["that", "IN"], ["possibly", "RB"], ["I", "PRP"], ["might", "MD"], ["be", "VB"], ["itemised", "VBN"], ["or", "CC"], ["briefly", "RB"], ["biographised", "VBN"], ["in", "IN"], ["the", "DT"], [["Cyclopaedia", "NNP"]], ["I", "NNP"], ["thought", "VBD"], ["I", "PRP"], ["would", "MD"], ["send", "VB"], ["you", "PRP"], [",", ","], ["(", ":"], ["or", "CC"], ["to", "TO"], [["Mr.", "NNP"], ["Dana", "NNP"]], [",", ","], [")", "NNP"], ["the", "DT"], ["accompanying", "NN"], ["sketch", "NN"], ["some", "DT"], ["authentic", "JJ"], ["statistics", "NNS"], [",", ","], ["(", ":"], ["as", "IN"], ["I", "PRP"], ["find", "VBP"], ["I", "PRP"], ["am", "VBP"], ["beginning", "VBG"], ["to", "TO"], ["be", "VB"], ["noted", "VBN"], [",", ","], ["&", "CC"], ["they", "PRP"], ["make", "VBP"], ["sad", "JJ"], ["work", "NN"], ["of", "IN"], ["it", "PRP"], ["sometimes", "VBZ"], [".", "."]], [[")", "NN"], ["Leaving", "NNP"], ["of", "IN"], ["course", "NN"], ["the", "DT"], ["whole", "JJ"], ["thing", "NN"], ["in", "IN"], ["your", "PRP$"], ["hands", "NNS"], [",", ","], ["I", "PRP"], ["should", "MD"], ["like", "VB"], ["you", "PRP"], ["to", "TO"], ["get", "VB"], ["the", "DT"], ["statistics", "NNS"], [",", ","], ["the", "DT"], ["fact-basis", "NN"], [",", ","], ["right", "RB"], ["(", ":"], ["&", "CC"], ["should", "MD"], ["you", "PRP"], ["think", "VB"], ["proper", "JJ"], ["can", "NN"], ["be", "VB"], ["further", "JJ"], ["consulted", "VBN"], ["here", "RB"], [",", ","], ["or", "CC"], ["proof", "IN"], ["sent", "NN"], [",", ","], ["&", "CC"], ["c.", "NNP"], [")", "NNP"], ["My", "NNP"], ["book", "NN"], ["Leaves", "VBZ"], ["of", "IN"], [["Grass", "NNP"]], ["as", "IN"], ["now", "RB"], ["printed", "VBN"], [",", ","], ["is", "VBZ"], ["in", "IN"], ["its", "PRP$"], ["permanent", "NN"], ["form", "NN"], ["My", "NNP"], ["other", "JJ"], ["Vol", "NNP"], [".", "."]], [["of", "IN"], ["equal", "JJ"], ["size",