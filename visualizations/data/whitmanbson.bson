 "year": "1876", "locations": ["West"], "month": "Jan", "parties": ["Walt", "Whitman", "Peter Doyle"], "properDate": "Jan 22, 1876", "gpe": ["Camden"], "facility": [], "latlngs": [[51.55170589999999, -0.1588255]], "text": "  431 Stevens st. cor West. Camden,           N. Jersey.           Jan. 22.                            All is going on with me full as comfortably as I can expect. A dark, drizzly,          very slippery day here   Keeps me in. Your papers & letter rec'd.         WW        ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"]], ["cor", "NN"], [["West", "NNP"]], [".", "."]], [[["Camden", "NNP"]], [",", ","], ["N.", "NNP"], ["Jersey", "NNP"], [".", "."]], [["Jan.", "NNP"], ["22", "CD"], [".", "."]], [["All", "DT"], ["is", "VBZ"], ["going", "VBG"], ["on", "IN"], ["with", "IN"], ["me", "PRP"], ["full", "JJ"], ["as", "IN"], ["comfortably", "RB"], ["as", "IN"], ["I", "PRP"], ["can", "MD"], ["expect", "VB"], [".", "."]], [["A", "DT"], ["dark", "NN"], [",", ","], ["drizzly", "RB"], [",", ","], ["very", "RB"], ["slippery", "JJ"], ["day", "NN"], ["here", "RB"], ["Keeps", "NNP"], ["me", "PRP"], ["in", "IN"], [".", "."]], [["Your", "PRP$"], ["papers", "NNS"], ["&", "CC"], ["letter", "NN"], ["rec", "NN"], ["'d", "MD"], [".", "."]], [["WW", "NNP"]]], "sentences": ["  431 Stevens st. cor West.", "Camden,           N. Jersey.", "Jan. 22.", "All is going on with me full as comfortably as I can expect.", "A dark, drizzly,          very slippery day here   Keeps me in.", "Your papers & letter rec'd.", "WW        "], "words": ["431", "Stevens", "st.", "cor", "West.", "Camden", ",", "N.", "Jersey.", "Jan.", "22.", "All", "is", "going", "on", "with", "me", "full", "as", "comfortably", "as", "I", "can", "expect.", "A", "dark", ",", "drizzly", ",", "very", "slippery", "day", "here", "Keeps", "me", "in.", "Your", "papers", "&", "letter", "rec'd.", "WW"], "date": [], "normalizedTime": "0.797769617843", "recipient": "Peter Doyle", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/nyp.00385.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Peter Doyle ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Whitelaw", "NNP"], ["Reid", "NNP"]], [",", ","]]], "people": ["Walt", "Stevens st.", "Camden"], "money": [], "year": "1876", "locations": [], "month": "Feb", "parties": ["Walt", "Whitman", "Whitelaw Reid"], "properDate": "Feb 8, 1876", "gpe": [], "facility": [], "latlngs": [], "text": "  private  Calculated to make from 2 1/3d to 2 2/3d columns, in the ordinary nonpareil, (or minion, is it?) you use for reading matter.        If convenient, when in type, send me a (revised) proof, which I will return by next mail.         Walt Whitman        431 Stevens st. | Camden, | N. Jersey.          ", "dateText": "", "percents": [], "taggedText": [[["private", "JJ"], ["Calculated", "VBN"], ["to", "TO"], ["make", "VB"], ["from", "IN"], ["2", "CD"], ["1/3d", "CD"], ["to", "TO"], ["2", "CD"], ["2/3d", "CD"], ["columns", "NNS"], [",", ","], ["in", "IN"], ["the", "DT"], ["ordinary", "JJ"], ["nonpareil", "NN"], [",", ","], ["(", ":"], ["or", "CC"], ["minion", "NN"], [",", ","], ["is", "VBZ"], ["it", "PRP"], ["?", "."]], [[")", "NN"], ["you", "PRP"], ["use", "VBP"], ["for", "IN"], ["reading", "NN"], ["matter", "NN"], [".", "."]], [["If", "IN"], ["convenient", "JJ"], [",", ","], ["when", "WRB"], ["in", "IN"], ["type", "NN"], [",", ","], ["send", "NN"], ["me", "PRP"], ["a", "DT"], ["(", "NN"], ["revised", "VBN"], [")", "-NONE-"], ["proof", "IN"], [",", ","], ["which", "WDT"], ["I", "PRP"], ["will", "MD"], ["return", "VB"], ["by", "IN"], ["next", "JJ"], ["mail", "NN"], [".", "."]], [[["Walt", "NNP"]], ["Whitman", "NNP"], ["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"]], ["|", "NNP"], [["Camden", "NNP"]], [",", ","], ["|", "NNP"], ["N.", "NNP"], ["Jersey", "NNP"], [".", "."]]], "sentences": ["  private  Calculated to make from 2 1/3d to 2 2/3d columns, in the ordinary nonpareil, (or minion, is it?", ") you use for reading matter.", "If convenient, when in type, send me a (revised) proof, which I will return by next mail.", "Walt Whitman        431 Stevens st. | Camden, | N. Jersey.          "], "words": ["private", "Calculated", "to", "make", "from", "2", "1/3d", "to", "2", "2/3d", "columns", ",", "in", "the", "ordinary", "nonpareil", ",", "(", "or", "minion", ",", "is", "it", "?", ")", "you", "use", "for", "reading", "matter.", "If", "convenient", ",", "when", "in", "type", ",", "send", "me", "a", "(", "revised", ")", "proof", ",", "which", "I", "will", "return", "by", "next", "mail.", "Walt", "Whitman", "431", "Stevens", "st.", "|", "Camden", ",", "|", "N.", "Jersey", "."], "date": [], "normalizedTime": "0.800081599347", "recipient": "Whitelaw Reid", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/loc.02826.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Whitelaw Reid ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Ellen", "NNP"], ["M.", "NNP"]], ["O'Connor", "NNP"], [",", ","]]], "people": ["Stevens st.", "Jersey Feb", "Dear", "Nelly", "Lesley", "Lesleys", "Lyman", "Lyman", "Miss", "Hector Tyndale", "Clinton", "Hector", "Marvin", "Peter Doyle"], "money": [], "year": "1876", "locations": ["West"], "month": "Feb", "parties": ["Walt", "Whitman", "Ellen M."], "properDate": "Feb 29, 1876", "gpe": ["Camden", "London", "Wash", "English", "Walt"], "facility": [], "latlngs": [[51.55170589999999, -0.1588255], [51.51121389999999, -0.1198244], [38.0332695, -78.5059101], [43.9653889, -70.8226541]], "text": "  431 Stevens st. cor West. Camden,           N. Jersey           Feb: 29.                             Dear Nelly:        About me, my ailments, no great difference. (A queer old doctor here   did I tell you?   sticks to it that,          although the trouble has taken the form of paralysis, & instigated far back, the basic & origin are of          stomachic nature   at any rate the derangement & suffering now          are mostly gastric & liver business   telling in distress of head)    I went over to PhilPhil: yesterday, & had a nice, good, I may almost say happy afternoon, with dear Mrs. Lesley,          Kate Hillard, & the two Miss Lesleys, daughters   us four, only, no men-critters but me   I was there some four hours,          filled with animated talk   we had dinner, very nice, a nice glass of wine   Mrs. L. a fine gentle, sweet-voiced,          handsome black-eyed New England woman, (of the Lyman family, daughter of Judge Lyman.) With Miss H[illard], though the first meeting, I got along capitally   found her a jolly, hearty girl   evidently seen life & folks, & read lots   she talked much about the London literati,          & the (I suppose I may say) personal friends of mine there, both men & women, nearly all of whom she knew well,          giving me, among the rest, descriptions of Personnel that were new & very interesting to me. She goes to Wash[ington]          to-morrow, to stay there (1734 I st.) a month   reads a series of twelve papers on English poets.        I made a short call on Hector Tyndale, 1021 Clinton st   he came down to see me, in the parlor   (I did not see Mrs. T.)   Hector did not seem much different, physically   had the tone, I thought,          of one who is dreary of life, to whom it is all an ennui, a settled morbidity   of course that was the worst.          I rec'd a letter from Marvin to-day   from Peter Doyle yesterday   snowing here as I write   the baby fine,          fat, bright today, but raising his voice lustily just this moment   You got my letter three days since?         Walt           ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"]], ["cor", "NN"], [["West", "NNP"]], [".", "."]], [[["Camden", "NNP"]], [",", ","], ["N.", "NNP"], [["Jersey", "NNP"], ["Feb", "NNP"]], [":", ":"], ["29", "CD"], [".", "."]], [[["Dear", "NNP"]], [["Nelly", "NNP"]], [":", ":"], ["About", "IN"], ["me", "PRP"], [",", ","], ["my", "PRP$"], ["ailments", "NNS"], [",", ","], ["no", "DT"], ["great", "JJ"], ["difference", "NN"], [".", "."]], [["(", "NN"], ["A", "DT"], ["queer", "NN"], ["old", "JJ"], ["doctor", "NN"], ["here", "RB"], ["did", "VBD"], ["I", "PRP"], ["tell", "VBP"], ["you", "PRP"], ["?", "."]], [["sticks", "NNS"], ["to", "TO"], ["it", "PRP"], ["that", "IN"], [",", ","], ["although", "IN"], ["the", "DT"], ["trouble", "NN"], ["has", "VBZ"], ["taken", "VBN"], ["the", "DT"], ["form", "NN"], ["of", "IN"], ["paralysis", "NN"], [",", ","], ["&", "CC"], ["instigated", "VBN"], ["far", "RB"], ["back", "RB"], [",", ","], ["the", "DT"], ["basic", "JJ"], ["&", "CC"], ["origin", "NN"], ["are", "VBP"], ["of", "IN"], ["stomachic", "JJ"], ["nature", "NN"], ["at", "IN"], ["any", "DT"], ["rate", "NN"], ["the", "DT"], ["derangement", "NN"], ["&", "CC"], ["suffering", "NN"], ["now", "RB"], ["are", "VBP"], ["mostly", "RB"], ["gastric", "JJ"], ["&", "CC"], ["liver", "RB"], ["business", "NN"], ["telling", "VBG"], ["in", "IN"], ["distress", "NN"], ["of", "IN"], ["head", "NN"], [")", ":"], ["I", "PRP"], ["went", "VBD"], ["over", "RB"], ["to", "TO"], [["PhilPhil", "NNP"]], [":", ":"], ["yesterday", "NN"], [",", ","], ["&", "CC"], ["had", "VBD"], ["a", "DT"], ["nice", "JJ"], [",", ","], ["good", "JJ"], [",", ","], ["I", "PRP"], ["may", "MD"], ["almost", "RB"], ["say", "VB"], ["happy", "JJ"], ["afternoon", "NN"], [",", ","], ["with", "IN"], ["dear", "JJ"], ["Mrs.", "NNP"], [["Lesley", "NNP"]], [",", ","], [["Kate", "NNP"], ["Hillard", "NNP"]], [",", ","], ["&", "CC"], ["the", "DT"], ["two", "CD"], ["Miss", "NNP"], [["Lesleys", "NNP"]], [",", ","], ["daughters", "NNS"], ["us", "PRP"], ["four", "CD"], [",", ","], ["only",