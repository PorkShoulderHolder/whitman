"copy7", "Papers", "Scottish American", "strata9"], "sender": "Thayer", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00576.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Thayer & Eldridge to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["James", "NNP"], ["Redpath", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Walt Whitman", "Walt", "Brigade", "James Redpath"], "money": [], "year": "1860", "locations": [], "month": "Jun", "parties": ["James Redpath", "Walt Whitman"], "properDate": "Jun 25, 1860", "gpe": ["Malden"], "facility": [], "latlngs": [[42.4250964, -71.066163]], "text": "  Malden, June 25th, 1860.  O rare Walt Whitman! I said I would write to you about your Book when I found time to read it as it was written to be read. But I take back my promise. For if you are not sane what will writing avail? and if you are sane your writings are alive with richest sanity. Now, if I do not understand them, or any parts of them, what good will it do to say so   silence, it seems to me, is a duty till I do understand them; and then again, if I do understand them, or when I shall do so, what good will it do to tell you of the fact? It is a waste of breath for my friend to tell me I am healthy when my pulse records the circumstance so often every minute. I love you, Walt! A Conquering Brigade will ere long march to the music of your barbaric jawp. Ever and truly  James Redpath.  ", "dateText": "", "percents": [], "taggedText": [[[["Malden", "NNP"]], [",", ","], ["June", "NNP"], ["25th", "CD"], [",", ","], ["1860", "CD"], [".", "."]], [["O", "NNP"], ["rare", "VBP"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["!", "."]], [["I", "PRP"], ["said", "VBD"], ["I", "PRP"], ["would", "MD"], ["write", "VB"], ["to", "TO"], ["you", "PRP"], ["about", "IN"], ["your", "PRP$"], ["Book", "NNP"], ["when", "WRB"], ["I", "PRP"], ["found", "VBP"], ["time", "NN"], ["to", "TO"], ["read", "VB"], ["it", "PRP"], ["as", "IN"], ["it", "PRP"], ["was", "VBD"], ["written", "VBN"], ["to", "TO"], ["be", "VB"], ["read", "VBN"], [".", "."]], [["But", "CC"], ["I", "PRP"], ["take", "VBP"], ["back", "RP"], ["my", "PRP$"], ["promise", "NN"], [".", "."]], [["For", "IN"], ["if", "IN"], ["you", "PRP"], ["are", "VBP"], ["not", "RB"], ["sane", "JJ"], ["what", "WP"], ["will", "MD"], ["writing", "VB"], ["avail", "NN"], ["?", "."]], [["and", "CC"], ["if", "IN"], ["you", "PRP"], ["are", "VBP"], ["sane", "JJ"], ["your", "PRP$"], ["writings", "NNS"], ["are", "VBP"], ["alive", "JJ"], ["with", "IN"], ["richest", "JJS"], ["sanity", "NN"], [".", "."]], [["Now", "RB"], [",", ","], ["if", "IN"], ["I", "PRP"], ["do", "VBP"], ["not", "RB"], ["understand", "VB"], ["them", "PRP"], [",", ","], ["or", "CC"], ["any", "DT"], ["parts", "NNS"], ["of", "IN"], ["them", "PRP"], [",", ","], ["what", "WP"], ["good", "JJ"], ["will", "MD"], ["it", "PRP"], ["do", "VB"], ["to", "TO"], ["say", "VB"], ["so", "RB"], ["silence", "NN"], [",", ","], ["it", "PRP"], ["seems", "VBZ"], ["to", "TO"], ["me", "PRP"], [",", ","], ["is", "VBZ"], ["a", "DT"], ["duty", "NN"], ["till", "IN"], ["I", "PRP"], ["do", "VBP"], ["understand", "RB"], ["them", "PRP"], [";", ":"], ["and", "CC"], ["then", "RB"], ["again", "RB"], [",", ","], ["if", "IN"], ["I", "PRP"], ["do", "VBP"], ["understand", "RB"], ["them", "PRP"], [",", ","], ["or", "CC"], ["when", "WRB"], ["I", "PRP"], ["shall", "MD"], ["do", "VB"], ["so", "RB"], [",", ","], ["what", "WDT"], ["good", "JJ"], ["will", "MD"], ["it", "PRP"], ["do", "VB"], ["to", "TO"], ["tell", "VB"], ["you", "PRP"], ["of", "IN"], ["the", "DT"], ["fact", "NN"], ["?", "."]], [["It", "PRP"], ["is", "VBZ"], ["a", "DT"], ["waste", "NN"], ["of", "IN"], ["breath", "NN"], ["for", "IN"], ["my", "PRP$"], ["friend", "NN"], ["to", "TO"], ["tell", "VB"], ["me", "PRP"], ["I", "PRP"], ["am", "VBP"], ["healthy", "JJ"], ["when", "WRB"], ["my", "PRP$"], ["pulse", "NN"], ["records", "NNS"], ["the", "DT"], ["circumstance", "NN"], ["so", "RB"], ["often", "RB"], ["every", "DT"], ["minute", "NN"], [".", "."]], [["I", "PRP"], ["love", "VBP"], ["you", "PRP"], [",", ","], [["Walt", "NNP"]], ["!", "."]], [["A", "DT"], ["Conquering", "NNP"], [["Brigade", "NNP"]], ["will", "MD"], ["ere", "VB"], ["long", "JJ"], ["march", "NN"], ["to", "TO"], ["the", "DT"], ["music", "NN"], ["of", "IN"], ["your", "PRP$"], ["barbaric", "JJ"], ["jawp", "NN"], [".", "."]], [["Ever", "RB"], ["and", "CC"], ["truly", "RB"], [["James", "NNP"], ["Redpath", "NNP"]], [".", "."]]], "sentences": ["  Malden, June 25th, 1860.", "O rare Walt Whitman!", "I said I would write to you about your Book when I found time to read it as it was written to be read.", "But I take back my promise.", "For if you are not sane what will writing avail?", "and if you are sane your writings are alive with richest sanity.", "Now, if I do not understand them, or any parts of them, what good will it do to say so   silence, it seems to me, is a duty till I do understand them; and then again, if I do understand them, or when I shall do so, what good will it do to tell you of the fact?", "It is a waste of breath for my friend to tell me I am healthy when my pulse records the circumstance so often every minute.", "I love you, Walt!", "A Conquering Brigade will ere long march to the music of your barbaric jawp.", "Ever and truly  James Redpath.  "], "words": ["Malden", ",", "June", "25th", ",", "1860.", "O", "rare", "Walt", "Whitman", "!", "I", "said", "I", "would", "write", "to", "you", "about", "your", "Book", "when", "I", "found", "time", "to", "read", "it", "as", "it", "was", "written", "to", "be", "read.", "But", "I", "take", "back", "my", "promise.", "For", "if", "you", "are", "not", "sane", "what", "will", "writing", "avail", "?", "and", "if", "you", "are", "sane", "your", "writings", "are", "alive", "with", "richest", "sanity.", "Now", ",", "if", "I", "do", "not", "understand", "them", ",", "or", "any", "parts", "of", "them", ",", "what", "good", "will", "it", "do", "to", "say", "so", "silence", ",", "it", "seems", "to", "me", ",", "is", "a", "duty", "till", "I", "do", "understand", "them", ";", "and", "then", "again", ",", "if", "I", "do", "understand", "them", ",", "or", "when", "I", "shall", "do", "so", ",", "what", "good", "will", "it", "do", "to", "tell", "you", "of", "the", "fact", "?", "It", "is", "a", "waste", "of", "breath", "for", "my", "friend", "to", "tell", "me", "I", "am", "healthy", "when", "my", "pulse", "records", "the", "circumstance", "so", "often", "every", "minute.", "I", "love", "you", ",", "Walt", "!", "A", "Conquering", "Brigade", "will", "ere", "long", "march", "to", "the", "music", "of", "your", "barbaric", "jawp.", "Ever", "and", "truly", "James", "Redpath", "."], "date": [], "normalizedTime": "0.0240718074255", "recipient": "Walt Whitman", "organizations": [], "sender": "James Redpath", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.01012.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from James Redpath to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Susan", "NNP"], ["Garnet", "NNP"], ["Smith", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Know", "Walt Whitman", "Mill", "Know", "Susan", "Garnet Smith Hartford"], "money": [], "year": "1860", "locations": [], "month": "Jul", "parties": ["Susan Garnet Smith", "Walt Whitman"], "properDate": "Jul 11, 1860", "gpe": ["America", "Mine", "Write"], "facility": [], "latlngs": [], "text": "  Hartford, July 11th, 1860.  Know Walt Whitman that I am a woman! I am not beautiful, but I love you! I am thirty-two years old. I am one of the workers of the world. A friend carelessly lends me Leaves of Grass for a day. Stealing an hour from labor I take it out for a walk. I do not know what I carry in my arms pressed close to my side and bosom! I feel a strange new sympathy! a mysterious delicious thrill! what means it? It is the loving contact of an affinite soul blending harmoniously with mine. I begin to know Walt Whitman. I have not yet seen him. I feel that I must be alone. I turn my steps to \"Zion's Mill\" a cemetery. The sun shines, the air is clean and fine, the birds trill songs, love songs, songs of praise for the boon of existence, or chirrup amorously to each other. They do not hesitate to tell their love: why should I? I seat myself under a tree and muse a moment. A lovely panorama is before me. Hartford and the surrounding country. I hear no human voice, see no human form. The ashes of the dead are spread around me. \"Did I say the dead?\" I am alone. \"Am I alone?\" I could sit thus forever with my newly-found soul. But somebody whispers, open your book! What care I for books now (though loved companions ever before). I have that which is better than books. The book opens itself. What do I behold! oh! blessed eyes! I see the image of the great beloved soul, which has already embraced encompassed me. Blessed be thy father and thy mother and the hour of thy conception. Oh! rich is America in her noble, manly, fearless son. Know Walt Whitman that thou hast a child for me! A noble beautiful perfect manchild. I charge you my love not to give it to another woman. The world demands it! It is not for you and me, is our child, but for the world. My womb is clean and pure. It is ready for thy child my love. Angels guard the vestibule until thou comest to deposit our and the world's precious treasure. Then oh! how tenderly, oh! how lovingly will I cherish and guard it, our child my love. Thine the pleasure my love. Mine the sweet burden and pain. Mine the sacrifice. Mine to have the stinging rebuke, the shame. I am willing. My motives are pure and holy. Our boy my love! Do you not already love him? He must be begotten on a mountain top, in the open air. Not in lust, not in mere gratification of sensual passion, but in holy ennobling pure strong deep glorious passionate broad universal love. I charge you to prepare my love. I love you, I love you, come, come. Write.  Susan Garnet Smith  Hartford, Connecticut   ", "dateText": "", "percents": [], "taggedText": [[[["Hartford", "NNP"]], [",", ","], ["July", "NNP"], ["11th", "JJ"], [",", ","], ["1860", "CD"], [".", "."]], [[["Know", "NNP"]], [["Walt", "NNP"]], ["Whitman", "NNP"], ["that", "IN"], ["I", "PRP"], ["am", "VBP"], ["a", "DT"], ["woman", "NN"], ["!", "."]], [["I", "PRP"], ["am", "VBP"], ["not", "RB"], ["beautiful", "JJ"], [",", ","], ["but", "CC"], ["I", "PRP"], ["love", "VBP"], ["you", "PRP"], ["!", "."]], [["I", "PRP"], ["am", "VBP"], ["thirty-two", "CD"], ["years", "NNS"], ["old", "JJ"], [".", "."]], [["I", "PRP"], ["am", "VBP"], ["one", "CD"], ["of", "IN"], ["the", "DT"], ["workers", "NNS"], ["of", "IN"], ["the", "DT"], ["world", "NN"], [".", "."]], [["A", "DT"], ["friend", "NN"], ["carelessly", "RB"], ["lends", "VBZ"], ["me", "PRP"], ["Leaves", "VBZ"], ["of", "IN"], [["Grass", "NNP"]], ["for", "IN"], ["a", "DT"], ["day", "NN"], [".", "."]], [["Stealing", "VBG"], ["an", "DT"], ["hour", "NN"], ["from", "IN"], ["labor", "NN"], ["I", "PRP"], ["take", "VBP"], ["it", "PRP"], ["out", "RP"], ["for", "IN"], ["a", "DT"], ["walk", "NN"], [".", "."]], [["I", "PRP"], ["do", "VBP"], ["not", "RB"], ["know", "VB"], ["what", "WP"], ["I", "PRP"], ["carry", "VBP"], ["in", "IN"], ["my", "PRP$"], ["arms", "NNS"], ["pressed", "VBN"], ["close", "JJ"], ["to", "TO"], ["my", "PRP$"], ["side", "NN"], ["and", "CC"], ["bosom", "NN"], ["!", "."]], [["I", "PRP"], ["feel", "VBP"], ["a", "DT"], ["strange", "NN"], ["new", "JJ"], ["sympathy", "NN"], ["!", "."]], [["a", "DT"], ["mysterious", "JJ"], ["delicious", "JJ"], ["thrill", "NN"], ["!", "."]], [["what", "WP"], ["means", "VBZ"], ["it", "PRP"], ["?", "."]], [["It", "PRP"], ["is", "VBZ"], ["the", "DT"], ["loving", "NN"], ["contact", "NN"], ["of", "IN"], ["an", "DT"], ["affinite", "JJ"], ["soul", "