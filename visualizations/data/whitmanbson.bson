", "this", "story", "or", "not", ",", "I", "can", "not", "tell", "the", "city", "is", "full", "of", "rumors", "&", "this", "may", "be", "one", "of", "them", "the", "government", "is", "not", "in", "receipt", "of", "any", "information", "to-day", "Grant", "has", "taken", "the", "reins", "entirely", "in", "his", "own", "hands", "he", "is", "really", "dictator", "at", "present", "we", "shall", "hear", "something", "important", "within", "two", "or", "three", "days", "Grant", "is", "very", "secretive", "indeed", "he", "bothers", "himself", "very", "little", "about", "sending", "news", "even", "to", "the", "President", "or", "Stanton", "time", "only", "can", "develope", "his", "plans", "I", "still", "think", "he", "is", "going", "to", "take", "Richmond", "&", "soon", ",", "(", "but", "I", "may", "be", "mistaken", "as", "I", "have", "been", "in", "past", ")", "Well", ",", "dearest", "mother", ",", "keep", "up", "good", "courage", ",", "good", "bye", "for", "present", "I", "wish", "you", "would", "write", "soon", "Walt"], "date": [], "normalizedTime": "0.21596627227", "recipient": "Louisa Van Velsor Whitman", "organizations": ["Army", "Potomac", "Rapidan", "Army", "Manassas", "Fortress Monroe", "Rapidan Butler", "Ohio"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00823.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to Louisa Van Velsor Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["John", "NNP"], ["F.", "NNP"], ["S.", "NNP"], ["Gray", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": [], "money": [], "year": "1864", "locations": [], "month": "May", "parties": ["John F. S. Gray", "Walt Whitman"], "properDate": "May 7, 1864", "gpe": ["Good"], "facility": [], "latlngs": [], "text": "   Good bye! We are suddenly ordered away to the South-west.  I will write you when we get settled!   ", "dateText": "", "percents": [], "taggedText": [[[["Good", "NNP"]], ["bye", "NN"], ["!", "."]], [["We", "PRP"], ["are", "VBP"], ["suddenly", "RB"], ["ordered", "VBN"], ["away", "RB"], ["to", "TO"], ["the", "DT"], ["South-west", "JJS"], [".", "."]], [["I", "PRP"], ["will", "MD"], ["write", "VB"], ["you", "PRP"], ["when", "WRB"], ["we", "PRP"], ["get", "VBP"], ["settled", "VBN"], ["!", "."]]], "sentences": ["   Good bye!", "We are suddenly ordered away to the South-west.", "I will write you when we get settled!   "], "words": ["Good", "bye", "!", "We", "are", "suddenly", "ordered", "away", "to", "the", "South-west.", "I", "will", "write", "you", "when", "we", "get", "settled", "!"], "date": [], "normalizedTime": "0.216102271182", "recipient": "Walt Whitman", "organizations": [], "sender": "John F. S. Gray", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/nyp.00162.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from John F. S. Gray to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Isaac", "NNP"], ["Livensparger", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Dear", "Isaac Livensparger", "Address Lykens", "Crawford Co"], "money": [], "year": "1864", "locations": [], "month": "May", "parties": ["Isaac Livensparger", "Walt Whitman"], "properDate": "May 7, 1864", "gpe": ["Washington", "Baltimore", "Bucyrus", "Washington"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [39.2903848, -76.6121893], [40.8083909, -82.97546489999999], [38.8951118, -77.0363658]], "text": " Dear Father, As I always wish to fulfill my promises I will enjoy this afternoon in writing a letter in order to let you know how I got home and how my health is    So I left Washington that evening at 5 Oc and got to Baltimore at 7 and left at 6 and got to Harisburg at two in the night. I changed cars and was off in a few minutes in the morning of the 4th Wednesday a train just a head of us run off track and was hurt which throwed us back six hours we ought to have got to Pittsburg at one that day But did not get in until after six then I had to wait until two in the night   But I was glad of it. I went to the Soldiers Home and got my supper and took a good sleep   I left Pittsburg a little after 2 after that we run right through   I got to Bucyrus just in time for dinner. I had good luck there was one of my Fathers old acquaintances there in a bugy [took me] straight on home to the door whar I had a grand interunion with my friends   I found all of them in good health   they were a little supprised to see me but they had been looking for me every day for a long time everything is a month behind things in Washington    It snowed all day this Monday the roads are very bad people are just getting their roads [open] the trees are just beginning to put forth their leafs. If my friend is in the Hospital yet tell him I got home all right   I guess I will close by biding you good by for this time and request from you to send a letter in return at some later time. I am very respectfully your soldier boy Isaac Livensparger, Address Lykens, Crawford Co[unty] Ohio   ", "dateText": "", "percents": [], "taggedText": [[[["Dear", "NNP"]], [["Father", "NNP"]], [",", ","], ["As", "NNP"], ["I", "PRP"], ["always", "RB"], ["wish", "JJ"], ["to", "TO"], ["fulfill", "VB"], ["my", "PRP$"], ["promises", "NNS"], ["I", "PRP"], ["will", "MD"], ["enjoy", "VB"], ["this", "DT"], ["afternoon", "NN"], ["in", "IN"], ["writing", "NN"], ["a", "DT"], ["letter", "NN"], ["in", "IN"], ["order", "NN"], ["to", "TO"], ["let", "VB"], ["you", "PRP"], ["know", "VB"], ["how", "WRB"], ["I", "PRP"], ["got", "VBD"], ["home", "NN"], ["and", "CC"], ["how", "WRB"], ["my", "PRP$"], ["health", "NN"], ["is", "VBZ"], ["So", "RB"], ["I", "PRP"], ["left", "VBD"], [["Washington", "NNP"]], ["that", "IN"], ["evening", "VBG"], ["at", "IN"], ["5", "CD"], ["Oc", "NNP"], ["and", "CC"], ["got", "VBD"]