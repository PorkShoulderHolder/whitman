ce/reconstruction/tei/loc.01289.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Francis P. Church to Walt Whitman ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Charles", "NNP"], ["F.", "NNP"], ["Blanch", "NNP"]], [",", ","]]], "people": ["Mr. Burroughs", "Walt", "Whitman"], "money": [], "year": "1869", "locations": [], "month": "Jun", "parties": ["Walt", "Whitman", "Charles F. Blanch"], "properDate": "Jun 4, 1869", "gpe": ["Washington"], "facility": [], "latlngs": [[38.8951118, -77.0363658]], "text": "  Attorney General's Office Washington,                     June 4, 1869                                  Dear Sir:              Your letters have been received. I cordially accept your appreciation & sympathy.              I send you, same mail with this, a copy of my book, as requested   Also a copy of Mr. Burroughs's \"Notes,\" which I have procured. Also a late photograph,                  accompanied by a picture taken in 1855, very good at the time. Also a late newspaper.              Since the book, there have been several pieces of mine, in magazines.                  I will endeavor to procure them, (or some of them,) & forward you.                               I send you my thanks & good will.                                  Walt Whitman              ", "dateText": "", "percents": [], "taggedText": [[["Attorney", "NNP"], ["General", "NNP"], ["'s", "POS"], ["Office", "NNP"], [["Washington", "NNP"]], [",", ","], ["June", "NNP"], ["4", "CD"], [",", ","], ["1869", "CD"], ["Dear", "NNP"], ["Sir", "NNP"], [":", ":"], ["Your", "PRP$"], ["letters", "NNS"], ["have", "VBP"], ["been", "VBN"], ["received", "VBN"], [".", "."]], [["I", "PRP"], ["cordially", "RB"], ["accept", "VB"], ["your", "PRP$"], ["appreciation", "NN"], ["&", "CC"], ["sympathy", "JJ"], [".", "."]], [["I", "PRP"], ["send", "VBP"], ["you", "PRP"], [",", ","], ["same", "JJ"], ["mail", "NN"], ["with", "IN"], ["this", "DT"], [",",