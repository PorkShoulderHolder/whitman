 "PRP"], ["believe", "VBP"], ["he", "PRP"], ["has", "VBZ"], ["a", "DT"], ["great", "JJ"], ["desire", "NN"], ["to", "TO"], ["as", "RB"], ["he", "PRP"], ["speaks", "VBZ"], ["of", "IN"], ["you", "PRP"], ["in", "IN"], ["every", "DT"], ["letter", "NN"], ["I", "PRP"], ["presume", "VBP"], ["you", "PRP"], ["have", "VBP"], ["seen", "VBN"], ["some", "DT"], ["of", "IN"], ["my", "PRP$"], [["Washington", "NNP"]], ["friends", "NNS"], ["ere", "VBP"], ["this", "DT"], [",", ","], ["and", "CC"], ["I", "PRP"], ["hope", "VBP"], ["to", "TO"], ["hear", "VB"], ["from", "IN"], ["them", "PRP"], ["when", "WRB"], ["I", "PRP"], ["hear", "VBP"], ["from", "IN"], ["you", "PRP"], [".", "."]], [["If", "IN"], ["you", "PRP"], ["see", "VBP"], [["Miss", "NNP"], ["Howard", "NNP"]], ["please", "NN"], ["remember", "NN"], ["me", "PRP"], ["to", "TO"], ["her", "PRP$"], ["as", "IN"], ["you", "PRP"], ["know", "VBP"], ["I", "PRP"], ["have", "VBP"], ["good", "JJ"], ["reason", "NN"], ["to", "TO"], ["thank", "VB"], ["her", "PRP$"], ["for", "IN"], ["many", "JJ"], ["a", "DT"], ["kind", "NN"], ["turn", "NN"], ["which", "WDT"], ["she", "PRP"], ["wrought", "VBD"], ["for", "IN"], ["me", "PRP"], ["during", "IN"], ["my", "PRP$"], ["stay", "NN"], ["in", "IN"], ["that", "DT"], ["city2", "NNP"], [".", "."]], [["I", "PRP"], ["can", "MD"], ["not", "RB"], ["forget", "VB"], [["Armory", "NNP"], ["Square", "NNP"]], ["hospital", "NN"], ["and", "CC"], ["I", "PRP"], ["have", "VBP"], ["a", "DT"], ["strong", "JJ"], ["desire", "NN"], ["to", "TO"], ["visit", "VB"], ["that", "IN"], ["place", "NN"], ["again", "RB"], [".", "."]], [[["Please", "NN"]], ["tell", "VBD"], ["Mr", "NNP"], [["Woods", "NNP"]], ["(", "NNP"], ["if", "IN"], ["you", "PRP"], ["see", "VBP"], ["him", "PRP"], [")", ":"], ["I", "PRP"], ["am", "VBP"], ["enjoying", "VBG"], ["good", "JJ"], ["health", "NN"], ["and", "CC"], ["I", "PRP"], ["send", "VBP"], ["my", "PRP$"], ["kind", "NN"], ["regards", "NNS"], ["to", "TO"], ["him", "PRP"], ["and", "CC"], ["all", "DT"], ["others", "NNS"], ["that", "WDT"], ["I", "PRP"], ["am", "VBP"], ["acquainted", "VBN"], ["with", "IN"], ["who", "WP"], ["may", "MD"], ["be", "VB"], ["in", "IN"], [["Ward", "NNP"]], ["A", "DT"], [".", "."]], [["Hoping", "VBG"], ["to", "TO"], ["hear", "VB"], ["from", "IN"], ["you", "PRP"], ["soon", "RB"], ["I", "PRP"], ["will", "MD"], ["subscribe", "VB"], ["myself", "PRP"], ["yours", "NNS"], ["affectionately", "RB"]]], "sentences": [" My Dear Friend, I have been thinking about writing you at Brooklyn but as I did not know for certain that you were there I have waited until now so that I might be shure this would find you in Washington I presume you are there by this time and I hope soon to receive a communication from you.", "I have thought of you very often since I saw you and would have gone to Brooklyn to see you again had my health been good enough.", "I have not been out much since I saw you as the weather would not admit and when the weather is stormy my wound pains me so much that I am obliged to remain quiet: I received a letter from James a few days ago acknowledgeing the receipt of your card.", "I also sent him your letter which he says he was very much pleased with: and he says he will always keep the card in remembrance of one who was so kind to me when I was so much in kneed of a little care When I wrote him before I did not tell him the picture was for him but merely enclosed your letter with the card in it telling him to return the letter after he had read it.", "And in answering he says The accompanying picture I understand is for me for which you will please give Mr Whitman my warmest thanks also for his kind rememberance of me  I hope he may live to see you for I believe he has a great desire to as he speaks of you in every letter    I presume you have seen some of my Washington friends ere this, and I hope to hear from them when I hear from you.", "If you see Miss Howard please remember me to her as you know I have good reason to thank her for many a kind turn which she wrought for me during my stay in that city2.", "I cannot forget Armory Square hospital and I have a strong desire to visit that place again.", "Please tell Mr Woods (if you see him) I am enjoying good health and I send my kind regards to him and all others that I am acquainted with who may be in Ward A.", "Hoping to hear from you soon I will subscribe myself yours affectionately  "], "words": ["My", "Dear", "Friend", ",", "I", "have", "been", "thinking", "about", "writing", "you", "at", "Brooklyn", "but", "as", "I", "did", "not", "know", "for", "certain", "that", "you", "were", "there", "I", "have", "waited", "until", "now", "so", "that", "I", "might", "be", "shure", "this", "would", "find", "you", "in", "Washington", "I", "presume", "you", "are", "there", "by", "this", "time", "and", "I", "hope", "soon", "to", "receive", "a", "communication", "from", "you.", "I", "have", "thought", "of", "you", "very", "often", "since", "I", "saw", "you", "and", "would", "have", "gone", "to", "Brooklyn", "to", "see", "you", "again", "had", "my", "health", "been", "good", "enough.", "I", "have", "not", "been", "out", "much", "since", "I", "saw", "you", "as", "the", "weather", "would", "not", "admit", "and", "when", "the", "weather", "is", "stormy", "my", "wound", "pains", "me", "so", "much", "that", "I", "am", "obliged", "to", "remain", "quiet", ":", "I", "received", "a", "letter", "from", "James", "a", "few", "days", "ago", "acknowledgeing", "the", "receipt", "of", "your", "card.", "I", "also", "sent", "him", "your", "letter", "which", "he", "says", "he", "was", "very", "much", "pleased", "with", ":", "and", "he", "says", "he", "will", "always", "keep", "the", "card", "in", "remembrance", "of", "one", "who", "was", "so", "kind", "to", "me", "when", "I", "was", "so", "much", "in", "kneed", "of", "a", "little", "care", "When", "I", "wrote", "him", "before", "I", "did", "not", "tell", "him", "the", "picture", "was", "for", "him", "but", "merely", "enclosed", "your", "letter", "with", "the", "card", "in", "it", "telling", "him", "to", "return", "the", "letter", "after", "he", "had", "read", "it.", "And", "in", "answering", "he", "says", "The", "accompanying", "picture", "I", "understand", "is", "for", "me", "for", "which", "you", "will", "please", "give", "Mr", "Whitman", "my", "warmest", "thanks", "also", "for", "his", "kind", "rememberance", "of", "me", "I", "hope", "he", "may", "live", "to", "see", "you", "for", "I", "believe", "he", "has", "a", "great", "desire", "to", "as", "he", "speaks", "of", "you", "in", "every", "letter", "I", "presume", "you", "have", "seen", "some", "of", "my", "Washington", "friends", "ere", "this", ",", "and", "I", "hope", "to", "hear", "from", "them", "when", "I", "hear", "from", "you.", "If", "you", "see", "Miss", "Howard", "please", "remember", "me", "to", "her", "as", "you", "know", "I", "have", "good", "reason", "to", "thank", "her", "for", "many", "a", "kind", "turn", "which", "she", "wrought", "for", "me", "during", "my", "stay", "in", "that", "city2.", "I", "can", "not", "forget", "Armory", "Square", "hospital", "and", "I", "have", "a", "strong", "desire", "to", "visit", "that", "place", "again.", "Please", "tell", "Mr", "Woods", "(", "if", "you", "see", "him", ")", "I", "am", "enjoying", "good", "health", "and", "I", "send", "my", "kind", "regards", "to", "him", "and", "all", "others", "that", "I", "am", "acquainted", "with", "who", "may", "be", "in", "Ward", "A.", "Hoping", "to", "hear", "from", "you", "soon", "I", "will", "subscribe", "myself", "yours", "affectionately"], "date": [], "normalizedTime": "0.251597987216", "recipient": "Walt Whitman", "organizations": [], "sender": "Jesse Mullery", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/nyp.00177.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Jesse Mullery to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["William", "NNP"], ["T.", "NNP"], ["Otto", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Sir", "Sir", "Walt Whitman", "Esq"], "money": [], "year": "1865", "locations": [], "month": "Jan", "parties": ["William T. Otto", "Walt Whitman"], "properDate": "Jan 24, 1865", "gpe": ["Washington", "Indian Affairs", "New York"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [40.7143528, -74.00597309999999], [22.3476325, 57.2818625]], "text": "  Department of the Interior, Washington, D. C., January 24, 1865.  Sir: You are hereby appointed to a Clerkship of the first class   in the Office of Indian Affairs, of this Department   the salary of which is $1200 per annum, to commence when you have subscribed the enclosed oath, and entered upon duty. I am, Sir, very respectfully, your obedient servant  W. T. Otto,  Assistant Secretary.  Walt Whitman, Esq. of New York  ", "dateText": "", "percents": [], "taggedText": [[["Department", "NN"], ["of", "IN"], ["the", "DT"], [["Interior", "NNP"]], [",", ","], [["Washington", "NNP"]], [",", ","], ["D.", "NNP"], ["C.", "NNP"], [",", ","], ["January", "NNP"], ["24", "CD"], [",", ","], ["1865", "CD"], [".", "."]], [[["Sir", "NNP"]], [":", ":"], ["You", "PRP"], ["are", "VBP"], ["hereby", "RB"], ["appointed", "VBN"], ["to", "TO"], ["a", "DT"], ["Clerkship", "NNP"], ["of", "IN"], ["the", "DT"], ["first", "JJ"], ["class", "NN"], ["in", "IN"], ["the", "DT"], ["Office", "NNP"], ["of", "IN"], [["Indian", "NNP"], ["Affairs", "NNP"]], [",", ","], ["of", "IN"], ["this", "DT"], ["Department", "NNP"], ["the", "DT"], ["salary", "NN"], ["of", "IN"], ["which", "WDT"], ["is", "VBZ"], ["$", "$"], ["1200", "CD"], ["per", "IN"], ["annum", "NN"], [",", ","], ["to", "TO"], ["commence", "VB"], ["when", "WRB"], ["you", "PRP"], ["have", "VBP"], ["subscribed", "VBN"], ["the", "DT"], ["enclosed", "VBN"], ["oath", "NN"], [",", ","], ["and", "CC"], ["entered", "VBD"], ["upon", "IN"], ["duty", "NN"], [".", "."]], [["I", "PRP"], ["am", "VBP"], [",", ","], [["Sir", "NNP"]], [",", ","], ["very", "RB"], ["respectfully", "RB"], [",", ","], ["your", "PRP$"], ["obedient", "NN"], ["servant", "NN"], ["W.", "NNP"], ["T.", "NNP"], ["Otto", "NNP"], [",", ","], [["Assistant", "NNP"]], ["Secretary", "NNP"], [".", "."]], [[["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","], [["Esq", "NNP"]], [".", "."]], [["of", "IN"], [["New", "NNP"], ["York", "NNP"]]]], "sentences": ["  Department of the Interior, Washington, D. C., January 24, 1865.", "Sir: You are hereby appointed to a Clerkship of the first class   in the Office of Indian Affairs, of this Department   the salary of which is $1200 per annum, to commence when you have subscribed the enclosed oath, and entered upon duty.", "I am, Sir, very respectfully, your obedient servant  W. T. Otto,  Assistant Secretary.", "Walt Whitman, Esq.", "of New York  "], "words": ["Department", "of", "the", "Interior", ",", "Washington", ",", "D.", "C.", ",", "January", "24", ",", "1865.", "Sir", ":", "You", "are", "hereby", "appointed", "to", "a", "Clerkship", "of", "the", "first", "class", "in", "the", "Office", "of", "Indian", "Affairs", ",", "of", "this", "Department", "the", "salary", "of", "which", "is", "$", "1200", "per", "annum", ",", "to", "commence", "when", "you", "have", "subscribed", "the", "enclosed", "oath", ",", "and", "entered", "upon", "duty.", "I", "am", ",", "Sir", ",", "very", "respectfully", ",", "your", "obedient", "servant", "W.", "T.", "Otto", ",", "Assistant", "Secretary.", "Walt", "Whitman", ",", "Esq.", "of", "New", "York"], "date": [], "normalizedTime": "0.251733986128", "recipient": "Walt Whitman", "organizations": ["Interior", "Assistant"], "sender": "William T. Otto", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/nyp.00220.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from William T. Otto to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Christopher", "NNP"]], ["and", "CC"], [["Maria", "NNP"], ["Smith", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Son", "Mother"], "money": [], "year": "1865", "locations": [], "month": "Jan", "parties": ["Christopher", "Maria Smith", "Walt Whitman"], "properDate": "Jan 26, 1865", "gpe": ["Pennsylvania", "Bethuels"], "facility": [], "latlngs": [], "text": "   Mr Walt Whitman, kind Sir we have received your kind letters and perused them with much pleasure we will assure you that your letters will always be very acceptible with us your Comrad Bethuel Smith2 has gone about forty miles from her with his team to work by the Day he gets twenty shillings per Day he went this week his health is not very good yet i dont now how he will stand it if his helth is good enough to work he may stay sevral weeks his health was very poor when he come home and that is the news why he Did not come and see you he wanted to get home and be doctered for he thinks it a very poor place to doctor down there we have one son younger with us he is Choping in the lumber woods and the two girls are with us so you se we have but four in a family at presant the rest of our family are as well as usual thu[e] will rite when he gets home we have got your papers you sent and thank you for them as we dont take any papers at presant those come very welcome the republicans have elected there oficers at last now we shall see what they will do  we think the war will last four long years more at least it ought to be the most earnest prayer to almighty god that the war might come to a close that those suffering soldiers might return to their homes and we have peace and more throughout our land  there will a draft in this town within a few days we have three sones here that will be liable to the draft and two in Pennsylvania you have a Mother with you I would like to now of her welfare i think she has one great blessing to comfort her in her age and that is having a kind hearted Son well i cant rite much more at presant i will say we got your letter and like you sent last fall and think a great deal of it Bethuels wounds are all sound and well and he is not lame in the least but has not got well of the diaraee we have got most everything we could think and hear of and it dont cure him he has had it ever since he was wounded in last June sometimes he gets better but not well if you now of any you think would cure him i should like to have you write what it is We will rite some more there is a small village a few miles north of us called rider which letters sometimes goes when you put on Quens-bury we dont get them when they go there very often perhaps i have rote enough at presant we live in hopes we may see each other yet if our lives are spared this from Bethuels father and Mother   ", "dateText": "", "percents": [], "taggedText": [[["Mr", "NNP"], ["Walt", "NNP"], ["Whitman", "NNP"], [",", ","], ["kind", "NN"], ["Sir", "NNP"], ["we", "PRP"], ["have", "VBP"], ["received", "VBN"], ["your", "PRP$"], ["kind", "NN"], ["letters", "NNS"], ["and", "CC"], ["perused", "VBD"], ["them", "PRP"], ["with", "IN"], ["much", "RB"], ["pleasure", "JJ"], ["we", "PRP"], ["will", "MD"], ["assure", "VB"], ["you", "PRP"], ["that", "IN"], ["your", "PRP$"], ["letters", "NNS"], ["will", "MD"], ["always", "RB"], ["be", "VB"], ["very", "RB"], ["acceptible", "JJ"], ["with", "IN"], ["us", "PRP"], ["your", "PRP$"], [["Comrad", "NNP"], ["Bethuel", "NNP"]], [["Smith2", "NNP"]], ["has", "VBZ"], ["gone", "VBN"], ["about", "IN"], ["forty", "NN"], ["miles", "NNS"], ["from", "IN"], ["her", "PRP$"], ["with", "IN"], ["his", "PRP$"], ["team", "NN"], ["to", "TO"], ["work", "VB"], ["by", "IN"], ["the", "DT"], ["Day", "NNP"], ["he", "PRP"], ["gets", "VBZ"], ["twenty", "NN"], ["shillings", "NNS"], ["per", "IN"], ["Day", "NNP"], ["he", "PRP"], ["went", "VBD"], ["this", "DT"], ["week", "NN"], ["his", "PRP$"], ["health", "NN"], ["is", "VBZ"], ["not", "RB"], ["very", "RB"], ["good", "JJ"], ["yet", "RB"], ["i", "PRP"], ["dont", "VBP"], ["now", "RB"], ["how", "WRB"], ["he", "PRP"], ["will", "MD"], ["stand", "VB"], ["it", "PRP"], ["if", "IN"], ["his", "PRP$"], ["helth", "NN"], ["is", "VBZ"], ["good", "JJ"], ["enough", "RB"], ["to", "TO"], ["work", "VB"], ["he", "PRP"], ["may", "MD"], ["stay", "VB"], ["sevral", "JJ"], ["weeks", "NNS"], ["his", "PRP$"], ["health", "NN"], ["was", "VBD"], ["very", "RB"], ["poor", "JJ"], ["when", "WRB"], ["he", "PRP"], ["come", "VBP"], ["home", "RB"], ["and", "CC"], ["that", "IN"], ["is", "VBZ"], ["the", "DT"], ["news", "NN"], ["why", "WRB"], ["he", "PRP"], ["Did", "NNP"], ["not", "RB"], ["come", "VB"], ["and", "CC"], ["see", "VB"], ["you", "PRP"], ["he", "PRP"], ["wanted", "VBD"], ["to", "TO"], ["get", "VB"], ["home", "NN"], ["and", "CC"], ["be", "VB"], ["doctered", "VBN"], ["for", "IN"], ["he", "PRP"], ["thinks", "VBZ"], ["it", "PRP"], ["a", "DT"], ["very", "RB"], ["poor", "JJ"], ["place", "NN"], ["to", "TO"], ["doctor", "NN"], ["down", "IN"], ["there", "EX"], ["we", "PRP"], ["have", "VBP"], ["one", "CD"], ["son", "NN"], ["younger", "NN"], ["with", "IN"], ["us", "PRP"], ["he", "PRP"], ["is", "VBZ"], ["Choping", "NNP"], ["in", "IN"], ["the", "DT"], ["lumber", "NN"], ["woods", "NNS"], ["and", "CC"], ["the", "DT"], ["two", "CD"], ["girls", "NNS"], ["are", "VBP"], ["with", "IN"], ["us", "PRP"], ["so", "RB"], ["you", "PRP"], ["se", "VBP"], ["we", "PRP"], ["have", "VBP"], ["but", "CC"], ["four", "CD"], ["in", "IN"], ["a", "DT"], ["family", "NN"], ["at", "IN"], ["presant", "JJ"], ["the", "DT"], ["rest", "NN"], ["of", "IN"], ["our", "PRP$"], ["family", "NN"], ["are", "VBP"], ["as", "RB"], ["well", "RB"], ["as", "IN"], ["usual", "JJ"], ["thu", "NN"], ["[", ":"], ["e", "NN"], ["]", ":"], ["will", "MD"], ["rite", "VB"], ["when", "WRB"], ["he", "PRP"], ["gets", "VBZ"], ["home", "NN"], ["we", "PRP"], ["have", "VBP"], ["got", "VBN"], ["your", "PRP$"], ["papers", "NNS"], ["you", "PRP"], ["sent", "VBD"], ["and", "CC"], ["thank", "NN"], ["you", "PRP"], ["for", "IN"