","], ["but", "CC"], ["I", "PRP"], ["feel", "VBP"], ["as", "IN"], ["if", "IN"], ["it", "PRP"], ["must", "MD"], ["have", "VB"], ["been", "VBN"], ["good", "JJ"], [".", "."]], [["At", "IN"], ["any", "DT"], ["rate", "NN"], ["what", "WP"], ["I", "PRP"], ["saw", "VBD"], ["of", "IN"], ["him", "PRP"], ["here", "RB"], [",", ","], ["under", "IN"], ["the", "DT"], ["most", "RBS"], ["trying", "VBG"], ["circumstances", "NNS"], [",", ","], ["with", "IN"], ["a", "DT"], ["painful", "JJ"], ["wound", "NN"], [",", ","], ["and", "CC"], ["among", "IN"], ["strangers", "NNS"], [",", ","], ["I", "PRP"], ["can", "MD"], ["say", "VB"], ["that", "IN"], ["he", "PRP"], ["behaved", "VBD"], ["so", "RB"], ["brave", "VBP"], [",", ","], ["so", "RB"], ["composed", "VBN"], [",", ","], ["and", "CC"], ["so", "RB"], ["sweet", "JJ"], ["and", "CC"], ["affectionate", "JJ"], [",", ","], ["it", "PRP"], ["could", "MD"], ["not", "RB"], ["be", "VB"], ["surpass", "RB"], ["'d", "JJ"], [".", "."]], [["And", "CC"], ["now", "RB"], ["like", "IN"], ["many", "JJ"], ["other", "JJ"], ["noble", "JJ"], ["and", "CC"], ["good", "JJ"], ["men", "NNS"], [",", ","], ["after", "IN"], ["serving", "VBG"], ["his", "PRP$"], ["country", "NN"], ["as", "IN"], ["a", "DT"], ["soldier", "NN"], [",", ","], ["he", "PRP"], ["has", "VBZ"], ["yielded", "VBN"], ["up", "RP"], ["his", "PRP$"], ["young", "JJ"], ["life", "NN"], ["at", "IN"], ["the", "DT"], ["very", "RB"], ["outset", "JJ"], ["in", "IN"], ["her", "PRP$"], ["service", "NN"], [".", "."]], [["Such", "JJ"], ["things", "NNS"], ["are", "VBP"], ["gloomy", "JJ"], ["yet", "RB"], ["there", "RB"], ["is", "VBZ"], ["a", "DT"], ["text", "NN"], [",", ","], ["``", "``"], ["God", "NNP"], ["doeth", "NN"], ["all", "DT"], ["things", "NNS"], ["well", "RB"], ["''", "''"], ["the", "DT"], ["meaning", "NN"], ["of", "IN"], ["which", "WDT"], [",", ","], ["after", "IN"], ["due", "JJ"], ["time", "NN"], [",", ","], ["appears", "VBZ"], ["to", "TO"], ["the", "DT"], ["soul", "NN"], [".", "."]], [["I", "PRP"], ["thought", "VBD"], ["perhaps", "RB"], ["a", "DT"], ["few", "JJ"], ["words", "NNS"], [",", ","], ["though", "IN"], ["from", "IN"], ["a", "DT"], ["stranger", "NN"], [",", ","], ["about", "IN"], ["your", "PRP$"], ["son", "NN"], [",", ","], ["from", "IN"], ["one", "CD"], ["who", "WP"], ["was", "VBD"], ["with", "IN"], ["him", "PRP"], ["at", "IN"], ["the", "DT"], ["last", "JJ"], [",", ","], ["might", "MD"], ["be", "VB"], ["worth", "JJ"], ["while", "IN"], ["for", "IN"], ["I", "PRP"], ["loved", "VBD"], ["the", "DT"], ["young", "JJ"], ["man", "NN"], [",", ","], ["though", "IN"], ["I", "PRP"], ["but", "CC"], ["saw", "VBD"], ["him", "PRP"], ["immediately", "RB"], ["to", "TO"], ["lose", "VB"], ["him", "PRP"], [".", "."]], [["I", "PRP"], ["am", "VBP"], ["merely", "RB"], ["a", "DT"], ["friend", "NN"], ["visiting", "VBG"], ["the", "DT"], ["hospitals", "NNS"], ["occasionally", "RB"], ["to", "TO"], ["cheer", "VB"], ["the", "DT"], ["wounded", "VBN"], ["and", "CC"], ["sick", "NN"], [".", "."]], [["W.", "NNP"], ["W", "NNP"], [".", "."]]], "sentences": [" Dear madam: No doubt you and Frank's friends have heard the sad fact of his death in hospital here, through his uncle, or the lady from Baltimore, who took his things.", "(I have not seen them, only heard of them visiting Frank.", ") I will write you a few lines   as a casual friend that sat by his death-bed.", "Your son, Corporal Frank H. Irwin, was wounded near Fort Fisher, Virginia, March 25th, 1865   the wound was in the left knee, pretty bad.", "He was sent up to Washington, was receiv'd in ward C, Armory-square hospital, March 28th   the wound became worse, and on the 4th of April the leg was amputated a little above the knee   the operation was perform'd by Dr. Bliss, one of the best surgeons in the army   he did the whole operation himself   there was a good deal of bad matter gather'd   the bullet was found in the knee.", "For a couple of weeks afterwards he was doing pretty well.", "I visited and sat by him frequently, as he was fond of having me.", "The last ten or twelve days of April I saw that his case was critical.", "He previously had some fever, with cold spells.", "The last week in April he was much of the time flighty   but always mild and gentle.", "He died first of May.", "The actual cause of death was pyaemia, (the absorption of the matter in the system instead of its discharge).", "Frank, as far as I saw, had everything requisite in surgical treatment, nursing, &c. He had watches much of the time.", "He was so good and well-behaved and affectionate I myself liked him very much.", "I was in the habit of coming in afternoons and sitting by him, and soothing him, and he liked to have me   liked to put his arm out and lay his hand on my knee   would keep it so a long while.", "Toward the last he was more restless and flighty at night   often fancied himself with his regiment   by his talk sometimes seem'd as if his feelings were hurt by being blamed by his officers for something he was entirely innocent of   said, \"I never in my life was thought capable of such a thing, and never was.", "\" At other times he would fancy himself talking as it seem'd to children or such like, his relatives I suppose, and giving them good advice; would talk to them a long while.", "All the time he was out of his head not one single bad word or idea escaped him.", "It was remark'd that many a man's conversation in his senses was not half as good as Frank's delirium.", "He seem'd quite willing to die   he had become very weak and had suffer'd a good deal, and was perfectly resign'd, poor boy.", "I do not know his past life, but I feel as if it must have been good.", "At any rate what I saw of him here, under the most trying circumstances, with a painful wound, and among strangers, I can say that he behaved so brave, so composed, and so sweet and affectionate, it could not be surpass'd.", "And now like many other noble and good men, after serving his country as a soldier, he has yielded up his young life at the very outset in her service.", "Such things are gloomy   yet there is a text, \"God doeth all things well\"   the meaning of which, after due time, appears to the soul.", "I thought perhaps a few words, though from a stranger, about your son, from one who was with him at the last, might be worth while   for I loved the young man, though I but saw him immediately to lose him.", "I am merely a friend visiting the hospitals occasionally to cheer the wounded and sick.", "W. W. "], "words": ["Dear", "madam", ":", "No", "doubt", "you", "and", "Frank", "'s", "friends", "have", "heard", "the", "sad", "fact", "of", "his", "death", "in", "hospital", "here", ",", "through", "his", "uncle", ",", "or", "the", "lady", "from", "Baltimore", ",", "who", "took", "his", "things.", "(", "I", "have", "not", "seen", "them", ",", "only", "heard", "of", "them", "visiting", "Frank.", ")", "I", "will", "write", "you", "a", "few", "lines", "as", "a", "casual", "friend", "that", "sat", "by", "his", "death-bed.", "Your", "son", ",", "Corporal", "Frank", "H.", "Irwin", ",", "was", "wounded", "near", "Fort", "Fisher", ",", "Virginia", ",", "March", "25th", ",", "1865", "the", "wound", "was", "in", "the", "left", "knee", ",", "pretty", "bad.", "He", "was", "sent", "up", "to", "Washington", ",", "was", "receiv", "'d", "in", "ward", "C", ",", "Armory-square", "hospital", ",", "March", "28th", "the", "wound", "became", "worse", ",", "and", "on", "the", "4th", "of", "April", "the", "leg", "was", "amputated", "a", "little", "above", "the", "knee", "the", "operation", "was", "perform", "'d", "by", "Dr.", "Bliss", ",", "one", "of", "the", "best", "surgeons", "in", "the", "army", "he", "did", "the", "whole", "operation", "himself", "there", "was", "a", "good", "deal", "of", "bad", "matter", "gather", "'d", "the", "bullet", "was", "found", "in", "the", "knee.", "For", "a", "couple", "of", "weeks", "afterwards", "he", "was", "doing", "pretty", "well.", "I", "visited", "and", "sat", "by", "him", "frequently", ",", "as", "he", "was", "fond", "of", "having", "me.", "The", "last", "ten", "or", "twelve", "days", "of", "April", "I", "saw", "that", "his", "case", "was", "critical.", "He", "previously", "had", "some", "fever", ",", "with", "cold", "spells.", "The", "last", "week", "in", "April", "he", "was", "much", "of", "the", "time", "flighty", "but", "always", "mild", "and", "gentle.", "He", "died", "first", "of", "May.", "The", "actual", "cause", "of", "death", "was", "pyaemia", ",", "(", "the", "absorption", "of", "the", "matter", "in", "the", "system", "instead", "of", "its", "discharge", ")", ".", "Frank", ",", "as", "far", "as", "I", "saw", ",", "had", "everything", "requisite", "in", "surgical", "treatment", ",", "nursing", ",", "&", "c.", "He", "had", "watches", "much", "of", "the", "time.", "He", "was", "so", "good", "and", "well-behaved", "and", "affectionate", "I", "myself", "liked", "him", "very", "much.", "I", "was", "in", "the", "habit", "of", "coming", "in", "afternoons", "and", "sitting", "by", "him", ",", "and", "soothing", "him", ",", "and", "he", "liked", "to", "have", "me", "liked", "to", "put", "his", "arm", "out", "and", "lay", "his", "hand", "on", "my", "knee", "would", "keep", "it", "so", "a", "long", "while.", "Toward", "the", "last", "he", "was", "more", "restless", "and", "flighty", "at", "night", "often", "fancied", "himself", "with", "his", "regiment", "by", "his", "talk", "sometimes", "seem", "'d", "as", "if", "his", "feelings", "were", "hurt", "by", "being", "blamed", "by", "his", "officers", "for", "something", "he", "was", "entirely", "innocent", "of", "said", ",", "``", "I", "never", "in", "my", "life", "was", "thought", "capable", "of", "such", "a", "thing", ",", "and", "never", "was.", "''", "At", "other", "times", "he", "would", "fancy", "himself", "talking", "as", "it", "seem", "'d", "to", "children", "or", "such", "like", ",", "his", "relatives", "I", "suppose", ",", "and", "giving", "them", "good", "advice", ";", "would", "talk", "to", "them", "a", "long", "while.", "All", "the", "time", "he", "was", "out", "of", "his", "head", "not", "one", "single", "bad", "word", "or", "idea", "escaped", "him.", "It", "was", "remark", "'d", "that", "many", "a", "man", "'s", "conversation", "in", "his", "senses", "was", "not", "half", "as", "good", "as", "Frank", "'s", "delirium.", "He", "seem", "'d", "quite", "willing", "to", "die", "he", "had", "become", "very", "weak", "and", "had", "suffer", "'d", "a", "good", "deal", ",", "and", "was", "perfectly", "resign", "'d", ",", "poor", "boy.", "I", "do", "not", "know", "his", "past", "life", ",", "but", "I", "feel", "as", "if", "it", "must", "have", "been", "good.", "At", "any", "rate", "what", "I", "saw", "of", "him", "here", ",", "under", "the", "most", "trying", "circumstances", ",", "with", "a", "painful", "wound", ",", "and", "among", "strangers", ",", "I", "can", "say", "that", "he", "behaved", "so", "brave", ",", "so", "composed", ",", "and", "so", "sweet", "and", "affectionate", ",", "it", "could", "not", "be", "surpass'd.", "And", "now", "like", "many", "other", "noble", "and", "good", "men", ",", "after", "serving", "his", "country", "as", "a", "soldier", ",", "he", "has", "yielded", "up", "his", "young", "life", "at", "the", "very", "outset", "in", "her", "service.", "Such", "things", "are", "gloomy", "yet", "there", "is", "a", "text", ",", "``", "God", "doeth", "all", "things", "well", "''", "the", "meaning", "of", "which", ",", "after", "due", "time", ",", "appears", "to", "the", "soul.", "I", "thought", "perhaps", "a", "few", "words", ",", "though", "from", "a", "stranger", ",", "about", "your", "son", ",", "from", "one", "who", "was", "with", "him", "at", "the", "last", ",", "might", "be", "worth", "while", "for", "I", "loved", "the", "young", "man", ",", "though", "I", "but", "saw", "him", "immediately", "to", "lose", "him.", "I", "am", "merely", "a", "friend", "visiting", "the", "hospitals", "occasionally", "to", "cheer", "the", "wounded", "and", "sick.", "W.", "W", "."], "date": [], "normalizedTime": "0.264925880593", "recipient": "", "organizations": ["Corporal Frank"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/med.00310.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to Mrs. Irwin ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Peter", "NNP"], ["Eckler", "NNP"]], [",", ","]]], "people": ["Mr.", "Alvord", "Walt", "Whitman"], "money": [], "year": "1865", "locations": [], "month": "May", "parties": ["Walt Whitman", "Peter Eckler"], "properDate": "May 2, 1865", "gpe": ["Washington", "New York"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [40.7143528, -74.00597309999999]], "text": "  Washington |  May 2 1865.  Mr. Eckler:1 Dear Sir: I enclose $20 in further liquidation. I wish you would send me a copy of each of the printed sheets, by mail   as I suppose Alvord has printed them. Before I left New York I paid Bradstreet2 $20 in advance for binding the first 100. I rec'd the copyright & receipt. I thank you for your kindness in getting the copyright. Walt Whitman ", "dateText": "", "percents": [], "taggedText": [[[["Washington", "NNP"]], ["|", ":"], ["May", "NNP"], ["2", "CD"], ["1865", "CD"], [".", "."]], [[["Mr.", "NNP"]], ["Eckler:1", "NNP"], ["Dear", "NNP"], ["Sir", "NNP"], [":", ":"], ["I", "PRP"], ["enclose", "VBP"], ["$", "$"], ["20", "CD"], ["in", "IN"], ["further", "JJ"], ["liquidation", "NN"], [".", "."]], [["I", "PRP"], ["wish", "VBP"], ["you", "PRP"], ["would", "MD"], ["send", "VB"], ["me", "PRP"], ["a", "DT"], ["copy", "NN"], ["of", "IN"], ["each", "DT"], ["of", "IN"], ["the", "DT"], ["printed", "VBN"], ["sheets", "NNS"], [",", ","], ["by", "IN"], ["mail", "NN"], ["as", "IN"], ["I", "PRP"], ["suppose", "VBP"], [["Alvord", "NNP"]], ["has", "VBZ"], ["printed", "VBN"], ["them", "PRP"], [".", "."]], [["Before", "IN"], ["I", "PRP"], ["left", "VBD"], [["New", "NNP"], ["York", "NNP"]], ["I", "NNP"], ["paid", "VBD"], [["Bradstreet2", "NNP"]], ["$", "$"], ["20", "CD"], ["in", "IN"], ["advance", "NN"], ["for", "IN"], ["binding", "NN"], ["the", "DT"], ["first", "JJ"], ["100", "CD"], [".", "."]], [["I", "PRP"], ["rec", "VBP"], ["'d", "JJ"], ["the", "DT"], ["copyright", "NN"], ["&", "CC"], ["receipt", "NN"], [".", "."]], [["I", "PRP"], ["thank", "VBP"], ["you", "PRP"], ["for", "IN"], ["your", "PRP$"], ["kindness", "NN"], ["in", "IN"], ["getting", "NN"], ["the", "DT"], ["copyright", "NN"], [".", "."]], [[["Walt", "NNP"]], [["Whitman", "NNP"]]]], "sentences": ["  Washington |  May 2 1865.", "Mr. Eckler:1 Dear Sir: I enclose $20 in further liquidation.", "I wish you would send me a copy of each of the printed sheets, by mail   as I suppose Alvord has printed them.", "Before I left New York I paid Bradstreet2 $20 in advance for binding the first 100.", "I rec'd the copyright & receipt.", "I thank you for your kindness in getting the copyright.", "Walt Whitman "], "words": ["Washington", "|", "May", "2", "1865.", "Mr.", "Eckler:1", "Dear", "Sir", ":", "I", "enclose", "$", "20", "in", "further", "liquidation.", "I", "wish", "you", "would", "send", "me", "a", "copy", "of", "each", "of", "the", "printed", "sheets", ",", "by", "mail", "as", "I", "suppose", "Alvord", "has", "printed", "them.", "Before", "I", "left", "New", "York", "I", "paid", "Bradstreet2", "$", "20", "in", "advance", "for", "binding", "the", "first", "100.", "I", "rec", "'d", "the", "copyright", "&", "receipt.", "I", "thank", "you", "for", "your", "kindness", "in", "getting", "the", "copyright.", "Walt", "Whitman"], "date": [], "normalizedTime": "0.265061879505", "recipient": "Peter Eckler", "organizations": ["Bradstreet2"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/rut.00002.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to Peter Eckler ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Jesse", "NNP"], ["Mullery", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Dear", "Friend Your", "April", "Joseph", "Rebel", "Miss Howard"], "money": [], "year": "1865", "locations": [], "month": "May", "parties": ["Jesse Mullery", "Walt Whitman"], "properDate": "May 3, 1865", "gpe": ["Brooklyn", "Burksville", "Picket", "Petersburgh", "Washington", "Look", "Washington", "Please"], "facility": [], "latlngs": [[40.65, -73.95], [38.8951118, -77.0363658], [38.8951118, -77.0363658]], "text": "   Dear Friend Your welcome epistle of the 24th of April came to hand this morning and found me in good health and as usual very glad to hear from you. My Brothers James & Joseph are both well and in the Regt and wish me to return thanks for your kind remembrance of them I received a letter from you written at Brooklyn bearing date of the 13th of April we marched from Burksville the following day. I have not had a chance to answer it. We finished our march to this place last Thursday afternoon and as soon as we halted my Regiment were ordered on Picket where we remained three days, consequently I could not write; and since we came in from picket we have been under marching orders. By the way we are waiting transportation towards Petersburgh. Our train started yesterday morning and about tomorrow we will start. We wait now for the Cars to return which took the 2nd Brigade of the Division in that direction on Monday. The soldiers have not emerged from the gloom which was cast over their minds on hearing of the death of our Beloved President. My heart is to full to write anything about him, for I cannot tell how well he was liked by the Soldiers who fought for the Flag under him. I am pained to say that many of my company secretly rejoiced when we received the news of the assasination. But none dared to cheer although if some Rebel had proposed it there were plenty ready to join in. All I want is to see the assassin dealt with if caught in a proper manner. I hope I shall soon have the pleasure of seeing you in Washington when I will tell you a great many things that I cannot write. Look out for me when you hear the 1st Div. of the 6th corps coming to Washington. We are kept very close now on account of the Orders for going back. Otherwise I would try to visit the Prison Camp and also the burying ground. There are a large number of my comrades buried there and I should like to have the satisfaction of seeing their graves. Should you see Miss Howard please remember me to her.2 Hoping to see you soon I will close for the present. Please write me before unless you hear of the Corps coming home. Yours truly.   ", "dateText": "", "percents": [], "taggedText": [[[["Dear", "NNP"]], [["Friend", "NNP"], ["Your", "NNP"]], ["welcome", "NN"], ["epistle", "NN"], ["of", "IN"], ["the", "DT"], ["24th", "JJ"], ["of", "IN"], [["April", "NNP"]], ["came", "VBD"], ["to", "TO"], ["hand", "VB"], ["this", "DT"], ["morning", "NN"], ["and", "CC"], ["found", "VBD"], ["me", "PRP"], ["in", "IN"], ["good", "JJ"], ["health", "NN"], ["and", "CC"], ["as", "IN"], ["usual", "JJ"], ["very", "RB"], ["glad", "JJ"], ["to", "TO"], ["hear", "VB"], ["from", "IN"], ["you", "PRP"], [".", "."]], [["My", "PRP$"], [["Brothers", "NNP"], ["James", "NNP"]], ["&", "CC"], [["Joseph", "NNP"]], ["are", "VBP"], ["both", "DT"], ["well", "RB"], ["and", "CC"], ["in", "IN"], ["the", "DT"], [["Regt", "NNP"]], ["and", "CC"], ["wish", "NN"], ["me", "PRP"], ["to", "TO"], ["return", "VB"], ["thanks", "NNS"], ["for", "IN"], ["your", "PRP$"], ["kind", "NN"], ["remembrance", "NN"], ["of", "IN"], ["them", "PRP"], ["I", "PRP"], ["received", "VBD"], ["a", "DT"], ["letter", "NN"], ["from", "IN"], ["you", "PRP"], ["written", "VBN"], ["at", "IN"], [["Brooklyn", "NNP"]], ["bearing", "NN"], ["date", "NN"], ["of", "IN"], ["the", "DT"], ["13th", "JJ"], ["of", "IN"], ["April", "NNP"], ["we", "PRP"], ["marched", "VBD"], ["from", "IN"], [["Burksville", "NNP"]], ["the", "DT"], ["following", "VBG"], ["day", "NN"], [".", "."]], [["I", "PRP"], ["have", "VBP"], ["not", "RB"], ["had", "VBN"], ["a", "DT"], ["chance", "NN"], ["to", "TO"], ["answer", "VB"], ["it", "PRP"], [".", "."]], [["We", "PRP"], ["finished", "VBD"], ["our", "PRP$"], ["march", "NN"], ["to", "TO"], ["this", "DT"], ["place", "NN"], ["last", "JJ"], ["Thursday", "NNP"], ["afternoon", "NN"], ["and", "CC"], ["as", "IN"], ["soon", "RB"], ["as", "IN"], ["we", "PRP"], ["halted", "VBD"], ["my", "PRP$"], ["Regiment", "NNP"], ["were", "VBD"], ["ordered", "VBN"], ["on", "IN"], [["Picket", "NNP"]], ["where", "WRB"], ["we", "PRP"], ["remained", "VBD"], ["three", "CD"], ["days", "NNS"], [",", ","], ["consequently", "RB"], ["I", "PRP"], ["could", "MD"], ["not", "RB"], ["write", "VB"], [";", ":"], ["and", "CC"], ["since", "IN"], ["we", "PRP"], ["came", "VBD"], ["in", "IN"], ["from", "IN"], ["picket", "NN"], ["we", "PRP"], ["have", "VBP"], ["been", "VBN"], ["under", "IN"], ["marching", "VBG"], ["orders", "NNS"], [".", "."]], [["By", "IN"], ["the", "DT"], ["way", "NN"], ["we", "PRP"], ["are", "VBP"], ["waiting", "VBG"], ["transportation", "NN"], ["towards", "NNS"], [["Petersburgh", "NNP"]], [".", "."]], [["Our", "PRP$"], ["train", "NN"], ["started", "VBD"], ["yesterday", "NN"], ["morning", "NN"], ["and", "CC"], ["about", "IN"], ["tomorrow", "NN"], ["we", "PRP"], ["will", "MD"], ["start", "VB"], [".", "."]], [["We", "PRP"], ["wait", "VBP"], ["now", "RB"], ["for", "IN"], ["the", "DT"], [["Cars", "NNPS"]], ["to", "TO"], ["return", "VB"], ["which", "WDT"], ["took", "NN"], ["the", "DT"], ["2nd", "CD"], ["Brigade", "NNP"], ["of", "IN"], ["the", "DT"], ["Division", "NNP"], ["in", "IN"], ["that", "DT"], ["direction", "NN"], ["on", "IN"], ["Monday", "NNP"], [".", "."]], [["The", "DT"], ["soldiers", "NNS"], ["have", "VBP"], ["not", "RB"], ["emerged", "VBN"], ["from", "IN"], ["the", "DT"], ["gloom", "NN"], ["which", "WDT"], ["was", "VBD"], ["cast", "VBN"], ["over", "IN"], ["their", "PRP$"], ["minds", "NNS"], ["on", "IN"], ["hearing", "NN"], ["of", "IN"], ["the", "DT"], ["death", "NN"], ["of", "IN"], ["our", "PRP$"], [["Beloved", "NNP"]], ["President", "NNP"], [".", "."]], [["My", "PRP$"], ["heart", "NN"], ["is", "VBZ"], ["to", "TO"], ["full", "JJ"], ["to", "TO"], ["write", "VB"], ["anything", "NN"], ["about", "IN"], ["him", "PRP"], [",", ","], ["for", "IN"], ["I", "PRP"], ["can", "MD"], ["not", "RB"], ["tell", "VB"], ["how", "WRB"], ["well", "RB"], ["he", "PRP"], ["was", "VBD"], ["liked", "VBN"], ["by", "IN"], ["the", "DT"], ["Soldiers", "NNP"], ["who", "WP"], ["fought", "RB"], ["for", "IN"], ["the", "DT"], [["Flag", "NNP"]], ["under", "IN"], ["him", "PRP"], [".", "."]], [["I", "PRP"], ["am", "VBP"], ["pained", "VBN"], ["to", "TO"], ["say", "VB"], ["that", "IN"], ["many", "JJ"], ["of", "IN"], ["my", "PRP$"], ["company", "NN"], ["secretly", "RB"], ["rejoiced", "VBD"], ["when", "WRB"], ["we", "PRP"], ["received", "VBD"], ["the", "DT"], ["news", "NN"], ["of", "IN"], ["the", "DT"], ["assasination", "NN"], [".", "."]], [["But", "CC"], ["none", "NN"], ["dared", "VBD"], ["to", "TO"], ["cheer", "NN"], ["although", "IN"], ["if", "IN"], ["some", "DT"], [["Rebel", "NNP"]], ["had", "VBD"], ["proposed", "VBN"], ["it", "PRP"], ["there", "RB"], ["were", "VBD"], ["plenty", "NN"], ["ready", "RB"], ["to", "TO"], ["join", "VB"], ["in", "IN"], [".", "."]], [["All", "DT"], ["I", "PRP"], ["want", "VBP"], ["is", "VBZ"], ["to", "TO"], ["see", "VB"], ["the", "DT"], ["assassin", "NN"], ["dealt", "NN"], ["with", "IN"], ["if", "IN"], ["caught", "VBN"], ["in", "IN"], ["a", "DT"], ["proper", "NN"], ["manner", "NN"], [".", "."]], [["I", "PRP"], ["hope", "VBP"], ["I", "PRP"], ["shall", "MD"], ["soon", "RB"], ["have", "VB"], ["the", "DT"], ["pleasure", "NN"], ["of", "IN"], ["seeing", "VBG"], ["you", "PRP"], ["in", "IN"], [["Washington", "NNP"]], ["when", "WRB"], ["I", "PRP"], ["will", "MD"], ["tell", "VB"], ["you", "PRP"], ["a", "DT"], ["great", "JJ"], ["many", "JJ"], ["things", "NNS"], ["that", "WDT"], ["I", "PRP"], ["can", "MD"], ["not", "RB"], ["write", "VB"], [".", "."]], [[["Look", "NNP"]], ["out", "IN"], ["for", "IN"], ["me", "PRP"], ["when", "WRB"], ["you", "PRP"], ["hear", "VBP"], ["the", "DT"], ["1st", "CD"], ["Div", "NNP"], [".", "."]], [["of", "IN"], ["the", "DT"], ["6th", "JJ"], ["corps", "NNS"], ["coming", "VBG"], ["to", "TO"], [["Washington", "NNP"]], [".", "."]], [["We", "PRP"], ["are", "VBP"], ["kept", "VBN"], ["very", "RB"], ["close", "JJ"], ["now", "RB"], ["on", "IN"], ["account", "NN"], ["of", "IN"], ["the", "DT"], [["Orders", "NNP"]], ["for", "IN"], ["going", "VBG"], ["back", "RB"], [".", "."]], [["Otherwise", "RB"], ["I", "PRP"], ["would", "MD"], ["try", "VB"], ["to", "TO"], ["visit", "VB"], ["the", "DT"], [["Prison", "NNP"], ["Camp", "NNP"]], ["and", "CC"], ["also", "RB"], ["the", "DT"], ["burying", "NN"], ["ground", "NN"], [".", "."]], [["There", "EX"], ["are", "VBP"], ["a", "DT"], ["large", "JJ"], ["number", "NN"], ["of", "IN"], ["my", "PRP$"], ["comrades", "NNS"], ["buried", "VBD"], ["there", "RB"], ["and", "CC"], ["I", "PRP"], ["should", "MD"], ["like", "VB"], ["to", "TO"], ["have", "VB"], ["the", "DT"], ["satisfaction", "NN"], ["of", "IN"], ["seeing", "VBG"], ["their", "PRP$"], ["graves", "NNS"], [".", "."]], [["Should", "MD"], ["you", "PRP"], ["see", "VB"], [["Miss", "NNP"], ["Howard", "NNP"]], ["please", "NN"], ["remember", "NN"], ["me", "PRP"], ["to", "TO"], ["her.2", "-NONE-"], ["Hoping", "VBG"], ["to", "TO"], ["see", "VB"], ["you", "PRP"], ["soon", "RB"], ["I", "PRP"], ["will", "MD"], ["close", "VB"], ["for", "IN"], ["the", "DT"], ["present", "NN"], [".", "."]], [[["Please", "NN"]], ["write", "VBD"], ["me", "PRP"], ["before", "IN"], ["unless", "IN"], ["you", "PRP"], ["hear", "VBP"], ["of", "IN"], ["the", "DT"], [["Corps", "NNP"]], ["coming", "VBG"], ["home", "NN"], [".", "."]], [["Yours", "NNS"], ["truly", "RB"], [".", "."]]], "sentences": ["   Dear Friend Your welcome epistle of the 24th of April came to hand this morning and found me in good health and as usual very glad to hear from you.", "My Brothers James & Joseph are both well and in the Regt and wish me to return thanks for your kind remembrance of them I received a letter from you written at Brooklyn bearing date of the 13th of April we marched from Burksville the following day.", "I have not had a chance to answer it.", "We finished our march to this place last Thursday afternoon and as soon as we halted my Regiment were ordered on Picket where we remained three days, consequently I could not write; and since we came in from picket we have been under marching orders.", "By the way we are waiting transportation towards Petersburgh.", "Our train started yesterday morning and about tomorrow we will start.", "We wait now for the Cars to return which took the 2nd Brigade of the Division in that direction on Monday.", "The soldiers have not emerged from the gloom which was cast over their minds on hearing of the death of our Beloved President.", "My heart is to full to write anything about him, for I cannot tell how well he was liked by the Soldiers who fought for the Flag under him.", "I am pained to say that many of my company secretly rejoiced when we received the news of the assasination.", "But none dared to cheer although if some Rebel had proposed it there were plenty ready to join in.", "All I want is to see the assassin dealt with if caught in a proper manner.", "I hope I shall soon have the pleasure of seeing you in Washington when I will tell you a great many things that I cannot write.", "Look out for me when you hear the 1st Div.", "of the 6th corps coming to Washington.", "We are kept very close now on account of the Orders for going back.", "Otherwise I would try to visit the Prison Camp and also the burying ground.", "There are a large number of my comrades buried there and I should like to have the satisfaction of seeing their graves.", "Should you see Miss Howard please remember me to her.2 Hoping to see you soon I will close for the present.", "Please write me before unless you hear of the Corps coming home.", "Yours truly.   "], "words": ["Dear", "Friend", "Your", "welcome", "epistle", "of", "the", "24th", "of", "April", "came", "to", "hand", "this", "morning", "and", "found", "me", "in", "good", "health", "and", "as", "usual", "very", "glad", "to", "hear", "from", "you.", "My", "Brothers", "James", "&", "Joseph", "are", "both", "well", "and", "in", "the", "Regt", "and", "wish", "me", "to", "return", "thanks", "for", "your", "kind", "remembrance", "of", "them", "I", "received", "a", "letter", "from", "you", "written", "at", "Brooklyn", "bearing", "date", "of", "the", "13th", "of", "April", "we", "marched", "from", "Burksville", "the", "following", "day.", "I", "have", "not", "had", "a", "chance", "to", "answer", "it.", "We", "finished", "our", "march", "to", "this", "place", "last", "Thursday", "afternoon", "and", "as", "soon", "as", "we", "halted", "my", "Regiment", "were", "ordered", "on", "Picket", "where", "we", "remained", "three", "days", ",", "consequently", "I", "could", "not", "write", ";", "and", "since", "we", "came", "in", "from", "picket", "we", "have", "been", "under", "marching", "orders.", "By", "the", "way", "we", "are", "waiting", "transportation", "towards", "Petersburgh.", "Our", "train", "started", "yesterday", "morning", "and", "about", "tomorrow", "we", "will", "start.", "We", "wait", "now", "for", "the", "Cars", "to", "return", "which", "took", "the", "2nd", "Brigade", "of", "the", "Division", "in", "that", "direction", "on", "Monday.", "The", "soldiers", "have", "not", "emerged", "from", "the", "gloom", "which", "was", "cast", "over", "their", "minds", "on", "hearing", "of", "the", "death", "of", "our", "Beloved", "President.", "My", "heart", "is", "to", "full", "to", "write", "anything", "about", "him", ",", "for", "I", "can", "not", "tell", "how", "well", "he", "was", "liked", "by", "the", "Soldiers", "who", "fought", "for", "the", "Flag", "under", "him.", "I", "am", "pained", "to", "say", "that", "many", "of", "my", "company", "secretly", "rejoiced", "when", "we", "received", "the", "news", "of", "the", "assasination.", "But", "none", "dared", "to", "cheer", "although", "if", "some", "Rebel", "had", "proposed", "it", "there", "were", "plenty", "ready", "to", "join", "in.", "All", "I", "want", "is", "to", "see", "the", "assassin", "dealt", "with", "if", "caught", "in", "a", "proper", "manner.", "I", "hope", "I", "shall", "soon", "have", "the", "pleasure", "of", "seeing", "you", "in", "Washington", "when", "I", "will", "tell", "you", "a", "great", "many", "things", "that", "I", "can", "not", "write.", "Look", "out", "for", "me", "when", "you", "hear", "the", "1st", "Div.", "of", "the", "6th", "corps", "coming", "to", "Washington.", "We", "are", "kept", "very", "close", "now", "on", "account", "of", "the", "Orders", "for", "going", "back.", "Otherwise", "I", "would", "try", "to", "visit", "the", "Prison", "Camp", "and", "also", "the", "burying", "ground.", "There", "are", "a", "large", "number", "of", "my", "comrades", "buried", "there", "and", "I", "should", "like", "to", "have", "the", "satisfaction", "of", "seeing", "their", "graves.", "Should", "you", "see", "Miss", "Howard", "please", "remember", "me", "to", "her.2", "Hoping", "to", "see", "you", "soon", "I", "will", "close", "for", "the", "present.", "Please", "write", "me", "before", "unless", "you", "hear", "of", "the", "Corps", "coming", "home.", "Yours", "truly", "."], "date": [], "normalizedTime": "0.265197878417", "recipient": "Walt Whitman", "organizations": ["Brothers James", "Regt", "Cars", "Beloved", "Flag", "Orders", "Prison Camp", "Corps"], "sender": "Jesse Mullery", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/nyp.00178.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Jesse Mullery to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Peter", "NNP"], ["Eckler", "NNP"]], [",", ","]]], "people": ["Simpson", "Louisa Whitman", "Walt", "Mr. Alvord"], "money": [], "year": "1865", "locations": [], "month": "May", "parties": ["Walt Whitman", "Peter Eckler"], "properDate": "May 3, 1865", "gpe": ["Spruce", "Grass", "Portland", "Myrtle", "Brooklyn"], "facility": [], "latlngs": [[57.9148175, -152.4058246], [45.5234515, -122.6762071], [52.1054611, -119.6489096], [40.65, -73.95]], "text": "  May 3, 1865.  P. Eckler:1 As I remitted $20 May 1st, which I suppose you duly received, I herewith enclose $14.85, as payment in full. Deliver the sheets to A. Simpson, 8 Spruce street, & send me his receipt. Leave the copy of \"Leaves of Grass,\" with Mrs. Louisa Whitman, Portland av. 4th door north of Myrtle, Brooklyn. If you have the plates of the two cancelled pages, I wish you would take three impressions of each page & enclose to me. Walt WhitmanWashington D. C. I will trouble you also to send me Mr. Alvord's receipt for my plates, in his vault. ", "dateText": "", "percents": [], "taggedText": [[["May", "NNP"], ["3", "CD"], [",", ","], ["1865", "CD"], [".", "."]], [["P.", "NNP"], ["Eckler:1", "NNP"], ["As", "NNP"], ["I", "NNP"], ["remitted", "VBD"], ["$", "$"], ["20", "CD"], ["May", "NNP"], ["1st", "CD"], [",", ","], ["which", "WDT"], ["I", "PRP"], ["suppose", "VBP"], ["you", "PRP"], ["duly", "RB"], ["received", "VBD"], [",", ","], ["I", "PRP"], ["herewith", "VBP"], ["enclose", "JJ"], ["$", "$"], ["14.85", "CD"], [",", ","], ["as", "IN"], ["payment", "NN"], ["in", "IN"], ["full", "JJ"], [".", "."]], [["Deliver", "RB"], ["the", "DT"], ["sheets", "NNS"], ["to", "TO"], ["A.", "NNP"], [["Simpson", "NNP"]], [",", ","], ["8", "CD"], [["Spruce", "NNP"]], ["street", "NN"], [",", ","], ["&", "CC"], ["send", "NN"], ["me", "PRP"], ["his", "PRP$"], ["receipt", "NN"], [".", "."]], [["Leave", "