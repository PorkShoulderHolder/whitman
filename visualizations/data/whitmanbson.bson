ase", "NN"], ["that", "IN"], ["I", "PRP"], ["could", "MD"], ["recover", "VB"], ["from", "IN"], ["it.2", "-NONE-"], ["However", "RB"], ["I", "PRP"], ["dont", "VBP"], ["know", "RB"], [".", "."]], [["I", "PRP"], ["sincerely", "RB"], ["wish", "JJ"], ["that", "IN"], ["you", "PRP"], ["would", "MD"], ["come", "VB"], ["hom", "NN"], ["for", "IN"], ["a", "DT"], ["short", "JJ"], ["time", "NN"], ["anyway", "NN"], [".", "."]], [["I", "PRP"], ["think", "VBP"], ["that", "IN"], ["you", "PRP"], ["could", "MD"], ["do", "VB"], [["Andrew", "NNP"]], ["a", "DT"], ["great", "JJ"], ["deal", "NN"], ["of", "IN"], ["good", "JJ"], ["In", "IN"], ["the", "DT"], [["letter3", "NNP"]], ["that", "IN"], [["Mother", "NNP"]], ["received", "VBD"], ["yesterday", "NN"], ["from", "IN"], ["you", "PRP"], [",", ","], ["you", "PRP"], ["speak", "VBP"], ["abt", "NN"], ["my", "PRP$"], ["having", "NN"], ["been", "VBN"], ["reduced", "VBN"], ["in", "IN"], ["pay", "NN"], [".", "."]], [["I", "PRP"], ["am", "VBP"], ["sorry", "JJ"], [["Mother", "NNP"]], ["wrote", "VBD"], ["you", "PRP"], ["abt", "NN"], ["it", "PRP"], ["for", "IN"], ["it", "PRP"], ["only", "RB"], ["worries", "VBZ"], ["you", "PRP"], ["without", "IN"], ["doing", "VBG"], ["any", "DT"], ["good", "JJ"], [",", ","], ["and", "CC"], ["another", "DT"], ["thing", "NN"], ["it", "PRP"], ["is", "VBZ"], ["not", "RB"], ["like", "IN"], ["you", "PRP"], ["think", "VBP"], ["in", "IN"], ["regard", "NN"], ["to", "TO"], ["cutting", "VBG"], ["down", "IN"], ["my", "PRP$"], ["wages", "NNS"], [".", "."]], [["I", "PRP"], ["was", "VBD"], ["working", "VBG"], ["for", "IN"], ["the", "DT"], ["two", "CD"], ["boards", "NNS"], ["of", "IN"], [["Commissioners", "NNP"]], [",", ","], ["one", "CD"], ["at", "IN"], ["$", "$"], ["40", "CD"], ["and", "CC"], ["the", "DT"], ["other", "JJ"], ["at", "IN"], ["$", "$"], ["50", "CD"], ["per", "IN"], ["month", "NN"], [",", ","], ["and", "CC"], ["I", "PRP"], ["have", "VBP"], ["got", "VBN"], ["all", "DT"], ["the", "DT"], ["work", "NN"], ["for", "IN"], ["one"