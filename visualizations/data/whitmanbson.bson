"with", "Something", "like", "this", "inscription", "on", "them.", "``", "A", "hand", "''", "with", "``", "If", "you", "can", "get", "will", "you", "accept", "''", "quite", "a", "nice", "thing", "but", "as", "it", "came", "from", "wrong", "quarter", "why", "I", "did", "n't", "accept.", "So", "Ile", "beg", "you", "to", "Excuse", "this", "writing", "which", "is", "done", "in", "a", "very", "big", "hurry", "as", "I", "have", "made", "an", "Engagement", "to", "go", "out", "Driving", "in", "Sleigh", "with", "``", "Her", "''", "&", "the", "time", "is", "Drawing", "near", "a", "head", "So", "Ile", "close", "sending", "you", "&", "Peter", "much", "Love.", "PS", "Tell", "Pete", "Ile", "answer", "his", "as", "soon", "as", "rec'd.", "Snowing", "here", "now", "Adeau", "Yours", "Muchly", "Ed", "C", "Stewart", "``", "Continuation", "''", "Eleven", "Oclock", "P.M.", "Well", "Walt", "Ive", "just", "returned", "from", "that", "ride", "I", "mentioned", "I", "was", "away", "about", "twenty", "miles", "on", "the", "Blue", "Mountains", "of", "Cape", "Breton", "had", "gay", "time", ",", "Saw", "any", "amount", "of", "Indians", "of", "Mickmac", "Tribe.", "I", "'ve", "promised", "that", "young", "Lady", "to", "show", "her", "your", "picture", "so", "you", "will", "not", "Disappoint", "me.", "Today", "I", "received", "two", "papers", "from", "Pete", "I", "suppose.", "``", "Sunday", "Chron", "''", "&", "Balto", "Sun.", "No", "more", "at", "present", "Yours", "Infernally", "(", "as", "old", "man", "``", "Weller", ",", "''", "says", "in", "Pickwick", "Ned"], "date": [], "normalizedTime": "0.50441996464", "recipient": "Walt Whitman", "organizations": ["Peters", "Peters", "Met'n", "Canturbury", "American Consul", "Sisters", "Temperance", "Intemperance", "Tell Pete", "Blue Mountains"], "sender": "Stewart", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/loc.01903.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Edward C. Stewart to Walt Whitman ,"}, {"taggedHeading": [[[["Martha", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Walt As", "Jeff", "St", "Jeff", "Davis", "Mattie"], "money": [], "year": "1870", "locations": [], "month": "Feb", "parties": ["Martha", "Whitman", "Walt Whitman"], "properDate": "Feb 27, 1870", "gpe": ["Brooklyn", "Brooklyn", "Davis", "Hattie", "Brooklyn", "Washington"], "facility": [], "latlngs": [[40.65, -73.95], [40.65, -73.95], [38.5449065, -121.7405167], [40.65, -73.95], [38.8951118, -77.0363658]], "text": "image 1image 2image 3image 4  Brooklyn                     Feb 27/70                                  Dear brother Walt              As you know I am in Brooklyn. I will not write about coming here. Jeff started back                 for St Louis this afternoon he was very sorry that he could not see you. but I am                 certainly coming on my way back. Davis is going to leave St L    to build the W                 W of Lowell Mass. it is a very sudden move and made Jeff have to return sooner than                 he expected. I hear from Hattie every few days they get along nicely, and I think the trip will do                 me good I want to remain in Brooklyn till Davis comes on and then I will come to                 Washington Walter dont put yourself out too much to get me a room. you know I am not particular                 and for a few days anything will do. I want to see you very much and as that will be                 soon I wont write a long letter as I can talk so much better.                  from your sister                 Mattie              ", "dateText": "", "percents": [], "taggedText": [[["image", "NN"], ["1image", "NN"], ["2image", "NN"], ["3image", "NN"], ["4", "CD"], [["Brooklyn", "NNP"]], ["Feb", "NNP"], ["27/70", "CD"], ["Dear", "NNP"], ["brother", "NN"], [["Walt", "NNP"], ["As", "NNP"]], ["you", "PRP"], ["know", "VBP"], ["I", "PRP"], ["am", "VBP"], ["in", "IN"], [["Brooklyn", "NNP"]], [".", "."]], [["I", "PRP"], ["will", "MD"], ["not", "RB"], ["write", "VB"], ["about", "IN"], ["coming", "VBG"], ["here", "RB"], [".", "."]], [[["Jeff", "NNP"]], ["started", "VBD"], ["back", "RP"], ["for", "IN"], ["St", "NNP"], ["Louis", "NNP"], ["this", "DT"], ["afternoon", "NN"], ["he", "PRP"], ["was", "VBD"], ["very", "RB"], ["sorry", "JJ"], ["that", "IN"], ["he", "PRP"], ["could", "MD"], ["not", "RB"], ["see", "VB"], ["you", "PRP"], [".", "."]], [["but", "CC"], ["I", "PRP"], ["am", "VBP"], ["certainly", "RB"], ["coming", "VBG"], ["on", "IN"], ["my", "PRP$"], ["way", "NN"], ["back", "RB"], [".", "."]], [[["Davis", "NNP"]], ["is", "VBZ"], ["going", "VBG"], ["to", "TO"], ["leave", "VB"], [["St", "NNP"]], ["L", "NNP"], ["to", "TO"], ["build", "VB"], ["the", "DT"], [["W", "NNP"]], ["W", "NNP"], ["of", "IN"], [["Lowell", "NNP"], ["Mass", "NNP"]], [".", "."]], [["it", "PRP"], ["is", "VBZ"], ["a", "DT"], ["very", "RB"], ["sudden", "VBN"], ["move", "NN"], ["and", "CC"], ["made", "VBD"], [["Jeff", "NNP"]], ["have", "VBP"], ["to", "TO"], ["return", "VB"], ["sooner", "RBR"], ["than", "IN"], ["he", "PRP"], ["expected", "VBD"], [".", "."]], [["I", "PRP"], ["hear", "VBP"], ["from", "IN"], [["Hattie", "NNP"]], ["every", "DT"], ["few", "JJ"], ["days", "NNS"], ["they", "PRP"], ["get", "VBP"], ["along", "IN"], ["nicely", "RB"], [",", ","], ["and", "CC"], ["I", "PRP"], ["think", "VBP"], ["the", "DT"], ["trip", "NN"], ["will", "MD"], ["do", "VB"], ["me", "PRP"], ["good", "VB"], ["I", "PRP"], ["want", "VBP"], ["to", "TO"], ["remain", "VB"], ["in", "IN"], [["Brooklyn", "NNP"]], ["till", "NN"], [["Davis", "NNP"]], ["comes", "VBZ"], ["on", "IN"], ["and", "CC"], ["then", "RB"], ["I", "PRP"], ["will", "MD"], ["come", "VB"], ["to", "TO"], [["Washington", "NNP"]], ["Walter", "NNP"], ["dont", "NN"], ["put", "VBD"], ["yourself", "PRP"], ["out", "IN"], ["too", "RB"], ["much", "JJ"], ["to", "TO"], ["get", "VB"], ["me", "PRP"], ["a", "DT"], ["room", "NN"], [".", "."]],