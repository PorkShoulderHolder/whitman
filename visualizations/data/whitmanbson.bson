as", "NNP"], ["O'Kane", "NNP"]], [",", ","]]], "people": ["Camden", "Phil", "Market st.", "Only", "Roberts Bros. Boston"], "money": [], "year": "1873", "locations": [], "month": "Sep", "parties": ["Walt", "Whitman", "Thomas O'Kane"], "properDate": "Sep 13, 1873", "gpe": ["Grass", "Camden"], "facility": [], "latlngs": [[51.55170589999999, -0.1588255]], "text": "  Sept. 13, 1873                               Tho's O'Kane           Dear Sir,        I have rec'd your letter of the 12th. I agree to allow you better than half off,          namely you to acc't to me at $1.40 cts a copy on the bound Leaves of Grass          (which retails at $3)   and at 30 cts each for As a strong bird, (which retails at 75 cts.)        I will be very happy to see you, at any time. I am stopping at 322 Stevens st. Camden,          (cross by Phil. ferry from foot of Market st.   or Camden depot from N. Y.)        If you are willing to go into selling my books, I think you ought to have some of the little          30 cts brochure \"After All not to Create Only\" published by Roberts Bros. Boston.        I do not of course expect the sale could any how be a rushing one   but           ", "dateText": "", "percents": [], "taggedText": [[["Sept.", "NNP"], ["13", "CD"], [",", ","], ["1873", "CD"], ["Tho", "NNP"], ["'s", "POS"], ["O'Kane", "JJ"], ["Dear", "NNP"], ["Sir", "NNP"], [",", ","], ["I", "PRP"], ["have", "VBP"], ["rec", "JJ"], ["'d", "JJ"], ["your", "PRP$"], ["letter", "NN"], ["of", "IN"], ["the", "DT"], ["12th", "JJ"], [".", "."]], [["I", "PRP"], ["agree", "VBP"], ["to", "TO"], ["allow", "VB"], ["you", "PRP"], ["better", "JJR"], ["than", "IN"], ["half", "PDT"], ["off", "IN"], [",", ","], ["namely", "RB"], ["you", "PRP"], ["to", "TO"], ["acc't", "JJ"], ["to", "TO"], ["me", "PRP"], ["at", "IN"], ["$", "$"], ["1.40", "CD"], ["cts", "NNS"], ["a", "DT"], ["copy", "NN"], ["on", "IN"], ["the", "DT"], ["bound", "NN"], ["Leaves", "VBZ"], ["of", "IN"], [["Grass", "NNP"]], ["(", "NNP"], ["which", "