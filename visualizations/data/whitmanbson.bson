"JJ"], ["to", "TO"], ["set", "VB"], ["your", "PRP$"], ["eyes", "NNS"], ["upon", "IN"], [".", "."]], [["Can", "NNP"], ["you", "PRP"], ["not", "RB"], ["visit", "VB"], ["us", "PRP"], ["and", "CC"], ["note", "VB"], ["for", "IN"], ["yourself", "PRP"], ["?", "."]], [["I", "PRP"], ["think", "VBP"], ["a", "DT"], ["change", "NN"], ["of", "IN"], ["climate", "NN"], ["will", "MD"], ["be", "VB"], ["beneficial", "JJ"], [".", "."]], [["How", "WRB"], ["are", "VBP"], [["Jack", "NNP"]], ["and", "CC"], [["Amos", "NNP"]], ["?", "."], ["2", "CD"], ["I", "PRP"], ["wish", "VBP"], ["you", "PRP"], ["would", "MD"], ["give", "VB"], ["me", "PRP"], [["Amos", "NNP"]], ["'s", "POS"], ["address", "NN"], [",", ","], ["as", "IN"], ["I", "PRP"], ["have", "VBP"], ["lost", "VBN"], ["the", "DT"], ["one", "CD"], ["he", "PRP"], ["gave", "VBD"], ["me", "PRP"], [".", "."]], [["My", "PRP$"], ["regards", "NNS"], ["to", "TO"], ["them", "PRP"], ["and", "CC"], ["hope", "VBP"], ["they", "PRP"], ["are", "VBP"], ["out", "RP"], ["of", "IN"], [["Campbell", "NNP"], ["Hospital", "NNP"]], [".", "."]], [["What", "WP"], ["became", "VBD"], ["of", "IN"], ["poor", "JJ"], [["Dick", "NNP"]], ["?", "."]], [["I", "PRP"], ["have", "VBP"], ["been", "VBN"], ["so", "RB"], ["busy", "JJ"], ["I", "PRP"], ["have", "VBP"], ["neglected", "VBN"], ["all", "DT"], ["correspondence", "NN"], ["so", "RB"], ["you", "PRP"], ["will", "MD"], ["readily", "RB"], ["forget", "VB"], ["the", "DT"], ["seeming", "NN"], ["neglect", "NN"], ["Hoping", "NNP"], ["to", "TO"], ["hear", "VB"], ["from", "IN"], ["you", "PRP"], ["at", "IN"], ["an", "DT"], ["early", "JJ"], ["period", "NN"], ["I", "PRP"], ["remain", "VBP"], [["Very", "NNP"]], ["respectfully", "RB"], ["Your", "NNP"], ["humble", "JJ"], [["Will", "NNP"], ["Wallace", "NNP"], ["To", "NNP"]], ["the", "DT"], ["Prince", "NNP"], ["of", "IN"], [["Bohemians", "NNPS"], ["Walt", "NNP"], ["Whitman", "NNP"]], [".", "."]], [["P..S.", "NNP"], ["Send", "NNP"], ["me", "PRP"], ["that", "IN"], ["promised", "VBN"], ["photograph", "NN"], ["and", "CC"], ["as", "IN"], ["soon", "RB"], ["as", "IN"], ["I", "PRP"], ["find", "VBP"], ["out", "RP"], ["your", "PRP$"], ["quarters", "NNS"], ["I", "PRP"], ["will", "MD"], ["return", "VB"], ["compt", "NN"], ["Will", "NNP"], ["I", "PRP"], ["will", "MD"], ["tell", "VB"], ["you", "PRP"], ["of", "IN"], ["the", "DT"], ["many", "JJ"], ["secesh", "JJ"], ["at", "IN"], ["the", "DT"], ["next", "JJ"], ["writing", "NN"]]], "sentences": ["   Friend Walter I have not forgotten you in the wanderings from Washington here.", "After five days and nights jolting in the cars I reached this point and was put on duty instanter   And such duty!", "Why I have worked night and day and it appears there is more to do now than when I came.", "They only allow one steward to each Hospital, and it is an irksome office when such is the case.", "I am doing finely and in the course of a few weeks I think will have some leisure time.", "The Hospitals here were in a destitute condition, compared with those of the North.", "When I came to this Hospital they had no clothes to change one fourth of the patients.", "I immediately appealed to my lady friends and patriots in Philadelphia, and they have sent me on a fine lot of sanitary stores, yet not enough for the wants of the many admitted.", "Our Hospt is a large five story building and accommodates between 300 & 400 patients, most of whom are wounded in the continual skirmishing about Murfreesboro and Franklin.", "I have never had better health in my life, perhaps I can explain it to you.", "I have five young ladies who act in the capacity of nurses   i e, one of them is French, young and beautiful to set your eyes upon.", "Can you not visit us and note for yourself?", "I think a change of climate will be beneficial.", "How are Jack and Amos?2 I wish you would give me Amos's address, as I have lost the one he gave me.", "My regards to them and hope they are out of Campbell Hospital.", "What became of poor Dick?", "I have been so busy I have neglected all correspondence so you will readily forget the seeming neglect   Hoping to hear from you at an early period I remain  Very respectfully  Your humble  Will Wallace  To the Prince of Bohemians Walt Whitman.", "P..S. Send me that promised photograph and as soon as I find out your quarters I will return compt Will I will tell you of the many secesh at the next writing  "], "words": ["Friend", "Walter", "I", "have", "not", "forgotten", "you", "in", "the", "wanderings", "from", "Washington", "here.", "After", "five", "days", "and", "nights", "jolting", "in", "the", "cars", "I", "reached", "this", "point", "and", "was", "put", "on", "duty", "instanter", "And", "such", "duty", "!", "Why", "I", "have", "worked", "night", "and", "day", "and", "it", "appears", "there", "is", "more", "to", "do", "now", "than", "when", "I", "came.", "They", "only", "allow", "one", "steward", "to", "each", "Hospital", ",", "and", "it", "is", "an", "irksome", "office", "when", "such", "is", "the", "case.", "I", "am", "doing", "finely", "and", "in", "the", "course", "of", "a", "few", "weeks", "I", "think", "will", "have", "some", "leisure", "time.", "The", "Hospitals", "here", "were", "in", "a", "destitute", "condition", ",", "compared", "with", "those", "of", "the", "North.", "When", "I", "came", "to", "this", "Hospital", "they", "had", "no", "clothes", "to", "change", "one", "fourth", "of", "the", "patients.", "I", "immediately", "appealed", "to", "my", "lady", "friends", "and", "patriots", "in", "Philadelphia", ",", "and", "they", "have", "sent", "me", "on", "a", "fine", "lot", "of", "sanitary", "stores", ",", "yet", "not", "enough", "for", "the", "wants", "of", "the", "many", "admitted.", "Our", "Hospt", "is", "a", "large", "five", "story", "building", "and", "accommodates", "between", "300", "&", "400", "patients", ",", "most", "of", "whom", "are", "wounded", "in", "the", "continual", "skirmishing", "about", "Murfreesboro", "and", "Franklin.", "I", "have", "never", "had", "better", "health", "in", "my", "life", ",", "perhaps", "I", "can", "explain", "it", "to", "you.", "I", "have", "five", "young", "ladies", "who", "act", "in", "the", "capacity", "of", "nurses", "i", "e", ",", "one", "of", "them", "is", "French", ",", "young", "and", "beautiful", "to", "set", "your", "eyes", "upon.", "Can", "you", "not", "visit", "us", "and", "note", "for", "yourself", "?", "I", "think", "a", "change", "of", "climate", "will", "be", "beneficial.", "How", "are", "Jack", "and", "Amos", "?", "2", "I", "wish", "you", "would", "give", "me", "Amos", "'s", "address", ",", "as", "I", "have", "lost", "the", "one", "he", "gave", "me.", "My", "regards", "to", "them", "and", "hope", "they", "are", "out", "of", "Campbell", "Hospital.", "What", "became", "of", "poor", "Dick", "?", "I", "have", "been", "so", "busy", "I", "have", "neglected", "all", "correspondence", "so", "you", "will", "readily", "forget", "the", "seeming", "neglect", "Hoping", "to", "hear", "from", "you", "at", "an", "early", "period", "I", "remain", "Very", "respectfully", "Your", "humble", "Will", "Wallace", "To", "the", "Prince", "of", "Bohemians", "Walt", "Whitman.", "P..S.", "Send", "me", "that", "promised", "photograph", "and", "as", "soon", "as", "I", "find", "out", "your", "quarters", "I", "will", "return", "compt", "Will", "I", "will", "tell", "you", "of", "the", "many", "secesh", "at", "the", "next", "writing"], "date": [], "normalizedTime": "0.161974704202", "recipient": "Walt Whitman", "organizations": ["Hospital", "Hospitals", "Hospt", "Campbell Hospital", "Bohemians Walt Whitman"], "sender": "Will W. Wallace", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00594.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Will W. Wallace to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Thomas", "NNP"], ["Jefferson", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Brother Walt", "Uncle Walt", "Uncle Walt", "Georges", "Jeff", "Van Anden9"], "money": [], "year": "1863", "locations": [], "month": "Apr", "parties": ["Thomas Jefferson Whitman", "Walt Whitman"], "properDate": "Apr 6, 1863", "gpe": ["Walt", "Twould", "Twould", "Mattie", "Walt"], "facility": [], "latlngs": [], "text": "  [April 6, 1863]1 [Dear Brother Walt,] As I was abt putting these in the envelope my eye caught this blank place and I thought that 'twas a pity to let such an opportunity go. It looked like waste. Walt, how I should like to see you, do you look the same as ever or has the immense number of unfortunate and heartworking cases given you an sobre and melancholy look.2 I sometimes think, when I get thinking abt you, that it must have that effect upon you. But then the cases that you releive and those dear lives that you save must bring back the old look again. Do you suppose that you will long continue where you are? Do you think Anything will come of your trying to get office?3 I suppose it is merely a question of time and patience as regards the office. I am in hopes to be able to have a small some of money sent you every week hereafter in this way  I will ask Lane4 to see how many names of those around in and abt. the W. W.5 will consent to give $1 per month regularly to be sent to you for Hospital purposes. I have no doubt but that some 25 or 30 names could be had and if we could send you $6 or $7 weekly twould be quite a big thing. We think then that we shall call you \"The B. Watr Works soldiers Aid society\" with power. Seriously, I think twould be a good thing and that I can come [by] it. I sent you $5 last week, did you get it. Twas from Mr Lane. Twould make you laugh to see little Hattie brush her hair and teeth. I am almost afraid she will clean them to death. She is tremendious proud of her things that Uncle Walt sent her. Twould please you to see how finely she is growing. Every day I give her a little exercise in singing two or three notes only. I think she could be made a fine musician and am going to try it.6 She often asks when you are coming home to take her out on Fort Greene.7 She often gets one of you[r] pictures and calls it her dear Uncle Walt. She knew Georges picture at once, which I think proves it to be pretty good. Mattie is as well as usual, she has no work and has not had hardly since you went away, and I am glad she has not8  Mother is first rate except she works to hard  I wish she wouldnt  she is foolish to clean house so much. Walt do write me a good long letter Jeff. The enclosed $10 I got from Van Anden9 ", "dateText": "", "percents": [], "taggedText": [[["[", "NN"], ["April", "NNP"], ["6", "CD"], [",", ","], ["1863", "CD"], ["]", ":"], ["1", "CD"], ["[", "CD"], ["Dear", "NNP"], [["Brother", "NNP"], ["Walt", "NNP"]], [",", ","], ["]", "NNP"], ["As", "NNP"], ["I", "NNP"], ["was", "VBD"], ["abt", "JJ"], ["putting", "NN"], ["these", "DT"], ["in", "IN"], ["the", "DT"], ["envelope", "NN"], ["my", "PRP$"], ["eye", "NN"], ["caught", "NN"], ["this", "DT"], ["blank", "NN"], ["place", "NN"], ["and", "CC"], ["I", "PRP"], ["thought", "VBD"], ["that", "IN"], ["'t", "JJ"], ["was", "VBD"], ["a", "DT"], ["pity", "NN"], ["to", "TO"], ["let", "VB"], ["such", "JJ"], ["an", "DT"], ["opportunity", "NN"], ["go", "NN"], [".", "."]], [["It", "PRP"], ["looked", "VBD"], ["like", "IN"], ["waste", "NN"], [".", "."]], [[["Walt", "NNP"]], [",", ","], ["how", "WRB"], ["I", "PRP"], ["should", "MD"], ["like", "VB"], ["to", "TO"], ["see", "VB"], ["you", "PRP"], [",", ","], ["do", "VBP"], ["you", "PRP"], ["look", "VB"], ["the", "DT"], ["same", "JJ"], ["as", "IN"], ["ever", "RB"], ["or", "CC"], ["has", "VBZ"], ["the", "DT"], ["immense", "NN"], ["number", "NN"], ["of", "IN"], ["unfortunate", "JJ"], ["and", "CC"], ["heartworking", "VBG"], ["cases", "NNS"], ["given", "VBN"], ["you", "PRP"], ["an", "DT"], ["sobre", "NN"], ["and", "CC"], ["melancholy", "RB"], ["look.2", "-NONE-"], ["I", "PRP"], ["sometimes", "RB"], ["think", "VBP"], [",", ","], ["when", "WRB"], ["I", "PRP"], ["get", "VBP"], ["thinking", "VBG"], ["abt", "NN"], ["you", "PRP"], [",", ","], ["that", "DT"], ["it", "PRP"], ["must", "MD"], ["have", "VB"], ["that", "IN"], ["effect", "NN"], ["upon", "IN"], ["you", "PRP"], [".", "."]], [["But", "CC"], ["then", "RB"], ["the", "DT"], ["cases", "NNS"], ["that", "WDT"], ["you", "PRP"], ["releive", "VBP"], ["and", "CC"], ["those", "DT"], ["dear", "JJ"], ["lives", "NNS"], ["that", "WDT"], ["you", "PRP"], ["save", "VBP"], ["must", "MD"], ["bring", "VB"], ["back", "RB"], ["the", "DT"], ["old", "JJ"], ["look", "NN"], ["again", "RB"], [".", "."]], [["Do", "NNP"], ["you", "PRP"], ["suppose", "VB"], ["that", "DT"], ["you", "PRP"], ["will", "MD"], ["long", "RB"], ["continue", "VB"], ["where", "WRB"], ["you", "PRP"], ["are", "VBP"], ["?", "."]], [["Do", "NNP"], ["you", "PRP"], ["think", "VBP"], ["Anything", "NNP"], ["will", "MD"], ["come", "VB"], ["of", "IN"], ["your", "PRP$"], ["trying", "VBG"], ["to", "TO"], ["get", "VB"], ["office", "NN"], ["?", "."], ["3", "CD"], ["I", "PRP"], ["suppose", "VBP"], ["it", "PRP"], ["is", "VBZ"], ["merely", "RB"], ["a", "DT"], ["question", "NN"], ["of", "IN"], ["time", "NN"], ["and", "CC"], ["patience", "NN"], ["as", "IN"], ["regards", "NNS"], ["the", "DT"], ["office", "NN"], [".", "."]], [["I", "PRP"], ["am", "VBP"], ["in", "IN"], ["hopes", "NNS"], ["to", "TO"], ["be", "VB"], ["able", "JJ"], ["to", "TO"], ["have", "VB"], ["a", "DT"], ["small", "JJ"], ["some", "DT"], ["of", "IN"], ["money", "NN"], ["sent", "VBN"], ["you", "PRP"], ["every", "DT"], ["week", "NN"], ["hereafter", "NN"], ["in", "IN"], ["this", "DT"], ["way", "NN"], ["I", "PRP"], ["will", "MD"], ["ask", "VB"], [["Lane4", "NNP"]], ["to", "TO"], ["see", "VB"], ["how", "WRB"], ["many", "JJ"], ["names", "NNS"], ["of", "IN"], ["those", "DT"], ["around", "IN"], ["in", "IN"], ["and", "CC"], ["abt", "NN"], [".", "."]], [["the", "DT"], ["W.", "NNP"], ["W.5", "NNP"], ["will"