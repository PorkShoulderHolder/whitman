y", "PRP$"], ["special", "JJ"], ["attentions", "NNS"], ["to", "TO"], ["the", "DT"], ["few", "JJ"], ["where", "WRB"], ["the", "DT"], ["investment", "NN"], ["seems", "VBZ"], ["to", "TO"], ["tell", "VB"], ["best", "JJS"], [",", ","], ["&", "CC"], ["who", "WP"], ["want", "VBP"], ["it", "PRP"], ["most", "JJS"], ["Mother", "NNP"], [",", ","], ["I", "PRP"], ["have", "VBP"], ["real", "JJ"], ["pride", "NN"], ["in", "IN"], ["telling", "NN"], ["you", "PRP"], ["that", "IN"], ["I", "PRP"], ["have", "VBP"], ["the", "DT"], ["consciousness", "NN"], ["of", "IN"], ["saving", "VBG"], ["quite", "RB"], ["a", "DT"], ["little", "RB"], ["number", "NN"], ["of", "IN"], ["lives", "NNS"], ["by", "IN"], ["saving", "VBG"], ["them", "PRP"], ["from", "IN"], ["giving", "VBG"], ["up", "RP"], ["&", "CC"], ["being", "VBG"], ["a", "DT"], ["good", "JJ"], ["deal", "NN"], ["with", "IN"], ["them", "PRP"], ["the", "DT"], ["men", "NNS"], ["say", "VBP"], ["it", "PRP"], ["is", "VBZ"], ["so", "RB"], [",", ","], ["&", "CC"], ["the", "DT"], ["doctors", "NNS"], ["say", "VBP"], ["it", "PRP"], ["is", "VBZ"], ["so", "RB"], ["&", "CC"], ["I", "PRP"], ["will", "MD"], ["candidly", "RB"], ["confess", "VB"], ["I", "PRP"], ["can", "MD"], ["see", "VB"], ["it", "PRP"], ["is", "VBZ"], ["true", "JJ"], [",", ","], ["though", "IN"], ["I", "PRP"], ["say", "VBP"], ["it", "PRP"], ["of", "IN"], ["myself", "PRP"], ["I", "PRP"], ["know", "VBP"], ["you", "PRP"], ["will", "MD"], ["like", "VB"], ["to", "TO"], ["hear", "VB"], ["it", "PRP"], [",", ","], ["mother", "RB"], [",", ","], ["so", "RB"], ["I", "PRP"], ["tell", "VBP"], ["you", "PRP"], ["I", "PRP"], ["am", "VBP"], ["finishing", "VBG"], ["this", "DT"], ["in", "IN"], [["Major", "NNP"], ["Hapgood", "NNP"]], ["'s", "POS"], ["office", "NN"], [",", ","], ["about", "IN"], ["1", "CD"], ["o'clock", "NN"], ["it", "PRP"], ["is", "VBZ"], ["pretty", "RB"], ["warm", "NN"], [",", ","], ["but", "CC"], ["has", "VBZ"], ["not", "RB"], ["cleared", "VBN"], ["off", "RP"], ["yet", "RB"], ["the", "DT"], ["trees", "NNS"], ["look", "VBP"], ["so", "RB"], ["well", "RB"], ["from", "IN"], ["where", "WRB"], ["I", "PRP"], ["am", "VBP"], [",", ","], ["&", "CC"], ["the", "DT"], ["Potomac", "NNP"], ["it", "PRP"], ["is", "VBZ"], ["a", "DT"], ["noble", "JJ"], ["river", "NN"], ["I", "PRP"], ["see", "VBP"], ["it", "PRP"], ["several", "JJ"], ["miles", "NNS"], [",", ","], ["&", "CC"], [["Arlington", "NNP"]], ["heights", "NNS"], [["Mother", "NNP"]], [",", ","], ["I", "PRP"], ["see", "VBP"], ["some", "DT"], ["of", "IN"], ["the", "DT"], ["47th", "JJ"], [["Brooklyn", "NNP"]], ["every", "DT"], ["day", "NN"], ["or", "CC"], ["two", "CD"], ["the", "DT"], ["reg't", "JJ"], ["is", "VBZ"], ["on", "IN"], ["the", "DT"], [["Heights", "NNP"]], ["back", "RB"], ["of", "IN"], [["Arlington", "NNP"], ["House", "NNP"]], [",", ","], ["a", "DT"], ["fine", "NN"], ["camp", "NN"], ["ground", "NN"], ["O", "NNP"], [",", ","], [["Matty", "NNP"]], [",", ","], ["I", "PRP"], ["have", "VBP"], ["just", "RB"], ["thought", "VBN"], ["of", "IN"], ["you", "PRP"], ["dear", "VBP"], ["sister", "NN"], [",", ","], ["how", "WRB"], ["are", "VBP"], ["you", "PRP"], ["getting", "VBG"], ["along", "IN"], ["?", "."]], [[["Jeff", "NNP"]], [",", ","], ["I", "PRP"], ["will", "MD"], ["write", "VB"], ["you", "PRP"], ["truly", "RB"], ["Good", "NNP"], ["bye", "NN"], ["for", "IN"], ["the", "DT"], ["present", "NN"], [",", ","], ["dearest", "NN"], ["mother", "NN"], [",", ","], ["&", "CC"], ["all", "DT"], ["Walt", "NNP"]]], "sentences": ["  Tuesday afternoon.1  Mother, it seems to be certain that Meade2 has gained the day, & that the battles there in Pennsylvania have been about as terrible as any in the war   O what a sight must have been presented by the field of action   I think the killed & wounded there on both sides were as many as eighteen or twenty thousand   in one place, four or five acres, there were a thousand dead, at daybreak on Saturday morning   Mother, one's heart grows sick of war, after all, when you see what it really is   every once in a while I feel so horrified & disgusted   it seems to me like a great slaughter-house & the men mutually butchering each other   then I feel how impossible it appears, again, to retire from this contest, until we have carried our points   (it is cruel to be so tossed from pillar to post in one's judgment).", "Washington is a pleasant place in some respects   it has the finest trees, & plenty of them every where, on the streets, & grounds.", "The Capitol grounds, though small, have the finest cultivated trees I ever see   there is a great variety, & not one but is in perfect condition   After I finish this letter I am going out there for an hour's recreation   The great sights of Washington are the public buildings, the wide streets, the public grounds, the trees, the Smithsonian Institute & grounds   I go to the latter occasionally   the Institute is an old fogy concern, but the grounds are fine3   Sometimes I go up to Georgetown, about two & a half miles up the Potomac, an old town   just opposite it in the river is an island, where the niggers have their first Washington reg't encamped   they make a good show, are often seen in the streets of Washington in squads   since they have begun to carry arms, the secesh here & in Georgetown (about 3/5ths) are not insulting to them as formerly.", "One of the things here always on the go, is long trains of army wagons   sometimes they will stream along all day, it almost seems as if there was nothing else but army wagons & ambulances   they have great camps here in every direction, of army wagons, teamsters, ambulance camps, &c. Some of them are permanent, & have small hospitals   I go to them, (as no one else goes, ladies would not venture)   I sometimes have the luck to give some of the drivers a great deal of comfort & help.", "Indeed, mother, there are camps here of every thing   I went once or twice to the Contraband Camp,4 to the Hospital, &c. but I could not bring myself to go again   when I meet black men or boys among my own hospitals, I use them kindly, give them something, &c.   I believe I told you that I do the same to the wounded rebels, too   but as there is a limit to one's sinews & endurance & sympathies, &c. I have got in the way after going lightly as it were all through the wards of a hospital, & trying to give a word of cheer, if nothing else, to every one, then confining my special attentions to the few where the investment seems to tell best, & who want it most   Mother, I have real pride in telling you that I have the consciousness of saving quite a little number of lives by saving them from giving up & being a good deal with them   the men say it is so, & the doctors say it is so   & I will candidly confess I can see it is true, though I say it of myself   I know you will like to hear it, mother, so I tell you    I am finishing this in Major Hapgood's office, about 1 o'clock   it is pretty warm, but has not cleared off yet   the trees look so well from where I am, & the Potomac   it is a noble river   I see it several miles, & Arlington heights   Mother, I see some of the 47th Brooklyn every day or two   the reg't is on the Heights   back of Arlington House, a fine camp ground   O, Matty, I have just thought of you   dear sister, how are you getting along?", "Jeff, I will write you truly   Good bye for the present, dearest mother, & all    Walt "], "words": ["Tuesday", "afternoon.1", "Mother", ",", "it", "seems", "to", "be", "certain", "that", "Meade2", "has", "gained", "the", "day", ",", "&", "that", "the", "battles", "there", "in", "Pennsylvania", "have", "been", "about", "as", "terrible", "as", "any", "in", "the", "war", "O", "what", "a", "sight", "must", "have", "been", "presented", "by", "the", "field", "of", "action", "I", "think", "the", "killed", "&", "wounded", "there", "on", "both", "sides", "were", "as", "many", "as", "eighteen", "or", "twenty", "thousand", "in", "one", "place", ",", "four", "or", "five", "acres", ",", "there", "were", "a", "thousand", "dead", ",", "at", "daybreak", "on", "Saturday", "morning", "Mother", ",", "one", "'s", "heart", "grows", "sick", "of", "war", ",", "after", "all", ",", "when", "you", "see", "what", "it", "really", "is", "every", "once", "in", "a", "while", "I", "feel", "so", "horrified", "&", "disgusted", "it", "seems", "to", "me", "like", "a", "great", "slaughter-house", "&", "the", "men", "mutually", "butchering", "each", "other", "then", "I", "feel", "how", "impossible", "it", "appears", ",", "again", ",", "to", "retire", "from", "this", "contest", ",", "until", "we", "have", "carried", "our", "points", "(", "it", "is", "cruel", "to", "be", "so", "tossed", "from", "pillar", "to", "post", "in", "one", "'s", "judgment", ")", ".", "Washington", "is", "a", "pleasant", "place", "in", "some", "respects", "it", "has", "the", "finest", "trees", ",", "&", "plenty", "of", "them", "every", "where", ",", "on", "the", "streets", ",", "&", "grounds.", "The", "Capitol", "grounds", ",", "though", "small", ",", "have", "the", "finest", "cultivated", "trees", "I", "ever", "see", "there", "is", "a", "great", "variety", ",", "&", "not", "one", "but", "is", "in", "perfect", "condition", "After", "I", "finish", "this", "letter", "I", "am", "going", "out", "there", "for", "an", "hour", "'s", "recreation", "The", "great", "sights", "of", "Washington", "are", "the", "public", "buildings", ",", "the", "wide", "streets", ",", "the", "public", "grounds", ",", "the", "trees", ",", "the", "Smithsonian", "Institute", "&", "grounds", "I", "go", "to", "the", "latter", "occasionally", "the", "Institute", "is", "an", "old", "fogy", "concern", ",", "but", "the", "grounds", "are", "fine3", "Sometimes", "I", "go", "up", "to", "Georgetown", ",", "about", "two", "&", "a", "half", "miles", "up", "the", "Potomac", ",", "an", "old", "town", "just", "opposite", "it", "in", "the", "river", "is", "an", "island", ",", "where", "the", "niggers", "have", "their", "first", "Washington", "reg't", "encamped", "they", "make", "a", "good", "show", ",", "are", "often", "seen", "in", "the", "streets", "of", "Washington", "in", "squads", "since", "they", "have", "begun", "to", "carry", "arms", ",", "the", "secesh", "here", "&", "in", "Georgetown", "(", "about", "3/5ths", ")", "are", "not", "insulting", "to", "them", "as", "formerly.", "One", "of", "the", "things", "here", "always", "on", "the", "go", ",", "is", "long", "trains", "of", "army", "wagons", "sometimes", "they", "will", "stream", "along", "all", "day", ",", "it", "almost", "seems", "as", "if", "there", "was", "nothing", "else", "but", "army", "wagons", "&", "ambulances", "they", "have", "great", "camps", "here", "in", "every", "direction", ",", "of", "army", "wagons", ",", "teamsters", ",", "ambulance", "camps", ",", "&", "c.", "Some", "of", "them", "are", "permanent", ",", "&", "have", "small", "hospitals", "I", "go", "to", "them", ",", "(", "as", "no", "one", "else", "goes", ",", "ladies", "would", "not", "venture", ")", "I", "sometimes", "have", "the", "luck", "to", "give", "some", "of", "the", "drivers", "a", "great", "deal", "of", "comfort", "&", "help.", "Indeed", ",", "mother", ",", "there", "are", "camps", "here", "of", "every", "thing", "I", "went", "once", "or", "twice", "to", "the", "Contraband", "Camp,4", "to", "the", "Hospital", ",", "&", "c.", "but", "I", "could", "not", "bring", "myself", "to", "go", "again", "when", "I", "meet", "black", "men", "or", "boys", "among", "my", "own", "hospitals", ",", "I", "use", "them", "kindly", ",", "give", "them", "something", ",", "&", "c.", "I", "believe", "I", "told", "you", "that", "I", "do", "the", "same", "to", "the", "wounded", "rebels", ",", "too", "but", "as", "there", "is", "a", "limit", "to", "one", "'s", "sinews", "&", "endurance", "&", "sympathies", ",", "&", "c.", "I", "have", "got", "in", "the", "way", "after", "going", "lightly", "as", "it", "were", "all", "through", "the", "wards", "of", "a", "hospital", ",", "&", "trying", "to", "give", "a", "word", "of", "cheer", ",", "if", "nothing", "else", ",", "to", "every", "one", ",", "then", "confining", "my", "special", "attentions", "to", "the", "few", "where", "the", "investment", "seems", "to", "tell", "best", ",", "&", "who", "want", "it", "most", "Mother", ",", "I", "have", "real", "pride", "in", "telling", "you", "that", "I", "have", "the", "consciousness", "of", "saving", "quite", "a", "little", "number", "of", "lives", "by", "saving", "them", "from", "giving", "up", "&", "being", "a", "good", "deal", "with", "them", "the", "men", "say", "it", "is", "so", ",", "&", "the", "doctors", "say", "it", "is", "so", "&", "I", "will", "candidly", "confess", "I", "can", "see", "it", "is", "true", ",", "though", "I", "say", "it", "of", "myself", "I", "know", "you", "will", "like", "to", "hear", "it", ",", "mother", ",", "so", "I", "tell", "you", "I", "am", "finishing", "this", "in", "Major", "Hapgood", "'s", "office", ",", "about", "1", "o'clock", "it", "is", "pretty", "warm", ",", "but", "has", "not", "cleared", "off", "yet", "the", "trees", "look", "so", "well", "from", "where", "I", "am", ",", "&", "the", "Potomac", "it", "is", "a", "noble", "river", "I", "see", "it", "several", "miles", ",", "&", "Arlington", "heights", "Mother", ",", "I", "see", "some", "of", "the", "47th", "Brooklyn", "every", "day", "or", "two", "the", "reg't", "is", "on", "the", "Heights", "back", "of", "Arlington", "House", ",", "a", "fine", "camp", "ground", "O", ",", "Matty", ",", "I", "have", "just", "thought", "of", "you", "dear", "sister", ",", "how", "are", "you", "getting", "along", "?", "Jeff", ",", "I", "will", "write", "you", "truly", "Good", "bye", "for", "the", "present", ",", "dearest", "mother", ",", "&", "all", "Walt"], "date": [], "normalizedTime": "0.174622603019", "recipient": "Louisa Van Velsor Whitman", "organizations": ["Meade2", "Capitol", "Institute", "fine3", "Washington", "Contraband", "Hospital", "Heights"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00775.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to Louisa Van Velsor Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Thomas", "NNP"], ["Jefferson", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Horace G.", "Sergeant Major", "Corps", "Lee", "Dont", "Jeff"], "money": [], "year": "1863", "locations": [], "month": "Jul", "parties": ["Thomas Jefferson Whitman", "Walt Whitman"], "properDate": "Jul 8, 1863", "gpe": ["Brooklyn", "New York", "Hope"], "facility": [], "latlngs": [[40.65, -73.95], [40.7143528, -74.00597309999999], [33.6670615, -93.5915665]], "text": "  [Brooklyn, N. Y.] July 8th 1863 Dear Walt, Mr Lane1 is again very anxious about his boy, his name is Horace G. Tarr,2 and is Sergeant Major of the 20th Reg. of Connecticut Vol. If by chance you should hear anything of him will you please write. His Reg. belonged to the 12th army Corps, and I think were in the hottest of the fight. I sent you a letter last week with $14 in it and another yesterday with $10.3 Did you get them both? We are all well at home. The rejoicing in New York is sincere and almost universal and yet a few, (and yet only a few when compared with the immense city) who try to find some reason why Lee should have been whipped. Copperheads are getting out of circulation being laid up for a future contingency. Hope to hear from you soon. Dont forget me. Yours truly Jeff", "dateText": "", "percents": [], "taggedText": [[["[", "NN"], [["Brooklyn", "NNP"]], [",", ","], ["N", "NNP"], [".", "."]], [["Y", "NNP"], [".", "."]], [["]", "NN"], ["July", "NNP"], ["8th", "CD"], ["1863", "CD"], ["Dear", "NNP"], ["Walt", "NNP"], [",", ","], ["Mr", "NNP"], ["Lane1", "NNP"], ["is", "VBZ"], ["again", "RB"], ["very", "RB"], ["anxious", "JJ"], ["about", "IN"], ["his", "PRP$"], ["boy", "NN"], [",", ","], ["his", "PRP$"], ["name", "NN"], ["is", "VBZ"], [["Horace", "NNP"], ["G.", "NNP"]], ["Tarr,2", "NNP"], ["and", "CC"], ["is", "VBZ"], [["Sergeant", "NNP"], ["Major", "NNP"]], ["of", "IN"], ["the", "DT"], ["20th", "JJ"], ["Reg", "NNP"], [".", "."]], [["of", "IN"], [["Connecticut", "NNP"]], ["Vol", "NNP"], [".", "."]], [["If", "IN"], ["by", "IN"], ["chance", "NN"], ["you", "PRP"], ["should", "MD"], ["hear", "VB"], ["anything", "NN"], ["of", "IN"], ["him", "PRP"], ["will", "MD"], ["you", "PRP"], ["please", "VB"], ["write", "JJ"], [".", "."]], [["His", "PRP$"], ["Reg", "NNP"], [".", "."]], [["belonged", "VBD"], ["to", "TO"], ["the", "DT"], ["12th", "JJ"], ["army", "NN"], [["Corps", "NNP"]], [",", ","], ["and", "CC"], ["I", "PRP"], ["think", "VBP"], ["were", "VBD"], ["in", "IN"], ["the", "DT"], ["hottest", "NN"], ["of", "IN"], ["the", "DT"], ["fight", "NN"], [".", "."]], [["I", "PRP"], ["sent", "VBD"], ["you", "PRP"], ["a", "DT"], ["letter", "NN"], ["last", "JJ"], ["week", "NN"], ["with", "IN"], ["$", "$"], ["14", "CD"], ["in", "IN"], ["it", "PRP"], ["and", "CC"], ["another", "DT"], ["yesterday", "NN"], ["with", "IN"], ["$", "$"], ["10.3", "CD"], ["Did", "NNP"], ["you", "PRP"], ["get", "VB"], ["them", "PRP"], ["both", "DT"], ["?", "."]], [["We", "PRP"], ["are", "VBP"], ["all", "RB"], ["well", "RB"], ["at", "IN"], ["home", "NN"], [".", "."]], [["The", "DT"], ["rejoicing", "NN"], ["in", "IN"], [["New", "NNP"], ["York", "NNP"]], ["is", "VBZ"], ["sincere", "RB"], ["and", "CC"], ["almost", "RB"], ["universal", "JJ"], ["and", "CC"], ["yet", "RB"], ["a", "DT"], ["few", "JJ"], [",", ","], ["(", ":"], ["and", "CC"], ["yet", "RB"], ["only", "RB"], ["a", "DT"], ["few", "JJ"], ["when", "WRB"], ["compared", "VBN"], ["with", "IN"], ["the", "DT"], ["immense", "NN"], ["city", "NN"], [")", ":"], ["who", "WP"], ["try", "NN"], ["to", "TO"], ["find", "VB"], ["some", "DT"], ["reason", "NN"], ["why", "WRB"], [["Lee", "NNP"]], ["should", "MD"], ["have", "VB"], ["been", "VBN"], ["whipped", "VBN"], [".", "."]], [["Copperheads", "NNS"], ["are", "VBP"], ["getting", "VBG"], ["out", "RP"], ["of", "IN"], ["circulation", "NN"], ["being", "VBG"], ["laid", "VBN"], ["up", "RP"], ["for", "IN"], ["a", "DT"], ["future", "NN"], ["contingency", "NN"], [".", "."]], [[["Hope", "NNP"]], ["to", "TO"], ["hear", "VB"], ["from", "IN"], ["you", "PRP"], ["soon", "RB"], [".", "."]], [[["Dont", "NNP"]], ["forget", "VBD"], ["me", "PRP"], [".", "."]], [["Yours", "NNS"], ["truly", "RB"], [["Jeff", "NNP"]]]], "sentences": ["  [Brooklyn, N.", "Y.", "] July 8th 1863 Dear Walt, Mr Lane1 is again very anxious about his boy, his name is Horace G. Tarr,2 and is Sergeant Major of the 20th Reg.", "of Connecticut Vol.", "If by chance you should hear anything of him will you please write.", "His Reg.", "belonged to the 12th army Corps, and I think were in the hottest of the fight.", "I sent you a letter last week with $14 in it and another yesterday with $10.3 Did you get them both?", "We are all well at home.", "The rejoicing in New York is sincere and almost universal and yet a few, (and yet only a few when compared with the immense city) who try to find some reason why Lee should have been whipped.", "Copperheads are getting out of circulation being laid up for a future contingency.", "Hope to hear from you soon.", "Dont forget me.", "Yours truly Jeff"], "words": ["[", "Brooklyn", ",", "N.", "Y.", "]", "July", "8th", "1863", "Dear", "Walt", ",", "Mr", "Lane1", "is", "again", "very", "anxious", "about", "his", "boy", ",", "his", "name", "is", "Horace", "G.", "Tarr,2", "and", "is", "Sergeant", "Major", "of", "the", "20th", "Reg.", "of", "Connecticut", "Vol.", "If", "by", "chance", "you", "should", "hear", "anything", "of", "him", "will", "you", "please", "write.", "His", "Reg.", "belonged", "to", "the", "12th", "army", "Corps", ",", "and", "I", "think", "were", "in", "the", "hottest", "of", "the", "fight.", "I", "sent", "you", "a", "letter", "last", "week", "with", "$", "14", "in", "it", "and", "another", "yesterday", "with", "$", "10.3", "Did", "you", "get", "them", "both", "?", "We", "are", "all", "well", "at", "home.", "The", "rejoicing", "in", "New", "York", "is", "sincere", "and", "almost", "universal", "and", "yet", "a", "few", ",", "(", "and", "yet", "only", "a", "few", "when", "compared", "with", "the", "immense", "city", ")", "who", "try", "to", "find", "some", "reason", "why", "Lee", "should", "have", "been", "whipped.", "Copperheads", "are", "getting", "out", "of", "circulation", "being", "laid", "up", "for", "a", "future", "contingency.", "Hope", "to", "hear", "from", "you", "soon.", "Dont", "forget", "me.", "Yours", "truly", "Jeff"], "date": [], "normalizedTime": "0.174758601931", "recipient": "Walt Whitman", "organizations": [], "sender": "Thomas Jefferson Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00417.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Thomas Jefferson Whitman to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Lewis", "NNP"], ["K.", "NNP"], ["Brown", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Freind Walter", "Wilmington", "Mother", "Lewis", "Brown", "James McPauley", "Simple Mead"], "money": [], "year": "1863", "locations": [], "month": "Jul", "parties": ["Lewis K. Brown", "Walt Whitman"], "properDate": "Jul 10, 1863", "gpe": ["Washington", "Vicksburg", "Pennsylvania"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [32.3526456, -90.877882]], "text": " My Dear Freind Walter. It is with mutch pleasure that I take my pen in hand to inform you that I am well and that my leg is mending verry fast  I left Washington on the 2nd on the 6 1/2 O clock train but It was the rong train and I had to get of at Haver de gras and stay all night on the Boat or els go on to Wilmington and so I got of and stayed on the boat and as good luck would have it I met 3 men on the boat that I knowed and they maid me verry comfortable that night and then I left the next morning and got home in the evening and I gave Mother a verry agreeable Supprise I was verry tired the next day but I feel well now. I think that I will soon get well hear for I have everything that I want we have a splendid garden and we have a good many cherries in fact every thing, the nice grain fields around the house and every thing looks so well. I have had a good many of my young friends to see me. I have got your picture and I am a going to have it fraimed the first time I get whear I can have it don. I expect to go on a visit up to my GranFathers in about 4 weeks and I think that I will have a nice time up thear. I only wish that you wer hear I am sure that you would enjoy it for it is so nice or it appears so to me [w]ho has been pennd up in the Hospital for 10 months. My Father and Mother are well and send their respects to you for Mother says whoeve[r] did me a faivor or was a friend to me was one to her and you have bin a friend in nead and that is a friend indead. I expect that you still visit the Hospital if so give my respects to the boys  I have nothing more to write at present so I will have to close hoping verry soon to hear from you so good by and God bless you from your affectionet friend   Lewis K Brown  care of James McPauley P.S. pleas excues this bad writing as well as spelling  I have just herd of the fall of Vicksburg and I am g[l]ad of it and Simple Mead has drove the rebbels out of Pennsylvania.  ", "dateText": "", "percents": [], "taggedText": [[["My", "PRP$"], ["Dear", "NNP"], [["Freind", "NNP"], ["Walter", "NNP"]], [".", "."]], [["It", "PRP"], ["is", "VBZ"], ["with", "IN"], ["mutch", "NN"], ["pleasure", "NN"], ["that", "WDT"], ["I", "PRP"], ["take", "VBP"], ["my", "PRP$"], ["pen", "NN"], ["in", "IN"], ["hand", "NN"], ["to", "TO"], ["inform", "VB"], ["you", "PRP"], ["that", "IN"], ["I", "PRP"], ["am", "VBP"], ["well", "RB"], ["and", "CC"], ["that", "IN"], ["my", "PRP$"], ["le