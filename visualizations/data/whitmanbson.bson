", "NN"], ["Saturday", "NNP"], ["next", "JJ"], [")", "NN"], ["WW", "NNP"]]], "sentences": ["  431 Stevens st cor West Camden, N.J.           Nov. 3.", "All going on about same.", "I want to come on next Monday (8th inst) & stay a few days   Would like to stop at Mr. N[ash]'s.", "(Will write so you will get particular word Saturday next)     WW        "], "words": ["431", "Stevens", "st", "cor", "West", "Camden", ",", "N.J.", "Nov.", "3.", "All", "going", "on", "about", "same.", "I", "want", "to", "come", "on", "next", "Monday", "(", "8th", "inst", ")", "&", "stay", "a", "few", "days", "Would", "like", "to", "stop", "at", "Mr.", "N", "[", "ash", "]", "'s.", "(", "Will", "write", "so", "you", "will", "get", "particular", "word", "Saturday", "next", ")", "WW"], "date": [], "normalizedTime": "0.786889704882", "recipient": "Peter Doyle", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/nyp.00374.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Peter Doyle ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Ellen", "NNP"], ["M.", "NNP"]], ["O'Connor", "NNP"], [",", ","]]], "people": ["Nash", "Navy Yard", "Love", "Walt"], "money": [], "year": "1875", "locations": [], "month": "Nov", "parties": ["Walt", "Whitman", "Ellen M."], "properDate": "Nov 9, 1875", "gpe": ["Washington"], "facility": [], "latlngs": [[38.8951118, -77.0363658]], "text": "  Tuesday, 9th Nov. 11 a.m.                  Dear Nelly,        I am in Washington, stopping at Mr. & Mrs. Nash's, L st. south east, Navy Yard   am middling well, for me   shall be in pretty sure up to 10 a.m. & from 2 to 3 p.m. Am so fixed that it is very convenient          for my friends to call   Love to you.         Walt W        ", "dateText": "", "percents": [], "taggedText": [[["Tuesday", "NNP"], [",", ","], ["9th", "JJ"], ["Nov.", "NNP"], ["11", "CD"], ["a.m.", "NNP"], ["Dear", "NNP"], ["Nelly", "NNP"], [",", ","], ["I", "PRP"], ["am", "VBP"], ["in", "IN"], [["Washington", "NNP"]], [",", ","], ["stopping", "VBG"], ["at", "IN"], [["Mr.", "NNP"]], ["&", "CC"], ["Mrs.", "NNP"], [["Nash", "NNP"]], ["'s", "POS"], [",", ","], [["L", "NNP"]], ["st.", "NNP"], ["south", "NN"], ["east", "NN"], [",", ","], [["Navy", "NNP"], ["Yard", "NNP"]], ["am", "VBP"], ["middling", "VBG"], ["well", "RB"], [",", ","], ["for", "IN"], ["me", "PRP"], ["shall", "MD"], ["be", "VB"], ["in", "IN"], ["pretty", "NN"], ["sure", "NN"], ["up", "IN"], ["to", "TO"], ["10", "CD"], ["a.m.", "NNP"], ["&", "CC"], ["from", "IN"], ["2", "CD"], ["to", "TO"], ["3", "CD"], ["p.m.", "NN"], ["Am", "NNP"], ["so", "RB"], ["fixed", "VBN"], ["that", "IN"], ["it", "PRP"], ["is", "VBZ"], ["very", "RB"], ["convenient", "JJ"], ["for", "IN"], ["my", "PRP$"], ["friends", "NNS"], ["to", "TO"], ["call", "VB"], [["Love", "NNP"]], ["to", "TO"], ["you", "PRP"], [".", "."]], [[["Walt", "NNP"]], ["W", "NNP"]]], "sentences": ["  Tuesday, 9th Nov. 11 a.m.                  Dear Nelly,        I am in Washington, stopping at Mr. & Mrs. Nash's, L st. south east, Navy Yard   am middling well, for me   shall be in pretty sure up to 10 a.m. & from 2 to 3 p.m. Am so fixed that it is very convenient          for my friends to call   Love to you.", "Walt W        "], "words": ["Tuesday", ",", "9th", "Nov.", "11", "a.m.", "Dear", "Nelly", ",", "I", "am", "in", "Washington", ",", "stopping", "at", "Mr.", "&", "Mrs.", "Nash", "'s", ",", "L", "st.", "south", "east", ",", "Navy", "Yard", "am", "middling", "well", ",", "for", "me", "shall", "be", "in", "pretty", "sure", "up", "to", "10", "a.m.", "&", "from", "2", "to", "3", "p.m.", "Am", "so", "fixed", "that", "it", "is", "very", "convenient", "for", "my", "friends", "to", "call", "Love", "to", "you.", "Walt", "W"], "date": [], "normalizedTime": "0.787705698354", "recipient": "Ellen M.", "organizations": ["Mr.", "L"], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/nyp.00366.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Ellen M. O'Connor ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["John", "NNP"], ["Burroughs", "NNP"]], [",", ","]]], "people": ["Stevens st.", "John Burroughs", "Jenny Grant", "Marvin", "Lord", "Houghton", "Walt", "Love", "Walt"], "money": [], "year": "1875", "locations": ["West"], "month": "Dec", "parties": ["Walt", "Whitman", "John Burroughs"], "properDate": "Dec 17, 1875", "gpe": ["Camden", "Washington", "England"], "facility": [], "latlngs": [[51.55170589999999, -0.1588255], [38.8951118, -77.0363658], [52.3555177, -1.1743197]], "text": "  431 Stevens st. cor West. Camden, N. Jersey.           Dec. 17                  Dear John Burroughs,        I have been back here two weeks & over   My Washington jaunt occupied some seventeen or eighteen days,          & was a very pleasant one for me   (started out with the idea of a two days visit only)   Am perhaps now lately          not so well, but not much different   the gravest trouble is the liver and stomachic business now   Still I keep          up about the same, (& get mad at myself for grunting)   Your letter of two days since rec'd.          Best love to 'Sula, & to Jenny Grant if there    My new edition is nearly ready   Two Vols   will give you early advice of their appearance   only 100 copies issued   Is the Winter Sunshine out? Eldridge call'd to see me on his return home two weeks since. Marvin has gone to England,          with a Treas[ury] squad. He has call'd on Mrs. Gilchrist. M. D. Conway called on me. Lord Houghton also.        We have great times in this house   a baby has arrived, a fine lusty little fellow, now five weeks old   (he has been named Walt)   just now though he is quite sick, but I opine will get along   The rest all very well, except that my sister,          the mother, is part of the time only middling. I hear young Walt raising his song, in the room overhead as          I conclude my letter    Love to you, as always, my friend            Walt.        ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"]], ["cor", "NN"], [["West", "NNP"]], [".", "."]], [[["Camden", "NNP"]], [",", ","], ["N.", "NNP"], ["Jersey", "NNP"], [".", "."]], [["Dec.", "NNP"], ["17", "CD"], ["Dear", "NNP"], [["John", "NNP"], ["Burroughs", "NNP"]], [",", ","], ["I", "PRP"], ["have", "VBP"], ["been", "VBN"], ["back", "RP"], ["here", "RB"], ["two", "CD"], ["weeks", "NNS"], ["&", "CC"], ["over", "IN"], ["My", "NNP"], [["Washington", "NNP"]], ["jaunt", "NN"], ["occupied", "VBD"], ["some", "DT"], ["seventeen", "VBN"], ["or", "CC"], ["eighteen", "VBN"], ["days", "NNS"], [",", ","], ["&", "CC"], ["was", "VBD"], ["a", "DT"], ["very", "RB"], ["pleasant", "JJ"], ["one", "CD"], ["for", "IN"], ["me", "PRP"], ["(", ":"], ["started", "VBD"], ["out", "IN"], ["with", "IN"], ["the", "DT"], ["idea", "NN"], ["of", "IN"], ["a", "DT"], ["two", "CD"], ["days", "NNS"], ["visit", "NN"], ["only", "RB"], [")", "."], ["Am", "NNP"], ["perhaps", "RB"], ["now", "RB"], ["lately", "RB"], ["not", "RB"], ["so", "RB"], ["well", "RB"], [",", ","], ["but", "CC"], ["not", "RB"], ["much", "JJ"], ["different", "JJ"], ["the", "DT"], ["gravest", "JJS"], ["trouble", "NN"], ["is", "VBZ"], ["the", "DT"], ["liver", "NN"], ["and", "CC"], ["stomachic", "JJ"], ["business", "NN"], ["now", "RB"], ["Still", "NNP"], ["I", "PRP"], ["keep", "VBP"], ["up", "RP"], ["about", "IN"], ["the", "DT"], ["same", "JJ"], [",", ","], ["(", ":"], ["&", "CC"], ["get", "VB"], ["mad", "JJ"], ["at", "IN"], ["myself", "PRP"], ["for", "IN"], ["grunting", "VBG"], [")", ":"], ["Your", "NNP"], ["letter", "NN"], ["of", "IN"], ["two", "CD"], ["days", "NNS"], ["since", "IN"], ["rec", "NN"], ["'d", "JJ"], [".", "."]], [["Best", "JJS"], ["love", "VBP"], ["to", "TO"], ["'Sula", "NNP"], [",", ","], ["&", 