", "again.", "Walt", "."], "date": [], "normalizedTime": "0.481572147423", "recipient": "Peter Doyle", "organizations": ["Pete", "Battery", "Broadway", "Foy", "City"], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/loc.01522.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Peter Doyle ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Washington", "NNP"], ["Friends", "NNPS"]], [",", ","]]], "people": [], "money": [], "year": "1869", "locations": [], "month": "Sep", "parties": ["Walt", "Whitman", "Washington Friends"], "properDate": "Sep 13, 1869", "gpe": ["Brooklyn", "Washington"], "facility": [], "latlngs": [[40.65, -73.95], [38.8951118, -77.0363658]], "text": "  Brooklyn                     September 13, 1869.                                  My friends,              I shall return to Washington either on Wednesday next, 15th or                  Thursday, 16th   Shall probably come in the train which gets in at 10:15 p.m.               Walt Whitman              ", "dateText": "", "percents": [], "taggedText": [[[["Brooklyn", "NNP"]], ["September", "NNP"], ["13", "CD"], [",", ","], ["1869", "CD"], [".", "."]], [["My", "PRP$"], ["friends", "NNS"], [",", ","], ["I", "PRP"], ["shall", "MD"], ["return", "VB"], ["to", "TO"], [["Washington", "NNP"]], ["either", "DT"], ["on", "IN"], ["Wednesday", "NNP"], ["next", "JJ"], [",", ","], ["15th", "JJ"], ["or", "CC"], ["Thursday", "NNP"], [",", ","], ["16th", "JJ"], ["Shall", "NNP"], ["probably", "RB"], ["come", "VBN"], ["in", "IN"], ["the", "DT"], ["train", "NN"], ["which", "WDT"], ["gets", "VBZ"], ["in", "IN"], ["at", "IN"], ["10:15", "CD"], ["p.m.", "NNP"], ["Walt", "NNP"], ["Whitman", "NNP"]]], "sentences": ["  Brooklyn                     September 13, 1869.", "My friends,              I shall return to Washington either on Wednesday next, 15th or                  Thursday, 16th   Shall probably come in the train which gets in at 10:15 p.m.               Walt Whitman              "], "words": ["Brooklyn", "September", "13", ",", "1869.", "My", "friends", ",", "I", "shall", "return", "to", "Washington", "either", "on", "Wednesday", "next", ",", "15th", "or", "Thursday", ",", "16th", "Shall", "probably", "come", "in", "the", "train", "which", "gets", "in", "at", "10:15", "p.m.", "Walt", "Whitman"], "date": [], "normalizedTime": "0.481980144159", "recipient": "Washington Friends", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/prc.00023.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Washington Friends ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["William", "NNP"], ["D.", "NNP"]], ["O'Connor", "NNP"], [",", ","]]], "people": ["Dear", "William", "Mr. Parton", "Mr. Parton", "Mr.", "Parton", "Mr. Oliver Dyer", "Mr. Dyer", "Mr. Parton", "Jesse Talbot", "Mr. Dyer", "Mr. Parton", "Mr. Dyer", "Mr. Dyer", "Mr. Dyer", "Walt Whitman"], "money": [], "year": "1869", "locations": [], "month": "Sep", "parties": ["Walt", "Whitman", "William D."], "properDate": "Sep 28, 1869", "gpe": ["Washington", "Classon", "Brooklyn", "Brooklyn", "Pilgrim"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [40.65, -73.95], [40.65, -73.95]], "text": "  Attorney General's Office, Washington, Sept 28, 1869.                                  Dear William O'Connor:              As you were interested in Mr. Parton's money-borrowing                 item about me, I enclose you the receipts signed & given me by his Attorney at                 the time, (June, 1857.) The sum borrowed by me of Mr. Parton was Two hundred                 dollars. He had, just before, kindly volunteered the loan himself, without the least                 request or hint from me. I then declined, but afterward borrowed the money, &                 gave a short-time Note. I felt soon, & feel now, that it was a great impropriety                 on my part, & it has caused me much compunction & real unhappiness since.                 Any how when the time for paying the note came, I had no money. Mr. Parton then put                 the matter in the hands of his Attorney, Mr. Oliver Dyer, who sued. My recollection                 is that I confessed judgment, & proposed to Mr. Dyer that he should receive                 payment in goods. He came by appointment to my room in Classon avenue, Brooklyn,                 June 17, 1857, talked over the matter, behaved very kindly, positively accepted                 there & then, & conveyed away, goods to the amount of One hundred and eighty                 one dollars, and receipted for them, on account. He also, for the balance,                 conditionally accepted other goods, (which he also conveyed away with him,) on the                 agreement between us that if they, when more deliberately examined, proved                 acceptable, they would requite the balance, & the debt would be considered paid;                 otherwise they would be returned, & the balance would still stand against me.                 These goods he retained, and subsequently told me that they had proved acceptable,                 and consented to give me a receipt in full, & satisfaction paper   but, (I                 think,) said the latter would require the signature of Mr. Parton. This was a                 meeting either in the street, or on the Brooklyn ferry. On meeting him afterwards in                 a similar way, once or twice, I mentioned the matter of a receipt in full, but never                 pressed it   never procured such receipt, nor the original note either. I consider the debt paid   (though if I had wealth,                 to-day, I should certainly pay it over again, in cash.) Among the goods rendered I                 remember an oil painting, an original, of marked beauty & value, by Jesse                     Talbot, illustrating a scene                 from Pilgrim's Progress, worth from four to five hundred dollars. This I put, if I                 remember right, at one hundred dollars. I presume Mr. Dyer or Mr. Parton has it yet. The enclosed receipt, marked 1, was, on turning over the goods,                 written by me & signed, by Mr. Dyer, who then remarked that he would also give                 me one in more technical form, and wrote, signed, & handed me the receipt marked                     2   I presume, (but do not know for                 certain,) that Mr. Dyer considers the debt fully paid. (The balance of thirty five dollars mentioned, besides the one hundred & eighty                 one includes sixteen dollars as Mr. Dyer's fee, or more probably costs of suit, over                 & above the original two hundred.)   Walt Whitman              ", "dateText": "", "percents": [], "taggedText": [[["Attorney", "NNP"], ["General", "NNP"], ["'s", "POS"], ["Office", "NNP"], [",", ","], [["Washington", "NNP"]], [",", ","], ["Sept", "NNP"], ["28", "CD"], [",", ","], ["1869", "CD"], [".", "."]], [[["Dear", "NNP"]], [["William", "NNP"]], ["O'Connor", "NNP"], [":", ":"], ["As", "IN"], ["you", "PRP"], ["were", "VBD"], ["interested", "JJ"], ["in", "IN"], [["Mr.", "NNP"], ["Parton", "NNP"]], ["'s", "POS"], ["money-borrowing", "JJ"], ["item", "NN"], ["about", "IN"], ["me", "PRP"], [",", ","], ["I", "PRP"], ["enclose", "VBP"], ["you", "PRP"], ["the", "DT"], ["receipts", "NNS"], ["signed", "VBD"], ["&", "CC"], ["given", "VBN"], ["me", "PRP"], ["by", "IN"], ["his", "PRP$"], ["Attorney", "NNP"], ["at", "IN"], ["the", "DT"], ["time", "NN"], [",", ","], ["(", ":"], ["June", "NNP"], [",", ","], ["1857", "CD"], [".", "."]], [[")", "NN"], ["The", "DT"], ["sum", "NN"], ["borrowed", "VBD"], ["by", "IN"], ["me", "PRP"], ["of", "IN"], [["Mr.", "NNP"], ["Parton", "NNP"]], ["was", "VBD"], ["Two", "CD"], ["hundre