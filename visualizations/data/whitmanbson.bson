              "], "words": ["Department", "of", "Justice", "Washington", "Dec.", "7", "1871", "Rudolf", "Schmidt", ",", "Dear", "Sir", ":", "I", "have", "received", ",", "(", "through", "Mr.", "Clausen", ")", "your", "letter", "of", "19th", "October", ",", "from", "Kopenhagen", "&", "I", "cheerfully", "forward", "you", "my", "poems", "``", "Leaves", "of", "Grass", ",", "''", "&", "a", "small", "prose", "work", "of", "mine", ",", "``", "Democratic", "Vistas.", "''", "I", "also", "enclose", "several", "articles", "&", "criticisms", "written", "about", "my", "books", "in", "England", "&", "America", "within", "the", "last", "ten", "years.", "May", "I", "say", ",", "there", "is", "something", "about", "your", "letter", "&", "application", "that", "has", "deeply", "pleased", "me.", "I", "should", "like", "to", "know", "your", "country", "&", "people", "&", "especially", "you", "yourself", ",", "&", "your", "poet", "Bj\u00f6rnson", "and", "Hans", "Andersen.", "How", "proud", "I", "should", "be", "to", "become", "known", "to", "you", "all.", "Pray", "let", "me", "hear", "from", "you", "and", "if", "the", "books", "&", "papers", "reach", "you", "safely.", "Please", "accept", "my", "best", ",", "brotherly", "good", "will.", "Any", "thing", "by", "mail", "will", "reach", "me", "addressed", "Walt", "Whitman", "Washington", ",", "D.", "C.", "U.", "S.", "of", "America"], "date": [], "normalizedTime": "0.592819257446", "recipient": "Rudolf Schmidt", "organizations": ["Justice Washington", "Kopenhagen", "Democratic Vistas"], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/rlc.00002.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Rudolf Schmidt ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], ["W.", "NNP"], ["H.", "NNP"], ["Piper", "NNP"], ["&", "CC"], ["Co.", "NNP"], [",", ","]]], "people": [], "money": [], "year": "1871", "locations": [], "month": "Dec", "parties": ["Walt", "Whitman"], "properDate": "Dec 8, 1871", "gpe": ["India"], "facility": [], "latlngs": [], "text": "  Department of Justice                     Washington.                     Dec. 7 1871.                                  W. H. Piper & Co.                 Dear Sirs:              Please send me acc't. & remit am't. sold   25 per cent off   of                  25 Copies \"Leaves of Grass\" @ $2.50 25 Copies \"Passage to India\" @ 1. 25 Copies \"Democratic Vistas\" @ .75                  sent you on sale, & receipted by you Nov. 3, 1870.                  Respectfully, &c.                 Walt Whitman              ", "dateText": "", "percents": [], "taggedText": [[["Department", "NN"], ["of", "IN"], [["Justice", "NNP"], ["Washington", "NNP"]], [".", "."]], [["Dec.", "NNP"], ["7", "CD"], ["1871", "CD"], [".", "."]], [["W.", "NNP"], ["H.", "NNP"], ["Piper", "NNP"], ["&", "CC"], ["Co.", "NNP"], ["Dear", "NNP"], ["Sirs", "NNP"], [":", ":"], ["Please", "NNP"], ["send", "NN"], ["me", "PRP"], ["acc't", "JJ"], [".", "."]], [["&", "CC"], ["remit", "NN"], ["am't", "JJ"], [".", "."]], [["sold", "VBD"], ["25", "CD"], ["per", "IN"], ["cent", "NN"], ["off", "IN"], ["of", "IN"], ["25", "CD"], ["Copies", "NNS"], ["``", "``"], ["Leaves", "NNS"], ["of", "IN"], [["Grass", "NNP"]], ["''", "''"], ["@", ":"], ["$", "$"], ["2.50", "CD"], ["25", "CD"], ["Copies", "NNS"], ["``", "``"], ["Passage", "NNP"], ["to", "TO"], [["India", "NNP"]], ["''", "''"], ["@", ":"], ["1", "CD"], [".", "."]], [["25", "CD"], ["Copies", "NNS"], ["``", "``"], [["Democratic", "JJ"], ["Vistas", "NNP"]], ["''", "''"], ["@", ":"], [".75", "CD"], ["sent", "NN"], ["you", "PRP"], ["on", "IN"], ["sale", "NN"], [",", ","], ["&", "CC"], ["receipted", "VBN"], ["by", "IN"], ["you", "PRP"], ["Nov.", "NNP"], ["3", "CD"], [",", ","], ["1870", "CD"], [".", "."]], [["Respectfully", "RB"], [",", ","], ["&", "CC"], ["c.", "NNP"], ["Walt", "NNP"], ["Whitman", "NNP"]]], "sentences": ["  Department of Justice                     Washington.", "Dec. 7 1871.", "W. H. Piper & Co.                 Dear Sirs:              Please send me acc't.", "& remit am't.", "sold   25 per cent off   of                  25 Copies \"Leaves of Grass\" @ $2.50 25 Copies \"Passage to India\" @ 1.", "25 Copies \"Democratic Vistas\" @ .75                  sent you on sale, & receipted by you Nov. 3, 1870.", "Respectfully, &c.                 Walt Whitman              "], "words": ["Department", "of", "Justice", "Washington.", "Dec.", "7", "1871.", "W.", "H.", "Piper", "&", "Co.", "Dear", "Sirs", ":", "Please", "send", "me", "acc't.", "&", "remit", "am't.", "sold", "25", "per", "cent", "off", "of", "25", "Copies", "``", "Leaves", "of", "Grass", "''", "@", "$", "2.50", "25", "Copies", "``", "Passage", "to", "India", "''", "@", "1.", "25", "Copies", "``", "Democratic", "Vistas", "''", "@", ".75", "sent", "you", "on", "sale", ",", "&", "receipted", "by", "you", "Nov.", "3", ",", "1870.", "Respectfully", ",", "&", "c.", "Walt", "Whitman"], "date": [], "normalizedTime": "0.592955256358", "recipient": "", "organizations": ["Justice Washington", "Grass", "Democratic Vistas"], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/yal.00398.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to W. H. Piper & Co. ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Louisa", "NNP"], ["Van", "NNP"], ["Velsor", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Christmas", "George", "Martha", "Han Good", "Love"], "money": [], "year": "1871", "locations": [], "month": "Dec", "parties": ["Walt", "Whitman", "Louisa Van Velsor Whitman"], "properDate": "Dec 25, 1871", "gpe": ["Newport", "Spanish", "Mother"], "facility": [], "latlngs": [[51.584151, -2.997664]], "text": "  Department of Justice                     Washington 187.                     Dec. 25   Evening \u00bd past 6     Well, mama dear, Christmas day is finished, & I thought I would just send you a line   We have had a mild day, as warm as spring   I took dinner at O'Connor's by invitation   we had an excellent dinner   I am invited to Dr. Channings this evening, but I hardly feel like going, & shall not go   They are very clever people, & have invited me to Newport next summer    I am writing this in the office, (alone in my own room)   I have just time to catch the mail   I hope you have had a nice Christmas, mama dear   May be George & Lou are with you   (I hope you will all take a glass of the Spanish wine)    I believe I told you in my last that I wrote to Martha and Han   Good bye, mama dear, for this time, & Love to you & Lou & all     Walt.              Mother, I will send the order in my next   The bells are all ringing for 7 oclock church   there is a chime of bells in one of the churches   they are playing an old hymn tune   it sounds good   it is a beautiful moonlight night    ", "dateText": "", "percents": [], "taggedText": [[["Department", "NN"], ["of", "IN"], [["Justice", "NNP"], ["Washington", "NNP"]], ["187", "CD"], [".", "."]], [["Dec.", "NNP"], ["25", "CD"], ["Evening", "NNP"], ["\u00bd", "NNP"], ["past", "NN"], ["6", "CD"], ["Well", "NNP"], [",", ","], ["mama", "NN"], ["dear", "NN"], [",", ","], [["Christmas", "NNP"]], ["day", "NN"], ["is", "VBZ"], ["finished", "VBN"], [",", ","], ["&", "CC"], ["I", "PRP"], ["thought", "VBD"], ["I", "PRP"], ["would", "MD"], ["just", "RB"], ["send", "VB"], ["you", "PRP"], ["a", "DT"], ["line", "NN"], ["We", "PRP"], ["have", "VBP"], ["had", "VBN"], ["a", "DT"], ["mild", "NN"], ["day", "NN"], [",", ","], ["as", "IN"], ["warm", "NN"], ["as", "IN"], ["spring", "NN"], ["I", "PRP"], ["took", "VBD"], ["dinner", "NN"], ["at", "IN"], [["O'Connor", "NNP"]], ["'s", "POS"], ["by", "IN"], ["invitation", "NN"], ["we", "PRP"], ["had", "VBD"], ["an", "DT"], ["excellent", "NN"], ["dinner", "NN"], ["I", "PRP"], ["am", "VBP"], ["invited", "VBN"