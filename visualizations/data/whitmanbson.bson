ars", "VBZ"], ["so", "RB"], ["to", "TO"], ["me", "PRP"], ["[", ":"], ["w", "NN"], ["]", ":"], ["ho", "NN"], ["has", "VBZ"], ["been", "VBN"], ["pennd", "JJ"], ["up", "RP"], ["in", "IN"], ["the", "DT"], [["Hospital", "NNP"]], ["for", "IN"], ["10", "CD"], ["months", "NNS"], [".", "."]], [["My", "PRP$"], ["Father", "NNP"], ["and", "CC"], ["Mother", "NNP"], ["are", "VBP"], ["well", "RB"], ["and", "CC"], ["send", "VB"], ["their", "PRP$"], ["respects", "NNS"], ["to", "TO"], ["you", "PRP"], ["for", "IN"], [["Mother", "NNP"]], ["says", "VBZ"], ["whoeve", "JJ"], ["[", "NN"], ["r", "NN"], ["]", ":"], ["did", "VBD"], ["me", "PRP"], ["a", "DT"], ["faivor", "NN"], ["or", "CC"], ["was", "VBD"], ["a", "DT"], ["friend", "NN"], ["to", "TO"], ["me", "PRP"], ["was", "VBD"], ["one", "CD"], ["to", "TO"], ["her", "PRP$"], ["and", "CC"], ["you", "PRP"], ["have", "VBP"], ["bin", "VBN"], ["a", "DT"], ["friend", "NN"], ["in", "IN"], ["nead", "NN"], ["and", "CC"], ["that", "IN"], ["is", "VBZ"], ["a", "DT"], ["friend", "NN"], ["indead", "NN"], [".", "."]], [["I", "PRP"], ["expect", "VBP"], ["that", "IN"], ["you", "PRP"], ["still", "RB"], ["visit", "VBP"], ["the", "DT"], [["Hospital", "NNP"]], ["if", "IN"], ["so", "RB"], ["give", "VBP"], ["my", "PRP$"], ["respects", "NNS"], ["to", "TO"], ["the", "DT"], ["boys", "NNS"], ["I", "PRP"], ["have", "VBP"], ["nothing", "NN"], ["more", "JJR"], ["to", "TO"], ["write", "VB"], ["at", "IN"], ["present", "NN"], ["so", "RB"], ["I", "PRP"], ["will", "MD"], ["have", "VB"], ["to", "TO"], ["close", "VB"], ["hoping", "NN"], ["verry", "NN"], ["soon", "RB"], ["to", "TO"], ["hear", "VB"], ["from", "IN"], ["you", "PRP"], ["so", "RB"], ["good", "JJ"], ["by", "IN"], ["and", "CC"], ["God", "NNP"], ["bless", "NN"], ["you", "PRP"], ["from", "IN"], ["your", "PRP$"], ["affectionet", "NN"], ["friend", "NN"], [["Lewis", "NNP"]], ["K", "NNP"], [["Brown", "NNP"]], ["care", "NN"], ["of", "IN"], [["James", "NNP"], ["McPauley", "NNP"]], ["P.S", "NNP"], [".", "."]], [["pleas", "NNS"], ["excues", "NNS"], ["this", "DT"], ["bad", "JJ"], ["writing", "NN"], ["as", "IN"], ["well", "RB"], ["as", "IN"], ["spelling", "VBG"], ["I", "PRP"], ["have", "VBP"], ["just", "RB"], ["herd", "VBN"], ["of", "IN"], ["the", "DT"], ["fall", "NN"], ["of", "IN"], [["Vicksburg", "NNP"]], ["and", "CC"], ["I", "PRP"], ["am", "VBP"], ["g", "JJ"], ["[", "NN"], ["l", "NN"], ["]", ":"], ["ad", "NN"], ["of", "IN"], ["it", "PRP"], ["and", "CC"], [["Simple", "NNP"], ["Mead", "NNP"]], ["has", "VBZ"], ["drove", "JJ"], ["the", "DT"], ["rebbels", "NNS"], ["out", "IN"], ["of", "IN"], [["Pennsylvania", "NNP"]], [".", "."]]], "sentences": [" My Dear Freind Walter.", "It is with mutch pleasure that I take my pen in hand to inform you that I am well and that my leg is mending verry fast  I left Washington on the 2nd on the 6 1/2 O clock train but It was the rong train and I had to get of at Haver de gras and stay all night on the Boat or els go on to Wilmington and so I got of and stayed on the boat and as good luck would have it I met 3 men on the boat that I knowed and they maid me verry comfortable that night and then I left the next morning and got home in the evening and I gave Mother a verry agreeable Supprise I was verry tired the next day but I feel well now.", "I think that I will soon get well hear for I have everything that I want we have a splendid garden and we have a good many cherries in fact every thing, the nice grain fields around the house and every thing looks so well.", "I have had a good many of my young friends to see me.", "I have got your picture and I am a going to have it fraimed the first time I get whear I can have it don.", "I expect to go on a visit up to my GranFathers in about 4 weeks and I think that I will have a nice time up thear.", "I only wish that you wer hear I am sure that you would enjoy it for it is so nice or it appears so to me [w]ho has been pennd up in the Hospital for 10 months.", "My Father and Mother are well and send their respects to you for Mother says whoeve[r] did me a faivor or was a friend to me was one to her and you have bin a friend in nead and that is a friend indead.", "I expect that you still visit the Hospital if so give my respects to the boys  I have nothing more to write at present so I will have to close hoping verry soon to hear from you so good by and God bless you from your affectionet friend   Lewis K Brown  care of James McPauley P.S.", "pleas excues this bad writing as well as spelling  I have just herd of the fall of Vicksburg and I am g[l]ad of it and Simple Mead has drove the rebbels out of Pennsylvania.  "], "words": ["My", "Dear", "Freind", "Walter.", "It", "is", "with", "mutch", "pleasure", "that", "I", "take", "my", "pen", "in", "hand", "to", "inform", "you", "that", "I", "am", "well", "and", "that", "my", "leg", "is", "mending", "verry", "fast", "I", "left", "Washington", "on", "the", "2nd", "on", "the", "6", "1/2", "O", "clock", "train", "but", "It", "was", "the", "rong", "train", "and", "I", "had", "to", "get", "of", "at", "Haver", "de", "gras", "and", "stay", "all", "night", "on", "the", "Boat", "or", "els", "go", "on", "to", "Wilmington", "and", "so", "I", "got", "of", "and", "stayed", "on", "the", "boat", "and", "as", "good", "luck", "would", "have", "it", "I", "met", "3", "men", "on", "the", "boat", "that", "I", "knowed", "and", "they", "maid", "me", "verry", "comfortable", "that", "night", "and", "then", "I", "left", "the", "next", "morning", "and", "got", "home", "in", "the", "evening", "and", "I", "gave", "Mother", "a", "verry", "agreeable", "Supprise", "I", "was", "verry", "tired", "the", "next", "day", "but", "I", "feel", "well", "now.", "I", "think", "that", "I", "will", "soon", "get", "well", "hear", "for", "I", "have", "everything", "that", "I", "want", "we", "have", "a", "splendid", "garden", "and", "we", "have", "a", "good", "many", "cherries", "in", "fact", "every", "thing", ",", "the", "nice", "grain", "fields", "around", "the", "house", "and", "every", "thing", "looks", "so", "well.", "I", "have", "had", "a", "good", "many", "of", "my", "young", "friends", "to", "see", "me.", "I", "have", "got", "your", "picture", "and", "I", "am", "a", "going", "to", "have", "it", "fraimed", "the", "first", "time", "I", "get", "whear", "I", "can", "have", "it", "don.", "I", "expect", "to", "go", "on", "a", "visit", "up", "to", "my", "GranFathers", "in", "about", "4", "weeks", "and", "I", "think", "that", "I", "will", "have", "a", "nice", "time", "up", "thear.", "I", "only", "wish", "that", "you", "wer", "hear", "I", "am", "sure", "that", "you", "would", "enjoy", "it", "for", "it", "is", "so", "nice", "or", "it", "appears", "so", "to", "me", "[", "w", "]", "ho", "has", "been", "pennd", "up", "in", "the", "Hospital", "for", "10", "months.", "My", "Father", "and", "Mother", "are", "well", "and", "send", "their", "respects", "to", "you", "for", "Mother", "says", "whoeve", "[", "r", "]", "did", "me", "a", "faivor", "or", "was", "a", "friend", "to", "me", "was", "one", "to", "her", "and", "you", "have", "bin", "a", "friend", "in", "nead", "and", "that", "is", "a", "friend", "indead.", "I", "expect", "that", "you", "still", "visit", "the", "Hospital", "if", "so", "give", "my", "respects", "to", "the", "boys", "I", "have", "nothing", "more", "to", "write", "at", "present", "so", "I", "will", "have", "to", "close", "hoping", "verry", "soon", "to", "hear", "from", "you", "so", "good", "by", "and", "God", "bless", "you", "from", "your", "affectionet", "friend", "Lewis", "K", "Brown", "care", "of", "James", "McPauley", "P.S.", "pleas", "excues", "this", "bad", "writing", "as", "well", "as", "spelling", "I", "have", "just", "herd", "of", "the", "fall", "of", "Vicksburg", "and", "I", "am", "g", "[", "l", "]", "ad", "of", "it", "and", "Simple", "Mead", "has", "drove", "the", "rebbels", "out", "of", "Pennsylvania", "."], "date": [], "normalizedTime": "0.175030599755", "recipient": "Walt Whitman", "organizations": ["Haver", "Boat", "Hospital", "Hospital"], "sender": "Lewis K. Brown", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/tex.00126.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Lewis K. Brown to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Louisa", "NNP"], ["Van", "NNP"], ["Velsor", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Bluffs", "George", "Han", "George", "Campbell Hospital", "Mother", "Jeff", "Mat", "Walt", "Mary"], "money": [], "year": "1863", "locations": [], "month": "Jul", "parties": ["Walt Whitman", "Louisa Van Velsor Whitman"], "properDate": "Jul 10, 1863", "gpe": ["Washington", "Dear", "George", "Mother"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [32.7178862, -100.9176184]], "text": "  Washington, |  July 10 1863.  Dear mother, I suppose you rec'd a letter from me last Wednesday as I sent you one Tuesday, (7th)   dear mother, I was glad enough to hear from George, by that letter from Snyder's Bluffs, June 28th   I had felt a little fear on acc't of some of those storming parties Grant sent against Vicksburgh the middle of June & up to the 20th   but this letter dispels all anxiety   I have written to George many times, but it seems he has not got them   Mother, I shall write immediately to him again   I think he will get the letter I sent last Sunday, as I directed it to Vicksburgh   I told him all the news from home. Mother, I shall write to Han & inclose George's letter   I am real glad to hear from Mat & the little one, all so favorable   We are having pleasant weather here still   I go to Campbell Hospital this afternoon   I still keep going, mother   the wounded are doing rather badly I am sorry to say, there are frequent deaths. The weather, I suppose, which has been peculiarly bad for wounds, so wet & warm, (though not disagreeable outdoors)    Mother, you must write as often as you can, & Jeff too   you must not get worried about the ups & downs of the war   I don't know any course but to resign onesself to events   if one can only bring one's mind to it   Good bye once more for the present, dearest mother, Mat & the dear little ones. Walt    Mother, do you ever hear from Mary    ", "dateText": "", "percents": [], "taggedText": [[[["Washington", "NNP"]], [",", ","], ["|", "NNP"], ["July", "NNP"], ["10", "CD"], ["1863", "CD"], [".", "."]], [[["Dear", "NNP"]], ["mother", "NN"], [",", ","], ["I", "PRP"], ["suppose", "VBP"], ["you", "PRP"], ["rec", "VBP"], ["'d", "JJ"], ["a", "DT"], ["letter", "NN"], ["from", "IN"], ["me", "PRP"], ["last", "JJ"], ["Wednesday", "NNP"], ["as", "IN"], ["I", "PRP"], ["sent", "VBP"], ["you", "PRP"], ["one", "CD"], ["Tuesday", "NNP"], [",", ","], ["(", ":"], ["7th", "JJ"], [")", "NN"], ["dear", "NN"], ["mother", "NN"], [",", ","], ["I", "PRP"], ["was", "VBD"], ["glad", "JJ"], ["enough", "RB"], ["to", "TO"], ["hear", "VB"], ["from", "IN"], [["George", "NNP"]], [",", ","], ["by", "IN"], ["that", "DT"], ["letter", "NN"], ["from", "IN"], [["Snyder", "NNP"]], ["'s", "POS"], [["Bluffs", "NNP"]], [",", ","], ["June", "NNP"], ["28th", "CD"], ["I", "PRP"], ["had", "VBD"], ["felt", "VBN"], ["a", "DT"], ["little", "RB"], ["fear", "JJ"], ["on", "IN"], ["acc't", "JJ"], ["of", "IN"], ["some", "DT"], ["of", "IN"], ["those", "DT"], ["storming", "VBG"], ["parties", "NNS"], ["Grant", "NNP"], ["sent", "NN"], ["against", "IN"], ["Vicksburgh", "NNP"], ["the", "DT"], ["middle", "NN"], ["of", "IN"], ["June", "NNP"], ["&", "CC"], ["up", "IN"], ["to", "TO"], ["the", "DT"], ["20th", "JJ"], ["but", "CC"], ["this", "DT"], ["letter", "NN"], ["dispels", "VBZ"], ["all", "DT"], ["anxiety", "NN"], ["I", "PRP"], ["have", "VBP"], ["written", "VBN"], ["to", "TO"], [["George", "NNP"]], ["many", "JJ"], ["times", "NNS"], [",", ","], ["but", "CC"], ["it", "PRP"], ["seems", "VBZ"], ["he", "PRP"], ["has", "VBZ"], ["not", "RB"], ["got", "VBN"], ["them", "PRP"], ["Mother", 