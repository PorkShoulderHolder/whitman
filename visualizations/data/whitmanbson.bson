"locations": ["West"], "month": "Feb", "parties": ["Walt", "Whitman", "Peter Doyle"], "properDate": "Feb 26, 1875", "gpe": ["Camden", "Pete"], "facility": [], "latlngs": [[51.55170589999999, -0.1588255]], "text": "  431 Stevens st. cor West. Camden, N. Jersey.           Feb. 26.                            A bright day again here, after some ugly weather. Pete, a bad month past, with me, but might have been worse   Bad spells frequent   strength, however, pretty fair   Out a little every day or so. Spirits good.          Comfortable now as I write   Wish you was here   paper & card came all right     W. W.        ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"]], ["cor", "NN"], [["West", "NNP"]], [".", "."]], [[["Camden", "NNP"]], [",", ","], ["N.", "NNP"], ["Jersey", "NNP"], [".", "."]], [["Feb.", "NNP"], ["26", "CD"], [".", "."]], [["A", "DT"], ["bright", "JJ"], ["day", "NN"], ["again", "RB"], ["here", "RB"], [",", ","], ["after", "IN"], ["some", "DT"], ["ugly", "RB"], ["weather", "RB"], [".", "."]], [[["Pete", "NNP"]], [",", ","], ["a", "DT"], ["bad", "JJ"], ["month", "NN"], ["past", "NN"], [",", ","], ["with", "IN"], ["me", "PRP"], [",", ","], ["but", "CC"], ["might", "MD"], ["have", "VB"], ["been", "VBN"], ["worse", "JJR"], ["Bad", "NNP"], ["spells", "NNS"], ["frequent", "VBD"], ["strength", "NN"], [",", ","], ["however", "RB"], [",", ","], ["pretty", "RB"], ["fair", "JJ"], ["Out", "IN"], ["a", "DT"], ["little", "RB"], ["every", "DT"], ["day", "NN"], ["or", "CC"], ["so", "RB"], [".", "."]], [[["Spirits", "NNS"]], ["good", "VBD"], [".", "."]], [["Comfortable", "JJ"], ["now", "RB"], ["as", "IN"], ["I", "PRP"], ["write", "VBP"], ["Wish", "JJ"], ["you", "PRP"], ["was", "VBD"], ["here", "RB"], ["paper", "NN"], ["&", "CC"], ["card", "NN"], ["came", "VBD"], ["all", "DT"], ["right", "NN"], ["W.", "NNP"], ["W", "NNP"], [".", "."]]], "sentences": ["  431 Stevens st. cor West.", "Camden, N. Jersey.", "Feb. 26.", "A bright day again here, after some ugly weather.", "Pete, a bad month past, with me, but might have been worse   Bad spells frequent   strength, however, pretty fair   Out a little every day or so.", "Spirits good.", "Comfortable now as I write   Wish you was here   paper & card came all right     W. W.        "], "words": ["431", "Stevens", "st.", "cor", "West.", "Camden", ",", "N.", "Jersey.", "Feb.", "26.", "A", "bright", "day", "again", "here", ",", "after", "some", "ugly", "weather.", "Pete", ",", "a", "bad", "month", "past", ",", "with", "me", ",", "but", "might", "have", "been", "worse", "Bad", "spells", "frequent", "strength", ",", "however", ",", "pretty", "fair", "Out", "a", "little", "every", "day", "or", "so.", "Spirits", "good.", "Comfortable", "now", "as", "I", "write", "Wish", "you", "was", "here", "paper", "&", "card", "came", "all", "right", "W.", "W", "."], "date": [], "normalizedTime": "0.75288997688", "recipient": "Peter Doyle", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/nyp.00361.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Peter Doyle ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["John", "NNP"]], ["and", "CC"], [["Ursula", "NNP"], ["Burroughs", "NNP"]], [",", ","]]], "people": ["Stevens st.", "Camden", "John", "Emerson", "Conway", "John", "Walt", "Whitman My"], "money": [], "year": "1875", "locations": ["West"], "month": "Mar", "parties": ["Walt", "Whitman", "John", "Ursula Burroughs"], "properDate": "Mar 2, 1875", "gpe": ["America", "Alabama"], "facility": [], "latlngs": [], "text": "  431 Stevens st. cor West. Camden N. Jersey. March 2.                             Dear John, & 'Sula,        This will show you that \"the lamp still holds out to burn\"   though I have had a bad two months past   I have had another paralytic stroke, but it passed over, without any thing serious, (it is probable          I have had several slight strokes)   but I am feeling, as I write, about the same as is now usual for me   still entertain expectations    If practicable I shall bring out a Vol. the coming summer   I hope to pay you the visit yet   Did you get the paper          I sent with a report of Emerson's late lecture on Eloquence   of course interesting, from him, but nothing very stunning,          it seemed to me   I see that Conway is coming to America next autumn certain, to see things, travel, lecture, &c       John, [I] send you the last letter from a quondam correspondent & unseen rebel friend of mine,          away down in Alabama   He seems to me a good affectionate fellow, a sort of uncut gem   I have had five or six letters from him,          all primitive but good   What are you about?   & how are you & 'Sula getting along?         Walt Whitman        My brother & sister well   brother full of business    ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"]], ["cor", "NN"], [["West", "NNP"]], [".", "."]], [[["Camden", "NNP"]], ["N.", "NNP"], ["Jersey", "NNP"], [".", "."]], [["March", "NNP"], ["2", "CD"], [".", "."]], [["Dear", "NNP"], [["John", "NNP"]], [",", ","], ["&", "CC"], ["'Sula", "NNP"], [",", ","], ["This", "DT"], ["will", "MD"], ["show", "VB"], ["you", "PRP"], ["that", "IN"], ["``", "``"], ["the", "DT"], ["lamp", "NN"], ["still", "RB"], ["holds", "VBZ"], ["out", "RP"], ["to", "TO"], ["burn", "VB"], ["''", "''"], ["though", "IN"], ["I", "PRP"], ["have", "VBP"], ["had", "VBN"], ["a", "DT"], ["bad", "JJ"], ["two", "CD"], ["months", "NNS"], ["past", "JJ"], ["I", "PRP"], ["have", "VBP"], ["had", "VBN"], ["another", "DT"], ["paralytic", "JJ"], ["stroke", "NN"], [",", ","], ["but", "CC"], ["it", "PRP"], ["passed", "VBD"], ["over", "IN"], [",", ","], ["without", "IN"], ["any", "DT"], ["thing", "NN"], ["serious", "JJ"], [",", ","], ["(", ":"], ["it", "PRP"], ["is", "VBZ"], ["probable", "