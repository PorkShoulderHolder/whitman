              Nearly opposite St. Nicholas Hotel.                     SMITH SHELDON.                     HEZEKIAH SHAILER.                     ISAAC E. SHELDON.                                                       New York,                     May 16th 1868                                  Walt Whitman Esq                 Dear Sir              Enclosed we send you our check for $75.00 for your article on \"Personalism\" in May                 Galaxy. We understand from Mr. Church that this article was to be paid for in the same                 proportion as your oth    articles have been                  We are Very Truly Yours                 Sheldon & Co              ", "dateText": "", "percents": [], "taggedText": [[["image", "NN"], ["1image", "NN"], ["2image", "NN"], ["3image", "NN"], ["4", "CD"], [["SHELDON", "NNP"]], ["&", "CC"], [["COMPANY", "NNP"]], [["PUBLISHERS", "NNP"]], ["AND", "NNP"], ["BOOKSELLERS", "NNP"], [",", ","], [["Nos", "NNP"]], [".", "."]], [["49", "CD"], ["&", "CC"], ["500", "CD"], [["BROADWAY", "NNP"]], [".", "."]], [["Nearly", "RB"], ["opposite", "VBP"], [["St.", "NNP"], ["Nicholas", "NNP"], ["Hotel", "NNP"]], [".", "."]], [[["SMITH", "NNP"]], [["SHELDON", "NNP"]], [".", "."]], [[["HEZEKIAH", "NNP"]], [["SHAILER", "NNP"]], [".", "."]], [[["ISAAC", "NNP"]], ["E.", "NNP"], ["SHELDON", "NNP"], [".", "."]], [[["New", "NNP"], ["York", "NNP"]], [",", ","], ["May", "NNP"], ["16th", "CD"], ["1868", "CD"], ["Walt", "NNP"], ["Whitman", "NNP"], ["Esq", "NNP"], ["Dear", "NNP"], ["Sir", "NNP"], ["Enclosed", "NNP"], ["we", "PRP"], ["send", "VBP"], ["you", "PRP"], ["our", "PRP$"], ["check", "NN"], ["for", "IN"], ["$", "$"], ["75.00", "CD"], ["for", "IN"], ["your", "PRP$"], ["article", "NN"], ["on", "IN"], ["``", "``"], ["Personalism", "NNP"], ["''", "''"], ["in", "IN"], ["May", "NNP"], ["Galaxy", "NNP"], [".", "."]], [["We", "PRP"], ["understand", "VBP"], ["from", "IN"], [["Mr.", "NNP"], ["Church", "NNP"]], ["that", "IN"], ["this", "DT"], ["article", "NN