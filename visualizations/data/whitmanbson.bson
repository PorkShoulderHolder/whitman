 going on   & pay him. Please write me at once, as I shall want to hear if the money comes safe.        Don't be alarmed   but I am worse to-day   having a bad spell   a succession of those blurs I used to complain of, only far more intense          & persistent   it is now \u00bd past 3, & I have had a succession of them all day   still I am not dismayed   still think I shall get well   We are moving into the new house to-day.         Walt Whitman        ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"]], ["cor", "NN"], [".", "."]], [[["West", "NNP"]], ["st.", "NNP"], [["Camden", "NNP"]], [",", ","], ["N.J.", "NNP"], ["Sept.", "NNP"], ["29", "CD"], [".", "."]], [[["Dear", "NNP"], ["Charley", "NNP"]], [",", ","], ["I", "PRP"], ["enclose", "VBP"], ["the", "DT"], ["money", "NN"], ["for", "IN"], [["Walter", "NNP"], ["Godey", "NNP"]], [".", "."]], [[["Please", "NN"]], ["go", "VBP"], ["down", "RB"], ["&", "CC"], ["see", "VB"], ["how", "WRB"], ["things", "NNS"], ["are", "VBP"], ["going", "VBG"], ["on", "IN"], ["&", "CC"], ["pay", "NN"], ["him", "PRP"], [".", "."]], [[["Please", "NN"]], ["write", "VBD"], ["me", "PRP"], ["at", "IN"], ["once", "RB"], [",", ","], ["as", "IN"], ["I", "PRP"], ["shall", "MD"], ["want", "VB"], ["to", "TO"], ["hear", "VB"], ["if", "IN"], ["the", "DT"], ["money", "NN"], ["comes", "VBZ"], ["safe", "JJ"], [".", "."]], [["Do", "NNP"], ["n't", "RB"], ["be", "VB"], ["alarmed", "VBN"], ["but", "CC"], ["I", "PRP"], ["am", "VBP"], ["worse", "JJ"], ["to-day", "NN"], ["having", "VBG"], ["a", "DT"], ["bad", "JJ"], ["spell", "NN"], ["a", "DT"], ["succession", "NN"], ["of", "IN"], ["those", "DT"], ["blurs", "NNS"], ["I", "PRP"], ["used", "VBD"], ["to", "TO"], ["complain", "VB"], ["of", "IN"], [",", ","], ["only", "RB"], ["far", "RB"], ["more", "RBR"], ["intense", "JJ"], ["&", "CC"], ["persistent", "JJ"], ["it", "PRP"], ["is", "VBZ"], ["now", "RB"], ["\u00bd", ":"], ["past", "JJ"], ["3", "CD"], [",", ","], ["&", "CC"], ["I", "PRP"], ["have", "VBP"], ["had", "VBN"], ["a", "DT"], ["succession", "NN"], ["of", "IN"], ["them", "PRP"], ["all", "DT"], ["day", "NN"], ["still", "RB"], ["I", "PRP"], ["am", "VBP"], ["not", "RB"], ["dismayed", "VBN"], ["still", "RB"], ["think", "VBP"], ["I", "PRP"], ["shall", "MD"], ["get", "VB"], ["well", "RB"], ["We", "PRP"], ["are", "VBP"], ["moving", "VBG"], ["into", "IN"], ["the", "DT"], ["new", "JJ"], ["house", "NN"], ["to-day", "NN"], [".", "."]], [[["Walt", "NNP"]], [["Whitman", "NNP"]]]], "sentences": ["  431 Stevens st. cor.", "West st. Camden, N.J.           Sept. 29.", "Dear Charley,        I enclose the money for Walter Godey.", "Please go down & see how things are going on   & pay him.", "Please write me at once, as I shall want to hear if the money comes safe.", "Don't be alarmed   but I am worse to-day   having a bad spell   a succession of those blurs I used to complain of, only far more intense          & persistent   it is now \u00bd past 3, & I have had a succession of them all day   still I am not dismayed   still think I shall get well   We are moving into the new house to-day.", "Walt Whitman        "], "words": ["431", "Stevens", "st.", "cor.", "West", "st.", "Camden", ",", "N.J.", "Sept.", "29.", "Dear", "Charley", ",", "I", "enclose", "the", "money", "for", "Walter", "Godey.", "Please", "go", "down", "&", "see", "how", "things", "are", "going", "on", "&", "pay", "him.", "Please", "write", "me", "at", "once", ",", "as", "I", "shall", "want", "to", "hear", "if", "the", "money", "comes", "safe.", "Do", "n't", "be", "alarmed", "but", "I", "am", "worse", "to-day", "having", "a", "bad", "spell", "a", "succession", "of", "those", "blurs", "I", "used", "to", "complain", "of", ",", "only", "far", "more", "intense", "&", "persistent", "it", "is", "now", "\u00bd", "past", "3", ",", "&", "I", "have", "had", "a", "succession", "of", "them", "all", "day", "still", "I", "am", "not", "dismayed", "still", "think", "I", "shall", "get", "well", "We", "are", "moving", "into", "the", "new", "house", "to-day.", "Walt", "Whitman"], "date": [], "normalizedTime": "0.682850537196", "recipient": "Charles W. Eldridge", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/prc.00029.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Charles W. Eldridge ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Charles", "NNP"], ["W.", "NNP"], ["Eldridge", "NNP"]], [",", ","]]], "people": ["Will", "Adam", "Charley"], "money": [], "year": "1873", "locations": [], "month": "Oct", "parties": ["Walt", "Whitman", "Charles W. Eldridge"], "properDate": "Oct 3, 1873", "gpe": ["Have"], "facility": [], "latlngs": [], "text": "   The bad spells in my head continued at short intervals all through Tuesday, Wednesday and Thursday.          Today there is a sulking sort of lull   have not had any actual blurs, but all the while          ready to have them, and pretty sick and sore and bad, especially in head, confusing me,          and affecting my eyes. I have rewritten my Will, with some slight changes and additions,          and placed it in the pocket of my trunk here.   \ufffd Ate my breakfast like a man this morning. I don't go out any.        Have been reading Dr. Adam's speech before the Evangelical Alliance in today's \"Tribune.\" My eyes gave out before through.        . . . Charley, I think I fully appreciate my situation and the possibilities and contingencies   and honestly think yet I shall come round   that this is a pretty bad flurry, but one which will pass over. . . .        . . . We like the new house.        ", "dateText": "", "percents": [], "taggedText": [[["The", "DT"], ["bad", "JJ"], ["spells", "NNS"], ["in", "IN"], ["my", "PRP$"], ["head", "NN"], ["continued", "VBD"], ["at", "IN"], ["short", "JJ"], ["intervals", "NNS"], ["all", "DT"], ["through", "IN"], ["Tuesd