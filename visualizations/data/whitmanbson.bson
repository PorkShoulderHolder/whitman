erDate": "May 19, 1871", "gpe": ["France"], "facility": [], "latlngs": [], "text": "  Department of Justice           Washington.           May 19, 1871                    Messrs. Church,           My friends,        If convenient, please remit to me, here, a check for $25 in pay for \"O Star of France.\"          Yours truly         Walt Whitman        ", "dateText": "", "percents": [], "taggedText": [[["Department", "NN"], ["of", "IN"], [["Justice", "NNP"], ["Washington", "NNP"]], [".", "."]], [["May", "NNP"], ["19", "CD"], [",", ","], ["1871", "CD"], ["Messrs.", "NNP"], ["Church", "NNP"], [",", ","], ["My", "NNP"], ["friends", "NNS"], [",", ","], ["If", "IN"], ["convenient", "JJ"], [",", ","], ["please", "NN"], ["remit", "NN"], ["to", "TO"], ["me", "PRP"], [",", ","], ["here", "RB"], [",", ","], ["a", "DT"], ["check", "NN"], ["for", "IN"], ["$", "$"], ["25", "CD"], ["in", "IN"], ["pay", "NN"], ["for", "IN"], ["``", "``"], ["O", "NNP"], ["Star", "NNP"], ["of", "IN"], [["France", "NNP"]], [".", "."]], [["``", "``"], ["Yours", "NNS"], ["truly", "RB"], [["Walt", "NNP"], ["Whitman", "NNP"]]]], "sentences": ["  Department of Justice           Washington.", "May 19, 1871                    Messrs. Church,           My friends,        If convenient, please remit to me, here, a check for $25 in pay for \"O Star of France.", "\"          Yours truly         Walt Whitman        "], "words": ["Department", "of", "Justice", "Washington.", "May", "19", ",", "1871", "Messrs.", "Church", ",", "My", "friends", ",", "If", "convenient", ",", "please", "remit", "to", "me", ",", "here", ",", "a", "check", "for", "$", "25", "in", "pay", "for", "``", "O", "Star", "of", "France.", "''", "Yours", "truly", "Walt", "Whitman"], "date": [], "normalizedTime": "0.56534747722", "recipient": "", "organizations": ["Justice Washington"], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/loc.01707.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to W. C. and F. P. Church ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Anne", "NNP"], ["Charlotte", "NNP"], ["Lynch", "NNP"], ["Botta", "NNP"]], [",", ","]]], "people": ["Madam", "Walt", "Whitman"], "money": [], "year": "1871", "locations": [], "month": "Jun", "parties": ["Walt", "Whitman", "Anne Charlotte Lynch Botta"], "properDate": "Jun 6, 1871", "gpe": ["France", "Please"], "facility": [], "latlngs": [], "text": "  Department of Justice                     Washington June 6, 1871.                                  Mrs. Botta:                 My dear Madam:              I sent you by mail about three weeks ago, (in compliance with your request of April 13,) the MS. of one of my poems, \"O Star of France\"   also a photographic portrait. Please let me know whether they arrived safely.                  With greatest respect.                 Walt Whitman              ", "dateText": "", "percents": [], "taggedText": [[["Department", "NN"], ["of", "IN"], [["Justice", "NNP"], ["Washington", "NNP"]], ["June", "NNP"], ["6", "CD"], [",", ","], ["1871", "CD"], [".", "."]], [["Mrs.", "NNP"], ["Botta", "NNP"], [":", ":"], ["My", "NNP"], ["dear", "NN"], [["Madam", "NNP"]], [":", ":"], ["I", "PRP"], ["sent", "VBP"], ["you", "PRP"], ["by", "IN"], ["mail", "NN"], ["about", "IN"], ["three", "CD"], ["weeks", "NNS"], ["ago", "IN"], [",", ","], ["(", ":"], ["in", "IN"], ["compliance", "NN"], ["with", "IN"], ["your", "PRP$"], ["request", "NN"], ["of", "IN"], ["April", "NNP"], ["13", "CD"], [",", ","], [")", ":"], ["the", "DT"], ["MS.", "NNP"], ["of", "IN"], ["one", "CD"], ["of", "IN"], ["my", "PRP$"], ["poems", "NNS"], [",", ","], ["``", "``"], ["O", "NNP"], ["Star", "NNP"], ["of", "IN"], [["France", "NNP"]], ["''", "''"], ["also", "RB"], ["a", "DT"], ["photographic", "JJ"], ["portrait", "NN"], [".", "."]], [[["Please", "NN"]], ["let", "VBD"], ["me", "PRP"], ["know", "VBP"], ["whether", "IN"], ["