 ["is", "VBZ"], ["getting", "VBG"], ["along", "IN"], ["tell", "NN"], ["Hattie", "NNP"], ["I", "PRP"], ["hope", "VBP"], ["she", "PRP"], ["will", "MD"], ["take", "VB"], ["a", "DT"], ["lesson", "NN"], ["on", "IN"], ["the", "DT"], ["piano", "NN"], ["every", "DT"], ["day", "NN"], [",", ","], ["and", "CC"], ["learn", "VB"], ["to", "TO"], ["play", "VB"], ["for", "IN"], ["her", "PRP"], [["Uncle", "NNP"], ["Walt", "NNP"]], ["so", "RB"], ["when", "WRB"], ["he", "PRP"], ["comes", "VBZ"], ["home", "NN"], [",", ","], ["she", "PRP"], ["can", "MD"], ["play", "VB"], ["a", "DT"], ["beautiful", "JJ"], ["tune2", "NNP"], ["I", "PRP"], ["have", "VBP"], ["been", "VBN"], ["down", "RP"], ["to", "TO"], ["the", "DT"], [["Hospital", "NNP"]], ["a", "DT"], ["great", "JJ"], ["deal", "NN"], ["lately", "RB"], ["A", "DT"], ["friend", "NN"], ["of", "IN"], ["mine", "JJ"], ["that", "IN"], ["I", "PRP"], ["have", "VBP"], ["known", "VBN"], ["over", "IN"], ["three", "CD"], ["years", "NNS"], [",", ","], ["a", "DT"], [["Maine", "NNP"]], ["soldier", "NN"], ["named", "VBD"], ["Racliffe,3", "-NONE-"], ["was", "VBD"], ["very", "RB"], ["low", "JJ"], ["with", "IN"], ["consumption", "NN"], ["&", "CC"], ["bleeding", "VBG"], ["at", "IN"], ["the", "DT"], ["lungs", "NNS"], ["He", "PRP"], ["died", "VBD"], ["Sunday", "NNP"], ["morning", "NN"], ["it", "PRP"], ["was", "VBD"], ["a", "DT"], ["great", "JJ"], ["relief", "NN"], [",", ","], ["for", "IN"], ["he", "PRP"], ["suffered", "VBD"], ["much", "RB"], ["Well", "NNP"], [",", ","], ["mother", "NN"], [",", ","], ["I", "PRP"], ["believe", "VBP"], ["that", "IN"], ["is", "VBZ"], ["all", "DT"], ["this", "DT"], ["time", "NN"], [".", "."]], [[["Walt", "NNP"]], [".", "."]]], "sentences": ["  ATTORNEY GENERAL'S OFFICE, Washington,  Dec. 18, 1866.", "Dearest Mother, I rec'd your letter Sunday morning last   It has been very cold here too, but is pleasant now.", "I sent you a copy of \"Leaves of Grass\"   which I suppose you have rec'd.", "Every thing here with me remains the same   I am free from the distress in my head   Mrs. Grayson1 is very sick   she sent my old washerwoman, old Aunt Kitty, around this morning to see if I had any of \"that bread my mother used to send me\"   I suppose she meant the sweet Dyer bread   I gave her a piece a long while ago, & she liked it   poor woman, I think she is on her dying bed   Mother, you must write to me how Jeff is, & how he is getting along   tell Hattie I hope she will take a lesson on the piano every day, and learn to play for her Uncle Walt   so when he comes home, she can play a beautiful tune2    I have been down to the Hospital a great deal lately   A friend of mine that I have known over three years, a Maine soldier named Racliffe,3 was very low with consumption & bleeding at the lungs   He died Sunday morning   it was a great relief, for he suffered much    Well, mother, I believe that is all this time.", "Walt. "], "words": ["ATTORNEY", "GENERAL", "'S", "OFFICE", ",", "Washington", ",", "Dec.", "18", ",", "1866.", "Dearest", "Mother", ",", "I", "rec", "'d", "your", "letter", "Sunday", "morning", "last", "It", "has", "been", "very", "cold", "here", "too", ",", "but", "is", "pleasant", "now.", "I", "sent", "you", "a", "copy", "of", "``", "Leaves", "of", "Grass", "''", "which", "I", "suppose", "you", "have", "rec'd.", "Every", "thing", "here", "with", "me", "remains", "the", "same", "I", "am", "free", "from", "the", "distress", "in", "my", "head", "Mrs.", "Grayson1", "is", "very", "sick", "she", "sent", "my", "old", "washerwoman", ",", "old", "Aunt", "Kitty", ",", "around", "this", "morning", "to", "see", "if", "I", "had", "any", "of", "``", "that", "bread", "my", "mother", "used", "to", "send", "me", "''", "I", "suppose", "she", "meant", "the", "sweet", "Dyer", "bread", "I", "gave", "her", "a", "piece", "a", "long", "while", "ago", ",", "&", "she", "liked", "it", "poor", "woman", ",", "I", "think", "she", "is", "on", "her", "dying", "bed", "Mother", ",", "you", "must", "write", "to", "me", "how", "Jeff", "is", ",", "&", "how", "he", "is", "getting", "along", "tell", "Hattie", "I", "hope", "she", "will", "take", "a", "lesson", "on", "the", "piano", "every", "day", ",", "and", "learn", "to", "play", "for", "her", "Uncle", "Walt", "so", "when", "he", "comes", "home", ",", "she", "can", "play", "a", "beautiful", "tune2", "I", "have", "been", "down", "to", "the", "Hospital", "a", "great", "deal", "lately", "A", "friend", "of", "mine", "that", "I", "have", "known", "over", "three", "years", ",", "a", "Maine", "soldier", "named", "Racliffe,3", "was", "very", "low", "with", "consumption", "&", "bleeding", "at", "the", "lungs", "He", "died", "Sunday", "morning", "it", "was", "a", "great", "relief", ",", "for", "he", "suffered", "much", "Well", ",", "mother", ",", "I", "believe", "that", "is", "all", "this", "time.", "Walt", "."], "date": [], "normalizedTime": "0.34598123215", "recipient": "Louisa Van Velsor Whitman", "organizations": ["GENERAL", "Grass", "Hospital"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/nyp.00214.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to Louisa Van Velsor Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Thomas", "NNP"], ["Jefferson", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Mother", "Lane", "Davis", "Van Buren11", "Davis", "Mother", "Hattie", "Jeff"], "money": [], "year": "1866", "locations": [], "month": "Dec", "parties": ["Thomas Jefferson Whitman", "Walt Whitman"], "properDate": "Dec 21, 1866", "gpe": ["Brooklyn"], "facility": [], "latlngs": [[40.65, -73.95]], "text": "  Brooklyn Dec 21st/66 Dear Walt, Sent letter to Worthen1   as soon as received  Mother received letter and book   by the way can I get one of the books to present to Ruggles2  The $31 was made up as follows  Moses Lane $5.  Davis $5.3  self $5.  McNamee,4 Brower,5 Story,6 Bergen,7 Ward,8 Lewis,9 Clapp10 and Van Buren11 (all young men employed in our office) each $2. Hope you wont be disappointed in the smallness of the amount   but Davis had to go away and did'nt have time to see if he could collect any at his office. Mother Mat and the children are all quite well   but have rather a hard time to keep warm12   wish when you write Mother you would always say something abt Hattie's learning to read and play &c  it sets her ahead wonderfully   you know how such things please children   should like to have you write me that long letter   I hope also to be able to pay you a short visit this winter   soon after the Holidays   everything is going abt as usual with us at home affectionately yours Jeff", "dateText": "", "percents": [], "taggedText": [[[["Brooklyn", "NNP"]], ["Dec", "NNP"], ["21st/66", "CD"], ["Dear", "NNP"], ["Walt", "NNP"], [",", ","], [["Sent", "NNP"]], ["letter", "NN"], ["to", "TO"], [["Worthen1", "NNP"]], ["as", "IN"], ["soon", "RB"], ["as", "IN"], ["received", "VBN"], [["Mother", "NNP"]], ["received", "VBD"], ["letter", "NN"], ["and", "CC"], ["book", "NN"], ["by", "IN"], ["the", "DT"], ["way", "NN"], ["can", "MD"], ["I", "PRP"], ["get", "VB"], ["one", "CD"], ["of", "IN"], ["the", "DT"], ["books", "NNS"], ["to", "TO"], ["present", "VB"], ["to", "TO"], ["Ruggles2", "NNP"], ["The", "DT"], ["$", "$"], ["31", "CD"], ["was", "VBD"], ["made", "VBN"], ["up", "RP"], ["as", "RB"], ["follows", "VBZ"], ["Moses", "NNS"], [["Lane", "NNP"]], ["$", "$"], ["5", "CD"], [".", "."]], [[["Davis", "NNP"]], ["$", "$"], ["5.3", "CD"], ["self", "PRP"], ["$", "$"], ["5", "CD"], [".", "."]], [["McNamee,4", "NN"], ["Brower,5", "-NONE-"], ["Story,6", "-NONE-"], ["Bergen,7", "-NONE-"], ["Ward,8", "-NONE-"], ["Lewis,9", "-NONE-"], [["Clapp10", "NNP"]], ["and", "CC"], [["Van", "NNP"], ["Buren11", "NNP"]], ["(", "NNP"], ["all", "DT"], ["young", "JJ"], ["men", "NNS"], ["employed", "VBN"], ["in", "IN"], ["our", "PRP$"], ["office", "NN"], [")"