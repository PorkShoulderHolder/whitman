K", "George", "Burnside", "Corps", "Fred McReady", "Sims"], "money": [], "year": "1864", "locations": [], "month": "May", "parties": ["Walt Whitman", "Louisa Van Velsor Whitman"], "properDate": "May 12, 1864", "gpe": [], "facility": [], "latlngs": [], "text": "  May 12th | \u00bd past 5 P M  Dearest Mother George is all right, unhurt, up to Tuesday morning, 10th inst   the 51st was in a bad battle last Friday, lost 20 killed, between 40 & 50 wounded   I have just seen some of the 51st wounded, just arrived, one of them Fred Saunders, Corp[oral], Co K, George's company   he said when he left the 51st was in rear on guard duty   he left Tuesday mn'g last   the papers have it that Burnside's Corps was in a fight Tuesday, but I think it most probable the 51st was not in it    Fred McReady is wounded, badly, but not seriously   Sims is safe   you see LeGendre is wounded   he was shot through the bridge of nose1    Mother, you ought to get this Friday forenoon, 13th   I will write again soon   wrote once before to-day2    Walt ", "dateText": "", "percents": [], "taggedText": [[["May", "NNP"], ["12th", "CD"], ["|", "CD"], ["\u00bd", "CD"], ["past", "JJ"], ["5", "CD"], ["P", "NNP"], ["M", "NNP"], ["Dearest", "NNP"], ["Mother", "NNP"], [["George", "NNP"]], ["is", "VBZ"], ["all", "DT"], ["right", "RB"], [",", ","], ["unhurt", "NN"], [",", ","], ["up", "RB"], ["to", "TO"], ["Tuesday", "NNP"], ["morning", "NN"], [",", ","], ["10th", "JJ"], ["inst", "NN"], ["the", "DT"], ["51st", "CD"], ["was", "VBD"], ["in", "IN"], ["a", "DT"], ["bad", "JJ"], ["battle", "NN"], ["last", "JJ"], ["Friday", "NNP"], [",", ","], ["lost", "VBD"], ["20", "CD"], ["killed", "VBN"], [",", ","], ["between", "IN"], ["40", "CD"], ["&", "CC"], ["50", "CD"], ["wounded", "VBD"], ["I", "PRP"], ["have", "VBP"], ["just", "RB"], ["seen", "VBN"], ["some", "DT"], ["of", "IN"], ["the", "DT"], ["51st", "CD"], ["wounded", "VBD"], [",", ","], ["just", "RB"], ["arrived", "VBD"], [",", ","], ["one", "CD"], ["of", "IN"], ["them", "PRP"], [["Fred", "NNP"], ["Saunders", "NNP"]], [",", ","], [["Corp", "NNP"]], ["[", "NNP"], ["oral", "JJ"], ["]", "NN"], [",", ","], [["Co", "NNP"], ["K", "NNP"]], [",", ","], [["George", "NNP"]], ["'s", "POS"], ["company", "NN"], ["he", "PRP"], ["said", "VBD"], ["when", "WRB"], ["he", "PRP"], ["left", "VBD"], ["the", "DT"], ["51st", "CD"], ["was", "VBD"], ["in", "IN"], ["rear", "JJ"], ["on", "IN"], ["guard", "NN"], ["duty", "NN"], ["he", "PRP"], ["left", "VBD"], ["Tuesday", "NNP"], ["mn'g", "NNP"], ["last", "JJ"], ["the", "DT"], ["papers", "NNS"], ["have", "VBP"], ["it", "PRP"], ["that", "IN"], [["Burnside", "NNP"]], ["'s", "POS"], [["Corps", "NNP"]], ["was", "VBD"], ["in", "IN"], ["a", "DT"], ["fight", "NN"], ["Tuesday", "NNP"], [",", ","], ["but", "CC"], ["I", "PRP"], ["think", "VBP"], ["it", "PRP"], ["most", "JJS"], ["probable", "JJ"], ["the", "DT"], ["51st", "JJ"], ["was", "VBD"], ["not", "RB"], ["in", "IN"], ["it", "PRP"], [["Fred", "NNP"], ["McReady", "NNP"]], ["is", "VBZ"], ["wounded", "VBN"], [",", ","], ["badly", "RB"], [",", ","], ["but", "CC"], ["not", "RB"], ["seriously", "RB"], [["Sims", "NNP"]], ["is", "VBZ"], ["safe", "JJ"], ["you", "PRP"], ["see", "VBP"], [["LeGendre", "NNP"]], ["is", "VBZ"], ["wounded", "VBN"], ["he", "PRP"], ["was", "VBD"], ["shot", "VBN"], ["through", "IN"], ["the", "DT"], ["bridge", "NN"], ["of", "IN"], [["nose1", "NNP"], ["Mother", "NNP"]], [",", ","], ["you", "PRP"], ["ought", "MD"], ["to", "TO"], ["get", "VB"], ["this", "DT"], ["Friday", "NNP"], ["forenoon", "NN"], [",", ","], ["13th", "JJ"], ["I", "PRP"], ["will", "MD"], ["write", "VB"], ["again", "RB"], ["soon", "RB"], ["wrote", "VBD"], ["once", "RB"], ["before", "IN"], ["to-day2", "-NONE-"], ["Walt", "NNP"]]], "sentences": ["  May 12th | \u00bd past 5 P M  Dearest Mother George is all right, unhurt, up to Tuesday morning, 10th inst   the 51st was in a bad battle last Friday, lost 20 killed, between 40 & 50 wounded   I have just seen some of the 51st wounded, just arrived, one of them Fred Saunders, Corp[oral], Co K, George's company   he said when he left the 51st was in rear on guard duty   he left Tuesday mn'g last   the papers have it that Burnside's Corps was in a fight Tuesday, but I think it most probable the 51st was not in it    Fred McReady is wounded, badly, but not seriously   Sims is safe   you see LeGendre is wounded   he was shot through the bridge of nose1    Mother, you ought to get this Friday forenoon, 13th   I will write again soon   wrote once before to-day2    Walt "], "words": ["May", "12th", "|", "\u00bd", "past", "5", "P", "M", "Dearest", "Mother", "George", "is", "all", "right", ",", "unhurt", ",", "up", "to", "Tuesday", "morning", ",", "10th", "inst", "the", "51st", "was", "in", "a", "bad", "battle", "last", "Friday", ",", "lost", "20", "killed", ",", "between", "40", "&", "50", "wounded", "I", "have", "just", "seen", "some", "of", "the", "51st", "wounded", ",", "just", "arrived", ",", "one", "of", "them", "Fred", "Saunders", ",", "Corp", "[", "oral", "]", ",", "Co", "K", ",", "George", "'s", "company", "he", "said", "when", "he", "left", "the", "51st", "was", "in", "rear", "on", "guard", "duty", "he", "left", "Tuesday", "mn'g", "last", "the", "papers", "have", "it", "that", "Burnside", "'s", "Corps", "was", "in", "a", "fight", "Tuesday", ",", "but", "I", "think", "it", "most", "probable", "the", "51st", "was", "not", "in", "it", "Fred", "McReady", "is", "wounded", ",", "badly", ",", "but", "not", "seriously", "Sims", "is", "safe", "you", "see", "LeGendre", "is", "wounded", "he", "was", "shot", "through", "the", "bridge", "of", "nose1", "Mother", ",", "you", "ought", "to", "get", "this", "Friday", "forenoon", ",", "13th", "I", "will", "write", "again", "soon", "wrote", "once", "before", "to-day2", "Walt"], "date": [], "normalizedTime": "0.216782265742", "recipient": "Louisa Van Velsor Whitman", "organizations": ["LeGendre", "nose1 Mother"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00826.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to Louisa Van Velsor Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Louisa", "NNP"], ["Van", "NNP"], ["Velsor", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Dearest Mother", "George", "Lt Sturgis", "Sgt Brown,1", "Sanders", "Col LeGendre", "George", "Fred McReady", "Mother", "Dearest Mother", "Grant", "Richmond"], "money": [], "year": "1864", "locations": [], "month": "May", "parties": ["Walt Whitman", "Louisa Van Velsor Whitman"], "properDate": "May 13, 1864", "gpe": ["Washington", "Brooklyn", "George", "Washington", "George", "Fredericksburgh"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [40.65, -73.95], [38.8951118, -77.0363658]], "text": "  Washington |  May 13 1864 | 2 o'clock p m  Dearest Mother I wrote you a hurried letter late yesterday afternoon, but left it myself at the P O in time for the mail   you ought to have got it this forenoon, or afternoon at furthest   I sent you two letters yesterday   I hope the carrier brings you your letters the same day   I wrote to the Brooklyn postmaster about it    I have heard from George up to Tuesday morning last, 10th, till which time he was safe   the battle of Friday 6th was very severe   George's co. K lost one acting Lt Sturgis killed, 2 men killed, 4 wounded   as I wrote yesterday I have seen here Corp Fred Sanders of Co K who was wounded in side, nothing serious, in Friday's fight, & came up here   I also talked with Sgt Brown,1 co F, 51st   rather badly wounded in right shoulder   Sanders said when he left Tuesday morning, he heard (or saw them there, I forget which) the 51st & its whole division were on guard duty toward the rear   the 9th Corps however has had hard fighting since, but whether the division, or brigade the 51st is in, was in the fights of Tuesday, 10th (a pretty severe one,) or Wednesday I cannot yet tell, & it is useless to make calculations   & the only way is to wait & hope for the best   as I wrote yesterday there were some 20 of 51st reg't killed & 50 wounded in Friday's battle, 6th inst    I have seen Col LeGendre, he is here in Washington, not far from where I am   485 12th st is his address   poor man, I felt sorry indeed for him, he is badly wounded & disfigured, he is shot through the bridge of the nose, & left eye probably lost   I spent a little time with him this forenoon   he is suffering very much   spoke of George very kindly, said \"your brother is well\"   his orderly told me he saw him (George) Sunday night last well   Fred McReady is wounded in hip, I believe bone fractured, bad enough, but not deeply serious   I cannot hear of his arrival here, if he comes I shall find him immediately & take care of him myself   he is probably yet at Fredericksburgh, but will come up I think2    Yesterday & to-day the badly wounded are coming in   the long lists of previous arrivals, (I suppose they are all reprinted at great length in N Y papers)3 are of men \u00beths of them quite slightly wounded, & the rest hurt pretty bad   I was thinking, mother, if one could see the men who arrived in the first squads, of two or three hundred at a time, one wouldn't be alarmed at those terrible long lists   Still there is a sufficient sprinkling of deeply distressing cases   I find my hands full all the time, with new & old cases   poor suffering young men, I think of them, & do try, Mother, to do what I can for them, (& not think of the vexatious skedaddlers & merely scratched ones, of whom there are too many lately come here)    Dearest Mother, I hope you & all are well   you must keep a good heart   still the fighting is very mixed, but it seems steadily turning into real successes for Grant   the news to-day here is very good   you will see it in N Y papers   I steadily believe Grant is going to succeed, & that we shall have Richmond   but O what a price to pay for it   We have had a good rain here & it is pleasanter & cooler   I shall write very soon again    Walt. ", "dateText": "", "percents": [], "taggedText": [[[["Washington", "NNP"]], ["|", ":"], ["May", "NNP"], ["13", "CD"], ["1864", "CD"], ["|", "CD"], ["2", "CD"], ["o'clock", "JJ"], ["p", "NN"], ["m", "NN"], [["Dearest", "NNP"], ["Mother", "NNP"]], ["I", "NNP"], ["wrote", "VBD"], ["you", "PRP"], ["a", "DT"], ["hurried", "JJ"], ["letter", "NN"], ["late", "JJ"], ["yesterday", "NN"], ["afternoon", "NN"], [",", ","], ["but", "CC"], ["left", "VBD"], ["it", "PRP"], ["myself", "PRP"], ["at", "IN"], ["the", "DT"], [["P", "NNP"]], ["O", "NNP"], ["in", "IN"], ["time", "NN"], ["for", "IN"], ["the", "DT"], ["mail", "NN"], ["you", "PRP"], ["ought", "MD"], ["to", "TO"], ["have", "VB"], ["got", "VBN"], ["it", "PRP"], ["this", "DT"], ["forenoon", "NN"], [",", ","], ["or", "CC"], ["afternoon", "NN"], ["at", "IN"], ["furthest", "JJS"], ["I", "PRP"], ["sent", "VBP"], ["you", "PRP"], ["two", "CD"], ["letters", "NNS"], ["yesterday", "NN"], ["I", "PRP"], ["hope", "VBP"], ["the", "DT"], ["carrier", "NN"], ["brings", "VBZ"], ["you", "PRP"], ["your", "PRP$"], ["letters", "NNS"], ["the", "DT"], ["same", "JJ"], ["day", "NN"], ["I", "PRP"], ["wrote", "VBD"], ["to", "TO"], ["the", "DT"], [["Brooklyn", "NNP"]], ["postmaster", "NN"], ["about", "IN"], ["it", "PRP"], ["I", "PRP"], ["have", "VBP"], ["heard", "VBN"], ["from", "IN"], [["George", "NNP"]], ["up", "IN"], ["to", "TO"], ["Tuesday", "NNP"], ["morning", "NN"], ["last", "JJ"], [",", ","], ["10th", "JJ"], [",", ","], ["till", "NN"], ["which", "WDT"], ["time", "NN"], ["he", "PRP"], ["was", "VBD"], ["safe", "JJ"], ["the", "DT"], ["battle", "NN"], ["of", "IN"], ["Friday", "NNP"], ["6th", "CD"], ["was", "VBD"], ["very", "RB"], ["severe", "JJ"], [["George", "NNP"]], ["'s", "POS"], ["co.", "NNP"], ["K", "NNP"], ["lost", "VBD"], ["one", "CD"], ["acting", "VBG"], [["Lt", "NNP"], ["Sturgis",