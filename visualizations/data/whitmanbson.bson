 ","], [["Jeffy", "NNP"]], [",", ","], ["dear", "JJ"], ["brother", "NN"], [".", "."]], [[["Walt", "NNP"]], [".", "."]]], "sentences": ["  Attorney General's Office,                     Washington.", "April 29, 1867 Dear brother Jeff,              I heard by William O'Connor of the St. Louis proposition   & as far as I could judge by his                 account   & since by your letter & Mother's   it seems to me best                 to accept the offer, & go, by all means    It is a great work   a noble position   & will give you a good big field.", "Jeff, I wish to hear about the family arrangements   whether Mother & Martha                 &c are going to stay there this summer, or not   (I hope they are.", ") There is nothing special with me, to write about.", "In the office, all goes on as                 usual.", "I still board at 472 M st. Love to Mat & the little girls.", "Remember me to                 Mr. Lane & Davis   So good bye for this                 time, Jeffy, dear brother.", "Walt.              "], "words": ["Attorney", "General", "'s", "Office", ",", "Washington.", "April", "29", ",", "1867", "Dear", "brother", "Jeff", ",", "I", "heard", "by", "William", "O'Connor", "of", "the", "St.", "Louis", "proposition", "&", "as", "far", "as", "I", "could", "judge", "by", "his", "account", "&", "since", "by", "your", "letter", "&", "Mother", "'s", "it", "seems", "to", "me", "best", "to", "accept", "the", "offer", ",", "&", "go", ",", "by", "all", "means", "It", "is", "a", "great", "work", "a", "noble", "position", "&", "will", "give", "you", "a", "good", "big", "field.", "Jeff", ",", "I", "wish", "to", "hear", "about", "the", "family", "arrangements", "whether", "Mother", "&", "Martha", "&", "c", "are", "going", "to", "stay", "there", "this", "summer", ",", "or", "not", "(", "I", "hope", "they", "are.", ")", "There", "is", "nothing", "special", "with", "me", ",", "to", "write", "about.", "In", "the", "office", ",", "all", "goes", "on", "as", "usual.", "I", "still", "board", "at", "472", "M", "st.", "Love", "to", "Mat", "&", "the", "little", "girls.", "Remember", "me", "to", "Mr.", "Lane", "&", "Davis", "So", "good", "bye", "for", "this", "time", ",", "Jeffy", ",", "dear", "brother.", "Walt", "."], "date": [], "normalizedTime": "0.363933088535", "recipient": "Thomas Jefferson Whitman", "organizations": ["St. Louis"], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/duk.00647.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Thomas Jefferson Whitman ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Louisa", "NNP"], ["Van", "NNP"], ["Velsor", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Mr. Kirkwood", "Davis", "Jeff", "Mat", "Mother"], "money": [], "year": "1867", "locations": [], "month": "Apr", "parties": ["Walt", "Whitman", "Louisa Van Velsor Whitman"], "properDate": "Apr 30, 1867", "gpe": ["Washington", "Jeffy", "Jeffy", "St. Louis", "St. Louis", "Love", "Walt"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [38.6270025, -90.19940419999999], [38.6270025, -90.19940419999999]], "text": "  Attorney General's Office, Washington. Tuesday, April 30, 1867 Dearest mother,              I received your letter   also one from Jeffy. I wrote to Jeffy yesterday   I                 suppose it is for the best that he should go to St. Louis     as it seems to be a great position   I was                 much pleased to hear that it was Mr. Kirkwood                   who was the designing Engineer   & also that                     Davis  is to                 go to St. Louis on the works    Well, mother, about domestic matters   I hardly know what to say at                 present   Jeff did not say in his letter what was proposed, or how he & Mat                 thought of doing   I can tell better after I hear   But, Mother, you must                 not worry about it   it will be arranged some way    There is nothing new in my affairs   I have a little more work these days than                 usual, but get along first rate   am satisfied with the boarding-house as well                 as could be expected. Love to you & all, dear mother. I write this at my                 desk   spring is quite advanced here   it is a damp, misty, cloudy                 forenoon   but pleasant   I can send you whatever money you need, dear                 mother, any time   or can come on for a few days   try to take things                 coolly.  Walt.              ", "dateText": "", "percents": [], "taggedText": [[["Attorney", "NNP"], ["General", "NNP"], ["'s", "POS"], ["Office", "NNP"], [",", ","], [["Washington", "NNP"]], [".", "."]], [["Tuesday", "NNP"], [",", ","], ["April", "NNP"], ["30", "CD"], [",", ","], ["1867", "CD"], ["Dearest", "NNP"], ["mother", "NN"], [",", ","], ["I", "PRP"], ["received", "VBD"], ["your", "PRP$"], ["letter", "NN"], ["also", "RB"], ["one", "CD"], ["from", "IN"], [["Jeffy", "NNP"]], [".", "."]], [["I", "PRP"], ["wrote", "VBD"], ["to", "TO"], [["Jeffy", "NNP"]], ["yesterday", "NN"], ["I", "PRP"], ["suppose", "VBP"], ["it", "PRP"], ["is", "VBZ"], ["for", "IN"], ["the", "DT"], ["best", "JJS"], ["that", "IN"], ["he", "PRP"], ["should", "MD"], ["go", "VB"], ["to", "TO"], [["St.", "NNP"], ["Louis", "NNP"]], ["as", "IN"], ["it", "PRP"], ["seems", "VBZ"], ["to", "TO"], ["be", "VB"], ["a", "DT"], ["great", "JJ"], ["position", "NN"], ["I", "PRP"], ["was", "VBD"], ["much", "RB"], ["pleased", "VBN"], ["to", "TO"], ["hear", "VB"], ["that", "IN"], ["it", "PRP"], ["was", "VBD"], [["Mr.", "NNP"], ["Kirkwood", "NNP"]], ["who", "WP"], ["was", "VBD"], ["the", "DT"], ["designing", "NN"], ["Engineer", "NNP"], ["&", "CC"], ["also", "RB"], ["that", "IN"], [["Davis", "NNP"]], ["is", "VBZ"], ["to", "TO"], ["go", "VB"], ["to", "TO"], [["St.", "NNP"], ["Louis", "NNP"]], ["on", "IN"], ["the", "DT"], ["works", "NNS"], ["Well", "NNP"], [",", ","],