NNP"], ["I", "NNP"], ["will", "MD"], ["be", "VB"], ["happy", "JJ"], ["to", "TO"], ["receive", "VB"], ["a", "DT"], ["visit", "NN"], ["from", "IN"], ["Mrs.", "NNP"], ["Bielby", "NNP"], ["will", "MD"], ["be", "VB"], ["in", "IN"], ["my", "PRP$"], ["room", "NN"], ["to-morrow", "NN"], [",", ","], ["Wednesday", "NNP"], [",", ","], ["from", "IN"], ["10", "CD"], ["to", "TO"], ["11", "CD"], ["\u00bd", "CD"], ["forenoon", "NN"], [["Will", "NNP"]], ["always", "RB"], ["be", "VB"], ["happy", "JJ"], ["to", "TO"], ["have", "VB"], ["visits", "NNS"], ["from", "IN"], ["you", "PRP"], ["or", "CC"], ["Mrs.", "NNP"], ["B.", "NNP"], ["Walt", "NNP"], ["Whitman", "NNP"]]], "sentences": ["  Tuesday May 20th                        Dear Doctor           I will be happy to receive a visit from Mrs. Bielby   will be in my room to-morrow, Wednesday,          from 10 to 11 \u00bd forenoon   Will always be happy to have visits from you or Mrs. B.  Walt Whitman        "], "words": ["Tuesday", "May", "20th", "Dear", "Doctor", "I", "will", "be", "happy", "to", "receive", "a", "visit", "from", "Mrs.", "Bielby", "will", "be", "in", "my", "room", "to-morrow", ",", "Wednesday", ",", "from", "10", "to", "11", "\u00bd", "forenoon", "Will", "always", "be", "happy", "to", "have", "visits", "from", "you", "or", "Mrs.", "B.", "Walt", "Whitman"], "date": [], "normalizedTime": "0.664898680811", "recipient": "", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/med.00428.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Dr. Bielby ,"}, {"taggedHeading": [[[["John", "NNP"], ["Burroughs", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["George Bliss", "Yaphank", "Ruin", "Chancy B.", "Sulic", "Kingston", "Yours John Burroughs"], "money": [], "year": "1873", "locations": [], "month": "Jun", "parties": ["John Burroughs", "Walt Whitman"], "properDate": "Jun 2, 1873", "gpe": ["Camden", "North"], "facility": ["Middletown"], "latlngs": [[51.55170589999999, -0.1588255], [22.5009081, 114.1558258]], "text": "image 1image 2image 3image 4  Middletown N.Y.                     June 2d 73                                  Dear Walt,              I got the Camden paper this morning containing the notice of your mothers death. I                 had heard through Eldridge a few days ago that all was over with her. I suppose it                 was not unexpected to you yet for all that the blow must have been a heavy one to                 all her children and doubly so to yourself. I should like to hear from you the                 particulars of her last days. I wish I might have seen her again. If you are able to                 write  do drop me a                 line & tell me about yourself & what your plans are for the summer. I hope                 you do not think of returning to W. before fall. I go to N. Y. to-morrow for a few                 days. While there a letter addressed to me care of George Bliss Jr. W. S. Atty,                 41 Chambers St. will reach me. If you can come North & spend some time with me I                 should be delighted. I am going out on L. I. to look at a place for sale, Yaphank                 on [Carmand?] Ruin. Do you know the country out there? My nephew, Chancy B. is with me for a few days but leaves to-morrow; so does Sulic                 for Kingston. They both                 speak affectionately of you & are much concerned on your account. The lilacs are in their prime here, but the season is getting dry.                  With much love.                 Ever Yours                 John Burroughs              ", "dateText": "", "percents": [], "taggedText": [[["image", "NN"], ["1image", "NN"], ["2image", "NN"], ["3image", "NN"], ["4", "CD"], [["Middletown", "NNP"]], ["N.Y.", "NNP"], ["June", "NNP"], ["2d", "CD"], ["73", "CD"], ["Dear", "NNP"], ["Walt", "NNP"], [",", ","], ["I", "PR