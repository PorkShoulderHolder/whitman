       Oct 15 /67                                  My dear Sir:                             I am pleased to hear that your article will be ready by the 21st   a week from today which will be just in time.                  Very truly yours                 F. P. Church                 Mr. Walt Whitman              Did you see Tinsley's for October with The Carol? ", "dateText": "", "percents": [], "taggedText": [[["image", "NN"], ["1image", "NN"], ["2image", "NN"], ["3image", "NN"], ["4", "CD"], [["Galaxy", "NNP"], ["Office", "NNP"]], ["Oct", "NNP"], ["15", "CD"], ["/67", "-NONE-"], ["My", "NNP"], ["dear", "NN"], [["Sir", "NNP"]], [":", ":"], ["I", "PRP"], ["am", "VBP"], ["pleased", "VBN"], ["to", "TO"], ["hear", "VB"], ["that", "IN"], ["your", "PRP$"], ["article", "NN"], ["will", "MD"], ["be", "VB"], ["ready", "RB"], ["by", "IN"], ["the", "DT"], ["21st", "CD"], ["a", "DT"], ["week", "NN"], ["from", "IN"], ["today", "NN"], ["which", "WDT"], ["will", "MD"], ["be", "VB"], ["just", "RB"], ["in", "IN"], ["time", "NN"], [".", "."]], [[["Very", "NNP"]], ["truly", "RB"], ["yours", "VBZ"], ["F.", "NNP"], ["P.", "NNP"], [["Church", "NNP"], ["Mr.", "NNP"], ["Walt", "NNP"], ["Whitman", "NNP"]], ["Did", "NNP"], ["you", "PRP"], ["see", "VB"], [["Tinsley", "NNP"]], ["'s", "POS"], ["for", "IN"], ["October", "NNP"], ["with", "IN"], ["The", "DT"], [["Carol", "NNP"]], ["?", "."]]], "sentences": ["image 1image 2image 3image 4  Galaxy Office                     Oct 15 /67                                  My dear Sir:                             I am pleased to hear that your article will be ready by the 21st   a week from today which will be just in time.", "Very truly yours                 F. P. Church                 Mr. Walt Whitman              Did you see Tinsley's for October with The Carol? "], "words": ["image", "1image", "2image", "3image", "4", "Galaxy", "Office", "Oct", "15", "/67", "My", "dear", "Sir", ":", "I", "am", "pleased", "to", "hear", "that", "your", "article", "will"