RP$"], ["address", "NN"], ["is", "VBZ"], [["Lewis", "NNP"], ["Wraymond", "NNP"]], ["7th", "CD"], ["St.", "NNP"], ["R.R", "NNP"], [".", "."]], [["office", "NN"], ["i", "PRP"], ["could", "MD"], ["not", "RB"], ["see", "VB"], ["the", "DT"], ["young", "JJ"], ["man", "NN"], ["Sy", "NNP"], ["[", "NNP"], ["d", "VBD"], ["?", "."]], [["]", "NN"], ["nor", "CC"], ["he", "PRP"], ["is", "VBZ"], ["sick", "VB"], ["&", "CC"], ["not", "RB"], ["at", "IN"], ["work", "NN"], [".", "."]], [["Jimmy", "NNP"], ["the", "DT"], [["Californian", "NNP"]], ["on", "IN"], ["7th", "JJ"], ["St.", "NNP"], ["RR", "NNP"], [["Jim", "NNP"], ["Sorrill", "NNP"]], ["sends", "VBZ"], ["his", "PRP$"], ["love", "NN"], ["&", "CC"], ["best", "JJS"], ["respects", "NNS"], ["&", "CC"], ["says", "VBZ"], ["he", "PRP"], ["is", "VBZ"], ["alive", "JJ"], ["&", "CC"], ["kicking", "VBG"], ["but", "CC"], ["the", "DT"], ["most", "RBS"], ["thing", "NN"], ["that", "WDT"], ["he", "PRP"], ["dont", "VBP"], ["understand", "VBP"], ["is", "VBZ"], ["that", "IN"], ["young", "JJ"], ["Lady", "NNP"], ["that", "IN"], ["said", "VBD"], ["you", "PRP"], ["make", "VBP"], ["such", "JJ"], ["a", "DT"], ["good", "JJ"], ["bed", "VBN"], ["fellow", "JJ"], [".", "."]], [["also", "RB"], [["Charley", "NNP"], ["Sorrill", "NNP"]], ["sends", "VBZ"], ["his", "PRP$"], ["love", "NN"], ["&", "CC"], ["is", "VBZ"], ["glad", "VBN"], ["to", "TO"], ["hear", "VB"], ["you", "PRP"], ["are", "VBP"], ["doing", "VBG"], ["so", "RB"], ["well", "RB"], [["Towers", "NNP"]], ["is", "VBZ"], [["Very", "NNP"]], ["much", "RB"], ["pleased", "VBN"], ["at", "IN"], ["your", "PRP$"], ["letter", "NN"], ["&", "CC"], ["sends", "NNS"], ["his", "PRP$"], ["love", "NN"], [["Henry", "NNP"], ["Hurt", "NNP"]], ["sends", "VBZ"], ["his", "PRP$"], ["love", "NN"], ["&", "CC"], ["is", "VBZ"], ["very", "RB"], ["thankful", "JJ"], ["for", "IN"], ["the", "DT"], [["Broadway", "NNP"]], ["that", "IN"], ["you", "PRP"], ["sent", "VBD"], ["him", "PRP"], ["I", "PRP"], ["saw", "VBD"], ["another", "DT"], ["game", "N