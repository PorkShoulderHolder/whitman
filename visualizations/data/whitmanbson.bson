ep appreciation of you & your letters.              ", "dateText": "", "percents": [], "taggedText": [[[["William", "NNP"]], ["bring", "NN"], ["in", "IN"], [",", ","], ["in", "IN"], ["your", "PRP$"], ["letter", "NN"], ["to", "TO"], [["Mr.", "NNP"], ["Rossetti", "NNP"]], [".", "."]], [["I", "PRP"], ["met", "VBD"], [["Mr.", "NNP"], ["Whitman", "NNP"]], ["a", "DT"], ["few", "JJ"], ["evenings", "NNS"], ["since", "IN"], [".", "."]], [["He", "PRP"], ["has", "VBZ"], ["received", "VBN"], ["your", "PRP$"], ["letter", "NN"], ["of", "IN"], ["December", "NNP"], ["16th", "CD"], [".", "."]], [["He", "PRP"], ["duly", "RB"], ["received", "VBD"], ["the", "DT"], ["previous", "JJ"], ["ones", "NNS"], ["also", "RB"], [",", ","], ["making", "VBG"], ["three", "CD"], ["letters", "NNS"], ["from", "IN"], ["you", "PRP"], [".", "."]], [["He", "PRP"], ["is", "VBZ"], ["entirely", "RB"], ["satisfied", "VBN"], ["with", "IN"], ["your", "PRP$"], ["action", "NN"], [",", ","], ["&", "CC"], ["with", "IN"], [["Mr.", "NNP"], ["Hotten", "NNP"]], ["'s", "POS"], [",", ","], ["in", "IN"], ["regard", "NN"], ["to", "TO"], ["the", "DT"], [["London", "NNP"]], ["selection", "NN"], ["&", "CC"], ["reprint", "NN"], [",", ","], ["and", "CC"], ["seems", "VBZ"], ["pleased", "VBN"], ["with", "IN"], ["the", "DT"], ["condition", "NN"], ["into", "IN"], ["which", "WDT"], ["that", "IN"], ["enterprise", "NN"], ["has", "VBZ"], ["been", "VBN"], ["shaped", "VBN"], [".", "."]], [["He", "PRP"], ["spoke", "VBD"], ["with", "IN"], ["deep", "NN"], ["appreciation", "NN"], ["of", "IN"], ["you", "PRP"], ["&", "CC"], ["your", "PRP$"], ["letters", "NNS"], [".", "."]]], "sentences": [" William   bring in, in your letter to Mr. Rossetti.", "I met Mr. Whitman a few evenings since.", "He has received your letter of December 16th.", "He duly received the previous ones also, making three letters from you.", "He is entirely satisfied with your action, & with Mr. Hotten's,                  in regard to the London selection & reprint, and seems ple