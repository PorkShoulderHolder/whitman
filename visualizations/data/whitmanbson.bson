dy", "return", "is", "of", "great", "importance", "to", "Wineburgh", ",", "I", "respectfully", "request", "that", "you", "execute", "it", "at", "your", "earliest", "convenience.", "If", "you", "will", "inform", "us", "what", "your", "charges", "and", "disbursements", "are", "we", "will", "remit", "by", "return", "of", "mail", ",", "or", "will", "arrange", "the", "matter", "on", "your", "return", "to", "this", "city.", "Yours", "most", "respectfully", ",", "Fred'k.", "Baker", ",", "15", "Nassau", "St.", "N.Y", "."], "date": [], "normalizedTime": "0.015503875969", "recipient": "Walt Whitman", "organizations": ["Deed"], "sender": "Frederick Baker", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00848.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Frederick Baker to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Frederick", "NNP"], ["Baker", "NNP"]], [",", ","]]], "people": ["Dear", "Mr.", "Mr. Adams", "Walt Whitman"], "money": [], "year": "1860", "locations": [], "month": "Apr", "parties": ["Walt Whitman", "Frederick Baker"], "properDate": "Apr 24, 1860", "gpe": ["Boston"], "facility": [], "latlngs": [[42.3584308, -71.0597732]], "text": "  Boston, Sunday night, | April 24.  Dear Brother, Mr. Baker,2 In compliance with your request, I execute and return the new and explanatory deed forthwith, depending upon you that it is all right, as I know nothing at all about such things. I paid Mr. Adams, the Commissioner, one dollar, which you may send me, if you please. Yours &c Walt Whitman ", "dateText": "", "percents": [], "taggedText": [[[["Boston", "NNP"]], [",", ","], ["Sunday", "NNP"], ["night", "NN"], [",", ","], ["|", ":"], ["April", "NNP"], ["24", "CD"], [".", "."]], [[["Dear", "NNP"]], [["Brother", "NNP"]], [",", ","], [["Mr.", "NNP"]], ["Baker,2", "NNP"], ["In", "NNP"], ["compliance", "NN"], ["with", "IN"], ["your", "PRP$"], ["request", "NN"], [",", ","], ["I", "PRP"], ["execute", "VBP"], ["and", "CC"], ["return", "NN"], ["the", "DT"], ["new", "JJ"], ["and", "CC"], ["explanatory", "JJ"], ["deed", "NN"], ["forthwith", "IN"], [",", ","], ["depending", "VBG"], ["upon", "IN"], ["you", "PRP"], ["that", "IN"], ["it", "PRP"], ["is", "VBZ"], ["all", "DT"], ["right", "RB"], [",", ","], ["as", "IN"], ["I", "PRP"], ["know", "VBP"], ["nothing", "NN"], ["at", "IN"], ["all", "DT"], ["about", "IN"], ["such", "JJ"], ["things", "NNS"], [".", "."]], [["I", "PRP"], ["paid", "VBD"], [["Mr.", "NNP"], ["Adams", "NNP"]], [",", ","], ["the", "DT"], [["Commissioner", "NNP"]], [",", ","], ["one", "CD"], ["dollar", "NN"], [",", ","], ["which", "WDT"], ["you", "PRP"], ["may", "MD"], ["send", "VB"], ["me", "PRP"], [",", ","], ["if", "IN"], ["you", "PRP"], ["please", "VBP"], [".", "."]], [["Yours", "NNS"], ["&", "CC"], ["c", "NN"], [["Walt", "NNP"], ["Whitman", "NNP"]]]], "sentences": ["  Boston, Sunday night, | April 24.", "Dear Brother, Mr. Baker,2 In compliance with your request, I execute and return the new and explanatory deed forthwith, depending upon you that it is all right, as I know nothing at all about such things.", "I paid Mr. Adams, the Commissioner, one dollar, which you may send me, if you please.", "Yours &c Walt Whitman "], "words": ["Boston", ",", "Sunday", "night", ",", "|", "April", "24.", "Dear", "Brother", ",", "Mr.", "Baker,2", "In", "compliance", "with", "your", "request", ",", "I", "execute", "and", "return", "the", "new", "and", "explanatory", "deed", "forthwith", ",", "depending", "upon", "you", "that", "it", "is", "all", "right", ",", "as", "I", "know", "nothing", "at", "all", "about", "such", "things.", "I", "paid", "Mr.", "Adams", ",", "the", "Commissioner", ",", "one", "dollar", ",", "which", "you", "may", "send", "me", ",", "if", "you", "please.", "Yours", "&", "c", "Walt", "Whitman"], "date": [], "normalizedTime": "0.015639874881", "recipient": "Frederick Baker", "organizations": ["Brother", "Commissioner"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00756.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to Frederick Baker ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Fred", "NNP"], ["Vaughan", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Jeff", "Mother", "Circus Co", "Walt"], "money": [], "year": "1860", "locations": [], "month": "Apr", "parties": ["Fred Vaughan", "Walt Whitman"], "properDate": "Apr 30, 1860", "gpe": ["Walt", "Brooklyn", "Matts", "Walt", "Japenese Embassy", "Every", "Boston", "Fred"], "facility": [], "latlngs": [[40.65, -73.95], [42.3584308, -71.0597732]], "text": "   Walt, I was very glad indeed to hear from you in answer to my last, and you know I could not but be gratified to find your business was progressing so favorably,   2 In accordance with not only your wishes, but my own I went to Brooklyn yesterday and saw your Mother.   I found her alone, Matt3 & Jeff4 out walking. Eddy5 at church, and George6 out somewhere's else I suppose. She did not remember me at first but as soon as she did she was very much pleased. I had a long talk, and settled the old $2.00 affair of Matts. I came away before she and Jeff returned. Walt, Mother says she feels first rate, is not at all sick, and I think she looks as well now as she did while I was living over there.   There is no news new Walt. The last fight, the Japenese Embassy, and the Charleston Democratic Convention, fill the papers to the exclusion of Every thing else.7   Dunn,8 the ex stage driver is in Boston with that Circus Co. I think he will call upon you as I gave him your address.   If you come on here this [week] Be sure and make it your business to call and see me. Do not neglect it please Walt, for I want to see you very much. Mrs. Cooper9 & Robert10 send their loves. Ever yours, In a Hurry! Fred.   ", "dateText": "", "percents": [], "taggedText": [[[["Walt", "NNP"]], [",", ","], ["I", "PRP"], ["was", "VBD"], ["very", "RB"], ["glad", "VBN"], ["indeed", "RB"], ["to", "TO"], ["hear", "VB"], ["from", "IN"], ["you", "PRP"], ["in", "IN"], ["answer", "JJR"], ["to", "TO"], ["my", "PRP$"], ["last", "JJ"], [",", ","], ["and", "CC"], ["you", "PRP"], ["know", "VBP"], ["I", "PRP"], ["could", "MD"], ["not", "RB"], ["but", "CC"], ["be", "VB"], ["gratified", "VBN"], ["to", "TO"], ["find", "VB"], ["your", "PRP$"], ["business", "NN"], ["was", "VBD"], ["progressing", "VBG"], ["so", "RB"], ["favorably", "RB"], [",", ","], ["2", "CD"], ["In", "NNP"], ["accordance", "NN"], ["with", "IN"], ["not", "RB"], ["only", "RB"], ["your", "PRP$"], ["wishes", "NNS"], [",", ","], ["but", "CC"], ["my", "PRP$"], ["own", "JJ"], ["I", "PRP"], ["went", "VBD"], ["to", "TO"], [["Brooklyn", "NNP"]], ["yesterday", "NN"], ["and", "CC"], ["saw", "VBD"], ["your", "PRP$"], ["Mother", "NNP"], [".", "."]], [["I", "PRP"], ["found", "VBD"], ["her", "PRP"], ["alone", "RB"], [",", ","], [["Matt3", "NNP"]], ["&", "CC"], [["Jeff4", "NNP"]], ["out", "IN"], ["walking", "VBG"], [".", "."]], [["Eddy5", "NNP"], ["at", "IN"], ["church", "NN"], [",", ","], ["and", "CC"], [["George6", "NNP"]], ["out", "IN"], ["somewhere", "RB"], ["'s", "POS"], ["else", "NN"], ["I", "PRP"], ["suppose", "VBP"], [".", "."]], [["She", "PRP"], ["did", "VBD"], ["not", "RB"], ["remember", "VB"], ["me", "PRP"], ["at", "IN"], ["first", "JJ"], ["but", "CC"], ["as", "IN"], ["soon", "RB"], ["as", "IN"], ["she", "PRP"], ["did", "VBD"], ["she", "PRP"], ["was", "VBD"], ["very", "RB"], ["much", "RB"], ["pleased", "VBN"], [".", "."]], [["I", "PRP"], ["had", "VBD"], ["a", "DT"], ["long", "JJ"], ["talk", "NN"], [",", ","], ["and", "CC"], ["settled", "VBD"], ["the", "DT"], ["old", "JJ"], ["$", "$"], ["2.00", "CD"], ["affair", "NN"], ["of", "IN"], [["Matts", "NNP"]], [".", "."]], [["I", "PRP"], ["came", "VBD"], ["away", "RB"], ["before", "IN"], ["she", "PRP"], ["and", "CC"], [["Jeff", "NNP"]], ["returned", "VBD"], [".", "."]], [[["Walt", "NNP"]], [",", ","], [["Mother", "NNP"]], ["says", "VBZ"], ["she", "PRP"], ["feels", "VBZ"], ["first", "JJ"], ["rate", "NN"], [",", ","], ["is", "VBZ"], ["not", "RB"], ["at", "IN"], ["all", "DT"], ["sick", "NN"], [",", ","], ["and", "CC"], ["I", "PRP"], ["think", "VBP"], ["she", "PRP"], ["looks", "VBZ"], ["as", "RB"], ["well", "RB"], ["now", "RB"], ["as", "IN"], ["she", "PRP"], ["did", "VBD"], ["while", "IN"], ["I", "PRP"], ["was", "VBD"], ["living", "VBG"], ["over", "IN"], ["there", "EX"], [".", "."]], [["There", "EX"], ["is", "VBZ"], ["no", "DT"], ["news", "NN"], ["new", "JJ"], ["Walt", "NNP"], [".", "."]], [["The", "DT"], ["last", "JJ"], ["fight", "NN"], [",", ","], ["the", "DT"], [["Japenese", "NNP"], ["Embassy", "NNP"]], [",", ","], ["and", "CC"], ["the", "DT"], [["Charleston", "NNP"], ["Democratic", "NNP"], ["Convention", "NNP"]], [",", ","], ["fill", "MD"], ["the", "DT"], ["papers", "NNS"], ["to", "TO"], ["the", "DT"], ["exclusion", "NN"], ["of", "IN"], [["Every", "NNP"]], ["thing", "NN"], ["else.7", "-NONE-"], ["Dunn,8", "-NONE-"], ["the", "DT"], ["ex", "NN"], ["stage", "NN"], ["driver", "NN"], ["is", "VBZ"], ["in", "IN"], [["Boston", "NNP"]], ["with", "IN"], ["that", "DT"], [["Circus", "NNP"], ["Co", "NNP"]], [".", "."]], [["I", "PRP"], ["think", "VBP"], ["he", "PRP"], ["will", "MD"], ["call", "VB"], ["upon", "IN"], ["you", "PRP"], ["as", "IN"], ["I", "PRP"], ["gave", "VBD"], ["him", "PRP"], ["your", "PRP$"], ["address", "NN"], [".", "."]], [["If", "IN"], ["you", "PRP"], ["come", "VBP"], ["on", "IN"], ["here", "RB"], ["this", "DT"], ["[", "NN"], ["week", "NN"], ["]", ":"], ["Be", "NNP"], ["sure", "RB"], ["and", "CC"], ["make", "VB"], ["it", "PRP"], ["your", "PRP$"], ["business", "NN"], ["to", "TO"], ["call", "VB"], ["and", "CC"], ["see", "VB"], ["me", "PRP"], [".", "."]], [["Do", "NNP"], ["not", "RB"], ["neglect", "VB"], ["it", "PRP"], ["please", "VB"], [["Walt", "NNP"]], [",", ","], ["for", "IN"], ["I", "PRP"], ["want", "VBP"], ["to", "TO"], ["see", "VB"], ["you", "PRP"], ["very", "RB"], ["much", "RB"], [".", "."]], [["Mrs.", "NNP"], ["Cooper9", "NNP"], ["&", "CC"], [["Robert10", "NNP"]], ["send", "NN"], ["their", "PRP$"], ["loves", "NNS"], [".", "."]], [["Ever", "RB"], ["yours", "VBZ"], [",", ","], ["In", "NNP"], ["a", "DT"], ["Hurry", "NNP"], ["!", "."]], [[["Fred", "NNP"]], [".", "."]]], "sentences": ["   Walt, I was very glad indeed to hear from you in answer to my last, and you know I could not but be gratified to find your business was progressing so favorably,   2 In accordance with not only your wishes, but my own I went to Brooklyn yesterday and saw your Mother.", "I found her alone, Matt3 & Jeff4 out walking.", "Eddy5 at church, and George6 out somewhere's else I suppose.", "She did not remember me at first but as soon as she did she was very much pleased.", "I had a long talk, and settled the old $2.00 affair of Matts.", "I came away before she and Jeff returned.", "Walt, Mother says she feels first rate, is not at all sick, and I think she looks as well now as she did while I was living over there.", "There is no news new Walt.", "The last fight, the Japenese Embassy, and the Charleston Democratic Convention, fill the papers to the exclusion of Every thing else.7   Dunn,8 the ex stage driver is in Boston with that Circus Co.", "I think he will call upon you as I gave him your address.", "If you come on here this [week] Be sure and make it your business to call and see me.", "Do not neglect it please Walt, for I want to see you very much.", "Mrs. Cooper9 & Robert10 send their loves.", "Ever yours, In a Hurry!", "Fred.   "], "words": ["Walt", ",", "I", "was", "very", "glad", "indeed", "to", "hear", "from", "you", "in", "answer", "to", "my", "last", ",", "and", "you", "know", "I", "could", "not", "but", "be", "gratified", "to", "find", "your", "business", "was", "progressing", "so", "favorably", ",", "2", "In", "accordance", "with", "not", "only", "your", "wishes", ",", "but", "my", "own", "I", "went", "to", "Brooklyn", "yesterday", "and", "saw", "your", "Mother.", "I", "found", "her", "alone", ",", "Matt3", "&", "Jeff4", "out", "walking.", "Eddy5", "at", "church", ",", "and", "George6", "out", "somewhere", "'s", "else", "I", "suppose.", "She", "did", "not", "remember", "me", "at", "first", "but", "as", "soon", "as", "she", "did", "she", "was", "very", "much", "pleased.", "I", "had", "a", "long", "talk", ",", "and", "settled", "the", "old", "$", "2.00", "affair", "of", "Matts.", "I", "came", "away", "before", "she", "and", "Jeff", "returned.", "Walt", ",", "Mother", "says", "she", "feels", "first", "rate", ",", "is", "not", "at", "all", "sick", ",", "and", "I", "think", "she", "looks", "as", "well", "now", "as", "she", "did", "while", "I", "was", "living", "over", "there.", "There", "is", "no", "news", "new", "Walt.", "The", "last", "fight", ",", "the", "Japenese", "Embassy", ",", "and", "the", "Charleston", "Democratic", "Convention", ",", "fill", "the", "papers", "to", "the", "exclusion", "of", "Every", "thing", "else.7", "Dunn,8", "the", "ex", "stage", "driver", "is", "in", "Boston", "with", "that", "Circus", "Co.", "I", "think", "he", "will", "call", "upon", "you", "as", "I", "gave", "him", "your", "address.", "If", "you", "come", "on", "here", "this", "[", "week", "]", "Be", "sure", "and", "make", "it", "your", "business", "to", "call", "and", "see", "me.", "Do", "not", "neglect", "it", "please", "Walt", ",", "for", "I", "want", "to", "see", "you", "very", "much.", "Mrs.", "Cooper9", "&", "Robert10", "send", "their", "loves.", "Ever", "yours", ",", "In", "a", "Hurry", "!", "Fred", "."], "date": [], "normalizedTime": "0.0164558683531", "recipient": "Walt Whitman", "organizations": ["Matt3", "Jeff4", "George6", "Charleston Democratic Convention", "Robert10"], "sender": "Fred Vaughan", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00571.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Fred Vaughan to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], ["W.", "NNP"], ["W.", "NNP"], ["Thayer", "NNP"], ["and", "CC"], [["Charles", "NNP"], ["W.", "NNP"], ["Eldridge", "NNP"]]]], "people": [], "money": [], "year": "1860", "locations": [], "month": "May", "parties": ["Walt Whitman", "Charles W. Eldridge"], "properDate": "May 0, 1860", "gpe": ["Arrived"], "facility": [], "latlngs": [], "text": " Arrived home all right, 24th, at dusk, over the \"shore line\"   I like that route better than the old one   no dust that day, and fine view of the water, half the time.1 The package came safe to ho[me] on Friday, containing my 20 purch[ased] L. of G. and 20 to give away at discretion. I shall send you a tally of the latter as I  [incomplete]. ", "dateText": "", "percents": [], "taggedText": [[[["Arrived", "NNP"]], ["home", "NN"], ["all", "DT"], ["right", "NN"], [",", ","], ["24th", "JJ"], [",", ","], ["at", "IN"], ["dusk", "NN"], [",", ","], ["over", "IN"], ["the", "DT"], ["``", "``"], ["shore", "NN"], ["line", "NN"], ["''", "''"], ["I", "PRP"], ["like", "VBP"], ["that", "IN"], ["route", "NN"], ["better", "JJR"], ["than", "IN"], ["the", "DT"], ["old", "JJ"], ["one", "CD"], ["no", "DT"], ["dust", "NN"], ["that", "IN"], ["day", "NN"], [",", ","], ["and", "CC"], ["fine", "NN"], ["view", "NN"], ["of", "IN"], ["the", "DT"], ["water", "NN"], [",", ","], ["half", "DT"], ["the", "DT"], ["time.1", "JJ"], ["The", "DT"], ["package", "NN"], ["came", "VBD"], ["safe", "NN"], ["to", "TO"], ["ho", "VB"], ["[", ":"], ["me", "PRP"], ["]", "VBP"], ["on", "IN"], ["Friday", "NNP"], [",", ","], ["containing", "VBG"], ["my", "PRP$"], ["20", "CD"], ["purch", "NN"], ["[", ":"], ["ased", "VBN"], ["]", "-NONE-"], ["L.", "NNP"], ["of", "IN"], ["G.", "NNP"], ["and", "CC"], ["20", "CD"], ["to", "TO"], ["give", "VB"], ["away", "RP"], ["at", "IN"], ["discretion", "NN"], [".", "."]], [["I", "PRP"], ["shall", "VBP"], ["send", "NN"], ["you", "PRP"], ["a", "DT"], ["tally", "RB"], ["of", "IN"], ["the", "DT"], ["latter", "NN"], ["as", "IN"], ["I", "PRP"], ["[", "VBP"], ["incomplete", "JJ"], ["]", "NN"], [".", "."]]], "sentences": [" Arrived home all right, 24th, at dusk, over the \"shore line\"   I like that route better than the old one   no dust that day, and fine view of the water, half the time.1 The package came safe to ho[me] on Friday, containing my 20 purch[ased] L. of G. and 20 to give away at discretion.", "I shall send you a tally of the latter as I  [incomplete]. "], "words": ["Arrived", "home", "all", "right", ",", "24th", ",", "at", "dusk", ",", "over", "the", "``", "shore", "line", "''", "I", "like", "that", "route", "better", "than", "the", "old", "one", "no", "dust", "that", "day", ",", "and", "fine", "view", "of", "the", "water", ",", "half", "the", "time.1", "The", "package", "came", "safe", "to", "ho", "[", "me", "]", "on", "Friday", ",", "containing", "my", "20", "purch", "[", "ased", "]", "L.", "of", "G.", "and", "20", "to", "give", "away", "at", "discretion.", "I", "shall", "send", "you", "a", "tally", "of", "the", "latter", "as", "I", "[", "incomplete", "]", "."], "date": [], "normalizedTime": "0.0164558683531", "recipient": "Charles W. Eldridge", "organizations": [], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00757.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to W. W. Thayer and Charles W. Eldridge"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Thomas", "NNP"], ["Jefferson", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Dear", "Uncle Tom", "Cabin", "Jeff", "Mother", "Jeff", "Jeff", "Jeff", "Mat", "Georgie"], "money": [], "year": "1860", "locations": [], "month": "May", "parties": ["Walt Whitman", "Thomas Jefferson Whitman"], "properDate": "May 10, 1860", "gpe": ["Boston", "Thayer", "Thayer", "Thayer", "Brooklyn", "Tell", "Boston Very", "Bostonian", "New England", "Maine", "New Hampshire", "Vermont", "Washington", "Han", "New York", "Walt"], "facility": [], "latlngs": [[42.3584308, -71.0597732], [36.5245064, -91.53819670000001], [36.5245064, -91.53819670000001], [36.5245064, -91.53819670000001], [40.65, -73.95], [43.9653889, -70.8226541], [45.253783, -69.4454689], [44.5588028, -72.57784149999999], [38.8951118, -77.0363658], [40.7143528, -74.00597309999999], [40.907507, -73.896546]], "text": "  Boston, | Thursday morning, May 10.  Dear Brother, I have nothing particular to write about, yet I know you will be glad to hear from me anyhow. The book is finished in all that makes the reading part, and is all through the press complete   It is electrotyped   that is, by a chemical process, a solution of copper, silver, zinc, &c. is precipitated in a \"bath,\" so as to cover the face of the plates of type all over, and make it very much harder and more enduring. Plates finished by that process wear well for hundreds of thousands of copies, and are probably a neater impression. But perhaps you know about it yourself. Thayer & Eldridge have put through 1000 copies, for the first pop. They have very accurate ideas of the whole matter. They expect it to be a valuable investment, increasing by months and years   not going off in a rocket way, (like \"Uncle Tom's Cabin.\")1   The typographical appearance of the book has been just as I directed it, in every respect. The printers and foremen thought I was crazy, and there were all sorts of supercilious squints (about the typography I ordered, I mean)   but since it has run through the press, they have simmered down. Yesterday the foreman of the press-room (Rand's,2 an old establishment where all the best work is done,) pronounced it, in plain terms, the freshest and handsomest piece of typography that had ever passed through his mill   I like it, I think, first rate   though I think I could improve much upon it now. It is quite \"odd,\" of course. As to Thayer & Eldridge they think every thing I do is the right thing. We are just now in \"suspenders\" on account of the engraving. I have about decided, though, to have 1000 copies printed from it, as it is   and then let Schoff,3 the engraver, finish it afterwards   I do not know for certain whether it is a good portrait or not   The probability is that the book will be bound and ready, May 19. I make Thayer & Eldridge crack on the elegant workmanship of the book, its material, &c. but I won't allow them to puff the poetry   though I had quite a hard struggle   as they had prepared several tremendous puff advertisements   altogether ahead of Ned Buntline and the \"Ledger\"4   I persuaded them to give me the copy to make some little corrections   which I did effectually by going straight to my lodgings, and putting the whole stuff in the fire   Oh, I forgot to tell you, they have printed a very neat little brochure, (pamphlet,) of 64 pages, called \"Leaves of Grass Imprints,\" containing a very readable collection of criticisms on the former issues   This is given away gratis, as an advertisement and circular. Altogether, Jeff, I am very, very much satisfied and relieved that the thing, in the permanent form it now is, looks as well and reads as well (to my own notion) as I anticipated   because a good deal, after all, was an experiment   and now I am satisfied. And how goes it with you, my dear? I watched the N. Y. papers to see if Spinola's5 bill passed   but it didn't, of course, or I should of heard of it in many ways. So you must be on the works still   If I get a chance I will take a look at the Boston Works before I leave. The water is almost exactly like the Brooklyn water in taste. I got Mother's letter6   tell Mother I may not write next Monday, as I am in hopes to be home, I can't tell exactly what day, but through the week. Oh the awful expense I have been under here, Jeff, living the way I have, hiring a room, and eating at restaurants   7 cents for a cup of coffee, and 19 cts for a beefsteak   and me so fond of coffee and beefsteak. Tell mother I think it would have been worth while for her to have moved on here, and boarded me    I have had a very fair time, though, here in Boston   Very, very many folks I meet I like much   I have never seen finer   they are fine in almost every respect   very friendly, very generous, very good feeling, and of course intelligent people   The great cramper of the Bostonian is, though, to be kept on the rack by the old idea of respectability, how the rest do, and what they will say. There are plenty of splendid specimens of men come from the other New England states to settle here, especially from Maine, New Hampshire, Vermont, &c, that if they would let themselves be, and only make that better and finer, would beat the world. For there is no denying that these Yanks are the first-class race. But, without exception, they all somehow allow themselves to be squeezed into the stereotype mould, and wear straight collars and hats, and say \"my respects\"   like the rest. Of course I cannot walk through Washington street, (the Broadway here,) without creating an immense sensation. I sent a couple of papers to Han this morning. Oh how much I would like to see her once more7   and I must, this summer   After I recruit a while home, I shall very likely take a tour, partly business and partly for edification, through all the N[ew] E[ngland] states   then I shall see Han   I shall write to her before I leave here   and do you write also, Jeff   don't fail   Should you write to me, in response to this, you must write so that I would get the letter not later than Wednesday morning next   as I feel the fit growing upon me stronger and stronger to move   And the fare is only $3 now from here to New York, cabin passage, in the boat   Besides I could go dead head if I was to apply   Jeff, I feel as if things had taken a turn with me, at last   Give my love to Mat, and all my dear brothers, especially Georgie. Walt. ", "dateText": "", "percents": [], "taggedText": [[[["Boston", "NNP"]], [",", ","], ["|", "NNP"], ["Thursday", "NNP"], ["morning", "NN"], [",", ","], ["May", "NNP"], ["10", "CD"], [".", "."]], [[["Dear", "NNP"]], [["Brother", "NNP"]], [",", ","], ["I", "PRP"], ["have", "VBP"], ["nothing", "NN"], ["particular", "JJ"], ["to", "TO"], ["write", "VB"], ["about", "IN"], [",", ","], ["yet", "CC"], ["I", "PRP"], ["know", "VBP"], ["you", "PRP"], ["will", "MD"], ["be", "VB"], ["glad", "VBN"], ["to", "TO"], ["hear", "VB"], ["from", "IN"], ["me", "PRP"], ["anyhow", "VBP"], [".", "."]], [["The", "DT"], ["book", "NN"], ["is", "VBZ"], ["finished", "VBN"], ["in", "IN"], ["all", "DT"], ["that", "DT"], ["makes", "VBZ"], ["the", "DT"], ["reading", "NN"], ["part", "NN"], [",", ","], ["and", "CC"], ["is", "VBZ"], ["all", "DT"], ["through", "IN"], ["the", "DT"], ["press", "NN"], ["complete", "NN"], ["It", "PRP"], ["is", "VBZ"], ["electrotyped", "VBN"], ["that", "IN"], ["is", "VBZ"], [",", ","], ["by", "IN"], ["a", "DT"], ["chemical", "JJ"], ["process", "NN"], [",", ","], ["a", "DT"], ["solution", "NN"], ["of", "IN"], ["copper", "NN"], [",", ","], ["silver", "NN"], [",", ","], ["zinc", "NN"], [",", ","], ["&", "CC"], ["c.", "NNP"], ["is", "VBZ"], ["precipitated", "VBN"], ["in", "IN"], ["a", "DT"], ["``", "``"], ["bath", "NN"], [",", ","], ["''", "''"], ["so", "IN"], ["as", "IN"], ["to", "TO"], ["cover", "VB"], ["the", "DT"], ["face", "NN"], ["of", "IN"], ["the", "DT"], ["plates", "NNS"], ["of", "IN"], ["type", "NN"], ["all", "DT"], ["over", "IN"], [",", ","], ["and", "CC"], ["make", "VB"], ["it", "PRP"], ["very", "RB"], ["much", "RB"], ["harder", "JJR"], ["and", "CC"], ["more", "JJR"], ["enduring", "VBG"], [".", "."]], [["Plates", "NNS"], ["finished", "VBD"], ["by", "IN"], ["that", "DT"], ["process", "NN"], ["we