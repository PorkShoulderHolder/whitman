NP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Edward", "NNP"], ["Dowden", "NNP"]], [",", ","]]], "people": ["Mr. Dowden", "John Burroughs", "Dublin", "Walt Whitman"], "money": [], "year": "1871", "locations": [], "month": "Sep", "parties": ["Walt", "Whitman", "Edward Dowden"], "properDate": "Sep 19, 1871", "gpe": ["Washington", "Europe"], "facility": [], "latlngs": [[38.8951118, -77.0363658]], "text": "  Washington, U. S.                     Sept. 19, 1871.                                  My Dear Mr. Dowden:              The gentleman who will hand you this is John Burroughs, a very valued friend of mine, who is about to start for Europe, and thinks of visiting Dublin, & making a call on you. I have rec'd your letter of Sept. 5, & hope to write you further   Believe me I deeply appreciate all you send me     Walt Whitman              ", "dateText": "", "percents": [], "taggedText": [[[["Washington", "NNP"]], [",", ","], ["U.", "NNP"], ["S.", "NNP"], ["Sept.", "NNP"], ["19", "CD"], [",", ","], ["1871", "CD"], [".", "."]], [["My", "PRP$"], ["Dear", "NNP"], [["Mr.", "NNP"], ["Dowden", "NNP"]], [":", ":"], ["The", "DT"], ["gentleman", "NN"], ["who", "WP"], ["will", "MD"], ["hand", "VB"], ["you", "PRP"], ["this", "DT"], ["is", "VBZ"], [["John", "NNP"], ["Burroughs", "NNP"]], [",", ","], ["a", "DT"], ["very", "RB"], ["valued", "VBN"], ["friend", "NN"], ["of", "IN"], ["mine", "JJ"], [",", ","], ["who", "WP"], ["is", "VBZ"], ["about", "IN"], ["to", "TO"], ["start", "VB"], ["for", "IN"], [["Europe", "NNP"]], [",", ","], ["and", "CC"], ["thinks", "NNS"], ["of", "IN"], ["visiting", "VBG"], [["Dublin", "NNP"]], [",", ","], ["&", "CC"], ["making", "VBG"], ["a", "DT"], ["call", "NN"], ["on", "IN"], ["you", "PRP"], [".", "."]], [["I", "PRP"], ["have", "VBP"], ["rec", "JJ"], ["'d", "JJ"], ["your", "PRP$"], ["letter", "NN"], ["of", "IN"], ["Sept.", "NNP"], ["5", "CD"], [",", ","], ["&", "CC"], ["hope", "NN"], ["to", "TO"], ["write", "VB"], ["you", "PRP"], ["further", "JJR"], ["Believe", "NNP"], ["me", "PRP"], ["I", "PRP"], ["deeply", "RB"], ["appreciate", "JJ"], ["all", "DT"], ["you", "PRP"], ["send", "VBP"], ["me", "PRP"], [["Walt", "NNP"], ["Whitman", "NNP"]]]], "sentences": ["  Washington, U. S.                     Sept. 19, 1871.", "My Dear Mr. Dowden:              The gentleman who will hand you this is John Burroughs, a very valued friend of mine, who is about to start for Europe, and thinks of visiting Dublin, & making a call on you.", "I have rec'd your letter of Sept. 5, & hope to write you further   Believe me I deeply appreciate all you send me     Walt Whitman              "], "words": ["Washington", ",", "U.", "S.", "Sept.", "19", ",", "1871.", "My", "Dear", "Mr.", "Dowden", ":", "The", "gentleman", "who", "will", "hand", "you", "this", "is", "John", "Burroughs", ",", "a", "very", "valued", "friend", "of", "mine", ",", "who", "is", "about", "to", "start", "for", "Europe", ",", "and", "thinks", "of", "visiting", "Dublin", ",", "&", "making", "a", "call", "on", "you.", "I", "have", "rec", "'d", "your", "letter", "of", "Sept.", "5", ",", "&", "hope", "to", "write", "you", "further", "Believe", "me", "I", "deeply", "appreciate", "all", "you", "send", "me", "Walt", "Whitman"], "date": [], "normalizedTime": "0.582075343397", "recipient": "Edward Dowden", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/loc.01700.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Edward Dowden ,"}, {"taggedHeading": [[[["John", "NNP"]], [["Addington", "NNP"], ["Symonds", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Sir", "John Addington Symonds"], "money": [], "year": "1871", "locations": [], "month": "Oct", "parties": ["John", "Addington Symonds", "Walt Whitman"], "properDate": "Oct 7, 1871", "gpe": ["Calamus", "Grass", "Italy", "Mediterranean", "Switzerland", "Calamus", "Answer"], "facility": [], "latlngs": [[41.87194, 12.56738], [41.4036007, -95.0138776]], "text": "image 1image 2image 3image 4image 5                  Oct  \ufffd 7. 1871.                 My dear Sir,              When a man has ventured to dedicate his work to another without authority or permission, I think that he is bound to make confession of the liberty he has taken. This must be my excuse for sending to you the crude poem in wh. you may perchance detect some echo, faint & feeble, of your Calamus.   As I have put pen to paper I cannot refrain from saying that since the time when I first took up Leaves of Grass in a friend's rooms at Trinity College Cambridge six                                     years ago till now, your poems have been my constant companions. I have read them in Italy by the shores of the Mediterranean, under pine trees or caverns washed by the sea   & in Switzerland among the alpine pastures & beside the glaciers. At home I have found in them pure air & health   the free breath of the world   when often cramped by illness & the cares of life. What one man can do                                      by communicating to those he loves the treasure he has found, I have done among my friends. I say this in order that I may, as simply as may be, tell you how much I owe to you. He who makes the words of a man his spiritual food for years is greatly that man's debtor. As for the poem I send you   it is of course implicit already in your Calamus, especially in \"Scented herbage of my breast.\"                                                     I have but set to an old tune the new divine song   : for you know that on this side of the Atlantic at least people most readily listen to old tunes. I fear greatly I have marred the purity & beauty of your thought by my bad singing.   I am an Englishman, married, with 3 children, & am aged 30.    Answer to this I scarcely expect, as I certainly do not deserve it. The poem I send is due for reasons already set forth. It is a printer's proof at present & no more.                  I am your grateful and attached                 John Addington Symonds              ", "dateText": "", "percents": [], "taggedText": [[["image", "NN"], ["1image", "NN"], ["2image", "NN"], ["3image", "NN"], ["4image", "NN"], ["5", "CD"], ["Oct", "NNP"], ["\ufffd", "NNP"], ["7", "CD"], [".", "."]], [["1871", "CD"], [".", "."]], [["My", "PRP$"], ["dear", "NN"], [["Sir", "NNP"]], [",", ","], ["When", "WRB"], ["a", "DT"], ["man", "NN"], ["has", "VBZ"], ["ventured", "VBN"], ["to", "TO"], ["dedicate", "VB"], ["his", "PRP$"], ["work", "NN"], ["to", "TO"], ["another", "DT"], ["without", "IN"], ["authority", "NN"], ["or", "CC"], ["permission", "NN"], [",", ","], ["I", "PRP"], ["think", "VBP"], ["that", "IN"], ["he", "PRP"], ["is", "VBZ"], ["bound", "VBN"], ["to", "TO"], ["make", "VB"], ["confession", "NN"], ["of", "IN"], ["the", "DT"], ["liberty", "NN"], ["he", "PRP"], ["has", "VBZ"], ["taken", "VBN"], [".", "."]], [["This", "DT"], ["must", "MD"], ["be", "VB"], ["my", "PRP$"], ["excuse", "NN"], ["for", "IN"], ["sending", "NN"], ["to", "TO"], ["you", "PRP"], ["the", "DT"], ["crude", "JJ"], ["poem", "NN"], ["in", "IN"], ["wh", "NN"], [".", "."]], [["you", "PRP"], ["may", "MD"], ["perchance", "VB"], ["detect", "NN"], ["some", "DT"], ["echo", "NN"], [",", ","], ["faint", "NN"], ["&", "CC"], ["feeble", "JJ"], [",", ","], ["of", "IN"], ["your", "PRP$"], [["Calamus", "NNP"]], [".", "."]], [["As", "IN"], ["I", "PRP"], ["have", "VBP"], ["put", "VBN"], ["pen", "RP"], ["to", "TO"], ["paper", "NN"], ["I", "PRP"], ["can", "MD"], ["not", "RB"], ["refrain", "VB"], ["from", "IN"], ["saying", "VBG"], ["that", "IN"], ["since", "IN"], ["the", "DT"], ["time", "NN"], ["when", "WRB"], ["I", "PRP"], ["first", "RB"], ["took", "VBD"], ["up", "RP"], [["Leaves", "NNP"]], ["of", "IN"], [["Grass", "NNP"]], ["in", "IN"], ["a", "DT"], ["friend", "NN"], ["'s", "POS"], ["rooms", "NNS"], ["at", "IN"], [["Trinity", "NNP"], ["College", "NNP"]], ["Camb