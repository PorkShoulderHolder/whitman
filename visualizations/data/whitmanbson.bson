ing", "to", "do", "for", "Ashton", ",", "so", "I", "will", "wind", "up", "my", "letter", ",", "&", "set", "about", "it", "I", "shall", "write", "once", "more", "before", "I", "come", "Good", "bye", "for", "this", "time", ",", "dear", "Mother.", "Walt", "."], "date": [], "normalizedTime": "0.431524547804", "recipient": "Louisa Van Velsor Whitman", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/tex.00188.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Louisa Van Velsor Whitman ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Abby", "NNP"], ["H.", "NNP"], ["Price", "NNP"]], [",", ","]]], "people": ["Broadway London Magazine"], "money": [], "year": "1868", "locations": [], "month": "Sep", "parties": ["Walt", "Whitman", "Abby H. Price"], "properDate": "Sep 14, 1868", "gpe": ["Washington", "New York", "Walt"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [40.7143528, -74.00597309999999]], "text": "  Attorney General's Office,                     Washington.                     Monday, Sept. 14, 1868                                   Dear Abby,              I shall come on in the train that leaves here in the middle of the day,                  to-morrow Tuesday, 15th, & gets in New York at 10 at night   so I shall be up there by or before 11 to-morrow night   (to-night for you reading this.)              I am really pleased that you can accommodate me, & make great reckoning of being with you,                  & of my room, &c   but wish [to] have it distinctly understood, in all friendship,                  that I pay for my room,                  &c, just the same as any body else   positively                  I will not come on any other terms   & you must just let it be as I say this time   I have lots of money   in fact untold wealth   & I shall not feel right                 if you undertake to alter this part of my programme   I am feeling well                  & hearty   I wish you to read my piece in the \"Broadway London Magazine,\"                  just out   it was written for you among the rest   In a few hours I shall be with you.               Walt.              ", "dateText": "", "percents": [], "taggedText": [[["Attorney", "NNP"], ["General", "NNP"], ["'s", "POS"], ["Office", "NNP"], [",", ","], [["Washington", "NNP"]], [".", "."]], [["Monday", "NNP"], [",", ","], ["Sept.", "NNP"], ["14", "CD"], [",", ","], ["1868", "CD"], ["Dear", "NNP"], ["Abby", "NNP"], [",", ","], ["I", "PRP"], ["shall", "MD"], ["come", "VB"], ["on", "IN"], ["in", "IN"], ["the", "DT"], ["train", "NN"], ["that", "IN"], ["leaves", "NNS"], ["here", "RB"], ["in", "IN"], ["the", "DT"], ["middle", "NN"], ["of", "IN"], ["the", "DT"], ["day", "NN"], [",", ","], ["to-morrow", "JJ"], ["Tuesday", "NNP"], [",", ","], ["15th", "JJ"], [",", ","], ["&", "CC"], ["gets", "NNS"], ["in", "IN"], [["New", "NNP"], ["York", "NNP"]], ["at", "IN"], ["10", "CD"], ["at", "IN"], ["night", "NN"], ["so", "RB"], ["I", "PRP"], ["shall", "MD"], ["be", "VB"], ["up", "RP"], ["there", "EX"], ["by", "IN"], ["or", "CC"], ["before", "IN"], ["11", "CD"], ["to-morrow", "JJ"], ["night", "NN"], ["(", ":"], ["to-night", "JJ"], ["for", "IN"], ["you", "PRP"], ["reading", "VBG"], ["this", "DT"], [".", "."]], [[")", "NN"], ["I", "PRP"], ["am", "VBP"], ["really", "RB"], ["pleased", "VBN"], ["that", "IN"], ["you", "PRP"], ["can", "MD"], ["accommodate", "VB"], ["me", "PRP"], [",", ","], ["&", "CC"], ["make", "VB"], ["great", "JJ"], ["reckoning", "NN"], ["of", "IN"], ["being", "VBG"], ["with", "IN"], ["you", "PRP"], [",", ","], ["&", "CC"], ["of", "IN"], ["my", "PRP$"], ["room", "NN"], [",", ","], ["&", "CC"], ["c", "NN"], ["but", "CC"], ["wish", "NN"], ["[", ":"], ["to", "TO"], ["]", "VB"], ["have", "VBP"], ["it", "PRP"], ["distinctly", "RB"], ["understood", "VBD"], [",", ","], ["in", "IN"], ["all", "DT"], ["friendship", 