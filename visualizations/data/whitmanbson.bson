["suffering", "NN"], ["ones", "NNS"], ["during", "IN"], ["the", "DT"], ["war", "NN"], ["I", "PRP"], ["will", "MD"], ["now", "RB"], ["close", "VB"], ["for", "IN"], ["perhaps", "RB"], ["you", "PRP"], ["may", "MD"], ["never", "RB"], ["receive", "VB"], ["this", "DT"], ["but", "CC"], ["if", "IN"], ["you", "PRP"], ["do", "VBP"], ["let", "VB"], ["me", "PRP"], ["hear", "VB"], ["from", "IN"], ["you", "PRP"], ["if", "IN"], ["it", "PRP"], ["is", "VBZ"], ["convenient", "JJ"], [".", "."]], [["May", "NNP"], ["God", "NNP"], ["bless", "NN"], ["you", "PRP"], ["kind", "VBP"], ["friend", "NN"], ["and", "CC"], ["in", "IN"], ["[", "NNP"], ["illegible", "JJ"], ["]", "NN"], ["through", "IN"], ["[", "CD"], ["illegible", "JJ"], ["]", "NN"], ["you", "PRP"], ["have", "VB"], ["the", "DT"], ["kindest", "JJS"], ["regards", "NNS"], ["of", "IN"], ["your", "PRP$"], ["humble", "JJ"], ["servant", "NN"], [",", ","], [["Hiram", "NNP"], ["Sholes", "NNP"], ["AlbanyN", "NNP"]], [".", "."]], [["Y", "NNP"], [".", "."]]], "sentences": ["image 1image 2image 3image 4image 5image 6  1867                     Albany                     May 24th                                  Mr Walt Whitman,              You may be surprised in receiving this from me but seeing your name in the paper the other day I could not resist the temptation of writing to you.", "You undoubtedly can bring to mind the gloomy winter of 1'62 and    3 and of your many visits to the different Hospitals in and about Washington I was an inmate of Armory Square Hospital and always occupied a bed by the side of Louis K. Brown                                                                     the boy that suffered so much with a \"Compound Fracture\" of the leg and after laying months and months had it amputated at last My kind friend (for so you must permit me to call you) I have thought of you many times since I left Washington and how well can I remember you as you came into the Wards with the Haversack under your arm giving some little nesessary here, a kind word there, and when you came to Louis bed and mine how cordialy you grasped our  hands and anxiously                                                                                   enquired into our condition.", "I thank you for all this and you in your lonely moments                 must be happy in thinking of the good you have done to the many suffering ones                 during the war I will now close for perhaps you may never receive this but if you do let me hear             from you if it is convenient.", "May God bless you kind friend and in [illegible] through [illegible] you have the kindest regards of your humble servant,  Hiram Sholes                 AlbanyN.", "Y.              "], "words": ["image", "1image", "2image", "3image", "4image", "5image", "6", "1867", "Albany", "May", "24th", "Mr", "Walt", "Whitman", ",", "You", "may", "be", "surprised", "in", "receiving", "this", "from", "me", "but", "seeing", "your", "name", "in", "the", "paper", "the", "other", "day", "I", "could", "not", "resist", "the", "temptation", "of", "writing", "to", "you.", "You", "undoubtedly", "can", "bring", "to", "mind", "the", "gloomy", "winter", "of", "1'62", "and", "3", "and", "of", "your", "many", "visits", "to", "the", "different", "Hospitals", "in", "and", "about", "Washington", "I", "was", "an", "inmate", "of", "Armory", "Square", "Hospital", "and", "always", "occupied", "a", "bed", "by", "the", "side", "of", "Louis", "K.", "Brown", "the", "boy", "that", "suffered", "so", "much", "with", "a", "``", "Compound", "Fracture", "''", "of", "the", "leg", "and", "after", "laying", "months", "and", "months", "had", "it", "amputated", "at", "last", "My", "kind", "friend", "(", "for", "so", "you", "must", "permit", "me", "to", "call", "you", ")", "I", "have", "thought", "of", "you", "many", "times", "since", "I", "left", "Washington", "and", "how", "well", "can", "I", "remember", "you", "as", "you", "came", "into", "the", "Wards", "with", "the", "Haversack", "under", "your", "arm", "giving", "some", "little", "nesessary", "here", ",", "a", "kind", "word", "there", ",", "and", "when", "you", "came", "to", "Louis", "bed", "and", "mine", "how", "cordialy", "you", "grasped", "our", "hands", "and", "anxiously", "enquired", "into", "our", "condition.", "I", "thank", "you", "for", "all", "this", "and", "you", "in", "your", "lonely", "moments", "must", "be", "happy", "in", "thinking", "of", "the", "good", "you", "have", "done", "to", "the", "many", "suffering", "ones", "during", "the", "war", "I", "will", "now", "close", "for", "perhaps", "you", "may", "never", "receive", "this", "but", "if", "you", "do", "let", "me", "hear", "from", "you", "if", "it", "is", "convenient.", "May", "God", "bless", "you", "kind", "friend", "and", "in", "[", "illegible", "]", "through", "[", "illegible", "]", "you", "have", "the", "kindest", "regards", "of", "your", "humble", "servant", ",", "Hiram", "Sholes", "AlbanyN.", "Y", "."], "date": [], "normalizedTime": "0.367333061336", "recipient": "Walt Whitman", "organizations": ["Compound Fracture"], "sender": "Sholes", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/loc.01920.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Hiram Sholes to Walt Whitman ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Hiram", "NNP"], ["Sholes", "NNP"]], [",", ","]]], "people": ["Hiram", "Lewis", "Brown", "Clerk", "Auditor", "Adrian Bartlett", "Tom", "Lewy Brown", "Bowen", "Old", "Armory Square", "Miss", "Lowell", "Lewy", "Brown", "Joe Harris", "Miss Martins"], "money": [], "year": "1867", "locations": [], "month": "May", "parties": ["Walt", "Whitman", "Hiram Sholes"], "properDate": "May 30, 1867", "gpe": ["Hiram", "Thompson", "New Jersey", "Shot", "Washington", "Ohio", "Cate", "New", "New York", "Hiram"], "facility": [], "latlngs": [[33.8756601, -84.7621592], [32.0717395, -106.6241582], [38.8951118, -77.0363658], [40.7143528, -74.00597309999999], [33.8756601, -84.7621592], [48.21474509999999, -101.5805256], [41.88550310000001, -86.5898397], [40.7658085, -73.83308439999999]], "text": "  Dear friend Hiram,              Your letter of 27th May has come safe to hand, & I was truly glad to hear from you.                  Hiram, you must not think I have forgotten you, for I have thought of you too                  many times since the days we used to see each other there in the Hospital.                  Lewis Brown is well. I see him often. He has a place here as Clerk, at $1200 a year.                  He is in the 4th Auditor's Office, Treasury Department, & that is his address.                  Did you know Adrian Bartlett   in Ward K? He is also a clerk in 4th Auditor's.                  Thompson, the one so low with diarrhea, went home to New Jersey,                  & I have never heard from him since. Taber was killed in one of the Battles of the Wilderness.                  Shot in the head & fell instantly. Tom Sawyer, (Lewy Brown's friend),                  passed safe through the war   but we have not heard from him now for two years.                  Dr. Bliss is practising here in Washington. Dr Bowen also. Old Armory Square                  is now used as an Army Clothing depot. Of course all the big hospitals are                  long broken up   there now remain only the Post Hospital, U. S. A. on K st.                  & two or three small regimental hospitals in & around the city.              As to me & my fortunes I am in pretty good health, thank God   & I am working in the Attorney General's office (as the heading of this letter.)                 It is an easy kind of place   the other clerks are all young men, friendly              & jovial   So I have things pleasant enough. The pay is 1000 a year. Miss Lowell is still around   is interested in the African schools.                  Lewy Brown has just been in to see me   he says he wrote two letters                  & wrote to your mother   Joe Harris often asks for you & is doing well   is in the State Office   Mrs & Miss Martins are well.              Curly, at last accounts, was home in Ohio. Cate is home in New Hampshire   he has been committing matrimony   & is now supposed to be suffering                  the consequences   poor reckless young man   Mrs. Wright is at Flushing, L. I., New York. She is in the Soldiers' orphan home.              Hiram, you ought to have put in your letter how you got along with your leg since,                  & how you are now in health, & how you are situated.                  I want to hear all about you generally   all the particulars.              Well I believe that is all this time. I send you my love, dear friend                  & soldier, & I hope this will find you well in health & in good spirits.                  So God bless you, boy, & for the present I must bid you Farewell    ", "dateText": "", "percents": [], "taggedText": [[["Dear", "NNP"], ["friend", "VBP"], [["Hiram", "NNP"]], [",", ","], ["Your", "NNP"], ["letter", "NN"], ["of", "IN"], ["27th", "CD"], ["May", "NNP"], ["has", "VBZ"], ["come", "VBN"], ["safe", "NN"], ["to", "TO"], ["hand", "VB"], [",", ","], ["&", "CC"], ["I", "PRP"], ["was", "VBD"], ["truly", "RB"], ["glad", "VBN"], ["to", "TO"], ["hear", "VB"], ["from", "IN"], ["you", "PRP"], [".", "."]], [[["Hiram", "NN"]], [",", ","], ["you", "PRP"], ["must", "MD"], ["not", "RB"], ["think", "VB"], ["I", "PRP"], ["have", "VBP"], ["forgotten", "VBN"], ["you", "PRP"], [",", ","], ["for", "IN"], ["I", "PRP"], ["have", "VBP"], ["thought", "VBN"], ["of", "IN"], ["you", "PRP"], ["too", "RB"], ["many", "JJ"], ["times", "NNS"], ["since", "IN"], ["the", "DT"], ["days", "NNS"], ["we", "PRP"], ["used", "VBD"], ["to", "TO"], ["see", "VB"], ["each", "DT"], ["other", "JJ"], ["there", "EX"], ["in", "IN"], ["the", "DT"], [["Hospital", "NNP"]], [".", "."]], [[["Lewis", "NNP"]], [["Brown", "NNP"]], ["is", "VBZ"], ["well", "R