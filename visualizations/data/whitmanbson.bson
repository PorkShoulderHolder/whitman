r", "IN"], ["a", "DT"], ["cloudy", "NN"], ["half-rainy", "JJ"], ["morning", "NN"], ["is", "VBZ"], ["mild", "VBN"], ["&", "CC"], ["warm", "NN"], ["I", "PRP"], ["go", "VBP"], ["out", "RP"], ["for", "IN"], ["about", "RB"], ["an", "DT"], ["hour", "NN"], ["generally", "RB"], ["about", "IN"], ["noon", "NN"], [",", ","], ["with", "IN"], ["my", "PRP$"], ["cane", "NN"], [",", ","], ["(", ":"], ["&", "CC"], ["accompanied", "VBD"], ["by", "IN"], ["my", "PRP$"], ["little", "JJ"], ["yellow", "NN"], ["&", "CC"], ["white", "NN"], ["dog", "NN"], [",", ","], ["a", "DT"], ["most", "RBS"], ["faithful", "JJ"], ["affectionate", "NN"], ["companion", "NN"], [")", ":"], ["frequently", "RB"], ["take", "VB"], ["a", "DT"], ["ride", "NN"], ["in", "IN"], ["the", "DT"], ["cars", "NNS"], [",", ","], ["or", "CC"], ["across", "IN"], ["in", "IN"], ["the", "DT"], ["boat", "NN"], ["the", "DT"], ["men", "NNS"], ["quite", "RB"], ["all", "DT"], ["know", "NN"], ["me", "PRP"], [",", ","], ["&", "CC"], ["are", "VBP"], ["very", "RB"], ["kind", "JJ"], [".", "."]], [[["Walt", "NNP"]], [["Whitman", "NNP"], ["Abby", "NNP"]], ["mind", "NN"], ["the", "DT"], ["address", "NN"], ["your", "PRP$"], ["last", "JJ"], ["letter", "NN"], ["went", "VBD"], ["wrong", "JJ"], ["had", "NN"], ["the", "DT"], ["wrong", "JJ"], ["state", "NN"]]], "sentences": ["  431 Stevens st. cor West.", "Camden N. Jersey,           March 3.", "Dear friend Abby, (& Dear friends all)        The letter of the 28th reached me yesterday after going wrong and was truly welcome.", "(I suppose you rec'd my postal card acknowledging your previous one, briefly, & saying I should prefer the upper room.", ")          Since then I have had another bad spell   has lasted some fifteen days   head, legs,          gastric region, all bad   but am to-day feeling decidedly better.", "I shall quite          certainly come on   cannot now [pla]n the time, but will write before   & take up my quarters a while with you, as it seems to be agreeable, & the moderate sum          you mention I should pay thankfully   Though badly disabled, I am perfectly able          to take care of myself, & my sister says I am no trouble   I am sure we would all get along well together    I have just rec'd a letter from Mrs. O'Connor, from Washington, today.", "Her daughter,          (just 16,) is not well, has had a form of measles, a second attack, quite severe,          & is otherwise ailing, but I think will probably come out of it all, & grow stronger.", "I was glad to hear about your dear grandchildren   and about our friends          Mrs. Davis & Mrs.", "Rein   I am alone, in the house to-day, (except Eddy)   as my sister has gone out          to spend the day, & my brother has gone to Easton, about his work.", "My brother Jeff,          at St. Louis, is well   his girls are growing finely.", "I am sitting here in the parlor   it is about 11\u00bd   the sun has just come out, after a cloudy          half-rainy morning   is mild & warm   I go out for about an hour generally about noon,          with my cane, (& accompanied by my little yellow & white dog, a most faithful affectionate          companion)   frequently take a ride in the cars, or across in the boat   the men quite all know me, & are very kind.", "Walt Whitman        Abby   mind the address   your last letter went wrong   had the wrong state    "], "words": ["431", "Stevens", "st.", "cor", "West.", "Camden", "N.", "Jersey", ",", "March", "3.", "Dear", "friend", "Abby", ",", "(", "&", "Dear", "friends", "all", ")", "The", "letter", "of", "the", "28th", "reached", "me", "yesterday", "after", "going", "wrong", "and", "was", "truly", "welcome.", "(", "I", "suppose", "you", "rec", "'d", "my", "postal", "card", "acknowledging", "your", "previous", "one", ",", "briefly", ",", "&", "saying", "I", "should", "prefer", "the", "upper", "room.", ")", "Since", "then", "I", "have", "had", "another", "bad", "spell", "has", "lasted", "some", "fifteen", "days", "head", ",", "legs", ",", "gastric", "region", ",", "all", "bad", "but", "am", "to-day", "feeling", "decidedly", "better.", "I", "shall", "quite", "certainly", "come", "on", "can", "not", "now", "[", "pla", "]", "n", "the", "time", ",", "but", "will", "write", "before", "&", "take", "up", "my", "quarters", "a", "while", "with", "you", ",", "as", "it", "seems", "to", "be", "agreeable", ",", "&", "the", "moderate", "sum", "you", "mention", "I", "should", "pay", "thankfully", "Though", "badly", "disabled", ",", "I", "am", "perfectly", "able", "to", "take", "care", "of", "myself", ",", "&", "my", "sister", "says", "I", "am", "no", "trouble", "I", "am", "sure", "we", "would", "all", "get", "along", "well", "together", "I", "have", "just", "rec", "'d", "a", "letter", "from", "Mrs.", "O'Connor", ",", "from", "Washington", ",", "today.", "Her", "daughter", ",", "(", "just", "16", ",", ")", "is", "not", "well", ",", "has", "had", "a", "form", "of", "measles", ",", "a", "second", "attack", ",", "quite", "severe", ",", "&", "is", "otherwise", "ailing", ",", "but", "I", "think", "will", "probably", "come", "out", "of", "it", "all", ",", "&", "grow", "stronger.", "I", "was", "glad", "to", "hear", "about", "your", "dear", "grandchildren", "and", "about", "our", "friends", "Mrs.", "Davis", "&", "Mrs.", "Rein", "I", "am", "alone", ",", "in", "the", "house", "to-day", ",", "(", "except", "Eddy", ")", "as", "my", "sister", "has", "gone", "out", "to", "spend", "the", "day", ",", "&", "my", "brother", "has", "gone", "to", "Easton", ",", "about", "his", "work.", "My", "brother", "Jeff", ",", "at", "St.", "Louis", ",", "is", "well", "his", "girls", "are", "growing", "finely.", "I", "am", "sitting", "here", "in", "the", "parlor", "it", "is", "about", "11\u00bd", "the", "sun", "has", "just", "come", "out", ",", "after", "a", "cloudy", "half-rainy", "morning", "is", "mild", "&", "warm", "I", "go", "out", "for", "about", "an", "hour", "generally", "about", "noon", ",", "with", "my", "cane", ",", "(", "&", "accompanied", "by", "my", "little", "yellow", "&", "white", "dog", ",", "a", "most", "faithful", "affectionate", "companion", ")", "frequently", "take", "a", "ride", "in", "the", "cars", ",", "or", "across", "in", "the", "boat", "the", "men", "quite", "all", "know", "me", ",", "&", "are", "very", "kind.", "Walt", "Whitman", "Abby", "mind", "the", "address", "your", "last", "letter", "went", "wrong", "had", "the", "wrong", "state"], "date": [], "normalizedTime": "0.703930368557", "recipient": "Abby H. Price", "organizations": ["St. Louis"], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/pml.00042.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Abby H. Price ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Ellen", "NNP"], ["M.", "NNP"]], ["O'Connor", "NNP"], [",", ","]]], "people": ["Stevens st.", "Camden", "Dear", "Nelly", "Ada Clare", "Charley", "Love", "Nelly"], "money": [], "year": "1874", "locations": ["West"], "month": "Mar", "parties": ["Walt", "Whitman", "Ellen M."], "properDate": "Mar 8, 1874", "gpe": ["Nelly", "Poor", "Walt"], "facility": [], "latlngs": [[38.2947578, -121.2455569]], "text": "  431 Stevens st. / cor West. / Camden, / N. Jersey.           Sunday, noon.                             Dear Nelly,        I must first tell you what will please you best, namely that I [am] feeling decidedly better          than usual this morning   I have spent an hour in the bath room, (quite my regular test,)          & come out not only without any diminution of strength or elasticity   but an increase   & with a visit or descending upon me like of a long-absent feeling of physical ease          & unconsciousness, which I will welcome as a precursor, even if [it] soon passes over          (as it doubtless will)   but hope for return. For I suppose you know that my condition          is very tantalizing in its fluctuations   Like today as I write   now the sun is out bright enough   & fifteen minutes since, I noticed from the window quite a flurry of snow   & cloudy   At any rate I am feeling again to-day one of the glimpses I had or was beginning to have          last May, before mother died   am under its influence & benefit to-day   & you shall have the good of it, Nelly dear   as far as this note can give.        Poor, poor, Ada Clare   I have been inexpressibly shocked by the horrible & sudden close          of her gay, easy, sunny free, loose, but not ungood life   I suppose you have seen about it,          but I cut the enclosed from the Herald in case you have not    Nelly, I rec'd your letter   I send W. Graphics of 21st & 28th as you request   The W. G. of 7th March is my last no.   did you get it?   I rec'd Charley's letter   Love to you & all   I feel to-day as though we shall yet be together again & have better times than ever, Nelly dear.         Walt        ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"]], ["/", "NNP"], ["cor", "NN"], [["West", "NNP"]], [".", "."]], [["/", "NN"], [["Camden", "NNP"]], [",", ","], ["/", "NNP"], ["N.", "NNP"], ["Jersey", "NNP"], [".", "."]], [["Sunday", "NNP"], [",", ","], ["noon", "NN"], [".", "."]], [[["Dear", "NNP"]], [["Nelly", "NNP"]], [",", ","], ["I", "PRP"], ["must", "MD"], ["first", "RB"], ["tell", "VB"], ["you", "PRP"], ["what", "WP"], ["will", "MD"], ["please", "VB"], ["you", "PRP"], ["best", "JJS"], [",", ","], ["namely", "RB"], ["that", "IN"], ["I", "PRP"], ["[", "VBP"], ["am", "VBP"], ["]", ":"], ["feeling", "VBG"], ["decidedly", "RB"], ["better", "JJR"], ["than", "IN"], ["usual", "JJ"], ["this", "DT"], ["morning", "NN"], ["I", "PRP"], ["have", "VBP"], ["spent", "VBN"], ["an", "DT"], ["hour", "NN"], ["in", "IN"], ["the", "DT"], ["bath", "NN"], ["room", "NN"], [",", ","], ["(", ":"], ["quite", "RB"], ["my", "PRP$"], ["regular", "JJ"], ["test", "NN"], [",", ","], [")", ":"], ["&", "CC"], ["come", "VBP"], ["out", "RP"], ["not", "RB"], ["only", "RB"], ["without", "IN"], ["any", "DT"], ["diminution", "NN"], ["of", "IN"], ["strength", "NN"], ["or", "CC"], ["elasticity", "NN"], ["but", "CC"], ["an", "DT"], ["increase", "NN"], ["&", "CC"], ["with", "IN"], ["a", "DT"], ["visit", "NN"], ["or", "CC"], ["descending", "VBG"], ["upon", "IN"], ["me", "PRP"], ["like", "IN"], ["of", "IN"], ["a", "DT"], ["long-absent", "JJ"], ["feeling", "NN"], ["of", "IN"], ["physical", "JJ"], ["ease", "NN"], ["&", "CC"], ["unconsciousness", "NN"], [",", ","], ["which", "WDT"], ["I", "PRP"], ["will", "MD"], ["welcome", "VB"], ["as", "IN"], ["a", "DT"], ["precursor", "NN"], [",", ","], ["even", "RB"], ["if", "IN"], ["[", "CD"], ["it", "PRP"], ["]", ":"], ["soon", "RB"], ["passes", "VBZ"], ["over", "IN"], ["(", "CD"], ["as", "IN"], ["it", "PRP"], ["doubtless", "VBZ"], ["will", "MD"], [")", "VB"], ["but", "CC"], ["hope", "NN"], ["for", "IN"], ["return", "NN"], [".", "."]], [["For", "IN"], ["I", "PRP"], ["suppose", "VBP"], ["you", "PRP"], ["know", "VBP"], ["that", "IN"], ["my", "PRP$"], ["condition", "NN"], ["is", "VBZ"], ["very", "RB"], ["tantalizing", "VBG"], ["in", "IN"], ["its", "PRP$"], ["fluctuations", "NNS"], ["Like", "NNP"], ["today", "NN"], ["as", "IN"], ["I", "PRP"], ["write", "VBP"], ["now", "RB"], ["the", "DT"], ["sun", "NN"], ["is", "VBZ"], ["out", "RP"], ["bright", "JJ"], ["enough", "RB"], ["&", "CC"], ["fifteen", "IN"], ["minutes", "NNS"], ["since", "IN"], [",", ","], ["I", "PRP"], ["noticed", "VBD"], ["from", "IN"], ["the", "DT"], ["window", "NN"], ["quite", "RB"], ["a", "DT"], ["flurry", "NN"], ["of", "IN"], ["snow", "NN"], ["&", "CC"], ["cloudy", "NN"], ["At", "IN"], ["any", "DT"], ["rate", "NN"], ["I", "PRP"], ["am", "VBP"], ["feeling", "VBG"], ["again", "RB"], ["to-day", "JJ"], ["one", "CD"], ["of", "IN"], ["the", "DT"], ["glimpses", "NNS"], ["I", "PRP"], ["had", "VBD"], ["or", "CC"], ["was", "VBD"], ["beginning", "VBG"], ["to", "TO"], ["have", "VB"], ["last", "JJ"], ["May", "NNP"], [",", ","], ["before", "IN"], ["mother", "NN"], ["died", "VBD"], ["am", "NN"], ["under", "IN"], ["its", "PRP$"], ["influence", "NN"], ["&", "CC"], ["benefit", "NN"], ["to-day", "NN"], ["&", "CC"], ["you", "PRP"], ["shall", "MD"], ["have", "VB"], ["the", "DT"], ["good", "JJ"], ["of", "IN"], ["it", "PRP"], [",", ","], [["Nelly", "NNP"]], ["dear", "NN"], ["as", "IN"], ["far", "RB"], ["as", "IN"], ["this", "DT"], ["note", "NN"], ["can", "MD"], ["give", "VB"], [".", "."]], [[["Poor", "NNP"]], [",", ","], ["poor", "JJ"], [",", ","], [["Ada", "NNP"], ["Clare", "NNP"]], ["I", "NNP"], ["have", "VBP"], ["been", "VBN"], ["inexpressibly", "RB"], ["shocked", "VBN"], ["by", "IN"], ["the", "DT"], ["horrible", "JJ"], ["&", "CC"], ["sudden", "JJ"], ["close", "NN"], ["of", "IN"], ["her", "PRP$"], ["gay", "NN"], [",", ","], ["easy", "JJ"], [",", ","], ["sunny", "JJ"], ["free", "JJ"], [",", ","], ["loose", "JJ"], [",", ","], ["but", "CC"], ["not", "RB"], ["ungood", "NN"], ["life", "NN"], ["I", "PRP"], ["suppose", "VBP"], ["you", "PRP"], ["have", "VBP"], ["seen", "VBN"], ["about", "IN"], ["it", "PRP"], [",", ","], ["but", "CC"], ["I", "PRP"], ["cut", "VBD"], ["the", "DT"], ["enclosed", "VBN"], ["from", "IN"], ["the", "DT"], [["Herald", "NNP"]], ["in", "IN"], ["case", "NN"], ["you", "PRP"], ["have", "VB"], ["not", "RB"], ["Nelly", "RB"], [",", ","], ["I", "PRP"], ["rec", "VBP"], ["'d", "JJ"], ["your", "PRP$"], ["letter", "NN"], ["I", "PRP"], ["send", "VBP"], ["W.", "NNP"], ["Graphics", "NNP"], ["of", "IN"], ["21st", "CD"], ["&", "CC"], ["28th", "CD"], ["as", "IN"], ["you", "PRP"], ["request", "VBP"], ["The", "DT"], ["W.", "NNP"], ["G.", "NNP"], ["of", "IN"], ["7th", "JJ"], ["March", "NNP"], ["is", "VBZ"], ["my", "PRP$"], ["last", "JJ"], ["no", "DT"], [".", "."]], [["did", "VBD"], ["you", "PRP"], ["get", "VB"], ["it", "PRP"], ["?", "."]], [["I", "PRP"], ["rec", "VBP"], ["'d", "JJ"], [["Charley", "NNP"]], ["'s", "POS"], ["letter", "NN"], [["Love", "NNP"]], ["to", "TO"], ["you", "PRP"], ["&", "CC"], ["all", "DT"], ["I", "PRP"], ["feel", "VBP"], ["to-day", "JJ"], ["as", "IN"], ["though", "IN"], ["we", "PRP"], ["shall", "MD"], ["yet", "RB"], ["be", "VB"], ["together", "RB"], ["again", "RB"], ["&", "CC"], ["have", "VB"], ["better", "JJR"], ["times", "NNS"], ["than", "IN"], ["ever", "NN"], [",", ","], [["Nelly", "NNP"]], ["dear", "NN"], [".", "."]], [[["Walt", "NNP"]]]], "sentences": ["  431 Stevens st. / cor West.", "/ Camden, / N. Jersey.", "Sunday, noon.", "Dear Nelly,        I must first tell you what will please you best, namely that I [am] feeling decidedly better          than usual this morning   I have spent an hour in the bath room, (quite my regular test,)          & come out not only without any diminution of strength or elasticity   but an increase   & with a visit or descending upon me like of a long-absent feeling of physical ease          & unconsciousness, which I will welcome as a precursor, even if [it] soon passes over          (as it doubtless will)   but hope for return.", "For I suppose you know that my condition          is very tantalizing in its fluctuations   Like today as I write   now the sun is out bright enough   & fifteen minutes since, I noticed from the window quite a flurry of snow   & cloudy   At any rate I am feeling again to-day one of the glimpses I had or was beginning to have          last May, before mother died   am under its influence & benefit to-day   & you shall have the good of it, Nelly dear   as far as this note can give.", "Poor, poor, Ada Clare   I have been inexpressibly shocked by the horrible & sudden close          of her gay, easy, sunny free, loose, but not ungood life   I suppose you have seen about it,          but I cut the enclosed from the Herald in case you have not    Nelly, I rec'd your letter   I send W. Graphics of 21st & 28th as you request   The W. G. of 7th March is my last no.", "did you get it?", "I rec'd Charley's letter   Love to you & all   I feel to-day as though we shall yet be together again & have better times than ever, Nelly dear.", "Walt        "], "words": ["431", "Stevens", "st.", "/", "cor", "West.", "/", "Camden", ",", "/", "N.", "Jersey.", "Sunday", ",", "noon.", "Dear", "Nelly", ",", "I", "must", "first", "tell", "you", "what", "will", "please", "you", "best", ",", "namely", "that", "I", "[", "am", "]", "feeling", "decidedly", "better", "than", "usual", "this", "morning", "I", "have", "spent", "an", "hour", "in", "the", "bath", "room", ",", "(", "quite", "my", "regular", "test", ",", ")", "&", "come", "out", "not", "only", "without", "any", "diminution", "of", "strength", "or", "elasticity", "but", "an", "increase", "&", "with", "a", "visit", "or", "descending", "upon", "me", "like", "of", "a", "long-absent", "feeling", "of", "physical", "ease", "&", "unconsciousness", ",", "which", "I", "will", "welcome", "as", "a", "precursor", ",", "even", "if", "[", "it", "]", "soon", "passes", "over", "(", "as", "it", "doubtless", "will", ")", "but", "hope", "for", "return.", "For", "I", "suppose", "you", "know", "that", "my", "condition", "is", "very", "tantalizing", "in", "its", "fluctuations", "Like", "today", "as", "I", "write", "now", "the", "sun", "is", "out", "bright", "enough", "&", "fifteen", "minutes", "since", ",", "I", "noticed", "from", "the", "window", "quite", "a", "flurry", "of", "snow", "&", "cloudy", "At", "any", "rate", "I", "am", "feeling", "again", "to-day", "one", "of", "the", "glimpses", "I", "had", "or", "was", "beginning", "to", "have", "last", "May", ",", "before", "mother", "died", "am", "under", "its", "influence", "&", "benefit", "to-day", "&", "you", "shall", "have", "the", "good", "of", "it", ",", "Nelly", "dear", "as", "far", "as", "this", "note", "can", "give.", "Poor", ",", "poor", ",", "Ada", "Clare", "I", "have", "been", "inexpressibly", "shocked", "by", "the", "horrible", "&", "sudden", "close", "of", "her", "gay", ",", "easy", ",", "sunny", "free", ",", "loose", ",", "but", "not", "ungood", "life", "I", "suppose", "you", "have", "seen", "about", "it", ",", "but", "I", "cut", "the", "enclosed", "from", "the", "Herald", "in", "case", "you", "have", "not", "Nelly", ",", "I", "rec", "'d", "your", "letter", "I", "send", "W.", "Graphics", "of", "21st", "&", "28th", "as", "you", "request", "The", "W.", "G.", "of", "7th", "March", "is", "my", "last", "no.", "did", "you", "get", "it", "?", "I", "rec", "'d", "Charley", "'s", "letter", "Love", "to", "you", "&", "all", "I", "feel", "to-day", "as", "though", "we", "shall", "yet", "be", "together", "again", "&", "have", "better", "times", "than", "ever", ",", "Nelly", "dear.", "Walt"], "date": [], "normalizedTime": "0.704610363117", "recipient": "Ellen M.", "organizations": ["Herald"], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/nyp.00330.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Ellen M. O'Connor ,"}, {"taggedHeading": [[[["Postcard", "NNP"]], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Ellen", "NNP"], ["M.", "NNP"]], ["O'Connor", "NNP"], [",", ","]]], "people": ["Sha", "Ch"], "money": [], "year": "1874", "locations": [], "month": "Mar", "parties": ["Postcard", "Walt Whitman", "Ellen M."], "properDate": "Mar 9, 1874", "gpe": ["Camden", "Wish"], "facility": [], "latlngs": [[51.55170589999999, -0.1588255]], "text": "  Camden,           March 9. 5 p.m.                            Yours rec'd last night. The let up & somewhat favorable condition mentioned in my letter          of Sunday still continues. Have not the slightest idea of hastening to W[ashington]   Shan't come till I get good & ready. Continue to write often. Wish Ch. to write me all news, & oftener.         W.        ", "dateText": "", "percents": [], "taggedText": [[[["Camden", "NNP"]], [",", ","], ["March", "NNP"], ["9", "CD"], [".", "."]], [["5", "LS"], ["p.m.", "NN"], ["Yours", "NNS"], ["rec", "VBP"], ["'d", "JJ"], ["last", "JJ"], ["night", "NN"], [".", "."]], [["The", "DT"], ["let", "NN"], ["up", "RP"], ["&", "CC"], ["somewhat", "RB"], ["favorable", "JJ"], ["condition", "NN"], ["mentioned", "VBD"], ["in", "IN"], ["my", "PRP$"], ["letter", "NN"], ["of", "IN"], ["Sunday", "NNP"], ["still", "RB"], ["continues", "VBZ"], [".", "."]], [["Have", "NNP"], ["not", "RB"], ["the", "DT"], ["slightest", "JJS"], ["idea", "NN"], ["of", "IN"], ["hastening", "VBG"], ["to", "TO"], ["W", "NNP"], ["[", "NNP"], ["ashington", "NN"], ["]", ":"], [["Sha", "NNP"]], ["n't", "RB"], ["come", "VBN"], ["till", "RB"], ["I", "PRP"], ["get", "VBP"], ["good", "JJ"], ["&", "CC"], ["ready", "JJ"], [".", "."]], [[["Continue", "NNP"]], ["to", "TO"], ["write", "VB"], ["often", "RB"], [".", "."]], [[["Wish", "JJ"]], [["Ch", "NNP"]], [".", "."]], [["to", "TO"], ["write", "VB"], ["me", "PRP"], ["all", "DT"], ["news", "NN"], [",", ","], ["&", "CC"], ["oftener", "NN"], [".", "."]], [["W", "NNP"], [".", "."]]], "sentences": ["  Camden,           March 9.", "5 p.m.                            Yours rec'd last night.", "The let up & somewhat favorable condition mentioned in my letter          of Sunday still continues.", "Have not the slightest idea of hastening to W[ashington]   Shan't come till I get good & ready.", "Continue to write often.", "Wish Ch.", "to write me all news, & oftener.", "W.        "], "words": ["Camden", ",", "March", "9.", "5", "p.m.", "Yours", "rec", "'d", "last", "night.", "The", "let", "up", "&", "somewhat", "favorable", "condition", "mentioned", "in", "my", "letter", "of", "Sunday", "still", "continues.", "Have", "not", "the", "slightest", "idea", "of", "hastening", "to", "W", "[", "ashington", "]", "Sha", "n't", "come", "till", "I", "get", "good", "&", "ready.", "Continue", "to", "write", "often.", "Wish", "Ch.", "to", "write", "me", "all", "news", ",", "&", "oftener.", "W", "."], "date": [], "normalizedTime": "0.704746362029", "recipient": "Ellen M.", "organizations": [], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/nyp.00331.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Postcard from Walt Whitman to Ellen M. O'Connor ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Ellen", "NNP"], ["M.", "NNP"]], ["O'Connor", "NNP"], [",", ","]]], "people": ["Stevens st.", "Summer"], "money": [], "year": "1874", "locations": ["West"], "month": "Mar", "parties": ["Walt", "Whitman", "Ellen M."], "properDate": "Mar 22, 1874", "gpe": ["Camden", "Grier"], "facility": [], "latlngs": [[51.55170589999999, -0.1588255]], "text": "  431 Stevens st. cor West. Camden, N. Jersey,           Sunday, March 22, after 4, p.m.                             Dearest Nelly,        I will just write you a word (for I feel to.) I am feeling well enough to be hopeful   Whether it is because I am hopeful   or whether the precursor of health yet, after all   tedious as it is a-coming   this deponent cannot swear   but we will think it the latter.          I have had a bad week since I wrote you   feel more comfortable to-day. Saw the doctor (Grier)         day before yesterday   he made a careful ausculation of my heart   pronounced it all right there   (I have been suffering considerable pain & oppression on left side)   He still thinks I will recover   says he is not disposed to recommend galvanism, (though the electric business is his specialty)   says he is sure the main trouble is the cerebral an\u00e6mia   cure, great care, good surroundings,          time & hygiene   arrives, in fact, at the same conclusions as Dr. Drinkard   (though an entirely different man from Dr. D., a great talker, & very demonstrative)    Nelly, you needn't send the photos of my nieces back yet. Keep them a while yet.        Nelly, your last letter is very blue, mainly about political & public degradation   Summer's death & inferior men &c. being rampant &c   I look on all such states of things          exactly as I look on a cloudy & evil state of weather, or a fog, or long sulk meteorological   it is a natural result of things, a growth of something deeper, has its uses,          & will hasten to exhaust itself, & yield to something better     Walt.        Thanks for your letter of 20th   give my love to Mrs. Brownell    ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"]], ["cor", "NN"], [["West", "NNP"]], [".", "."]], [[["Camden", "NNP"]], [",", ","], ["N.", "NNP"], ["Jersey", "NNP"], [",", ","], ["Sunday", "NNP"], [",", ","], ["March", "NNP"], ["22", "CD"], [",", ","], ["after", "IN"], ["4", "CD"], [",", ","], ["p.m.", "NNP"], ["Dearest", "NNP"], ["Nelly", "NNP"], [",", ","], ["I", "PRP"], ["will", "MD"], ["just", "RB"], ["write", "VB"], ["you", "PRP"], ["a", "DT"], ["word", "NN"], ["(", ":"], ["for", "IN"], ["I", "PRP"], ["feel", "VBP"], ["to", "TO"], [".", "."]], [[")", "NN"], ["I", "PRP"], ["am", "VBP"], ["feeling", "VBG"], ["well", "RB"], ["enough", "RB"], ["to", "TO"], ["be", "VB"], ["hopeful", "JJ"], ["Whether", "NNP"], ["it", "PRP"], ["is", "VBZ"], ["because", "IN"], ["I", "PRP"], ["am", "VBP"], ["hopeful", "JJ"], ["or", "CC"], ["whether", "IN"], ["the", "DT"], ["precursor", "NN"], ["of", "IN"], ["health", "NN"], ["yet", "RB"], [",", ","], ["after", "IN"], ["all", "DT"], ["tedious", "JJ"], ["as", "IN"], ["it", "PRP"], ["is", "VBZ"], ["a-coming", "JJ"], ["this", "DT"], ["deponent", "NN"], ["can", "MD"], ["not", "RB"], ["swear", "VB"], ["but", "CC"], ["we", "PRP"], ["will", "MD"], ["think", "VB"], ["it", "PRP"], ["the", "DT"], ["latter", "NN"], [".", "."]], [["I", "PRP"], ["have", "VBP"], ["had", "VBN"], ["a", "DT"], ["bad", "JJ"], ["week", "NN"], ["since", "IN"], ["I", "PRP"], ["wrote", "VBD"], ["you", "PRP"], ["feel", "VBP"], ["more", "JJR"], ["comfortable", "JJ"], ["to-day", "JJ"], [".", "."]], [["Saw", "NNP"], ["the", "DT"], ["doctor", "NN"], ["(", ":"], [["Grier", "NNP"