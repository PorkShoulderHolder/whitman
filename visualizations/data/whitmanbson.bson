S"], [["Expedition2", "NNP"]], ["has", "VBZ"], ["sailed", "VBN"], [",", ","], ["but", "CC"], ["everyone", "NN"], ["is", "VBZ"], ["in", "IN"], ["the", "DT"], ["dark", "JJ"], ["as", "IN"], ["to", "TO"], ["its", "PRP$"], ["destination", "NN"], [",", ","], ["I", "PRP"], ["only", "RB"], ["hope", "VBP"], ["they", "PRP"], ["are", "VBP"], ["going", "VBG"], ["to", "TO"], ["act", "VB"], [",", ","], ["with", "IN"], ["us", "PRP"], ["in", "IN"], ["the", "DT"], ["capture", "NN"], ["of", "IN"], [["Richmond", "NNP"]], [",", ","], ["which", "WDT"], ["it", "PRP"], ["seems", "VBZ"], ["to", "TO"], ["me", "PRP"], ["should", "MD"], ["be", "VB"], ["taken", "VBN"], [",", ","], ["without", "IN"], ["any", "DT"], ["more", "RBR"], ["blowing", "VBG"], ["and", "CC"], ["talking", "VBG"], [".", "."]], [["Mother", "NNP"], ["you", "PRP"], ["ask", "VBP"], ["if", "IN"], ["my", "PRP$"], ["throat", "NN"], ["troubles", "NNS"], ["me", "PRP"], ["any", "DT"], ["now", "RB"], [".", "."]], [["Not", "RB"], ["a", "DT"], ["bit", "NN"], [",", ","], ["I", "PRP"], ["never", "RB"], ["felt", "VBD"], ["better", "RBR"], ["in", "IN"], ["my", "PRP$"], ["life", "NN"], [",", ","], ["one", "CD"], ["thing", "NN"], ["I", "PRP"], ["have", "VBP"], ["learned", "VBN"], ["in", "IN"], ["this", "DT"], ["war", "NN"], [",", ","], ["and", "CC"], ["that", "IN"], ["is", "VBZ"], [",", ","], ["that", "IN"], ["I", "PRP"], ["can", "MD"], ["stand", "VB"], ["almost", "RB"], ["any", "DT"], ["amount", "NN"], ["of", "IN"], ["exposeure", "NN"], [",", ","], ["as", "IN"], ["I", "PRP"], ["have", "VBP"], ["found", "VBN"], ["by", "IN"], ["experience", "NN"], [",", ","], [["Mother", "NNP"]], ["dont", "NN"], ["fail", "NN"], ["to", "TO"], ["let", "VB"], ["me", "PRP"], ["hear", "VB"], ["from", "IN"], ["you", "PRP"], ["as", "IN"], ["soon", "RB"], ["as", "IN"], ["you", "PRP"], ["get", "VBP"], ["the", "DT"], ["money", "NN"], [",", ","], ["and", "CC"], ["when", "WRB"], ["you", "PRP"], ["write", "VBP"], ["to", "TO"], [["Han", "NNP"]], ["tell", "NN"], ["her", "PRP"], ["to", "TO"], ["be", "VB"], ["Sure", "NNP"], ["and", "CC"], ["write", "VB"], ["to", "TO"], ["me", "PRP"], [".", "."]], [[["Good", "NNP"]], [["ByeG", "NNP"]], [".", "."]], [["W.", "NNP"], ["Whitman", "NNP"]]], "sentences": ["  Camp of 51st Regt N Y Vols nearFalmouth Va December 8th 1862 Dear Mother.", "All is quiet along the Rappahannock and we are still lying here in Camp.", "The weather has been Cold here, for the last day or two, and this morning the ground is covered with snow, but the sun is out now, warm and pleasant and promises fine weather.", "We were paid, a few days since, and one of our Officers leaves this afternoon for Washington to take money to the Express Office.", "I shall send you $300.", "The Expressage will not be paid so you will pay it when you receive the money.", "I suppose you will get it soon after you get this.", "I have been out with my Co on Picket but we are now back to Camp,  I had charge of the line, for more than a mile, so that I had to keep my Eyes open,  we were posted along the bank of the river which is very narrow, and so Shallow that it is very easy to cross, at some places,  The Rebs are posted on the opposite bank in plain sight and we could talk to each other, but there was no shooting as I had strickt orders not to alow a rifle fired, unless the Rebs commenced the performance,  Capt Francis,1 came back last night but he is not very well and will not take command of the Co for a few days yet.", "I received Walts letter, (enclosing a note from You and Mattie) when I was on Picket, and was so pleased to hear from you all, that I read them over three or four times, and wished we could have one good big square fight that would settle the Rebs, and the war at the same time, so that I could come home and see you all, and drink that wine Matt has saved for me.", "I hardly think there will be a fight here at Fredericksburg, as we have orders to fix up our tents as though we were expected to stay here some time.", "The rebels seem to be buisy, building breastworks, and prepareing for us, but I should think it would not be much trouble for us to drive them out of Fredericksburg if we went about it.", "I see by the papers the great Banks Expedition2 has sailed, but everyone is in the dark as to its destination,  I only hope they are going to act, with us in the capture of Richmond, which it seems to me should be taken, without any more blowing and talking.", "Mother you ask if my throat troubles me any now.", "Not a bit,  I never felt better in my life,  one thing I have learned in this war, and that is, that I can stand almost any amount of exposeure, as I have found by experience, Mother dont fail to let me hear from you as soon as you get the money, and when you write to Han tell her to be Sure and write to me.", "Good ByeG.", "W. Whitman"], "words": ["Camp", "of", "51st", "Regt", "N", "Y", "Vols", "nearFalmouth", "Va", "December", "8th", "1862", "Dear", "Mother.", "All", "is", "quiet", "along", "the", "Rappahannock", "and", "we", "are", "still", "lying", "here", "in", "Camp.", "The", "weather", "has", "been", "Cold", "here", ",", "for", "the", "last", "day", "or", "two", ",", "and", "this", "morning", "the", "ground", "is", "covered", "with", "snow", ",", "but", "the", "sun", "is", "out", "now", ",", "warm", "and", "pleasant", "and", "promises", "fine", "weather.", "We", "were", "paid", ",", "a", "few", "days", "since", ",", "and", "one", "of", "our", "Officers", "leaves", "this", "afternoon", "for", "Washington", "to", "take", "money", "to", "the", "Express", "Office.", "I", "shall", "send", "you", "$", "300.", "The", "Expressage", "will", "not", "be", "paid", "so", "you", "will", "pay", "it", "when", "you", "receive", "the", "money.", "I", "suppose", "you", "will", "get", "it", "soon", "after", "you", "get", "this.", "I", "have", "been", "out", "with", "my", "Co", "on", "Picket", "but", "we", "are", "now", "back", "to", "Camp", ",", "I", "had", "charge", "of", "the", "line", ",", "for