92710458316", "recipient": "Charles W. Eldridge", "organizations": ["Trovatore2"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/nyp.00215.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to Charles W. Eldridge ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Livingston", "NNP"], ["J.", "NNP"], ["Brooks", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Dear", "Friend Well"], "money": [], "year": "1863", "locations": [], "month": "Nov", "parties": ["Livingston J. Brooks", "Walt Whitman"], "properDate": "Nov 21, 1863", "gpe": [], "facility": [], "latlngs": [], "text": " Dear Friend Well uncle I thought I would scratch off a few lines to you to let you know that I am well at present and I hope the few lines will find you the same I have thought of you many a time since we parted I have been home since then and have got back with the regiment we have had some skirmishing and picketing to do since I got back we came off of picket yesterday and last night we got payed off and to day it is rainey and wet so it quite uncomfortable you must excuse my pen and ink well I wont write a great deal this time I intended to write to you before but we have been moving about so I aint had time well no more this time pleas answer this soon as you can my love to you   Co. B 17th Pa Cavalry  ", "dateText": "", "percents": [], "taggedText": [[[["Dear", "NNP"]], [["Friend", "NNP"], ["Well", "NNP"]], ["uncle", "NN"], ["I", "PRP"], ["thought", "VBD"], ["I", "PRP"], ["would", "MD"], ["scratch", "VB"], ["off", "RP"], ["a", "DT"], ["few", "JJ"], ["lines", "NNS"], ["to", "TO"], ["you", "PRP"], ["to", "TO"], ["let", "VB"], ["you", "PRP"], ["know", "VB"], ["that", "IN"], ["I", "PRP"], ["am", "VBP"], ["well", "RB"], ["at", "IN"], ["present", "JJ"], ["and", "CC"], ["I", "PRP"], ["hope", "VBP"], ["the", "DT"], ["few", "JJ"], ["lines", "NNS"], ["will", "MD"], ["find", "VB"], ["you", "PRP"], ["the", "DT"], ["same", "JJ"], ["I", "PRP"], ["have", "VBP"], ["thought", "VBN"], ["of", "IN"], ["you", "PRP"], ["many", "JJ"], ["a", "DT"], ["time", "NN"], ["since", "IN"], ["we", "PRP"], ["parted", "VBD"], ["I", "PRP"], ["have", "VBP"], ["been", "VBN"], ["home", "NN"], ["since", "IN"], ["then", "RB"], ["and", "CC"], ["have", "VB"], ["got", "VBN"], ["back", "RP"], ["with", "IN"], ["the", "DT"], ["regiment", "NN"], ["we", "PRP"], ["have", "VBP"], ["had", "VBN"], ["some", "DT"], ["skirmishing", "VBG"], ["and", "CC"], ["picketing", "VBG"], ["to", "TO"], ["do", "VB"], ["since", "IN"], ["I", "PRP"], ["got", "VBD"], ["back", "RP"], ["we", "PRP"], ["came", "VBD"], ["off", "RP"], ["of", "IN"], ["picket", "NN"], ["yesterday", "NN"], ["and", "CC"], ["last", "JJ"], ["night", "NN"], ["we", "PRP"], ["got", "VBD"], ["payed", "VBN"], ["off", "RP"], ["and", "CC"], ["to", "TO"], ["day", "NN"], ["it", "PRP"], ["is", "VBZ"], ["rainey", "NN"], ["and", "CC"], ["wet", "NN"], ["so", "IN"], ["it", "PRP"], ["quite", "RB"], ["uncomfortable", "JJ"], ["you", "PRP"], ["must", "MD"], ["excuse", "VB"], ["my", "PRP$"], ["pen", "NN"], ["and", "CC"], ["ink", "NN"], ["well", "RB"], ["I", "PRP"], ["wont", "VBP"], ["write", "JJ"], ["a", "DT"], ["great", "JJ"], ["deal", "NN"], ["this", "DT"], ["time", "NN"], ["I", "PRP"], ["intended", "VBD"], ["to", "TO"], ["write", "VB"], ["to", "TO"], ["you", "PRP"], ["before", "IN"], ["but", "CC"], ["we", "PRP"], ["have", "VBP"], ["been", "VBN"], ["moving", "VBG"], ["about", "IN"], ["so", "RB"], ["I", "PRP"], ["aint", "VBP"], ["had", "VBD"], ["time", "NN"], ["well", "RB"], ["no", "DT"], ["more", "RBR"], ["this", "DT"], ["time", "NN"], ["pleas", "VBZ"], ["answer", "NN"], ["this", "DT"], ["soon", "NN"], ["as", "IN"], ["you", "PRP"], ["can", "MD"], ["my", "PRP$"], ["love", "VB"], ["to", "TO"], ["you", "PRP"], ["Co.", "NNP"], ["B", "NNP"], ["17th", "CD"], ["Pa", "NNP"], ["Cavalry", "NNP"]]], "sentences": [" Dear Friend Well uncle I thought I would scratch off a few lines to you to let you know that I am well at present and I hope the few lines will find you the same I have thought of you many a time since we parted I have been home since then and have got back with the regiment we have had some skirmishing and picketing to do since I got back we came off of picket yesterday and last night we got payed off and to day it is rainey and wet so it quite uncomfortable you must excuse my pen and ink well I wont write a great deal this time I intended to write to you before but we have been moving about so I aint had time well no more this time pleas answer this soon as you can my love to you   Co. B 17th Pa Cavalry  "], "words": ["Dear", "Friend", "Well", "uncle", "I", "thought", "I", "would", "scratch", "off", "a", "few", "lines", "to", "you", "to", "let", "you", "know", "that", "I", "am", "well", "at", "present", "and", "I", "hope", "the", "few", "lines", "will", "find", "you", "the", "same", "I", "have", "thought", "of", "you", "many", "a", "time", "since", "we", "parted", "I", "have", "been", "home", "since", "then", "and", "have", "got", "back", "with", "the", "regiment", "we", "have", "had", "some", "skirmishing", "and", "picketing", "to", "do", "since", "I", "got", "back", "we", "came", "off", "of", "picket", "yesterday", "and", "last", "night", "we", "got", "payed", "off", "and", "to", "day", "it", "is", "rainey", "and", "wet", "so", "it", "quite", "uncomfortable", "you", "must", "excuse", "my", "pen", "and", "ink", "well", "I", "wont", "write", "a", "great", "deal", "this", "time", "I", "intended", "to", "write", "to", "you", "before", "but", "we", "have", "been", "moving", "about", "so", "I", "aint", "had", "time", "well", "no", "more", "this", "time", "pleas", "answer", "this", "soon", "as", "you", "can", "my", "love", "to", "you", "Co.", "B", "17th", "Pa", "Cavalry"], "date": [], "normalizedTime": "0.193254453964", "recipient": "Walt Whitman", "organizations": [], "sender": "Livingston J. Brooks", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/nyp.00152.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Livingston J. Brooks to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Ellen", "NNP"], ["M.", "NNP"]], ["O'Connor", "NNP"], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Charlie Eldridge", "Girard Avenue", "Broad", "Cooper", "William", "William", "Charlie", "Dear", "William"], "money": [], "year": "1863", "locations": [], "month": "Nov", "parties": ["Ellen M.", "Walt Whitman"], "properDate": "Nov 21, 1863", "gpe": ["Sat", "Many", "New York", "Walt", "Kiss", "Good", "New York"], "facility": [], "latlngs": [[47.53217619999999, 18.6555811], [40.7143528, -74.00597309999999], [40.7143528, -74.00597309999999]], "text": "  Sat. Nov. 21st 400 L Street  Dear Walt, Many thanks for your long good letter, which I am not going now to answer. I write at the request of Charlie Eldridge who said that he should be too busy to-day to do so, to tell you that he and Mrs. Cooper are to leave here either in the 8 A.M. or the 11 A.M. train on Monday next, for Philadelphia, and he is to remain at her house that night.1 They want you to leave New York so as to meet them, and stay at her house too. Her residence is No. 1429 Girard Avenue, between Broad & 15th Streets. Mrs. Cooper has been coaxing, persuading, begging, entreating, commanding even William to go on with them too, but he says he can't , & I know him well enough to know that she can't move him.2 She wants me to go on also, but I know that I shall not unless some strong pressure is brought to bear between now & Monday, for I can see that William does not want to spare me. They fully count upon seeing you. Charlie will remain at Mrs. C's till Tuesday evening. By the way   he got your letter, & was delighted with it, he said it was worthy to be set in a gold frame & to which Wm. & I assented most heartily. Dear Walt, we long for you, William sighs for you, & I feel as if a large part of myself were out of the city,   I shall give you a good big kiss when you come, so depend upon it. My love to your good, noble mother, whom I shall some day know. Kiss her for me   & tell her that I love her boy Walt. I want to see those splendid children too. But I shall some day. Good bye. Now more now, but if you are not back in a few days I will write you a good long letter, and answer yours fully. Oh! do you know that Mrs. Howells is in New York, has been there a week.3  With love from all    Yours Nelly.  ", "dateText": "", "percents": [], "taggedText": [[[["Sat", "NNP"]], [".", "."]], [["Nov.", "NNP"], ["21st", "CD"], ["400", "CD"], ["L", "NNP"], ["Street", "NNP"], ["Dear", "NNP"], ["Walt", "NNP"], [",", ","], [["Many", "NNP"]], ["thanks", "NNS"], ["for", "IN"], ["your", "PRP$"], ["long", "JJ"], ["good", "NN"], ["letter", "NN"], [",", ","], ["which", "WDT"], ["I", "PRP"], ["am", "VBP"], ["not", "RB"], ["going", "VBG"], ["now", "RB"], ["to", "TO"], ["answer", "VB"], [".", "."]], [["I", "PRP"], ["write", "VBP"], ["at", "IN"], ["the", "DT"], ["request", "NN"], ["of", "IN"], [["Charlie", "NNP"], ["Eldridge", "NNP"]], ["who", "WP"], ["said", "VBD"], ["that", "IN"], ["he", "PRP"], ["should", "MD"], ["be", "VB"], ["too", "RB"], ["busy", "JJ"], ["to-day", "NN"], ["to", "TO"], ["do", "VB"], ["so", "RB"], [",", ","], ["to", "TO"], ["tell", "VB"], ["you", "PRP"], ["that", "IN"], ["he", "PRP"], ["and", "CC"], ["Mrs.", "NNP"], ["Cooper", "NNP"], ["are", "VBP"], ["to", "TO"], ["leave", "VB"], ["here", "RB"], ["either", "DT"], ["in", "IN"], ["the", "DT"], ["8", "CD"], ["A.M.", "NNP"], ["or", "CC"], ["the", "DT"], ["11", "CD"], ["A.M.", "NNP"], ["train", "NN"], ["on", "IN"], ["Monday", "NNP"], ["next", "JJ"], [",", ","], ["for", "IN"], [["Philadelphia", "NNP"]], [",", ","], ["and", "CC"], ["he", "PRP"], ["is", "VBZ"], ["to", "TO"], ["remain", "VB"], ["at",