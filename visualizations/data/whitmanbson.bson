"original", ",", "of", "marked", "beauty", "&", "value", ",", "by", "Jesse", "Talbot", ",", "illustrating", "a", "scene", "from", "Pilgrim", "'s", "Progress", ",", "worth", "from", "four", "to", "five", "hundred", "dollars.", "This", "I", "put", ",", "if", "I", "remember", "right", ",", "at", "one", "hundred", "dollars.", "I", "presume", "Mr.", "Dyer", "or", "Mr.", "Parton", "has", "it", "yet.", "The", "enclosed", "receipt", ",", "marked", "1", ",", "was", ",", "on", "turning", "over", "the", "goods", ",", "written", "by", "me", "&", "signed", ",", "by", "Mr.", "Dyer", ",", "who", "then", "remarked", "that", "he", "would", "also", "give", "me", "one", "in", "more", "technical", "form", ",", "and", "wrote", ",", "signed", ",", "&", "handed", "me", "the", "receipt", "marked", "2", "I", "presume", ",", "(", "but", "do", "not", "know", "for", "certain", ",", ")", "that", "Mr.", "Dyer", "considers", "the", "debt", "fully", "paid.", "(", "The", "balance", "of", "thirty", "five", "dollars", "mentioned", ",", "besides", "the", "one", "hundred", "&", "eighty", "one", "includes", "sixteen", "dollars", "as", "Mr.", "Dyer", "'s", "fee", ",", "or", "more", "probably", "costs", "of", "suit", ",", "over", "&", "above", "the", "original", "two", "hundred.", ")", "Walt", "Whitman"], "date": [], "normalizedTime": "0.484020127839", "recipient": "William D.", "organizations": ["Progress"], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/loc.01689.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to William D. O'Connor ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Francis", "NNP"], ["P.", "NNP"], ["Church", "NNP"]], ["and", "CC"], [["William", "NNP"], ["C.", "NNP"], ["Church", "NNP"]], [",", ","]]], "people": ["Church", "Dear Sirs", "George Peabody", "Walt", "Whitman"], "money": [], "year": "1869", "locations": [], "month": "Nov", "parties": ["Walt", "Whitman", "Francis P. Church", "William C. Church"], "properDate": "Nov 15, 1869", "gpe": ["Washington", "Please", "Direct"], "facility": [], "latlngs": [[38.8951118, -77.0363658]], "text": "  Attorney General's Office,                     Washington,                     Nov. 15, 1869.                                  Messrs Church,                 Dear Sirs:                               I write a line with reference to my piece \"Brother of All with generous hand,\"                  (commemorative of George Peabody,) handed to W. C. Church here three or four days since. I suppose it ought to appear, if at all, in the January Number.              Please send me proof forthwith. Direct to me this office.               Walt Whitman              ", "dateText": "", "percents": [], "taggedText": [[["Attorney", "NNP"], ["General", "NNP"], ["'s", "POS"], ["Office", "NNP"], [",", ","], [["Washington", "NNP"]], [",", ","], ["Nov.", "NNP"], ["15", "CD"], [",", ","], ["1869", "CD"], [".", "."]], [["Messrs", "NNS"], [["Church", "NNP"]], [",", ","], [["Dear", "NNP"], ["Sirs", "NNP"]], [":", ":"], ["I", "PRP"], ["write", "VBP"], ["a", "DT"], ["line", "NN"], ["with", "IN"], ["reference", "NN"], ["to", "TO"], ["my", "PRP$"], ["piece", "NN"], ["``", "``"], ["Brother", "NNP"], ["of", "IN"], ["All", "NNP"], ["with", "IN"], ["generous", "JJ"], ["hand", "NN"], [",", ","], ["''", "''"], ["(", ":"], ["commemorative", "JJ"], ["of", "IN"], [["George", "NNP"], ["Peabody", "NNP"]], [",", ","], [")", "NNP"], ["handed", "VBD"], ["to", "TO"], ["W.", "NNP"], ["C.", "NNP"], ["Church", "NNP"], ["here", "RB"], ["three", "CD"], ["or", "CC"], ["four", "CD"], ["days", "NNS"], ["since", "IN"], [".", "."]], [["I", "PRP"], ["suppose", "VBP"], ["it", "PRP"], ["ought", "MD"], ["to", "TO"], ["appear", "VB"], [",", ","], ["if", "IN"], ["at", "IN"], ["all", "DT"], [",", ","], ["in", "IN"], ["the", "DT"], ["January", "NNP"], ["Number", "NNP"], [".", "."]], [[["Please", "NN"]], ["send", "VBP"], ["me", "PRP"], ["proof", "IN"], ["forthwith", "NN"], [".", "."]], [[["Direct", "JJ"]], ["to", "TO"], ["me", "PRP"], ["this", "DT"], ["office", "NN"], [".", "."]], [[["Walt", "NNP"]], [["Whitman", "NNP"]]]], "sentences": ["  Attorney General's Office,                     Washington,                     Nov. 15, 1869.", "Messrs Church,                 Dear Sirs:                               I write a line with reference to my piece \"Brother of All with generous hand,\"                  (commemorative of George Peabody,) handed to W. C. Church here three or four days since.", "I suppose it ought to appear, if at all, in the January Number.", "Please send me proof forthwith.", "Direct to me this office.", "Walt Whitman              "], "words": ["Attorney", "General", "'s", "Office", ",", "Washington", ",", "Nov.", "15", ",", "1869.", "Messrs", "Church", ",", "Dear", "Sirs", ":", "I", "write", "a", "line", "with", "reference", "to", "my", "piece", "``", "Brother", "of", "All", "with", "generous", "hand", ",", "''", "(", "commemorative", "of", "George", "Peabody", ",", ")", "handed", "to", "W.", "C.", "Church", "here", "three", "or", "four", "days", "since.", "I", "suppose", "it", "ought", "to", "appear", ",", "if", "at", "all", ",", "in", "the", "January", "Number.", "Please", "send", "me", "proof", "forthwith.", "Direct", "to", "me", "this", "office.", "Walt", "Whitman"], "date": [], "normalizedTime": "0.490548075615", "recipient": "William C. Church", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/prc.00024.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Francis P. Church and William C. Church ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["William", "NNP"], ["M.", "NNP"], ["Rossetti", "NNP"]], [",", ","]]], "people": ["Dear", "Mr. Rossetti", "William O'Connor", "Mr. O'Connor", "Moncure Conway", "Walt", "Whitman"], "money": [], "year": "1869", "locations": [], "month": "Dec", "parties": ["Walt", "Whitman", "William M. Rossetti"], "properDate": "Dec 9, 1869", "gpe": ["Washington", "England", "Science"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [52.3555177, -1.1743197]], "text": "  Washington,                     December 9, 1869.                                  Dear Mr. Rossetti,              Your letter of last summer to William O'Connor with the passages transcribed from a lady's correspondence have been shown                 me by him, and a copy lately furnished me, which I have just been re-reading. I am                 deeply touched by these sympathies & convictions coming from a woman, & from                 England, & am sure that if the lady knew how much comfort it has been to me to                 get them, she would not only pardon you for transmitting them to Mr. O'Connor, but                 approve that action. I realize indeed of such an                 emphatic & smiling Well done from the heart &                 conscience of a true wife & mother, & one too whose sense of the poetic, as                 I glean from your letter, after flowing through the heart & conscience, also                 comes through & must satisfy Science, as much as the esthetic, that I had                 hitherto received no eulogium so magnificent.              I send by same mail with this, same address as this letter, two photographs, taken                 within a few months. One is intended for the lady (if I may be permitted to send it                 her)   and will you please accept the other with my respects & love? The                 picture is by some criticized very severely indeed, but I hope you will not dislike                 it, for I confess myself to a (perhaps capricious) fondness for it as my own                 portrait over some scores that have been made or taken at one time or another. I am still at work in the Attorney General's office. My p. o. address remains the                 same, here. I am, & have been, quite well & hearty. My new editions,                 considerably expanded, with what suggestions &c. I have to offer, presented, I                 hope, in more definite, graphic form, will probably get printed, the coming spring.                 I shall forward you early copies. I send my love to Moncure Conway, if you see him. I wish he would                 write to me, soon & fully. If the pictures don't reach you, or if they get                 injured on the way, I will try again by express. I wish you to read or loan this                 letter to the lady   or, if she wishes it, give it to her to keep.  Walt Whitman              ", "dateText": "", "percents": [], "taggedText": [[[["Washington", "NNP"]], [",", ","], ["December", "NNP"], ["9", "CD"], [",", ","], ["1869", "CD"], [".", "."]], [[["Dear", "NNP"]], [["Mr.", "NNP"], ["Rossetti", "NNP"]], [",", ","], ["Your", "NNP"], ["letter", "NN"], ["of", "IN"], ["last", "JJ"], ["summer", "NN"], ["to", "TO"], [["William", "NNP"], ["O'Connor", "NNP"]], ["with", "IN"], ["the", "DT"], ["passages", "NNS"], ["transcribed", "VBD"], ["from", "IN"], ["a", "DT"], ["lady", "NN"], ["'s", "POS"], ["correspondence", "NN"], ["have", "VBP"], ["been", "VBN"], ["shown", "VBN"], ["me", "PRP"], ["by", "IN"], ["him", "PRP"], [",", ","], ["and", "CC"], ["a", "DT"], ["copy", "NN"], ["lately", "RB"], ["furnished", "VBD"], ["me", "PRP"], [",", ","], ["which", "WDT"], ["I", "PRP"], ["have", "VBP"], ["just", "RB"], ["been", "VBN"], ["re-reading", "JJ"], [".", "."]], [["I", "PRP"], ["am", "VBP"], ["deeply", "RB"], ["touched", "VBN"], ["by", "IN"], ["these", "DT"], ["sympathies", "NNS"], ["&", "CC"], ["convictions", "NNS"], ["coming", "VBG"], ["from", "IN"], ["a", "DT"], ["woman", "NN"], [",", ","], ["&", "CC"], ["from", "IN"], [["England", "NNP"]], [",", ","], ["&", "CC"], ["am", "VBP"], ["sure", "JJ"], ["that", "IN"], ["if", "IN"], ["the", "DT"], ["lady", "NN"]