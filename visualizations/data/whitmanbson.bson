ivulets", "NNS"], ["Ca", "NNP"], ["n't", "RB"], ["you", "PRP"], ["have", "VB"], ["the", "DT"], ["pictures", "NNS"], ["properly", "RB"], ["pasted", "VBN"], ["on", "IN"], ["the", "DT"], ["frontispieces", "NNS"], ["prepared", "VBN"], ["for", "IN"], ["them", "PRP"], ["(", ":"], ["see", "VBP"], ["front", "JJ"], ["of", "IN"], ["the", "DT"], ["vols", "NNS"], [")", ":"], ["&", "CC"], ["send", "NN"], ["them", "PRP"], ["over", "IN"], ["again", "RB"], ["by", "IN"], ["this", "DT"], ["boy", "NN"], [",", ","], ["&", "CC"], ["I", "PRP"], ["will", "MD"], ["put", "VB"], ["my", "PRP$"], ["autograph", "NN"], ["on", "IN"], ["them", "PRP"], [["Walt", "NNP"], ["Whitman", "NNP"]]]], "sentences": ["  Camden           Sept 23                            I send over two copies of Two Rivulets   Can't you have the pictures properly pasted on the frontispieces          prepared for them (see front of the vols)   & send them over again by this boy,          & I will put my autograph on them     Walt Whitman        "], "words": ["Camden", "Sept", "23", "I", "send", "over", "two", "copies", "of", "Two", "Rivulets", "Ca", "n't", "you", "have", "the", "pictures", "properly", "pasted", "on", "the", "frontispieces", "prepared", "for", "them", "(", "see", "front", "of", "the", "vols", ")", "&", "send", "them", "over", "again", "by", "this", "boy", ",", "&", "I", "will", "put", "my", "autograph", "on", "them", "Walt", "Whitman"], "date": [], "normalizedTime": "0.831089351285", "recipient": "", "organizations": [], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/loc.02842.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to an Unidentified Printer ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Damon", "NNP"], ["Y.", "NNP"], ["Kilgore", "NNP"]], [",", ","]]], "people": ["Camden New Jersey", "Paine", "Walt Whitman", "Kilgore", "Charley"], "money": [], "year": "1876", "locations": [], "month": "Sep", "parties": ["Walt", "Whitman", "Damon Y. Kilgore"], "properDate": "Sep 24, 1876", "gpe": ["Stevens", "Paine"], "facility": [], "latlngs": [], "text": "  431 Stevens street Camden New Jersey            Sept 24                    D Y Kilgore           Dear Sir        Send me word immediately when (day & hour) & where          the Paine bust affair is to come off. I see an announcement          in the paper that I am to read a poem on the occasion. I do not propose to read a poem   but I will promise          to be there, & speak just a little (say 10 minutes)   if I can be put on the early part of the program          (as waiting fags me out entirely)   & perhaps it would be necessary that I should be sent for in a carriage.          I would advise that you have some good music, & no long-winded address at all. (Couldn't you get some          good baritone singer to sing Paine's fine lively old song of \"the Liberty Tree\"?)         Walt Whitman        best respects to Mrs Kilgore   love to Charley    ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"]], ["street", "NN"], [["Camden", "NNP"], ["New", "NNP"], ["Jersey", "NNP"]], ["Sept", "NNP"], ["24", "CD"], [["D", "NNP"]], ["Y", "NNP"], ["Kilgore", "NNP"], ["Dear", "NNP"], ["Sir", "NNP"], ["Send", "NNP"], ["me", "PRP"], ["word", "VBD"], ["immediately", "RB"], ["when", "WRB"], ["(", ":"], ["day", "NN"], ["&", "CC"], ["hour", "PRP$"], [")", "NN"], ["&", "CC"], ["where", "WRB"], ["the", "DT"], [["Paine", "NNP"]], ["bust", "NN"], ["affair", "NN"], ["is", "VBZ"], ["to", "TO"], ["come", "VB"], ["off", "RP"], [".", "."]], [["I", "PRP"], ["see", "VBP"], ["an", "DT"], ["announcement", "NN"], ["in", "IN"], ["the", "DT"], ["paper", "NN"], ["that", "IN"], ["I", "PRP"], ["am", "VBP"], ["to", "TO"], ["read", "VB"], ["a", "DT"], ["poem", "NN"], ["on", "IN"], ["the", "DT"], ["occasion", "NN"], [".", "."]], [["I", "PRP"], ["do", "VBP"], ["not", "RB"], ["propose", "VB"