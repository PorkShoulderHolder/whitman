LS"], ["'s", "POS"], ["book", "NN"], ["has", "VBZ"], ["[", ":"], ["made", "VBN"], ["?", "."]], [["]", "NN"], ["me", "PRP"], ["very", "RB"], ["great", "JJ"], ["pleasure", "NN"], [",", ","], ["the", "DT"], ["article", "NN"], ["of", "IN"], ["the", "DT"], [["English", "NNP"]], ["lady", "NN"], ["in", "IN"], ["``", "``"], ["The", "DT"], [["Radical", "NNP"]], ["''", "''"], ["also", "RB"], [".", "."]], [["Your", "PRP$"], ["``", "``"], [["Democratic", "JJ"]], ["vistas", "NNS"], ["''", "''"], ["I", "PRP"], ["have", "VBP"], ["yet", "RB"], ["not", "RB"], ["read", "VB"], ["completely", "RB"], [".", "."]], [["What", "WP"], ["I", "PRP"], ["have", "VBP"], ["read", "VBN"], ["has", "VBZ"], ["astonished", "VBN"], ["and", "CC"], ["delighted", "VBN"], ["me", "PRP"], [".", "."]], [["There", "EX"], ["are", "VBP"], ["words", "NNS"], ["of", "IN"], ["a", "DT"], ["genius", "NN"], ["superior", "NN"], ["to", "TO"], ["all", "DT"], ["the", "DT"], ["political", "JJ"], ["and", "CC"], ["literary", "JJ"], ["nonentities", "NNS"], ["of", "IN"], ["the", "DT"], ["day", "NN"], ["and", "CC"], ["worthy", "JJ"], ["the", "DT"], ["great", "JJ"], ["horizons", "NNS"], ["of", "IN"], ["your", "PRP$"], ["proud", "NN"], ["country", "NN"], [",", ","], ["from", "IN"], ["which", "WDT"], ["nevertheless", "NN"], ["the", "DT"], ["names", "NNS"], ["of", "IN"], ["[", "NNP"], ["radi", "NN"], ["?", "."]], [["]", "NN"], ["cals", "NNS"], ["as", "IN"], [["James", "NNP"], ["Fisk", "NNP"]], ["have", "VBP"], ["hithe", "DT"], ["[", "NNP"], ["rto", "NN"], ["?", "."]], [["]", "NN"], ["been", "VBN"], ["the", "DT"], ["most", "RBS"], ["resounding", "VBG"], [".", "."]], [["I", "PRP"], ["read", "VBP"], ["yesterday", "NN"], ["some", "DT"], ["part", "NN"], ["of", "IN"], ["``", "``"], ["Democratical", "JJ"], ["Vistas", "NNP"], ["''", "''"], ["to", "TO"], ["the", "DT"], [["Professor", "NNP"], ["Rasmus", "NNP"], ["Nielsen", "NNP"]], [",", ","], ["one", "CD"], ["great", "JJ"], [["Scandinavian", "JJ"]], ["philosopher", "NN"], ["and", "CC"], ["acc