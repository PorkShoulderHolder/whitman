Mar", "parties": ["Walt", "Whitman", "William Michael Rossetti"], "properDate": "Mar 31, 1876", "gpe": ["Camden"], "facility": [], "latlngs": [[51.55170589999999, -0.1588255]], "text": "  431 Stevens st. cor West. Camden, N. Jersey, U S America            March 31, '76                             My dear friend,        (Later than my letter dispatched last evening I wish merely to say) make cheques, orders or drafts payable          by Brown brothers, bankers, Philadelphia, U. S. A., corner Chestnut and Strawberry streets,          on my endorsement.         Walt Whitman        I am feeling quite comfortable to-day   I wish this information   the address above   conveyed to Robert Buchanan    ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"]], ["cor", "NN"], [["West", "NNP"]], [".", "."]], [[["Camden", "NNP"]], [",", ","], ["N.", "NNP"], ["Jersey", "NNP"], [",", ","], [["U", "NNP"]], ["S", "NNP"], [["America", "NNP"]], ["March", "NNP"], ["31", "CD"], [",", ","], ["'76", "-NONE-"], ["My", "NNP"], ["dear", "NN"], ["friend", "NN"], [",", ","], ["(", ":"], ["Later", "JJ"], ["than", "IN"], ["my", "PRP$"], ["letter", "NN"], ["dispatched", "VBD"], ["last", "JJ"], ["evening", "NN"], ["I", "PRP"], ["wish", "VBP"], ["merely", "RB"], ["to", "TO"], ["say", "VB"], [")", ":"], ["make", "VB"], ["cheques", "NNS"], [",", ","], ["orders", "NNS"], ["or", "CC"], ["drafts", "NNS"], ["payable", "JJ"], ["by", "IN"], [["Brown", "NNP"]], ["brothers", "NNS"], [",", ","], ["bankers", "NNS"], [",", ","], [["Philadelphia", "NNP"]], [",", ","], ["U.", "NNP"], ["S.", "NNP"], ["A.", "NNP"], [",", ","], ["corner", "NN"], [["Chestnut", "NNP"]], ["and", "CC"], [["Strawberry", "NNP"]], ["streets", "NNS"], [",", ","], ["on", "IN"], ["my", "PRP$"], ["endorsement", "NN"], [".", "."]], [[["Walt", "NNP"]], [["Whitman", "NNP"]], ["I", "NNP"], ["am", "VBP"], ["feeling", "VBG"], ["quite", "RB"], ["comfortable", "JJ"], ["to-day", "NN"], ["I", "PRP"], ["wish",