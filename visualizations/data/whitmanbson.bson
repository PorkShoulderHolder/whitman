"."]], [["]", "NN"], ["name", "VBD"], ["mentioned", "VBN"], [".", "."]], [["is", "VBZ"], ["[", "``"], ["illegible", "JJ"], ["]", "NN"], ["thats", "NNS"], ["wounded", "VBD"], [",", ","], ["the", "DT"], ["one", "CD"], ["that", "WDT"], [["Mother", "NNP"]], ["speaks", "VBZ"], ["of", "IN"], ["in", "IN"], ["her", "PRP$"], ["letters", "NNS"], [".", "."]], [["I", "PRP"], ["mean", "VBP"], ["is", "VBZ"], ["he", "PRP"], ["a", "DT"], ["friend", "NN"], ["of", "IN"], ["brother", "NN"], [["George", "NNP"]], ["'s", "POS"], [".", "."]], [["I", "PRP"], ["do", "VBP"], ["hope", "NN"], ["we", "PRP"], ["will", "MD"], ["hear", "VB"], ["from", "IN"], [["George", "NNP"]], [",", ","], ["I", "PRP"], ["wish", "VBP"], [["Mother", "NNP"]], ["would", "MD"], ["write", "VB"], ["s", "NNS"], ["its", "PRP$"], ["very", "JJ"], ["long", "JJ"], ["since", "IN"], ["she", "PRP"], ["has", "VBZ"], ["written", "VBN"], [".", "."]], [["I", "PRP"], ["hope", "VBP"], ["she", "PRP"], ["is", "VBZ"], ["well", "RB"], ["of", "IN"], ["rheumatism", "NN"], [".", "."]], [[["Write", "NNP"]], ["soon", "RB"], ["Walt", "NNP"], [".", "."]], [["I", "PRP"], ["try", "VBP"], ["to", "TO"], ["not", "RB"], ["be", "VB"], ["anxious", "JJ"], ["about", "IN"], [["Georg", "NNP"]], ["but", "CC"], ["I", "PRP"], ["am", "VBP"], [["Good", "NNP"]], ["bye", "NN"], [["Han", "NNP"]], ["tell", "NN"], ["Mother", "NNP"], ["I", "PRP"], ["am", "VBP"], ["better", "RBR"], ["and", "CC"], ["want", "VB"], ["to", "TO"], ["come", "VB"], ["home", "NN"], ["and", "CC"], ["see", "VB"], ["you", "PRP"], ["all", "DT"], ["more", "RBR"], ["than", "IN"], ["ever", "RB"], [",", ","], ["give", "VBP"], ["my", "PRP$"], ["love", "NN"], ["to", "TO"], ["all", "DT"], ["I", "PRP"], ["hope", "VBP"], [["Eddy", "NNP"]], ["is", "VBZ"], ["better", "JJR"]]], "sentences": ["  Monday afternoon Oct 17  Dear brother Walt Wont you write soon as you get this I want to know how Mother is, & what you think about George.", "dont you think he will be exchanged soon.", "do they fare hard do you think.", "you must know more than I do about it.", "can we hear can he write from there Major Wright writes from Petersburg.", "Oct 2. makes me think perhaps brother George has written or can write Write to me will you Walt I always feel better to hear from home.", "I shall be anxious till you write I sent this morning to the P.O.", "I thought I should hear.", "I have been spared ever since that battle but I had a hope he was safe, because he always had been What will we do if we cant hear from him.", "I was glad the paper spoke of his being well I hope we will hear from him soon.", "you must certainly send it to me too if you get a line from him.", "I wish Walt I could see dear Mother and you all I hope Mother is well.", "I want you to write Walt perhaps you will tell me prisoners of war are not badly used.", "one cant judge by the papers I see George is the only [Capt?", "] name mentioned.", "is [illegible] thats wounded, the one that Mother speaks of in her letters.", "I mean is he a friend of brother George's.", "I do hope we will hear from George, I wish Mother would write s its very long since she has written.", "I hope she is well of rheumatism.", "Write soon Walt.", "I try to not be anxious about Georg but I am  Good bye Han  tell Mother I am better and want to come home and see you all more than ever, give my love to all I hope Eddy is better  "], "words": ["Monday", "afternoon", "Oct", "17", "Dear", "brother", "Walt", "Wont", "you", "write", "soon", "as", "you", "get", "this", "I", "want", "to", "know", "how", "Mother", "is", ",", "&", "what", "you", "think", "about", "George.", "dont", "you", "think", "he", "will", "be", "exchanged", "soon.", "do", "they", "fare", "hard", "do", "you", "think.", "you", "must", "know", "more", "than", "I", "do", "about", "it.", "can", "we", "hear", "can", "he", "write", "from", "there", "Major", "Wright", "writes", "from", "Petersburg.", "Oct", "2.", "makes", "me", "think", "perhaps", "brother", "George", "has", "written", "or"