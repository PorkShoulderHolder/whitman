u", "PRP"], ["should", "MD"], ["like", "VB"], ["to", "TO"], ["have", "VB"], ["you", "PRP"], ["defer", "VBP"], ["your", "PRP$"], ["visit", "NN"], ["until", "IN"], ["then", "RB"], [".", "."]], [["The", "DT"], ["form", "NN"], ["and", "CC"], ["style", "NN"], ["of", "IN"], ["the", "DT"], [["Poems", "NNP"]], ["is", "VBZ"], ["a", "DT"], ["matter", "NN"], ["only", "RB"], ["to", "TO"], ["be", "VB"], ["decided", "VBN"], ["on", "IN"], ["after", "IN"], ["a", "DT"], ["free", "JJ"], ["and", "CC"], ["full", "JJ"], ["personal", "JJ"], ["conference", "NN"], [",", ","], ["discussing", "VBG"], ["the", "DT"], ["whole", "JJ"], ["thing", "NN"], ["thoroughly", "RB"], [["Yours", "NNP"], ["Truly", "NNP"], ["Thayer", "NNP"]], ["&", "CC"], ["Eldridge", "NNP"]]], "sentences": ["  Boston March 2, 1860 Walt Whitman  Dear Sir, Your favor is at hand.", "Our Mr. Thayer will be in New York tomorrow and call on you either Saturday or Sunday.", "He will stop at the Astor.", "We think favorably of the propositions in your letters, but owing to a press of other business next week we should not be able to give that personal attention to the matter which we should desire, and we have one or two other works in the stereotypes hands, which can be finished next week and which we should like to have out of the way before commencing on anything new.", "We can make our arrangement, so that we shall be comparatively untrammeled week after next, and if agreeable to you should like to have you defer your visit until then.", "The form and style of the Poems is a matter only to be decided on after a free and full personal conference, discussing the whole thing thoroughly   Yours Truly  Thayer & Eldridge  "], "words": ["Boston", "March", "2", ",", "1860", "Walt", "Whitman", "Dear", "Sir", ",", "Your", "favor", "is", "at", "hand.", "Our", "Mr.", "Thayer", "will", "be", "in", "New", "York", "tomorrow", "and", "call", "on", "you", "either", "Saturday", "or", "Sunday.", "He", "will", "stop", "at", "the", "Astor.", "We", "think", "favorably", "of", "the", "propositions", "in", "your", "letters", ",", "but", "owing", "to", "a", "press", "of", "other", "business", "next", "week", "we", "should", "not", "be", "able", "to", "give", "that", "personal", "attention", "to", "the", "matter", "which", "we", "should", "desire", ",", "and", "we", "have", "one", "or", "two", "other", "works", "in", "the", "stereotypes", "hands", ",", "which", "can", "be", "finished", "next", "week", "and", "which", "we", "should", "like", "to", "have", "out", "of", "the", "way", "before", "commencing", "on", "anything", "new.", "We", "can", "make", "our", "arrangement", ",", "so", "that", "we", "shall", "be", "comparatively", "untrammeled", "week", "after", "next", ",", "and", "if", "agreeable", "to", "you", "should", "like", "to", "have", "you", "defer", "your", "visit", "until", "then.", "The", "form", "and", "style", "of", "the", "Poems", "is", "a", "matter", "only", "to", "be", "decided", "on", "after", "a", "free", "and", "full", "personal", "conference", ",", "discussing", "the", "whole", "thing", "thoroughly", "Yours", "Truly", "Thayer", "&", "Eldridge"], "date": [], "normalizedTime": "0.00843193254454", "recipient": "Walt Whitman", "organizations": ["Poems"], "sender": "Thayer", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00562.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Thayer & Eldridge to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], ["the", "DT"], ["Editor", "NNP"], ["of", "IN"], ["the", "DT"], [["Atlantic", "NNP"], ["Monthly", "NNP"]], [",", ","]]], "people": ["Mr. Lowell2", "Walt", "Myrtle", "Mr. L."], "money": [], "year": "1860", "locations": [], "month": "Mar", "parties": ["Walt Whitman", "Atlantic Monthly"], "properDate": "Mar 2, 1860", "gpe": ["Brooklyn"], "facility": [], "latlngs": [[40.65, -73.95]], "text": "  Friday morning, March 2, '60. Your \"Atlantic\" has, either in type or MS. an article of mine, sent on by E. H. House1, and accepted by Mr. Lowell2   price $40. In lieu of that sum when the piece is printed, could you enclose me $30 immediately on receiving this, and send by mail   considering this a receipt in full? Walt WhitmanPortland av. next to Myrtle | Brooklyn, N. Y. You will first inquire of Mr. L. about the article, lest I am entertaining some misunderstanding about it.3 ", "dateText": "", "percents": [], "taggedText": [[["Friday", "NNP"], ["morning", "NN"], [",", ","], ["March", "NNP"], ["2", "CD"], [",", ","], ["'60", "-NONE-"], [".", "."]], [["Your", "PRP$"], ["``", "``"], ["Atlantic", "NNP"], ["''", "''"], ["has", "VBZ"], [",", ","], ["either", "DT"], ["in", "IN"], ["type", "NN"], ["or", "CC"], ["MS.", "NNP"], ["an", "DT"], ["article", "NN"], ["of", "IN"], ["mine", "JJ"], [",", ","], ["sent", "NN"], ["on", "IN"], ["by", "IN"], ["E.", "NNP"], ["H.", "NNP"], [["House1", "NNP"]], [",", ","], ["and", "CC"], ["accepted", "VBD"], ["by", "IN"], [["Mr.", "NNP"], ["Lowell2", "NNP"]], ["price", "NN"], ["$", "$"], ["40", "CD"], [".", "."]], [["In", "IN"], ["lieu", "NN"], ["of", "IN"], ["that", "DT"], ["sum", "NN"], ["when", "WRB"], ["the", "DT"], ["piece", "NN"], ["is", "VBZ"], ["printed", "VBN"], [",", ","], ["could", "MD"], ["you", "PRP"], ["enclose", "VB"], ["me", "PRP"], ["$", "$"], ["30", "CD"], ["immediately", "RB"], ["on", "IN"], ["receiving", "VBG"], ["this", "DT"], [",", ","], ["and", "CC"], ["send", "VB"], ["by", "IN"], ["mail", "NN"], ["considering", "VBG"], ["this", "DT"], ["a", "DT"], ["receipt", "NN"], ["in", "IN"], ["full", "JJ"], ["?", "."]], [[["Walt", "NNP"]], [["WhitmanPortland", "NNP"]], ["av", "NN"], [".", "."]], [["next", "JJ"], ["to", "TO"], [["Myrtle", "NNP"]], ["|", "NNP"], [["Brooklyn", "NNP"]], [",", ","], ["N.", "NNP"], ["Y", "NNP"], [".", "."]], [["You", "PRP"], ["will", "MD"], ["first", "RB"], ["inquire", "VB"], ["of", "IN"], [["Mr.", "NNP"], ["L.", "NNP"]], ["about", "IN"], ["the", "DT"], ["article", "NN"], [",", ","], ["lest", "NN"], ["I", "PRP"], ["am", "VBP"], ["entertaining", "VBG"], ["some", "DT"], ["misunderstanding", "VBG"], ["about", "IN"], ["it.3", "-NONE-"]]], "sentences": ["  Friday morning, March 2, '60.", "Your \"Atlantic\" has, either in type or MS. an article of mine, sent on by E. H. House1, and accepted by Mr. Lowell2   price $40.", "In lieu of that sum when the piece is printed, could you enclose me $30 immediately on receiving this, and send by mail   considering this a receipt in full?", "Walt WhitmanPortland av.", "next to Myrtle | Brooklyn, N. Y.", "You will first inquire of Mr. L. about the article, lest I am entertaining some misunderstanding about it.3 "], "words": ["Friday", "morning", ",", "March", "2", ",", "'60.", "Your", "``", "Atlantic", "''", "has", ",", "either", "in", "type", "or", "MS.", "an", "article", "of", "mine", ",", "sent", "on", "by", "E.", "H.", "House1", ",", "and", "accepted", "by", "Mr.", "Lowell2", "price", "$", "40.", "In", "lieu", "of", "that", "sum", "when", "the", "piece", "is", "printed", ",", "could", "you", "enclose", "me", "$", "30", "immediately", "on", "receiving", "this", ",", "and", "send", "by", "mail", "considering", "this", "a", "receipt", "in", "full", "?", "Walt", "WhitmanPortland", "av.", "next", "to", "Myrtle", "|", "Brooklyn", ",", "N.", "Y.", "You", "will", "first", "inquire", "of", "Mr.", "L.", "about", "the", "article", ",", "lest", "I", "am", "entertaining", "some", "misunderstanding", "about", "it.3"], "date": [], "normalizedTime": "0.00843193254454", "recipient": "Atlantic Monthly", "organizations": ["House1", "WhitmanPortland"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/prc.00003.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to the Editor of the Atlantic Monthly ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Ticknor", "NNP"]], ["&", "CC"], [["Fields", "NNP"]], [",", ","], ["for", "IN"], ["The", "DT"], [["Atlantic", "NNP"], ["Monthly", "NNP"]], [",", ","], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["MR.", "Ticknor", "Fields"], "money": [], "year": "1860", "locations": [], "month": "Mar", "parties": ["Ticknor", "Fields", "Atlantic Monthly", "Walt Whitman"], "properDate": "Mar 6, 1860", "gpe": [], "facility": [], "latlngs": [], "text": "  OFFICE OF THE ATLANTIC MONTHLY BOSTON, March 6, 1860.  MR. WALT WHITMAN    Sir. We enclose our check for thirty dollars finding your note to be quite correct.  Yours truly, Ticknor & Fields  ", "dateText": "", "percents": [], "taggedText": [[["OFFICE", "NN"], ["OF", "IN"], [["THE", "DT"]], [["ATLANTIC", "NNP"]], ["MONTHLY", "NNP"], [["BOSTON", "NNP"]], [",", ","], ["March", "NNP"], ["6", "CD"], [",", ","], ["1860", "CD"], [".", "."]], [[["MR.", "NNP"]], [["WALT", "NNP"]], ["WHITMAN", "NNP"], ["Sir", "NNP"], [".", "."]], [["We", "PRP"], ["enclose", "VBP"], ["our", "PRP$"], ["check", "NN"], ["for", "IN"], ["thirty", "NN"], ["dollars", "NNS"], ["finding", "VBG"], ["your", "PRP$"], ["note", "NN"], ["to", "TO"], ["be", "VB"], ["quite", "RB"], ["correct", "JJ"], [".", "."]], [["Yours", "NNS"], ["truly", "RB"], [",", ","], [["Ticknor", "NNP"]], ["&", "CC"], [["Fields", "NNP"]]]], "sentences": ["  OFFICE OF THE ATLANTIC MONTHLY BOSTON, March 6, 1860.", "MR. WALT WHITMAN    Sir.", "We enclose our check for thirty dollars finding your note to be quite correct.", "Yours truly, Ticknor & Fields  "], "words": ["OFFICE", "OF", "THE", "ATLANTIC", "MONTHLY", "BOSTON", ",", "March", "6", ",", "1860.", "MR.", "WALT", "WHITMAN", "Sir.", "We", "enclose", "our", "check", "for", "thirty", "dollars", "finding", "your", "note", "to", "be", "quite", "correct.", "Yours", "truly", ",", "Ticknor", "&", "Fields"], "date": [], "normalizedTime": "0.00897592819257", "recipient": "Walt Whitman", "organizations": ["THE", "ATLANTIC", "BOSTON", "WALT"], "sender": "Atlantic Monthly", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/med.00319.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Ticknor & Fields , for The Atlantic Monthly , to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Thayer", "NNP"]], ["&", "CC"], ["Eldridge", "NNP"], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Mr. Thayer", "Yours Truly Thayer"], "money": [], "year": "1860", "locations": [], "month": "Mar", "parties": ["Thayer", "Walt Whitman"], "properDate": "Mar 7, 1860", "gpe": ["Boston", "Brooklyn", "NYork", "York"], "facility": [], "latlngs": [[42.3584308, -71.0597732], [40.65, -73.95], [53.96230079999999, -1.0818844]], "text": "  Boston March 7, 1860  Walt Whitman Brooklyn, N.Y. Dear Sir When we wrote you last week that our Mr. Thayer would be in NYork on Saturday and see you, he was in another section of Country and anticipated being in York without fail on the day we stated, on his way home, but circumstances have prevented his coming that way at all. We would therefore say that we will agree to give you the amount you wish per week for four or five weeks, and shall expect to see you at our place on Monday or Tuesday of next week, when we shall be able to attend to your work & put it through   Yours Truly  Thayer & Eldridge  ", "dateText": "", "percents": [], "taggedText": [[[["Boston", "NNP"]], ["March", "NNP"], ["7", "CD"], [",", ","], ["1860", "CD"], ["Walt", "NNP"], ["Whitman", "NNP"], [["Brooklyn", "NNP"]], [",", ","], ["N.Y.", "NNP"], ["Dear", "NNP"], ["Sir", "NNP"], ["When", "NNP"], ["we", "PRP"], ["wrote", "VBD"], ["you", "PRP"], ["last", "JJ"], ["week", "NN"], ["that", "IN"], ["our", "PRP$"], [["Mr.", "NNP"], ["Thayer", "NNP"]], ["would", "MD"], ["be", "VB"], ["in", "IN"], [["NYork", "NNP"]], ["on", "IN"], ["Saturday", "NNP"], ["and", "CC"], ["see", "VB"], ["you", "PRP"], [",", ",