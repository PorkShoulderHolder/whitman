IN"], ["his", "PRP$"], ["dangerous", "JJ"], ["post", "NN"], ["on", "IN"], ["the", "DT"], [["Baltimore", "NNP"]], ["&", "CC"], [["Potomac", "NNP"], ["RR", "NNP"]], ["I", "NNP"], ["miss", "NN"], ["him", "PRP"], ["much", "RB"], ["&", "CC"], ["I", "PRP"], ["miss", "VBP"], ["you", "PRP"], ["too", "RB"], [",", ","], [["Nelly", "NNP"]], ["I", "PRP"], ["am", "VBP"], ["very", "RB"], ["lonesome", "JJ"], ["here", "RB"], [",", ","], ["(", ":"], ["&", "CC"], ["yet", "RB"], ["I", "PRP"], ["keep", "VBP"], ["up", "RP"], ["very", "RB"], ["good", "JJ"], ["heart", "NN"], [")", ":"], ["If", "IN"], [["Charles", "NNP"], ["Eldridge", "NNP"]], ["is", "VBZ"], ["there", "RB"], [",", ","], ["I", "PRP"], ["send", "VBP"], ["him", "PRP"], ["my", "PRP$"], ["love", "NN"], [",", ","], ["&", "CC"], ["the", "DT"], ["same", "JJ"], ["to", "TO"], ["all", "DT"], ["to", "TO"], ["your", "PRP$"], ["daughter", "NN"], [["Jeannie", "NNP"]], [",", ","], ["(", "NNP"], ["whom", "WP"], ["you", "PRP"], ["do", "VBP"], ["not", "RB"], ["mention", "VB"], [")", ":"], ["&", "CC"], ["to", "TO"], ["your", "PRP$"], ["sister", "NN"], ["&", "CC"], ["the", "DT"], [["Doctor", "NNP"]], [",", ","], ["&", "CC"], ["all", "DT"], ["who", "WP"], ["in", "IN"], ["good", "JJ"], ["will", "NN"], ["enquire", "NN"], ["for", "IN"], ["me", "PRP"], ["It", "PRP"], ["is", "VBZ"], ["now", "RB"], ["between", "IN"], ["3", "CD"], ["and", "CC"], ["4", "CD"], ["Saturday", "NNP"], ["afternoon", "NN"], ["I", "PRP"], ["am", "VBP"], ["sitting", "VBG"], ["here", "RB"], ["in", "IN"], ["mother", "NN"], ["'s", "POS"], ["great", "JJ"], ["arm", "NN"], ["chair", "NN"], ["we", "PRP"], ["have", "VBP"], ["had", "VBN"], ["a", "DT"], ["hot", "JJ"], ["day", "NN"], ["but", "CC"], ["a", "DT"], ["breeze", "NN"], ["is", "VBZ"], ["springing", "VBG"], ["up", "RP"], ["it", "PRP"], ["is", "VBZ"], ["a", "DT"], ["shady", "JJ"], ["quiet", "NN"], ["spot", "NN"], ["here", "RB"], ["I", "PRP"], ["shall", "MD"], ["try", "VB"], ["to", "TO"], ["hobble", "VB"], ["out", "RP"], ["soon", "RB"], ["though", "IN"], ["I", "PRP"], ["am", "VBP"], ["quite", "RB"], ["feeble", "JJ"], [".", "."]], [[["Walt", "NNP"]], [".", "."]]], "sentences": ["  322 Stevens st. Camden, N.J.           Saturday after-noon, July 26.", "Dear friend,        Your welcome letter reached me to-day.", "Yours from Washington of over two weeks since,          also came safe.", "Since my letter of about three weeks since to Charles Eldridge   in which I wrote to you also   I have not improved any   the distress in my head          has not abated   some spells are very bad indeed   (but it fluctuates, some days,          or parts of days, leaving me comparatively comfortable.", ") Nor can I walk any better   some of the time, not so well   My saving points are pretty good nights' rest,          and a fair appetite, digestion, &c. Still I can see I am gradually being pulled,          and, though I have not at all given up hope of eventual recovery, I do not shut          my eyes to the other termination    I am very comfortable here, as I believe I told you, occupying mother's former rooms,          (a north & south one, second floor,) and with all her nice & homely furniture          & bed & chairs   & living day & night in her memory & atmosphere.", "We are having the hottest sort of weather here   in New York and Washington it must be terrible   but here I find I stand it quite well.", "I rec'd a note from John Burroughs telling me          of his flitting visit to Newport & call on you.", "I have been waiting till I felt stronger,          to go to Atlantic City (Jersey sea shore) or Long Island, but in my present condition          feel it best to stay here   (Nelly, I don't feel as well as when you          used to come there to White's)   I shall be glad indeed to have Charles Eldridge come here & see me   & it will be a real disappointment if he does not   but I count on his coming          without fail   I hope to get a letter from him soon.", "I still manage to get out a little, towards evening   not always, but nearly every day   get to the ferry boat, & sail to & fro across the Delaware, occasionally   I had seen in the newspapers of William's appointment, & was truly pleased   I hear from Peter Doyle quite regularly   he is well, & working at his dangerous post          on the Baltimore & Potomac RR   I miss him much   & I miss you too, Nelly   I am very lonesome here, (& yet I keep up very good heart)    If Charles Eldridge is there, I send him my love, & the same to all   to your daughter Jeannie, (whom you do not mention) & to your sister          & the Doctor, & all who in good will enquire for me   It is now between 3 and 4 Saturday afternoon   I am sitting here in mother's great arm chair   we have had a hot day   but a breeze is springing up   it is a shady quiet spot here   I shall try to hobble out soon though I am quite feeble.", "Walt.        "], "words": ["322", "Stevens", "st.", "Camden", ",", "N.J.", "Saturday", "after-noon", ",", "July", "26.", "Dear", "friend", ",", "Your", "welcome", "letter", "reached", "me", "to-day.", "Yours", "from", "Washington", "of", "over", "two", "weeks", "since", ",", "also", "came", "safe.", "Since", "my", "letter", "of", "about", "three", "weeks", "since", "to", "Charles", "Eldridge", "in", "which", "I", "wrote", "to", "you", "also", "I", "have", "not", "improved", "any", "the", "distress", "in", "my", "head", "has", "not", "abated", "some", "spells", "are", "very", "bad", "indeed", "(", "but", "it", "fluctuates", ",", "some", "days", ",", "or", "parts", "of", "days", ",", "leaving", "me", "comparatively", "comfortable.", ")", "Nor", "can", "I", "walk", "any", "better", "some", "of", "the", "time", ",", "not", "so", "well", "My", "saving", "points", "are", "pretty", "good", "nights", "'", "rest", ",", "and", "a", "fair", "appetite", ",", "digestion", ",", "&", "c.", "Still", "I", "can", "see", "I", "am", "gradually", "being", "pulled", ",", "and", ",", "though", "I", "have", "not", "at", "all", "given", "up", "hope", "of", "eventual", "recovery", ",", "I", "do", "not", "shut", "my", "eyes", "to", "the", "other", "termination", "I", "am", "very", "comfortable", "here", ",", "as", "I", "believe", "I", "told", "you", ",", "occupying", "mother", "'s", "former", "rooms", ",", "(", "a", "north", "&", "south", "one", ",", "second", "floor", ",", ")", "and", "with", "all", "her", "nice", "&", "homely", "furniture", "&", "bed", "&", "chairs", "&", "living", "day", "&", "night", "in", "her", "memory", "&", "atmosphere.", "We", "are", "having", "the", "hottest", "sort", "of", "weather", "here", "in", "New", "York", "and", "Washington", "it", "must", "be", "terrible", "but", "here", "I", "find", "I", "stand", "it", "quite", "well.", "I", "rec", "'d", "a", "note", "from", "John", "Burroughs", "telling", "me", "of", "his", "flitting", "visit", "to", "Newport", "&", "call", "on", "you.", "I", "have", "been", "waiting", "till", "I", "felt", "stronger", ",", "to", "go", "to", "Atlantic", "City", "(", "Jersey", "sea", "shore", ")", "or", "Long", "Island", ",", "but", "in", "my", "present", "condition", "feel", "it", "best", "to", "stay", "here", "(", "Nelly", ",", "I", "do", "n't", "feel", "as", "well", "as", "when", "you", "used", "to", "come", "there", "to", "White", "'s", ")", "I", "shall", "be", "glad", "indeed", "to", "have", "Charles", "Eldridge", "come", "here", "&", "see", "me", "&", "it", "will", "be", "a", "real", "disappointment", "if", "he", "does", "not", "but", "I", "count", "on", "his", "coming", "without", "fail", "I", "hope", "to", "get", "a", "letter", "from", "him", "soon.", "I", "still", "manage", "to", "get", "out", "a", "little", ",", "towards", "evening", "not", "always", ",", "but", "nearly", "every", "day", "get", "to", "the", "ferry", "boat", ",", "&", "sail", "to", "&", "fro", "across", "the", "Delaware", ",", "occasionally", "I", "had", "seen", "in", "the", "newspapers", "of", "William", "'s", "appointment", ",", "&", "was", "truly", "pleased", "I", "hear", "from", "Peter", "Doyle", "quite", "regularly", "he", "is", "well", ",", "&", "working", "at", "his", "dangerous", "post", "on", "the", "Baltimore", "&", "Potomac", "RR", "I", "miss", "him", "much", "&", "I", "miss", "you", "too", ",", "Nelly", "I", "am", "very", "lonesome", "here", ",", "(", "&", "yet", "I", "keep", "up", "very", "good", "heart", ")", "If", "Charles", "Eldridge", "is", "there", ",", "I", "send", "him", "my", "love", ",", "&", "the", "same", "to", "all", "to", "your", "daughter", "Jeannie", ",", "(", "whom", "you", "do", "not", "mention", ")", "&", "to", "your", "sister", "&", "the", "Doctor", ",", "&", "all", "who", "in", "good", "will", "enquire", "for", "me", "It", "is", "now", "between", "3", "and", "4", "Saturday", "afternoon", "I", "am", "sitting", "here", "in", "mother", "'s", "great", "arm", "chair", "we", "have", "had", "a", "hot", "day", "but", "a", "breeze", "is", "springing", "up", "it", "is", "a", "shady", "quiet", "spot", "here", "I", "shall", "try", "to", "hobble", "out", "soon", "though", "I", "am", "quite", "feeble.", "Walt", "."], "date": [], "normalizedTime": "0.674010607915", "recipient": "Ellen M.", "organizations": ["Newport", "Delaware", "Baltimore"], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/nyp.00320.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Ellen M. O'Connor ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["John", "NNP"], ["Burroughs", "NNP"]], [",", ","]]], "people": ["Smith", "John"], "money": [], "year": "1873", "locations": [], "month": "Sep", "parties": ["Walt", "Whitman", "John Burroughs"], "properDate": "Sep 2, 1873", "gpe": ["Brooklyn"], "facility": [], "latlngs": [[40.65, -73.95]], "text": "     \ufffdThere is his old Brooklyn partner  \ufffdwho is also a natural builder and carpenter          (practically and in effect) architect.   \ufffd My brother thinks (and I think so, too)          that if you have not committed yourself, you could not do better than to get Smith to plan and supervise and practically work with you  \ufffdan honest, conscientious,          old-fashioned man, a man of family  \ufffdyoungish-middle-aged   you would like him   I do     \ufffdIf you need him, & he will go, he is your man.        John, I think 'The Birds of the Poets' your best article, in many respects   it has a jaunty air, in a perfectly natural way   flits and hops and soars          and sings around in a birdish way itself   \ufffdI shall remain here for the present.        ", "dateText": "", "percents": [], "taggedText": [[["\ufffdThere", "JJ"], ["is", "VBZ"], ["his", "PRP$"], ["old", "JJ"], [["Brooklyn", "NNP"]], ["partner", "NN"], ["\ufffdwho", "-NONE-"], ["is", "VBZ"], ["also", "RB"], ["a", "DT"], ["natural", "JJ"], ["builder", "NN"], ["and", "CC"], ["carpenter", "NN"], ["(", ":"], ["practically", "RB"], ["and", "CC"], ["in", "IN"], ["effect", "NN"], [")", ":"], ["architect", "NN"], [".", "."]], [["\ufffd", "NN"], ["My", "PRP$"], ["brother", "NN"], ["thinks", "NNS"], ["(", ":"], ["and", "CC"], ["I", "PRP"], ["think", "VBP"], ["so", "RB"], [",", ","], ["too", "RB"], [")", ":"], ["that", "IN"], ["if", "IN"], ["you", "PRP"], ["have", "VBP"], ["not", "RB"], ["committed", "VBN"], ["yourself", "PRP"], [",", ","], ["you", "PRP"], ["could", "MD"], ["not", "RB"], ["do", "VB"], ["better", "RBR"], ["than", "IN"], ["to", "TO"], ["get", "VB"], [["Smith", "NNP"]], ["to", "TO"], ["plan", "NN"], ["and", "CC"], ["supervise", "VB"], ["and", "CC"], ["practically", "RB"], ["work", "VB"], ["with", "IN"], ["you", "PRP"], ["\ufffdan", "JJ"], ["honest", "NN"], [",", ","], ["conscientious", "JJ"], [",", ","], ["old-fashioned", "JJ"], ["man", "NN"], [",", ","], ["a", "DT"], ["man", "NN"], ["of", "IN"], ["family", "NN"], ["\ufffdyoungish-middle-aged", "JJ"], ["you", "PRP"], ["would", "MD"], ["like", "VB"], ["him", "PRP"], ["I", "PRP"], ["do"