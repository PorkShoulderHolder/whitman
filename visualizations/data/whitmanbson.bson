: " Walt Whitman to James T. Fields ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Samuel", "NNP"], ["W.", "NNP"], ["Thayer", "NNP"]], [",", ","]]], "people": ["Dear Sir"], "money": [], "year": "1868", "locations": [], "month": "Dec", "parties": ["Walt", "Whitman", "Samuel W. Thayer"], "properDate": "Dec 8, 1868", "gpe": ["Doctor"], "facility": [], "latlngs": [], "text": "  sent Dec 8, '68                                  Dr. Thayer,                 Dear Sir:              Won't you do me the very great favor to write me a few lines regarding the condition of my sister,                  Mrs. H. L. Heyde. I am sure, from what I hear, that it is mainly to your medical skill,                  and your kindness as a good man, that she got through her late illness.                  She seems by her letters to be left in an extremely nervous state.                  Doctor, please write me as fully as you think proper. Though we have never met personally,                  I have heard of you from my mother & sister. I must ask you to keep this letter,                  and the whole matter, strictly confidential, & mention it to no person. My sister in a late letter,                  wished me to write you & thank you for your great kindness to her.              ", "dateText": "", "percents": [], "taggedText": [[["sent", "NN"], ["Dec", "NNP"], ["8", "CD"], [",", ","], ["'68", "-NONE-"], ["Dr.", "NNP"], ["Thayer", "NNP"], [",", ","], [["Dear", "NNP"], ["Sir", "NNP"]], [":", ":"], ["Wo", "NNP"], ["n't", "RB"], ["you", "PRP"], ["do", "VBP"], ["me", "PRP"], ["the", "DT"], ["very", "RB"], ["great", "JJ"], ["favor", "NN"], ["to", "TO"], ["write", "VB"], ["me", "PRP"], ["a", "DT"], ["few", "JJ"], ["lines", "NNS"], ["regarding", "VBG"], ["the", "DT"], ["condition", "NN"], ["of", "IN"], ["my", "PRP$"], ["sister", "NN"], [",", ","], ["Mrs.", "NNP"], ["H.", "NNP"], ["L.", "NNP"], ["Heyde", "NNP"], [".", "."]], [["I", "PRP"], ["am", "VBP"], ["sure", "