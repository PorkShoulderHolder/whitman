C"], [["Thomas", "NNP"], ["Rome", "NNP"]], [",", ","]]], "people": ["Andrew", "Thom"], "money": [], "year": "1870", "locations": [], "month": "Mar", "parties": ["Walt", "Whitman", "Andrew Rome", "Thomas Rome"], "properDate": "Mar 15, 1870", "gpe": ["Washington", "Rome", "Dear", "India", "Walt"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [41.8929163, 12.4825199]], "text": "  Attorney General's Office, Washington. March 15, 1870.                  Andrew & Thom. Rome,                 Dear friends,              I suppose the MS. of \"Passage to India\" came safe, last week   to be put in type                 as requested   with p. o. order for $10   I write now merely to ask you                 to read the proof carefully by copy   correct carefully   & then send me two                     proofs   put it through as soon as convenient.  Walt.              I have a piece in next Galaxy   about three or four sticks full   about Spring   I wish                     you would just copy it in your paper & send me 10 copies    ", "dateText": "", "percents": [], "taggedText": [[["Attorney", "NNP"], ["General", "NNP"], ["'s", "POS"], ["Office", "NNP"], [",", ","], [["Washington", "NNP"]], [".", "."]], [["March", "NNP"], ["15", "CD"], [",", ","], ["1870", "CD"], [".", "."]], [[["Andrew", "NNP"]], ["&", "CC"], [["Thom", "NNP"]], [".", "."]], [[["Rome", "NNP"]], [",", ","], [["Dear", "NNP"]], ["friends", "NNS"], [",", ","], ["I", "PRP"], ["suppose", "VBP"], ["the", "DT"], ["MS.", "NNP"], ["of", "IN"], ["``", "``"], ["Passage", "NNP"], ["to", "TO"], [["India", "NNP"]], ["''", "''"], ["came", "VBD"], ["safe", "NN"], [",", ","], ["last", "JJ"], ["week", "NN"], ["to", "TO"], ["be", "VB"], ["put", "VBN"], ["in", "RP"], ["type", "NN"], ["as", "IN"], ["requested", "VBN"], ["with", "IN"], ["p.", "NNP"], ["o.", "NNP"], ["order", "NN"], ["for", "IN"], ["$", "$"], ["10", "CD"], ["I", "PRP"], ["write", "VBP"], ["now", "RB"], ["merely", "RB"], ["to", "TO"], ["ask", "VB"], ["you", "