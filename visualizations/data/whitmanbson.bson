ou", "also", ",", "my", "dear", "comrade", ",", "&", "tell", "me", "all", "about", "the", "boys", "&", "everything", ",", "all", "the", "little", "items", "are", "so", "good", "should", "Charles", "Russell", "visit", "New", "York", ",", "I", "wish", "you", "to", "say", "to", "him", "I", "send", "him", "my", "love", "I", "wish", "you", "the", "same", "to", "Perk", ",", "&", "to", "Kingsley2", "&", "Ben", "Knower", "So", "good", "bye", ",", "my", "comrade", ",", "till", "we", "meet", ",", "&", "God", "bless", "you", ",", "dear", "friend", "Walt", "address", "me", "care", "Major", "Hapgood", ",", "Paymaster", "U", "S", "A", ",", "cor", "15th", "&", "F", "Washington", "D", "C"], "date": [], "normalizedTime": "0.18278253774", "recipient": "Nathaniel Bloom", "organizations": ["Kingsley2", "F Washington"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/uro.00001.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to Nathaniel Bloom ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Mary", "NNP"], ["A.", "NNP"]], [["Babbitt", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Dear", "Sir", "Yours Respectfully"], "money": [], "year": "1863", "locations": [], "month": "Sep", "parties": ["Mary A.", "Babbitt", "Walt Whitman"], "properDate": "Sep 6, 1863", "gpe": ["Caleb"], "facility": [], "latlngs": [], "text": " Dear Sir I feel that as my brothers friend you have been neglecred but owing to sickness in the family having been away most of the time I have not had much spare time. Caleb is not quite as well as when I wrore you before. He can not sit up at all. He was very much pleased with your letter & he wishes me to tell you to keep writing if you do not hear from him first. for your letters do him more good than a great deal of medicine. He wants to know if you will be so kind as to ask Dr. Bliss2 what he must do to have his furlough extended if he should not be able to come back then. His head troubles him very much and I fear he will not be able to come back for a long time if ever through he will not own it. Hoping to hear from you again soon I will now close, Yours Respectfully ", "dateText": "", "percents": [], "taggedText": [[[["Dear", "NNP"]], [["Sir", "NNP"]], ["I", "NNP"], ["feel", "VBP"], ["that", "IN"], ["as", "IN"], ["my", "PRP$"], ["brothers", "NNS"], ["friend", "VBP"], ["you", "PRP"], ["have", "VBP"], ["been", "VBN"], ["neglecred", "VBN"], ["but", "CC"], ["owing", "VBG"], ["to", "TO"], ["sickness", "NN"], ["in", "IN"], ["the", "DT"], ["family", "NN"], ["having", "VBG"], ["been", "VBN"], ["away", "RB"], ["most", "RBS"], ["of", "IN"], ["the", "DT"], ["time", "NN"], ["I", "PRP"], ["have", "VBP"], ["not", "RB"], ["had", "VBN"], ["much", "RB"], ["spare", "VBP"], ["time", "NN"], [".", "."]], [[["Caleb", "NNP"]], ["is", "VBZ"], ["not", "RB"], ["quite", "RB"], ["as", "IN"], ["well", "RB"], ["as", "IN"], ["when", "WRB"], ["I", "PRP"], ["wrore", "VBP"], ["you", "PRP"], ["before", "IN"], [".", "."]], [["He", "PRP"], ["can", "MD"], ["not", "RB"], ["sit", "VB"], ["up", "RP"], ["at", "IN"], ["all", "DT"], [".", "."]], [["He", "PRP"], ["was", "VBD"], ["very", "RB"], ["much", "RB"], ["pleased", "VBN"], ["with", "IN"], ["your", "PRP$"], ["letter", "NN"], ["&", "CC"], ["he", "PRP"], ["wishes", "VBZ"], ["me", "PRP"], ["to", "TO"], ["tell", "VB"], ["you", "PRP"], ["to", "TO"], ["keep", "VB"], ["writing", "NN"], ["if", "IN"], ["you", "PRP"], ["do", "VBP"], ["not", "RB"], ["hear", "VB"], ["from", "IN"], ["him", "PRP"], ["first", "RB"], [".", "."]], [["for", "IN"], ["your", "PRP$"], ["letters", "NNS"], ["do", "VBP"], ["him", "PRP"], ["more", "JJR"], ["good", "JJ"], ["than", "IN"], ["a", "DT"], ["great", "JJ"], ["deal", "NN"], ["of", "IN"], ["medicine", "NN"], [".", "."]], [["He", "PRP"], ["wants", "VBZ"], ["to", "TO"], ["know", "VB"], ["if", "IN"], ["you", "PRP"], ["will", "MD"], ["be", "VB"], ["so", "RB"], ["kind", "IN"], ["as", "IN"], ["to", "TO"], ["ask", "VB"], ["Dr.", "NNP"], ["Bliss2", "NNP"], ["what", "WP"], ["he", "PRP"], ["must", "MD"], ["do", "VB"], ["to", "TO"], ["have", "VB"], ["his", "PRP$"], ["furlough", "JJ"], ["extended", "JJ"], ["if", "IN"], ["he", "PRP"], ["should", "MD"], ["not", "RB"], ["be", "VB"], ["able", "JJ"], ["to", "TO"], ["come", "VB"], ["back", "RB"], ["then", "RB"], [".", "."]], [["His", "PRP$"], ["head", "NN"], ["troubles", "NNS"], ["him", "PRP"], ["very", "RB"], ["much", "RB"], ["and", "CC"], ["I", "PRP"], ["fear", "VBP"], ["he", "PRP"], ["will", "MD"], ["not", "RB"], ["be", "VB"], ["able", "JJ"], ["to", "TO"], ["come", "VB"], ["back", "RB"], ["for", "IN"], ["a", "DT"], ["long", "JJ"], ["time", "NN"], ["if", "IN"], ["ever", "RB"], ["through", "IN"], ["he", "PRP"], ["will", "MD"], ["not", "RB"], ["own", "VB"], ["it", "PRP"], [".", "."]], [["Hoping", "VBG"], ["to", "TO"], ["hear", "VB"], ["from", "IN"], ["you", "PRP"], ["again", "RB"], ["soon", "RB"], ["I", "PRP"], ["will", "MD"], ["now", "RB"], ["close", "VB"], [",", ","], [["Yours", "NNP"], ["Respectfully", "NNP"]]]], "sentences": [" Dear Sir I feel that as my brothers friend you have been neglecred but owing to sickness in the family having been away most of the time I have not had much spare time.", "Caleb is not quite as well as when I wrore you before.", "He can not sit up at all.", "He was very much pleased with your letter & he wishes me to tell you to keep writing if you do not hear from him first.", "for your letters do him more good than a great deal of medicine.", "He wants to know if you will be so kind as to ask Dr. Bliss2 what he must do to have his furlough extended if he should not be able to come back then.", "His head troubles him very much and I fear he will not be able to come back for a long time if ever through he will not own it.", "Hoping to hear from you again soon I will now close, Yours Respectfully "], "words": ["Dear", "Sir", "I", "feel", "that", "as", "my", "brothers", "friend", "you", "have", "been", "neglecred", "but", "owing", "to", "sickness", "in", "the", "family", "having", "been", "away", "most", "of", "the", "time", "I", "have", "not", "had", "much", "spare", "time.", "Caleb", "is", "not", "quite", "as", "well", "as", "when", "I", "wrore", "you", "before.", "He", "can", "not", "sit", "up", "at", "all.", "He", "was", "very", "much", "pleased", "with", "your", "letter", "&", "he", "wishes", "me", "to", "tell", "you", "to", "keep", "writing", "if", "you", "do", "not", "hear", "from", "him", "first.", "for", "your", "letters", "do", "him", "more", "good", "than", "a", "great", "deal", "of", "medicine.", "He", "wants", "to", "know", "if", "you", "will", "be", "so", "kind", "as", "to", "ask", "Dr.", "Bliss2", "what", "he", "must", "do", "to", "have", "his", "furlough", "extended", "if", "he", "should", "not", "be", "able", "to", "come", "back", "then.", "His", "head", "troubles", "him", "very", "much", "and", "I", "fear", "he", "will", "not", "be", "able", "to", "come", "back", "for", "a", "long", "time", "if", "ever", "through", "he", "will", "not", "own", "it.", "Hoping", "to", "hear", "from", "you", "again", "soon", "I", "will", "now", "close", ",", "Yours", "Respectfully"], "date": [], "normalizedTime": "0.182918536652", "recipient": "Walt Whitman", "organizations": [], "sender": "Babbitt", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/nyp.00145.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Mary A. Babbitt to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["George", "NNP"], ["Washington", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Louisa", "NNP"], ["Van", "NNP"], ["Velsor", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Andrew", "Mother", "Eggs", "Burnside", "Sick", "Sams Lottery", "Jeff", "Jeff", "Stroke", "Charleston", "Month", "Uncle Sam", "Capt Sims", "Jeff"], "money": [], "year": "1863", "locations": [], "month": "Sep", "parties": ["George Washington Whitman", "Louisa Van Velsor Whitman"], "properDate": "Sep 7, 1863", "gpe": ["Camp", "Mattie", "Covington", "Covington", "Haversacks", "Burnside", "East", "Burnside", "Brigade", "Hospitals", "Capt", "Sims3", "New York", "Brooklyn", "Uncle", "Jeff", "Co", "Corporels", "Poor", "Burnside", "Mississippi", "Washington", "Clothing", "Ordnance", "Washington", "New York", "Good"], "facility": ["Knoxville"], "latlngs": [[39.0836712, -84.5085536], [39.0836712, -84.5085536], [36.9889661, -84.5999405], [36.9889661, -84.5999405], [40.7143528, -74.00597309999999], [40.65, -73.95], [36.9889661, -84.5999405], [38.8951118, -77.0363658], [38.8951118, -77.0363658], [40.7143528, -74.00597309999999], [37.8806341, -84.5729961], [32.7765656, -79.93092159999999]], "text": "  Camp of 51st Regt N.Y. Vols.near Nicholasville Ky   Sept 7th/63 Dear Mother. Your letter of August 30th with the $10 came all right, and I am sory I put you to the trouble of going to the bank, as we were paid last night, for the Months of July & August and of course I have more money than I know what to do with. Mother I feel quite worried about Andrew, and if his being in the Country benifits his disease, I hope you will send him money (out of what I send you) enough to let him stay there untill he recovers his voice, and his throat gets all right. I should think it would not be very expensive for him to board there, for I suppose of course, he boards at a private house, as I should think he would be much better off, there than at a Hotel. If I was he, I would go to some farmers house where I could have everything comfortable and good. I am very glad Mother, to hear that your health is good, and I hope that you will take things easy and not overwork yourself, and Mother above all things, dont wory and frett yourself, but let things take their course. Hannah you say, has not written to you very lately but I am in hopes that we will soon hear that she is entirely well. Mattie and the babies I am glad to hear, are well and hearty,  Jess you say has not been very well but I hope he is better now. I last wrote you, from Covington where we were haveing first rate easy times and fine liveing. We left there, August 26th marched down to the Depot and took the Cars for this place. We are about 100 miles from Covington and 3 from the village of Nicholasville  We are right among the farmers, so of course we are all right on the grub question, pedlars every day bring in fruit,vegetables, Eggs and all that kind of thing. We have been expecting orders to march every day, and this morning we were ordered to be ready to move at any moment, with 3 days rations in Haversacks, but a few minutes ago the orders to be ready, were countermanded for some reason or another, (I think likely that word has come from Burnside that he is not likely to meet with much resistance at Knoxville)2  It seemed to be the general opinion that we were going down to East Tennessee to reinforce Burnside,  It is some 200 miles from here to where Burnside is, and the men and Officers of our Brigade, dont like the idea of going there much, but as for myself, if it wasent for being so far away from any place where a fellow could get the papers, or hear from home, I think I would as leave go down there as not, although our Regt aint fit to go anywhere, or for any kind of service. My morning report this morning (and for the last 8 days has been the same) was I   Capt, 2 Sergts 2 Corpls, 1 drummer, and 3 privates for duty, and 7 privates Sick in Hospitals,  rather a small company aint it. Capt. Sims3 and two Lieuts that were appointed to go on after conscripts, havent left the Regt. yet, so whether we will get any conscripts or not I dont know. I suppose the draft must be through with in New York & Brooklyn by this time, I wonder how many of my aquaintences have been fortunate enough to draw prizes in Uncle Sams Lottery. I do hope that Jeff has escaped, but I know quite a number that I should be pleased to hear, would have to shoulder a musket, and take their chances with the rest of us. Jeff if you know of any one (that has been drafted) that is anxious to extinguish4 themselvs, tell them to try and get in Co K and if they do right smart, they'l soon get to be Corporels, or something, and get the splendid Salary of $13 a month. Poor devils I fear theyl have rather a hard time in this Regt, for the troops that came out before the big bountys were given, seem to think themselvs a great deal better than the big bounty men (as they call them.)5 Well Mother, what do you all think, of things now,  havent we given the rebs some pretty hard knocks lately, and dont you think we can almost begin to see daylight. Jeff write a fellow a letter once in a while and let me know what your oppinion is of matters and things,  it seems to me if Rosencrans,6 and Burnside are successful, it will be another fine Stroke for our side, and Gillmore7 to at Charleston seems to be getting along well, but its my opinion thers considerable heavy work to be done before we get Charleston, but still I think its bound to come in time and if its only done, and well done, we can afford to wait annother Month or two. I suppose Walt thinks strange of my not writing to him, but as you send my letters around, writing to one is just as good as writing to each one seperately,  You have no idea how much writing I have had to do since we came back from Mississippi  our accounts got very much behind while we were down there and since we came back I have been buisy straitening them out. The Authorities at Washington, are getting very strickt, and we have to make lots of reports, of Clothing, Ordnance, and one thing and another, but I am getting things in pretty good shape, and am very glad to see the head devils at Washington are paying a little attention to their business, for Uncle Sam has been terribly robbed heretofore. Mother I will send you, (by Express) probaly tomorrow $190 or 185 dollars, and remember, I dont want you to be afraid to use it for anything you want.8 I have just heard that Capt Sims starts for New York tomorrow to bring on conscripts, probaly Jeff will see him somewhere about town. Good bye for this timeG W Whitman Mother if you have not sent the second 10 dollars, of course you wont send it but if its on the way before you get this, its all right, let me hear from you as soon as you receive the money. ", "dateText": "", "percents": [], "taggedText": [[[["Camp", "NNP"]], ["of", "IN"], ["51st", "CD"], ["Regt", "NNP"], ["N.Y.", "NNP"], ["Vols.near", "NNP"], ["Nicholasville", "NNP"], ["Ky", "NNP"], ["Sept", "NNP"], ["7th/63", "CD"], ["Dear", "NNP"], ["Mother", "NNP"], [".", "."]], [["Your", "PRP$"], ["letter", "NN"], ["of", "IN"], ["August", "NNP"], ["30th", "CD"], ["with", "IN"], ["the", "DT"], ["$", "$"], ["10", "CD"], ["came", "VBD"], ["all", "DT"], ["right", "NN"], [",", ","], ["and", "CC"], ["I", "PRP"], ["am", "VBP"], ["sory", "JJ"], ["I", "PRP"], ["put", "VBD"], ["you", "PRP"], ["to", "TO"], ["the", "DT"], ["trouble", "NN"], ["of", "IN"], ["going", "VBG"], ["to", "TO"], ["the", "DT"], ["bank", "NN"], [",", ","], ["as", "IN"], ["we", "PRP"], ["were", "VBD"], ["paid", "VBN"], ["last", "JJ"], ["night", "NN"], [",", ","], ["for", "IN"], ["the", "DT"], [["Months", "NNP"]], ["of", "IN"], ["July", "NNP"], ["&", "CC"], ["August", "NNP"], ["and", "CC"], ["of", "IN"], ["course", "NN"], ["I", "PRP"], ["have", "VBP"], ["more", "JJR"], ["money", "NN"], ["than", "IN"], ["I", "PRP"], ["know", "VBP"], ["what", "WP"], ["to", "TO"], ["do", "VB"], ["with", "IN"], [".", "."]], [["Mother", "NNP"], ["I", "PRP"], ["feel", "VBP"], ["quite", "RB"], ["worried", "VBN"], ["about", "IN"], [["Andrew", "NNP"]], [",", ","], ["and", "CC"], ["if", "IN"], ["his", "PRP$"], ["being", "VBG"], ["in", "IN"], ["the", "DT"], [["Country", "NNP"]], ["benifits", "VBZ"], ["his", "PRP$"], ["disease", "NN"], [",", ","], ["I", "PRP"], ["hope