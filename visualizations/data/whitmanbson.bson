"crutches", "NNS"], ["yet", "RB"], [["Thomas", "NNP"]], ["flood", "NN"], ["is", "VBZ"], ["well", "RB"], ["and", "CC"], ["is", "VBZ"], ["ward", "RB"], ["master", "JJR"], ["of", "IN"], ["this", "DT"], ["ward", "NN"], ["I", "PRP"], ["thing", "VBG"], ["likely", "JJ"], ["that", "IN"], ["I", "PRP"], ["shall", "MD"], ["go", "VB"], ["home", "RB"], ["Some", "DT"], ["time", "NN"], ["this", "DT"], ["month", "NN"], ["there", "RB"], ["was", "VBD"], ["an", "DT"], ["order", "NN"], ["in", "IN"], ["the", "DT"], ["paper", "NN"], ["that", "IN"], ["we", "PRP"], ["was", "VBD"], ["all", "PDT"], ["A", "DT"], ["goin", "NN"], ["to", "TO"], ["be", "VB"], [["Sent", "NNP"]], ["home", "NN"], ["to", "TO"], ["vote", "VB"], ["So", "RB"], ["no", "DT"], ["more", "RBR"], ["at", "IN"], ["presant", "JJ"], ["from", "IN"], ["your", "PRP$"], ["friend", "NN"], [["James", "NNP"], ["Stilwell", "NNP"]], ["write", "NN"], ["Soon", "NNP"]]], "sentences": ["   Dear Friend I take this opportunity to write to you to let you know how I am I am well and my wound is A most healed up and I hope that these few lines will find you well  I received your letter and was glad to here from you and to here that you was well I havent got transfered to newyork yet I tryed to when I was at home but I could not So I had to come back here the Doctor ask me when I came back if I did not want my discharge I told him that I would rather be transfered to newyork and if I could not that I would like to have my discharge, he said that he would get me transfered or give me my discharge I walk with crutches yet Thomas flood is well and is ward master of this ward I thing likely that I shall go home Some time this month there was an order in the paper that we was all A goin to be Sent home to vote So no more at presant from your friend James Stilwell write Soon   "], "words": ["Dear", "Friend", "I", "take", "this", "opportunity", "to", "write", "to", "you", "to", "let", "you", "know", "how", "I", "am", "I", "am", "well", "and", "my", "wound", "is", "A", "most", "healed", "up", "and", "I", "hope", "that", "these", "few", "lines", "will", "find", "you", "well", "I", "received", "your", "letter", "and", "was", "glad", "to", "here", "from", "you", "and", "to", "here", "that", "you", "was", "well", "I", "havent", "got", "transfered", "to", "newyork", "yet", "I", "tryed", "to", "when", "I", "was", "at", "home", "but", "I", "could", "not", "So", "I", "had", "to", "come", "back", "here", "the", "Doctor", "ask", "me", "when", "I", "came", "back", "if", "I", "did", "not", "want", "my", "discharge", "I", "told", "him", "that", "I", "would", "rather", "be", "transfered", "to", "newyork", "and", "if", "I", "could", "not", "that", "I", "would", "like", "to", "have", "my", "discharge", ",", "he", "said", "that", "he", "would", "get", "me", "transfered", "or", "give", "me", "my", "discharge", "I", "walk", "with", "crutches", "yet", "Thomas", "flood", "is", "well", "and", "is", "ward", "master", "of", "this", "ward", "I", "thing", "likely", "that", "I", "shall", "go", "home", "Some", "time", "this", "month", "there", "was", "an", "order", "in", "the", "paper", "that", "we", "was", "all", "A", "goin", "to", "be", "Sent", "home", "to", "vote", "So", "no", "more", "at", "presant", "from", "your", "friend", "James", "Stilwell", "write", "Soon"], "date": [], "normalizedTime": "0.235550115599", "recipient": "Walt Whitman", "organizations": ["Sent"], "sender": "James S. Stilwell", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/nyp.00172.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from James S. Stilwell to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], ["the", "DT"], [["Editors", "NNP"]], ["of", "IN"], ["the", "DT"], [["New", "NNP"], ["York", "NNP"], ["Times", "NNP"]]]], "people": [], "money": [], "year": "1864", "locations": [], "month": "Oct", "parties": ["Walt Whitman", "Editors", "New York Times"], "properDate": "Oct 0, 1864", "gpe": ["New York Veterans"], "facility": [], "latlngs": [], "text": " (Private) when a great general dies, you print his obituary, & his record, by its inspiration sometimes does as much good as his deeds.   I think the 51st New York Veterans, lately captured almost entire, while bravely fighting, deserves some such mention. The statements in the abstract I send are all facts. You will see I have avoided any thing like puffing, but given an abstract only. ", "dateText": "", "percents": [], "taggedText": [[["(", "NN"], [["Private", "JJ"]], [")", "NN"], ["when", "WRB"], ["a", "DT"], ["great", "JJ"], ["general", "JJ"], ["dies", "NNS"], [",", ","], ["you", "PRP"], ["print", "VBP"], ["his", "PRP$"], ["obituary", "JJ"], [",", ","], ["&", "CC"], ["his", "PRP$"], ["record", "NN"], [",", ","], ["by", "IN"], ["its", "PRP$"], ["inspiration", "NN"], ["sometimes", "RB"], ["does", "VBZ"], ["as", "IN"], ["much", "JJ"], ["good", "NN"], ["as", "IN"], ["his", "PRP$"], ["deeds", "NNS"], [".", "."]], [["I", "PRP"], ["think", "VBP"], ["the", "DT"], ["51st", "JJ"], [["New", "NNP"], ["York", "NNP"], ["Veterans", "NNP"]], [",", ","], ["lately", "RB"], ["captured", "VBN"], ["almost", "RB"], ["entire", "JJ"], [",", ","], ["while", "IN"], ["bravely", "RB"], ["fighting", "VBG"], [",", ","], ["deserves", "NNS"], ["some", "DT"], ["such", "JJ"], ["mention", "NN"], [".", "."]], [["The", "DT"], ["statements", "NNS"], ["in", "IN"], ["the", "DT"], ["abstract", "NN"], ["I", "PRP"], ["send", "VBP"], ["are", "VBP"], ["all", "DT"], ["facts", "NNS"], [".", "."]], [["You", "PRP"], ["will", "MD"], ["see", "VB"], ["I", "PRP"], ["have", "VBP"], ["avoided", "VBN"], ["any", "DT"], ["thing", "NN"], ["like", "IN"], ["puffing", "NN"], [",", ","], ["but", "CC"], ["given", "VBN"], ["an", "DT"], ["abstract", "NN"], ["only", "RB"], [".", "."]]], "sentences": [" (Private) when a great general dies, you print his obituary, & his record, by its inspiration sometimes does as much good as his deeds.", "I think the 51st New York Veterans, lately captured almost entire, while bravely fighting, deserves some such mention.", "The statements in the abstract I send are all facts.", "You will see I have avoided any thing like puffing, but given an abstract only. "], "words": ["(", "Private", ")", "when", "a", "great", "general", "dies", ",", "you", "print", "his", "obituary", ",", "&", "his", "record", ",", "by", "its", "inspiration", "sometimes", "does", "as", "much", "good", "as", "his", "deeds.", "I", "think", "the", "51st", "New", "York", "Veterans", ",", "lately", "captured", "almost", "entire", ",", "while", "bravely", "fighting", ",", "deserves", "some", "such", "mention.", "The", "statements", "in", "the", "abstract", "I", "send", "are", "all", "facts.", "You", "will", "see", "I", "have", "avoided", "any", "thing", "like", "puffing", ",", "but", "given", "an", "abstract", "only", "."], "date": [], "normalizedTime": "0.235958112335", "recipient": "New York Times", "organizations": ["Private"], "sender": "Walt Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/duk.00386.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Walt Whitman to the Editors of the New York Times"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Reuben", "NNP"], ["Farwell", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Dear", "Uncle Sam", "Answer"], "money": [], "year": "1864", "locations": [], "month": "Oct", "parties": ["Reuben Farwell", "Walt Whitman"], "properDate": "Oct 2, 1864", "gpe": ["Armory"], "facility": [], "latlngs": [], "text": "   Dear Comrad Yours I recived several weeks ago. Though I have been quite unwell like your self  This makes the fourth week I have been out of the Service of Uncle Sam  I hardly know what to write you at present because I do not know wether you ever will recive it or not. I am some better than I was when I arrived here I trust that you will excuse me in not writing you before Though I tried to find out by the Boys in Armory where you were But they could not tell Now Uncle if you will (not) Answer this after My being detained in geting yours from the Regt. I belonged to too this place I least I hope you will Try and give me a Reply I trust that this may find you well and in better health than when you wrote me last. I will answer All enquireys from you. this from one who would like to see you Indeed   A Comrad  Ruben Farwell  ", "dateText": "", "percents": [], "taggedText": [[[["Dear", "NNP"]], [["Comrad", "NNP"]], ["Yours", "NNP"], ["I", "NNP"], ["recived", "VBD"], ["several", "JJ"], ["weeks", "NNS"], ["ago", "IN"], [".", "."]], [["Though", "IN"], ["I", "PRP"], ["have", "VBP"], ["been", "VBN"], ["quite", "RB"], ["unwell", "RB"], ["like", "IN"], ["your", "PRP$"], ["self", "NN"], ["This", "DT"], ["makes", "VBZ"], ["the", "DT"], ["fourth", "JJ"], ["week", "NN"], ["I", "PRP"], ["have", "VBP"], ["been", "VBN"], ["out", "RP"], ["of", "IN"], ["the", "DT"], [["Service", "NNP"]], ["of", "IN"], [["Uncle", "NNP"], ["Sam", "NNP"]], ["I", "NNP"], ["hardly", "RB"], ["know", "VB"], ["what", "WP"], ["to", "TO"], ["write", "VB"], ["you", "PRP"], ["at", "IN"], ["present", "JJ"], ["because", "IN"], ["I", "PRP"], ["do", "VBP"], ["not", "RB"], ["know", "VB"], ["wether", "RB"], ["you", "PRP"], ["ever", "RB"], ["will", "MD"], ["recive", "VB"], ["it", "PRP"], ["or", "CC"], ["not", "RB"], [".", "."]], [["I", "PRP"], ["am", "VBP"], ["some", "DT"], ["better", "JJR"], ["than", "IN"], ["I", "PRP"], ["was", "VBD"], ["when", "WRB"], ["I", "PRP"], ["arrived", "VBD"], ["here", "RB"], ["I", "PRP"], ["trust", "VBP"], ["that", "IN"], ["you", "PRP"], ["will", "MD"], ["excuse", "VB"], ["me", "PRP"], ["in", "IN"], ["not", "RB"], ["writing", "VBG"], ["you", "PRP"], ["before", "IN"], ["Though", "NNP"], ["I", "NNP"], ["tried", "VBD"], ["to", "TO"], ["find", "VB"], ["out", "RP"], ["by", "IN"], ["the", "DT"], ["Boys", "NNP"], ["in", "IN"], [["Armory", "NNP"]], ["where", "WRB"], ["you", "PRP"], ["were", "VBD"], ["But", "CC"], ["they", "PRP"], ["could", "MD"], ["not", "RB"], ["tell", "VB"], ["Now", "RB"], ["Uncle", "NNP"], ["if", "IN"], ["you", "PRP"], ["will", "MD"], ["(", "VB"], ["not", "RB"], [")", "VB"], [["Answer", "NNP"]], ["this", "DT"], ["after", "IN"], ["My", "NNP"], ["being", "VBG"], ["detained", "VBN"], ["in", "IN"], ["geting", "NN"], ["yours", "NNS"], ["from", "IN"], ["the", "DT"], ["Regt", "NNP"], [".", "."]], [["I", "PRP"], ["belonged", "VBD"], ["to", "TO"], ["too", "RB"], ["this", "DT"], ["place", "NN"], ["I", "PRP"], ["least", "VBP"], ["I", "PRP"], ["hope", "VBP"], ["you", "PRP"], ["will", "MD"], ["Try", "VB"], ["and", "CC"], ["give", "VB"], ["me", "PRP"], ["a", "DT"], ["Reply", "NNP"], ["I", "NNP"], ["trust", "NN"], ["that", "WDT"], ["this", "DT"], ["may", "MD"], ["find", "VB"], ["you", "PRP"], ["well", "RB"], ["and", "CC"], ["in", "IN"], ["better", "JJR"], ["health", "NN"], ["than", "IN"], ["when", "WRB"], ["you", "PRP"], ["wrote", "VBD"], ["me", "PRP"], ["last", "JJ"], [".", "."]], [["I", "PRP"], ["will", "MD"], ["answer", "VB"], ["All", "DT"], ["enquireys", "NNS"], ["from", "IN"], ["you", "PRP"], [".", "."]], [["this", "DT"], ["from", "IN"], ["one", "CD"], ["who", "WP"], ["would", "MD"], ["like", "VB"], ["to", "TO"], ["see", "VB"], ["you", "PRP"], ["Indeed", "NNP"], ["A", "DT"], [["Comrad", "NNP"], ["Ruben", "NNP"], ["Farwell", "NNP"]]]], "sentences": ["   Dear Comrad Yours I recived several weeks ago.", "Though I have been quite unwell like your self  This makes the fourth week I have been out of the Service of Uncle Sam  I hardly know what to write you at present because I do not know wether you ever will recive it or not.", "I am some better than I was when I arrived here I trust that you will excuse me in not writing you before Though I tried to find out by the Boys in Armory where you were But they could not tell Now Uncle if you will (not) Answer this after My being detained in geting yours from the Regt.", "I belonged to too this place I least I hope you will Try and give me a Reply I trust that this may find you well and in better health than when you wrote me last.", "I will answer All enquireys from you.", "this from one who would like to see you Indeed   A Comrad  Ruben Farwell  "], "words": ["Dear", "Comrad", "Yours", "I", "recived", "several", "weeks", "ago.", "Though", "I", "have", "been", "quite", "unwell", "like", "your", "self", "This", "makes", "the", "fourth", "week", "I", "have", "been", "out", "of", "the", "Service", "of", "Uncle", "Sam", "I", "hardly", "know", "what", "to", "write", "you", "at", "present", "because", "I", "do", "not", "know", "wether", "you", "ever", "will", "recive", "it", "or", "not.", "I", "am", "some", "better", "than", "I", "was", "when", "I", "arrived", "here", "I", "trust", "that", "you", "will", "excuse", "me", "in", "not", "writing", "you", "before", "Though", "I", "tried", "to", "find", "out", "by", "the", "Boys", "in", "Armory", "where", "you", "were", "But", "they", "could", "not", "tell", "Now", "Uncle", "if", "you", "will", "(", "not", ")", "Answer", "this", "after", "My", "being", "detained", "in", "geting", "yours", "from", "the", "Regt.", "I", "belonged", "to", "too", "this", "place", "I", "least", "I", "hope", "you", "will", "Try", "and", "give", "me", "a", "Reply", "I", "trust", "that", "this", "may", "find", "you", "well", "and", "in", "better", "health", "than", "when", "you", "wrote", "me", "last.", "I", "will", "answer", "All", "enquireys", "from", "you.", "this", "from", "one", "who", "would", "like", "to", "see", "you", "Indeed", "A", "Comrad", "Ruben", "Farwell"], "date": [], "normalizedTime": "0.236230110159", "recipient": "Walt Whitman", "organizations": ["Comrad", "Service", "Comrad Ruben Farwell"], "sender": "Reuben Farwell", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/duk.00374.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Reuben Farwell to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["George", "NNP"], ["Washington", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Louisa", "NNP"], ["Van", "NNP"], ["Velsor", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Petersburg Va", "Major Wright,2 Lieuts", "Lieut Butler7", "Spirits", "Walt", "Jeff", "Pooley"], "money": [], "year": "1864", "locations": [], "month": "Oct", "parties": ["George Washington Whitman", "Louisa Van Velsor Whitman"], "properDate": "Oct 2, 1864", "gpe": ["Mother", "Lieut"], "facility": [], "latlngs": [], "text": "  Petersburg Va   Oct 2d/64 Dear Mother, Here I am perfectly well and unhurt, but a prisoner. I was captured day before yesterday with Major Wright,2 Lieuts Pooley,3 Cauldwell,4 Ackerson,5 Sims,6 and nearly the entire Regt. that was not killed or wounded  Lieut Butler7 was badly wounded  I am in tip top health and Spirits, and am as tough as a mule and shall get along first rate,  Mother please dont worry and all will be right in time if you will not worry  I wish Walt, or Jeff would write to Lieut. Babcock8 of our Regt (who is with the Regt) and tell him to send my things home by express, as I should be very sorry to lose them.9 G. W. Whitman Lieut Pooley is here and unhurt. ", "dateText": "", "percents": [], "taggedText": [[[["Petersburg", "NNP"], ["Va", "NNP"]], ["Oct", "NNP"], ["2d/64", "CD"], ["Dear", "NNP"], ["Mother", "NNP"], [",", ","], ["Here", "NNP"], ["I", "PRP"], ["am", "VBP"], ["perfectly", "RB"], ["well", "RB"], ["and", "CC"], ["unhurt", "VB"], [",", ","], ["but", "CC"], ["a", "DT"], ["prisoner", "NN"], [".", "."]], [["I", "PRP"], ["was", "VBD"], ["captured", "VBN"], ["day", "NN"], ["before", "IN"], ["yesterday", "NN"], ["with", "IN"], [["Major", "NNP"], ["Wright,2", "NNP"], ["Lieuts", "NNP"]], ["Pooley,3", "NNP"], ["Cauldwell,4", "NNP"], ["Ackerson,5", "NNP"], ["Sims,6", "NNP"], ["and", "CC"], ["nearly", "RB"], ["the", "DT"], ["entire", "JJ"], ["Regt", "NNP"], [".", "."]], [["that", "DT"], ["was", "VBD"], ["not", "RB"], ["killed", "VBN"], ["or", "CC"], ["wounded", "VBN"], [["Lieut", "NNP"], ["Butler7", "NNP"]], ["was", "VBD"], ["badly", "RB"], ["wounded", "VBN"], ["I", "PRP"], ["am", "VBP"], ["in", "IN"], ["tip", "NN"], ["top", "NN"], ["health", "NN"], ["and", "CC"], [["Spirits", "NNP"]], [",", ","], ["and", "CC"], ["am", "NN"], ["as", "IN"], ["tough", "JJ"], ["as", "IN"], ["a", "DT"], ["mule", "NN"], ["and", "CC"], ["shall", "MD"], ["get", "VB"], ["along", "IN"], ["first", "JJ"], ["rate", "NN"], [",", ","], [["Mother", "NNP"]], ["please", "NN"], ["dont", "NN"], ["worry", "NN"], ["and", "CC"], ["all", "DT"], ["will", "MD"], ["be", "VB"], ["right", "RB"], ["in", "IN"], ["time", "NN"], ["if", "IN"], ["you", "PRP"], ["will", "MD"], ["not", "RB"], ["worry", "VB"], ["I", "PRP"], ["wish", "VB"], [["Walt", "NNP"]], [",", ","], ["or", "CC"], [["Jeff", "NNP"]], ["would", "MD"], ["write", "VB"], ["to", "TO"], [["Lieut", "NNP"]], [".", "."]], [[["Babcock8", "NNP"]], ["of", "IN"], ["our", "PRP$"], ["Regt", "NNP"], ["(", "NNP"], ["who", "WP"], ["is", "VBZ"], ["with", "IN"], ["the", "DT"], [["Regt", "NNP"]], [")", "NNP"], ["and", "CC"], ["tell", "VBD"], ["him", "PRP"], ["to", "TO"], ["send", "VB"], ["my", "PRP$"], ["things", "NNS"], ["home", "NN"], ["by", "IN"], ["express", "NN"], [",", ","], ["as", "IN"], ["I", "PRP"], ["should", "MD"], ["be", "VB"], ["very", "RB"], ["sorry", "JJ"], ["to", "TO"], ["lose", "VB"], ["them.9", "-NONE-"], ["G.", "NNP"], ["W.", "NNP"], ["Whitman", "NNP"], ["Lieut", "NNP"], [["Pooley", "NNP"]], ["is", "VBZ"], ["here", "RB"], ["and", "CC"], ["unhurt", "NN"], [".", "."]]], "sentences": ["  Petersburg Va   Oct 2d/64 Dear Mother, Here I am perfectly well and unhurt, but a prisoner.", "I was captured day before yesterday with Major Wright,2 Lieuts Pooley,3 Cauldwell,4 Ackerson,5 Sims,6 and nearly the entire Regt.", "that was not killed or wounded  Lieut Butler7 was badly wounded  I am in tip top health and Spirits, and am as tough as a mule and shall get along first rate,  Mother please dont worry and all will be right in time if you will not worry  I wish Walt, or Jeff would write to Lieut.", "Babcock8 of our Regt (who is with the Regt) and tell him to send my things home by express, as I should be very sorry to lose them.9 G. W. Whitman Lieut Pooley is here and unhurt. "], "words": ["Petersburg", "Va", "Oct", "2d/64", "Dear", "Mother", ",", "Here", "I", "am", "perfectly", "well", "and", "unhurt", ",", "but", "a", "prisoner.", "I", "was", "captured", "day", "before", "yesterday", "with", "Major", "Wright,2", "Lieuts", "Pooley,3", "Cauldwell,4", "Ackerson,5", "Sims,6", "and", "nearly", "the", "entire", "Regt.", "that", "was", "not", "killed", "or", "wounded", "Lieut", "Butler7", "was", "badly", "wounded", "I", "am", "in", "tip", "top", "health", "and", "Spirits", ",", "and", "am", "as", "tough", "as", "a", "mule", "and", "shall", "get", "along", "first", "rate", ",", "Mother", "please", "dont", "worry", "and", "all", "will", "be", "right", "in", "time", "if", "you", "will", "not", "worry", "I", "wish", "Walt", ",", "or", "Jeff", "would", "write", "to", "Lieut.", "Babcock8", "of", "our", "Regt", "(", "who", "is", "with", "the", "Regt", ")", "and", "tell", "him", "to", "send", "my", "things", "home", "by", "express", ",", "as", "I", "should", "be", "very", "sorry", "to", "lose", "them.9", "G.", "W.", "Whitman", "Lieut", "Pooley", "is", "here", "and", "unhurt", "."], "date": [], "normalizedTime": "0.236230110159", "recipient": "Louisa Van Velsor Whitman", "organizations": ["Babcock8", "Regt"], "sender": "George Washington Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/duk.00363.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from George Washington Whitman to Louisa Van Velsor Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Charles", "NNP"], ["W.", "NNP"], ["Eldridge", "NNP"]], [",", ","]]], "people": ["Myrtle", "Brooklyn Oct", "William", "Jennie", "Nelly", "George", "William", "Per", "Grant", "Good", "Walt"], "money": [], "year": "1864", "locations": [], "month": "Oct", "parties": ["Walt Whitman", "Charles W. Eldridge"], "properDate": "Oct 8, 1864", "gpe": ["Portland", "Washington", "Boston", "Little", "New York", "Brooklyn"], "facility": [], "latlngs": [[45.5234515, -122.6762071], [38.8951118, -77.0363658], [42.3584308, -71.0597732], [40.7143528, -74.00597309999999], [40.65, -73.95], [33.8958492, -118.2200712]], "text": "  Portland av near Myrtle | Brooklyn  Oct 8 '64  Dear friend, Your letters from Washington have all reached me, with the others enclosed. The last from you was dated Sept 27. You did not mention William in it   I should always like to hear about him & from him. Is Nelly in Boston? If so say I sent my best love, not forgetting little Jennie. The last letter I received from Nelly was from Little Compton Aug 18   I have written subsequently & directed there, which I suppose she received   I have not heard from her since    I am pretty well, perhaps not so unconsciously hearty as before my sickness   We are deprest in spirits home here about my brother George, (2d div 9th Corps)   if not killed, he is a prisoner   he was in the engagement of Sept 30 on the extreme left.31 My book is not yet being printed. I still wish to stereotype it myself. I could easily still put it in the hands of a proper publisher then, & make better terms with him. If you write to William I wish you to enclose him this letter   I wish him to receive again my faithful friendship   while breath & sense remain I cannot forget what he has been to me   I love him dearly    The weather here is fine of late   to-day a little blowy   The political meetings in New York & Brooklyn are immense   I go to them as to shows, fireworks, cannon, clusters of gaslights, countless torches, banners & mottos, 15, 20, 50,000 people   Per contra I occasionally go riding off in the country, in quiet lanes, or a sail on the water, & many times to the sea shore at Coney Island    All the signs are that Grant is going to strike forthwith, perhaps risk all   One feels solemn who sees what depends. The military success, though first-class of war, is the least that depends    Good bye, dearest comrade, write me whenever you can   if I make any move I shall let you know    Walt ", "dateText": "", "percents": [], "taggedText": [[[["Portland", "NNP"]], ["av", "NN"], ["near", "IN"], [["Myrtle", "NNP"]], ["|", "NNP"], [["Brooklyn", "NNP"], ["Oct", "NNP"]], ["8", "CD"], ["'64", "-NONE-"], ["Dear", "NNP"], ["friend", "NN"], [",", ","], ["Your", "NNP"], ["letters", "NNS"], ["from", "IN"], [["Washington", "NNP"]], ["have", "VBP"], ["all", "DT"], ["reached", "VBN"], ["me", "PRP"], [",", ","], ["with", "IN"], ["the", "DT"], ["others", "NNS"], ["enclosed", "VBD"], [".", "."]], [["The", "DT"], ["last", "JJ"], ["from", "IN"], ["you", "PRP"], ["was", "VBD"], ["dated", "VBN"], ["Sept", "NNP"], ["27", "CD"], [".", "."]], [["You", "PRP"], ["did", "VBD"], ["not", "RB"], ["mention", "NN"], [["William", "NNP"]], ["in", "IN"], ["it", "PRP"], ["I", "PRP"], ["should", "MD"], ["always", "RB"], ["like", "VB"], ["to", "TO"], ["hear", "VB"], ["about", "IN"], ["him", "PRP"], ["&", "CC"], ["from", "IN"], ["him", "PRP"], [".", "."]], [["Is", "VBZ"], ["Nelly", "RB"], ["in", "IN"], [["Boston", "NNP"]], ["?", "."]], [["If", "IN"], ["so", "RB"], ["say", "VBP"], ["I", "PRP"], ["sent", "VBP"], ["my", "PRP$"], ["best", "JJS"], ["love", "NN"], [",", ","], ["not", "RB"], ["forgetting", "VBG"], ["little", "RB"], [["Jennie", "NNP"]], [".", "."]], [["The", "DT"], ["last", "JJ"], ["letter", "NN"], ["I", "PRP"], ["received", "VBD"], ["from", "IN"], [["Nelly", "NNP"]], ["was", "VBD"], ["from", "IN"], [["Little", "NNP"]], [["Compton", "NNP"]], ["Aug", "NNP"], ["1