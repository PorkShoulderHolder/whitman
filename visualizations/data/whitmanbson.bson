, "but", "I", "go", "out", "clear", "to-day", "I", "get", "or", "see", "N.Y.", "and", "Phil.", "papers", "nearly", "all", ",", "&", "the", "Wash.", "Chronicle", "&", "the", "Capital", "Write", "me", "how", "new", "train", "makes", "out", "Do", "you", "go", "through", "to", "Balt", "only", "or", "further", "?", "Am", "glad", "Buck", "is", "your", "conductor", "Your", "old", "Walt"], "date": [], "normalizedTime": "0.710594315245", "recipient": "Peter Doyle", "organizations": ["Capital"], "sender": "Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/reconstruction/tei/nyp.00336.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Walt Whitman to Peter Doyle ,"}, {"taggedHeading": [[[["Walt", "NNP"]], [["Whitman", "NNP"]], ["to", "TO"], [["Peter", "NNP"], ["Doyle", "NNP"]], [",", ","]]], "people": ["Stevens st.", "Camden"], "money": [], "year": "1874", "locations": ["West"], "month": "Apr", "parties": ["Walt", "Whitman", "Peter Doyle"], "properDate": "Apr 24, 1874", "gpe": [], "facility": [], "latlngs": [], "text": "  431 Stevens st. / cor West. / Camden, N.J.           April 24   12 noon                            Yours of 23d just rec'd   Nothing new or different with me. Come   When you once find the way          you'll discover its very easy   A bright pleasant forenoon here at last. Am going out now.         W W        ", "dateText": "", "percents": [], "taggedText": [[["431", "CD"], [["Stevens", "NNP"], ["st.", "NNP"]], ["/", "NNP"], ["cor", "NN"], [["West", "NNP"]], [".", "."]], [["/", "NN"], [["Camden", "NNP"]], [",", ","], ["N.J.", "NNP"], ["April", "NNP"], ["24", "CD"], ["12", "CD"], ["noon", "NN"], ["Yours", "NNS"], ["of", "IN"], ["23d", "JJ"], ["just", "RB"], ["rec", "JJ"], ["'d", "JJ"], ["Nothing", "NN"], ["new", "JJ"], ["or", "CC"], ["different", "JJ"], ["with", "IN"], ["me", "PRP"], [".", "."]], [["Come", "NNP"], ["When", "NNP"], ["you", "PRP"], ["once", "RB"], ["find", "VBP"], ["the", "DT"], ["way"