d our disappointment that our Mr. Thayer was not able to see you last Saturday or Sunday.", "Business obliged him to return to Boston from the West, but he will leave here for New York Sunday night & will put up either at the Astor, Lovejoys or the hotel Corner Nassau & Beekman Streets.", "If he does not see you in the morning at above places, he will call at your house in the afternoon say at 3 o'clock.", "Our Mr. Eldridge will reply to your letter at length tomorrow afternoon mail.", "Our thanks for your most excellent and practical letter.", "Your Friends  Thayer & Eldridge  "], "words": ["Boston", "March", "9/60", "6", "o'clock", "P.M.", "Walt", "Whitman", "Dr", "Sir.", "Yours", "of", "Thursday", "morning", "rec", "'d", "this", "A.M.~", "Your", "suggestions", "are", "pertinent", "to", "the", "business", "under", "consideration", ",", "all", "of", "which", "are", "most", "amply", "satisfactory.", "Your", "letter", "is", "such", "a", "capital", "one", ",", "that", "it", "has", "intensified", "our", "disappointment", "that", "our", "Mr.", "Thayer", "was", "not", "able", "to", "see", "you", "last", "Saturday", "or", "Sunday.", "Business", "obliged", "him", "to", "return", "to", "Boston", "from", "the", "West", ",", "but", "he", "will", "leave", "here", "for", "New", "York", "Sunday", "night", "&", "will", "put", "up", "either", "at", "the", "Astor", ",", "Lovejoys", "or", "the", "hotel", "Corner", "Nassau", "&", "Beekman", "Streets.", "If", "he", "does", "not", "see", "you", "in", "the", "morning", "at", "above", "places", ",", "he", "will", "call", "at", "your", "house", "in", "the", "afternoon", "say", "at", "3", "o'clock.", "Our", "Mr.", "Eldridge", "will", "reply", "to", "your", "letter", "at", "length", "tomorrow", "afternoon", "mail.", "Our", "thanks", "for", "your", "most", "excellent", "and", "practical", "letter.", "Your", "Friends", "Thayer", "&", "Eldridge"], "date": [], "normalizedTime": "0.0093839249286", "recipient": "Walt Whitman", "organizations": ["Beekman Streets"], "sender": "Thayer", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00564.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Thayer & Eldridge to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Fred", "NNP"], ["Vaughan", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Dear", "Fred"], "money": [], "year": "1860", "locations": [], "month": "Mar", "parties": ["Fred Vaughan", "Walt Whitman"], "properDate": "Mar 19, 1860", "gpe": ["Walt", "Boston", "Write", "New York", "New York"], "facility": [], "latlngs": [[42.3584308, -71.0597732], [40.7143528, -74.00597309999999], [40.7143528, -74.00597309999999], [41.4036007, -95.0138776]], "text": " Dear Walt, I am sorry I could not see you previous to your departure for Boston. I called in at Pfaffs two evenings in succession but did not find you on hand.2 I am quite anxious to hear about how matters are progressing with you. Write to me as soon as you can make it convenient. Care of Man- Ex Co. 140 Chamber St., New York. Every thing remains as usual in New York. I have seen the Atlantic for April.3 \"good, bully for you.\"      Yours as Ever,  Fred  ", "dateText": "", "percents": [], "taggedText": [[[["Dear", "NNP"]], [["Walt", "NNP"]], [",", ","], ["I", "PRP"], ["am", "VBP"], ["sorry", "JJ"], ["I", "PRP"], ["could", "MD"], ["not", "RB"], ["see", "VB"], ["you", "PRP"], ["previous", "JJ"], ["to", "TO"], ["your", "PRP$"], ["departure", "NN"], ["for", "IN"], [["Boston", "NNP"]], [".", "."]], [["I", "PRP"], ["called", "VBD"], ["in", "IN"], ["at", "IN"], [["Pfaffs", "NNP"]], ["two", "CD"], ["evenings", "NNS"], ["in", "IN"], ["succession", "NN"], ["but", "CC"], ["did", "VBD"], ["not", "RB"], ["find", "VB"], ["you", "PRP"], ["on", "IN"], ["hand.2", "-NONE-"], ["I", "PRP"], ["am", "VBP"], ["quite", "RB"], ["anxious", "JJ"], ["to", "TO"], ["hear", "VB"], ["about", "IN"], ["how", "WRB"], ["matters", "NNS"], ["are", "VBP"], ["progressing", "VBG"], ["with", "IN"], ["you", "PRP"], [".", "."]], [[["Write", "NNP"]], ["to", "TO"], ["me", "PRP"], ["as", "IN"], ["soon", "RB"], ["as", "IN"], ["you", "PRP"], ["can", "MD"], ["make", "VB"], ["it", "PRP"], ["convenient", "JJ"], [".", "."]], [["Care", "NNP"], ["of", "IN"], ["Man-", "NNP"], ["Ex", "NNP"], ["Co.", "NNP"], ["140", "CD"], ["Chamber", "NNP"], ["St.", "NNP"], [",", ","], [["New", "NNP"], ["York", "NNP"]], [".", "."]], [["Every", "DT"], ["thing", "NN"], ["remains", "VBZ"], ["as", "IN"], ["usual", "JJ"], ["in", "IN"], [["New", "NNP"], ["York", "NNP"]], [".", "."]], [["I", "PRP"], ["have", "VBP"], ["seen", "VBN"], ["the", "DT"], [["Atlantic", "NNP"]], ["for", "IN"], ["April.3", "-NONE-"], ["``", "``"], ["good", "JJ"], [",", ","], ["bully", "RB"], ["for", "IN"], ["you", "PRP"], [".", "."]], [["``", "``"], ["Yours", "NNS"], ["as", "IN"], ["Ever", "NNP"], [",", ","], [["Fred", "NNP"]]]], "sentences": [" Dear Walt, I am sorry I could not see you previous to your departure for Boston.", "I called in at Pfaffs two evenings in succession but did not find you on hand.2 I am quite anxious to hear about how matters are progressing with you.", "Write to me as soon as you can make it convenient.", "Care of Man- Ex Co. 140 Chamber St., New York.", "Every thing remains as usual in New York.", "I have seen the Atlantic for April.3 \"good, bully for you.", "\"      Yours as Ever,  Fred  "], "words": ["Dear", "Walt", ",", "I", "am", "sorry", "I", "could", "not", "see", "you", "previous", "to", "your", "departure", "for", "Boston.", "I", "called", "in", "at", "Pfaffs", "two", "evenings", "in", "succession", "but", "did", "not", "find", "you", "on", "hand.2", "I", "am", "quite", "anxious", "to", "hear", "about", "how", "matters", "are", "progressing", "with", "you.", "Write", "to", "me", "as", "soon", "as", "you", "can", "make", "it", "convenient.", "Care", "of", "Man-", "Ex", "Co.", "140", "Chamber", "St.", ",", "New", "York.", "Every", "thing", "remains", "as", "usual", "in", "New", "York.", "I", "have", "seen", "the", "Atlantic", "for", "April.3", "``", "good", ",", "bully", "for", "you.", "''", "Yours", "as", "Ever", ",", "Fred"], "date": [], "normalizedTime": "0.0107439140487", "recipient": "Walt Whitman", "organizations": ["Pfaffs", "Atlantic"], "sender": "Fred Vaughan", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00565.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Fred Vaughan to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Charles", "NNP"], ["Hine", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Lewis", "Chas Hine Artist"], "money": [], "year": "1860", "locations": [], "month": "Mar", "parties": ["Charles Hine", "Walt Whitman"], "properDate": "Mar 21, 1860", "gpe": ["New York", "Boston", "Write"], "facility": [], "latlngs": [[40.7143528, -74.00597309999999], [42.3584308, -71.0597732]], "text": "  New York March 21st 60.  My Dear Walt Through the stupidity of Lewis I did not receive the dispatch until late in the afternoon, but as the picture is yet unfinished you will understand why I do not send it spedily. 2I went directly to my frame makers, the frame will be done to-morrow, (it is a beauty) and if you wish I will send it in a few days. It is my wish it should be seen in Boston. Let me know how you propose to introduce it. It must be hung where the Fellows will see it,   you know what I mean. Let the light be an important thing, and dont allow any clap-trap surroundings. Let it be the thing wherever it is, at any price. I had intended as you are aware to put it in the Academy.   3  Tell me what you think. If I put it there I must enter it by the 31st   What shall I do? I wish to please you and feeling that you understand me I wait your pleasure. Write immediately for we have no time to loose    Most truly yours  Chas Hine Artist  ", "dateText": "", "percents": [], "taggedText": [[[["New", "NNP"], ["York", "NNP"]], ["March", "NNP"], ["21st", "CD"], ["60", "CD"], [".", "."]], [["My", "PRP$"], ["Dear", "NNP"], ["Walt", "NNP"], ["Through", "NNP"], ["the", "DT"], ["stupidity", "NN"], ["of", "IN"], [["Lewis", "NNP"]], ["I", "NNP"], ["did", "VBD"], ["not", "RB"], ["receive", "VB"], ["the", "DT"], ["dispatch", "NN"], ["until", "IN"], ["late", "JJ"], ["in", "IN"], ["the", "DT"], ["afternoon", "NN"], [",", ","], ["but", "CC"], ["as", "IN"], ["the", "DT"], ["picture", "NN"], ["is", "VBZ"], ["yet", "RB"], ["unfinished", "VBN"], ["you", "PRP"], ["will", "MD"], ["understand", "VB"], ["why", "WRB"], ["I", "PRP"], ["do", "VBP"], ["not", "RB"], ["send", "VB"], ["it", "PRP"], ["spedily", "RB"], [".", "."]], [["2I", "CD"], ["went", "VBD"], ["directly", "RB"], ["to", "TO"], ["my", "PRP$"], ["frame", "NN"], ["makers", "NNS"], [",", ","], ["the", "DT"], ["frame", "NN"], ["will", "MD"], ["be", "VB"], ["done", "VBN"], ["to-morrow", "-NONE-"], [",", ","], ["(", ":"], ["it", "PRP"], ["is", "VBZ"], ["a", "DT"], ["beauty", "NN"], [")", ":"], ["and", "CC"], ["if", "IN"], ["you", "PRP"], ["wish", "VBP"], ["I", "PRP"], ["will", "MD"], ["send", "VB"], ["it", "PRP"], ["in", "IN"], ["a", "DT"], ["few", "JJ"], ["days", "NNS"], [".", "."]], [["It", "PRP"], ["is", "VBZ"], ["my", "PRP$"], ["wish", "NN"], ["it", "PRP"], ["should", "MD"], ["be", "VB"], ["seen", "VBN"], ["in", "IN"], [["Boston", "NNP"]], [".", "."]], [["Let", "NNP"], ["me", "PRP"], ["know", "VBP"], ["how", "WRB"], ["you", "PRP"], ["propose", "VBP"], ["to", "TO"], ["introduce", "VB"], ["it", "PRP"], [".", "."]], [["It", "PRP"], ["must", "MD"], ["be", "VB"], ["hung", "VBN"], ["where", "WRB"], ["the", "DT"], [["Fellows", "NNP"]], ["will", "MD"], ["see", "VB"], ["it", "PRP"], [",", ","], ["you", "PRP"], ["know", "VBP"], ["what", "WP"], ["I", "PRP"], ["mean", "VBP"], [".", "."]], [["Let", "NNP"], ["the", "DT"], ["light", "JJ"], ["be", "NN"], ["an", "D