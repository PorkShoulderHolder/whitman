nnor", "Cloud"], "money": [], "year": "1870", "locations": [], "month": "Oct", "parties": ["Walt", "Whitman", "William D."], "properDate": "Oct 14, 1870", "gpe": ["Brooklyn"], "facility": [], "latlngs": [[40.65, -73.95]], "text": "  Brooklyn                     Friday afternoon Oct. 14                                                      Dear William O'Connor,              I have just rec'd your letter. To make the matter certain won't you take thirty or forty minutes & go down to the St. Cloud   look at the rooms, & pick out one for me?   positively engaging it   You know what is good as well as I do, (I mean for me)   I shall want a room at least for a few weeks   & perhaps for the winter   & for that season one is not so particular about the location   (But perhaps you have already engaged for me at St. C. a specific room.)                  lovingly                 Walt.              ", "dateText": "", "percents": [], "taggedText": [[[["Brooklyn", "NNP"]], ["Friday", "NNP"], ["afternoon", "NN"], ["Oct.", "NNP"], ["14", "CD"], ["Dear", "NNP"], [["William", "NNP"], ["O'Connor", "NNP"]], [",", ","], ["I", "PRP"], ["have", "VBP"], ["just", "RB"], ["rec", "JJ"], ["'d", "JJ"], ["your", "PRP$"], ["letter", "NN"], [".", "."]], [["To", "TO"], ["make", "VB"], ["the", "DT"], ["matter", "NN"], ["certain", "NN"], ["wo", "MD"], ["n't", "RB"], ["you", "PRP"], ["take", "VB"], ["thirty", "NN"], ["or", "CC"], ["forty", "NN"], ["minutes", "NNS"], ["&", "CC"], ["go", "VB"], ["down", "RP"], ["to", "TO"], ["the", "DT"], ["St", "NNP"], [".", "."]], [[["Cloud", "NNP"]], ["look", "VBD"], ["at", "IN"], ["the", "DT"], ["rooms", "NNS"], [",", ","], ["&", "CC"], ["pick", "VB"], ["out", "RP"], ["one", "CD"], ["for", "IN"], ["me", "PRP"], ["?", "."]], [["positively", "RB"], ["engaging", "VBG"], ["it", "PRP"], ["You", "PRP"], ["know", "VBP"], ["what", "WP"], ["is", "VBZ"], ["good", "JJ"], ["as", "IN"], ["well", "RB"], ["as", "IN"], ["I", "PRP"], ["do", "VBP"], [",", ","], ["(", "NNP"], ["I", "P