", "NNP"], ["you", "PRP"], ["sent", "VBD"], ["one", "CD"], ["to", "TO"], [["Emerson", "NNP"]], ["?", "."]], [[["Do", "NNP"]], [",", ","], ["in", "IN"], ["haste", "NN"], [",", ","], ["wo", "MD"], ["n't", "RB"], ["you", "PRP"], ["?", "."]], [["I", "PRP"], ["want", "VBP"], ["him", "PRP"], ["to", "TO"], ["have", "VB"], ["one", "CD"], ["right", "JJ"], ["away", "NN"], [".", "."]], [[["Dear", "NNP"]], [["Walt", "NNP"]], [",", ","], ["will", "MD"], ["you", "PRP"], ["see", "VB"], ["in", "IN"], [["New", "NNP"], ["York", "NNP"]], [["Mr.", "NNP"], ["Howells", "NNP"]], ["?", "."], ["4", "CD"], ["I", "PRP"], ["do", "VBP"], ["n't", "RB"], ["even", "RB"], ["know", "VB"], ["his", "PRP$"], ["address", "NN"], [",", ","], ["&", "CC"], ["it", "PRP"], ["is", "VBZ"], ["necessary", "JJ"], ["that", "IN"], ["I", "PRP"], ["should", "MD"], ["write", "VB"], ["him", "PRP"], ["a", "DT"], ["business", "NN"], ["letter", "NN"], [".", "."]], [["I", "PRP"], ["wonder", "VBP"], ["how", "WRB"], ["they", "PRP"], ["are", "VBP"], [".", "."]], [["Give", "JJ"], ["him", "PRP"], ["my", "PRP$"], ["love", "NN"], ["if", "IN"], ["you", "PRP"], ["see", "VBP"], ["him", "PRP"], [".", "."]], [[["Jeannie", "NNP"]], ["is", "VBZ"], ["well", "RB"], [",", ","], ["&", "CC"], ["sends", "NNS"], ["love", "VBP"], [".", "."]], [["I", "PRP"], ["am", "VBP"], ["well", "RB"], [",", ","], ["so", "RB"], ["is", "VBZ"], [["Charley", "NNP"]], [",", ","], ["&", "CC"], ["he", "PRP"], ["too", "RB"], [",", ","], ["sends", "NNS"], ["love", "VBP"], [".", "."]], [["We", "PRP"], ["all", "DT"], ["want", "VBP"], ["to", "TO"], ["see", "VB"], ["you", "PRP"], ["back", "RB"], [".", "."]], [[["Mr.", "NNP"]], [["Ashton", "NNP"]], ["is", "VBZ"], ["well", "RB"], [",", ","], ["but", "CC"], ["very", "RB"], ["busy", "JJ"], [",", ","], ["&", "CC"], ["looks", "NNS"], ["worn.5", "-NONE-"], ["His", "NNP"], ["wife", "NN"], ["is", "VBZ"], ["well", "RB"], [",", ","], ["&", "CC"], ["I", "PRP"], ["guess", "VBP"], ["they", "PRP"], ["will", "MD"], ["come", "VB"], ["soon", "RB"], [".", "."]], [["Give", "JJ"], ["my", "PRP$"], ["love", "NN"], ["to", "TO"], ["your", "PRP$"], ["mother", "NN"], [",", ","], ["&", "CC"], ["with", "IN"], ["much", "JJ"], ["love", "NN"], ["to", "TO"], ["you", "PRP"], ["-", ":"], ["hoping", "VBG"], ["soon", "RB"], ["to", "TO"], ["see", "VB"], ["you", "PRP"], [".", "."]], [["Yours", "NNS"], ["Nelly", "RB"], [".", "."]]], "sentences": ["  Friday.", "Nov. 1st 1865.", "Dear Walt, Your letter was very welcome, and I have not forgotten you one day, though I have not written you.", "But I have been very much occupied in thought, as well as much of my time in going daily, & some days twice to see Miss Howard.2 Her sister Sallie has the worst form of typhoid fever.", "She has been very ill for three weeks, & alarmingly so for over ten days.", "Her mother was sent for more than a week ago, and two doctors have come twice a day to see her for many days.", "I don't suppose there is any hope at all.", "She is wild with delirium all the time.", "Poor Garrie is worn, but she bears up like a hero under it, does not leave her sister night or day.", "I got a good nurse for them, as their nurse had to leave.", "It is very sad, & I have not given up hoping till to-day, but she has no encouraging symptoms.", "I was so glad to hear that your little pet was better, and that your mother had got home!", "Has the little girl continued to improve?", "I hope so.", "It was good too, to hear that your mother was so well, & George, & all of you.", "I hope you are all well now.", "I trust the little girl is picking up fast.", "You ask about William.3 His letters have been \"few and far between\", four in five weeks,    but now I look a little for him to-morrow, Saturday, and shall surely expect him on Sunday.", "I guess he has had a good time, & he sent the MSS.", "to Curtis.", "You may see him in New York to-morrow.", "He will see Curtis, I suppose.", "When you come back what lots of things we shall have to talk about.", "I saw in the Tribune of Wednesday the advertisement of Drum Taps.", "Glad we were to see it, Charley & I.", "Have you sent one to Emerson?", "Do, in haste, won't you?", "I   want him to have one right away.", "Dear Walt, will you see in New York Mr. Howells?4 I don't even know his address, & it is necessary that I should write him a business letter.", "I wonder how they are.", "Give him my love if you see him.", "Jeannie is well, & sends love.", "I am well, so is Charley, & he too, sends love.", "We all want to see you back.", "Mr. Ashton is well, but very busy, & looks worn.5 His wife is well, & I guess they will come soon.", "Give my love to your mother, & with much love to you - hoping soon to see you.", "Yours    Nelly.  "], "words": ["Friday.", "Nov.", "1st", "1865.", "Dear", "Walt", ",", "Your", "letter", "was", "very", "welcome", ",", "and", "I", "have", "not", "forgotten", "you", "one", "day", ",", "though", "I", "have", "not", "written", "you.", "But", "I", "have", "been", "very", "much", "occupied", "in", "thought", ",", "as", "well", "as", "much", "of", "my", "time", "in", "going", "daily", ",", "&", "some", "days", "twice", "to", "see", "Miss", "Howard.2", "Her", "sister", "Sallie", "has", "the", "worst", "form", "of", "typhoid", "fever.", "She", "has", "been", "very", "ill", "for", "three", "weeks", ",", "&", "alarmingly", "so", "for", "over", "ten", "days.", "Her", "mother", "was", "sent", "for", "more", "than", "a", "week", "ago", ",", "and", "two", "doctors", "have", "come", "twice", "a", "day", "to", "see", "her", "for", "many", "days.", "I", "do", "n't", "suppose", "there", "is", "any", "hope", "at", "all.", "She", "is", "wild", "with", "delirium", "all", "the", "time.", "Poor", "Garrie", "is", "worn", ",", "but", "she", "bears", "up", "like", "a", "hero", "under", "it", ",", "does", "not", "leave", "her", "sister", "night", "or", "day.", "I", "got", "a", "good", "nurse", "for", "them", ",", "as", "their", "nurse", "had", "to", "leave.", "It", "is", "very", "sad", ",", "&", "I", "have", "not", "given", "up", "hoping", "till", "to-day", ",", "but", "she", "has", "no", "encouraging", "symptoms.", "I", "was", "so", "glad", "to", "hear", "that", "your", "little", "pet", "was", "better", ",", "and", "that", "your", "mother", "had", "got", "home", "!", "Has", "the", "little", "girl", "continued", "to", "improve", "?", "I", "hope", "so.", "It", "was", "good", "too", ",", "to", "hear", "that", "your", "mother", "was", "so", "well", ",", "&", "George", ",", "&", "all", "of", "you.", "I", "hope", "you", "are", "all", "well", "now.", "I", "trust", "the", "little", "girl", "is", "picking", "up", "fast.", "You", "ask", "about", "William.3", "His", "letters", "have", "been", "``", "few", "and", "far", "between", "''", ",", "four", "in", "five", "weeks", ",", "but", "now", "I", "look", "a", "little", "for", "him", "to-morrow", ",", "Saturday", ",", "and", "shall", "surely", "expect", "him", "on", "Sunday.", "I", "guess", "he", "has", "had", "a", "good", "time", ",", "&", "he", "sent", "the", "MSS.", "to", "Curtis.", "You", "may", "see", "him", "in", "New", "York", "to-morrow.", "He", "will", "see", "Curtis", ",", "I", "suppose.", "When", "you", "come", "back", "what", "lots", "of", "things", "we", "shall", "have", "to", "talk", "about.", "I", "saw", "in", "the", "Tribune", "of", "Wednesday", "the", "advertisement", "of", "Drum", "Taps.", "Glad", "we", "were", "to", "see", "it", ",", "Charley", "&", "I.", "Have", "you", "sent", "one", "to", "Emerson", "?", "Do", ",", "in", "haste", ",", "wo", "n't", "you", "?", "I", "want", "him", "to", "have", "one", "right", "away.", "Dear", "Walt", ",", "will", "you", "see", "in", "New", "York", "Mr.", "Howells", "?", "4", "I", "do", "n't", "even", "know", "his", "address", ",", "&", "it", "is", "necessary", "that", "I", "should", "write", "him", "a", "business", "letter.", "I", "wonder", "how", "they", "are.", "Give", "him", "my", "love", "if", "you", "see", "him.", "Jeannie", "is", "well", ",", "&", "sends", "love.", "I", "am", "well", ",", "so", "is", "Charley", ",", "&", "he", "too", ",", "sends", "love.", "We", "all", "want", "to", "see", "you", "back.", "Mr.", "Ashton", "is", "well", ",", "but", "very", "busy", ",", "&", "looks", "worn.5", "His", "wife", "is", "well", ",", "&", "I", "guess", "they", "will", "come", "soon.", "Give", "my", "love", "to", "your", "mother", ",", "&", "with", "much", "love", "to", "you", "-", "hoping", "soon", "to", "see", "you.", "Yours", "Nelly", "."], "date": [], "normalizedTime": "0.289949680403", "recipient": "Walt Whitman", "organizations": ["MSS"], "sender": "Ellen M.", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00949.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Ellen M. O'Connor to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Benton", "NNP"], ["H.", "NNP"], ["Wilson", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Mr. Whitman", "Dear Friend"], "money": [], "year": "1865", "locations": [], "month": "Nov", "parties": ["Benton H. Wilson", "Walt Whitman"], "properDate": "Nov 11, 1865", "gpe": ["Savannah"], "facility": [], "latlngs": [[32.0835407, -81.09983419999999]], "text": " Mr. Whitman, Dear Friend, I suppose you will think that I have forgotten you long before this time but I have not, your kindness to me while in the hospital will never be forgotten by me. I have entirely recovered from my wounds long since and have been at work part of the time and attending commercial school.  I have been at work about six weeks, consequently my hand is not in very good condition for writing. I have been promising myself to write to you ever since I returned home but have failed to keep my promise till now. I intend to go south in about two months and if I come that way I will stop and see you. I would like to know what chance I would have to go into business with a few hundred dollars capital.  If I can not go into anything there, what do you think of my going further south, say to Savannah. I want you when you write to tell me just what you think about it. I do not know as you will be much interested by receiving this letter from me but I would like to hear from you very much.  yours with respect.   ", "dateText": "", "percents": [], "taggedText": [[[["Mr.", "NNP"], ["Whitman", "NNP"]], [",", ","], [["Dear", "NNP"], ["Friend", "NNP"]], [",", ","], ["I", "PRP"], ["suppose", "VBP"], ["you", "PRP"], ["will", "MD"], ["think", "VB"], ["that", "IN"], ["I", "PRP"], ["have", "VBP"], ["forgotten", "VBN"], ["you", "PRP"], ["long", "RB"], ["before", "IN"], ["this", "DT"], ["time", "NN"], ["but", "CC"], ["I", "PRP"], ["have", "VBP"], ["not", "RB"], [",", ","], ["your", "PRP$"], ["kindness", "NN"], ["to", "TO"], ["me", "PRP"], ["while", "IN"], ["in", "IN"], ["the", "DT"], ["hospital", "NN"], ["will", "MD"], ["never", "RB"], ["be", "VB"], ["forgotten", "VBN"], ["by", "IN"], ["me", "PRP"], [".", "."]], [["I", "PRP"], ["have", "VBP"], ["entirely", "RB"], ["recovered", "VBN"], ["from", "IN"], ["my", "PRP$"], ["wounds", "NNS"], ["long", "RB"], ["since", "IN"], ["and", "CC"], ["have", "VBP"], ["been", "VBN"], ["at", "IN"], ["work", "NN"], ["part", "NN"], ["of", "IN"], ["the", "DT"], ["time", "NN"], ["and", "CC"], ["attending", "VBG"], ["commercial", "JJ"], ["school", "NN"], [".", "."]], [["I", "PRP"], ["have", "VBP"], ["been", "VBN"], ["at", "IN"], ["work", "NN"], ["about", "IN"], ["six", "CD"], ["weeks", "NNS"], [",", ","], ["consequently", "RB"], ["my", "PRP$"], ["hand", "NN"], ["is", "VBZ"], ["not", "RB"], ["in", "IN"], ["very", "RB"], ["good", "JJ"], ["condition", "NN"], ["for", "IN"], ["writing", "NN"], [".", "."]], [["I", "PRP"], ["have", "VBP"], ["been", "VBN"], ["promising", "VBG"], ["myself", "PRP"], ["to", "TO"], ["write", "VB"], ["to", "TO"], ["you", "PRP"], ["ever", "RB"], ["since", "IN"], ["I", "PRP"], ["returned", "VBD"], ["home", "NN"], ["but", "CC"], ["have", "VBP"], ["failed", "VBN"], ["to", "TO"], ["keep", "VB"], ["my", "PRP$"], ["promise", "NN"], ["till", "NN"], ["now", "RB"], [".", "."]], [["I", "PRP"], ["intend", "VBP"], ["to", "TO"], ["go", "VB"], ["south", "NN"], ["in", "IN"], ["about", "IN"], ["two", "CD"], ["months", "NNS"], ["and", "CC"], ["if", "IN"], ["I", "PRP"], ["come", "VBP"], ["that", "IN"], ["way", "NN"], ["I", "PRP"], ["will", "MD"], ["stop", "VB"], ["and", "CC"], ["see", "VB"], ["you", "PRP"], [".", "."]], [["I", "PRP"], ["would", "MD"], ["like", "VB"], ["to", "TO"], ["know", "VB"], ["what", "WP"], ["chance", "NN"], ["I", "PRP"], ["would", "MD"], ["have", "VB"], ["to", "TO"], ["go", "VB"], ["into", "IN"], ["business", "NN"], ["with", "IN"], ["a", "DT"], ["few", "JJ"], ["hundred", "VBN"], ["dollars", "NNS"], ["capital", "NN"], [".", "."]], [["If", "IN"], ["I", "PRP"], ["can", "MD"], ["not", "RB"], ["go", "VB"], ["into", "IN"], ["anything", "NN"], ["there", "RB"], [",", ","], ["what", "WDT"], ["do", "VBP"], ["you", "PRP"], ["think", "VB"], ["of", "IN"], ["my", "PRP$"], ["going", "NN"], ["further", "RB"], ["south", "JJ"], [",", ","], ["say", "VBP"], ["to", "TO"], [["Savannah", "NNP"]], [".", "."]], [["I", "PRP"], ["want", "VBP"], ["you", "PRP"], ["when", "WRB"], ["you", "PRP"], ["write", "VBP"], ["to", "TO"], ["tell", "VB"], ["me", "PRP"], ["just", "RB"], ["what", "WP"], ["you", "PRP"], ["think", "VBP"], ["about", "IN"], ["it", "PRP"], [".", "."]], [["I", "PRP"], ["do", "VBP"], ["not", "RB"], ["know", "VB"], ["as", "IN"], ["you", "PRP"], ["will", "MD"], ["be", "VB"], ["much", "RB"], ["interested", "JJ"], ["by", "IN"], ["receiving", "NN"], ["this", "DT"], ["letter", "NN"], ["from", "IN"], ["me", "PRP"], ["but", "CC"], ["I", "PRP"], ["would", "MD"], ["like", "VB"], ["to", "TO"], ["hear", "VB"], ["from", "IN"], ["you", "PRP"], ["very", "RB"], ["much", "RB"], [".", "."]], [["yours", "NNS"], ["with", "IN"], ["respect", "NN"], [".", "."]]], "sentences": [" Mr. Whitman, Dear Friend, I suppose you will think that I have forgotten you long before this time but I have not, your kindness to me while in the hospital will never be forgotten by me.", "I have entirely recovered from my wounds long since and have been at work part of the time and attending commercial school.", "I have been at work about six weeks, consequently my hand is not in very good condition for writing.", "I have been promising myself to write to you ever since I returned home but have failed to keep my promise till now.", "I intend to go south in about two months and if I come that way I will stop and see you.", "I would like to know what chance I would have to go into business with a few hundred dollars capital.", "If I can not go into anything there, what do you think of my going further south, say to Savannah.", "I want you when you write to tell me just what you think about it.", "I do not know as you will be much interested by receiving this letter from me but I would like to hear from you very much.", "yours with respect.   "], "words": ["Mr.", "Whitman", ",", "Dear", "Friend", ",", "I", "suppose", "you", "will", "think", "that", "I", "have", "forgotten", "you", "long", "before", "this", "time", "but", "I", "have", "not", ",", "your", "kindness", "to", "me", "while", "in", "the", "hospital", "will", "never", "be", "forgotten", "by", "me.", "I", "have", "entirely", "recovered", "from", "my", "wounds", "long", "since", "and", "have", "been", "at", "work", "part", "of", "the", "time", "and", "attending", "commercial", "school.", "I", "have", "been", "at", "work", "about", "six", "weeks", ",", "consequently", "my", "hand", "is", "not", "in", "very", "good", "condition", "for", "writing.", "I", "have", "been", "promising", "myself", "to", "write", "to", "you", "ever", "since", "I", "returned", "home", "but", "have", "failed", "to", "keep", "my", "promise", "till", "now.", "I", "intend", "to", "go", "south", "in", "about", "two", "months", "and", "if", "I", "come", "that", "way", "I", "will", "stop", "and", "see", "you.", "I", "would", "like", "to", "know", "what", "chance", "I", "would", "have", "to", "go", "into", "business", "with", "a", "few", "hundred", "dollars", "capital.", "If", "I", "can", "not", "go", "into", "anything", "there", ",", "what", "do", "you", "think", "of", "my", "going", "further", "south", ",", "say", "to", "Savannah.", "I", "want", "you", "when", "you", "write", "to", "tell", "me", "just", "what", "you", "think", "about", "it.", "I", "do", "not", "know", "as", "you", "will", "be", "much", "interested", "by", "receiving", "this", "letter", "from", "me", "but", "I", "would", "like", "to", "hear", "from", "you", "very", "much.", "yours", "with", "respect", "."], "date": [], "normalizedTime": "0.291309669523", "recipient": "Walt Whitman", "organizations": [], "sender": "Benton H. Wilson", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00611.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Benton H. Wilson to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["William", "NNP"], ["D.", "NNP"]], ["O'Connor", "NNP"], [",", ","], ["September", "NNP"], ["(", "NNP"]]], "people": ["Poetry"], "money": [], "year": "1866", "locations": ["West"], "month": ")", "parties": ["Walt Whitman", "William D."], "properDate": ") 0, 1866", "gpe": ["America", "United States", "European"], "facility": [], "latlngs": [], "text": " I assume that Poetry in America needs to be entirely recreated. On examining with anything like deep analysis what now prevails in the United States, the whole mass of current poetical works, long and short, consists either of the poetry of an elegantly weak sentimentalism, at bottom nothing but maudlin puerilities, more or less musical in verbiage, arising out of a life of depression and enervation, and producing depression and enervation as their result;   or else that class of poetry, plays, &c, of which the foundation is feudalism, with its ideas of lords and ladies, its imported standards of gentility, and the manners of European high-life-below-stairs in every line and verse. Such to me is the existing condition of poetry; such the product of the poets and poems of the time. To me, nothing can be more utterly contemptible. Instead of mighty and vital breezes, proportionate to our continent, with its powerful races of men, its tremendous historic events, its great oceans, its mountains and its illimitable prairies, I find a few little silly fans languidly moved by shrunken fingers. [My ambition is] to give something to our literature which will be our own; with neither foreign spirit, nor imagery nor form, but adapted to our case, grown out of our associations, boldly portraying the West, strengthening and intensifying the national soul, and finding the entire fountains of its birth and growth in our own country. ", "dateText": "", "percents": [], "taggedText": [[["I", "PRP"], ["assume", "VBP"], ["that", "IN"], [["Poetry", "NNP"]], ["in", "IN"], [["America", "NNP"]], ["needs", "VBZ"], ["to", "TO"], ["be", "VB"], ["entirely", "RB"], ["recreated", "VBN"], [".", "."]], [["On", "IN"], ["examining", "NN"], ["with", "IN"], ["anything", "NN"], ["like", "IN"], ["deep", "NN"], ["analysis", "NN"], ["what", "WP"], ["now", "RB"], ["prevails", "VBZ"], ["in", "IN"], ["the", "DT"], [["United", "NNP"], ["States", "NNPS"]], [",", ","], ["the", "DT"], ["whole", "JJ"], ["mass", "NN"], ["of", "IN"], ["current", "NN"], ["poetical", "JJ"], ["works", "NNS"], [",", ","], ["long", "RB"], ["and", "CC"], ["short", "JJ"], [",", ","], ["consists", "NNS"], ["either", "CC"], ["of", "IN"], ["the", "DT"], ["poetry", "NN"], ["of", "IN"], ["an", "DT"], ["elegantly", "RB"], ["weak", "JJ"], ["sentimentalism", "NN"], [",", ","], ["at", "IN"], ["bottom", "NN"], ["nothing", "NN"], ["but", "CC"], ["maudlin", "NN"], ["puerilities", "NNS"], [",", ","], ["more", "RBR"], ["or"