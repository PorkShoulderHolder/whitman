, "VBD"], ["for", "IN"], ["you", "PRP"], [",", ","], ["&", "CC"], ["I", "PRP"], ["told", "VBD"], ["him", "PRP"], ["where", "WRB"], ["you", "PRP"], ["were", "VBD"], ["he", "PRP"], ["asked", "VBD"], ["if", "IN"], ["you", "PRP"], ["were", "VBD"], ["coming", "VBG"], ["back", "RB"], ["etc", "JJ"], [".", "."]], [["&", "CC"], ["when", "WRB"], ["I", "PRP"], ["told", "VBD"], ["him", "PRP"], ["that", "IN"], ["I", "PRP"], ["had", "VBD"], ["heard", "VBN"], ["&", "CC"], ["should", "MD"], ["write", "VB"], ["you", "PRP"], [",", ","], ["he", "PRP"], ["said", "VBD"], ["``", "``"], ["My", "PRP$"], ["Gott", "NNP"], [",", ","], ["I", "PRP"], ["did", "VBD"], ["not", "RB"], ["know", "VB"], ["that", "IN"], ["he", "PRP"], ["was", "VBD"], ["such", "PDT"], ["a", "DT"], ["poet", "NN"], [",", ","], ["tell", "NN"], ["him", "PRP"], ["so", "RB"], [",", ","], ["I", "PRP"], ["have", "VBP"], ["been", "VBN"], ["trying", "VBG"], ["every", "DT"], ["where", "WRB"], ["to", "TO"], ["find", "VB"], ["him", "PRP"], ["to", "TO"], ["tell", "VB"], ["him", "PRP"], ["myself", "PRP"], [".", "."]], [["``", "``"], ["So", "RB"], ["you", "PRP"], ["see", "VBP"], [".", "."]], [["He", "PRP"], ["said", "VBD"], ["tell", "RB"], ["him", "PRP"], ["he", "PRP"], ["must", "MD"], ["write", "VB"], ["more", "RBR"], ["poems", "NNS"], [".", "."]], [["I", "PRP"], ["wish", "VBP"], ["that", "IN"], ["you", "PRP"], ["were", "VBD"], ["back", "RB"], ["here", "RB"], ["in", "IN"], ["your", "PRP$"], ["old", "JJ"], ["room", "NN"], ["for", "IN"], ["my", "PRP$"], ["sake", "NN"], [",", ","], ["for", "IN"], ["I", "PRP"], ["miss", "VBP"], ["you", "PRP"], ["&", "CC"], ["shall", "MD"], [".", "."]], [["I", "PRP"], ["should", "MD"], ["have", "VB"], ["gone", "VBN"], ["to", "TO"], ["the", "DT"], [["Hospital", "NNP"]], ["today", "NN"], ["if", "IN"], ["it", "PRP"], ["had", "VBD"], ["not", "RB"], ["rained", "VBN"], [",", ","], ["and", "CC"], ["I", "PRP"], ["shall", "MD"], ["go", "VB"], ["to-morrow", "JJ"], ["I", "PRP"], ["think", "VBP"], [",", ","], ["rain", "NN"], ["or", "CC"], ["shine", "NN"], [".", "."]], [["I", "PRP"], ["could", "MD"], ["not", "RB"], ["very", "RB"], ["well", "RB"], ["while", "IN"], ["Mrs.", "NNP"], [["Cooper", "NNP"]], ["was", "VBD"], ["here", "RB"], [",", ","], ["for", "IN"], ["we", "PRP"], ["kept", "VBD"], ["thinking", "VBG"], ["that", "IN"], ["every", "DT"], ["day", "NN"], ["would", "MD"], ["be", "VB"], ["here", "RB"], ["last", "JJ"], ["here", "RB"], [".", "."]], [["I", "PRP"], ["count", "VBP"], ["upon", "IN"], ["your", "PRP$"], ["return", "NN"], [",", ","], ["and", "CC"], ["on", "IN"], ["our", "PRP$"], ["all", "DT"], ["being", "VBG"], ["together", "RP"], ["much", "RB"], [",", ","], ["very", "RB"], ["much", "JJ"], ["this", "DT"], ["winter", "NN"], [",", ","], ["and", "CC"], ["on", "IN"], ["some", "DT"], ["good", "JJ"], ["talks", "NNS"], [",", ","], ["&", "CC"], ["good", "JJ"], ["times", "NNS"], ["reading", "VBG"], ["your", "PRP$"], ["Drum", "NNP"], ["Taps", "NNP"], [".", "."]], [["You", "PRP"], ["must", "MD"], ["publish", "VB"], ["that", "IN"], ["book", "NN"], [".", "."]], [[["William", "NNP"]], ["very", "RB"], ["often", "RB"], ["wishes", "VBZ"], ["for", "IN"], ["your", "PRP$"], ["return", "NN"], ["and", "CC"], ["wants", "VBZ"], ["to", "TO"], ["see", "VB"], ["you.5", "-NONE-"], ["Good", "NNP"], ["bye", "NN"], [".", "."]], [["With", "IN"], ["love", "JJ"], ["from", "IN"], ["us", "PRP"], ["all", "DT"], [".", "."]], [["Your", "PRP$"], ["friend", "NN"], [["Nelly", "NNP"]], ["O'Connor", "NNP"], [".", "."]]], "sentences": ["  No.", "400 L St. Nov. 24 1863  Dear Walt, Mrs. Cooper and Mr. Eldridge left yesterday morning as they intended, and as you see by this I did not go.1 I hardly think that you did either, so I will venture to send to you.", "I have some news to tell you.", "Mr. Howells came home with his wife last Saturday from New York.2 He has decided not to go to Idaho, and does not know yet what he will do.", "But he says he shall have no trouble in making it all right with the Government.", "About the other matter I do not know any more.", "I agree with you Walt, that in time he must see right through those people, & if it were not for the suffering it causes his wife, I should by all means say, let him go there, see them, be with them and live it out.", "Perhaps it is the only thing to do any way.", "Time will prove that.", "How I long to see you.", "Are you going to be here by Thursday, Thanksgiving!", "I wish I knew, for I would get a good big turkey and we would have a jolly time.", "I miss Mrs. C. very much.", "By the way, when you return to Washington if it is not too much out of your way, will you stop at Mrs. Cooper's and get a small parcel she is to have ready for me?", "It will save the expressage, and if you can do so without too much trouble I shall be very glad.", "She wants you to stop very much, and you would have a good time, & see Mr. & Mrs. Louis her brother & sister both of whom are great admirers of yours.", "I enjoyed your letter very much, did I tell you so in my note?", "I am better of my cough, which has been very bad, and I shall do well I have no doubt, but I get very tired of being half well, I would like to be in perfect health like you   how splendid it is!", "You ought to do grand things with such a grand body.", "I am sorry to hear such poor accounts of your brother Andrew   I hoped you would find him better.", "But for your mother's good health and vigor I rejoice with you.", "It must be a compensation for all to see her so nobly bearing up.", "You are rich indeed in having such a noble, grand mother.", "I hope I shall know her sometime, also your sister Martha & all.", "Are they going to let you name the baby California?", "She is a fine baby, I am sure.", "Your boys there will hold on to you till the last minute I know, and how they will miss you.", "I quite envy you the Opera, I wish I were there with you for a week to go around.", "Would we not have some good times?", "I am sure we would.", "Have you seen Mrs. Price any more?3 I hope you will, for I know she counted so much on seeing you.", "Last Sunday we were out walking & met the Count, the first time since you left.4 He immediately asked for you, & I told him where you were   he asked if you were coming back etc.", "& when I told him that I had heard & should write you, he said \"My Gott, I did not know that he was such a poet, tell him so, I have been trying every where to find him to tell him myself.", "\" So you see.", "He said tell him he must write more poems.", "I wish that you were back here in your old room for my sake, for I miss you & shall.", "I should have gone to the Hospital today if it had not rained, and I shall go to-morrow I think, rain or shine.", "I could not very well while Mrs. Cooper was here, for we kept thinking that every day would be here last here.", "I count upon your return, and on our all being together much, very much this winter, and on some good talks, & good times reading your Drum Taps.", "You must publish that book.", "William very often wishes for your return and wants to see you.5 Good bye.", "With love from us all.", "Your friend Nelly O'Connor.  "], "words": ["No.", "400", "L", "St.", "Nov.", "24", "1863", "Dear", "Walt", ",", "Mrs.", "Cooper", "and", "Mr.", "Eldridge", "left", "yesterday", "morning", "as", "they", "intended", ",", "and", "as", "you", "see", "by", "this", "I", "did", "not", "go.1", "I", "hardly", "think", "that", "you", "did", "either", ",", "so", "I", "will", "venture", "to", "send", "to", "you.", "I", "have", "some", "news", "to", "tell", "you.", "Mr.", "Howells", "came", "home", "with", "his", "wife", "last", "Saturday", "from", "New", "York.2", "He", "has", "decided", "not", "to", "go", "to", "Idaho", ",", "and", "does", "not", "know", "yet", "what", "he", "will", "do.", "But", "he", "says", "he", "shall", "have", "no", "trouble", "in", "making", "it", "all", "right", "with", "the", "Government.", "About", "the", "other", "matter", "I", "do", "not", "know", "any", "more.", "I", "agree", "with", "you", "Walt", ",", "that", "in", "time", "he", "must", "see", "right", "through", "those", "people", ",", "&", "if", "it", "were", "not", "for", "the", "suffering", "it", "causes", "his", "wife", ",", "I", "should", "by", "all", "means", "say", ",", "let", "him", "go", "there", ",", "see", "them", ",", "be", "with", "them", "and", "live", "it", "out.", "Perhaps", "it", "is", "the", "only", "thing", "to", "do", "any", "way.", "Time", "will", "prove", "that.", "How", "I", "long", "to", "see", "you.", "Are", "you", "going", "to", "be", "here", "by", "Thursday", ",", "Thanksgiving", "!", "I", "wish", "I", "knew", ",", "for", "I", "would", "get", "a", "good", "big", "turkey", "and", "we", "would", "have", "a", "jolly", "time.", "I", "miss", "Mrs.", "C.", "very", "much.", "By", "the", "way", ",", "when", "you", "return", "to", "Washington", "if", "it", "is", "not", "too", "much", "out", "of", "your", "way", ",", "will", "you", "stop", "at", "Mrs.", "Cooper", "'s", "and", "get", "a", "small", "parcel", "she", "is", "to", "have", "ready", "for", "me", "?", "It", "will", "save", "the", "expressage", ",", "and", "if", "you", "can", "do", "so", "without", "too", "much", "trouble", "I", "shall", "be", "very", "glad.", "She", "wants", "you", "to", "stop", "very", "much", ",", "and", "you", "would", "have", "a", "good", "time", ",", "&", "see", "Mr.", "&", "Mrs.", "Louis", "her", "brother", "&", "sister", "both", "of", "whom", "are", "great", "admirers", "of", "yours.", "I", "enjoyed", "your", "letter", "very", "much", ",", "did", "I", "tell", "you", "so", "in", "my", "note", "?", "I", "am", "better", "of", "my", "cough", ",", "which", "has", "been", "very", "bad", ",", "and", "I", "shall", "do", "well", "I", "have", "no", "doubt", ",", "but", "I", "get", "very", "tired", "of", "being", "half", "well", ",", "I", "would", "like", "to", "be", "in", "perfect", "health", "like", "you", "how", "splendid", "it", "is", "!", "You", "ought", "to", "do", "grand", "things", "with", "such", "a", "grand", "body.", "I", "am", "sorry", "to", "hear", "such", "poor", "accounts", "of", "your", "brother", "Andrew", "I", "hoped", "you", "would", "find", "him", "better.", "But", "for", "your", "mother", "'s", "good", "health", "and", "vigor", "I", "rejoice", "with", "you.", "It", "must", "be", "a", "compensation", "for", "all", "to", "see", "her", "so", "nobly", "bearing", "up.", "You", "are", "rich", "indeed", "in", "having", "such", "a", "noble", ",", "grand", "mother.", "I", "hope", "I", "shall", "know", "her", "sometime", ",", "also", "your", "sister", "Martha", "&", "all.", "Are", "they", "going", "to", "let", "you", "name", "the", "baby", "California", "?", "She", "is", "a", "fine", "baby", ",", "I", "am", "sure.", "Your", "boys", "there", "will", "hold", "on", "to", "you", "till", "the", "last", "minute", "I", "know", ",", "and", "how", "they", "will", "miss", "you.", "I", "quite", "envy", "you", "the", "Opera", ",", "I", "wish", "I", "were", "there", "with", "you", "for", "a", "week", "to", "go", "around.", "Would", "we", "not", "have", "some", "good", "times", "?", "I", "am", "sure", "we", "would.", "Have", "you", "seen", "Mrs.", "Price", "any", "more", "?", "3", "I", "hope", "you", "will", ",", "for", "I", "know", "she", "counted", "so", "much", "on", "seeing", "you.", "Last", "Sunday", "we", "were", "out", "walking", "&", "met", "the", "Count", ",", "the", "first", "time", "since", "you", "left.4", "He", "immediately", "asked", "for", "you", ",", "&", "I", "told", "him", "where", "you", "were", "he", "asked", "if", "you", "were", "coming", "back", "etc.", "&", "when", "I", "told", "him", "that", "I", "had", "heard", "&", "should", "write", "you", ",", "he", "said", "``", "My", "Gott", ",", "I", "did", "not", "know", "that", "he", "was", "such", "a", "poet", ",", "tell", "him", "so", ",", "I", "have", "been", "trying", "every", "where", "to", "find", "him", "to", "tell", "him", "myself.", "''", "So", "you", "see.", "He", "said", "tell", "him", "he", "must", "write", "more", "poems.", "I", "wish", "that", "you", "were", "back", "here", "in", "your", "old", "room", "for", "my", "sake", ",", "for", "I", "miss", "you", "&", "shall.", "I", "should", "have", "gone", "to", "the", "Hospital", "today", "if", "it", "had", "not", "rained", ",", "and", "I", "shall", "go", "to-morrow", "I", "think", ",", "rain", "or", "shine.", "I", "could", "not", "very", "well", "while", "Mrs.", "Cooper", "was", "here", ",", "for", "we", "kept", "thinking", "that", "every", "day", "would", "be", "here", "last", "here.", "I", "count", "upon", "your", "return", ",", "and", "on", "our", "all", "being", "together", "much", ",", "very", "much", "this", "winter", ",", "and", "on", "some", "good", "talks", ",", "&", "good", "times", "reading", "your", "Drum", "Taps.", "You", "must", "publish", "that", "book.", "William", "very", "often", "wishes", "for", "your", "return", "and", "wants", "to", "see", "you.5", "Good", "bye.", "With", "love", "from", "us", "all.", "Your", "friend", "Nelly", "O'Connor", "."], "date": [], "normalizedTime": "0.1936624507", "recipient": "Walt Whitman", "organizations": ["Hospital"], "sender": "Ellen M.", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00942.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Ellen M. O'Connor to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Thomas", "NNP"], ["Jefferson", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], [["Walt", "NNP"], ["Whitman", "NNP"]], [",", ","]]], "people": ["Walt", "Andrew", "Mary", "Mother Mat", "Poor Nancy", "Nancy", "Mattie", "Andrew"], "money": [], "year": "1863", "locations": [], "month": "Dec", "parties": ["Thomas Jefferson Whitman", "Walt Whitman"], "properDate": "Dec 3, 1863", "gpe": ["Brooklyn", "Mother", "Jeff"], "facility": [], "latlngs": [[40.65, -73.95]], "text": "  Brooklyn, N. Y. December 3rd 1863 Dear brother Walt, I have just telegraphed to you that Andrew was dead.2 Poor boy he died much eaiser than one would have supposed. I do hope to God you will come on. I have been with him, Mary, Mother Mat and I, almost all the time since you left. Mary and I watched last night. He has been dying ever since Wednesday morning   full 24 hours   Poor Nancy, she takes it woful hard  Mary has acted like the best of women  It is very affecting to see Nancy and the children  Mattie did everything that she possibly could3  She watched with us till near 3oclk this morning  Andrew was very desirous of having us all around him when he died. The poor boy seemed to think that that would take nearly all the horror of it away. If you will come on I will try and give you the passage money. Mother and the rest take it very hard. I hope to get an answer by telegraph. Jeff", "dateText": "", "percents": [], "taggedText": [[[["Brooklyn", "NNP"]], [",", ","], ["N.", "NNP"], ["Y.", "NNP"], ["December", "NNP"], ["3rd", "CD"], ["1863", "CD"], ["Dear", "NNP"], ["brother", "NN"], [["Walt", "NNP"]], [",", ","], ["I", "PRP"], ["have", "VBP"], ["just", "RB"], ["telegraphed", "VBN"], ["to", "TO"], ["you", "PRP"], ["that", "IN"], [["Andrew", "NNP"]], ["was", "VBD"], ["dead.2", "-NONE-"], ["Poor", "NNP"], ["boy", "NN"], ["he", "PRP"], ["died", "VBD"], ["much", "RB"], ["eaiser", "JJR"], ["than", "IN"], ["one", "CD"], ["would", "MD"], ["have", "VB"], ["supposed", "VBN"], [".", "."]], [["I", "PRP"], ["do", "VBP"], ["hope", "NN"], ["to", "TO"], ["God", "NNP"], ["you", "PRP"], ["will", "MD"], ["come", "VB"], ["on", "IN"], [".", "."]], [["I", "PRP"], ["have", "VBP"], ["been", "VBN"], ["with", "IN"], ["him", "PRP"], [",", ","], [["Mary", "NNP"]], [",", ","], [["Mother", "NNP"], ["Mat", "NNP"]], ["and", "CC"], ["I", "PRP"], [",", ","], ["almost", "RB"], ["all", "DT"], ["the", "DT"], ["time", "NN"], ["since", "IN"], ["you", "PRP"], ["left", "VBD"], [".", "."]], [["Mary", "NNP"], ["and", "CC"], ["I", "PRP"], ["watched", "VBD"], ["last", "JJ"], ["night", "NN"], [".", "."]], [["He", "PRP"], ["has", "VBZ"], ["been", "VBN"], ["dying", "VBG"], ["ever", "RB"], ["since", "IN"], ["Wednesday", "NNP"], ["morning", "NN"], ["full", "JJ"], ["24", "CD"], ["hours", "NNS"], [["Poor", "NNP"], ["Nancy", "NNP"]], [",", ","], ["she", "PRP"], ["takes", "VBZ"], ["it", "PRP"], ["woful", "JJ"], ["hard", "JJ"], ["Mary", "NNP"], ["has", "VBZ"], ["acted", "VBN"], ["like", "IN"], ["the", "DT"], ["best", "JJS"], ["of", "IN"], ["women", "NNS"], ["It", "PRP"], ["is", "VBZ"], ["very", "RB"], ["affecting", "VBG"], ["to", "TO"], ["see", "VB"], [["Nancy", "NNP"]], ["and", "CC"], ["the", "DT"], ["children", "NNS"], [["Mattie", "NNP"]], ["did", "VBD"], ["everything", "VBG"], ["that", "IN"], ["she", "PRP"], ["possibly", "RB"], [["could3", "NNP"]], ["She", "NNP"], ["watched", "VBD"], ["with", "IN"], ["us", "PRP"], ["till", "MD"], ["near", "VB"], ["3oclk", "CD"], ["this", "DT"], ["morning", "NN"], [["Andrew", "NNP"]], ["was", "VBD"], ["very", "RB"], ["desirous", "JJ"], ["of", "IN"], ["having", "VBG"], ["us", "PRP"], ["all", "DT"], ["around", "IN"], ["him", "PRP"], ["when", "WRB"], ["he", "PRP"], ["died", "VBD"], [".", "."]], [["The", "DT"], ["poor", "JJ"], ["boy", "NN"], ["seemed", "VBD"], ["to", "TO"], ["think", "VB"], ["that", "IN"], ["that", "DT"], ["would", "MD"], ["take", "VB"], ["nearly", "RB"], ["all", "DT"], ["the", "DT"], ["horror", "NN"], ["of", "IN"], ["it", "PRP"], ["away", "RB"], [".", "."]], [["If", "IN"], ["you", "PRP"], ["will", "MD"], ["come", "VB"], ["on", "IN"], ["I", "PRP"], ["will", "MD"], ["try", "VB"], ["and", "CC"], ["give", "VB"], ["you", "PRP"], ["the", "DT"], ["passage", "NN"], ["money", "NN"], [".", "."]], [[["Mother", "NNP"]], ["and", "CC"], ["the", "DT"], ["rest", "NN"], ["take", "NN"], ["it", "PRP"], ["very", "RB"], ["hard", "RB"], [".", "."]], [["I", "PRP"], ["hope", "VBP"], ["to", "TO"], ["get", "VB"], ["an", "DT"], ["answer", "NN"], ["by", "IN"], ["telegraph", "NN"], [".", "."]], [[["Jeff", "NNP"]]]], "sentences": ["  Brooklyn, N. Y. December 3rd 1863 Dear brother Walt, I have just telegraphed to you that Andrew was dead.2 Poor boy he died much eaiser than one would have supposed.", "I do hope to God you will come on.", "I have been with him, Mary, Mother Mat and I, almost all the time since you left.", "Mary and I watched last night.", "He has been dying ever since Wednesday morning   full 24 hours   Poor Nancy, she takes it woful hard  Mary has acted like the best of women  It is very affecting to see Nancy and the children  Mattie did everything that she possibly could3  She watched with us till near 3oclk this morning  Andrew was very desirous of having us all around him when he died.", "The poor boy seemed to think that that would take nearly all the horror of it away.", "If you will come on I will try and give you the passage money.", "Mother and the rest take it very hard.", "I hope to get an answer by telegraph.", "Jeff"], "words": ["Brooklyn", ",", "N.", "Y.", "December", "3rd", "1863", "Dear", "brother", "Walt", ",", "I", "have", "just", "telegraphed", "to", "you", "that", "Andrew", "was", "dead.2", "Poor", "boy", "he", "died", "much", "eaiser", "than", "one", "would", "have", "supposed.", "I", "do", "hope", "to", "God", "you", "will", "come", "on.", "I", "have", "been", "with", "him", ",", "Mary", ",", "Mother", "Mat", "and", "I", ",", "almost", "all", "the", "time", "since", "you", "left.", "Mary", "and", "I", "watched", "last", "night.", "He", "has", "been", "dying", "ever", "since", "Wednesday", "morning", "full", "24", "hours", "Poor", "Nancy", ",", "she", "takes", "it", "woful", "hard", "Mary", "has", "acted", "like", "the", "best", "of", "women", "It", "is", "very", "affecting", "to", "see", "Nancy", "and", "the", "children", "Mattie", "did", "everything", "that", "she", "possibly", "could3", "She", "watched", "with", "us", "till", "near", "3oclk", "this", "morning", "Andrew", "was", "very", "desirous", "of", "having", "us", "all", "around", "him", "when", "he", "died.", "The", "poor", "boy", "seemed", "to", "think", "that", "that", "would", "take", "nearly", "all", "the", "horror", "of", "it", "away.", "If", "you", "will", "come", "on", "I", "will", "try", "and", "give", "you", "the", "passage", "money.", "Mother", "and", "the", "rest", "take", "it", "very", "hard.", "I", "hope", "to", "get", "an", "answer", "by", "telegraph.", "Jeff"], "date": [], "normalizedTime": "0.194886440908", "recipient": "Walt Whitman", "organizations": ["could3"], "sender": "Thomas Jefferson Whitman", "url": "http://www.whitmanarchive.org/biography/correspondence/cw/tei/loc.00428.html", "doc": {"headline": "doc", "text": ""}, "pastTO": true, "time": [], "heading": " Letter from Thomas Jefferson Whitman to Walt Whitman ,"}, {"taggedHeading": [[["Letter", "NNP"], ["from", "IN"], [["Walt", "NNP"], ["Whitman", "NNP"]], ["to", "TO"], ["Dr", "NNP"], [".", "."]], [[["Le", "NNP"]], [["Baron", "NNP"], ["Russell", "NNP"]], [",", ","]]], "people": ["Your note4", "Doctor", "Walt Whitman Care Major Hapgood Paymaster"], "money": [], "year": "1863", "locations": [], "month": "Dec", "parties": ["Walt Whitman"], "properDate": "Dec 3, 1863", "gpe": ["Washington", "Doctor", "American", "Boston"], "facility": [], "latlngs": [[38.8951118, -77.0363658], [42.3584308, -71.0597732]], "text": "  Washington / Dec. 3d 18632  Dear Friend3, Your note4 with $20 from a friend, (formerly a Breckenridge democrat) came safe. Doctor, I have been away for a few days, but have now returned to remain here certainly for the winter & ensuing spring, & probably for two or three years. I feel much possessed with the wounded & sick soldiers   they have taken a powerful hold of me, & I am very happy among them   it is perhaps the greatest interchange of magnetism human relations are capable of   I have told you how young & how American they mostly are   so on my own account   I shall continue as a missionary among them as sure as I live   I shall continue for years   tell your friend that his mony is being distributed as mony or what little purchas I find appropriate for the men of all states   I reject none of course   not rebel wounded nor blacks, nor any when I find them suffering & dying   Doctor to the other friends that assisted me in Boston & to yourself, I send my regards & love  Walt Whitman  Care Major Hapgood Paymaster U.S.A.  ", "dateText": "", "percents": [], "taggedText": [[[["Washington", "NNP"]], ["/", ":"], ["Dec.", "NNP"], ["3d", "CD"], ["18632", "CD"], ["Dear", "NNP"], ["Friend3", "NNP"], [",", ","], [["Your", "NNP"], ["note4", "NNP"]], ["with", "IN"], ["$", "$"], ["20", "CD"], ["from", "IN"], ["a", "DT"], ["friend", "NN"], [",", ","], ["(", ":"], ["formerly", "RB"], ["a", "DT"], ["Breckenridge", "NNP"], ["democrat", "NN"], [")", ":"], ["came", "VBD"], ["safe", "NN"], [".", "."]], [[["Doctor", "NNP"]], [",", ","], ["I", "PRP"], ["have", "VBP"], ["been", "VBN"], ["away", "RB"], ["for", "IN"], ["a", "DT"], ["few", "JJ"], ["days", "NNS"], [",", ","], ["but", "CC"], ["have", "VBP"], ["now", "RB"], ["returned", "VBN"], ["to", "TO"], ["remain", "VB"], ["here", "RB"], ["certainly", "RB"], ["for", "IN"], ["the", "DT"], ["winter", "NN"], ["&", "CC"], ["ensuing", "VBG"], ["spring", "NN"], [",", ","], ["&", "CC"], ["probably", "RB"], ["for", "IN"], ["two", "CD"], ["or", "CC"], ["three", "CD"], ["years", "NNS"], [".", "."]], [["I", "PRP"], ["feel", "VBP"], ["much", "JJ"], ["possessed", "VBN"], ["with", "IN"], ["the", "DT"], ["wounded", "VBN"], ["&", "CC"], ["sick", "NN"], ["soldiers", "NNS"], ["they", "PRP"], ["have", "VBP"], ["taken", "VBN"], ["a", "DT"], ["powerful", "JJ"], ["hold", "NN"], ["of", "IN"], ["me", "PRP"], [",", ","], ["&", "CC"], ["I", "PRP"], ["am", "VBP"], ["very", "RB"], ["happy", "JJ"], ["among", "IN"], ["them", "PRP"], ["it", "PRP"], ["is", "VBZ"], ["perhaps", "RB"], ["the", "DT"], ["greatest", "JJS"], ["interchange", "NN"], ["of", "IN"], ["magnetism", "NN"], ["human", "NN"], ["relations", "NNS"], ["ar